{
  "id": "AdmissiblePairsAndPadicHodgeStructures",
  "title": "Admissible pairs, p-adic Hodge structures and bi-analytic Ax–Lindemann",
  "area": "padic",
  "parent": null,
  "summary": "Plan the neutral Tannakian theory of admissible pairs and p-adic Hodge structures over points and diamonds, its period domains for connected linear algebraic groups, and the geometry of Hodge and Hodge–Tate special loci. Establish basic duality, density of Hodge-generic classical points, and the bi-analytic Ax–Lindemann theorem, with applications to variations and explicitly conditional Shimura uniformizations. The arbitrary-field type theorem retains an explicit full-rank de Rham criterion as an open input.",
  "readme": "The neutral Tannakian theory of admissible pairs connects Frobenius modules, two de Rham-period lattices and local systems. The layers pass from pointwise exactness and CM criteria to relative lattices, non-reductive period domains, basic duality and two analytic closures. The final statements are the bi-analytic Ax–Lindemann theorem and Hodge–Tate period-image density. General period rings, reductive bundle geometry, rigid Zariski geometry and integral BKF theory are imported from their existing owners. The detailed reader document fixes signs, supplier contracts and all tests.",
  "prerequisites": [
    "AInfCohomology",
    "AdicSpacesPartIIPartII",
    "BunGAndNewtonStrata",
    "DiamondSixOperations",
    "DiamondsAndVStacks",
    "EndoscopicTransferAndUnitaryTraceComparison",
    "GeometricSatakeAndFusion",
    "HeckeStacksAndLocalShtukas",
    "HilbertModularVarietiesAndShimuraCurves",
    "IgusaVarietiesAndTorsionConcentration",
    "MotivesAndAlgebraicCycles",
    "PadicHodgeTheory",
    "PerfectoidQuotients",
    "PerfectoidShimuraVarieties",
    "ReductiveGroupsPartII",
    "RelativeFarguesFontaine",
    "VectorBundlesAndIsocrystals"
  ],
