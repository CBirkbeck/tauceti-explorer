/-! ## L0. The Eisenstein ideal of an Eisenstein family -/

section EisensteinIdeal

variable {Λ 𝕋 J : Type*} [CommRing Λ] [CommRing 𝕋]

/-- AutomorphicCongruences:L0/eisenstein-ideal, API `EisensteinIdeal.hecke`.
The ideal of the Hecke algebra generated by `t − λ(t)` for the listed Hecke operators
`ops j` and the eigenvalues `eig j` of the Eisenstein family, pushed into `𝕋` along the
structure map `ι : Λ →+* 𝕋`. -/
def EisensteinIdeal.hecke (ι : Λ →+* 𝕋) (ops : J → 𝕋) (eig : J → Λ) : Ideal 𝕋 :=
  Ideal.span (Set.range fun j => ops j - ι (eig j))

/-- AutomorphicCongruences:L0/eisenstein-ideal, API `EisensteinIdeal.base`.
`E = ker(Λ → 𝕋/I)`: the Eisenstein ideal of the coefficient ring. -/
def EisensteinIdeal.base (ι : Λ →+* 𝕋) (ops : J → 𝕋) (eig : J → Λ) : Ideal Λ :=
  Ideal.comap ι (EisensteinIdeal.hecke ι ops eig)

/-- `EisensteinIdeal.quotientEquiv`: when `Λ → 𝕋/I` is onto (the operators generate `𝕋`
over `Λ` modulo `I`), `Λ/E ≃ 𝕋/I`, compatibly with the classes of elements of `Λ`. -/
theorem EisensteinIdeal.quotientEquiv (ι : Λ →+* 𝕋) (ops : J → 𝕋) (eig : J → Λ)
    (honto : Function.Surjective
      ((Ideal.Quotient.mk (EisensteinIdeal.hecke ι ops eig)).comp ι)) :
    ∃ e : (Λ ⧸ EisensteinIdeal.base ι ops eig) ≃+* (𝕋 ⧸ EisensteinIdeal.hecke ι ops eig),
      ∀ r, e (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ (ι r) := by
  sorry

/-- `EisensteinIdeal.localize`: formation of `E` commutes with localization of `Λ` at a
prime `P`, for the localized Hecke algebra `𝕋 ⊗ Λ_P`. Stated here in the inclusion form
that holds for any commuting square; equality after flat base change is the README target. -/
theorem EisensteinIdeal.localize {Λ' 𝕋' : Type*} [CommRing Λ'] [CommRing 𝕋']
    (ι : Λ →+* 𝕋) (ι' : Λ' →+* 𝕋') (α : Λ →+* Λ') (β : 𝕋 →+* 𝕋')
    (ops : J → 𝕋) (eig : J → Λ) (hsq : β.comp ι = ι'.comp α) :
    Ideal.map α (EisensteinIdeal.base ι ops eig) ≤
      EisensteinIdeal.base ι' (fun j => β (ops j)) (fun j => α (eig j)) := by
  sorry

/-- `EisensteinIdeal.proper_iff`, algebraic form: `E ≠ ⊤` iff `I ≠ ⊤` when `ι` is unital
(the arithmetic form — a congruent cuspidal eigensystem exists — is the README target). -/
theorem EisensteinIdeal.proper_iff (ι : Λ →+* 𝕋) (ops : J → 𝕋) (eig : J → Λ) :
    EisensteinIdeal.base ι ops eig ≠ ⊤ ↔ EisensteinIdeal.hecke ι ops eig ≠ ⊤ := by
  sorry

/-- `EisensteinIdeal.mono`: enlarging the set of Hecke operators enlarges the ideals. -/
theorem EisensteinIdeal.mono {J' : Type*} (ι : Λ →+* 𝕋) (ops : J' → 𝕋) (eig : J' → Λ)
    (f : J → J') :
    EisensteinIdeal.base ι (ops ∘ f) (eig ∘ f) ≤ EisensteinIdeal.base ι ops eig := by
  sorry

-- eisensteinIdeal_ramanujan_level1 (one-generator shadow): for Δ against E₁₂ at ℓ = 2,
-- τ(2) − σ₁₁(2) = −24 − 2049 = −2073 = −3·691; over ℤ with 𝕋 = ℤ the ideal is (2073).
example : EisensteinIdeal.base (RingHom.id ℤ) (fun _ : Unit => (-24 : ℤ))
    (fun _ : Unit => (2049 : ℤ)) = Ideal.span {(2073 : ℤ)} := by
  sorry

-- eisensteinIdeal_ramanujan_level1, localized at 691: over ℤ_(691)-type coefficients the
-- generator 2073 has 691-adic valuation exactly one.
example : (691 : ℤ) ∣ 2073 ∧ ¬ (691 ^ 2 : ℤ) ∣ 2073 := by
  sorry

-- eisensteinIdeal_no_congruence: a unit difference makes `E = Λ`.
example : EisensteinIdeal.base (RingHom.id ℤ) (fun _ : Unit => (2 : ℤ))
    (fun _ : Unit => (1 : ℤ)) = ⊤ := by
  sorry

end EisensteinIdeal

/-! ## L0. Euler-factor polynomials -/

section EulerFactors

open Polynomial

variable {R : Type*} [CommRing R]

/-- AutomorphicCongruences:L0/primitive-imprimitive-comparison: the Euler polynomial
`P_ℓ(X) = det(1 − Frob_ℓ⁻¹ X | (T ⊗ Frac A)^{I_ℓ})` in SU, with trace `a`
and determinant `d` of that inverse Frobenius: `1 − a X + d X²`. -/
noncomputable def eulerPolyUnramified (a d : R) : R[X] :=
  1 - C a * X + C d * X ^ 2

/-- The Euler polynomial at a prime where the inertia invariants have rank one (Steinberg
or its unramified twist), with the chosen source-normalized Frobenius eigenvalue `α` on them: `1 − α X`. -/
noncomputable def eulerPolySteinberg (α : R) : R[X] :=
  1 - C α * X

theorem eulerPolyUnramified_eval_zero (a d : R) : (eulerPolyUnramified a d).eval 0 = 1 := by
  sorry

theorem eulerPolySteinberg_eval_zero (α : R) : (eulerPolySteinberg α).eval 0 = 1 := by
  sorry

-- Nakamura's norm relation factor for a newform of weight `k` and character `ε` at `ℓ ∉ Σ_f`:
-- `P_ℓ(u) = 1 − a_ℓ u + ℓ^{k−1} ε(ℓ) u²` (NakamuraZeta.norm); weight two, trivial character.
example (aℓ : ℤ) (ℓ : ℕ) :
    eulerPolyUnramified aℓ (ℓ : ℤ) = 1 - C aℓ * X + C (ℓ : ℤ) * X ^ 2 := by
  sorry

-- Steinberg check of L0/primitive-imprimitive-comparison: for `a_ℓ = ±1` the factor is
-- `1 ∓ X` before the cyclotomic substitution.
example : eulerPolySteinberg (1 : ℤ) = 1 - X := by
  sorry

-- A residual Euler factor can be nonzero as a polynomial and vanish at augmentation.
-- Thus zero augmentation cannot justify discarding it as a unit in a local Iwasawa ring.
example : (1 - X : (ZMod 5)[X]) ≠ 0 ∧ (1 - X : (ZMod 5)[X]).eval 1 = 0 := by
  sorry

end EulerFactors

/-! ## L2 and L5a. Splitting conditions on the auxiliary quadratic fields -/

section AuxiliaryFields

/-- Splitting test for an unramified prime and a quadratic fundamental discriminant `D`.
At `p = 2`, odd `D` splits precisely when `D ≡ 1 mod 8`; the Jacobi criterion is for odd primes. -/
def SplitsInQuadratic (D : ℤ) (p : ℕ) : Prop :=
  if p = 2 then D % 8 = 1 else jacobiSym D p = 1

/-- Inertia test for an unramified prime and a quadratic fundamental discriminant `D`.
At `p = 2`, odd `D` is inert precisely when `D ≡ 5 mod 8`. -/
def InertInQuadratic (D : ℤ) (p : ℕ) : Prop :=
  if p = 2 then D % 8 = 5 else jacobiSym D p = -1

/-- BCS's condition (disc) on the discriminant of `K`: odd and different from `−3`. -/
def BCSDisc (DK : ℤ) : Prop := Odd DK ∧ DK ≠ -3

/-- BCS's (Heeg) for `K` relative to the primes `ℓ ∣ N` (listed), and (spl) at `p`. -/
def BCSHeegSpl (DK : ℤ) (primesN : List ℕ) (p : ℕ) : Prop :=
  (∀ ℓ ∈ primesN, SplitsInQuadratic DK ℓ) ∧ SplitsInQuadratic DK p

/-- Conditions (i)–(iii) of BCS Prop. 5.2.1 on the real quadratic `F` (discriminant `DF`):
`p` inert in `F`; `DF` odd with its prime divisors split in `K`; every `ℓ ∣ N` inert in `F`
if `ℓ ≡ −1 mod p` and split otherwise. -/
def BCSConditionsF (DF DK : ℤ) (primesDF primesN : List ℕ) (p : ℕ) : Prop :=
  InertInQuadratic DF p ∧ Odd DF ∧ (∀ q ∈ primesDF, SplitsInQuadratic DK q) ∧
    ∀ ℓ ∈ primesN, (ℓ % p = p - 1 → InertInQuadratic DF ℓ) ∧
      (ℓ % p ≠ p - 1 → SplitsInQuadratic DF ℓ)

-- 11 splits in ℚ(√−7): (−7/11) = (−1/11)(7/11) = (−1)(−1) = 1.
example : SplitsInQuadratic (-7) 11 := by
  sorry

-- p = 5 is inert in ℚ(√13): (13/5) = (3/5) = −1, as condition (i) of Prop. 5.2.1 asks.
example : InertInQuadratic 13 5 := by
  sorry

-- The prime 2 may divide N: it splits for D = −7 and is inert for D = 13.
example : SplitsInQuadratic (-7) 2 ∧ InertInQuadratic 13 2 ∧ ¬ SplitsInQuadratic 13 2 := by
  change (-7 : ℤ) % 8 = 1 ∧ (13 : ℤ) % 8 = 5 ∧ ¬ (13 : ℤ) % 8 = 1
  decide

-- (disc) excludes ℚ(√−3) and accepts ℚ(√−7).
example : ¬ BCSDisc (-3) ∧ BCSDisc (-7) := by
  sorry

end AuxiliaryFields

/-! ## L3–L4. The regular ring Λ of the family theorem -/

section FamilyRing

/-- `Λ = O⟦X₁, X₂, X₃⟧`, the regular subring over which `T_Σ` is finite free
(L3/universal-deformation-ring-structure) and over which FW Thm 1.8 is stated
(L4/fw-universal-family-theorem). -/
abbrev FWLambda (O : Type*) [CommRing O] : Type _ := MvPowerSeries (Fin 3) O

-- The three variables of `Λ` are distinct elements (the regular sequence `x₁, x₂, x₃` of
-- FW Cor. 2.7 maps to them).
example : (MvPowerSeries.X 0 : FWLambda ℤ) ≠ MvPowerSeries.X 1 := by
  sorry

end FamilyRing


/-! ## L5w–L5b. Coefficient ideals and algebraic descent reductions -/


section CoefficientIdeal
variable {R H J : Type*} [CommRing R] [CommRing H]

/-- AutomorphicCongruences:L5w/eisenstein-coefficient-ideal
The preimage in the coefficient ring of the ideal of the actual Hecke differences.
The arithmetic index J includes both corrected split Hecke families (packet E6), and all
polynomial, central and ordinary operators of Wan 9.1. -/
noncomputable def wanEisensteinIdeal
    (ι : R →+* H) (operator : J → H) (eigenvalue : J → R) : Ideal R :=
  EisensteinIdeal.base ι operator eigenvalue

lemma wanEisensteinIdeal_mem
    (ι : R →+* H) (operator : J → H) (eigenvalue : J → R) (r : R) :
    r ∈ wanEisensteinIdeal ι operator eigenvalue ↔
      ι r ∈ Ideal.span (Set.range (fun j => operator j - ι (eigenvalue j))) := by
  sorry

lemma wanEisensteinIdeal_quotient_kernel
    (ι : R →+* H) (operator : J → H) (eigenvalue : J → R) :
    wanEisensteinIdeal ι operator eigenvalue =
      RingHom.ker ((Ideal.Quotient.mk
        (Ideal.span (Set.range (fun j => operator j - ι (eigenvalue j))))).comp ι) := by
  sorry

lemma wanEisensteinIdeal_generator
    (ι : R →+* H) (operator : J → H) (eigenvalue : J → R) (j : J) :
    Ideal.Quotient.mk (Ideal.span (Set.range (fun k => operator k - ι (eigenvalue k))))
        (operator j) =
      Ideal.Quotient.mk (Ideal.span (Set.range (fun k => operator k - ι (eigenvalue k))))
        (ι (eigenvalue j)) := by
  sorry

/-- First isomorphism theorem, with the coefficient action preserved. Surjectivity is an
actual hypothesis; in the arithmetic application it needs the Hecke-generator argument. -/
lemma wanEisensteinIdeal_quotient_surjective
    (ι : R →+* H) (operator : J → H) (eigenvalue : J → R)
    (honto : Function.Surjective
      ((Ideal.Quotient.mk
        (Ideal.span (Set.range (fun j => operator j - ι (eigenvalue j))))).comp ι)) :
    ∃ e : (R ⧸ wanEisensteinIdeal ι operator eigenvalue) ≃+*
        (H ⧸ Ideal.span (Set.range (fun j => operator j - ι (eigenvalue j)))),
      ∀ r, e (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ (ι r) := by
  sorry

/-- A commuting coefficient/Hecke square gives inclusion, without asserting kernel
base-change equality for an arbitrary specialization. -/
lemma wanEisensteinIdeal_baseChange_le
    {R' H' : Type*} [CommRing R'] [CommRing H']
    (ι : R →+* H) (ι' : R' →+* H') (α : R →+* R') (β : H →+* H')
    (operator : J → H) (eigenvalue : J → R)
    (hsquare : β.comp ι = ι'.comp α) :
    Ideal.map α (wanEisensteinIdeal ι operator eigenvalue) ≤
      wanEisensteinIdeal ι' (fun j => β (operator j)) (fun j => α (eigenvalue j)) := by
  sorry

-- eisenstein_equal_eigenvalues: zero difference and injective coefficient map.
example : wanEisensteinIdeal (RingHom.id ℤ)
    (fun _ : Unit => (7 : ℤ)) (fun _ : Unit => (7 : ℤ)) = ⊥ := by
  sorry

-- eisenstein_mod_five: detects both the direction and multiplicity of the ideal.
example :
    wanEisensteinIdeal (RingHom.id ℤ)
        (fun _ : Unit => (8 : ℤ)) (fun _ : Unit => (3 : ℤ)) =
      Ideal.span ({(5 : ℤ)} : Set ℤ) ∧
    wanEisensteinIdeal (RingHom.id ℤ)
        (fun _ : Unit => (8 : ℤ)) (fun _ : Unit => (3 : ℤ)) ≠
      Ideal.span ({(25 : ℤ)} : Set ℤ) := by
  sorry

-- eisenstein_unit_difference: a unit relation destroys the entire quotient.
example : wanEisensteinIdeal (RingHom.id ℤ)
    (fun _ : Unit => (2 : ℤ)) (fun _ : Unit => (1 : ℤ)) = ⊤ := by
  sorry

-- eisenstein_kernel_noninjective: the coefficient kernel survives even with no difference.
example : wanEisensteinIdeal (Int.castRingHom (ZMod 5))
    (fun _ : Unit => (3 : ZMod 5)) (fun _ : Unit => (3 : ℤ)) =
      Ideal.span ({(5 : ℤ)} : Set ℤ) := by
  sorry
end CoefficientIdeal

section IntegralAlgebra
variable {R : Type*} [CommRing R]

/-- Algebraic reduction only: changing the period/projector by a unit preserves its ideal.
The arithmetic identification of that unit remains in the named comparison target. -/
theorem canonicalPeriodDuality (a : R) (u : Rˣ) :
    Ideal.span ({(u : R) * a} : Set R) = Ideal.span ({a} : Set R) := by
  sorry

/-- Algebraic reduction only: the order-two splitting is integral when 2 is invertible.
The continuous global and local Selmer maps are missing hypotheses/carriers, not proved here. -/
theorem quadraticSelmerDecomposition
    {M : Type*} [AddCommGroup M] [Module R M]
    (c : M →ₗ[R] M) (hc : c.comp c = LinearMap.id) (h2 : IsUnit (2 : R)) :
    Nonempty (M ≃ₗ[R]
      ((LinearMap.ker (c - LinearMap.id)) × (LinearMap.ker (c + LinearMap.id)))) := by
  sorry

/-- Algebraic reduction only: a unit-normalized product has the same principal ideal.
The analytic interpolation and Neron-period identities are omitted arithmetic hypotheses. -/
theorem cyclotomicAnalyticFactorization (L L₁ L₂ : R)
    (hfactor : ∃ u : Rˣ, L = (u : R) * (L₁ * L₂)) :
    Ideal.span ({L} : Set R) =
      Ideal.span ({L₁} : Set R) * Ideal.span ({L₂} : Set R) := by
  sorry

/-- Algebraic reduction only: transport the EARLY bound, then use correctly oriented control.
I is the two-variable characteristic product, A the early analytic product. -/
theorem fourFactorProductBound
    {S : Type*} [CommRing S] (π : S →+* R) (I A : Ideal S)
    (J₀ J₁ J₂ J₃ B₀ B₁ B₂ B₃ : Ideal R)
    (hearly : I ≤ A)
    (hcontrol : J₀ * J₁ * J₂ * J₃ ≤ Ideal.map π I)
    (hanalytic : Ideal.map π A = B₀ * B₁ * B₂ * B₃) :
    J₀ * J₁ * J₂ * J₃ ≤ B₀ * B₁ * B₂ * B₃ := by
  sorry

/-- Algebraic reduction only: in an integral unipotent basis, squaring doubles the off-diagonal.
The Galois group, determinant, twist character and existence of this basis are omitted here. -/
theorem rankOneImageQuadraticTwist (u : R) (hu : IsUnit u) (h2 : IsUnit (2 : R)) :
    (!![(1 : R), u; 0, 1] : Matrix (Fin 2) (Fin 2) R) ^ 2 - 1 =
      !![(0 : R), 2 * u; 0, 0] ∧ IsUnit (2 * u) := by
  sorry

/-- The actual cokernel reduction used after the integral-basis step. No p-power index is
removed: the parameter must be a unit in R itself. The map sends (x,y) to (u*y,0). -/
example (u : Rˣ) :
    ∃ n : (R × R) →ₗ[R] (R × R),
      (∀ v, n v = ((u : R) * v.2, 0)) ∧
      Nonempty (((R × R) ⧸ LinearMap.range n) ≃ₗ[R] R) := by
  sorry

open scoped BigOperators

/-- Algebraic reduction with all four individual bounds, the reverse product bound and
nonzero characteristic generators. The arithmetic hypotheses reside in the packet. -/
theorem factorSeparation [IsDomain R]
    (L j : Fin 4 → R) (hj : ∀ i, j i ≠ 0)
    (hupper : ∀ i, j i ∣ L i)
    (hlower : (∏ i, L i) ∣ (∏ i, j i)) :
    ∀ i, Ideal.span ({L i} : Set R) = Ideal.span ({j i} : Set R) := by
  sorry

-- Nonzero generators and upper bounds cannot be dropped from the reduction.
example : (2 : ℤ) * 3 = 1 * 6 ∧
    Ideal.span ({(2 : ℤ)} : Set ℤ) ≠ Ideal.span ({(1 : ℤ)} : Set ℤ) := by
  sorry
end IntegralAlgebra

section ExistingTwistInterface
variable {K L M : Type*} [Field K] [Field L] [Field M]
variable [Algebra K L] [Algebra.IsQuadraticExtension K L] [Algebra.IsSeparable K L]
variable [Algebra K M] [Algebra L M] [IsScalarTower K L M] [DecidableEq M]
variable (E : WeierstrassCurve K) [E.IsElliptic]

/-- fourTwistLatticeDictionary starts with this existing point-group character equivariance.
Restriction to E[p^n], compatible transition maps, continuous inverse limits and ordinary
sublattices still require the supplier APIs stated in the packet. This example is the baseline
statement, not a newly planned twist or a claim that those further comparisons are built. -/
example (σ : M ≃ₐ[K] M) (P : ((E.quadraticTwist L).baseChange M).toAffine.Point) :
    E.quadraticTwistPointEquiv L M (WeierstrassCurve.Affine.Point.map σ.toAlgHom P) =
      (Algebra.IsQuadraticExtension.quadraticCharacter K L (σ.restrictNormal L) : ℤ) •
        WeierstrassCurve.Affine.Point.map σ.toAlgHom (E.quadraticTwistPointEquiv L M P) := by
  sorry
end ExistingTwistInterface


end AutomorphicCongruences

/-!
## Register of arithmetic targets

The reader carries the complete contracts and checks. These are mathematical targets,
not declarations over substitute carriers. Their prerequisites and remaining obligations
are in the reader; this register makes no implementation or closure claim.

### AutomorphicCongruences:L0/sigma-primitive-selmer
Let F be a number field, A a profinite ℤ_p-algebra, T a free A-module of finite rank with a
continuous A-linear G_F-action, and for each place v | p a G_{F_v}-stable A-direct summand T_v ⊆ T
with T/T_v free. For a finite set Σ of finite places, Sel^Σ_F(T,(T_v)) is the kernel of the
restriction from H¹(F, T ⊗_A A^∨) (A^∨ the Pontryagin dual) to the product over v ∉ Σ, v ∤ p of
H¹(I_v, T ⊗ A^∨) and over v | p of H¹(I_v, (T/T_v) ⊗ A^∨): no condition at Σ away from p, unramified
elsewhere away from p, and the ordinary (Greenberg) condition at p. Its dual X^Σ_F = Hom_A(Sel^Σ_F,
A^∨) is finitely generated over A. For an extension E/F inside a ℤ_p^d-tower, Sel^Σ_E is the direct
limit over finite subextensions and X^Σ_E the inverse limit, and Shapiro's lemma identifies
Sel^Σ_{F_∞}(T) with Sel^Σ_F(T ⊗_A Λ_{F,A}(ε_F^{-1})) as Λ_{F,A}-modules, where Λ_{F,A} = A ⊗̂
ℤ_p[[Gal(F_∞/F)]] and ε_F is the tautological character. When A is noetherian and normal,
Ch^Σ_{F,A}(T) denotes the characteristic ideal of X^Σ_F(T) and Ft^Σ_{F,A}(T) its Fitting ideal. The
p-condition is imposed for every v|p regardless of membership in Σ. For torsion X, Ch means the
divisorial ideal of its length divisor; noetherian normal does not imply principal. Use SU’s zero
characteristic-ideal convention if X is not torsion.
Hypothesis: T free of finite rank over the profinite ℤ_p-algebra A, with a continuous action of G_F;
T_v free direct summands with free quotients for v | p.
Hypothesis: Σ is finite. If S contains Σ, p and the ramification of T, the same kernel may be
computed using H¹(G_{F,S},−); membership of p in Σ does not remove its local condition.
Hypothesis: The characteristic ideal is used only over noetherian normal A, as the divisorial ideal
of height-one lengths.
Check: If T_v=T at all p-places and S contains Σ, p and ram(T), then Sel^Σ_F=H¹(G_{F,S},T⊗A^∨) when
S=Σ∪{v|p}∪ram(T) and ram(T) away from p lies in Σ.
Check: For Σ⊂Σ′ the quotient embeds in the sum of changed local-condition quotients; surjectivity
onto all local terms needs the additional hypotheses of primitive-imprimitive-comparison.
Source: SU-2014, §3.1.3, p. 18.
Source: SU-2014, §3.1.8, pp. 20–21, and Prop. 3.2.3, p. 21.
Source: CLW-v1, (1.0.1)–(1.0.2) p. 3 and proof of Thm 8.2.1, p. 79.
API SigmaSelmer.mk: Sel^Σ_F(T,(T_v)) as an A-submodule of H¹(F, T ⊗_A A^∨), defined by the local
conditions above.
API SigmaSelmer.dual: X^Σ_F = Hom_A(Sel^Σ_F, A^∨), finitely generated over A.
API SigmaSelmer.mono: Σ ⊆ Σ′ gives an inclusion Sel^Σ ⊆ Sel^{Σ′} and a surjection X^{Σ′} → X^Σ.
API SigmaSelmer.shapiro: Sel^Σ_{F_∞}(T) ≅ Sel^Σ_F(T ⊗_A Λ_{F,A}(ε_F^{-1})) as Λ_{F,A}-modules,
compatibly with the local conditions.
API SigmaSelmer.charIdeal: For finite torsion X over a noetherian normal domain, Ch is the
divisorial ideal corresponding to div(X). In a UFD this agrees with PMIA’s native charIdeal. Its
comparison with the divisorial hull of Fitt uses the finite-presentation/normal-ring theorem
requested below.
API SigmaSelmer.baseChange: For an ideal 𝔞 with A/𝔞 profinite, the natural map X^Σ(T)/𝔞 → X^Σ(T/𝔞T)
(an isomorphism under L0/selmer-specialization-control).
API SigmaSelmer.of_upstream: Agreement with the imported Selmer kernel whose local conditions are
relaxed at non-p places of Σ, unramified at other non-p places and Greenberg at every p-place.
API SigmaSelmer.ext: Two classes in Sel^Σ are equal iff their images in global H¹ agree; membership
is exactly the vanishing of the stated localization maps.
Test sigmaSelmer_full_relaxed: With T_v=T and Σ containing all non-p ramification, Sel^Σ_F is full
H¹(G_{F,Σ∪p},T⊗A^∨).
Test sigmaSelmer_trivial_coefficients: For the zero coefficient module T=0 all local/global groups
and X vanish; Ch=(1). This rejects a construction that inserts a coefficient-independent local
summand.
Test sigmaSelmer_strict_is_not_ordinary: With T_v=0 the condition is unramified at p, not strict
zero: for trivial Q_p/Z_p coefficients at Q_p, a nonzero unramified homomorphism G_Qp/I_p→Q_p/Z_p
belongs to this local kernel. A strict zero local condition excludes it.
