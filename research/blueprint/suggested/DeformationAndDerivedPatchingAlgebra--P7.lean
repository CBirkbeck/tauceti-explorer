lemma curveGradedMap_ker [NoZeroDivisors k] (d : ℕ) (hd : f.order = d) :
    RingHom.ker (curveGradedMap f).toRingHom =
      Ideal.span ({homogeneousPolynomial d f} : Set (MvPolynomial σ k)) := by
