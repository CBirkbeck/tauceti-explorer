def adicModuleDecompose :
    adicGradedModule q M →ₗ[A] ⨁ n : ℕ, adicModuleComponents q M n :=
  (DirectSum.congrLinearEquiv (adicModuleComponentEquiv q M)).toLinearMap.comp
    (adicModuleDirectSumEquiv q M).symm.toLinearMap

