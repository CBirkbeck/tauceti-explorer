example (η : DirichletCharacter K D) (hD : IsUnit (D : K)) (hpD : ¬p∣D)
    (f g : C(U,O)) (b : O) :
    b∣intrinsicIntegralTameZetaMeasure η hD hpD (f+b • g)-
      intrinsicIntegralTameZetaMeasure η hD hpD f := sorry
