example (x : kubertPrimitivePoints (Fin 1 → AddCircle (1 : ℚ)) ((1 : ℕ+) : ℕ)) (y : kubertPrimitivePoints (Fin 1 → AddCircle (1 : ℚ)) ((3 : ℕ+) : ℕ)) : kubertPrimitiveTransfer 0 (ℤ) 1 3 (by decide) (Finsupp.single x 1) y=1 := by sorry
