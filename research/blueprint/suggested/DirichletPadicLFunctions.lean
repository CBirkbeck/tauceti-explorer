local notation "U" => (ℤ_[p])ˣ
variable (η : DirichletCharacter K D) (hD : IsUnit (D : K)) (hpD : ¬p∣D)
  (h2 : IsUnit (2 : O))
-- odd_prime_certificate
example (hp : p≠2) : IsUnit (2 : O) := sorry
