-- level_zeta_mass_product
example (η : DirichletCharacter K M) (hη : η ≠ 1) (hMN : M ∣ N)
    (hM : IsUnit (M : K)) (hN : IsUnit (N : K)) (hpM : ¬p ∣ M) (hpN : ¬p ∣ N) :
    tameZetaMeasure (η.changeLevel hMN) hN hpN 1 =
