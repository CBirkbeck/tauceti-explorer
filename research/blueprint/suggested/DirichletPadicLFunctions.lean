example : (1 : DirichletCharacter ℚ 3).changeLevel (dvd_mul_left 3 2)
    (2 : ZMod (2*3)) = 0 := sorry
-- principal_polynomial_mod_three_to_six
example (Y : R) :
    (∑ a ∈ Finset.range 6, (1 : DirichletCharacter R 6) (a : ZMod 6)*Y^a) =
