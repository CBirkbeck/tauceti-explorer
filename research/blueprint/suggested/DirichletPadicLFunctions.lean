lemma kubertCartanCircleValue_sum (R : Type*) [Semiring R] (N : ℕ+) [Fintype (∀ p : (N : ℕ).primeFactors, (TruncatedWittVector p.val ((N : ℕ).factorization p.val) (GaloisField p.val ((1 : ℕ+) : ℕ)))ˣ)]
