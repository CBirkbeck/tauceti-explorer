lemma kubertPrimeFiber_prime_root_card {p M : ℕ} (hp : p.Prime) (hc : p.Coprime M) (hM : M ≠ 0)
    (z w : kubertPrimitivePoints X M)
    (hw : p • (w : X)=(z : X))
