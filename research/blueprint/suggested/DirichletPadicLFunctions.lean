example {F K : Type*} [Field F] [Fintype F] [CommRing K] [IsDomain K] (χ : MulChar F K) (ψ : AddChar F K) (hχ : χ≠1) (hψ : ψ.IsPrimitive) (hcard : Fintype.card F=9) (hneg : χ (-1)=-1) : (-gaussSum χ ψ)*(-gaussSum χ⁻¹ ψ)=(-9 : K) := by sorry
