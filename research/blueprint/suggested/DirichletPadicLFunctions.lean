example [IsDomain R] (η : DirichletCharacter R M) (hη : η ≠ 1)
    (hM : IsUnit (M : R)) (hN : IsUnit ((q*M : ℕ) : R)) (hqM : q ∣ M) (n : ℕ) :
    coeff n (tameSeries (η.changeLevel (dvd_mul_left M q)) hN) =
      coeff n (tameSeries η hM) := sorry
