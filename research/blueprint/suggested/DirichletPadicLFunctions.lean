      grossKoblitzCirclePhi p ι ℓ w.val)=
      (f/(Function.minimalPeriod (fun z : AddCircle (1 : ℚ) => p • z) (q : AddCircle (1 : ℚ)))) •
      grossKoblitzCirclePhi p ι ℓ ⟨(q : AddCircle (1 : ℚ)),grossKoblitz_circle_periodic p q hq⟩ := by sorry

end DirichletPadic

