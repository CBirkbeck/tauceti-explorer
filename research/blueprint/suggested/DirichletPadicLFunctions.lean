example (x : ℤ_[3]) (hx : 2*x=-1) : IsAlgebraic ℚ ((moritaGamma 3 x : ℤ_[3]) : ℚ_[3]) := by sorry
-- half_algebraic
example (y : ℤ_[3]) (hy : 2*y=1) : IsAlgebraic ℚ ((moritaGamma 3 y : ℤ_[3]) : ℚ_[3]) := by sorry
