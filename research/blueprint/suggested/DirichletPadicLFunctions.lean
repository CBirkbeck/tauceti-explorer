lemma kubertPrimeFiber_prime_root_partition {p M : ℕ} (hp : p.Prime) (hc : p.Coprime M)
    (z : kubertPrimitivePoints X M) :
    ∃! w : X, (p • w=(z : X) ∧
      w ∈ kubertPrimitivePoints X M) ∧
      ∀ y : X, p • y=(z : X) ↔ y=w ∨
        (y ∈ kubertPrimitivePoints X (p*M) ∧ p • y=(z : X)) := by sorry

