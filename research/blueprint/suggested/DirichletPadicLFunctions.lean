variable (f : ZMod 5 → ℤ)
variable (hf : ∀ (n : ({2} : Set ℕ+)) (a : ZMod 5), (n.val : ℕ)^0 • (∑ b : {b : ZMod 5 // (n.val : ℕ) • b=a}, f b.val)=f a)
