    (f : C((ℤ_[p])ˣ,OF)) :
    algebraMap OF OK (intrinsicIntegralTameZetaMeasure ηF hF hpD f)=
      intrinsicIntegralTameZetaMeasure η hK hpD ((jMap).comp f) := sorry

