    FreeAbelianGroup (kubertAdmissibleGenerators k (N : ℕ) N.pos.ne') →+
      (FreeAbelianGroup ((nsmulAddMonoidHom
        (α := Fin (k+1) → AddCircle (1 : ℚ)) (N : ℕ)).ker) ⧸
