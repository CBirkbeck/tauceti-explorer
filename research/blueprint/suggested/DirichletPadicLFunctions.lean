section General
variable (p : ℕ) [Fact p.Prime]
variable {K : Type*} [NormedField K] [Algebra ℤ_[p] K]
  [IsUltrametricDist K] [CompleteSpace K] [IsBoundedSMul ℤ_[p] K]
variable (n : ℕ) (hn : 1≤n) (χ : DirichletCharacter K (p^n)) (hχ : χ.IsPrimitive)
