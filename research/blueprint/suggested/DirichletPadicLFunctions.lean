      grossKoblitzSourcePhi p ι ℓ ((q+h)/m) (grossKoblitz_affine_integral p q hq m hmpos hm h))=
      (f/(Function.minimalPeriod (fun z : AddCircle (1 : ℚ) => p • z) (q : AddCircle (1 : ℚ)))) • grossKoblitzSourcePhi p ι ℓ q hq := by sorry

