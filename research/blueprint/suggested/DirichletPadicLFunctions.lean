example : (algebraMap ℚ ℂ) (-2) = iteratedDeriv 0
    (smoothedCharacterKernel (χ.ringHomComp (algebraMap ℚ ℂ)) 3) 0 ∧
    (algebraMap ℚ K) (-2) = twistedSmoothedMeasure 2 2
      (χ.ringHomComp (algebraMap ℚ K)) 3 (by norm_num) 1 := sorry
