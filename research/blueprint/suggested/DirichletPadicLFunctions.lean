example : moritaAngularMean 2 (1 : DirichletCharacter ℚ_[2] 1) 0 (fun x => (x : ℚ_[2])) ≠
    moritaFiniteMean 2 (1 : DirichletCharacter ℚ_[2] 1) 0 (fun a => a) := by sorry
