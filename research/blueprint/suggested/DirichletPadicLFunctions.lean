        (X := Fin (k+1) → AddCircle (1 : ℚ)) N 0)
          (FreeAbelianGroup.of ⟨t.val,
            kubertGeneratorProduct_generators_mem_level k (N : ℕ) N.pos.ne' t.property⟩) := by sorry

