    tameMeasure (η.changeLevel (dvd_mul_left M q)) hN hpN f =
      tameMeasure η hM hpM f - η (q : ZMod M) * tameMeasure η hM hpM
        (f.comp (⟨fun x : ℤ_[p] => (q : ℤ_[p])*x, by fun_prop⟩ : C(ℤ_[p],ℤ_[p]))) := sorry
