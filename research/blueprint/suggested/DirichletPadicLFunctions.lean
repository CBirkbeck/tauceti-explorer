-- level_zeta_positive_moment_product
example (η : DirichletCharacter K M) (hη : η ≠ 1) (hMN : M ∣ N)
    (hM : IsUnit (M : K)) (hN : IsUnit (N : K)) (hpM : ¬p ∣ M) (hpN : ¬p ∣ N) (k : ℕ) :
