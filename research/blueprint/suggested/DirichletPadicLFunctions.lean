    (v : ℕ → K) (hv : ∀ m, Tendsto (fun n => moritaAngularMean p (moritaCharacterTwist p ι (moritaTorsionCharacterMap p ι) m) n (D m)) atTop (𝓝 (v m)))
    (hexp : ∀ u : K, ‖u-1‖≤‖((2*moritaModulus p : ℕ) : ℤ_[p])‖ → NormedSpace.exp (ℓ u)=u)
