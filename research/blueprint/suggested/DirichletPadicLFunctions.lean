    algebraMap OF OK (intrinsicIntegralTameZetaMeasure ηF hF hpD f)=0 ∧
      intrinsicIntegralTameZetaMeasure η hK hpD ((jMap).comp f)=0 := sorry
end SuggestedTameCharacterDescentTests
end CharacterMeasureDescent
end
end DirichletPadic

