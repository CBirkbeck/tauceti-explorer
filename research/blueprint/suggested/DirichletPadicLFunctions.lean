example (x : ℕ → ℤ_[3]) (hx : ∀ j, 2*x j=(grossKoblitzOrbitNumerator 3 1 0 j : ℤ_[3])) : (-3 : ℤ_[3])^1*(∏ j ∈ Finset.range 1, (moritaGamma 3 (x j) : ℤ_[3])*(moritaGamma 3 (1-x j) : ℤ_[3]))=3 := by sorry
