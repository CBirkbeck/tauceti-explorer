example (η : DirichletCharacter K N) (hN : IsUnit (N : K)) (hpN : ¬p ∣ N) :
    η.conductor ≠ 0 ∧ IsUnit (η.conductor : K) ∧ ¬p ∣ η.conductor := sorry
