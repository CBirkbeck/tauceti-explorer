    (fun z => (moritaGamma 2 z : ℤ_[2])) (-x)*(fun z => (moritaGamma 2 z : ℤ_[2])) (x+1)=(-1 : ℤ_[2])^(1+(PadicInt.toZModPow 2 x).val%2+
      (PadicInt.toZModPow 2 x).val/2) := by
  sorry

