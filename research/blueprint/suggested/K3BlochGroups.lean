/-! ## V.3 Bloch-group conventions -/

section Antisymmetric

variable (A : Type) [AddCommGroup A]

/-- V.3/antisymmetric-tensor-quotient: the subgroup generated by the symmetrised
tensors `a ⊗ b + b ⊗ a`. -/
def symmetrisedSubgroup : AddSubgroup (A ⊗[ℤ] A) := by sorry

/-- Suslin's antisymmetric tensor quotient. This is not the exterior square. -/
def AntisymSquare : Type := (A ⊗[ℤ] A) ⧸ symmetrisedSubgroup A

instance : AddCommGroup (AntisymSquare A) := by sorry

/-- The bilinear constructor `a ∧ b`. -/
def antisymMk : A → A → AntisymSquare A := by sorry

@[simp] theorem antisymMk_antisymm (a b : A) :
    antisymMk A a b + antisymMk A b a = 0 := by sorry

/-- The universal property. -/
def antisymLift {B : Type} [AddCommGroup B] (f : A → A → B)
    (hf : ∀ a b, f a b + f b a = 0) : AntisymSquare A → B := by sorry

/-- Functoriality. -/
def antisymMap {B : Type} [AddCommGroup B] (f : A →+ B) :
    AntisymSquare A →+ AntisymSquare B := by sorry

/-- V.3/antisym-exterior-comparison: the kernel of the projection onto the
exterior square is a copy of `A/2A`, generated by the classes `a ∧ a`. -/
theorem antisym_toExterior_ker : True := by sorry

/-- Unit test: for `A = ℤ/2` the class `a ∧ a` is nonzero, so the quotient is not
the exterior square. -/
example : ∃ a : ZMod 2, antisymMk (Additive (ZMod 2)) (Additive.ofMul a) (Additive.ofMul a) ≠ 0 := by
  sorry

end Antisymmetric

section PreBloch

variable (F : Type) [Field F]

/-- The admissible pairs of the five-term relation: both entries different from
`0` and `1`, and different from each other. -/
structure Admissible where
  x : F
  y : F
  hx0 : x ≠ 0
  hx1 : x ≠ 1
  hy0 : y ≠ 0
  hy1 : y ≠ 1
  hxy : x ≠ y

/-- V.3/five-term-relation: the five-term element of the free abelian group on the
nonzero elements of `F`, in Suslin's normalisation. -/
def fiveTerm (p : Admissible F) : FreeAbelianGroup {a : F // a ≠ 0} := by sorry

/-- The subgroup generated by the five-term elements and by `[1]`. -/
def fiveTermSubgroup : AddSubgroup (FreeAbelianGroup {a : F // a ≠ 0}) := by sorry

/-- V.3/pre-bloch-group: the pre-Bloch group `P(F)`. -/
def PreBloch : Type := (FreeAbelianGroup {a : F // a ≠ 0}) ⧸ fiveTermSubgroup F

instance : AddCommGroup (PreBloch F) := by sorry

/-- The generator `[x]`. -/
def preBlochGen (x : F) (hx : x ≠ 0) : PreBloch F := by sorry

@[simp] theorem preBlochGen_one : preBlochGen F 1 one_ne_zero = 0 := by sorry

theorem preBloch_fiveTerm (p : Admissible F) : True := by sorry

/-- The universal property of `P(F)`. -/
def preBlochLift {B : Type} [AddCommGroup B] (f : ∀ x : F, x ≠ 0 → B) : PreBloch F → B := by sorry

/-- V.3/bloch-boundary: `[x] ↦ x ∧ (1 - x)`, with `[1] ↦ 0`. -/
def blochBoundary : PreBloch F →+ AntisymSquare (Additive Fˣ) := by sorry

/-- V.3/bloch-group: the Bloch group in Suslin's convention. -/
def Bloch : AddSubgroup (PreBloch F) := (blochBoundary F).ker

theorem mem_bloch_iff (z : PreBloch F) : z ∈ Bloch F ↔ blochBoundary F z = 0 := by sorry

/-- V.3/element-c: `c = [x] + [1 - x]` does not depend on `x`. -/
def elementC : PreBloch F := by sorry

theorem elementC_eq (x : F) (hx0 : x ≠ 0) (hx1 : x ≠ 1) : True := by sorry

/-- V.3/angle-bracket-homomorphism: `x ↦ [x] + [x⁻¹]` is a homomorphism, and
`6 • c = 0`. -/
def angleBracket : Fˣ →+ Additive (Bloch F) := by sorry

theorem six_nsmul_elementC : (6 : ℕ) • elementC F = 0 := by sorry

/-- V.3/bloch-four-term-exact: `0 → B(F) → P(F) → ~∧²Fˣ → K₂(F) → 0`. -/
theorem bloch_four_term_exact : True := by sorry

/-- V.3/small-field-conventions: the two exceptional small fields. -/
theorem bloch_field_two : True := by sorry

theorem bloch_field_three : True := by sorry

end PreBloch

section BlochWigner

/-- V.3/bloch-wigner-dilogarithm. The dilogarithm, the cut domain and the branch
conventions are owned by Polylogarithms P.1 and imported; this signature records
only the form in which this layer consumes the function. The packet's restructure
entry proposes moving this node and the next to that layer. -/
variable (dilog : ℂ → ℂ)

def blochWigner (z : ℂ) : ℝ := (dilog z).im + Complex.arg (1 - z) * Real.log (Complex.abs z)

@[simp] theorem blochWigner_zero : blochWigner dilog 0 = 0 := by sorry

@[simp] theorem blochWigner_one : blochWigner dilog 1 = 0 := by sorry

theorem blochWigner_conj (z : ℂ) : blochWigner dilog (starRingEnd ℂ z) = -blochWigner dilog z := by
  sorry

theorem blochWigner_inv (z : ℂ) (hz : z ≠ 0) : blochWigner dilog z⁻¹ = -blochWigner dilog z := by
  sorry

/-- V.3/bloch-wigner-five-term: the descended homomorphism `P(ℂ) → ℝ`. -/
def blochWignerHom : PreBloch ℂ →+ ℝ := by sorry

theorem blochWignerHom_gen (x : ℂ) (hx : x ≠ 0) :
    blochWignerHom (preBlochGen ℂ x hx) = blochWigner dilog x := by sorry

/-- The descended map kills torsion, which is the warning V.3 is built around. -/
theorem blochWignerHom_torsion (z : PreBloch ℂ) (n : ℕ) (hn : n ≠ 0) (h : (n : ℕ) • z = 0) :
    blochWignerHom z = 0 := by sorry

end BlochWigner

/-! ## V.4 Suslin's exact sequence -/

section Configuration

variable (X : Type)

/-- V.4/configuration-complex: the free abelian group on injective tuples. -/
def configChain (n : ℕ) : Type := FreeAbelianGroup {t : Fin (n + 1) → X // Function.Injective t}

instance (n : ℕ) : AddCommGroup (configChain X n) := by sorry

/-- The alternating-sum differential. -/
def configD (n : ℕ) : configChain X (n + 1) →+ configChain X n := by sorry

theorem configD_comp_configD (n : ℕ) :
    (configD X n).comp (configD X (n + 1)) = 0 := by sorry

/-- The augmentation. -/
def configAug : configChain X 0 →+ ℤ := by sorry

/-- V.4/configuration-acyclicity: for infinite `X` the augmentation is a
quasi-isomorphism. -/
theorem config_acyclic [Infinite X] : True := by sorry

end Configuration

/-- V.4/coinvariants-p1-homology: the degree-three coinvariants for the action of
the invertible two by two matrices on the projective line are `P(F)`. -/
theorem coinvariants_h3_eq_preBloch (F : Type) [Field F] : True := by sorry

/-- V.4/psi-gl2: the surjection onto the Bloch group. -/
def psiGL2 (F : Type) [Field F] : Unit → Bloch F := by sorry

theorem psiGL2_surjective (F : Type) [Field F] : True := by sorry

/-- V.4/psi-gl3: the extension to rank three, with image the Bloch group. -/
def psiGL3 (F : Type) [Field F] : Unit → PreBloch F := by sorry

theorem psiGL3_range (F : Type) [Field F] : True := by sorry

section EnhancedRoots

variable (F : Type) [Field F]

/-- V.4/enhanced-mu: the enhanced group of roots of unity. In even order it is the
unique nontrivial extension by `ℤ/2`; in odd order it is the group itself. This is
not `Tor₁^ℤ(μ(F), μ(F))`. -/
def EnhancedRoots : Type := by sorry

instance : AddCommGroup (EnhancedRoots F) := by sorry

/-- The surjection onto the roots of unity, with kernel of order at most two. -/
def enhancedToRoots : EnhancedRoots F →+ Additive (CommGroup.torsion Fˣ) := by sorry

theorem enhancedToRoots_surjective : Function.Surjective (enhancedToRoots F) := by sorry

/-- In odd order, and in particular in even characteristic, the enhancement is an
isomorphism. -/
theorem enhanced_odd_bijective (h : True) : True := by sorry

/-- A field extension induces an injection of enhanced groups. -/
theorem enhanced_map_injective (E : Type) [Field E] [Algebra F E] : True := by sorry

/-- Unit test: for `ℚ` the enhanced group is cyclic of order four while the roots
of unity have order two. -/
example : True := by sorry

end EnhancedRoots

/-- V.4/suslin-exact-sequence: `0 → μ̃(F) → K₃^ind(F) → B(F) → 0` for a field with
