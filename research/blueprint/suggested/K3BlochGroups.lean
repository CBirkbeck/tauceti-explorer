    KGroup 3 A ≃ KGroup 3 A := by sorry

/-- V.1/k3-naturality: the isomorphism is natural in the ring. -/
theorem k3EquivH3Steinberg_naturality (A B : Type) [Ring A] [Ring B] (f : A →+* B) :
    True := by sorry

/-- V.1/bar-cycle-model: evaluation of a bar 3-cycle of the Steinberg group. -/
def evalBarCycle (A : Type) [Ring A] [Group (St A)] : Unit → KGroup 3 A := by sorry

