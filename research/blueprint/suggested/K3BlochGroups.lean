/-! ## V.6 Explicit elements and certificates -/

section Certificates

variable (F : Type) [Field F] [DecidableEq F]

/-- V.6/five-term-certificate: a finite integer combination of admissible pairs,
together with a coefficient for the symbol `[1]`. -/
structure FiveTermCertificate where
  terms : Finsupp (Admissible F) ℤ
  unitCoeff : ℤ

/-- What a certificate evaluates to in the free abelian group. -/
def FiveTermCertificate.eval (c : FiveTermCertificate F) :
    FreeAbelianGroup {a : F // a ≠ 0} := by sorry

/-- Validity for a given element. -/
def FiveTermCertificate.Valid (c : FiveTermCertificate F)
    (z : FreeAbelianGroup {a : F // a ≠ 0}) : Prop := c.eval = z

/-- V.6/certificate-soundness: a valid certificate proves equality in `P(F)`. -/
theorem certificate_sound (c : FiveTermCertificate F)
    (z : FreeAbelianGroup {a : F // a ≠ 0}) (h : c.Valid z) : True := by sorry

/-- Relative completeness: equality of classes gives a certificate, with no bound
on its length. -/
theorem certificate_complete (z : FreeAbelianGroup {a : F // a ≠ 0}) : True := by sorry

/-- V.6/bloch-element-constructor: an element of `B(F)` from data and a proof that
the boundary vanishes. -/
def ofData (d : Finsupp {a : F // a ≠ 0} ℤ)
    (h : blochBoundary F (by sorry : PreBloch F) = 0) : Bloch F := by sorry

/-- Unit test: the two-term input at `x` and `1 - x` is accepted and gives `c`. -/
example (x : F) (hx0 : x ≠ 0) (hx1 : x ≠ 1) : True := by sorry

/-- V.6/root-of-unity-symbol: a single root-of-unity symbol need not lie in the
Bloch group. -/
theorem rootOfUnity_symbol_not_mem : True := by sorry

end Certificates

