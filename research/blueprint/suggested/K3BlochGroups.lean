theorem suslin_exact (F : Type) [Field F] (hF : 4 ≤ Nat.card F ∨ Infinite F) : True := by sorry

/-- V.4/tor-form-comparison: the enhanced group against the ordinary Tor group. -/
theorem enhanced_ne_tor (F : Type) [Field F] : True := by sorry

