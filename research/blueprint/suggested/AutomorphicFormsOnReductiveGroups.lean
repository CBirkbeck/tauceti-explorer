def hermitian : HermitianDatum D := sorry

def balancedCartanCoordinates : hermitian.cartan.h ≃ₗ[ℂ] (ℂ × ℂ) := sorry

def rootCoordinates : hermitian.cartan.rootIndex → ℤ × ℤ × ℤ := sorry

theorem rootCoordinates_eval (i : hermitian.cartan.rootIndex) (X : hermitian.cartan.h) :
    hermitian.cartan.R.root i X=Complex.I*((rootCoordinates i).1 : ℂ)*(balancedCartanCoordinates X).1+
      Complex.I*((rootCoordinates i).2.1 : ℂ)*(balancedCartanCoordinates X).2 := sorry

/-- π(λ,C) is first a positive-component class, retaining integral compact
parameters and the independent central coordinate, before any full-group induction. -/
def dsRep (lambda : ℝ × ℝ × ℝ) (i : Fin 4)
    (hc : lambda∈chamber i)
    (hint : ∃ a b c : ℤ, lambda=((a : ℝ),(b : ℝ),(c : ℝ)) ∧ (a+b-c)%2=1)
    (hnondegenerate : lambda.1≠lambda.2.1) : IrrAdmissible.{0} positivePair := sorry

def dsModel (lambda : ℝ × ℝ × ℝ) (i : Fin 4)
    (hc : lambda∈chamber i)
    (hint : ∃ a b c : ℤ, lambda=((a : ℝ),(b : ℝ),(c : ℝ)) ∧ (a+b-c)%2=1)
    (hnondegenerate : lambda.1≠lambda.2.1) : IrrAdmissibleModel.{0} positivePair := sorry

theorem dsModel_class (lambda : ℝ × ℝ × ℝ) (i : Fin 4)
    (hc : lambda∈chamber i) (hint : ∃ a b c : ℤ, lambda=((a : ℝ),(b : ℝ),(c : ℝ)) ∧ (a+b-c)%2=1)
    (hnondegenerate : lambda.1≠lambda.2.1) :
    Quotient.mk _ (dsModel lambda i hc hint hnondegenerate)=dsRep lambda i hc hint hnondegenerate := sorry

theorem dsRep_infChar (lambda : ℝ × ℝ × ℝ) (i : Fin 4)
    (hc : lambda∈chamber i) (hint : ∃ a b c : ℤ, lambda=((a : ℝ),(b : ℝ),(c : ℝ)) ∧ (a+b-c)%2=1)
    (hnondegenerate : lambda.1≠lambda.2.1) :
    IrrAdmissible.infChar positivePair (dsRep lambda i hc hint hnondegenerate)=infCharOf cartan (parameter lambda) := sorry

/-- The compact Levi longest element swaps the two coordinates. -/
def dualParameter (lambda : ℝ × ℝ × ℝ) : ℝ × ℝ × ℝ := (-lambda.2.1,-lambda.1,-lambda.2.2)

def positiveDual (pi : IrrAdmissible.{0} positivePair) : IrrAdmissible.{0} positivePair := sorry

theorem dsRep_dual (lambda : ℝ × ℝ × ℝ) (i : Fin 4)
    (hc : lambda∈chamber i) (hint : ∃ a b c : ℤ, lambda=((a : ℝ),(b : ℝ),(c : ℝ)) ∧ (a+b-c)%2=1)
    (hnondegenerate : lambda.1≠lambda.2.1) :
    positiveDual (dsRep lambda i hc hint hnondegenerate)=
      dsRep (dualParameter lambda) (3-i) (by sorry) (by sorry) (by sorry) := sorry

/-- Pilloni's negative compact-coordinate convention, with the source's two limits. -/
def holomorphicLimit (a c : ℤ) (ha : a<0) (hparity : (a-c)%2=1) :
    IrrAdmissible.{0} positivePair × IrrAdmissible.{0} positivePair :=
  (dsRep (-(a : ℝ),0,c) 0 (by sorry) (by sorry) (by sorry),
    dsRep (-(a : ℝ),0,c) 1 (by sorry) (by sorry) (by sorry))

theorem holomorphicLimit_parameter (a c : ℤ) (ha : a<0) (hparity : (a-c)%2=1) :
    ∀ pi∈({(holomorphicLimit a c ha hparity).1,(holomorphicLimit a c ha hparity).2} : Set _),
      IrrAdmissible.infChar positivePair pi=infCharOf cartan (parameter (a,0,c)) := sorry
end TauCeti.Automorphic.GSp4

namespace TauCeti.Automorphic.GSp4
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
open TauCeti.Automorphic.Suppliers.ReductiveGroupsPartII

/-- The Cayley basis is specified in the native four-dimensional representation. -/
def cayleyMatrix : Matrix (Fin 4) (Fin 4) ℂ :=
  !![1,0,0,-Complex.I;0,1,-Complex.I,0;0,-Complex.I,1,0;-Complex.I,0,0,1]

theorem cayleyMatrix_cartan (t1 t2 z : ℂ) :
    cayleyMatrix⁻¹*compactCartanMatrix t1 t2 z*cayleyMatrix=
      Matrix.diagonal ![z-Complex.I*t1,z-Complex.I*t2,z+Complex.I*t2,z+Complex.I*t1] := sorry

/-- Compact identity points act on the actual positive Hodge eigenspace. -/
def compactGL : CompactIdentity (K := D.K) →* Matrix.GeneralLinearGroup (Fin 2) ℂ := sorry

theorem compactGL_matrix (k : CompactIdentity (K := D.K)) (i j : Fin 2) :
    (compactGL k).val i j=(cayleyMatrix⁻¹*
      ((similitudePoints 2 ℝ k.val.val).val.1.val.map (algebraMap ℝ ℂ))*cayleyMatrix)
        ⟨2+i.val,by omega⟩ ⟨2+j.val,by omega⟩ := sorry

def hodgeCoefficient (mu : Weight) (hdom : mu.2.1≤mu.1)
    (hpar : mu∈compactCartanLattice) : Hermitian.HodgeCoefficient hermitian := sorry

def hodgeCartan (X : cartan.h) : Hermitian.fullHodgeParabolic hermitian := ⟨X.val,by sorry⟩

def compactPositiveRootSpace : Submodule ℂ Q :=
  { carrier := {X | ∀ H : cartan.h, ⁅H.val,X⁆=parameter (1,-1,0) H • X}
    zero_mem' := by sorry
    add_mem' := by sorry
    smul_mem' := by sorry }

/-- Irreducibility, integral highest weight and dimension characterize this coefficient. -/
theorem hodgeCoefficient_highestWeight (mu : Weight) (hdom : mu.2.1≤mu.1)
    (hpar : mu∈compactCartanLattice) :
    IsIrreducibleGK (hodgeCoefficient mu hdom hpar).action ∧
    (hodgeCoefficient mu hdom hpar).dimension=(mu.1-mu.2.1+1).toNat ∧
    ∃ v : Fin (hodgeCoefficient mu hdom hpar).dimension → ℂ, v≠0 ∧
      (∀ H : cartan.h, (hodgeCoefficient mu hdom hpar).action.rho (hodgeCartan H) v=
        parameter (mu.1,mu.2.1,mu.2.2) H • v) ∧
      ∀ X : compactPositiveRootSpace,
        (hodgeCoefficient mu hdom hpar).action.rho ⟨X.val,by sorry⟩ v=0 := sorry

/-- Character integration on the compact torus is part of the specification. -/
def compactTorusPoint (theta1 theta2 : ℝ) : CompactIdentity (K := D.K) := sorry

theorem compactTorusPoint_matrix (theta1 theta2 : ℝ) :
    (similitudePoints 2 ℝ (compactTorusPoint theta1 theta2).val.val).val.1.val=
      !![Real.cos theta1,0,0,Real.sin theta1;0,Real.cos theta2,Real.sin theta2,0;
        0,-Real.sin theta2,Real.cos theta2,0;-Real.sin theta1,0,0,Real.cos theta1] := sorry

theorem hodgeCoefficient_integrates (mu : Weight) (hdom : mu.2.1≤mu.1)
    (hpar : mu∈compactCartanLattice) (v : Fin (hodgeCoefficient mu hdom hpar).dimension → ℂ)
    (hv : v≠0) (hweight : ∀ H : cartan.h,
      (hodgeCoefficient mu hdom hpar).action.rho (hodgeCartan H) v=
        parameter (mu.1,mu.2.1,mu.2.2) H • v) (theta1 theta2 : ℝ) :
    (hodgeCoefficient mu hdom hpar).action.sigma (compactTorusPoint theta1 theta2) v=
      Complex.exp (Complex.I*((mu.1 : ℂ)*theta1+(mu.2.1 : ℂ)*theta2)) • v := sorry

def splitCoefficient (mu : Weight) (hdom : mu.2.1≤mu.1) :=
  hodgeCoefficient (coherentCoefficient mu) (by sorry) (coherentCoefficient_parity mu)

def realWeight (mu : Weight) : ℝ × ℝ × ℝ := (mu.1,mu.2.1,mu.2.2)

theorem dsModel_balanced (mu : Weight) (hdom : mu.2.1≤mu.1) (i : Fin 4)
    (hc : (realWeight (hcParameter mu))∈chamber i)
    (hnd : (hcParameter mu).1≠(hcParameter mu).2.1) :
    Hermitian.TensorBalanced hermitian
      (dsModel (realWeight (hcParameter mu))
        i hc (by sorry) (by sorry)).action.toGKModule (splitCoefficient mu hdom) := sorry

/-- The chosen contributing degree is retained; no additional degree vanishing is inferred. -/
theorem coherent_discreteSeries (mu : Weight) (hdom : mu.2.1≤mu.1) (i : Fin 4)
    (hc : (realWeight (hcParameter mu))∈chamber i)
    (hnd : (hcParameter mu).1≠(hcParameter mu).2.1) :
    Module.finrank ℂ (coherentCohomology D hermitian
      (dsModel (realWeight (hcParameter mu))
        i hc (by sorry) (by sorry)).action.toGKModule
      (splitCoefficient mu hdom) (dsModel_balanced mu hdom i hc hnd) i.val)=1 := sorry

/-- Pilloni's Siegel-Levi weight is transported through the Cayley basis. -/
def pilloniCoefficient (a c : ℤ) (ha : a<0) (hpar : (a-c)%2=1) :=
  hodgeCoefficient (-2,a-1,-c) (by sorry) (by sorry)

def limitModel (a c : ℤ) (ha : a<0) (hpar : (a-c)%2=1) (generic : Bool) :
    IrrAdmissibleModel.{0} positivePair :=
  dsModel (-(a : ℝ),0,c) (if generic then 1 else 0) (by sorry) (by sorry) (by sorry)

theorem holomorphicLimit_models (a c : ℤ) (ha : a<0) (hpar : (a-c)%2=1) :
    Quotient.mk _ (limitModel a c ha hpar false)=(holomorphicLimit a c ha hpar).1 ∧
    Quotient.mk _ (limitModel a c ha hpar true)=(holomorphicLimit a c ha hpar).2 := sorry

theorem limitModel_balanced (a c : ℤ) (ha : a<0) (hpar : (a-c)%2=1) (generic : Bool) :
    Hermitian.TensorBalanced hermitian (limitModel a c ha hpar generic).action.toGKModule
      (pilloniCoefficient a c ha hpar) := sorry

theorem coherent_limits (a c : ℤ) (ha : a<0) (hpar : (a-c)%2=1) :
    Module.finrank ℂ (coherentCohomology D hermitian
      (limitModel a c ha hpar false).action.toGKModule (pilloniCoefficient a c ha hpar)
      (limitModel_balanced a c ha hpar false) 0)=1 ∧
    Module.finrank ℂ (coherentCohomology D hermitian
      (limitModel a c ha hpar true).action.toGKModule (pilloniCoefficient a c ha hpar)
      (limitModel_balanced a c ha hpar true) 1)=1 := sorry
end TauCeti.Automorphic.GSp4

