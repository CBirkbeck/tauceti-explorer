-- test: sfRep_principalSeries
example (nu μ : ℂ) (epsilon : Bool) :
    IsAdmissible (principal nu μ epsilon).obj.action ∧
      IsFinitelyGenerated (principal nu μ epsilon).obj.action := sorry
end TauCeti.RealReductive.GL2

namespace TauCeti.Automorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology

section AlgebraicCoefficients
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A)

/-- The complexification is the native Hopf-algebra base change. -/
abbrev ComplexCoordinate := ℂ ⊗[ℝ] A
abbrev ComplexPoints := WithConv (ComplexCoordinate (A := A) →ₐ[ℂ] ℂ)

def complexifyRealPoint : realPoints A →* ComplexPoints (A := A) := sorry

theorem complexifyRealPoint_tmul (g : realPoints A) (z : ℂ) (a : A) :
    (complexifyRealPoint g).ofConv (z ⊗ₜ[ℝ] a)=z*(g.ofConv a : ℂ) := sorry

/-- Native cotangent base change identifies complex counit derivations. -/
def complexificationLie : Derivation ℂ (ComplexCoordinate (A := A))
    (TauCeti.Bialgebra.CounitAlgebra ℂ (ComplexCoordinate (A := A)) ℂ) ≃ₗ⁅ℂ⁆
      complexAlgebraicLie A := sorry

def torusCounitDerivation (r : ℕ) (x : Fin r → ℂ) :
    Derivation ℂ (MonoidAlgebra ℂ (Multiplicative (Fin r →₀ ℤ)))
      (TauCeti.Bialgebra.CounitAlgebra ℂ
        (MonoidAlgebra ℂ (Multiplicative (Fin r →₀ ℤ))) ℂ) := sorry

theorem torusCounitDerivation_monomial (r : ℕ) (x : Fin r → ℂ)
    (lam : Fin r →₀ ℤ) (z : ℂ) :
    TauCeti.Bialgebra.CounitAlgebra.algEquivSelf ℂ _ ℂ
      (torusCounitDerivation r x (MonoidAlgebra.single (Multiplicative.ofAdd lam) z))=
        z*∑ i, (lam i : ℂ)*x i := sorry

/-- Supplier Borel/torus data include the actual integral character lattice.
The map to the Cartan is the differential of the algebraic torus inclusion. -/
structure SplitCoefficientDatum (D : Datum A) where
  rank : ℕ
  torusInclusion : ComplexCoordinate (A := A) →ₐc[ℂ]
    MonoidAlgebra ℂ (Multiplicative (Fin rank →₀ ℤ))
  closedImmersion : Function.Surjective torusInclusion
  cartan : ReductiveCartan (complexAlgebraicLie A)
  torusLie : (Fin rank → ℂ) ≃ₗ[ℂ] cartan.h
  torusLie_differential : ∀ x, (torusLie x).val=
    complexificationLie (TauCeti.derivationCompLieHom (B := ℂ)
      torusInclusion (torusCounitDerivation rank x))
  differential : (Fin rank →₀ ℤ) →ₗ[ℤ] Module.Dual ℂ cartan.h
  differential_torus : ∀ lam x, differential lam (torusLie x)=∑ i, (lam i : ℂ)*x i
  injective : Function.Injective differential
  spans : Submodule.span ℂ (Set.range differential)=⊤
  rootIsIntegral : ∀ i : cartan.rootIndex, ∃ x, differential x=cartan.R.root i
  longest : cartan.R.weylGroup
  longest_negative : ∀ i, cartan.b.IsPos i →
    ∃ j, ¬cartan.b.IsPos j ∧ longest • cartan.R.root i=cartan.R.root j
  longest_integral : ∀ x, ∃ y, differential y=longest • differential x

/-- An algebraic representation carries its coaction, rather than an abstract Lie action. -/
structure AlgebraicCoefficient where
  dimension : ℕ
  [comodule : Comodule ℂ (ComplexCoordinate (A := A)) (Fin dimension → ℂ)]
attribute [instance] AlgebraicCoefficient.comodule

namespace AlgebraicCoefficient
variable {D}

def points (V : AlgebraicCoefficient (A := A)) : Representation ℂ
    (ComplexPoints (A := A)) (Fin V.dimension → ℂ) :=
  TauCeti.Comodule.basePointsRepresentation (H := ComplexCoordinate (A := A)) _

def action (V : AlgebraicCoefficient (A := A)) :
    GKModule D.pair (Fin V.dimension → ℂ) := sorry

theorem action_compact (V : AlgebraicCoefficient (A := A)) (k : D.K)
    (v : Fin V.dimension → ℂ) :
    (V.action (D := D)).sigma k v=V.points (complexifyRealPoint k.val) v := sorry

/-- Differentiation is characterized by the actual algebraic comodule orbit map. -/
theorem action_differential (V : AlgebraicCoefficient (A := A)) (X : algebraicRealLie A)
    (v : Fin V.dimension → ℂ) :
    (V.action (D := D)).rho (1 ⊗ₜ[ℝ] X) v=
      mfderiv 𝓘(ℝ,realPoints.Model A) 𝓘(ℝ,Fin V.dimension → ℂ)
        (fun g : realPoints A => V.points (complexifyRealPoint g) v) 1
        ((realPoints_lieAlgebra A).symm X) := sorry

def dual (V : AlgebraicCoefficient (A := A)) : AlgebraicCoefficient (A := A) := sorry

def dualEquiv (V : AlgebraicCoefficient (A := A)) :
    (Fin V.dual.dimension → ℂ) ≃ₗ[ℂ] Module.Dual ℂ (Fin V.dimension → ℂ) := sorry

theorem dualEquiv_action (V : AlgebraicCoefficient (A := A)) (g : ComplexPoints (A := A))
    (l : Fin V.dual.dimension → ℂ) (v : Fin V.dimension → ℂ) :
    V.dualEquiv (V.dual.points g l) v=V.dualEquiv l (V.points g⁻¹ v) := sorry

/-- Algebraic descent retains the coefficient Hopf algebra and its scalar extension. -/
structure FieldModel (V : AlgebraicCoefficient (A := A)) (E : Subfield ℂ) where
  coordinate : Type
  [ring : CommRing coordinate]
  [hopf : HopfAlgebra E coordinate]
  [finiteType : Algebra.FiniteType E coordinate]
  complexification : (ℂ ⊗[E] coordinate) ≃ₐc[ℂ] ComplexCoordinate (A := A)
  [coefficient : Comodule E coordinate (Fin V.dimension → E)]
  scalarVector : (ℂ ⊗[E] (Fin V.dimension → E)) ≃ₗ[ℂ] (Fin V.dimension → ℂ)
  scalarVector_tmul : ∀ (z : ℂ) (v : Fin V.dimension → E),
    scalarVector (z ⊗ₜ[E] v)=fun i => z*(v i : ℂ)
  baseChangedPoint : ComplexPoints (A := A) →* WithConv (coordinate →ₐ[E] ℂ)
  baseChangedPoint_apply : ∀ g a,
    (baseChangedPoint g).ofConv a=g.ofConv (complexification (1 ⊗ₜ[E] a))
  coaction_baseChange : ∀ g z v,
    scalarVector (TauCeti.Comodule.pointsRepresentation (H := coordinate)
      (Fin V.dimension → E) (baseChangedPoint g) (z ⊗ₜ[E] v))=
      V.points g (scalarVector (z ⊗ₜ[E] v))

end AlgebraicCoefficient

/-- Weights belong to the character lattice of the chosen algebraic torus. -/
abbrev AlgebraicWeight {D : Datum A} (S : SplitCoefficientDatum D) := Fin S.rank →₀ ℤ
namespace AlgebraicWeight
variable {D} (S : SplitCoefficientDatum D)

def IsDominant (lam : AlgebraicWeight S) : Prop :=
  ∀ i∈S.cartan.b.support, ∃ m : ℕ, S.differential lam (S.cartan.R.coroot i)=(m : ℂ)

def IsRegular (lam : AlgebraicWeight S) : Prop :=
  ∀ i : S.cartan.rootIndex,
    (S.differential lam+S.cartan.rho) (S.cartan.R.coroot i)≠0

def dualWeight (lam : AlgebraicWeight S) : AlgebraicWeight S := sorry

theorem dualWeight_differential (lam : AlgebraicWeight S) :
    S.differential (dualWeight S lam)=-(S.longest • S.differential lam) := sorry

/-- Highest-weight integration is the AF.4 theorem; RG supplies the comodule carrier. -/
def rep (lam : AlgebraicWeight S) (hlam : IsDominant S lam) : AlgebraicCoefficient (A := A) := sorry

theorem rep_highestWeight (lam : AlgebraicWeight S) (hlam : IsDominant S lam) :
    IsIrreducibleGK ((rep S lam hlam).action (D := D)) ∧
      ∃ v : Fin (rep S lam hlam).dimension → ℂ,
        IsCartanHighestWeight S.cartan ((rep S lam hlam).action (D := D))
          (S.differential lam) v := sorry

theorem highestWeight_classification (V : AlgebraicCoefficient (A := A))
    (hV : IsIrreducibleGK (V.action (D := D))) :
    ∃! lam : AlgebraicWeight S, ∃ hlam : IsDominant S lam,
      Nonempty (GKModule.Hom (V.action (D := D)) ((rep S lam hlam).action (D := D))) ∧
      ∃ e : (Fin V.dimension → ℂ) ≃ₗ[ℂ] (Fin (rep S lam hlam).dimension → ℂ),
        ∀ g v, e (V.points g v)=(rep S lam hlam).points g (e v) := sorry

def rep_dual (lam : AlgebraicWeight S) (hlam : IsDominant S lam)
    (hdual : IsDominant S (dualWeight S lam)) :
    (Fin (rep S lam hlam).dual.dimension → ℂ) ≃ₗ[ℂ]
      (Fin (rep S (dualWeight S lam) hdual).dimension → ℂ) := sorry

theorem rep_dual_intertwines (lam : AlgebraicWeight S) (hlam : IsDominant S lam)
    (hdual : IsDominant S (dualWeight S lam)) (g : ComplexPoints (A := A)) (v) :
    rep_dual S lam hlam hdual ((rep S lam hlam).dual.points g v)=
      (rep S (dualWeight S lam) hdual).points g (rep_dual S lam hlam hdual v) := sorry

theorem infChar_rep (lam : AlgebraicWeight S) (hlam : IsDominant S lam) :
    HasInfChar ((rep S lam hlam).action (D := D))
      (infCharOf S.cartan (S.differential lam+S.cartan.rho)) ∧
    HasInfChar ((rep S lam hlam).dual.action (D := D))
      (infCharOf S.cartan (-(S.differential lam+S.cartan.rho))) := sorry
end AlgebraicWeight
end AlgebraicCoefficients
end TauCeti.Automorphic

