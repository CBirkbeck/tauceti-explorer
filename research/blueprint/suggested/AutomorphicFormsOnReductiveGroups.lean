namespace TauCeti.Automorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
/-- BHR in the verified GSp₄ coordinate convention. -/
theorem coherentCohomology_discreteSeries (mu : GSp4.Weight) (hdom : mu.2.1≤mu.1) (i : Fin 4)
    (hc : (GSp4.realWeight (GSp4.hcParameter mu))∈GSp4.chamber i)
    (hnd : (GSp4.hcParameter mu).1≠(GSp4.hcParameter mu).2.1) :
    Module.finrank ℂ (coherentCohomology GSp4.D GSp4.hermitian
      (GSp4.dsModel (GSp4.realWeight (GSp4.hcParameter mu))
        i hc (by sorry) (by sorry)).action.toGKModule
      (GSp4.splitCoefficient mu hdom) (GSp4.dsModel_balanced mu hdom i hc hnd) i.val)=1 := sorry
end TauCeti.Automorphic

namespace TauCeti.RealReductive
open TauCeti.RelativeLieCohomology
section IdentityUnitary
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A)
abbrev IdentityGroup := Subgroup.connectedComponentOfOne (realPoints A)
instance : ChartedSpace (realPoints.Model A) (IdentityGroup (A := A)) := sorry
instance : LieGroup 𝓘(ℝ,realPoints.Model A) ∞ (IdentityGroup (A := A)) := sorry
instance : MeasurableSpace (IdentityGroup (A := A) ⧸ Subgroup.center (IdentityGroup (A := A))) := borel _
instance : BorelSpace (IdentityGroup (A := A) ⧸ Subgroup.center (IdentityGroup (A := A))) := ⟨rfl⟩

def identityCompactInclusion : CompactIdentity (K := D.K) →* IdentityGroup (A := A) := sorry

theorem identityCompactInclusion_val (k : CompactIdentity (K := D.K)) :
    (identityCompactInclusion D k).val=k.val.val := sorry

def identityHaar : Measure (IdentityGroup (A := A) ⧸ Subgroup.center (IdentityGroup (A := A))) := sorry
instance : (identityHaar (A := A)).IsHaarMeasure := sorry

/-- The positive-component realization includes both compact and Lie intertwinings. -/
structure IdentityUnitaryModel (M : IrrAdmissibleModel.{0} D.pair.identityComponent) where
  H : Type
  [normed : NormedAddCommGroup H]
  [inner : InnerProductSpace ℂ H]
  [complete : CompleteSpace H]
  action : ContRepresentation ℂ (IdentityGroup (A := A)) H
  joint : Continuous (fun gv : IdentityGroup (A := A) × H => action gv.1 gv.2)
  unitary : ∀ g v, ‖action g v‖=‖v‖
  character : Subgroup.center (IdentityGroup (A := A)) →* ℂˣ
  central : ∀ z v, action z.val v=(character z : ℂ) • v
  vectors : M.carrier ≃ₗ[ℂ] kFinite (action.toRepresentation.comp (identityCompactInclusion D))
  compact : ∀ k v, (vectors (M.action.sigma k v)).val=action (identityCompactInclusion D k) (vectors v).val
  smooth : ∀ v, ContMDiff 𝓘(ℝ,realPoints.Model A) 𝓘(ℝ,H) ∞
    (fun g => action g (vectors v).val)
  derivative : ∀ (X : algebraicRealLie A) v,
    (vectors (M.action.rho (1 ⊗ₜ[ℝ] X) v)).val=
      mfderiv 𝓘(ℝ,realPoints.Model A) 𝓘(ℝ,H)
        (fun g => action g (vectors v).val) 1 ((realPoints_lieAlgebra A).symm X)
attribute [instance] IdentityUnitaryModel.normed IdentityUnitaryModel.inner IdentityUnitaryModel.complete

def IdentityUnitaryModel.coefficients {M : IrrAdmissibleModel.{0} D.pair.identityComponent}
    (U : IdentityUnitaryModel D M) : CoefficientRealization (H := U.H)
      (Subgroup.center (IdentityGroup (A := A))) :=
  ⟨U.action,U.joint,U.character,U.central⟩

def IsIdentityTempered (pi : IrrAdmissible.{0} D.pair.identityComponent) : Prop :=
  ∃ M : IrrAdmissibleModel.{0} D.pair.identityComponent, Quotient.mk _ M=pi ∧
    ∃ U : IdentityUnitaryModel D M, IsTempered (identityCompactInclusion D) (by sorry)
      (identityHaar (A := A)) (U.coefficients D)

def IsIdentityDiscreteSeries (pi : IrrAdmissible.{0} D.pair.identityComponent) : Prop :=
  ∃ M : IrrAdmissibleModel.{0} D.pair.identityComponent, Quotient.mk _ M=pi ∧
    ∃ U : IdentityUnitaryModel D M, IsSquareIntegrable (identityCompactInclusion D) (by sorry)
      (identityHaar (A := A)) (U.coefficients D)

def identityTwist (χ : SmoothCharacter D) :
    IrrAdmissible.{0} D.pair.identityComponent → IrrAdmissible.{0} D.pair.identityComponent := sorry

theorem identityTwist_compact (χ : SmoothCharacter D)
    (M : IrrAdmissibleModel.{0} D.pair.identityComponent) :
    ∃ N : IrrAdmissibleModel.{0} D.pair.identityComponent,
      Quotient.mk _ N=identityTwist D χ (Quotient.mk _ M) ∧
      ∃ e : M.carrier ≃ₗ[ℂ] N.carrier,
        (∀ k v, N.action.sigma k (e v)=(χ.character k.val.val : ℂ) • e (M.action.sigma k v)) ∧
        ∀ X v, N.action.rho X (e v)=e (M.action.rho X v)+χ.differential D X • e v := sorry

def IsIdentityEssentiallyTempered (pi : IrrAdmissible.{0} D.pair.identityComponent) : Prop :=
  ∃ χ : SmoothCharacter D, IsIdentityTempered D (identityTwist D χ pi)
def IsIdentityEssentiallyUnitary (pi : IrrAdmissible.{0} D.pair.identityComponent) : Prop :=
  ∃ χ : SmoothCharacter D, ∃ M : IrrAdmissibleModel.{0} D.pair.identityComponent,
    Quotient.mk _ M=identityTwist D χ pi ∧ Nonempty (IdentityUnitaryModel D M)
end IdentityUnitary
end TauCeti.RealReductive

namespace TauCeti.Automorphic.GSp4
open TauCeti.RealReductive TauCeti.RelativeLieCohomology

theorem dsRep_tempered (lambda : ℝ × ℝ × ℝ) (i : Fin 4)
    (hc : lambda∈chamber i) (hint : ∃ a b c : ℤ, lambda=((a : ℝ),(b : ℝ),(c : ℝ)) ∧ (a+b-c)%2=1)
    (hnd : lambda.1≠lambda.2.1) :
    IsIdentityEssentiallyTempered D (dsRep lambda i hc hint hnd) := sorry

theorem dsRep_discrete (lambda : ℝ × ℝ × ℝ) (i : Fin 4)
    (hc : lambda∈chamber i) (hint : ∃ a b c : ℤ, lambda=((a : ℝ),(b : ℝ),(c : ℝ)) ∧ (a+b-c)%2=1)
    (hnd : lambda.1≠lambda.2.1) :
    (∃ χ : SmoothCharacter D, IsIdentityDiscreteSeries D
      (identityTwist D χ (dsRep lambda i hc hint hnd))) ↔ lambda∈openChamber i := sorry

/-- The threshold uses −λ₁, and the central weight is held fixed in each comparison. -/
theorem coherent_classification_largeWeight :
    ∃ R : ℝ, 0<R ∧ ∀ (a c : ℤ) (ha : a<0) (hpar : (a-c)%2=1), R≤-(a : ℝ) →
      ∀ M : IrrAdmissibleModel.{0} positivePair,
        IsIdentityEssentiallyUnitary D (Quotient.mk _ M) →
        ∀ hbal : Hermitian.TensorBalanced hermitian M.action.toGKModule (pilloniCoefficient a c ha hpar),
          (Nontrivial (coherentCohomology D hermitian M.action.toGKModule
            (pilloniCoefficient a c ha hpar) hbal 0) →
            Quotient.mk _ M=(holomorphicLimit a c ha hpar).1) ∧
          (Nontrivial (coherentCohomology D hermitian M.action.toGKModule
            (pilloniCoefficient a c ha hpar) hbal 1) →
            Quotient.mk _ M=(holomorphicLimit a c ha hpar).2) := sorry
end TauCeti.Automorphic.GSp4

namespace TauCeti.Automorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
section Mirkovic
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A) (T : HermitianDatum D)

/-- Identity-component version of the native Cartan/chamber construction. -/
def identityDiscreteSeries (C : CompactCartan D) (p : DiscreteSeriesParameter C)
    (hnd : p.NonDegenerate) : IrrAdmissible.{0} D.pair.identityComponent := sorry

theorem identityDiscreteSeries_infChar (C : CompactCartan D) (p : DiscreteSeriesParameter C)
    (hnd : p.NonDegenerate) :
    IrrAdmissible.infChar D.pair.identityComponent (identityDiscreteSeries D C p hnd)=
      infCharOf C.roots p.lambda := sorry

theorem identityDiscreteSeries_tempered (C : CompactCartan D) (p : DiscreteSeriesParameter C)
    (hnd : p.NonDegenerate) : IsIdentityTempered D (identityDiscreteSeries D C p hnd) := sorry

theorem identityDiscreteSeries_regular (C : CompactCartan D) (p : DiscreteSeriesParameter C)
    (hnd : p.NonDegenerate) :
    IsIdentityDiscreteSeries D (identityDiscreteSeries D C p hnd) ↔ p.Regular := sorry

/-- A limit is a classified module with a noncompact wall, not a bare infinitesimal character. -/
def IsIdentityNondegenerateLimit (pi : IrrAdmissible.{0} D.pair.identityComponent) : Prop :=
  ∃ C : CompactCartan D, ∃ p : DiscreteSeriesParameter C,
    ∃ hnd : p.NonDegenerate, ¬p.Regular ∧ pi=identityDiscreteSeries D C p hnd

/-- The actual Hodge-pair cohomology is the hypothesis, after central normalization. -/
theorem isDiscreteSeries_of_coherentCohomology_ne_zero
    (M : IrrAdmissibleModel.{0} D.pair.identityComponent)
    (htemp : IsIdentityEssentiallyTempered D (Quotient.mk _ M))
    (σ : Hermitian.HodgeCoefficient T) (hbal : Hermitian.TensorBalanced T M.action.toGKModule σ)
    (q : ℕ) (hcoh : Nontrivial (coherentCohomology D T M.action.toGKModule σ hbal q)) :
    ∃ χ : SmoothCharacter D,
      IsIdentityDiscreteSeries D (identityTwist D χ (Quotient.mk _ M)) ∨
      IsIdentityNondegenerateLimit D (identityTwist D χ (Quotient.mk _ M)) := sorry
end Mirkovic
end TauCeti.Automorphic

namespace TauCeti.RealReductive
open TauCeti.RelativeLieCohomology
section CompactHighestWeights
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] {D : Datum A}

def HasCompactHighestWeight (C : CompactCartan D) {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : GKModule D.pair.identityComponent V) (mu : Module.Dual ℂ C.roots.h) (v : V) : Prop :=
  v≠0 ∧ (∀ H : C.roots.h, M.rho H.val v=mu H • v) ∧
    ∀ i : C.roots.rootIndex, C.roots.b.IsPos i → i∈C.compactRoots →
      ∀ X : complexAlgebraicLie A,
        (∀ H : C.roots.h, ⁅H.val,X⁆=C.roots.R.root i H • X) → M.rho X v=0
end CompactHighestWeights
end TauCeti.RealReductive

namespace TauCeti.Automorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
section IdentityCartanConsequences
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A) (T : HermitianDatum D)

theorem identityDiscreteSeries_lowestKType (C : CompactCartan D) (p : DiscreteSeriesParameter C)
    (hnd : p.NonDegenerate) :
    ∃ M : IrrAdmissibleModel.{0} D.pair.identityComponent,
      Quotient.mk _ M=identityDiscreteSeries D C p hnd ∧
      (∃ v, HasCompactHighestWeight C M.action.toGKModule
        (p.lambda+C.rhoNoncompact-C.rhoCompact) v) ∧
      ∀ mu : Module.Dual ℂ C.roots.h, (∃ v, HasCompactHighestWeight C M.action.toGKModule mu v) →
        ∃ n : C.roots.rootIndex → ℕ,
          mu=p.lambda+C.rhoNoncompact-C.rhoCompact+
            ∑ i : C.roots.rootIndex,
              if C.roots.b.IsPos i ∧ i∉C.compactRoots then (n i : ℂ) • C.roots.R.root i else 0 := by
  classical
  sorry
end IdentityCartanConsequences
end TauCeti.Automorphic

namespace TauCeti.Automorphic.GSp4
open TauCeti.RealReductive TauCeti.RelativeLieCohomology

theorem positiveDual_model (M : IrrAdmissibleModel.{0} positivePair) :
    ∃ N : IrrAdmissibleModel.{0} positivePair,
      Quotient.mk _ N=positiveDual (Quotient.mk _ M) ∧
      ∃ e : N.carrier ≃ₗ[ℂ] kFinite (contragredient M.action.toGKModule),
        (∀ k v, e (N.action.sigma k v)=(restrictedDual M.action.toGKModule).sigma k (e v)) ∧
        ∀ X v, e (N.action.rho X v)=(restrictedDual M.action.toGKModule).rho X (e v) := sorry
end TauCeti.Automorphic.GSp4

namespace TauCeti.Automorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
section FundamentalCartans
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A)

/-- A fundamental θ-stable Cartan has a maximal compact part; it need not itself
be compact. This is the Cartan used by Vogan–Zuckerman in unequal rank. -/
structure FundamentalCartan where
  roots : ReductiveCartan (complexAlgebraicLie A)
  theta_stable : ∀ X : roots.h,
    (LinearMap.baseChange ℂ D.thetaLie.toLinearMap) X.val∈roots.h
  compactPart : LieSubalgebra ℂ (complexAlgebraicLie A)
  compactPart_eq : compactPart=roots.h ⊓ D.pair.iota.range
  compactCartan : (compactPart.comap D.pair.iota).IsCartanSubalgebra

def FundamentalCartan.compactInclusion (C : FundamentalCartan D) : C.compactPart →ₗ[ℂ] C.roots.h :=
  { toFun := fun X => ⟨X.val,by sorry⟩
    map_add' := by sorry
    map_smul' := by sorry }

def FundamentalCartan.compactRoots (C : FundamentalCartan D) : Set C.roots.rootIndex :=
  {i | ∃ X : D.pair.iota.range, X.val≠0 ∧ ∀ H : C.roots.h,
    ⁅H.val,X.val⁆=C.roots.R.root i H • X.val}

def Datum.fundamentalCartan : FundamentalCartan D := sorry

def HasFundamentalCompactHighestWeight (C : FundamentalCartan D)
    {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : GKModule D.pair.identityComponent V) (mu : Module.Dual ℂ C.compactPart) (v : V) : Prop :=
  v≠0 ∧ (∀ H : C.compactPart, M.rho H.val v=mu H • v) ∧
    ∀ i : C.roots.rootIndex, C.roots.b.IsPos i → i∈C.compactRoots →
      ∀ X : complexAlgebraicLie A,
        (∀ H : C.roots.h, ⁅H.val,X⁆=C.roots.R.root i H • X) → M.rho X v=0
end FundamentalCartans

section VoganZuckerman
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A) (C : FundamentalCartan D)
local notation "g" => complexAlgebraicLie A

/-- A θ-stable parabolic is fixed by its actual imaginary compact-Cartan element. -/
structure ThetaStableData where
  x : C.roots.h
  imaginary_compact : ∃ X∈D.compactLie, x.val=Complex.I • (1 ⊗ₜ[ℝ] X)
  real_roots : ∀ i : C.roots.rootIndex, (C.roots.R.root i x).im=0
  positiveSystem : C.roots.R.Base
  compatible : ∀ i : C.roots.rootIndex, positiveSystem.IsPos i →
    0≤(C.roots.R.root i x).re
  compactPositive : ∀ i : C.roots.rootIndex, i∈C.compactRoots →
    (positiveSystem.IsPos i ↔ C.roots.b.IsPos i)

namespace ThetaStableData
variable {D C} (S : ThetaStableData D C)

def adaptedCartan : ReductiveCartan g := { C.roots with b := S.positiveSystem }

def rho : Module.Dual ℂ C.roots.h := (S.adaptedCartan).rho

def levi : LieSubalgebra ℂ g where
  carrier := {Y | ⁅S.x.val,Y⁆=0}
  add_mem' := by sorry
  zero_mem' := by sorry
  smul_mem' := by sorry
  lie_mem' := by sorry

def radical (_S : ThetaStableData D C) : LieSubalgebra ℂ g := sorry

theorem radical_span : S.radical.toSubmodule=Submodule.span ℂ
    {Y | ∃ i : C.roots.rootIndex, 0<(C.roots.R.root i S.x).re ∧
      ∀ H : C.roots.h, ⁅H.val,Y⁆=C.roots.R.root i H • Y} := sorry

def parabolic : LieSubalgebra ℂ g := S.levi ⊔ S.radical

def leviGroup : Subgroup (realPoints A) where
  carrier := {h | (LinearMap.baseChange ℂ (realPoints.algebraicAd h)) S.x.val=S.x.val}
  one_mem' := by sorry
  mul_mem' := by sorry
  inv_mem' := by sorry

/-- The carrier uses the actual scalar-extended adjoint action. -/
theorem leviGroup_mem (h : realPoints A) : h∈S.leviGroup ↔
    (LinearMap.baseChange ℂ (realPoints.algebraicAd h)) S.x.val=S.x.val := sorry

def realLevi : LieSubalgebra ℝ (algebraicRealLie A) where
  carrier := {X | (1 : ℂ) ⊗ₜ[ℝ] X∈S.levi}
  add_mem' := by sorry
  zero_mem' := by sorry
  smul_mem' := by sorry
  lie_mem' := by sorry
abbrev leviModel := EuclideanSpace ℝ (Fin (Module.finrank ℝ S.realLevi))
instance : ChartedSpace S.leviModel S.leviGroup := sorry
instance : LieGroup 𝓘(ℝ,S.leviModel) ∞ S.leviGroup := sorry

def leviTangent : GroupLieAlgebra 𝓘(ℝ,S.leviModel) S.leviGroup ≃ₗ[ℝ] S.realLevi := sorry

def cartanInLevi : C.roots.h →ₗ[ℂ] S.levi :=
  { toFun := fun X => ⟨X.val,by sorry⟩
    map_add' := by sorry
    map_smul' := by sorry }

structure Parameter where
  character : S.leviGroup →* ℂˣ
  smooth : ContMDiff 𝓘(ℝ,S.leviModel) 𝓘(ℝ,ℂ) ∞ (fun h => (character h : ℂ))
  unitary : ∀ h, ‖(character h : ℂ)‖=1
  differential : Module.Dual ℂ S.levi
  derivative : ∀ X : GroupLieAlgebra 𝓘(ℝ,S.leviModel) S.leviGroup,
    mfderiv 𝓘(ℝ,S.leviModel) 𝓘(ℝ,ℂ) (fun h => (character h : ℂ)) 1 X=
      differential ⟨1 ⊗ₜ[ℝ] (S.leviTangent X).val,by sorry⟩
  dominant : ∀ i : C.roots.rootIndex, 0<(C.roots.R.root i S.x).re →
    0≤(differential (S.cartanInLevi (C.roots.R.coroot i))).re

variable (lam : S.Parameter)
def weight : Module.Dual ℂ C.roots.h := lam.differential.comp S.cartanInLevi

def noncompact (_S : ThetaStableData D C) : Submodule ℂ g := Submodule.span ℂ
  {Y | ∃ X∈D.noncompactLie, Y=1 ⊗ₜ[ℝ] X}

def radicalNoncompact := S.radical.toSubmodule ⊓ S.noncompact

def rhoRadicalNoncompact : Module.Dual ℂ C.roots.h := by
  classical
  exact (1/2 : ℂ) • ∑ i : C.roots.rootIndex,
    if 0<(C.roots.R.root i S.x).re ∧ i∉C.compactRoots then C.roots.R.root i else 0

def induced (_S : ThetaStableData D C) (_lam : _S.Parameter) : IrrAdmissibleModel.{0} D.pair := sorry

def IsCharacterized (M : IrrAdmissibleModel.{0} D.pair) : Prop :=
  Nonempty (UnitaryModel D M) ∧
  HasInfChar M.action.toGKModule (infCharOf C.roots (S.weight lam+S.rho)) ∧
  (∃ v, HasFundamentalCompactHighestWeight D C
    (GKModule.restrict D.pair.identityComponentHom M.action.toGKModule)
      ((S.weight lam+2 • S.rhoRadicalNoncompact).comp C.compactInclusion) v) ∧
  ∀ mu : Module.Dual ℂ C.compactPart,
    (∃ v, HasFundamentalCompactHighestWeight D C
      (GKModule.restrict D.pair.identityComponentHom M.action.toGKModule) mu v) →
    ∃ n : C.roots.rootIndex → ℕ, mu=(S.weight lam+2 • S.rhoRadicalNoncompact+
      ∑ i : C.roots.rootIndex,
        if 0<(C.roots.R.root i S.x).re ∧ i∉C.compactRoots then
          (n i : ℂ) • C.roots.R.root i else 0).comp C.compactInclusion

/-- Invariants are on actual Levi∩K alternating forms, including its centre. -/
def leviNoncompact := S.levi.toSubmodule ⊓ S.noncompact

def leviCompactAction : Representation ℂ ↥(S.leviGroup⊓D.K) S.leviNoncompact := sorry

theorem leviCompactAction_val (k : ↥(S.leviGroup⊓D.K)) (X : S.leviNoncompact) :
    (S.leviCompactAction k X).val=D.pair.Ad ⟨k.val,k.property.2⟩ X.val := sorry

def alternatingInvariants (q : ℕ) : Submodule ℂ
    (AlternatingMap ℂ S.leviNoncompact ℂ (Fin q)) where
  carrier := {f | ∀ k : ↥(S.leviGroup⊓D.K), ∀ X,
    f (fun i => S.leviCompactAction k (X i))=f X}
  zero_mem' := by sorry
  add_mem' := by sorry
  smul_mem' := by sorry
end ThetaStableData

/-- General connected reductive classification, using a fundamental θ-stable Cartan. -/
theorem voganZuckerman (hconn : ConnectedSpace (realPoints A)) :
    (∀ (S : ThetaStableData D C) (lam : S.Parameter),
      S.IsCharacterized lam (S.induced lam) ∧
      ∀ M : IrrAdmissibleModel.{0} D.pair, S.IsCharacterized lam M →
        (IrrAdmissibleModel.isoSetoid D.pair).r M (S.induced lam)) ∧
    (∀ (M : IrrAdmissibleModel.{0} D.pair) (U : UnitaryModel D M)
      (F : AlgebraicCoefficient (A := A)), IsIrreducibleGK (F.action (D := D)) →
      IsCohomologicalWith M.action.toGKModule (F.dual.action (D := D)) →
      ∃ (S : ThetaStableData D C) (lam : S.Parameter),
        (IrrAdmissibleModel.isoSetoid D.pair).r M (S.induced lam) ∧
        (∃ v, IsCartanHighestWeight S.adaptedCartan (F.action (D := D)) (S.weight lam) v) ∧
        ∀ q : ℕ, Nonempty ((cohomology (GKModule.tensorFinite D.pair M.action.toGKModule
          (F.dual.action (D := D))) (Module.finrank ℂ S.radicalNoncompact+q)) ≃ₗ[ℂ]
            S.alternatingInvariants q)) := sorry
end VoganZuckerman
end TauCeti.Automorphic

namespace TauCeti.Automorphic.GSp2g
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
open TauCeti.Automorphic.Suppliers.ReductiveGroupsPartII

abbrev D (n : ℕ) := similitudeDatum n

def hermitian (n : ℕ) : HermitianDatum (D n) := sorry

def compactCartan (n : ℕ) : CompactCartan (D n) := sorry

def compactCoordinates (n : ℕ) : (compactCartan n).roots.h ≃ₗ[ℂ] ((Fin n → ℂ) × ℂ) := sorry

theorem compactCoordinates_matrix (n : ℕ) (H : (compactCartan n).roots.h) (i j : Fin (2*n)) :
    (similitudeLieEquiv n H.val).val.1 i j=
      (if i=j then (compactCoordinates n H).2 else 0)+
      (if i.val+j.val+1=2*n then
        (if h : i.val<n then (compactCoordinates n H).1 ⟨i.val,h⟩
         else -(compactCoordinates n H).1 ⟨j.val,by sorry⟩) else 0) := sorry

/-- The actual compact Cartan lattice, with central parity, is retained. -/
abbrev Weight (n : ℕ) := (Fin n → ℤ) × ℤ

def compactWeight (n : ℕ) (κ : Weight n) : Module.Dual ℂ (compactCartan n).roots.h where
  toFun H := Complex.I*(∑ i, (κ.1 i : ℂ)*(compactCoordinates n H).1 i)+
    (κ.2 : ℂ)*(compactCoordinates n H).2
  map_add' := by sorry
  map_smul' := by sorry

def Integral (n : ℕ) (κ : Weight n) : Prop := κ.2%2=(∑ i, κ.1 i)%2

def LeviDominant (n : ℕ) (κ : Weight n) : Prop :=
  ∀ i j : Fin n, i≤j → κ.1 j≤κ.1 i

/-- The longest compact-Levi element is characterized on all Cartan coordinates. -/
def longestLevi (n : ℕ) : (compactCartan n).roots.R.weylGroup := sorry

theorem longestLevi_action (n : ℕ) (κ : Weight n) (H : (compactCartan n).roots.h) :
    (longestLevi n • compactWeight n κ) H=
      Complex.I*(∑ i, (κ.1 i.rev : ℂ)*(compactCoordinates n H).1 i)+
        (κ.2 : ℂ)*(compactCoordinates n H).2 := sorry

/-- Minimal representatives of W_M\W use the source's inverse-root criterion. -/
def KostantRepresentative (n : ℕ) (w : (compactCartan n).roots.R.weylGroup) : Prop :=
  ∀ i : (compactCartan n).roots.rootIndex,
    i∈(compactCartan n).compactRoots → (compactCartan n).roots.b.IsPos i →
      ∃ j, (compactCartan n).roots.b.IsPos j ∧
        w⁻¹ • (compactCartan n).roots.R.root i=(compactCartan n).roots.R.root j

def length (n : ℕ) (w : (compactCartan n).roots.R.weylGroup) : ℕ := by
  classical
  exact (Finset.univ.filter (fun i : (compactCartan n).roots.rootIndex =>
    (compactCartan n).roots.b.IsPos i ∧ ∃ j,
      ¬(compactCartan n).roots.b.IsPos j ∧
      w • (compactCartan n).roots.R.root i=(compactCartan n).roots.R.root j)).card

/-- κ+ρ lies in the rational weight space; no false lattice-integrality condition is added. -/
def Ckappa (n : ℕ) (κ : Weight n) : Set (compactCartan n).roots.R.weylGroup :=
  {w | KostantRepresentative n w ∧ ∀ i : (compactCartan n).roots.rootIndex,
    (compactCartan n).roots.b.IsPos i →
      0≤((-(w⁻¹ • (longestLevi n • (compactWeight n κ+(compactCartan n).roots.rho))))
        ((compactCartan n).roots.R.coroot i)).re}

def coefficient (n : ℕ) (κ : Weight n) (hi : Integral n κ) (hd : LeviDominant n κ) :
    Hermitian.HodgeCoefficient (hermitian n) := sorry

def hodgeCartan (n : ℕ) (H : (compactCartan n).roots.h) :
    Hermitian.fullHodgeParabolic (hermitian n) := ⟨H.val,by sorry⟩

theorem coefficient_highestWeight (n : ℕ) (κ : Weight n) (hi : Integral n κ)
    (hd : LeviDominant n κ) : IsIrreducibleGK (coefficient n κ hi hd).action ∧
    ∃ v : Fin (coefficient n κ hi hd).dimension → ℂ, v≠0 ∧
      (∀ H : (compactCartan n).roots.h,
        (coefficient n κ hi hd).action.rho (hodgeCartan n H) v=compactWeight n κ H • v) ∧
      ∀ i : (compactCartan n).roots.rootIndex,
        i∈(compactCartan n).compactRoots → (compactCartan n).roots.b.IsPos i →
          ∀ X : complexAlgebraicLie (GSpCoordinate n),
            (∀ H : (compactCartan n).roots.h, ⁅H.val,X⁆=(compactCartan n).roots.R.root i H • X) →
              (coefficient n κ hi hd).action.rho ⟨X,by sorry⟩ v=0 := sorry

/-- The full weight/chamber pair specifies the constructor. -/
def limitModel (n : ℕ) (hn : 0<n) (κ : Weight n) (hi : Integral n κ)
    (hd : LeviDominant n κ) (w : (compactCartan n).roots.R.weylGroup)
    (hw : w∈Ckappa n κ) : IrrAdmissibleModel.{0} (D n).pair.identityComponent := sorry

theorem limitModel_parameter (n : ℕ) (hn : 0<n) (κ : Weight n) (hi : Integral n κ)
    (hd : LeviDominant n κ) (w : (compactCartan n).roots.R.weylGroup)
    (hw : w∈Ckappa n κ) :
    HasInfChar (limitModel n hn κ hi hd w hw).action.toGKModule
      (infCharOf (compactCartan n).roots
        (-(w⁻¹ • (longestLevi n • (compactWeight n κ+(compactCartan n).roots.rho))))) := sorry

theorem limitModel_balanced (n : ℕ) (hn : 0<n) (κ : Weight n) (hi : Integral n κ)
    (hd : LeviDominant n κ) (w : (compactCartan n).roots.R.weylGroup)
    (hw : w∈Ckappa n κ) :
    Hermitian.TensorBalanced (hermitian n) (limitModel n hn κ hi hd w hw).action.toGKModule
      (coefficient n κ hi hd) := sorry

theorem limitDiscreteSeries (n : ℕ) (hn : 0<n) (κ : Weight n) (hi : Integral n κ)
    (hd : LeviDominant n κ) :
    (Ckappa n κ).Nonempty ∧
    (∀ w w', w∈Ckappa n κ → w'∈Ckappa n κ →
      -(w⁻¹ • (longestLevi n • (compactWeight n κ+(compactCartan n).roots.rho)))=
        -(w'⁻¹ • (longestLevi n • (compactWeight n κ+(compactCartan n).roots.rho)))) ∧
    (∀ w, w∈Ckappa n κ →
      (∀ i : (compactCartan n).roots.rootIndex,
        (-(w⁻¹ • (longestLevi n • (compactWeight n κ+(compactCartan n).roots.rho))))
          ((compactCartan n).roots.R.coroot i)≠0) →
        Ckappa n κ={w}) ∧
    ∀ w (hw : w∈Ckappa n κ),
      Module.finrank ℂ (coherentCohomology (D n) (hermitian n)
        (limitModel n hn κ hi hd w hw).action.toGKModule (coefficient n κ hi hd)
        (limitModel_balanced n hn κ hi hd w hw) (length n w))=1 := sorry

-- E8 regression: the rank-two minimal representatives have distinct lengths.
example : Set.range (fun w : {w : (compactCartan 2).roots.R.weylGroup //
    KostantRepresentative 2 w} => length 2 w.val)=({0,1,2,3} : Set ℕ) := sorry
end TauCeti.Automorphic.GSp2g

namespace TauCeti.RelativeLieCohomology
open TauCeti.RealReductive
section Kostant
variable {g : Type} [NormedComplexLieAlgebra g] (C : ReductiveCartan g)

/-- Standard Levi and nilradical, specified by their actual adjoint root spaces. -/
structure StandardParabolicData where
  leviRoots : Finset C.rootIndex
  levi : LieSubalgebra ℂ g
  radical : LieSubalgebra ℂ g
  cartan_mem : C.h≤levi
  levi_span : levi.toSubmodule=C.h.toSubmodule⊔Submodule.span ℂ
    {X | ∃ i∈leviRoots, ∀ H : C.h, ⁅H.val,X⁆=C.R.root i H • X}
  radical_span : radical.toSubmodule=Submodule.span ℂ
    {X | ∃ i : C.rootIndex, C.b.IsPos i ∧ i∉leviRoots ∧
      ∀ H : C.h, ⁅H.val,X⁆=C.R.root i H • X}
  normalizes : ∀ X∈levi, ∀ Y∈radical, ⁅X,Y⁆∈radical
  opposite_closed : ∀ i∈leviRoots, ∃ j∈leviRoots, C.R.root j= -C.R.root i
  standard_simple : ∃ S : Finset C.rootIndex,
    (∀ i∈S, i∈C.b.support) ∧ ∀ i : C.rootIndex,
      i∈leviRoots ↔ C.R.root i∈Submodule.span ℂ (C.R.root '' (S : Set C.rootIndex))

namespace StandardParabolicData
variable {C} (P : StandardParabolicData C)

def representatives : Set C.R.weylGroup := {w | ∀ i∈P.leviRoots,
  C.b.IsPos i → ∃ j, C.b.IsPos j ∧ w⁻¹ • C.R.root i=C.R.root j}

def length (_P : StandardParabolicData C) (w : C.R.weylGroup) : ℕ := by
  classical
  exact (Finset.univ.filter (fun i : C.rootIndex => C.b.IsPos i ∧
    ∃ j, ¬C.b.IsPos j ∧ w • C.R.root i=C.R.root j)).card

def cartanLevi : C.h →ₗ[ℂ] P.levi :=
  { toFun := fun H => ⟨H.val,P.cartan_mem H.property⟩
    map_add' := by sorry
    map_smul' := by sorry }

variable (V : Type) [AddCommGroup V] [Module ℂ V]
  [LieRingModule g V] [LieModule ℂ g V]
local instance : LieRingModule P.radical V := LieRingModule.compLieHom V P.radical.incl
local instance : LieModule ℂ P.radical V := LieModule.compLieHom V P.radical.incl

abbrev nilCohomology (q : ℕ) := AbsoluteLie.cohomology ℂ P.radical V q

def leviCochainAction (q : ℕ) : P.levi →ₗ⁅ℂ⁆
    Module.End ℂ (AlternatingMap ℂ P.radical V (Fin q)) := sorry

theorem leviCochainAction_apply (q : ℕ) (Y : P.levi)
    (f : AlternatingMap ℂ P.radical V (Fin q)) (X : Fin q → P.radical) :
    leviCochainAction P V q Y f X=⁅Y.val,f X⁆-
      ∑ i : Fin q, f (Function.update X i ⟨⁅Y.val,(X i).val⁆,by sorry⟩) := sorry

def leviCohomologyAction (q : ℕ) : P.levi →ₗ⁅ℂ⁆ Module.End ℂ (P.nilCohomology V q) := sorry
end StandardParabolicData

/-- Each actual irreducible Levi summand has its complete dot-action weight and occurs once. -/
theorem kostant (hss : LieAlgebra.IsSemisimple ℂ g) (P : StandardParabolicData C)
    (V : Type) [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    [LieRingModule g V] [LieModule ℂ g V] [Nontrivial V]
    (hirr : ∀ S : LieSubmodule ℂ g V, S=⊥ ∨ S=⊤)
    (lam : Module.Dual ℂ C.h) (v : V) (hv : v≠0)
    (hweight : ∀ H : C.h, ⁅H.val,v⁆=lam H • v)
    (hhighest : ∀ i : C.rootIndex, C.b.IsPos i → ∀ X : g,
      (∀ H : C.h, ⁅H.val,X⁆=C.R.root i H • X) → ⁅X,v⁆=0)
    (q : ℕ) :
    ∃ (d : {w : C.R.weylGroup // w∈P.representatives ∧ P.length w=q} → ℕ)
      (rho : ∀ w : {w : C.R.weylGroup // w∈P.representatives ∧ P.length w=q},
        P.levi →ₗ⁅ℂ⁆ Module.End ℂ (Fin (d w) → ℂ))
      (e : P.nilCohomology V q ≃ₗ[ℂ] (∀ w, Fin (d w) → ℂ)),
      (∀ w, 0<d w ∧
        (∀ S : Submodule ℂ (Fin (d w) → ℂ),
          (∀ X z, z∈S → rho w X z∈S) → S=⊥ ∨ S=⊤) ∧
        ∃ z, z≠0 ∧
          (∀ H : C.h, rho w (P.cartanLevi H) z=
            (w.val • (lam+C.rho)-C.rho) H • z) ∧
          ∀ i∈P.leviRoots, C.b.IsPos i → ∀ X : P.levi,
            (∀ H : C.h, ⁅H.val,X.val⁆=C.R.root i H • X.val) → rho w X z=0) ∧
      ∀ X c w, e (P.leviCohomologyAction V q X c) w=rho w X (e c w) := sorry
end Kostant
end TauCeti.RelativeLieCohomology

namespace TauCeti.Automorphic.GLn
open TauCeti.RealReductive TauCeti.RelativeLieCohomology

def signCharacter (n : ℕ) : SmoothCharacter (Datum.generalLinear n) := sorry

theorem signCharacter_value (n : ℕ) (g : realPoints (GLCoordinate n)) :
    ((signCharacter n).character g : ℂ)=
      (if 0<Matrix.det ((realPoints.GL n g : Matrix.GeneralLinearGroup (Fin n) ℝ) :
        Matrix (Fin n) (Fin n) ℝ) then 1 else -1 : ℂ) := sorry

/-- SO(n)-cohomology is retained before taking the O(n) component invariants. -/
def weightZeroTempered (n : ℕ) : Set (IrrAdmissible.{0} (Datum.generalLinear n).pair) :=
  {π | IsTemperedClass (Datum.generalLinear n) π ∧
    IrrAdmissible.infChar (Datum.generalLinear n).pair π=
      infCharOf (splitCoefficientDatum n).cartan (splitCoefficientDatum n).cartan.rho ∧
    ∃ M : IrrAdmissibleModel.{0} (Datum.generalLinear n).pair,
      Quotient.mk _ M=π ∧ ∃ q : ℕ,
        Nontrivial (cohomology (GKModule.restrict
          (Datum.generalLinear n).pair.identityComponentHom M.action.toGKModule) q)}

/-- BCG Remark 1.2: the full graded SO(n) cohomology carries the component action. -/
theorem temperedCohomological (n : ℕ) (hn : 0<n) :
    (Even n → ∃! π, π∈weightZeroTempered n) ∧
    (Odd n → ∃ π∈weightZeroTempered n,
      let π' := IrrAdmissible.twist (Datum.generalLinear n) (signCharacter n) π
      π'≠π ∧ weightZeroTempered n={π,π'}) ∧
    ∀ (M : IrrAdmissibleModel.{0} (Datum.generalLinear n).pair),
      Quotient.mk _ M∈weightZeroTempered n →
      (Even n → ∀ q : ℕ, ∃ (d : ℕ)
        (e : cohomology (GKModule.restrict (Datum.generalLinear n).pair.identityComponentHom
          M.action.toGKModule) q ≃ₗ[ℂ]
            (Fin d → MonoidAlgebra ℂ (Datum.componentGroupOf (G := (Datum.generalLinear n).K)))),
        ∀ k v, e (componentCohomologyAction M.action.toGKModule q k v)=
          fun i => (MonoidAlgebra.single k 1)*e v i) ∧
      (Odd n → ∃ ε : Bool, ∀ q k v,
        componentCohomologyAction M.action.toGKModule q k v=
          (if ε then 1 else (if k=1 then 1 else -1 : ℂ)) • v) := sorry
end TauCeti.Automorphic.GLn

namespace TauCeti.Automorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology

/-- SR.0's smooth admissible model, with its actual group action. -/
structure SmoothLocalModel (G : Type) [Group G] [TopologicalSpace G] where
  carrier : Type
  [addGroup : AddCommGroup carrier]
  [module : Module ℂ carrier]
  action : Representation ℂ G carrier
  smooth : ∀ v, IsOpen {g | action g v=v}
  admissible : ∀ J : Subgroup G, IsOpen (J : Set G) → IsCompact (J : Set G) →
    FiniteDimensional ℂ (fixedVectors (action.comp J.subtype))
  nonzero : Nontrivial carrier
  irreducible : ∀ S : Submodule ℂ carrier,
    (∀ g v, v∈S → action g v∈S) → S=⊥ ∨ S=⊤
attribute [instance] SmoothLocalModel.addGroup SmoothLocalModel.module

namespace SmoothLocalModel
variable {G : Type} [Group G] [TopologicalSpace G]
def iso (M N : SmoothLocalModel G) : Prop := ∃ e : M.carrier ≃ₗ[ℂ] N.carrier,
  ∀ g v, e (M.action g v)=N.action g (e v)
end SmoothLocalModel

section ArchFiniteFactorization
variable {F : Type} [Field F] [NumberField F] {H : Type} [CommRing H]
  [HopfAlgebra F H] [Algebra.FiniteType F H] [Algebra.Smooth F H]
  (D : Arithmetic.Datum F H)
local notation "FinG" => Arithmetic.FinitePoints F H
local notation "P" => D.realDatum.pair

/-- The finite part is irreducible; the whole π carrier is not used as its finite part. -/
def factorModule (M : IrrAdmissibleModel.{0} P) (N : SmoothLocalModel FinG) :
    GlobalHeckeModule FinG P (M.carrier ⊗[ℂ] N.carrier) := sorry

theorem factorModule_lie (M : IrrAdmissibleModel.{0} P) (N : SmoothLocalModel FinG)
    (X : complexAlgebraicLie (Arithmetic.ArchCoordinate F H)) (v : M.carrier) (w : N.carrier) :
    (factorModule D M N).rho X (v ⊗ₜ[ℂ] w)=M.action.rho X v ⊗ₜ[ℂ] w := sorry

theorem factorModule_compact (M : IrrAdmissibleModel.{0} P) (N : SmoothLocalModel FinG)
    (k : D.realDatum.K) (v : M.carrier) (w : N.carrier) :
    (factorModule D M N).sigma k (v ⊗ₜ[ℂ] w)=M.action.sigma k v ⊗ₜ[ℂ] w := sorry

theorem factorModule_finite (M : IrrAdmissibleModel.{0} P) (N : SmoothLocalModel FinG)
    (g : FinG) (v : M.carrier) (w : N.carrier) :
    (factorModule D M N).finiteAction g (v ⊗ₜ[ℂ] w)=v ⊗ₜ[ℂ] N.action g w := sorry

structure ArchFiniteFactorization (π : D.representationModel) where
  arch : IrrAdmissibleModel.{0} P
  finite : SmoothLocalModel FinG
  intertwiner : GlobalHeckeModule.Iso (factorModule D arch finite) π.action
end ArchFiniteFactorization

