abbrev Forms := AutomorphicForm 𝓘(ℝ,realPoints.Model (GLCoordinate 2))
  TauCeti.RealReductive.GL2.D.K.subtype height Gamma

/-- Integral finite adeles are integral at every finite place. -/
def IntegralRing : Subring FiniteRing where
  carrier := {a | ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ),
    a v∈v.adicCompletionIntegers ℚ}
  one_mem' := sorry
  mul_mem' := sorry
  zero_mem' := sorry
  add_mem' := sorry
  neg_mem' := sorry

def integralReduction (N : ℕ) : IntegralRing →+* ZMod N := sorry

theorem integralReduction_int (N : ℕ) (m : ℤ) :
    integralReduction N ⟨algebraMap ℚ FiniteRing m,by sorry⟩=(m : ZMod N) := sorry

def K0 (N : ℕ) : Subgroup FiniteGroup where
  carrier := {g | let m := (TauCeti.GeneralLinear.pointsMulEquiv 2 g).val
    (∀ i j, m i j∈IntegralRing) ∧
    (∀ i j, (TauCeti.GeneralLinear.pointsMulEquiv 2 g⁻¹).val i j∈IntegralRing) ∧
    ∃ c : IntegralRing, m 1 0=(N : FiniteRing)*c.val}
  one_mem' := sorry
  mul_mem' := sorry
  inv_mem' := sorry

def lowerRightMod (N : ℕ) [NeZero N] : K0 N →* (ZMod N)ˣ := sorry

theorem lowerRightMod_value (N : ℕ) [NeZero N] (g : K0 N) :
    (lowerRightMod N g : ZMod N)=integralReduction N
      ⟨(TauCeti.GeneralLinear.pointsMulEquiv 2 g.val).val 1 1,by sorry⟩ := sorry

def K1 (N : ℕ) [NeZero N] : Subgroup FiniteGroup :=
  (lowerRightMod N).ker.map (K0 N).subtype

def levelCharacter (N : ℕ) [NeZero N] (χ : (ZMod N)ˣ →* ℂˣ) : K0 N →* ℂˣ :=
  χ.comp (lowerRightMod N)

abbrev Classical (N : ℕ) (k : ℤ) (χ : (ZMod N)ˣ →* ℂˣ) :=
  modFormCharSpace k χ

/-- This is the determinant-unitary slash, with the positive real determinant. -/
def unitarySlash (k : ℤ) (f : UpperHalfPlane → ℂ)
    (g : Matrix.GeneralLinearGroup (Fin 2) ℝ) (z : UpperHalfPlane) : ℂ :=
  (Real.rpow |g.det.val| ((k : ℝ)/2) : ℂ)*
    UpperHalfPlane.denom g z ^ (-k)*f (g • z)

variable (N : ℕ) [NeZero N] (k : ℤ) (χ : (ZMod N)ˣ →* ℂˣ)

def adelize : Classical N k χ →ₗ[ℂ] Forms := sorry

theorem adelize_formula (f : Classical N k χ)
    (γ : Matrix.GeneralLinearGroup (Fin 2) ℚ)
    (g : realPoints (GLCoordinate 2)) (hg : 0<(realPoints.GL 2 g).det.val) (u : K0 N) :
    (adelize N k χ f).val.val (rationalDiagonal γ*(g,u.val))=
      ((levelCharacter N χ u : ℂ)⁻¹)*unitarySlash k f.val (realPoints.GL 2 g) UpperHalfPlane.I := sorry

theorem adelize_left (f : Classical N k χ)
    (γ : Matrix.GeneralLinearGroup (Fin 2) ℚ) (g : Adeles) :
    (adelize N k χ f).val.val (rationalDiagonal γ*g)=(adelize N k χ f).val.val g := sorry

theorem adelize_weight (f : Classical N k χ) (g : Adeles) (t : ℝ) :
    (adelize N k χ f).val.val (g*((TauCeti.RealReductive.GL2.rotation t).val,1))=
      Complex.exp (Complex.I*(k : ℂ)*(t : ℂ))*(adelize N k χ f).val.val g := sorry

theorem adelize_level (f : Classical N k χ) (g : Adeles) (u : K0 N) :
    (adelize N k χ f).val.val (g*(1,u.val))=
      ((levelCharacter N χ u : ℂ)⁻¹)*(adelize N k χ f).val.val g := sorry

/-- The full central character is trivial on positive real scalars. -/
def centralCharacter (N : ℕ) (k : ℤ) (χ : (ZMod N)ˣ →* ℂˣ) : Subgroup.center Adeles →* ℂˣ := sorry

theorem centralCharacter_positive (z : ℝˣ) (hz : 0<z.val)
    (g : Subgroup.center Adeles) (hg :
      (realPoints.GL 2 g.val.1).val=z.val • (1 : Matrix (Fin 2) (Fin 2) ℝ) ∧ g.val.2=1) :
    centralCharacter N k χ g=1 := sorry

theorem adelize_central (f : Classical N k χ) (g : Adeles) (z : Subgroup.center Adeles) :
    (adelize N k χ f).val.val (z.val*g)=
      (centralCharacter N k χ z : ℂ)*(adelize N k χ f).val.val g := sorry

theorem adelize_slash_compat (f : UpperHalfPlane → ℂ)
    (g : Matrix.GeneralLinearGroup (Fin 2) ℝ) (hg : 0<g.det.val) (z : UpperHalfPlane) :
    (SlashAction.map k g f) z=(Real.rpow g.det.val ((k : ℝ)/2-1) : ℂ)*unitarySlash k f g z := sorry

theorem adelize_injective : Function.Injective (adelize N k χ) := sorry

/-- The target records full central covariance, SO₂ weight and the actual lowering operator. -/
def HolomorphicAdelicSpace : Submodule ℂ Forms where
  carrier := {f | (∀ g (u : K0 N), f.val.val (g*(1,u.val))=
    ((levelCharacter N χ u : ℂ)⁻¹)*f.val.val g) ∧
    (∀ g (z : Subgroup.center Adeles), f.val.val (z.val*g)=
      (centralCharacter N k χ z : ℂ)*f.val.val g) ∧
    (∀ g t, f.val.val (g*((TauCeti.RealReductive.GL2.rotation t).val,1))=
      Complex.exp (Complex.I*(k : ℂ)*(t : ℂ))*f.val.val g) ∧
    SmoothAdelicFunction.complexLieAction (Ginf := realPoints (GLCoordinate 2)) (Gf := FiniteGroup)
      𝓘(ℝ,realPoints.Model (GLCoordinate 2))
      (TauCeti.RealReductive.GL2.D.complexLieTangent ((realPoints.GLcomplexLie 2).symm ((1/2 : ℂ) •
        (!![1,0;0,-1] - Complex.I • (!![0,1;1,0] : Matrix (Fin 2) (Fin 2) ℂ))))) f.val=0}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

def modularFormEquiv : Classical N k χ ≃ₗ[ℂ] HolomorphicAdelicSpace N k χ := sorry

theorem modularFormEquiv_adelize (f : Classical N k χ) :
    (modularFormEquiv N k χ f).val=adelize N k χ f := sorry

