abbrev QCoordinate := TauCeti.GeneralLinear.coordinateHopfAlgebra ℚ 2
abbrev FiniteRing := IsDedekindDomain.FiniteAdeleRing (NumberField.RingOfIntegers ℚ) ℚ
abbrev FiniteGroup := Arithmetic.FinitePoints ℚ QCoordinate
abbrev Adeles := realPoints (GLCoordinate 2) × FiniteGroup

def datumQ : Arithmetic.Datum ℚ QCoordinate := sorry

def archIdentification : realPoints (Arithmetic.ArchCoordinate ℚ QCoordinate) ≃*
    realPoints (GLCoordinate 2) := sorry

def rationalDiagonal : Matrix.GeneralLinearGroup (Fin 2) ℚ →* Adeles := sorry

theorem rationalDiagonal_real (g : Matrix.GeneralLinearGroup (Fin 2) ℚ) :
    realPoints.GL 2 (rationalDiagonal g).1=Matrix.GeneralLinearGroup.map (algebraMap ℚ ℝ) g := sorry

