def circleFourierIdempotent (n : ℤ) : archimedeanHeckeAlgebra 𝓘(ℝ,E) G ι :=
  archimedeanHeckeAlgebra.idempotent 𝓘(ℝ,E) G ι hι dk 1 (circleWeight n)
    (circleWeight_joint n) (circleWeight_irreducible n)

