open TauCeti.RealReductive TauCeti.RelativeLieCohomology
namespace GLn

def splitCoefficientDatum (n : ℕ) : SplitCoefficientDatum (Datum.generalLinear n) where
  rank := n
  torusInclusion := sorry
  closedImmersion := sorry
  cartan := sorry
  torusLie := sorry
  torusLie_differential := sorry
  differential := sorry
  differential_torus := sorry
  injective := sorry
  spans := sorry
  rootIsIntegral := sorry
  longest := sorry
  longest_negative := sorry
  longest_integral := sorry

def weight (n : ℕ) (lam : Fin n → ℤ) : AlgebraicWeight (splitCoefficientDatum n) :=
  Finsupp.equivFunOnFinite.symm lam

theorem weight_dominant (n : ℕ) (lam : Fin n → ℤ) :
    AlgebraicWeight.IsDominant (splitCoefficientDatum n) (weight n lam) ↔
      ∀ i j, i≤j → lam j≤lam i := sorry

