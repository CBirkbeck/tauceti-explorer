section InfiniteFlath
variable {F : Type} [Field F] [NumberField F] {H : Type} [CommRing H]
  [HopfAlgebra F H] [Algebra.FiniteType F H] [Algebra.Smooth F H]
  (D : Arithmetic.Datum F H)

set_option maxHeartbeats 4000000 in
structure ArchFactorization (M : IrrAdmissibleModel.{0} D.realDatum.pair) where
  localFactor : ∀ v : NumberField.InfinitePlace F,
    IrrAdmissibleModel.{0} (Arithmetic.archPlaceDatum F H D v).pair
  linear : PiTensorProduct ℂ (fun v => (localFactor v).carrier) ≃ₗ[ℂ] M.carrier
  compact : ∀ k (a : ∀ v, (localFactor v).carrier),
    M.action.sigma k (linear (PiTensorProduct.tprod ℂ a))=
      linear (PiTensorProduct.tprod ℂ (fun v => (localFactor v).action.sigma
        (Arithmetic.archCompactSplit F H D k v) (a v)))
  lie : ∀ (X : complexAlgebraicLie (Arithmetic.ArchCoordinate F H))
    (a : ∀ v, (localFactor v).carrier),
    M.action.rho X (linear (PiTensorProduct.tprod ℂ a))=
      ∑ v : NumberField.InfinitePlace F,
        linear (PiTensorProduct.tprod ℂ (Function.update a v
          ((localFactor v).action.rho (Arithmetic.archLieSplit F H X v) (a v))))

/-- This refinement supplies the archimedean factors and their actual intertwining equations. -/
theorem flath_all_places (π : D.representationModel) :
    ∃ f : ArchFiniteFactorization D π,
      Nonempty (ArchFactorization D f.arch) ∧ Nonempty (FiniteFactorization D f.finite) := sorry

/-- Local factors, not only the combined archimedean and finite factors, are unique. -/
theorem flath_finite_unique (N : SmoothLocalModel (Arithmetic.FinitePoints F H))
    (a b : FiniteFactorization D N) :
    ∀ v, SmoothLocalModel.iso (a.localFactor v) (b.localFactor v) := sorry

theorem flath_arch_unique (M : IrrAdmissibleModel.{0} D.realDatum.pair)
    (a b : ArchFactorization D M) :
    ∀ v, (IrrAdmissibleModel.isoSetoid (Arithmetic.archPlaceDatum F H D v).pair).r
      (a.localFactor v) (b.localFactor v) := sorry
end InfiniteFlath
