open CategoryTheory
/-- Ordinary de Rham forms with real coefficients, supplied by DifferentialGeometry. -/
def realSmoothForms {E M : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [TopologicalSpace M] [ChartedSpace E M] (n : ℕ) :
    Submodule ℝ ((x : M) → TangentSpace 𝓘(ℝ,E) x [⋀^Fin n]→L[ℝ] ℝ) where
  carrier := {w | ∀ x : M, ContDiffOn ℝ ∞
    (fun y : E => (w ((extChartAt 𝓘(ℝ,E) x).symm y)).compContinuousLinearMap
      (mfderiv 𝓘(ℝ,E) 𝓘(ℝ,E) (extChartAt 𝓘(ℝ,E) x).symm y))
    (extChartAt 𝓘(ℝ,E) x).target}
  zero_mem' := by sorry
  add_mem' := by sorry
  smul_mem' := by sorry

def realExteriorDerivative {E M : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [TopologicalSpace M] [ChartedSpace E M]
    [IsManifold 𝓘(ℝ,E) ∞ M] (n : ℕ) :
    realSmoothForms (E := E) (M := M) n →ₗ[ℝ] realSmoothForms (E := E) (M := M) (n+1) := sorry

theorem realExteriorDerivative_chart {E M : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [TopologicalSpace M] [ChartedSpace E M]
    [IsManifold 𝓘(ℝ,E) ∞ M] (n : ℕ) (w : realSmoothForms (E := E) (M := M) n)
    (x : M) (y : E) (hy : y∈(extChartAt 𝓘(ℝ,E) x).target) :
    ((realExteriorDerivative n w).val ((extChartAt 𝓘(ℝ,E) x).symm y)).compContinuousLinearMap
      (mfderiv 𝓘(ℝ,E) 𝓘(ℝ,E) (extChartAt 𝓘(ℝ,E) x).symm y)=
      extDerivWithin (fun z => (w.val ((extChartAt 𝓘(ℝ,E) x).symm z)).compContinuousLinearMap
        (mfderiv 𝓘(ℝ,E) 𝓘(ℝ,E) (extChartAt 𝓘(ℝ,E) x).symm z))
          (extChartAt 𝓘(ℝ,E) x).target y := sorry

def realDeRhamComplex {E M : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [TopologicalSpace M] [ChartedSpace E M]
    [IsManifold 𝓘(ℝ,E) ∞ M] : CochainComplex (ModuleCat ℝ) ℕ :=
  CochainComplex.of (fun n => ModuleCat.of ℝ (realSmoothForms (E := E) (M := M) n))
    (fun n => ModuleCat.ofHom (realExteriorDerivative n)) (by sorry)

end TauCeti.Automorphic.Suppliers.DifferentialGeometry

