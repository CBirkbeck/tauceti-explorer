section WeilRestriction
variable (F E : Type) [Field F] [NumberField F] [Field E] [NumberField E]
  [Algebra F E] [FiniteDimensional F E]
  (H : Type) [CommRing H] [HopfAlgebra E H] [Algebra.FiniteType E H] [Algebra.Smooth E H]

/-- AA.1/RG2's Weil restriction represents the scalar-extension point functor. -/
def ResScalarsCoordinate (F E : Type) [Field F] [Field E] [Algebra F E]
    (H : Type) [CommRing H] [HopfAlgebra E H] : Type := sorry
instance : CommRing (ResScalarsCoordinate F E H) := sorry
instance : HopfAlgebra F (ResScalarsCoordinate F E H) := sorry
instance : Algebra.FiniteType F (ResScalarsCoordinate F E H) := sorry
instance : Algebra.Smooth F (ResScalarsCoordinate F E H) := sorry

def resScalarsUniversal (R : Type) [CommRing R] [Algebra F R] :
    WithConv (ResScalarsCoordinate F E H →ₐ[F] R) ≃*
      WithConv (H →ₐ[E] (E ⊗[F] R)) := sorry

/-- The adelic scalar extension is on the number-field adele rings, at all places. -/
def adelicScalarExtension :
    (E ⊗[F] NumberField.AdeleRing (NumberField.RingOfIntegers F) F) ≃ₐ[E]
      NumberField.AdeleRing (NumberField.RingOfIntegers E) E := sorry

theorem adelicScalarExtension_tmul (a : E) (b : F) :
    adelicScalarExtension F E (a ⊗ₜ[F] algebraMap F _ b)=
      algebraMap E _ (a*algebraMap F E b) := sorry

variable (D : Arithmetic.Datum E H)
def resScalarsDatum (D : Arithmetic.Datum E H) : Arithmetic.Datum F (ResScalarsCoordinate F E H) := sorry

def resScalarsAdelic : Arithmetic.AdelicPoints F (ResScalarsCoordinate F E H) ≃*
    Arithmetic.AdelicPoints E H := sorry

theorem resScalarsAdelic_universal (g : Arithmetic.AdelicPoints F (ResScalarsCoordinate F E H)) :
    (resScalarsAdelic F E H g).ofConv=
      (adelicScalarExtension F E).toAlgHom.comp
        ((resScalarsUniversal F E H _ g).ofConv) := sorry

def resScalarsSplit :
    (realPoints (Arithmetic.ArchCoordinate F (ResScalarsCoordinate F E H)) ×
      Arithmetic.FinitePoints F (ResScalarsCoordinate F E H)) ≃*
    (realPoints (Arithmetic.ArchCoordinate E H) × Arithmetic.FinitePoints E H) :=
  (Arithmetic.adelicSplit F (ResScalarsCoordinate F E H)).symm.trans
    ((resScalarsAdelic F E H).trans (Arithmetic.adelicSplit E H))

def resScalarsArchIso : Datum.Iso (resScalarsDatum F E H D).realDatum D.realDatum := sorry

def resScalarsFinite : Arithmetic.FinitePoints F (ResScalarsCoordinate F E H) ≃*
    Arithmetic.FinitePoints E H := sorry

theorem resScalarsSplit_factors (g) :
    resScalarsSplit F E H g=((resScalarsArchIso F E H D).points g.1,
      resScalarsFinite F E H g.2) := sorry

theorem resScalarsSplit_rational :
    (Arithmetic.rationalSubgroup F (ResScalarsCoordinate F E H)).map
      (resScalarsSplit F E H).toMonoidHom=Arithmetic.rationalSubgroup E H := sorry
end WeilRestriction
