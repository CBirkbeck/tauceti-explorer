    (localProjection F H v g).ofConv h=(g.ofConv h) v := sorry

/-- RG2.3's reductive integral model outside a finite set is a separate supplier. -/
structure HyperspecialDatum (v : FinitePlaceIndex F) where
  integralCoordinates : Type
  [ring : CommRing integralCoordinates]
  [hopf : HopfAlgebra (v.adicCompletionIntegers F) integralCoordinates]
  [finiteType : Algebra.FiniteType (v.adicCompletionIntegers F) integralCoordinates]
  [smooth : Algebra.Smooth (v.adicCompletionIntegers F) integralCoordinates]
  baseChange : (v.adicCompletion F ⊗[v.adicCompletionIntegers F] integralCoordinates) ≃ₐc[v.adicCompletion F]
    (v.adicCompletion F ⊗[F] H)
  reductiveFibres : ∀ p : PrimeSpectrum (v.adicCompletionIntegers F),
    TauCeti.reductiveCommHopfAlgProperty p.asIdeal.ResidueField
      (TauCeti.FiniteTypeCommHopfAlgCat.of p.asIdeal.ResidueField
        (p.asIdeal.ResidueField ⊗[v.adicCompletionIntegers F] integralCoordinates))
  genericPoints : WithConv (integralCoordinates →ₐ[v.adicCompletionIntegers F]
    v.adicCompletionIntegers F) →* LocalPoints F H v
  evaluation : ∀ g : WithConv (integralCoordinates →ₐ[v.adicCompletionIntegers F]
    v.adicCompletionIntegers F),
    (v.adicCompletion F ⊗[v.adicCompletionIntegers F] integralCoordinates) →ₐ[v.adicCompletion F]
      v.adicCompletion F
  evaluation_tmul : ∀ g a h, evaluation g (a ⊗ₜ[v.adicCompletionIntegers F] h)=
    a*algebraMap (v.adicCompletionIntegers F) (v.adicCompletion F) (g.ofConv h)
  genericPoints_value : ∀ g h, (genericPoints g).ofConv h=evaluation g (baseChange.symm (1 ⊗ₜ[F] h))
  K : Subgroup (LocalPoints F H v)
  points_image : K=genericPoints.range
  compact : IsCompact (K : Set (LocalPoints F H v))
  open_set : IsOpen (K : Set (LocalPoints F H v))
