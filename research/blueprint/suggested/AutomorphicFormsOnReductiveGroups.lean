/-- Semisimple Weil parameters use an actual continuous representation on ℂⁿ. -/
structure WeilParameter (W : Type) [Group W] [TopologicalSpace W] (n : ℕ) where
  representation : ContRepresentation ℂ W (Fin n → ℂ)
  continuous : Continuous (fun gv : W × (Fin n → ℂ) => representation gv.1 gv.2)
  semisimple : IsSemisimpleModule (MonoidAlgebra ℂ W) representation.toRepresentation.asModule

namespace WeilParameter
variable {W : Type} [Group W] [TopologicalSpace W] {n : ℕ}

def isoSetoid (W : Type) [Group W] [TopologicalSpace W] (n : ℕ) : Setoid (WeilParameter W n) where
  r a b := ∃ e : (Fin n → ℂ) ≃ₗ[ℂ] (Fin n → ℂ),
    ∀ g v, e (a.representation g v)=b.representation g (e v)
  iseqv := sorry

def classes (W : Type) [Group W] [TopologicalSpace W] (n : ℕ) := Quotient (isoSetoid W n)

def bounded (a : WeilParameter W n) : Prop :=
  ∃ C : ℝ, ∀ (g : W) (v : Fin n → ℂ), ‖a.representation g v‖≤C*‖v‖

end WeilParameter

