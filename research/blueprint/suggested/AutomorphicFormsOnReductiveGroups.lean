section Algebraicity
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] {D : Datum A} (S : SplitCoefficientDatum D)

def IsLAlgebraic (π : IrrAdmissible.{0} D.pair) : Prop :=
  ∃ lam : AlgebraicWeight S, IrrAdmissible.infChar D.pair π=infCharOf S.cartan (S.differential lam)

def IsCAlgebraic (π : IrrAdmissible.{0} D.pair) : Prop :=
  ∃ lam : AlgebraicWeight S,
    IrrAdmissible.infChar D.pair π=infCharOf S.cartan (S.differential lam+S.cartan.rho)

theorem isLAlgebraic_iff_of_rho_integral (h : ∃ r, S.differential r=S.cartan.rho)
    (π : IrrAdmissible.{0} D.pair) : IsLAlgebraic S π ↔ IsCAlgebraic S π := sorry

/-- The actual algebraic coefficient in the relative cochain complex is essential. -/
def IsCohomological (π : IrrAdmissibleModel.{0} D.pair) : Prop :=
  ∃ (lam : AlgebraicWeight S) (hlam : AlgebraicWeight.IsDominant S lam) (q : ℕ),
    Nontrivial (cohomology (GKModule.tensorFinite D.pair π.action.toGKModule
      ((AlgebraicWeight.rep S lam hlam).action (D := D))) q)

namespace IsCohomological
variable {S}

def coefficient (π : IrrAdmissibleModel.{0} D.pair) (hπ : IsCohomological S π) :
    AlgebraicWeight S := Classical.choose hπ

theorem coefficient_dominant (π : IrrAdmissibleModel.{0} D.pair) (hπ : IsCohomological S π) :
    AlgebraicWeight.IsDominant S (coefficient π hπ) := sorry

theorem coefficient_unique (π : IrrAdmissibleModel.{0} D.pair)
    (lam μ : AlgebraicWeight S) (hlam : AlgebraicWeight.IsDominant S lam)
    (hμ : AlgebraicWeight.IsDominant S μ) (q r : ℕ)
    (hq : Nontrivial (cohomology (GKModule.tensorFinite D.pair π.action.toGKModule
      ((AlgebraicWeight.rep S lam hlam).action (D := D))) q))
    (hr : Nontrivial (cohomology (GKModule.tensorFinite D.pair π.action.toGKModule
      ((AlgebraicWeight.rep S μ hμ).action (D := D))) r)) : lam=μ := sorry

theorem infChar (π : IrrAdmissibleModel.{0} D.pair) (hπ : IsCohomological S π) :
    HasInfChar π.action.toGKModule (infCharOf S.cartan
      (-(S.differential (coefficient π hπ)+S.cartan.rho))) := sorry

theorem twist (π : IrrAdmissibleModel.{0} D.pair) (hπ : IsCohomological S π)
    (χ : SmoothCharacter D) (a : AlgebraicCoefficient (A := A)) (ha : a.dimension=1)
    (halg : ∀ g v, a.points (complexifyRealPoint g) v=(χ.character g : ℂ) • v) :
    IsCohomological S (IrrAdmissibleModel.ofHC D (HCModule.twist D π.action χ) (by sorry)) := sorry
end IsCohomological
end Algebraicity

namespace GLn
/-- Positive norm twists are smooth characters of the full real GL_n, including both components. -/
def normTwist (n : ℕ) (s : ℂ) : SmoothCharacter (Datum.generalLinear n) := sorry

theorem normTwist_value (n : ℕ) (s : ℂ) (g : realPoints (GLCoordinate n)) :
    ((normTwist n s).character g : ℂ)=Complex.exp
      (s*(Real.log |Matrix.det
        ((realPoints.GL n g : Matrix.GeneralLinearGroup (Fin n) ℝ) : Matrix (Fin n) (Fin n) ℝ)| : ℂ)) := sorry
end GLn

theorem isCAlgebraic_iff_isLAlgebraic_twist (n : ℕ)
    (π : IrrAdmissible.{0} (Datum.generalLinear n).pair) :
    IsCAlgebraic (GLn.splitCoefficientDatum n) π ↔
      IsLAlgebraic (GLn.splitCoefficientDatum n)
        (IrrAdmissible.twist (Datum.generalLinear n) (GLn.normTwist n (((n : ℂ)-1)/2)) π) := sorry

/-- Chenevier–Taïbi's scalar condition is an additional parameter condition. -/
def IsAlgebraicCT_compat (n : ℕ)
    (π : IrrAdmissible.{0} (Datum.generalLinear n).pair) : Prop :=
  IsLAlgebraic (GLn.splitCoefficientDatum n) π ∧
    ∃ (w : ℤ) (p : WeilParameter WeilGroupReal n), Quotient.mk _ p=recGL n π ∧
      ∀ t : ℝˣ,
        ∃ e : Bool, ∀ v, p.representation (WeilGroupReal.inclusion
          (Units.map (algebraMap ℝ ℂ).toMonoidHom t)) v=
            ((if e then (1 : ℂ) else -1) * Complex.exp ((w : ℂ)*(Real.log |t.val| : ℂ))) • v

-- test: cohomological_D_k
example (k : ℕ) (hk : 2≤k) (μ : ℂ) :
    IsCohomological (GLn.splitCoefficientDatum 2)
      (IrrAdmissibleModel.ofHC TauCeti.RealReductive.GL2.D
        (TauCeti.RealReductive.GL2.discreteSeries k (by omega) μ)
        (TauCeti.RealReductive.GL2.discreteSeries_irreducible k (by omega) μ)) ↔
      ∃ a b : ℤ, a-b=(k : ℤ)-2 ∧ ((a+b : ℤ) : ℂ)=-μ := sorry

-- test: cohomological_D1_not
example (μ : ℂ) : ¬IsCohomological (GLn.splitCoefficientDatum 2)
    (IrrAdmissibleModel.ofHC TauCeti.RealReductive.GL2.D
      (TauCeti.RealReductive.GL2.discreteSeries 1 (by omega) μ)
      (TauCeti.RealReductive.GL2.discreteSeries_irreducible 1 (by omega) μ)) := sorry

-- test: cohomological_trivial
example (n : ℕ) : IsCohomological (GLn.splitCoefficientDatum n)
    (IrrAdmissibleModel.ofHC (Datum.generalLinear n)
      (HCModule.trivial (P := (Datum.generalLinear n).pair)) (by sorry)) := sorry

-- test: algebraic_trivial_gl2
example : let π := Quotient.mk _ (IrrAdmissibleModel.ofHC TauCeti.RealReductive.GL2.D
      (HCModule.trivial (P := TauCeti.RealReductive.GL2.D.pair)) (by sorry))
    IsCAlgebraic (GLn.splitCoefficientDatum 2) π ∧ ¬IsLAlgebraic (GLn.splitCoefficientDatum 2) π ∧
      IsLAlgebraic (GLn.splitCoefficientDatum 2)
        (IrrAdmissible.twist TauCeti.RealReductive.GL2.D (GLn.normTwist 2 (1/2)) π) := sorry

-- test: algebraic_maass_not
example (r : ℝ) (hr : 0<r) (π : IrrAdmissible.{0} TauCeti.RealReductive.GL2.D.pair)
    (hπ : IrrAdmissible.infChar TauCeti.RealReductive.GL2.D.pair π=
      TauCeti.RealReductive.GL2.chi (Complex.I*r) (-Complex.I*r)) :
    ¬IsCAlgebraic (GLn.splitCoefficientDatum 2) π ∧
      ¬IsLAlgebraic (GLn.splitCoefficientDatum 2) π := sorry
end TauCeti.Automorphic

namespace TauCeti.Automorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
instance realPointsMeasurable (A : Type) [CommRing A] [HopfAlgebra ℝ A]
    [Algebra.FiniteType ℝ A] [Algebra.Smooth ℝ A] : MeasurableSpace (realPoints A) := borel _
instance realPointsBorel (A : Type) [CommRing A] [HopfAlgebra ℝ A]
    [Algebra.FiniteType ℝ A] [Algebra.Smooth ℝ A] : BorelSpace (realPoints A) := ⟨rfl⟩
section CuspidalHilbertSpace
variable {F : Type} [Field F] [NumberField F] {H : Type} [CommRing H]
  [HopfAlgebra F H] [Algebra.FiniteType F H] [Algebra.Smooth F H]
  (D : Arithmetic.Datum F H)
local notation "A" => Arithmetic.ArchCoordinate F H
local notation "G" => realPoints A × Arithmetic.FinitePoints F H
local notation "Γ" => Arithmetic.rationalSubgroup F H

/-- The full adelic centre occurs in the quotient, including its real positive part. -/
structure UnitaryCentralCharacter (D : Arithmetic.Datum F H) where
  character : Subgroup.center G →* ℂˣ
  continuous : Continuous character
  unitary : ∀ z, ‖(character z : ℂ)‖=1
  rational_trivial : ∀ z, z.val∈Γ → character z=1

def centralArithmeticQuotient (D : Arithmetic.Datum F H) := Quotient (QuotientGroup.rightRel (Γ ⊔ Subgroup.center G))
instance : MeasurableSpace (centralArithmeticQuotient D) := sorry
instance : TopologicalSpace (centralArithmeticQuotient D) :=
  inferInstanceAs (TopologicalSpace (Quotient (QuotientGroup.rightRel (Γ ⊔ Subgroup.center G))))
instance : BorelSpace (centralArithmeticQuotient D) := sorry

def centralQuotientMeasure : Measure (centralArithmeticQuotient D) := sorry

def centralQuotientSection : centralArithmeticQuotient D → G := sorry

theorem centralQuotientSection_rightInverse (q : centralArithmeticQuotient D) :
    Quotient.mk _ (centralQuotientSection D q)=q := sorry

theorem centralQuotientSection_measurable : Measurable (centralQuotientSection D) := sorry

def centralQuotientRight (g : G) : centralArithmeticQuotient D → centralArithmeticQuotient D :=
  Quotient.map (fun x => x*g) (by sorry)

theorem centralQuotientMeasure_invariant (g : G) :
    Measure.map (centralQuotientRight D g) (centralQuotientMeasure D)=centralQuotientMeasure D := sorry

variable (χ : UnitaryCentralCharacter D)

/-- Central covariance uses χ, while classical coefficient transport uses χ⁻¹. -/
def centralCuspForms : Submodule ℂ D.cuspForms where
  carrier := {f | ∀ z : Subgroup.center G, ∀ g,
    f.val.val.val (z.val*g)=(χ.character z : ℂ)*f.val.val.val g}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

/-- L² uses a measurable trivialization of the central-character line bundle. -/
theorem CuspForm.memL2 (f : centralCuspForms D χ) :
    MemLp (fun q => f.val.val.val.val (centralQuotientSection D q)) 2 (centralQuotientMeasure D) := sorry

def cuspL2Embedding : centralCuspForms D χ →ₗ[ℂ]
    Lp ℂ 2 (centralQuotientMeasure D) := sorry

theorem cuspL2Embedding_ae (f : centralCuspForms D χ) :
    ∀ᵐ q ∂centralQuotientMeasure D, cuspL2Embedding D χ f q=
      f.val.val.val.val (centralQuotientSection D q) := sorry

theorem cuspL2Embedding_injective : Function.Injective (cuspL2Embedding D χ) := sorry

/-- Cuspidal L² is the closure of the genuine central-character cusp functions. -/
def L2Cusp : Submodule ℂ (Lp ℂ 2 (centralQuotientMeasure D)) :=
  (LinearMap.range (cuspL2Embedding D χ)).topologicalClosure

instance : CompleteSpace (L2Cusp D χ) := sorry

def L2Cusp.rightAction : ContRepresentation ℂ G (L2Cusp D χ) := sorry

theorem L2Cusp.rightAction_continuous :
    Continuous (fun gv : G × L2Cusp D χ => L2Cusp.rightAction D χ gv.1 gv.2) := sorry

theorem L2Cusp.rightAction_isometry (g : G) (f : L2Cusp D χ) :
    ‖L2Cusp.rightAction D χ g f‖=‖f‖ := sorry

def L2Cusp.ofForm (f : centralCuspForms D χ) : L2Cusp D χ :=
  ⟨cuspL2Embedding D χ f, by sorry⟩

theorem L2Cusp.rightAction_ofForm (g : G) (f f' : centralCuspForms D χ)
    (h : ∀ x, f'.val.val.val.val x=f.val.val.val.val (x*g)) :
    L2Cusp.rightAction D χ g (L2Cusp.ofForm D χ f)=L2Cusp.ofForm D χ f' := sorry

/-- A cuspidal representation is a closed subrepresentation, not a subquotient. -/
structure CuspidalRepresentation where
  space : Submodule ℂ (L2Cusp D χ)
  closed : IsClosed (space : Set (L2Cusp D χ))
  nonzero : space≠⊥
  invariant : ∀ g v, v∈space → L2Cusp.rightAction D χ g v∈space
  irreducible : ∀ S : Submodule ℂ (L2Cusp D χ), S≤space →
    IsClosed (S : Set (L2Cusp D χ)) →
    (∀ g v, v∈S → L2Cusp.rightAction D χ g v∈S) → S=⊥ ∨ S=space

namespace CuspidalRepresentation
variable {D χ}

def action (π : CuspidalRepresentation D χ) : ContRepresentation ℂ G π.space := sorry

abbrev multiplicitySpace (π : CuspidalRepresentation D χ) :
    Submodule ℂ (π.space →ₗ[ℂ] L2Cusp D χ) where
  carrier := {T | Continuous T ∧ ∀ g v, T (π.action g v)=L2Cusp.rightAction D χ g (T v)}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

instance multiplicitySpaceGroup (π : CuspidalRepresentation D χ) :
    AddCommGroup π.multiplicitySpace := sorry
instance multiplicitySpaceScalar (π : CuspidalRepresentation D χ) :
    @Module ℂ π.multiplicitySpace inferInstance
      (multiplicitySpaceGroup π).toAddCommMonoid := sorry

theorem multiplicitySpace_add_apply (π : CuspidalRepresentation D χ)
    (T U : π.multiplicitySpace) (v : π.space) :
    (T+U).val v=T.val v+U.val v := sorry

theorem multiplicitySpace_smul_apply (π : CuspidalRepresentation D χ)
    (z : ℂ) (T : π.multiplicitySpace) (v : π.space) :
    (z • T).val v=z • T.val v := sorry

theorem multiplicitySpace_finite (π : CuspidalRepresentation D χ) :
    FiniteDimensional ℂ π.multiplicitySpace := sorry

def multiplicity (π : CuspidalRepresentation D χ) : ℕ := Module.finrank ℂ π.multiplicitySpace

/-- The K-finite model is embedded in the actual cuspidal function module. -/
def kFinite (π : CuspidalRepresentation D χ) :
    Submodule ℂ (centralCuspForms D χ) := sorry

def kFiniteEquiv (π : CuspidalRepresentation D χ) :
    TauCeti.RealReductive.kFinite (K := D.realDatum.K) (V := π.space) (π.action.toRepresentation.comp
      (D.realDatum.K.subtype.prod (1 : D.realDatum.K →* Arithmetic.FinitePoints F H))) ≃ₗ[ℂ] π.kFinite := sorry

def toAutomorphic (π : CuspidalRepresentation D χ) : D.representations := sorry

theorem toAutomorphic_occurs (π : CuspidalRepresentation D χ) :
    ∃ m : D.representationModel, Quotient.mk _ m=π.toAutomorphic ∧
      ∃ e : m.carrier ≃ₗ[ℂ] π.kFinite,
        ∀ g v, (e (m.action.finiteAction g v)).val.val.val.val.val=
          fun x => (e v).val.val.val.val.val (x*(1,g)) := sorry
end CuspidalRepresentation

/-- The integrated test-function operator is defined on the native Hilbert carrier. -/
def L2Cusp.convolution (dg : Measure G) [dg.IsHaarMeasure]
    (f : TestFunction (Ginf := realPoints A) (Gf := Arithmetic.FinitePoints F H) 𝓘(ℝ,realPoints.Model A)) :
    L2Cusp D χ →L[ℂ] L2Cusp D χ := sorry

theorem L2Cusp.convolution_integral (dg : Measure G) [dg.IsHaarMeasure]
    (f : TestFunction (Ginf := realPoints A) (Gf := Arithmetic.FinitePoints F H) 𝓘(ℝ,realPoints.Model A)) (v : L2Cusp D χ) :
    L2Cusp.convolution D χ dg f v=∫ g, f.val g • L2Cusp.rightAction D χ g v ∂dg := sorry

def L2Cusp.homogeneousSummand (π : CuspidalRepresentation D χ) :
    Submodule ℂ (L2Cusp D χ) :=
  Submodule.span ℂ (Set.range (fun tv : π.multiplicitySpace × π.space => tv.1.val tv.2))

/-- Discreteness includes finite multiplicity and completeness of the orthogonal summands. -/
theorem L2Cusp.discrete :
    (∀ (dg : Measure G) [dg.IsHaarMeasure] (f : TestFunction (Ginf := realPoints A) (Gf := Arithmetic.FinitePoints F H) 𝓘(ℝ,realPoints.Model A)),
      IsCompactOperator (L2Cusp.convolution D χ dg f)) ∧
    (∀ π : CuspidalRepresentation D χ, FiniteDimensional ℂ π.multiplicitySpace) ∧
    (∀ π τ : CuspidalRepresentation D χ,
      (¬ ∃ e : π.space ≃L[ℂ] τ.space,
        ∀ g v, e (π.action g v)=τ.action g (e v)) →
      ∀ v ∈ L2Cusp.homogeneousSummand D χ π,
        ∀ w ∈ L2Cusp.homogeneousSummand D χ τ, inner ℂ v w=0) ∧
    closure (Submodule.span ℂ (⋃ π : CuspidalRepresentation D χ,
      (L2Cusp.homogeneousSummand D χ π : Set (L2Cusp D χ))) : Set (L2Cusp D χ))=Set.univ := sorry
end CuspidalHilbertSpace
end TauCeti.Automorphic

