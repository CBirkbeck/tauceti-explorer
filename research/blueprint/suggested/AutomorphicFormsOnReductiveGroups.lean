namespace TauCeti.RealReductive
section DynamicParabolic
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A]
  [Algebra.FiniteType ℝ A] [Algebra.Smooth ℝ A] (D : Datum A)

/-- Parabolic points are imported from the native dynamic-cocharacter construction. -/
abbrev realParabolic (l : A →ₐc[ℝ] LaurentPolynomial ℝ) : Subgroup (realPoints A) :=
  TauCeti.Cocharacter.parabolic ℝ l
abbrev realLevi (l : A →ₐc[ℝ] LaurentPolynomial ℝ) : Subgroup (realPoints A) :=
  TauCeti.Cocharacter.levi ℝ l
abbrev realUnipotent (l : A →ₐc[ℝ] LaurentPolynomial ℝ) : Subgroup (realPoints A) :=
  TauCeti.Cocharacter.unipotent ℝ l

/-- G=P K for every real parabolic, including the improper parabolic. -/
theorem realParabolic_compact_cover (l : A →ₐc[ℝ] LaurentPolynomial ℝ) :
    ∀ g : realPoints A, ∃ p : realParabolic l, ∃ k : D.K, g=p.val*k.val := sorry

/-- A minimal real parabolic is minimal among the dynamic parabolic subgroups. -/
def IsMinimalParabolic (l : A →ₐc[ℝ] LaurentPolynomial ℝ) : Prop :=
  ∀ l' : A →ₐc[ℝ] LaurentPolynomial ℝ,
    realParabolic l' ≤ realParabolic l → realParabolic l' = realParabolic l

/-- Tangent subalgebras use the actual native exponential in the ambient group. -/
def parabolicRealLie (l : A →ₐc[ℝ] LaurentPolynomial ℝ) :
    LieSubalgebra ℝ (algebraicRealLie A) where
  carrier := {X | ∀ t : ℝ, realPoints.exp A (t • X) ∈ realParabolic l}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry
  lie_mem' := sorry

def unipotentRealLie (l : A →ₐc[ℝ] LaurentPolynomial ℝ) :
    LieSubalgebra ℝ (algebraicRealLie A) where
  carrier := {X | ∀ t : ℝ, realPoints.exp A (t • X) ∈ realUnipotent l}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry
  lie_mem' := sorry

abbrev realParabolicModel (l : A →ₐc[ℝ] LaurentPolynomial ℝ) :=
  EuclideanSpace ℝ (Fin (Module.finrank ℝ (parabolicRealLie l)))

instance realParabolic.charted (l : A →ₐc[ℝ] LaurentPolynomial ℝ) :
    ChartedSpace (realParabolicModel l) (realParabolic l) := sorry
instance realParabolic.lie (l : A →ₐc[ℝ] LaurentPolynomial ℝ) :
    LieGroup 𝓘(ℝ,realParabolicModel l) ∞ (realParabolic l) := sorry

theorem realParabolic.inclusion_smooth (l : A →ₐc[ℝ] LaurentPolynomial ℝ) :
    ContMDiff 𝓘(ℝ,realParabolicModel l) 𝓘(ℝ,realPoints.Model A) ∞
      (realParabolic l).subtype := sorry

/-- A character of the real parabolic, with the smoothness used by induction. -/
structure InducingCharacter (l : A →ₐc[ℝ] LaurentPolynomial ℝ) where
  character : realParabolic l →* ℂˣ
  smooth : ContMDiff 𝓘(ℝ,realParabolicModel l) 𝓘(ℝ,ℂ) ∞
    (fun p => (character p : ℂ))
  unipotent_trivial : ∀ u : realUnipotent l, character ⟨u.val,by sorry⟩=1

/-- Restriction of the actual adjoint representation to the unipotent tangent. -/
def parabolicAdUnipotent (l : A →ₐc[ℝ] LaurentPolynomial ℝ) (p : realParabolic l) :
    unipotentRealLie l ≃ₗ[ℝ] unipotentRealLie l := sorry

theorem parabolicAdUnipotent_apply (l : A →ₐc[ℝ] LaurentPolynomial ℝ)
    (p : realParabolic l) (X : unipotentRealLie l) :
    (parabolicAdUnipotent l p X).val = realPoints.algebraicAd p.val X.val := sorry

/-- Modular character computed by the actual adjoint action on the unipotent Lie algebra. -/
def parabolicDelta (l : A →ₐc[ℝ] LaurentPolynomial ℝ) :
    PositiveRealCharacter (realParabolic l) := sorry

theorem parabolicDelta_eq_det (l : A →ₐc[ℝ] LaurentPolynomial ℝ)
    (p : realParabolic l) :
    (parabolicDelta l p : ℝ) = |LinearMap.det (parabolicAdUnipotent l p).toLinearMap| := sorry

/-- The modular determinant is a root-theoretic/smooth-subgroup supplier obligation. -/
theorem parabolicDelta_positive (l : A →ₐc[ℝ] LaurentPolynomial ℝ)
    (p : realParabolic l) : 0 < (parabolicDelta l p : ℝ) := sorry
end DynamicParabolic
end TauCeti.RealReductive

namespace TauCeti.RealReductive
section CartanParameters
open TauCeti.RelativeLieCohomology
variable (q : Type) [NormedComplexLieAlgebra q]

/-- Supplier Cartan/root data, identified with the actual adjoint root spaces.
The Cartan includes the reductive centre; no Killing-form hypothesis is imposed. -/
structure ReductiveCartan where
  semisimple : LieIdeal ℂ q
  semisimple_isSemisimple : LieAlgebra.IsSemisimple ℂ semisimple
  centre : LieIdeal ℂ q
  centre_isCentre : centre = LieAlgebra.center ℂ q
  directSum : IsCompl centre semisimple
  h : LieSubalgebra ℂ q
  cartan : h.IsCartanSubalgebra
  abelian : ∀ X Y : h, ⁅X.val,Y.val⁆=0
  rootIndex : Type
  [rootFintype : Fintype rootIndex]
  R : RootPairing rootIndex ℂ (Module.Dual ℂ h) h
  rootSpaces : Set.range R.root = {α | α≠0 ∧ ∃ X : q, X≠0 ∧
    ∀ Y : h, ⁅Y.val,X⁆ = α Y • X}
  b : R.Base

attribute [instance] ReductiveCartan.rootFintype
variable {q}

def ReductiveCartan.rho (C : ReductiveCartan q) : Module.Dual ℂ C.h := by
  classical
  exact (1/2 : ℂ) • ∑ i : C.rootIndex, if C.b.IsPos i then C.R.root i else 0

/-- The invariant polynomial algebra uses the linear Weyl action on shifted parameters. -/
def ReductiveCartan.invariants (C : ReductiveCartan q) :
    Subalgebra ℂ (SymmetricAlgebra ℂ C.h) where
  carrier := {p | ∀ (w : C.R.weylGroup) (lam : Module.Dual ℂ C.h),
    SymmetricAlgebra.lift lam p = SymmetricAlgebra.lift (w • lam) p}
  mul_mem' := sorry
  add_mem' := sorry
  algebraMap_mem' := sorry

/-- The normalized reductive extension of the upstream Harish-Chandra projection. -/
def ReductiveCartan.harishChandra (C : ReductiveCartan q) :
    Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ q) ≃ₐ[ℂ] C.invariants := sorry

def infCharOf (C : ReductiveCartan q) (lam : Module.Dual ℂ C.h) : InfChar q :=
  (SymmetricAlgebra.lift lam).comp (C.invariants.val.comp C.harishChandra.toAlgHom)

theorem infCharOf_eq_iff (C : ReductiveCartan q) (lam μ : Module.Dual ℂ C.h) :
    infCharOf C lam = infCharOf C μ ↔ ∃ w : C.R.weylGroup, μ=w • lam := sorry

/-- The highest-weight condition is expressed by the real root-space operators. -/
def IsCartanHighestWeight {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] {H : Type} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
    {K : Type} [Group K] [TopologicalSpace K] [ChartedSpace H K]
    [LieGroup I ∞ K] [CompactSpace K] {P : Pair I K q}
    {V : Type} [AddCommGroup V] [Module ℂ V]
    (C : ReductiveCartan q) (M : GKModule P V) (μ : Module.Dual ℂ C.h) (v : V) : Prop :=
  v≠0 ∧ (∀ Y : C.h, M.rho Y.val v=μ Y • v) ∧
    ∀ (i : C.rootIndex), C.b.IsPos i → ∀ X : q,
      (∀ Y : C.h, ⁅Y.val,X⁆=C.R.root i Y • X) → M.rho X v=0

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {K : Type} [Group K] [TopologicalSpace K] [ChartedSpace H K]
  [LieGroup I ∞ K] [CompactSpace K] {P : Pair I K q}
  {V : Type} [AddCommGroup V] [Module ℂ V]

theorem infChar_highestWeight (C : ReductiveCartan q) (M : GKModule P V)
    (μ : Module.Dual ℂ C.h) (v : V) (hv : IsCartanHighestWeight C M μ v)
    (hgen : Submodule.span ℂ (Set.range (fun u : UniversalEnvelopingAlgebra ℂ q =>
      envelopingAction M u v)) = ⊤) :
    HasInfChar M (infCharOf C (μ+C.rho)) := sorry

/-- The dual vector for a nondegenerate invariant bilinear form. -/
def invariantFormDual {q : Type} [AddCommGroup q] [Module ℂ q] [FiniteDimensional ℂ q]
    (B : LinearMap.BilinForm ℂ q) (hB : B.Nondegenerate) :
    Module.Dual ℂ q ≃ₗ[ℂ] q := sorry

theorem invariantFormDual_spec {q : Type} [AddCommGroup q] [Module ℂ q] [FiniteDimensional ℂ q]
    (B : LinearMap.BilinForm ℂ q) (hB : B.Nondegenerate)
    (lam : Module.Dual ℂ q) (Y : q) : B (invariantFormDual B hB lam) Y=lam Y := sorry

def invariantCasimir (B : LinearMap.BilinForm ℂ q) (hB : B.Nondegenerate) :
    UniversalEnvelopingAlgebra ℂ q :=
  ∑ i, UniversalEnvelopingAlgebra.ι ℂ ((Module.finBasis ℂ q) i) *
    UniversalEnvelopingAlgebra.ι ℂ
      (invariantFormDual B hB ((Module.finBasis ℂ q).coord i))

def cartanRestrictedForm (C : ReductiveCartan q) (B : LinearMap.BilinForm ℂ q) :
    LinearMap.BilinForm ℂ C.h := sorry

theorem cartanRestrictedForm_apply (C : ReductiveCartan q) (B : LinearMap.BilinForm ℂ q)
    (X Y : C.h) : cartanRestrictedForm C B X Y=B X.val Y.val := sorry

def cartanDualForm (C : ReductiveCartan q) (B : LinearMap.BilinForm ℂ q)
    (hH : (cartanRestrictedForm C B).Nondegenerate) :
    LinearMap.BilinForm ℂ (Module.Dual ℂ C.h) := sorry

theorem cartanDualForm_apply (C : ReductiveCartan q) (B : LinearMap.BilinForm ℂ q)
    (hH : (cartanRestrictedForm C B).Nondegenerate) (lam μ : Module.Dual ℂ C.h) :
    cartanDualForm C B hH lam μ =
      lam (invariantFormDual (q := C.h) (cartanRestrictedForm C B) hH μ) := sorry

theorem infChar_casimir (C : ReductiveCartan q) (B : LinearMap.BilinForm ℂ q)
    (hB : B.Nondegenerate) (hs : ∀ X Y, B X Y=B Y X)
    (hi : ∀ (X Y Z : q), B ⁅X,Y⁆ Z + B Y ⁅X,Z⁆=0)
    (hH : (cartanRestrictedForm C B).Nondegenerate)
    (hc : invariantCasimir B hB ∈ Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ q))
    (lam : Module.Dual ℂ C.h) :
    infCharOf C lam ⟨invariantCasimir B hB,hc⟩ =
      cartanDualForm C B hH lam lam - cartanDualForm C B hH C.rho C.rho := sorry
end CartanParameters
end TauCeti.RealReductive

