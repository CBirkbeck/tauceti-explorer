structure SmoothCharacter (D : Datum A) where
  character : realPoints A →* ℂˣ
  smooth : ContMDiff 𝓘(ℝ,realPoints.Model A) 𝓘(ℝ,ℂ) ∞ (fun g => (character g : ℂ))

def SmoothCharacter.differential (χ : SmoothCharacter D) : complexAlgebraicLie A →ₗ[ℂ] ℂ := sorry

theorem SmoothCharacter.differential_real (χ : SmoothCharacter D) (X : algebraicRealLie A) :
    χ.differential D (1 ⊗ₜ[ℝ] X)=mfderiv 𝓘(ℝ,realPoints.Model A) 𝓘(ℝ,ℂ)
      (fun g => (χ.character g : ℂ)) 1 ((realPoints_lieAlgebra A).symm X) := sorry

def HCModule.twist {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : HCModule (P := D.pair) (V := V)) (χ : SmoothCharacter D) :
    HCModule (P := D.pair) (V := V) := sorry

theorem HCModule.twist_lie {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : HCModule (P := D.pair) (V := V)) (χ : SmoothCharacter D)
    (X : complexAlgebraicLie A) (v : V) :
    (HCModule.twist D M χ).rho X v=M.rho X v+χ.differential D X • v := sorry

theorem HCModule.twist_compact {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : HCModule (P := D.pair) (V := V)) (χ : SmoothCharacter D) (k : D.K) (v : V) :
    (HCModule.twist D M χ).sigma k v=(χ.character k.val : ℂ) • M.sigma k v := sorry

def IrrAdmissible.dual : IrrAdmissible.{0} D.pair → IrrAdmissible.{0} D.pair := sorry

def IrrAdmissible.twist (χ : SmoothCharacter D) :
    IrrAdmissible.{0} D.pair → IrrAdmissible.{0} D.pair := sorry

def IrrAdmissibleModel.ofHC {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : HCModule (P := D.pair) (V := V)) (hirr : IsIrreducibleGK M.toGKModule) :
    IrrAdmissibleModel.{0} D.pair where
  carrier := V
  action := M
  irreducible := hirr
  centralEquivariant := D.centre_invariant M.toGKModule

theorem IrrAdmissible.dual_representative (M : IrrAdmissibleModel.{0} D.pair) :
    IrrAdmissible.dual D (Quotient.mk _ M)=Quotient.mk _
      (IrrAdmissibleModel.ofHC D (HCModule.dual D M.action) (by sorry)) := sorry

theorem IrrAdmissible.twist_representative (χ : SmoothCharacter D) (M : IrrAdmissibleModel.{0} D.pair) :
    IrrAdmissible.twist D χ (Quotient.mk _ M)=Quotient.mk _
      (IrrAdmissibleModel.ofHC D (HCModule.twist D M.action χ) (by sorry)) := sorry

def HCModule.bidualevaluation {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : HCModule (P := D.pair) (V := V)) :
    V ≃ₗ[ℂ] kFinite (contragredient (HCModule.dual D M).toGKModule) := sorry

theorem HCModule.bidualevaluation_apply {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : HCModule (P := D.pair) (V := V)) (v : V)
    (l : kFinite (contragredient M.toGKModule)) :
    (HCModule.bidualevaluation D M v).val l=l.val v := sorry
