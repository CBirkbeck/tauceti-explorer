/-- The native trace-zero algebra inside the scalar-extended GL₂ tangent. -/
def traceZero : LieSubalgebra ℂ Q where
  carrier := {X | Matrix.trace (realPoints.GLcomplexLie 2 X)=0}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry
  lie_mem' := sorry

def sl2O2Pair : Pair 𝓘(ℝ,D.KModel) D.K traceZero :=
  Pair.ofSubalgebra D.pair traceZero (by sorry) (by sorry)

def sl2SO2Pair : Pair 𝓘(ℝ,D.KModel) (CompactIdentity (K := D.K)) traceZero :=
  sl2O2Pair.identityComponent

def rotationSO2 (t : ℝ) : CompactIdentity (K := D.K) := ⟨rotation t, by sorry⟩

theorem rotationSO2_coe (t : ℝ) : (rotationSO2 t).val=rotation t := rfl

