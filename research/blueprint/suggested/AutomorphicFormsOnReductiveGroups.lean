theorem gsp4_roots :
    rootCoordinates '' compactRoots hermitian=(compactRootCoordinates : Set (ℤ × ℤ × ℤ)) ∧
    rootCoordinates '' plusRoots hermitian=(plusRootCoordinates : Set (ℤ × ℤ × ℤ)) ∧
    Set.range rootCoordinates=(allRootCoordinates : Set (ℤ × ℤ × ℤ)) := sorry

