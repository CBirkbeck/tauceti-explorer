def balancedMatrices : BalancedLie (A := A) ≃ₗ⁅ℂ⁆ LieAlgebra.SpecialLinear.sl (Fin 2) ℂ := sorry

theorem balancedMatrices_projection (X : complexAlgebraicLie A) :
    balancedMatrices (balancedProjection (A := A) X)=TauCeti.RealReductive.SL2.lieMatrices X := sorry

def hermitian : HermitianDatum D := sorry

