open TauCeti.RelativeLieCohomology
abbrev D := Datum.generalLinear 2
abbrev Q := complexAlgebraicLie (GLCoordinate 2)

/-- The diagonal complex Cartan transported through the algebraic tangent map. -/
def cartan : ReductiveCartan Q := sorry

theorem cartan_mem (X : Q) : X∈cartan.h ↔
    (realPoints.GLcomplexLie 2 X) 0 1=0 ∧ (realPoints.GLcomplexLie 2 X) 1 0=0 := sorry

def parameter (a b : ℂ) : Module.Dual ℂ cartan.h where
  toFun X := a*(realPoints.GLcomplexLie 2 X.val) 0 0 +
    b*(realPoints.GLcomplexLie 2 X.val) 1 1
  map_add' := sorry
  map_smul' := sorry

theorem rho_parameter : cartan.rho=parameter (1/2) (-1/2) := sorry

def chi (a b : ℂ) : InfChar Q := infCharOf cartan (parameter a b)

theorem infChar_weyl_invariant (a b : ℂ) : chi a b=chi b a := sorry

-- test: infChar_weyl_invariant
example (a b : ℂ) : chi a b=chi b a := sorry

theorem infChar_not_linear_action :
    chi (3/2) (-1/2) ≠ chi (1/2) (1/2) := sorry

-- test: infChar_not_linear_action
example :
    chi (3/2) (-1/2) ≠ chi (1/2) (1/2) := sorry

/-- Clockwise rotation and a reflection in the native fixed-point compact group. -/
def rotation (t : ℝ) : D.K := sorry
theorem rotation_matrix (t : ℝ) : (realPoints.GL 2 (rotation t).val).val =
    !![Real.cos t, Real.sin t; -Real.sin t, Real.cos t] := sorry

def reflection : D.K := sorry
theorem reflection_matrix : (realPoints.GL 2 reflection.val).val =
    (!![1,0;0,-1] : Matrix (Fin 2) (Fin 2) ℝ) := sorry

/-- The O(2) action extends both weight rays; a reflection exchanges them. -/
def discreteSeries (k : ℕ) (hk : 1≤k) (s : ℂ) : HCModule (P := D.pair) (V := WeightModel k) := sorry

theorem discreteSeries_rotation (k : ℕ) (hk : 1≤k) (s : ℂ)
    (t : ℝ) (f : WeightModel k) (ell : ℤ) :
    ((discreteSeries k hk s).sigma (rotation t) f).val ell =
      Complex.exp (Complex.I * (ell : ℂ) * (t : ℂ)) * f.val ell := sorry

theorem discreteSeries_reflection (k : ℕ) (hk : 1≤k) (s : ℂ)
    (f : WeightModel k) (ell : ℤ) :
    ((discreteSeries k hk s).sigma reflection f).val ell=f.val (-ell) := sorry

/-- H, X, Y are the compact-Cartan matrices; the scalar matrix acts by s. -/
theorem discreteSeries_lie (k : ℕ) (hk : 1≤k) (s : ℂ) (f : WeightModel k) :
    ((discreteSeries k hk s).rho ((realPoints.GLcomplexLie 2).symm compactH) f).val=weightH f.val ∧
    ((discreteSeries k hk s).rho ((realPoints.GLcomplexLie 2).symm compactX) f).val=weightX k f.val ∧
    ((discreteSeries k hk s).rho ((realPoints.GLcomplexLie 2).symm compactY) f).val=weightY k f.val ∧
    (discreteSeries k hk s).rho ((realPoints.GLcomplexLie 2).symm 1) f=s • f := sorry

/-- The normalized sl₂ Casimir in the actual universal enveloping algebra. -/
def casimir : Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ Q) := by
  let H := UniversalEnvelopingAlgebra.ι ℂ ((realPoints.GLcomplexLie 2).symm compactH)
  let X := UniversalEnvelopingAlgebra.ι ℂ ((realPoints.GLcomplexLie 2).symm compactX)
  let Y := UniversalEnvelopingAlgebra.ι ℂ ((realPoints.GLcomplexLie 2).symm compactY)
  exact ⟨(1/4 : ℂ) • (H*H+2•(X*Y)+2•(Y*X)), by sorry⟩

theorem chi_casimir (a b : ℂ) : chi a b casimir=((a-b)^2-1)/4 := sorry

theorem discreteSeries_casimir (k : ℕ) (hk : 1≤k) (s : ℂ) (f : WeightModel k) :
    envelopingAction (discreteSeries k hk s).toGKModule casimir.val f =
      ((k : ℂ)*(k-2)/4) • f := sorry

theorem discreteSeries_infChar (k : ℕ) (hk : 1≤k) (s : ℂ) :
    HasInfChar (discreteSeries k hk s).toGKModule
      (chi ((s+k-1)/2) ((s-k+1)/2)) := sorry

def rotationWeightSpace (k : ℕ) (hk : 1≤k) (s : ℂ) (ell : ℤ) :
    Submodule ℂ (WeightModel k) where
  carrier := {f | ∀ t : ℝ, (discreteSeries k hk s).sigma (rotation t) f =
    Complex.exp (Complex.I*(ell : ℂ)*(t : ℂ)) • f}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

theorem discreteSeries_ktypes (k : ℕ) (hk : 1≤k) (s : ℂ) (ell : ℤ) :
    Module.finrank ℂ (rotationWeightSpace k hk s ell) =
      if (k : ℤ)≤|ell| ∧ (ell-(k : ℤ))%2=0 then 1 else 0 := sorry

theorem discreteSeries_irreducible (k : ℕ) (hk : 1≤k) (s : ℂ) :
    IsIrreducibleGK (discreteSeries k hk s).toGKModule := sorry

-- test: infChar_trivial_gl2, infChar_k_weight
example : HasInfChar (GKModule.trivial D.pair) (chi (1/2) (-1/2)) ∧
    chi (1/2) (-1/2) casimir=0 := sorry
example (k : ℕ) (hk : 2≤k) :
    HasInfChar (discreteSeries k (by omega) 0).toGKModule (chi ((k-1)/2) ((1-k)/2)) := sorry

-- tests on the integrated O(2) module, not only its auxiliary weight operators.
theorem gl2DS_casimir_k2 (s : ℂ) (f : WeightModel 2) :
    envelopingAction (discreteSeries 2 (by omega) s).toGKModule casimir.val f=0 := sorry

-- test: gl2DS_casimir_k2
example (s : ℂ) (f : WeightModel 2) :
    envelopingAction (discreteSeries 2 (by omega) s).toGKModule casimir.val f=0 := sorry

theorem gl2DS_casimir_k12 (s : ℂ) (f : WeightModel 12) :
