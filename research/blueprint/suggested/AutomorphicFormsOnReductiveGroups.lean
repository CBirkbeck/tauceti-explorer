namespace TauCeti.RealReductive
open TauCeti.RelativeLieCohomology CategoryTheory
section PrincipalSeriesNative
attribute [local instance] LieGroup.minSmoothnessThree
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A]
  [Algebra.FiniteType ℝ A] [Algebra.Smooth ℝ A] (D : Datum A)

/-- Constant Banach coordinates realize the given finite-dimensional coefficient. -/
def finiteCoefficient (n : ℕ) : Submodule ℂ (ℕ → EuclideanSpace ℂ (Fin n)) where
  carrier := {v | ∀ i j, v i=v j}
  zero_mem' := by simp
  add_mem' := by intro x y hx hy i j; simp only [Pi.add_apply]; rw [hx i j,hy i j]
  smul_mem' := by intro a x hx i j; simp only [Pi.smul_apply]; rw [hx i j]

instance (n : ℕ) : FiniteDimensional ℂ (finiteCoefficient n) := sorry

structure PrincipalCoefficient (D : Datum A) where
  cocharacter : A →ₐc[ℝ] LaurentPolynomial ℝ
  minimal : IsMinimalParabolic cocharacter
  dimension : ℕ
  representation : ContRepresentation ℂ (realParabolic cocharacter) (finiteCoefficient dimension)
  smooth : ∀ (v : finiteCoefficient dimension) i,
    ContMDiff 𝓘(ℝ,realParabolicModel cocharacter) 𝓘(ℝ,EuclideanSpace ℂ (Fin dimension)) ∞
      (fun p => (representation p v).val i)

/-- Unnormalized covariance f(pg)=W(p)f(g), obtained by cancelling δ^(1/2). -/
def PrincipalCoefficient.unnormalizingCharacter (W : PrincipalCoefficient D) :
    InducingCharacter W.cocharacter := sorry

theorem PrincipalCoefficient.unnormalizingCharacter_apply (W : PrincipalCoefficient D)
    (p : realParabolic W.cocharacter) :
    (W.unnormalizingCharacter D).character p =
      Units.mk0 ((Real.rpow ((parabolicDelta W.cocharacter p : ℝ)) (-1/2) : ℂ)) (by sorry) := sorry

abbrev PrincipalCoefficient.functions (W : PrincipalCoefficient D) :=
  normalizedInduction (E := realPoints.Model A) (fun _ => EuclideanSpace ℂ (Fin W.dimension))
    (finiteCoefficient W.dimension) (realParabolic W.cocharacter) W.representation
      (parabolicDelta W.cocharacter) (W.unnormalizingCharacter D).character

def principalSeries (W : PrincipalCoefficient D) : SAFModuleCat D := sorry

/-- This identifies the constructed SF carrier with the prescribed smooth functions. -/
def principalSeriesCarrier (W : PrincipalCoefficient D) :
    (principalSeries D W).S ≃L[ℂ] W.functions D := sorry

theorem principalSeries_covariance (W : PrincipalCoefficient D)
    (f : (principalSeries D W).S) (p : realParabolic W.cocharacter) (g : realPoints A) :
    (principalSeriesCarrier D W f).val (p.val*g)=
      W.representation p ((principalSeriesCarrier D W f).val g) := sorry

theorem principalSeries_action (W : PrincipalCoefficient D)
    (f : (principalSeries D W).S) (g x : realPoints A) :
    (principalSeriesCarrier D W ((principalSeries D W).representation.π g f)).val x=
      (principalSeriesCarrier D W f).val (x*g) := sorry

def principalSeries_kFinite (W : PrincipalCoefficient D) : HCModuleCat D.pair :=
  (kFiniteFunctor D).obj (principalSeries D W)

abbrev PrincipalCoefficient.compactFunctions (W : PrincipalCoefficient D) :=
  normalizedInduction.compactPicture (Ek := D.KModel)
    (fun _ => EuclideanSpace ℂ (Fin W.dimension)) (finiteCoefficient W.dimension)
    (realParabolic W.cocharacter) W.representation (parabolicDelta W.cocharacter)
    (W.unnormalizingCharacter D).character D.K.subtype

def normalizedInduction.compactAction (W : PrincipalCoefficient D) :
    Representation ℂ D.K (W.compactFunctions D) := sorry

theorem normalizedInduction.compactAction_apply (W : PrincipalCoefficient D)
    (k x : D.K) (f : W.compactFunctions D) :
    ((normalizedInduction.compactAction D W k) f).val x=f.val (x*k) := sorry

/-- Restriction is the actual function restriction, not an assumed bijection. -/
def principalSeries_restrictK (W : PrincipalCoefficient D) :
    ((principalSeries_kFinite D W).obj.carrier) ≃ₗ[ℂ]
      kFinite (K := D.K) (V := W.compactFunctions D) (normalizedInduction.compactAction D W) := sorry

-- The compact action is right translation on the native compact picture.

theorem principalSeries_restrictK_apply (W : PrincipalCoefficient D)
    (f : (principalSeries_kFinite D W).obj.carrier) (k : D.K) :
    (principalSeries_restrictK D W f).val.val k =
      (principalSeriesCarrier D W ((kFiniteFunctorCarrier D (principalSeries D W) f).val)).val k.val := sorry

def principalSeries_map (W W' : PrincipalCoefficient D)
    (hp : W.cocharacter=W'.cocharacter)
    (T : finiteCoefficient W.dimension →L[ℂ] finiteCoefficient W'.dimension)
    (hT : ∀ (p : realParabolic W.cocharacter) v,
      T (W.representation p v)=W'.representation ⟨p.val,by simp [←hp]⟩ (T v)) :
    SAFModuleCat.Hom D (principalSeries D W) (principalSeries D W') := sorry

theorem principalSeries_map_apply (W W' : PrincipalCoefficient D)
    (hp : W.cocharacter=W'.cocharacter)
    (T : finiteCoefficient W.dimension →L[ℂ] finiteCoefficient W'.dimension)
    (hT : ∀ (p : realParabolic W.cocharacter) v,
      T (W.representation p v)=W'.representation ⟨p.val,by simp [←hp]⟩ (T v))
    (f : (principalSeries D W).S) (g : realPoints A) :
    (principalSeriesCarrier D W' ((principalSeries_map D W W' hp T hT).toContinuousLinearMap f)).val g=
      T ((principalSeriesCarrier D W f).val g) := sorry

/-- The δ-twisted contragredient coefficient gives the −ν+ρ covariance. -/
def PrincipalCoefficient.dual (W : PrincipalCoefficient D) : PrincipalCoefficient D := sorry

theorem PrincipalCoefficient.dual_cocharacter (W : PrincipalCoefficient D) :
    (W.dual D).cocharacter=W.cocharacter := sorry

def PrincipalCoefficient.dualPairing (W : PrincipalCoefficient D) :
    finiteCoefficient (W.dual D).dimension ≃ₗ[ℂ] Module.Dual ℂ (finiteCoefficient W.dimension) := sorry

theorem PrincipalCoefficient.dual_action (W : PrincipalCoefficient D)
    (p : realParabolic (W.dual D).cocharacter)
    (l : finiteCoefficient (W.dual D).dimension) (v : finiteCoefficient W.dimension) :
    W.dualPairing D ((W.dual D).representation p l) v=
      ((parabolicDelta W.cocharacter
        ⟨p.val, by simpa [W.dual_cocharacter D] using p.property⟩ : ℝ) : ℂ)*
      W.dualPairing D l (W.representation
        ⟨p.val⁻¹,by simpa [W.dual_cocharacter D] using p⁻¹.property⟩ v) := sorry

/-- The integral pairing is the specified contragredient isomorphism. -/
def principalSeries_dual (W : PrincipalCoefficient D) :
    ((principalSeries_kFinite D (W.dual D)).obj.carrier) ≃ₗ[ℂ]
      kFinite (K := D.K) (contragredient ((principalSeries_kFinite D W).obj.action)) := sorry

theorem principalSeries_dual_pairing (W : PrincipalCoefficient D)
    (dk : Measure D.K) [dk.IsHaarMeasure] [IsProbabilityMeasure dk]
    (f : (principalSeries_kFinite D (W.dual D)).obj.carrier)
    (v : (principalSeries_kFinite D W).obj.carrier) :
    (principalSeries_dual D W f).val v=
      ∫ k : D.K, W.dualPairing D
        ((principalSeries_restrictK D (W.dual D) f).val.val k)
        ((principalSeries_restrictK D W v).val.val k) ∂dk := sorry

/-- Casselman embeds the entire module, including finite-length nonsimple modules. -/
theorem casselman_embedding (X : HCModuleCat D.pair) :
    ∃ (W : PrincipalCoefficient D) (f : GKModule.Hom X.obj.action
      (principalSeries_kFinite D W).obj.action), Function.Injective f.toLinearMap := sorry

-- test: principalSeries_hc_compat
example (W : PrincipalCoefficient D) :
    IsAdmissible (principalSeries_kFinite D W).obj.action ∧
      IsFinitelyGenerated (principalSeries_kFinite D W).obj.action := sorry
end PrincipalSeriesNative
end TauCeti.RealReductive

namespace TauCeti.RealReductive
section IntegratedFrechetAction
variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [ChartedSpace E G]
  [LieGroup 𝓘(ℝ,E) ∞ G] [LocallyCompactSpace G] [T2Space G] [SecondCountableTopology G]
  [MeasurableSpace G] [BorelSpace G]
  {B : ℕ → Type} [∀ n, NormedAddCommGroup (B n)] [∀ n, NormedSpace ℂ (B n)]
  [∀ n, CompleteSpace (B n)] {V : Submodule ℂ (∀ n, B n)} {height : G → ℝ}
  (π : SFRep 𝓘(ℝ,E) G B V height) (dg : Measure G) [dg.IsHaarMeasure]

/-- Integration is taken in each Banach coordinate and lands in the actual closed carrier. -/
def SFRep.integrated (π : SFRep 𝓘(ℝ,E) G B V height) (dg : Measure G) [dg.IsHaarMeasure] (f : TauCeti.Automorphic.ArchTestFunction (Ginf := G) 𝓘(ℝ,E)) :
    V →L[ℂ] V := sorry

theorem SFRep.integrated_coordinate
    (f : TauCeti.Automorphic.ArchTestFunction (Ginf := G) 𝓘(ℝ,E)) (v : V) (n : ℕ) :
    (π.integrated dg f v).val n=∫ g : G, f.val g • (π.π g v).val n ∂dg := sorry

/-- Finite factorization on the full Fréchet carrier, not a Banach-only assertion. -/
theorem dixmierMalliavin (v : V) :
    ∃ (m : ℕ) (f : Fin m → TauCeti.Automorphic.ArchTestFunction (Ginf := G) 𝓘(ℝ,E))
      (w : Fin m → V), v=∑ i, π.integrated dg (f i) (w i) := sorry
end IntegratedFrechetAction

section NormAndExtensionSpecifications
open TauCeti.RelativeLieCohomology CategoryTheory
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A]
  [Algebra.FiniteType ℝ A] [Algebra.Smooth ℝ A] (D : Datum A)
  {V : Type} [AddCommGroup V] [Module ℂ V]

-- test: gContinuous_finiteDim. Completion is the integrated finite-dimensional module.
theorem gContinuous_finiteDim [FiniteDimensional ℂ V]
    (M : HCModule (P := D.pair) (V := V)) (p : Seminorm ℂ V) (hp : ∀ v, p v=0 → v=0) :
    ∃ r : GContinuousNorm M D.K.subtype D.complexLieTangent, r.norm=p := sorry

-- test: gContinuous_finiteDim
example [FiniteDimensional ℂ V]
    (M : HCModule (P := D.pair) (V := V)) (p : Seminorm ℂ V) (hp : ∀ v, p v=0 → v=0) :
    ∃ r : GContinuousNorm M D.K.subtype D.complexLieTangent, r.norm=p := sorry

/-- The unit and counit specify identity on K-finite vectors, rather than arbitrary equivalences. -/
theorem casselmanWallach_counit (X : HCModuleCat D.pair)
    (v : X.obj.carrier) :
    ((casselmanWallach D).counitIso.hom.app X).hom.toLinearMap
      (((casselmanWallach D).counitIso.inv.app X).hom.toLinearMap v)=v := sorry

/-- Exactness is reflected in kernels and ranges of the actual continuous extensions. -/
theorem casselmanWallach_exact {X Y Z : HCModuleCat D.pair}
    (f : X ⟶ Y) (g : Y ⟶ Z)
    (hex : LinearMap.range f.hom.toLinearMap=LinearMap.ker g.hom.toLinearMap) :
    LinearMap.range ((globalizationFunctor D).map f).toContinuousLinearMap.toLinearMap=
      LinearMap.ker ((globalizationFunctor D).map g).toContinuousLinearMap.toLinearMap := sorry

/-- Admissibility has uniformly bounded K-type multiplicities on an irreducible module. -/
theorem admissible_of_irreducible_bound (M : GKModule D.pair V)
    (hM : IsIrreducibleGK M) :
    ∃ C : ℕ, ∀ n (σ : Representation ℂ D.K (Fin n → ℂ)), IsIrreducible σ →
      Module.finrank ℂ (multiplicity n σ M.sigma)≤C*n := sorry

/-- Finitely generated admissible modules are noetherian and artinian over U(g). -/
theorem hcModule_finiteLength (M : HCModule (P := D.pair) (V := V)) :
    letI := Module.compHom V (envelopingAction M.toGKModule).toRingHom
    IsNoetherian (UniversalEnvelopingAlgebra ℂ (complexAlgebraicLie A)) V ∧
      IsArtinian (UniversalEnvelopingAlgebra ℂ (complexAlgebraicLie A)) V := sorry

/-- A fixed scalar central character has only finitely many irreducible HC classes. -/
theorem admissible_of_irreducible_finite_fibres (χ : InfChar (complexAlgebraicLie A)) :
    Set.Finite {π : IrrAdmissible.{0} D.pair | IrrAdmissible.infChar D.pair π=χ} := sorry
end NormAndExtensionSpecifications
