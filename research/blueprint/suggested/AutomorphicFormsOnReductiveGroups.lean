section SphericalAndFiniteFlath
variable {F : Type} [Field F] [NumberField F] {H : Type} [CommRing H]
  [HopfAlgebra F H] [Algebra.FiniteType F H] [Algebra.Smooth F H]
  (D : Arithmetic.Datum F H)

/-- The bound is ≤1, including nonspherical irreducible modules. -/
theorem finrank_spherical_le_one (v : Arithmetic.FinitePlaceIndex F)
    (K : Arithmetic.HyperspecialDatum F H v) (M : SmoothLocalModel (Arithmetic.LocalPoints F H v)) :
    FiniteDimensional ℂ (fixedVectors (M.action.comp K.K.subtype)) ∧
      Module.finrank ℂ (fixedVectors (M.action.comp K.K.subtype))≤1 := sorry

/-- Native local-vector choices define the colimit; no pure-sequence replacement. -/
structure FiniteFactorization (_D : Arithmetic.Datum F H) (N : SmoothLocalModel (Arithmetic.FinitePoints F H)) where
  localFactor : ∀ v : Arithmetic.FinitePlaceIndex F, SmoothLocalModel (Arithmetic.LocalPoints F H v)
  compact : ∀ v : Arithmetic.FinitePlaceIndex F, Subgroup (Arithmetic.LocalPoints F H v)
  open_set : ∀ v, IsOpen (compact v : Set (Arithmetic.LocalPoints F H v))
  isCompact : ∀ v, IsCompact (compact v : Set (Arithmetic.LocalPoints F H v))
  reductive : ∀ᶠ v in Filter.cofinite, ∃ K : Arithmetic.HyperspecialDatum F H v, compact v=K.K
  spherical : ∀ v, (localFactor v).carrier
  nonzero : ∀ v, spherical v≠0
  fixed : ∀ᶠ v in Filter.cofinite, ∀ k : compact v, (localFactor v).action k.val (spherical v)=spherical v
  linear : RestrictedTensor (fun v => (localFactor v).carrier) spherical ≃ₗ[ℂ] N.carrier
  intertwines : ∀ (S : Finset (Arithmetic.FinitePlaceIndex F))
    (a : ∀ v : S, (localFactor v.val).carrier) (g : Arithmetic.FinitePoints F H),
    (∀ v∉S, (localFactor v).action (Arithmetic.localProjection F H v g) (spherical v)=spherical v) →
      N.action g (linear (RestrictedTensor.of (fun v => (localFactor v).carrier) spherical S
        (PiTensorProduct.tprod ℂ a)))=
      linear (RestrictedTensor.of (fun v => (localFactor v).carrier) spherical S
        (PiTensorProduct.tprod ℂ (fun v => (localFactor v.val).action
          (Arithmetic.localProjection F H v.val g) (a v))))

/-- Flath on the actual global carrier; archimedean place refinement follows below. -/
theorem flath (π : D.representationModel) :
    ∃ f : ArchFiniteFactorization D π,
      Nonempty (FiniteFactorization D f.finite) ∧
      (∀ f' : ArchFiniteFactorization D π,
        (IrrAdmissibleModel.isoSetoid D.realDatum.pair).r f.arch f'.arch ∧
        SmoothLocalModel.iso f.finite f'.finite) := sorry
end SphericalAndFiniteFlath
end TauCeti.Automorphic

