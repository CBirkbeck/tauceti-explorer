/-- Rapid decay on the arithmetic norm-one Siegel set, including every right
Lie derivative. The coefficient has an actual continuous central character.
Harish-Chandra's analytic argument remains the recorded source-proof gap. -/
theorem CuspForm.rapidDecay (f : D.cuspForms)
    (chi : Subgroup.center G →* ℂˣ) (hchi : Continuous chi)
    (hcentral : ∀ (z : Subgroup.center G) g,
      f.val.val.val (z.val*g)=(chi z : ℂ)*f.val.val.val g)
    (S : Suppliers.AdelicAlgebraicGroups.SiegelSet D)
    (u : UniversalEnvelopingAlgebra ℂ (complexAlgebraicLie (Arithmetic.ArchCoordinate F H)))
    (N : ℕ) :
    ∃ C : ℝ, 0<C ∧ ∀ g∈S.carrier,
      g∈Suppliers.AdelicAlgebraicGroups.normOne (F := F) (H := H) →
      ‖(SmoothAdelicFunction.envelopingAction 𝓘(ℝ,realPoints.Model (Arithmetic.ArchCoordinate F H))
        ((UniversalEnvelopingAlgebra.lift ℂ
          ((UniversalEnvelopingAlgebra.ι ℂ (L := TauCeti.ComplexGroupLie 𝓘(ℝ,realPoints.Model (Arithmetic.ArchCoordinate F H)) (realPoints (Arithmetic.ArchCoordinate F H)))).comp D.realDatum.complexLieTangent.toLieHom)) u) f.val.val).val g‖≤
          C*(D.embedding.height F H g)^(-(N : ℝ)) := sorry
