def Arithmetic.Datum.cuspAction : GlobalHeckeModule (Arithmetic.FinitePoints F H)
    D.realDatum.pair D.cuspForms := sorry

theorem Arithmetic.Datum.cuspAction_lie (X) (f : D.cuspForms) :
    (D.cuspAction.rho X f).val=D.functionAction.action.rho X f.val := sorry

