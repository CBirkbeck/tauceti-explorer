/-- The constructor exhausts square-integrable classes. Limits are distinguished
by the regularity condition, rather than counted as square-integrable. -/
theorem discreteSeries_exhaustive (hconn : IsConnectedModuloCentre (A := A))
    (pi : IrrAdmissible.{0} D.pair) (hpi : IsDiscreteSeriesClass D pi) :
    ∃ (T : CompactCartan D) (p : DiscreteSeriesParameter T) (hp : p.NonDegenerate),
      p.Regular ∧ discreteSeries hconn T p hp=pi := sorry

/-- Lowest compact type on the identity component, with the full central
extension retained in the constructed discrete-series class. -/
theorem discreteSeries_lowestKType (hconn : IsConnectedModuloCentre (A := A))
    (T : CompactCartan D) (p : DiscreteSeriesParameter T) (hp : p.NonDegenerate) :
    ∃ M : IrrAdmissibleModel.{0} D.pair,
      Quotient.mk _ M=discreteSeries hconn T p hp ∧
      ∃ v, HasCompactHighestWeight T
        (GKModule.restrict D.pair.identityComponentHom M.action.toGKModule)
          (p.lambda+T.rhoNoncompact-T.rhoCompact) v := sorry

