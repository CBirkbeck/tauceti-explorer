  [T2Space G] [IsTopologicalGroup G] [Finite (ConnectedComponents G)]

def IsMaximalCompact (K : Subgroup G) : Prop :=
  IsCompact (K : Set G) ∧ ∀ L : Subgroup G, IsCompact (L : Set G) → K≤L → L=K

theorem maximalCompact_exists : ∃ K : Subgroup G, IsMaximalCompact K := sorry

theorem compact_contained_maximalCompact (L : Subgroup G) (hL : IsCompact (L : Set G)) :
    ∃ K : Subgroup G, IsMaximalCompact K ∧ L≤K := sorry

theorem maximalCompact_conjugate (K L : Subgroup G)
    (hK : IsMaximalCompact K) (hL : IsMaximalCompact L) :
    ∃ g : G, L=K.map (MulAut.conj g).toMonoidHom := sorry
