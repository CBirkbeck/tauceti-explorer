namespace TauCeti.Automorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
section HermitianGeometry
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A)

/-- Central real cocharacters retain the algebraic group, not only its Lie centre. -/
def centralRealCocharacter : Set (A →ₐc[ℝ] LaurentPolynomial ℝ) :=
  {l | ∀ t : ℝˣ, ∀ g : realPoints A,
    realPoints_map l ((TauCeti.MultiplicativeGroup.pointsMulEquiv (R := ℝ) (A := ℝ)).symm t)*g=
      g*realPoints_map l ((TauCeti.MultiplicativeGroup.pointsMulEquiv (R := ℝ) (A := ℝ)).symm t)}

/-- Derivative of the actual real cocharacter at 1. -/
def cocharacterTangent (l : A →ₐc[ℝ] LaurentPolynomial ℝ) : algebraicRealLie A :=
  TauCeti.derivationCompLieHom (B := ℝ) l
    ((TauCeti.MultiplicativeGroup.tangentLinearEquiv (R := ℝ) (B := ℝ)).symm 1)

def splitCentreLie : LieIdeal ℂ (complexAlgebraicLie A) := sorry

theorem splitCentreLie_span : (splitCentreLie (A := A)).toSubmodule=
    Submodule.span ℂ {X | ∃ l∈centralRealCocharacter (A := A),
      X=1 ⊗ₜ[ℝ] cocharacterTangent l} := sorry

theorem splitCentreLie_central : splitCentreLie (A := A)≤LieAlgebra.center ℂ (complexAlgebraicLie A) := sorry

abbrev BalancedLie := complexAlgebraicLie A ⧸ splitCentreLie (A := A)
instance balancedLie.normedAddCommGroup : NormedAddCommGroup (BalancedLie (A := A)) :=
  NormedAddCommGroup.induced _ _ (Module.finBasis ℂ (BalancedLie (A := A))).equivFun.toAddMonoidHom
    (Module.finBasis ℂ (BalancedLie (A := A))).equivFun.injective
instance balancedLie.normedSpace : NormedSpace ℂ (BalancedLie (A := A)) :=
  NormedSpace.induced _ _ _ (Module.finBasis ℂ (BalancedLie (A := A))).equivFun.toLinearMap
instance : NormedComplexLieAlgebra (BalancedLie (A := A)) :=
  { (inferInstance : NormedAddCommGroup (BalancedLie (A := A))),
    (inferInstance : LieRing (BalancedLie (A := A))),
    (inferInstance : NormedSpace ℂ (BalancedLie (A := A))),
    (inferInstance : LieAlgebra ℂ (BalancedLie (A := A))),
    (inferInstance : FiniteDimensional ℂ (BalancedLie (A := A))) with }

def balancedProjection : complexAlgebraicLie A →ₗ⁅ℂ⁆ BalancedLie (A := A) where
  toLinearMap := (splitCentreLie (A := A)).toSubmodule.mkQ
  map_lie' := by sorry

/-- A Hermitian structure is its actual ±i eigenspace decomposition, compatible
with the native Cartan involution and connected compact action. -/
structure HermitianDatum (D : Datum A) where
  J : BalancedLie (A := A) →ₗ[ℂ] BalancedLie (A := A)
  pProjection : BalancedLie (A := A) →ₗ[ℂ] BalancedLie (A := A)
  projection_squared : pProjection.comp pProjection=pProjection
  projection_kernel : LinearMap.ker pProjection=
    Submodule.map (balancedProjection (A := A)).toLinearMap D.pair.iota.range.toSubmodule
  projection_range : LinearMap.range pProjection=Submodule.span ℂ
    {X | ∃ Y∈D.noncompactLie, X=balancedProjection (A := A) (1 ⊗ₜ[ℝ] Y)}
  compact_equivariant : ∀ k : D.K, ∀ X Y : complexAlgebraicLie A,
    J (balancedProjection (A := A) X)=balancedProjection (A := A) Y →
    J (balancedProjection (A := A) (D.pair.Ad k X))=
      balancedProjection (A := A) (D.pair.Ad k Y)
  J_squared : J.comp J=-pProjection
  pPlus : LieSubalgebra ℂ (BalancedLie (A := A))
  pMinus : LieSubalgebra ℂ (BalancedLie (A := A))
  plus_eigenspace : pPlus.toSubmodule=LinearMap.ker (J-Complex.I • LinearMap.id)
  tangent_decomposition : pPlus.toSubmodule ⊔ pMinus.toSubmodule=LinearMap.range pProjection
  minus_eigenspace : pMinus.toSubmodule=LinearMap.ker (J-(-Complex.I) • LinearMap.id)
  minus_abelian : ∀ X Y : pMinus, ⁅X.val,Y.val⁆=0
  cartan : ReductiveCartan (BalancedLie (A := A))

namespace Hermitian
variable {D} (T : HermitianDatum D)

/-- Quotient of the identity-component pair by the real split central directions. -/
def balancedPair : Pair 𝓘(ℝ,D.KModel) (CompactIdentity (K := D.K)) (BalancedLie (A := A)) := sorry

theorem balancedPair_iota (X : TauCeti.ComplexGroupLie 𝓘(ℝ,D.KModel)
    (CompactIdentity (K := D.K))) :
    (balancedPair (D := D)).iota X=
      balancedProjection (A := A) (D.pair.identityComponent.iota X) := sorry

def compactRoots : Set T.cartan.rootIndex :=
  {i | ∃ X : (balancedPair (D := D)).iota.range, X.val≠0 ∧
    ∀ Y : T.cartan.h, ⁅Y.val,X.val⁆=T.cartan.R.root i Y • X.val}

def noncompactRoots : Set T.cartan.rootIndex := (compactRoots T)ᶜ

def plusRoots : Set T.cartan.rootIndex :=
  {i | ∃ X : T.pPlus, X.val≠0 ∧
    ∀ Y : T.cartan.h, ⁅Y.val,X.val⁆=T.cartan.R.root i Y • X.val}

def IsHCPositive (b : T.cartan.R.Base) : Prop :=
  {i | b.IsPos i}∩noncompactRoots T=plusRoots T

/-- The Hodge subalgebra is k_C+p⁻ in the balanced Lie algebra. -/
def hodgeParabolic : LieSubalgebra ℂ (BalancedLie (A := A)) :=
  (balancedPair (D := D)).iota.range ⊔ T.pMinus

instance : NormedComplexLieAlgebra (hodgeParabolic T) :=
  { (inferInstance : NormedAddCommGroup (hodgeParabolic T)),
    (inferInstance : LieRing (hodgeParabolic T)),
    (inferInstance : NormedSpace ℂ (hodgeParabolic T)),
    (inferInstance : LieAlgebra ℂ (hodgeParabolic T)),
    (inferInstance : FiniteDimensional ℂ (hodgeParabolic T)) with }

def hodgePair : Pair 𝓘(ℝ,D.KModel) (CompactIdentity (K := D.K)) (hodgeParabolic T) := sorry

def hodgeInclusion : Pair.Hom (hodgePair T) (balancedPair (D := D)) := sorry

theorem hodgeInclusion_lie (X : hodgeParabolic T) : (hodgeInclusion T).lie X=X.val := sorry

/-- Balanced coefficients descend from the actual Lie representation. -/
def descend {V : Type} [AddCommGroup V] [Module ℂ V] (M : GKModule D.pair V)
    (hbal : ∀ X : splitCentreLie (A := A), M.rho X.val=0) :
    GKModule (balancedPair (D := D)) V := sorry

theorem descend_quotient {V : Type} [AddCommGroup V] [Module ℂ V] (M : GKModule D.pair V)
    (hbal : ∀ X : splitCentreLie (A := A), M.rho X.val=0) (X : complexAlgebraicLie A) :
    (descend M hbal).rho (balancedProjection (A := A) X)=M.rho X := sorry

/-- The full Hodge Lie algebra includes the central directions before balancing. -/
def fullHodgeParabolic : LieSubalgebra ℂ (complexAlgebraicLie A) :=
  (hodgeParabolic T).comap (balancedProjection (A := A))

instance : NormedComplexLieAlgebra (fullHodgeParabolic T) :=
  { (inferInstance : NormedAddCommGroup (fullHodgeParabolic T)),
    (inferInstance : LieRing (fullHodgeParabolic T)),
    (inferInstance : NormedSpace ℂ (fullHodgeParabolic T)),
    (inferInstance : LieAlgebra ℂ (fullHodgeParabolic T)),
    (inferInstance : FiniteDimensional ℂ (fullHodgeParabolic T)) with }

def fullHodgePair : Pair 𝓘(ℝ,D.KModel) (CompactIdentity (K := D.K)) (fullHodgeParabolic T) := sorry

def fullHodgeInclusion : Pair.Hom (fullHodgePair T) D.pair.identityComponent := sorry

theorem fullHodgeInclusion_lie (X : fullHodgeParabolic T) :
    (fullHodgeInclusion T).lie X=X.val := sorry

theorem fullHodgeInclusion_group (k : CompactIdentity (K := D.K)) :
    (fullHodgeInclusion T).group k=k := sorry

/-- The unique derived-Lie lift avoids imposing triviality on the central preimage. -/
def minusLift : T.pMinus →ₗ[ℂ] fullHodgeParabolic T := sorry

theorem minusLift_quotient (X : T.pMinus) :
    balancedProjection (A := A) (minusLift T X).val=X.val := sorry

theorem minusLift_derived (X : T.pMinus) : (minusLift T X).val∈
    Submodule.span ℂ {Z | ∃ U V : complexAlgebraicLie A, Z=⁅U,V⁆} := sorry

/-- The compact algebraic coefficient is extended trivially across the derived p⁻. -/
structure HodgeCoefficient where
  dimension : ℕ
  action : GKModule (fullHodgePair T) (Fin dimension → ℂ)
  minus_trivial : ∀ X : T.pMinus, action.rho (minusLift T X)=0

/-- Only the tensor product, rather than each factor, must have trivial split centre. -/
def TensorBalanced {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : GKModule D.pair.identityComponent V) (σ : HodgeCoefficient T) : Prop :=
  ∀ (X : splitCentreLie (A := A)) (hX : X.val∈fullHodgeParabolic T),
    (GKModule.tensorFinite (fullHodgePair T)
      (GKModule.restrict (fullHodgeInclusion T) M) σ.action).rho ⟨X.val,hX⟩=0

def balancedTensor {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : GKModule D.pair.identityComponent V) (σ : HodgeCoefficient T) (hbal : TensorBalanced T M σ) :
    GKModule (hodgePair T) (V ⊗[ℂ] (Fin σ.dimension → ℂ)) := sorry

theorem balancedTensor_lie {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : GKModule D.pair.identityComponent V) (σ : HodgeCoefficient T) (hbal : TensorBalanced T M σ)
    (X : fullHodgeParabolic T) (v : V) (w : Fin σ.dimension → ℂ) :
    (balancedTensor T M σ hbal).rho ⟨balancedProjection (A := A) X.val,X.property⟩ (v ⊗ₜ[ℂ] w)=
      (M.rho X.val v) ⊗ₜ[ℂ] w + v ⊗ₜ[ℂ] (σ.action.rho X w) := sorry

theorem balancedTensor_group {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : GKModule D.pair.identityComponent V) (σ : HodgeCoefficient T) (hbal : TensorBalanced T M σ)
    (k : CompactIdentity (K := D.K)) (v : V) (w : Fin σ.dimension → ℂ) :
    (balancedTensor T M σ hbal).sigma k (v ⊗ₜ[ℂ] w)=
      (M.sigma k v) ⊗ₜ[ℂ] (σ.action.sigma k w) := sorry

def minusCompactAction : Representation ℂ (CompactIdentity (K := D.K)) T.pMinus := sorry

theorem minusCompactAction_val (k : CompactIdentity (K := D.K)) (X : T.pMinus) :
    (minusCompactAction T k X).val=(balancedPair (D := D)).Ad k X.val := sorry
end Hermitian

/-- Coherent cohomology is the relative complex of the balanced tensor Hodge module. -/
abbrev coherentCohomology (T : HermitianDatum D) {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : GKModule D.pair.identityComponent V) (σ : Hermitian.HodgeCoefficient T)
    (hbal : Hermitian.TensorBalanced T M σ) (q : ℕ) :=
  cohomology (Hermitian.balancedTensor T M σ hbal) q

/-- The p⁻ alternating model retains the actual connected compact invariance. -/
def coherentAlternatingCochains (T : HermitianDatum D) {V : Type}
    [AddCommGroup V] [Module ℂ V] (M : GKModule D.pair.identityComponent V)
    (σ : Hermitian.HodgeCoefficient T) (hbal : Hermitian.TensorBalanced T M σ) (q : ℕ) :
    Submodule ℂ (AlternatingMap ℂ T.pMinus (V ⊗[ℂ] (Fin σ.dimension → ℂ)) (Fin q)) where
  carrier := {f | ∀ k : CompactIdentity (K := D.K), ∀ X : Fin q → T.pMinus,
    f (fun i => Hermitian.minusCompactAction T k (X i))=
      (Hermitian.balancedTensor T M σ hbal).sigma k (f X)}
  zero_mem' := by sorry
  add_mem' := by sorry
  smul_mem' := by sorry

def coherentCohomology_eq (T : HermitianDatum D) {V : Type}
    [AddCommGroup V] [Module ℂ V] (M : GKModule D.pair.identityComponent V)
    (σ : Hermitian.HodgeCoefficient T) (hbal : Hermitian.TensorBalanced T M σ) (q : ℕ) :
    cochains (Hermitian.balancedTensor T M σ hbal) q ≃ₗ[ℂ]
      coherentAlternatingCochains D T M σ hbal q := sorry

end HermitianGeometry
end TauCeti.Automorphic

namespace TauCeti.Automorphic.GL2
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
open scoped MatrixGroups _root_.ModularForm
variable (N : ℕ) [NeZero N] (k : ℤ) (χ : (ZMod N)ˣ →* ℂˣ)

/-- Transport uses the actual archimedean Weil-restriction identification. -/
def arithmeticForms : Forms ≃ₗ[ℂ] datumQ.forms := sorry

theorem arithmeticForms_val (f : Forms) (g : Arithmetic.AdelicPoints ℚ QCoordinate) :
    (arithmeticForms f).val.val (Arithmetic.adelicSplit ℚ QCoordinate g)=
      f.val.val (archIdentification (Arithmetic.adelicSplit ℚ QCoordinate g).1,
        (Arithmetic.adelicSplit ℚ QCoordinate g).2) := sorry

def cuspSpace : Submodule ℂ Forms := datumQ.cuspForms.comap arithmeticForms.toLinearMap

/-- Mathlib's cusp carrier imposes decay at every cusp of Γ₁(N). -/
def classicalCuspSpace : Submodule ℂ (Classical N k χ) where
  carrier := {f | ∃ c : _root_.CuspForm ((CongruenceSubgroup.Gamma1 N).map
    (Matrix.SpecialLinearGroup.mapGL ℝ)) k, (c : ModularForm _ k)=f.val}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

theorem adelize_cuspidal_iff (f : Classical N k χ) :
    adelize N k χ f∈cuspSpace ↔ f∈classicalCuspSpace N k χ := sorry

theorem adelize_bounded_iff_cuspidal (hk : 0<k) (f : Classical N k χ) :
    (∃ C : ℝ, ∀ g : Adeles, ‖(adelize N k χ f).val.val g‖≤C) ↔
      f∈classicalCuspSpace N k χ := sorry

/-- This is the existing native cusp form, transported to the character-one space. -/
def Delta : Classical 1 12 1 := sorry

theorem Delta_val : (Delta.val : UpperHalfPlane → ℂ)=ModularForm.discriminant := sorry

-- test: adelize_Delta_level, cuspForm_delta
example : adelize 1 12 1 Delta∈cuspSpace ∧
    (∀ g (u : K0 1), (adelize 1 12 1 Delta).val.val (g*(1,u.val))=
      (adelize 1 12 1 Delta).val.val g) ∧
    ∀ y : ℝ, 0<y → ∀ g : realPoints (GLCoordinate 2),
      (realPoints.GL 2 g).val=!![y,0;0,1] →
      (adelize 1 12 1 Delta).val.val (g,1)=
        (y^6 : ℂ)*ModularForm.discriminant (UpperHalfPlane.ofComplex (y*Complex.I)) := sorry

/-- The arithmetic standard upper-triangular parabolic is specified by its native
rational cocharacter rather than supplied as a formal unipotent subgroup. -/
def standardBorel : Arithmetic.RationalParabolic (F := ℚ) (H := QCoordinate) := sorry

/-- Transfer of the classical constant Fourier coefficient uses normalized Haar mass one. -/
theorem constantTerm_cusp_compat (f : Classical N k χ) :
    standardBorel.constantTerm_automorphicMap datumQ (arithmeticForms (adelize N k χ f))=0 ↔
      f∈classicalCuspSpace N k χ := sorry

-- test: constantTerm_cusp_compat
example (f : Classical N k χ) :
    standardBorel.constantTerm_automorphicMap datumQ (arithmeticForms (adelize N k χ f))=0 ↔
      f∈classicalCuspSpace N k χ := sorry

def primeResidue (p : ℕ) (hlevel : Nat.Coprime p N) : (ZMod N)ˣ := sorry

theorem primeResidue_val (p : ℕ) (hlevel : Nat.Coprime p N) :
    (primeResidue N p hlevel : ZMod N)=p := sorry

/-- The classical T_p has q-series normalization, expressed by its actual slashes. -/
def classicalTp (p : ℕ) (hp : p.Prime) (hlevel : Nat.Coprime p N) :
    Classical N k χ →ₗ[ℂ] Classical N k χ := sorry

theorem classicalTp_val (p : ℕ) (hp : p.Prime) (hlevel : Nat.Coprime p N)
    (f : Classical N k χ) (z : UpperHalfPlane) :
    (classicalTp N k χ p hp hlevel f).val z=
      (χ (primeResidue N p hlevel) : ℂ)*(p : ℂ)^(k-1)*
        f.val (UpperHalfPlane.ofComplex ((p : ℂ)*(z : ℂ)))+
      (p : ℂ)⁻¹*∑ b : Fin p, f.val
        (UpperHalfPlane.ofComplex (((z : ℂ)+(b.val : ℂ))/(p : ℂ))) := sorry

/-- At p only, with identity at every other place. -/
def primeMatrix (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (g : Matrix.GeneralLinearGroup (Fin 2) ℚ) : FiniteGroup := sorry

theorem primeMatrix_val (v w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (g : Matrix.GeneralLinearGroup (Fin 2) ℚ) (i j : Fin 2) :
    letI := Classical.decEq (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (TauCeti.GeneralLinear.pointsMulEquiv 2 (primeMatrix v g)).val i j w=
      if w=v then algebraMap ℚ (w.adicCompletion ℚ) (g.val i j) else (1 : Matrix (Fin 2) (Fin 2) (w.adicCompletion ℚ)) i j := sorry

/-- The finite coset and its Haar volume are part of the normalization. -/
def primeCompact (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ)) :
    Subgroup FiniteGroup := sorry

theorem primeCompact_val (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (g : FiniteGroup) : g∈primeCompact v ↔
    (∀ i j, (TauCeti.GeneralLinear.pointsMulEquiv 2 g).val i j v∈v.adicCompletionIntegers ℚ) ∧
    (∀ i j, (TauCeti.GeneralLinear.pointsMulEquiv 2 g⁻¹).val i j v∈v.adicCompletionIntegers ℚ) ∧
    ∀ w, w≠v → ∀ i j,
      (TauCeti.GeneralLinear.pointsMulEquiv 2 g).val i j w=
        (1 : Matrix (Fin 2) (Fin 2) (w.adicCompletion ℚ)) i j := sorry

/-- The pointwise integral is over the local subgroup supported at v, not a
measure-zero subset of the full finite adelic group. -/
abbrev primeLocalGroup (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ)) :=
  Matrix.GeneralLinearGroup (Fin 2) (v.adicCompletion ℚ)
instance (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ)) :
    MeasurableSpace (primeLocalGroup v) := borel _
instance (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ)) :
    BorelSpace (primeLocalGroup v) := ⟨rfl⟩

def localEmbedding (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ)) :
    primeLocalGroup v →* FiniteGroup := sorry

theorem localEmbedding_val (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (g : primeLocalGroup v) (w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (i j : Fin 2) :
    letI := Classical.decEq (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (TauCeti.GeneralLinear.pointsMulEquiv 2 (localEmbedding v g)).val i j w=
      if h : w=v then (by subst w; exact g.val i j)
      else (1 : Matrix (Fin 2) (Fin 2) (w.adicCompletion ℚ)) i j := sorry

-- The equality branch is transported by equality of places, with no spurious algebra map.
def localCompact (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ)) :
    Subgroup (primeLocalGroup v) := (primeCompact v).comap (localEmbedding v)

def primeDiagonal (p : ℕ) (hp : p.Prime)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ)) : primeLocalGroup v := sorry

theorem primeDiagonal_val (p : ℕ) (hp : p.Prime)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ)) :
    (primeDiagonal p hp v).val=!![(p : v.adicCompletion ℚ),0;0,1] := sorry

def Rp (p : ℕ) (hp : p.Prime)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (dg : Measure (primeLocalGroup v)) [dg.IsHaarMeasure] : Forms →ₗ[ℂ] Forms := sorry

theorem Rp_integral (p : ℕ) (hp : p.Prime)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (dg : Measure (primeLocalGroup v)) [dg.IsHaarMeasure] (f : Forms) (g : Adeles) :
    (Rp p hp v dg f).val.val g=
      ∫ x in DoubleCoset.doubleCoset (primeDiagonal p hp v)
        (localCompact v : Set (primeLocalGroup v)) (localCompact v : Set (primeLocalGroup v)),
      f.val.val (g*(1,localEmbedding v x)) ∂dg := sorry

theorem hecke_adelize (p : ℕ) (hp : p.Prime) (hlevel : Nat.Coprime p N)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (hv : Ideal.absNorm v.asIdeal=p)
    (dg : Measure (primeLocalGroup v)) [dg.IsHaarMeasure]
    (hvol : dg (localCompact v : Set (primeLocalGroup v))=1) (f : Classical N k χ) :
    adelize N k χ (classicalTp N k χ p hp hlevel f)=
      (Real.rpow p ((k : ℝ)/2-1) : ℂ) • Rp p hp v dg (adelize N k χ f) := sorry

/-- The diamond character is the inverse of the right-translation character. -/
theorem diamond_right_inverse (f : Classical N k χ) (u : K0 N) (g : Adeles) :
    (adelize N k χ f).val.val (g*(1,u.val⁻¹))=
      (levelCharacter N χ u : ℂ)*(adelize N k χ f).val.val g := sorry

end TauCeti.Automorphic.GL2

namespace TauCeti.Automorphic
section PlaceIndexedTestFunctions
open scoped RestrictedProduct
variable {ι : Type} [Countable ι] [DecidableEq ι] (Gv : ι → Type) [∀ i, Group (Gv i)]
  [∀ i, TopologicalSpace (Gv i)] [∀ i, IsTopologicalGroup (Gv i)]
  [∀ i, LocallyCompactSpace (Gv i)] [∀ i, TotallyDisconnectedSpace (Gv i)]
  [∀ i, T2Space (Gv i)] [∀ i, SecondCountableTopology (Gv i)]
  (Kv : ∀ i, Subgroup (Gv i)) (hopen : ∀ i, IsOpen (Kv i : Set (Gv i)))
  (hcompact : ∀ i, IsCompact (Kv i : Set (Gv i)))

abbrev FiniteRestrictedGroup := RestrictedProduct Gv (fun i => (Kv i : Set (Gv i))) Filter.cofinite
instance : LocallyCompactSpace (FiniteRestrictedGroup Gv Kv) := sorry
instance : TotallyDisconnectedSpace (FiniteRestrictedGroup Gv Kv) := sorry
instance : SecondCountableTopology (FiniteRestrictedGroup Gv Kv) := sorry

def localUnit (hopen : ∀ i, IsOpen (Kv i : Set (Gv i)))
    (hcompact : ∀ i, IsCompact (Kv i : Set (Gv i))) (i : ι) : FiniteTestFunction (Gf := Gv i) :=
  ⟨(Kv i : Set (Gv i)).indicator (fun _ => (1 : ℂ)),by sorry⟩

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {Ginf : Type} [Group Ginf] [TopologicalSpace Ginf] [IsTopologicalGroup Ginf]
  [LocallyCompactSpace Ginf] [T2Space Ginf] [SecondCountableTopology Ginf]
  [ChartedSpace E Ginf] [LieGroup 𝓘(ℝ,E) ∞ Ginf]

/-- Finite linear sums of restricted elementary tensors, with the actual colimit carrier. -/
def TestFunction.restrictedTensor :
    ArchTestFunction (Ginf := Ginf) 𝓘(ℝ,E) ⊗[ℂ]
      RestrictedTensor (fun i => FiniteTestFunction (Gf := Gv i))
        (localUnit Gv Kv hopen hcompact) ≃ₗ[ℂ]
      TestFunction (Ginf := Ginf) (Gf := FiniteRestrictedGroup Gv Kv) 𝓘(ℝ,E) := sorry

def TestFunction.ofLocal (S : Finset ι) (f : ArchTestFunction (Ginf := Ginf) 𝓘(ℝ,E))
    (fs : ∀ i : S, FiniteTestFunction (Gf := Gv i)) :
    TestFunction (Ginf := Ginf) (Gf := FiniteRestrictedGroup Gv Kv) 𝓘(ℝ,E) :=
  TestFunction.restrictedTensor Gv Kv hopen hcompact
    (f ⊗ₜ[ℂ] RestrictedTensor.of (fun i => FiniteTestFunction (Gf := Gv i))
      (localUnit Gv Kv hopen hcompact) S (PiTensorProduct.tprod ℂ fs))

theorem TestFunction.ofLocal_apply (S : Finset ι)
    (f : ArchTestFunction (Ginf := Ginf) 𝓘(ℝ,E))
    (fs : ∀ i : S, FiniteTestFunction (Gf := Gv i))
    (g : Ginf × FiniteRestrictedGroup Gv Kv) :
    TestFunction.ofLocal Gv Kv hopen hcompact S f fs g=
      f g.1*(∏ i : S, fs i (g.2 i.val))*
        ((fun _ => (1 : ℂ)) |> Set.indicator {h : FiniteRestrictedGroup Gv Kv | ∀ i, i∉S → h i∈Kv i}) g.2 := sorry

-- test: testFunction_local_compat
example (S : Finset ι) (f : ArchTestFunction (Ginf := Ginf) 𝓘(ℝ,E))
    (fs : ∀ i : S, FiniteTestFunction (Gf := Gv i))
    (g : Ginf × FiniteRestrictedGroup Gv Kv) (hg : ∀ i, i∉S → g.2 i∈Kv i) :
    TestFunction.ofLocal Gv Kv hopen hcompact S f fs g=
      f g.1*∏ i : S, fs i (g.2 i.val) := sorry
end PlaceIndexedTestFunctions
end TauCeti.Automorphic

namespace TauCeti.Automorphic.SL2
open scoped MatrixGroups
variable (F : Type) [CommRing F]

def upperUnipotent (b : F) : Matrix.SpecialLinearGroup (Fin 2) F := ⟨!![1,b;0,1],by sorry⟩
def lowerUnipotent (b : F) : Matrix.SpecialLinearGroup (Fin 2) F := ⟨!![1,0;b,1],by sorry⟩

def upperBorel : Subgroup (Matrix.SpecialLinearGroup (Fin 2) F) where
  carrier := {g | g.val 1 0=0}
  one_mem' := sorry
  mul_mem' := sorry
  inv_mem' := sorry

end TauCeti.Automorphic.SL2

namespace TauCeti.Automorphic.SL2
variable (F : Type) [Field F]

/-- Exact algebraic generation; no topological closure is needed for part (i). -/
theorem closure_unipotent_eq_top (w : Matrix.SpecialLinearGroup (Fin 2) F)
    (hw : w∉upperBorel F) :
    Subgroup.closure (Set.range (upperUnipotent F) ∪ {w})=⊤ := sorry

/-- The local assertion uses the actual two fractional ideals. -/
theorem local_unipotent_generation (O : Subring F) [IsDiscreteValuationRing O]
    [IsFractionRing O F] (π : O) (hπ : Irreducible π) (c : ℤ) :
    Subgroup.closure
      ((upperUnipotent F) '' ((fun a : F => (π.val : F)^(-c-1)*a) '' (O : Set F)) ∪
        (lowerUnipotent F) '' ((fun a : F => (π.val : F)^c*a) '' (O : Set F)))=⊤ := sorry
end TauCeti.Automorphic.SL2

namespace TauCeti.Automorphic
section GlobalCoefficientLattices
open NumberField
variable (E : Type) [Field E] [NumberField E]
  {H : Type} [CommRing H] [HopfAlgebra ℚ H] [Algebra.FiniteType ℚ H]
  (V : Type) [AddCommGroup V] [Module E V] [FiniteDimensional E V]
  [Comodule E (E ⊗[ℚ] H) V]

local instance coefficientPrime (p : Nat.Primes) : Fact p.val.Prime := ⟨p.property⟩
local instance coefficientIntegralScalars : Module (NumberField.RingOfIntegers E) V :=
  Module.compHom V (algebraMap (NumberField.RingOfIntegers E) E)

abbrev CoefficientLocalScalar (p : Nat.Primes) := E ⊗[ℚ] ℚ_[p.val]
abbrev CoefficientLocalIntegers (p : Nat.Primes) := NumberField.RingOfIntegers E ⊗[ℤ] ℤ_[p.val]
abbrev CoefficientLocalVector (p : Nat.Primes) := CoefficientLocalScalar E p ⊗[E] V

/-- The local integral action is the canonical scalar extension, with its value formula. -/
def coefficientIntegralMap (p : Nat.Primes) :
    CoefficientLocalIntegers E p →+* CoefficientLocalScalar E p := sorry

theorem coefficientIntegralMap_tmul (p : Nat.Primes)
    (a : NumberField.RingOfIntegers E) (b : ℤ_[p.val]) :
    coefficientIntegralMap E p (a ⊗ₜ[ℤ] b)=(a : E) ⊗ₜ[ℚ] (b : ℚ_[p.val]) := sorry

instance coefficientLocalRightAlgebra (p : Nat.Primes) :
    Algebra ℚ_[p.val] (CoefficientLocalScalar E p) := sorry
instance coefficientLocalVectorSpace (p : Nat.Primes) :
    Module ℚ_[p.val] (CoefficientLocalVector E V p) := sorry
instance coefficientLocalIntegralModule (p : Nat.Primes) :
    Module (CoefficientLocalIntegers E p) (CoefficientLocalVector E V p) := sorry

/-- The comodule action evaluated after extending a ℚ_p-point to E⊗ℚℚ_p. -/
def coefficientLocalPoint (p : Nat.Primes) (g : WithConv (H →ₐ[ℚ] ℚ_[p.val])) :
    (E ⊗[ℚ] H) →ₐ[E] CoefficientLocalScalar E p := sorry

theorem coefficientLocalPoint_tmul (p : Nat.Primes) (g : WithConv (H →ₐ[ℚ] ℚ_[p.val]))
    (a : E) (h : H) : coefficientLocalPoint E p g (a ⊗ₜ[ℚ] h)=a ⊗ₜ[ℚ] g.ofConv h := sorry

def coefficientLocalAction (p : Nat.Primes) :
    Representation (CoefficientLocalScalar E p) (WithConv (H →ₐ[ℚ] ℚ_[p.val]))
      (CoefficientLocalVector E V p) := sorry

theorem coefficientLocalAction_point (p : Nat.Primes)
    (g : WithConv (H →ₐ[ℚ] ℚ_[p.val])) (v : CoefficientLocalVector E V p) :
    coefficientLocalAction E V p g v=
      Comodule.endOfPoint V (coefficientLocalPoint E p g) v := sorry

/-- The finite-place component includes the canonical ℚ_p/completion identification. -/
def rationalPrimeComponent (p : Nat.Primes) :
    Arithmetic.FinitePoints ℚ H →* WithConv (H →ₐ[ℚ] ℚ_[p.val]) := sorry

/-- An integral reference lattice is an actual finitely generated full-span O_E-module. -/
structure CoefficientReferenceLattice (E : Type) [Field E] [NumberField E]
    (V : Type) [AddCommGroup V] [Module E V]
    [Module (NumberField.RingOfIntegers E) V] where
  lattice : Submodule (NumberField.RingOfIntegers E) V
  finite : lattice.FG
  full : Submodule.span E (lattice : Set V)=⊤

/-- Scalar extension of the reference lattice, not a choice of another local lattice. -/
def CoefficientReferenceLattice.atPrime (L : CoefficientReferenceLattice E V) (p : Nat.Primes) :
    Submodule (CoefficientLocalIntegers E p) (CoefficientLocalVector E V p) :=
  Submodule.span (CoefficientLocalIntegers E p)
    {w | ∃ v∈L.lattice, w=(1 : CoefficientLocalScalar E p) ⊗ₜ[E] v}

/-- The global carrier is the coherent family at all rational primes. It allows
nonprincipal rank-one O_E-lattices through its reference module. -/
structure StableLattice (J : Subgroup (Arithmetic.FinitePoints ℚ H)) where
  latticeAt : ∀ p : Nat.Primes,
    Submodule (CoefficientLocalIntegers E p) (CoefficientLocalVector E V p)
  finite : ∀ p, (latticeAt p).FG
  full : ∀ p, Submodule.span ℚ_[p.val] (latticeAt p : Set (CoefficientLocalVector E V p))=⊤
  stable : ∀ p (g : J) v, v∈latticeAt p →
    coefficientLocalAction E V p (rationalPrimeComponent p g.val) v∈latticeAt p
  reference : CoefficientReferenceLattice E V
  almost_all : ∀ᶠ p : Nat.Primes in Filter.cofinite, latticeAt p=CoefficientReferenceLattice.atPrime E V reference p

namespace StableLattice
variable {E V}

theorem «exists» (J : Subgroup (Arithmetic.FinitePoints ℚ H))
    (ho : IsOpen (J : Set (Arithmetic.FinitePoints ℚ H)))
    (hc : IsCompact (J : Set (Arithmetic.FinitePoints ℚ H))) :
    Nonempty (StableLattice E V J) := sorry

/-- Both inclusions are stated at every prime; inverting N makes them equal. -/
theorem eq_localization {J : Subgroup (Arithmetic.FinitePoints ℚ H)}
    (L L' : StableLattice E V J) :
    ∃ N : ℕ, 0<N ∧ ∀ p : Nat.Primes,
      (∀ v∈L.latticeAt p, (N : CoefficientLocalIntegers E p) • v∈L'.latticeAt p) ∧
      (∀ v∈L'.latticeAt p, (N : CoefficientLocalIntegers E p) • v∈L.latticeAt p) := sorry

def restrict {J J' : Subgroup (Arithmetic.FinitePoints ℚ H)} (h : J'≤J)
    (L : StableLattice E V J) : StableLattice E V J' := sorry

def map {J : Subgroup (Arithmetic.FinitePoints ℚ H)} (g : Arithmetic.FinitePoints ℚ H)
    (L : StableLattice E V J) :
    StableLattice E V (J.map (MulAut.conj g).toMonoidHom) := sorry

theorem map_local {J : Subgroup (Arithmetic.FinitePoints ℚ H)}
    (g : Arithmetic.FinitePoints ℚ H) (L : StableLattice E V J) (p : Nat.Primes) :
    ((map g L).latticeAt p : Set (CoefficientLocalVector E V p))=
      coefficientLocalAction E V p (rationalPrimeComponent p g) ''
        (L.latticeAt p : Set (CoefficientLocalVector E V p)) := sorry

def reduction {J : Subgroup (Arithmetic.FinitePoints ℚ H)} (L : StableLattice E V J)
    (p : Nat.Primes) (I : Ideal (CoefficientLocalIntegers E p)) : Type := by
  let N : Submodule (CoefficientLocalIntegers E p) (L.latticeAt p) := I • ⊤
  let r : Setoid (L.latticeAt p) := {
    r := fun x y => x-y∈N
    iseqv := by sorry }
  exact Quotient r

instance reduction.addCommGroup {J : Subgroup (Arithmetic.FinitePoints ℚ H)}
    (L : StableLattice E V J) (p : Nat.Primes) (I : Ideal (CoefficientLocalIntegers E p)) :
    AddCommGroup (reduction L p I) := sorry
instance reduction.module {J : Subgroup (Arithmetic.FinitePoints ℚ H)}
    (L : StableLattice E V J) (p : Nat.Primes) (I : Ideal (CoefficientLocalIntegers E p)) :
    Module (CoefficientLocalIntegers E p ⧸ I) (reduction L p I) := sorry

def reductionAction {J : Subgroup (Arithmetic.FinitePoints ℚ H)} (L : StableLattice E V J)
    (p : Nat.Primes) (I : Ideal (CoefficientLocalIntegers E p)) :
    Representation (CoefficientLocalIntegers E p ⧸ I) J (reduction L p I) := sorry
end StableLattice
end GlobalCoefficientLattices

/-- Sym² and divided powers are compared in the same coordinate basis x²,xy,y². -/
def sym2Integral (p : ℕ) [Fact p.Prime] : Submodule ℤ_[p] (Fin 3 → ℚ_[p]) :=
  Submodule.span ℤ_[p] (Set.range (fun i : Fin 3 => Pi.single i (1 : ℚ_[p])))

def dividedPower2Integral (p : ℕ) [Fact p.Prime] : Submodule ℤ_[p] (Fin 3 → ℚ_[p]) :=
  Submodule.span ℤ_[p] {Pi.single 0 1,Pi.single 1 (2 : ℚ_[p]),Pi.single 2 1}

-- test: lattice_sym2, lattice_not_unique
example : dividedPower2Integral 2≠sym2Integral 2 ∧
    (∀ v∈sym2Integral 2, (2 : ℤ_[2]) • v∈dividedPower2Integral 2) ∧
    ∀ c : ℚ_[2]ˣ, (dividedPower2Integral 2 : Set (Fin 3 → ℚ_[2]))≠
      (fun v : Fin 3 → ℚ_[2] => (c : ℚ_[2]) • v) '' (sym2Integral 2 : Set (Fin 3 → ℚ_[2])) := sorry
end TauCeti.Automorphic
namespace TauCeti.RealReductive
open TauCeti.RelativeLieCohomology
section NativeDiscreteSeries
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A)

/-- The real Cartan is recovered from the real form of the supplied complex Cartan. -/
def ReductiveCartan.realLie (C : ReductiveCartan (complexAlgebraicLie A)) :
    Submodule ℝ (algebraicRealLie A) where
  carrier := {X | 1 ⊗ₜ[ℝ] X∈C.h}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

def realSplitCentre : Submodule ℝ (algebraicRealLie A) :=
  Submodule.span ℝ {X | ∃ l∈TauCeti.Automorphic.centralRealCocharacter (A := A),
    X=TauCeti.Automorphic.cocharacterTangent l}

/-- Compactness modulo the positive split centre is expressed on the actual Cartan Lie algebra. -/
structure CompactCartan where
  roots : ReductiveCartan (complexAlgebraicLie A)
  realForm : roots.h.toSubmodule=Submodule.span ℂ
    {X | ∃ Y∈roots.realLie, X=1 ⊗ₜ[ℝ] Y}
  compactModuloCentre : roots.realLie≤D.compactLie⊔realSplitCentre

variable {D}

def CompactCartan.torus (T : CompactCartan D) : Subgroup (realPoints A) :=
  Subgroup.closure {g | ∃ X∈T.roots.realLie, g=realPoints.exp A X}

def CompactCartan.compactRoots (T : CompactCartan D) : Set T.roots.rootIndex :=
  {i | ∀ X : complexAlgebraicLie A,
    (∀ Y : T.roots.h, ⁅Y.val,X⁆=T.roots.R.root i Y • X) →
      X∈Submodule.span ℂ {Z | ∃ Y∈D.compactLie, Z=1 ⊗ₜ[ℝ] Y}}

def CompactCartan.rhoCompact (T : CompactCartan D) : Module.Dual ℂ T.roots.h := by
  classical
  exact (1/2 : ℂ) • ∑ i : T.roots.rootIndex,
    if T.roots.b.IsPos i ∧ i∈T.compactRoots then T.roots.R.root i else 0

def CompactCartan.rhoNoncompact (T : CompactCartan D) : Module.Dual ℂ T.roots.h :=
  T.roots.rho-T.rhoCompact

/-- Group integrality is tested by a genuine character on the compact torus.
The positive central character is retained separately, including for disconnected G. -/
structure DiscreteSeriesParameter (T : CompactCartan D) where
  lambda : Module.Dual ℂ T.roots.h
  integralCharacter : ↥((T.torus : Subgroup (realPoints A))⊓D.K) →* ℂˣ
  integralContinuous : Continuous integralCharacter
  integralUnitary : ∀ t, ‖(integralCharacter t : ℂ)‖=1
  integralDerivative : ∀ (X : T.roots.realLie) (hX : X.val∈D.compactLie),
    deriv (fun t : ℝ => (integralCharacter
      ⟨realPoints.exp A (t • X.val),by sorry⟩ : ℂ)) 0=
      (lambda-T.roots.rho) ⟨1 ⊗ₜ[ℝ] X.val, X.property⟩
  centralCharacter : Subgroup.center (realPoints A) →* ℂˣ
  centralContinuous : Continuous centralCharacter
  centralUnitary : ∀ z, ‖(centralCharacter z : ℂ)‖=1
  centralOverlap : ∀ t : ↥((T.torus : Subgroup (realPoints A))⊓D.K), ∀ (ht : t.val∈Subgroup.center (realPoints A)),
    integralCharacter t=centralCharacter ⟨t.val,ht⟩
  centralDerivative : ∀ X : T.roots.realLie,
    X.val∈realSplitCentre →
      lambda ⟨1 ⊗ₜ[ℝ] X.val,X.property⟩=
        deriv (fun t : ℝ => (centralCharacter ⟨realPoints.exp A (t • X.val),by sorry⟩ : ℂ)) 0
  dominant : ∀ i : T.roots.rootIndex, T.roots.b.IsPos i →
    0≤(lambda (T.roots.R.coroot i)).re

/-- Regularity and the nondegenerate compact-wall condition are actual root evaluations. -/
def DiscreteSeriesParameter.Regular {T : CompactCartan D} (p : DiscreteSeriesParameter T) : Prop :=
  ∀ i : T.roots.rootIndex, p.lambda (T.roots.R.coroot i)≠0

def DiscreteSeriesParameter.NonDegenerate {T : CompactCartan D}
    (p : DiscreteSeriesParameter T) : Prop :=
  ∀ i∈T.roots.b.support, i∈T.compactRoots → p.lambda (T.roots.R.coroot i)≠0

/-- Integrated discrete series and limits as actual admissible isomorphism classes. -/
def IsConnectedModuloCentre : Prop :=
  Subgroup.center (realPoints A)⊔Subgroup.connectedComponentOfOne (realPoints A)=⊤

def discreteSeries (hconn : IsConnectedModuloCentre (A := A)) (T : CompactCartan D) (p : DiscreteSeriesParameter T)
    (hp : p.NonDegenerate) : IrrAdmissible.{0} D.pair := sorry

theorem discreteSeries_infChar (hconn : IsConnectedModuloCentre (A := A)) (T : CompactCartan D) (p : DiscreteSeriesParameter T)
    (hp : p.NonDegenerate) :
    IrrAdmissible.infChar D.pair (discreteSeries hconn T p hp)=infCharOf T.roots p.lambda := sorry

theorem discreteSeries_squareIntegrable (hconn : IsConnectedModuloCentre (A := A)) (T : CompactCartan D) (p : DiscreteSeriesParameter T)
    (hp : p.NonDegenerate) :
    IsDiscreteSeriesClass D (discreteSeries hconn T p hp) ↔ p.Regular := sorry

theorem discreteSeries_limit_tempered (hconn : IsConnectedModuloCentre (A := A)) (T : CompactCartan D) (p : DiscreteSeriesParameter T)
    (hp : p.NonDegenerate) : IsTemperedClass D (discreteSeries hconn T p hp) := sorry

/-- The orbit relation uses actual conjugation of the Cartan by a compact element. -/
def DiscreteSeriesParameter.KConjugate {T T' : CompactCartan D}
    (p : DiscreteSeriesParameter T) (p' : DiscreteSeriesParameter T') : Prop :=
  ∃ k : D.K, ∃ e : T.roots.h ≃ₗ[ℂ] T'.roots.h,
    (∀ X, (e X).val=D.pair.Ad k X.val) ∧
    (∀ X, p'.lambda (e X)=p.lambda X) ∧
    p.centralCharacter=p'.centralCharacter ∧
    ∀ i, T.roots.b.IsPos i ↔
      ∃ j, T'.roots.b.IsPos j ∧ ∀ X,
        T'.roots.R.root j (e X)=T.roots.R.root i X

theorem discreteSeries_eq_iff (hconn : IsConnectedModuloCentre (A := A)) {T T' : CompactCartan D}
    (p : DiscreteSeriesParameter T) (p' : DiscreteSeriesParameter T')
    (hp : p.NonDegenerate) (hp' : p'.NonDegenerate) :
    discreteSeries hconn T p hp=discreteSeries hconn T' p' hp' ↔ p.KConjugate p' := sorry

theorem discreteSeries_exists_iff :
    (∃ π : IrrAdmissible.{0} D.pair, IsDiscreteSeriesClass D π) ↔
      Nonempty (CompactCartan D) := sorry
end NativeDiscreteSeries
end TauCeti.RealReductive
namespace TauCeti.RealReductive
open TauCeti.RelativeLieCohomology CategoryTheory
section NativeLeviInduction
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A)

/-- Coordinate-algebra realization of the native dynamic Levi, supplied by RG2.
The point map, compact subgroup and Levi projection are pinned to the ambient group. -/
structure LeviDatum (l : A →ₐc[ℝ] LaurentPolynomial ℝ) where
  coordinate : Type
  [ring : CommRing coordinate]
  [hopf : HopfAlgebra ℝ coordinate]
  [finiteType : Algebra.FiniteType ℝ coordinate]
  [smooth : Algebra.Smooth ℝ coordinate]
  inclusion : A →ₐc[ℝ] coordinate
  injective : Function.Injective (realPoints_map inclusion)
  range_le : ∀ g, realPoints_map inclusion g∈realLevi l
  range_eq : Set.range (realPoints_map inclusion)=(realLevi l : Set (realPoints A))
  datum : Datum coordinate
  compact : ∀ k : datum.K, realPoints_map inclusion k.val∈D.K
  compactRange : Set.range (fun k : datum.K => realPoints_map inclusion k.val)=
    ((realLevi l⊓D.K) : Set (realPoints A))
attribute [instance] LeviDatum.ring LeviDatum.hopf LeviDatum.finiteType LeviDatum.smooth

/-- The canonical projection is the limit of conjugation by the defining cocharacter. -/
def realParabolic.leviProjection (l : A →ₐc[ℝ] LaurentPolynomial ℝ) :
    realParabolic l →* realLevi l := sorry

theorem realParabolic.leviProjection_factorization (l : A →ₐc[ℝ] LaurentPolynomial ℝ)
    (p : realParabolic l) :
    ∃ n : realUnipotent l, p.val=(realParabolic.leviProjection l p).val*n.val := sorry

theorem realParabolic.leviProjection_onLevi (l : A →ₐc[ℝ] LaurentPolynomial ℝ)
    (m : realLevi l) : (realParabolic.leviProjection l ⟨m.val,by sorry⟩).val=m.val := sorry

def LeviDatum.parabolicMap {l : A →ₐc[ℝ] LaurentPolynomial ℝ} (L : LeviDatum D l) :
    realParabolic l →* realPoints L.coordinate := sorry

theorem LeviDatum.parabolicMap_factorization {l : A →ₐc[ℝ] LaurentPolynomial ℝ}
    (L : LeviDatum D l) (p : realParabolic l) :
    realPoints_map L.inclusion (L.parabolicMap D p)=
      (realParabolic.leviProjection l p).val := sorry

/-- Normalized induction of the given smooth Fréchet Levi representation. -/
def normalizedInduction.ofLevi {l : A →ₐc[ℝ] LaurentPolynomial ℝ}
    (L : LeviDatum D l) (σ : SAFModuleCat L.datum) (η : InducingCharacter l) : SAFModuleCat D := sorry

def LeviDatum.inducingRepresentation {l : A →ₐc[ℝ] LaurentPolynomial ℝ}
    (L : LeviDatum D l) (σ : SAFModuleCat L.datum) :
    ContRepresentation ℂ (realParabolic l) σ.S := sorry

theorem LeviDatum.inducingRepresentation_apply {l : A →ₐc[ℝ] LaurentPolynomial ℝ}
    (L : LeviDatum D l) (σ : SAFModuleCat L.datum) (p : realParabolic l) (v : σ.S) :
    L.inducingRepresentation D σ p v=σ.representation.π (L.parabolicMap D p) v := sorry

def normalizedInduction.ofLeviCarrier {l : A →ₐc[ℝ] LaurentPolynomial ℝ}
    (L : LeviDatum D l) (σ : SAFModuleCat L.datum) (η : InducingCharacter l) :
    (normalizedInduction.ofLevi D L σ η).S ≃L[ℂ]
      normalizedInduction (E := realPoints.Model A) σ.B σ.S (realParabolic l)
        (L.inducingRepresentation D σ) (parabolicDelta l) η.character := sorry

theorem normalizedInduction.ofLevi_action {l : A →ₐc[ℝ] LaurentPolynomial ℝ}
    (L : LeviDatum D l) (σ : SAFModuleCat L.datum) (η : InducingCharacter l)
    (v : (normalizedInduction.ofLevi D L σ η).S) (g x : realPoints A) :
    (normalizedInduction.ofLeviCarrier D L σ η
      ((normalizedInduction.ofLevi D L σ η).representation.π g v)).val x=
        (normalizedInduction.ofLeviCarrier D L σ η v).val (x*g) := sorry

/-- Goodness identifies this constructed carrier, with its prescribed right action. -/
def normalizedInduction.globalization {l : A →ₐc[ℝ] LaurentPolynomial ℝ}
    (L : LeviDatum D l) (σ : SAFModuleCat L.datum) (η : InducingCharacter l) :
    normalizedInduction.ofLevi D L σ η ≅
      (globalizationFunctor D).obj ((kFiniteFunctor D).obj
        (normalizedInduction.ofLevi D L σ η)) := sorry

/-- The finite-dimensional minimal carrier has exactly the same covariance. -/
def normalizedInduction.minimal_compat (W : PrincipalCoefficient D) :
    W.functions D ≃L[ℂ] (principalSeries D W).S :=
  (principalSeriesCarrier D W).symm

/-- Parabolic split Lie algebra: the noncompact centre of the actual Levi. -/
def parabolicSplitLie (l : A →ₐc[ℝ] LaurentPolynomial ℝ) :
    Submodule ℝ (algebraicRealLie A) where
  carrier := {X | X∈D.noncompactLie ∧
    (∀ t : ℝ, realPoints.exp A (t • X)∈realLevi l) ∧
    ∀ Y : algebraicRealLie A,
      (∀ t : ℝ, realPoints.exp A (t • Y)∈realLevi l) → ⁅X,Y⁆=0}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

/-- Positive relative roots are the actual adjoint weights on Lie N_P. -/
def parabolicRoots (l : A →ₐc[ℝ] LaurentPolynomial ℝ) :
    Set (Module.Dual ℝ (parabolicSplitLie D l)) :=
  {α | α≠0 ∧ ∃ X : unipotentRealLie l, X.val≠0 ∧
    ∀ Y : parabolicSplitLie D l, ⁅Y.val,X.val⁆=α Y • X.val}

/-- The trace form determines the coroot on the semisimple complement of the centre. -/
def parabolicCoroot (l : A →ₐc[ℝ] LaurentPolynomial ℝ)
    (α : Module.Dual ℝ (parabolicSplitLie D l)) : parabolicSplitLie D l := sorry

theorem parabolicCoroot_characterization (l : A →ₐc[ℝ] LaurentPolynomial ℝ)
    (α : Module.Dual ℝ (parabolicSplitLie D l)) (hα : α∈parabolicRoots D l) :
    α (parabolicCoroot D l α)=2 ∧
    ∃ c : ℝ, 0<c ∧ ∀ Y : parabolicSplitLie D l,
      LinearMap.trace ℝ (algebraicRealLie A)
        ((LieAlgebra.ad ℝ (algebraicRealLie A) (parabolicCoroot D l α).val).comp
          (LieAlgebra.ad ℝ (algebraicRealLie A) Y.val))=c*α Y := sorry

structure LanglandsData (minimal : A →ₐc[ℝ] LaurentPolynomial ℝ) where
  cocharacter : A →ₐc[ℝ] LaurentPolynomial ℝ
  standard : realParabolic minimal≤realParabolic cocharacter
  levi : LeviDatum D cocharacter
  sigma : IrrAdmissibleModel.{0} levi.datum.pair
  tempered : IsTemperedClass levi.datum (Quotient.mk _ sigma)
  exponent : InducingCharacter cocharacter
  positiveCharacter : ∀ p, 0<(exponent.character p : ℂ).re ∧ (exponent.character p : ℂ).im=0
  compactTrivial : ∀ p : realParabolic cocharacter, p.val∈D.K → exponent.character p=1
  unipotentTrivial : ∀ p : realParabolic cocharacter,
    p.val∈realUnipotent cocharacter → exponent.character p=1
  positiveChamber : ∀ α∈parabolicRoots D cocharacter,
    0<(deriv (fun t : ℝ => (exponent.character
      ⟨realPoints.exp A (t • (parabolicCoroot D cocharacter α).val),by sorry⟩ : ℂ)) 0).re

variable {D}

def LanglandsData.standardModule {minimal : A →ₐc[ℝ] LaurentPolynomial ℝ}
    (d : LanglandsData D minimal) : SAFModuleCat D :=
  normalizedInduction.ofLevi D d.levi
    ((globalizationFunctor d.levi.datum).obj
      ⟨⟨d.sigma.carrier,d.sigma.action.toGKModule⟩,d.sigma.action.admissible,d.sigma.action.finitelyGenerated⟩)
    d.exponent

/-- Uniqueness is equality of the actual irreducible quotient isomorphism classes. -/
def LanglandsData.IsQuotient {minimal : A →ₐc[ℝ] LaurentPolynomial ℝ}
    (d : LanglandsData D minimal) (π : IrrAdmissible.{0} D.pair) : Prop :=
  ∃ M : IrrAdmissibleModel.{0} D.pair, Quotient.mk _ M=π ∧
    ∃ T : GKModule.Hom ((kFiniteFunctor.{0} D).obj d.standardModule).obj.action M.action.toGKModule,
      Function.Surjective T.toLinearMap

theorem langlandsClassification (minimal : A →ₐc[ℝ] LaurentPolynomial ℝ)
    (hmin : IsMinimalParabolic minimal) :
    (∀ d : LanglandsData D minimal, ∃! π : IrrAdmissible.{0} D.pair, d.IsQuotient π) ∧
    (∀ π : IrrAdmissible.{0} D.pair, ∃ d : LanglandsData D minimal, d.IsQuotient π) := sorry
end NativeLeviInduction
end TauCeti.RealReductive
namespace TauCeti.Automorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
section ClassicalComponents
variable {F : Type} [Field F] [NumberField F] {H : Type} [CommRing H]
  [HopfAlgebra F H] [Algebra.FiniteType F H] [Algebra.Smooth F H]
  (D : Arithmetic.Datum F H)
local notation "A" => Arithmetic.ArchCoordinate F H
local notation "R" => realPoints A
local notation "Gf" => Arithmetic.FinitePoints F H
local notation "G" => R × Gf
local notation "Γ" => Arithmetic.rationalSubgroup F H
local notation "I" => 𝓘(ℝ,realPoints.Model A)

def classicalArithmeticSubgroup (D : Arithmetic.Datum F H) (J : Subgroup Gf) (t : Gf) : Subgroup R :=
  (Γ⊓Subgroup.prod (⊤ : Subgroup R) (J.map (MulAut.conj t).toMonoidHom)).map
    (MonoidHom.fst R Gf)

def classicalDiagonal (D : Arithmetic.Datum F H) (J : Subgroup Gf) (t : Gf) : Subgroup (R × PUnit) :=
  (classicalArithmeticSubgroup D J t).map ((MonoidHom.id R).prod (1 : R →* PUnit))

/-- The classical carrier retains slow growth, K-finiteness and central finiteness.
It is the ordinary infinite-place function space, with no finite factor. -/
abbrev ClassicalAutomorphicForm (J : Subgroup Gf) (t : Gf) :=
  AutomorphicForm I D.realDatum.K.subtype
    (fun x : R × PUnit => D.embedding.height F H (x.1,t)) (classicalDiagonal D J t)

def AutomorphicForm.level (J : Subgroup Gf) : Submodule ℂ D.forms where
  carrier := {f | ∀ x (j : J), f.val.val (x*(1,j.val))=f.val.val x}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

/-- Representatives are a disjoint finite double-coset decomposition, not a cover alone. -/
structure ClassicalComponentData (D : Arithmetic.Datum F H) (J : Subgroup Gf) where
  size : ℕ
  representative : Fin size → Gf
  cover : ∀ g : G, ∃ i : Fin size, ∃ γ : Γ, ∃ x : R, ∃ j : J,
    g=γ.val*(x,representative i*j.val)
  disjoint : ∀ i j : Fin size, ∀ γ : Γ, ∀ x : R, ∀ u : J,
    (1,representative i)=γ.val*(x,representative j*u.val) → i=j

/-- Evaluation on the actual finite component gives the classical/adelic dictionary. -/
def AutomorphicForm.classicalEquiv (J : Subgroup Gf)
    (ho : IsOpen (J : Set Gf)) (hc : IsCompact (J : Set Gf)) (T : ClassicalComponentData D J) :
    AutomorphicForm.level D J ≃ₗ[ℂ]
      (∀ i : Fin T.size, ClassicalAutomorphicForm D J (T.representative i)) := sorry

theorem AutomorphicForm.classicalEquiv_apply (J : Subgroup Gf)
    (ho : IsOpen (J : Set Gf)) (hc : IsCompact (J : Set Gf)) (T : ClassicalComponentData D J)
    (f : AutomorphicForm.level D J) (i : Fin T.size) (x : R) :
    (AutomorphicForm.classicalEquiv D J ho hc T f i).val.val (x,PUnit.unit)=
      f.val.val.val (x,T.representative i) := sorry

theorem AutomorphicForm.classicalEquiv_compact (J : Subgroup Gf)
    (ho : IsOpen (J : Set Gf)) (hc : IsCompact (J : Set Gf)) (T : ClassicalComponentData D J)
    (f : AutomorphicForm.level D J) (k : D.realDatum.K) (i : Fin T.size) (x : R) :
    (AutomorphicForm.classicalEquiv D J ho hc T
      ⟨D.functionAction.action.sigma k f.val,by sorry⟩ i).val.val (x,PUnit.unit)=
      (AutomorphicForm.classicalEquiv D J ho hc T f i).val.val (x*k.val,PUnit.unit) := sorry

-- test: automorphicForm_classical_compat
example (J : Subgroup Gf) (ho : IsOpen (J : Set Gf)) (hc : IsCompact (J : Set Gf))
    (T : ClassicalComponentData D J) (f : AutomorphicForm.level D J) (i : Fin T.size) (x : R) :
    (AutomorphicForm.classicalEquiv D J ho hc T f i).val.val (x,PUnit.unit)=f.val.val.val (x,T.representative i) := sorry
end ClassicalComponents
end TauCeti.Automorphic
namespace TauCeti.Automorphic.SL2
open TauCeti.RealReductive TauCeti.RelativeLieCohomology NumberField
open scoped MatrixGroups
section HolomorphicForms
variable (F : Type) [Field F] [NumberField F] [NumberField.IsTotallyReal F]

abbrev Coordinate := TauCeti.SpecialLinear.coordinateHopfAlgebra F 2
abbrev ArchCoordinate := Arithmetic.ArchCoordinate F (Coordinate F)
abbrev RealGroup := realPoints (ArchCoordinate F)
abbrev FiniteGroup := Arithmetic.FinitePoints F (Coordinate F)
abbrev Group := RealGroup F × FiniteGroup F

def datum : Arithmetic.Datum F (Coordinate F) := sorry

/-- This is the actual product of SL₂(ℝ) at all real embeddings. -/
def archMatrices : RealGroup F ≃* (∀ v : InfinitePlace F, Matrix.SpecialLinearGroup (Fin 2) ℝ) := sorry

def realEmbedding (v : InfinitePlace F) : F →+* ℝ :=
  InfinitePlace.embedding_of_isReal (w := v) (NumberField.IsTotallyReal.isReal v)

/-- The local supplier uses the pointwise bracket on the tuple of native sl₂ algebras. -/
instance localLieRing : LieRing (InfinitePlace F → LieAlgebra.SpecialLinear.sl (Fin 2) ℂ) where
  bracket X Y := fun v => ⁅X v,Y v⁆
  add_lie := by sorry
  lie_add := by sorry
  lie_self := by sorry
  leibniz_lie := by sorry

instance localLieAlgebra : LieAlgebra ℂ (InfinitePlace F → LieAlgebra.SpecialLinear.sl (Fin 2) ℂ) where
  lie_smul := by sorry

theorem localBracket_apply (X Y : InfinitePlace F → LieAlgebra.SpecialLinear.sl (Fin 2) ℂ)
    (v : InfinitePlace F) : ⁅X,Y⁆ v=⁅X v,Y v⁆ := rfl

/-- The differential identifies the Weil-restricted algebraic Lie algebra with local sl₂'s. -/
def complexLieMatrices : complexAlgebraicLie (ArchCoordinate F) ≃ₗ⁅ℂ⁆
    (∀ v : InfinitePlace F, LieAlgebra.SpecialLinear.sl (Fin 2) ℂ) := sorry

def rotationElement (theta : InfinitePlace F → ℝ) : RealGroup F :=
  (archMatrices F).symm (fun v => ⟨!![Real.cos (theta v),Real.sin (theta v);
    -Real.sin (theta v),Real.cos (theta v)],by sorry⟩)

def lowering (v : InfinitePlace F) : complexAlgebraicLie (ArchCoordinate F) := by
  classical
  exact (complexLieMatrices F).symm
    (fun w => if w=v then ⟨(1/2 : ℂ) • !![Complex.I,1;1,-Complex.I],by sorry⟩ else 0)

/-- The carrier is a subspace of the genuine arithmetic automorphic functions. -/
def HolomorphicForm (J : Subgroup (FiniteGroup F)) (k : ℤ) : Submodule ℂ (datum F).forms where
  carrier := {f | (∀ g (j : J), f.val.val (g*(1,j.val))=f.val.val g) ∧
    (∀ g theta, f.val.val (g*(rotationElement F theta,1))=
      Complex.exp (Complex.I*(k : ℂ)*(∑ v : InfinitePlace F, (theta v : ℂ)))*f.val.val g) ∧
    ∀ v : InfinitePlace F, (datum F).functionAction.action.rho (lowering F v) f=0}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

theorem HolomorphicForm.finiteDimensional (J : Subgroup (FiniteGroup F)) (k : ℤ)
    (ho : IsOpen (J : Set (FiniteGroup F))) (hc : IsCompact (J : Set (FiniteGroup F))) :
    FiniteDimensional ℂ (HolomorphicForm F J k) := sorry

def upperHalfPlaneSection (z : InfinitePlace F → UpperHalfPlane) : RealGroup F :=
  (archMatrices F).symm (fun v =>
    ⟨!![Real.sqrt (z v).im,(z v).re/Real.sqrt (z v).im;0,(Real.sqrt (z v).im)⁻¹],by sorry⟩)

/-- The product of y_v^{-k/2} supplies the classical normalization. -/
def HolomorphicForm.flat {J : Subgroup (FiniteGroup F)} {k : ℤ}
    (f : HolomorphicForm F J k) (h : FiniteGroup F) :
    (InfinitePlace F → UpperHalfPlane) → ℂ :=
  fun z => (∏ v : InfinitePlace F, (Real.rpow (z v).im (-(k : ℝ)/2) : ℂ))*
    f.val.val.val (upperHalfPlaneSection F z,h)

/-- The Fourier quotient is the actual additive arithmetic quotient F\A_F. -/
abbrev AdditiveAdeles := NumberField.AdeleRing (RingOfIntegers F) F

def additiveDiagonal : F →+ AdditiveAdeles F := (algebraMap F (AdditiveAdeles F)).toAddMonoidHom
abbrev AdditiveQuotient := AdditiveAdeles F ⧸ (additiveDiagonal F).range
instance additiveQuotientMeasurable : MeasurableSpace (AdditiveQuotient F) := borel _
instance additiveQuotientBorel : BorelSpace (AdditiveQuotient F) := ⟨rfl⟩

def additiveProbability : Measure (AdditiveQuotient F) := sorry
instance additiveProbability_haar : (additiveProbability F).IsAddHaarMeasure := sorry
instance additiveProbability_probability : IsProbabilityMeasure (additiveProbability F) := sorry

def additiveSection : AdditiveQuotient F → AdditiveAdeles F := sorry

theorem additiveSection_rightInverse (b : AdditiveQuotient F) :
    QuotientAddGroup.mk (additiveSection F b)=b := sorry

/-- AA supplies the standard character exp(2πi·tr∞) and its finite local factors. -/
def standardAdditiveCharacter : AddChar (AdditiveAdeles F) ℂ := sorry

theorem standardAdditiveCharacter_rational (b : F) :
    standardAdditiveCharacter F (additiveDiagonal F b)=1 := sorry

def upperUnipotentAdelic (b : AdditiveAdeles F) : Group F := sorry

theorem upperUnipotentAdelic_points (b : AdditiveAdeles F) :
    TauCeti.SpecialLinear.pointsMulEquiv (R := F) (A := AdditiveAdeles F) 2
      ((Arithmetic.adelicSplit F (Coordinate F)).symm (upperUnipotentAdelic F b))=
        upperUnipotent (AdditiveAdeles F) b := sorry

/-- The index is the trace-dual fractional ideal determined by the finite unipotent level. -/
def qIdeal (J : Subgroup (FiniteGroup F)) : FractionalIdeal (nonZeroDivisors (RingOfIntegers F)) F := sorry

def qIndex (J : Subgroup (FiniteGroup F)) :=
  {xi : F | xi∈qIdeal F J ∧ ∀ v : InfinitePlace F, 0≤realEmbedding F v xi}

def HolomorphicForm.qExpansion {J : Subgroup (FiniteGroup F)} {k : ℤ}
    (f : HolomorphicForm F J k) : qIndex F J → ℂ :=
  fun xi => Complex.exp ((2*Real.pi*(∑ v : InfinitePlace F, realEmbedding F v xi.val) : ℝ) : ℂ)*
    ∫ b : AdditiveQuotient F,
      f.val.val.val (upperUnipotentAdelic F (additiveSection F b))*
        standardAdditiveCharacter F (-((algebraMap F (AdditiveAdeles F) xi.val)*additiveSection F b))
      ∂additiveProbability F

theorem HolomorphicForm.qExpansion_injective (J : Subgroup (FiniteGroup F)) (k : ℤ) :
    Function.Injective (HolomorphicForm.qExpansion F (J := J) (k := k)) := sorry

/-- A specified subfield model records algebraic Fourier coefficients. -/
def HolomorphicForm.rationalStructure (J : Subgroup (FiniteGroup F)) (k : ℤ) (E : Subfield ℂ) :
    Submodule E (HolomorphicForm F J k) where
  carrier := {f | ∀ xi, HolomorphicForm.qExpansion F f xi∈E}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

theorem HolomorphicForm.numberFieldModel (J : Subgroup (FiniteGroup F)) (k : ℤ)
    (ho : IsOpen (J : Set (FiniteGroup F))) (hc : IsCompact (J : Set (FiniteGroup F))) :
    ∃ E : Subfield ℂ, NumberField E ∧
      Submodule.span ℂ (HolomorphicForm.rationalStructure F J k E : Set (HolomorphicForm F J k))=⊤ := sorry

/-- Arbitrary W-valued forms are finite E-linear combinations of the same q-expansions. -/
abbrev HolomorphicForm.coefficient (J : Subgroup (FiniteGroup F)) (k : ℤ) (E : Subfield ℂ)
    (W : Type) [AddCommGroup W] [Module E W] :=
  HolomorphicForm.rationalStructure F J k E ⊗[E] W

def HolomorphicForm.coefficientExpansion (J : Subgroup (FiniteGroup F)) (k : ℤ) (E : Subfield ℂ)
    (W : Type) [AddCommGroup W] [Module E W] :
    HolomorphicForm.coefficient F J k E W →ₗ[E] (qIndex F J → W) := sorry

theorem HolomorphicForm.coefficientExpansion_tmul (J : Subgroup (FiniteGroup F)) (k : ℤ)
    (E : Subfield ℂ) (W : Type) [AddCommGroup W] [Module E W]
    (f : HolomorphicForm.rationalStructure F J k E) (w : W) (xi : qIndex F J) :
    HolomorphicForm.coefficientExpansion F J k E W (f ⊗ₜ[E] w) xi=
      (⟨HolomorphicForm.qExpansion F f.val xi,f.property xi⟩ : E) • w := sorry

-- test: sl2Hol_negative
example (J : Subgroup (FiniteGroup F)) (k : ℤ) (hk : k<0) :
    Subsingleton (HolomorphicForm F J k) := sorry
end HolomorphicForms
end TauCeti.Automorphic.SL2

namespace TauCeti.Automorphic.SL2
open TauCeti.RealReductive NumberField
section FourierVanishing
variable (F : Type) [Field F] [NumberField F] [NumberField.IsTotallyReal F]
local notation "Places" => IsDedekindDomain.HeightOneSpectrum (RingOfIntegers F)

/-- Projection is entrywise evaluation of the native finite adelic matrix. -/
def localMatrix (v : Places) : FiniteGroup F →* Matrix.SpecialLinearGroup (Fin 2) (v.adicCompletion F) := sorry

theorem localMatrix_entry (v : Places) (g : FiniteGroup F) (i j : Fin 2) :
    (localMatrix F v g).val i j=(TauCeti.SpecialLinear.pointsMulEquiv (R := F) (A := IsDedekindDomain.FiniteAdeleRing (NumberField.RingOfIntegers F) F) 2 g).val i j v := sorry

/-- Zhang Lemma 13.6 uses conjugated integral SL₂, with its specified conductor. -/
def conjugatedIntegral (v : Places) (pi : v.adicCompletion F) (c : ℤ) (hpi : pi≠0) :
    Subgroup (Matrix.SpecialLinearGroup (Fin 2) (v.adicCompletion F)) where
  carrier := {g | ∀ i j : Fin 2,
    ((!![pi^c,0;0,1] : Matrix (Fin 2) (Fin 2) (v.adicCompletion F))*g.val*
      !![pi^(-c),0;0,1]) i j∈v.adicCompletionIntegers F}
  one_mem' := by sorry
  mul_mem' := by sorry
  inv_mem' := by sorry

def finiteAdditiveEmbedding (v : Places) (x : v.adicCompletion F) : AdditiveAdeles F := sorry

theorem finiteAdditiveEmbedding_infinite (v : Places) (x : v.adicCompletion F) :
    (finiteAdditiveEmbedding F v x).1=0 := sorry

theorem finiteAdditiveEmbedding_finite (v w : Places) (x : v.adicCompletion F) :
    letI := Classical.decEq Places
    (finiteAdditiveEmbedding F v x).2 w=if h : w=v then (by subst w; exact x) else 0 := sorry

structure FourierLevel (B : Finset Places) where
  localCompact : ∀ v : Places, Subgroup (Matrix.SpecialLinearGroup (Fin 2) (v.adicCompletion F))
  open_local : ∀ v : Places, IsOpen (localCompact v : Set (Matrix.SpecialLinearGroup (Fin 2) (v.adicCompletion F)))
  compact_local : ∀ v : Places, IsCompact (localCompact v : Set (Matrix.SpecialLinearGroup (Fin 2) (v.adicCompletion F)))
  uniformizer : ∀ v : B, v.val.adicCompletionIntegers F
  uniformizer_irreducible : ∀ v : B, Irreducible (uniformizer v)
  conductor : B → ℤ
  conductor_trivial : ∀ v : B, ∀ x : v.val.adicCompletion F,
    x∈v.val.adicCompletionIntegers F →
    standardAdditiveCharacter F (finiteAdditiveEmbedding F v.val
      ((uniformizer v : v.val.adicCompletion F)^(conductor v)*x))=1
  conductor_exact : ∀ v : B, ∃ x : v.val.adicCompletion F,
    x∈v.val.adicCompletionIntegers F ∧
    standardAdditiveCharacter F (finiteAdditiveEmbedding F v.val
      ((uniformizer v : v.val.adicCompletion F)^(conductor v-1)*x))≠1
  specified_level : ∀ v : B, localCompact v.val=
    conjugatedIntegral F v.val (uniformizer v) (conductor v) (by sorry)
  integral_almost_everywhere : ∀ᶠ v : Places in Filter.cofinite,
    (localCompact v : Set (Matrix.SpecialLinearGroup (Fin 2) (v.adicCompletion F)))=
      {g | ∀ i j, g.val i j∈v.adicCompletionIntegers F}

/-- The global level is the product condition, not an arbitrary subgroup with local images. -/
def FourierLevel.level {B : Finset Places} (L : FourierLevel F B) : Subgroup (FiniteGroup F) where
  carrier := {g | ∀ v, localMatrix F v g∈L.localCompact v}
  one_mem' := by sorry
  mul_mem' := by sorry
  inv_mem' := by sorry

def fourierCoeff (phi : Group F → ℂ) (xi : F) (h : Group F) : ℂ :=
  ∫ b : AdditiveQuotient F,
    phi (upperUnipotentAdelic F (additiveSection F b)*h)*
      standardAdditiveCharacter F (-((algebraMap F (AdditiveAdeles F) xi)*additiveSection F b))
    ∂additiveProbability F

theorem eq_const_of_fourierCoeff_eq_zero (B : Finset Places) (L : FourierLevel F B)
    (phi : Group F → ℂ) (hcont : Continuous phi)
    (hleft : ∀ gamma : Arithmetic.rationalSubgroup F (Coordinate F), ∀ g,
      phi (gamma.val*g)=phi g)
    (hlevel : ∀ g (u : L.level F), phi (g*(1,u.val))=phi g)
    (hfourier : ∀ xi : F, xi≠0 →
      (∀ v∈B, ∃ u : (v.adicCompletionIntegers F)ˣ,
        (u : v.adicCompletion F)=algebraMap F (v.adicCompletion F) xi) →
      ∀ h : RealGroup F, fourierCoeff F phi xi (h,1)=0) :
    ∃ c : ℂ, ∀ g : Group F, phi g=c := sorry

theorem eq_zero_of_fourierCoeff_weight (B : Finset Places) (L : FourierLevel F B)
    (k : ℤ) (hk : k≠0) (f : HolomorphicForm F (L.level F) k)
    (hfourier : ∀ xi : F, xi≠0 →
      (∀ v∈B, ∃ u : (v.adicCompletionIntegers F)ˣ,
        (u : v.adicCompletion F)=algebraMap F (v.adicCompletion F) xi) →
      ∀ h : RealGroup F, fourierCoeff F f.val.val.val xi (h,1)=0) : f=0 := sorry
end FourierVanishing
end TauCeti.Automorphic.SL2

