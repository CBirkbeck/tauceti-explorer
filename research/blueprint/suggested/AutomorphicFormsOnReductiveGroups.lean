open TauCeti.RelativeLieCohomology
section RealGlobalization
attribute [local instance] LieGroup.minSmoothnessThree
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A]
  [Algebra.FiniteType ℝ A] [Algebra.Smooth ℝ A] (D : Datum A)

/-- Scalar extension of the native algebraic-tangent identification. -/
def Datum.complexLieTangent (D : Datum A) : complexAlgebraicLie A ≃ₗ⁅ℂ⁆
    TauCeti.ComplexGroupLie 𝓘(ℝ,realPoints.Model A) (realPoints A) := sorry

theorem Datum.complexLieTangent_tmul (z : ℂ) (X : algebraicRealLie A) :
    D.complexLieTangent (z ⊗ₜ[ℝ] X)=z ⊗ₜ[ℝ] (realPoints_lieAlgebra A).symm X := sorry

theorem Datum.K_inclusion_smooth :
    ContMDiff 𝓘(ℝ,D.KModel) 𝓘(ℝ,realPoints.Model A) ∞ D.K.subtype := sorry

/-- A faithful algebraic closed immersion; its regular coordinate map is surjective. -/
structure RealFaithfulEmbedding where
  n : ℕ
  coordinates : (GLCoordinate n) →ₐc[ℝ] A
  closedImmersion : Function.Surjective coordinates

def Datum.faithfulEmbedding (D : Datum A) : RealFaithfulEmbedding (A := A) := sorry

open scoped Matrix.Norms.Operator
/-- A fixed proper algebraic matrix height, comparable to any other faithful height. -/
def Datum.height (g : realPoints A) : ℝ :=
  max 1 (max
    ‖(realPoints.GL D.faithfulEmbedding.n (realPoints_map D.faithfulEmbedding.coordinates g)).val‖
    ‖(realPoints.GL D.faithfulEmbedding.n (realPoints_map D.faithfulEmbedding.coordinates g⁻¹)).val‖)

theorem Datum.height_one (g : realPoints A) : 1≤D.height g := sorry

theorem Datum.height_mul (g h : realPoints A) : D.height (g*h)≤D.height g*D.height h := sorry

theorem Datum.height_continuous : Continuous D.height := sorry

variable {V : Type} [AddCommGroup V] [Module ℂ V]
  (M : HCModule (P := D.pair) (V := V))

theorem exists_gContinuousNorm :
    Nonempty (GContinuousNorm M D.K.subtype D.complexLieTangent) := sorry

def globalizationNorm : GContinuousNorm M D.K.subtype D.complexLieTangent :=
  Classical.choice (exists_gContinuousNorm D M)

/-- The derivative acts on smooth vectors in the actual Banach completion. -/
def GContinuousNorm.smoothLieAction
    (p : GContinuousNorm M D.K.subtype D.complexLieTangent) :
    complexAlgebraicLie A →ₗ⁅ℂ⁆ Module.End ℂ p.smoothCompletion := sorry

theorem GContinuousNorm.smoothLieAction_real
    (p : GContinuousNorm M D.K.subtype D.complexLieTangent)
    (X : algebraicRealLie A) (v : p.smoothCompletion) :
    (p.smoothLieAction D M (1 ⊗ₜ[ℝ] X) v).val =
      mfderiv 𝓘(ℝ,realPoints.Model A) 𝓘(ℝ,p.B)
        (fun g => p.representation g v.val) 1 ((realPoints_lieAlgebra A).symm X) := sorry

def GContinuousNorm.smoothSeminorm
    (p : GContinuousNorm M D.K.subtype D.complexLieTangent)
    (xs : List (Fin (Module.finrank ℂ (complexAlgebraicLie A)))) :
    Seminorm ℂ p.smoothCompletion := sorry

theorem GContinuousNorm.smoothSeminorm_apply
    (p : GContinuousNorm M D.K.subtype D.complexLieTangent)
    (xs : List (Fin (Module.finrank ℂ (complexAlgebraicLie A)))) (v : p.smoothCompletion) :
    p.smoothSeminorm D M xs v =
      ‖(((xs.map (fun i => p.smoothLieAction D M
        ((Module.finBasis ℂ (complexAlgebraicLie A)) i))).prod v).val)‖ := sorry

instance GContinuousNorm.smoothTopology
    (p : GContinuousNorm M D.K.subtype D.complexLieTangent) :
    TopologicalSpace p.smoothCompletion :=
  (SeminormFamily.moduleFilterBasis (fun xs => p.smoothSeminorm D M xs)).topology

/-- Every continuous map to a Banach space has an absolutely summable rank-one
expansion with an equicontinuous family of functionals. -/
def IsNuclearSpace (W : Type) [AddCommGroup W] [Module ℂ W] [TopologicalSpace W] : Prop :=
  ∀ (F : Type) [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F]
    (T : W →L[ℂ] F), ∃ (c : ℕ → ℂ) (ell : ℕ → W →L[ℂ] ℂ) (y : ℕ → F)
      (q : Seminorm ℂ W), Continuous q ∧ Summable (fun n => ‖c n‖) ∧
      (∀ n, ‖y n‖≤1 ∧ ∀ w, ‖ell n w‖≤q w) ∧
      ∀ w, T w=∑' n, (c n*ell n w) • y n

theorem smoothCompletion_nuclear
    (p : GContinuousNorm M D.K.subtype D.complexLieTangent) :
    IsNuclearSpace p.smoothCompletion := sorry

/-- The smooth topology is independent of the norm, by the two Sobolev estimates. -/
theorem gContinuousNorms_sobolev
    (p r : GContinuousNorm M D.K.subtype D.complexLieTangent) :
    SobolevLE M (Module.finBasis ℂ (complexAlgebraicLie A)) p.norm r.norm ∧
    SobolevLE M (Module.finBasis ℂ (complexAlgebraicLie A)) r.norm p.norm := sorry
end RealGlobalization

/-- A presentation records a homeomorphism of the given Fréchet carrier, rather
than replacing its topology by an arbitrary product topology. -/
structure FrechetPresentation (W : Type) [AddCommGroup W] [Module ℂ W] [TopologicalSpace W] where
  B : ℕ → Type
  [banachGroup : ∀ n, NormedAddCommGroup (B n)]
  [banachSpace : ∀ n, NormedSpace ℂ (B n)]
  [complete : ∀ n, CompleteSpace (B n)]
  S : Submodule ℂ (∀ n, B n)
  closed : IsClosed (S : Set (∀ n, B n))
  coordinates : W ≃L[ℂ] S
attribute [instance] FrechetPresentation.banachGroup FrechetPresentation.banachSpace
  FrechetPresentation.complete

section SAFCategory
open CategoryTheory
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A]
  [Algebra.FiniteType ℝ A] [Algebra.Smooth ℝ A] (D : Datum A)

/-- Bundled SAF objects over the actual reductive real-point group. -/
structure SAFModuleCat where
  B : ℕ → Type
  [banachGroup : ∀ n, NormedAddCommGroup (B n)]
  [banachSpace : ∀ n, NormedSpace ℂ (B n)]
  [complete : ∀ n, CompleteSpace (B n)]
  S : Submodule ℂ (∀ n, B n)
  representation : SFRep 𝓘(ℝ,realPoints.Model A) (realPoints A) B S D.height
  admissible : IsAdmissible (SFRep.toGK representation D.pair D.K.subtype
    D.K_inclusion_smooth D.complexLieTangent (by sorry) (by sorry))
  finitelyGenerated : IsFinitelyGenerated (SFRep.toGK representation D.pair D.K.subtype
    D.K_inclusion_smooth D.complexLieTangent (by sorry) (by sorry))
attribute [instance] SAFModuleCat.banachGroup SAFModuleCat.banachSpace SAFModuleCat.complete

structure SAFModuleCat.Hom (X Y : SAFModuleCat D) extends X.S →L[ℂ] Y.S where
  equivariant : ∀ g v, toContinuousLinearMap (X.representation.π g v) =
    Y.representation.π g (toContinuousLinearMap v)

instance : CategoryTheory.Category (SAFModuleCat D) where
  Hom := SAFModuleCat.Hom D
  id X := {
    toContinuousLinearMap := ContinuousLinearMap.id ℂ X.S
    equivariant := by sorry }
  comp f g := {
    toContinuousLinearMap := g.toContinuousLinearMap.comp f.toContinuousLinearMap
    equivariant := by sorry }
  id_comp := by sorry
  comp_id := by sorry
  assoc := by sorry

/-- The functor is specifically the native K-finite subspace with differentiated action. -/
def kFiniteFunctor : SAFModuleCat D ⥤ HCModuleCat D.pair := sorry

def kFiniteFunctorCarrier (X : SAFModuleCat D) :
    ((kFiniteFunctor D).obj X).obj.carrier ≃ₗ[ℂ]
      SFRep.kFinite 𝓘(ℝ,realPoints.Model A) (realPoints A) X.B X.S X.representation D.K.subtype := sorry

/-- Sobolev jets give a closed Banach-product presentation of the actual smooth completion. -/
def smoothCompletionPresentation (X : HCModuleCat D.pair) :
    FrechetPresentation (globalizationNorm D
      ⟨X.obj.action, X.property.1, X.property.2⟩).smoothCompletion := sorry

/-- Globalization uses the fixed norm's smooth vectors and their Sobolev topology. -/
def globalizationFunctor : HCModuleCat D.pair ⥤ SAFModuleCat D := sorry

def globalizationCarrier (X : HCModuleCat D.pair) :
    ((globalizationFunctor D).obj X).S ≃L[ℂ]
      (globalizationNorm D ⟨X.obj.action, X.property.1, X.property.2⟩).smoothCompletion := sorry

/-- Casselman–Wallach specifies these two functors; the unit and counit are
extension and restriction of the identity on the original Harish-Chandra carrier. -/
def casselmanWallach : SAFModuleCat D ≌ HCModuleCat D.pair where
  functor := kFiniteFunctor D
  inverse := globalizationFunctor D
  unitIso := by sorry
  counitIso := by sorry
  functor_unitIso_comp := by sorry

theorem casselmanWallach_closed_range {X Y : SAFModuleCat D} (f : X ⟶ Y) :
    IsClosed (Set.range f.toContinuousLinearMap) := sorry
end SAFCategory
