namespace TauCeti.Automorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology MeasureTheory
section GlobalCoherentCohomology
variable {F : Type} [Field F] [NumberField F] {H : Type} [CommRing H]
  [HopfAlgebra F H] [Algebra.FiniteType F H] [Algebra.Smooth F H]
  (D : Arithmetic.Datum F H) (chi : UnitaryCentralCharacter D)
local notation "G" => realPoints (Arithmetic.ArchCoordinate F H) × Arithmetic.FinitePoints F H

/-- AS.4's automorphic square-integrable carrier, with full central covariance.
This is a supplier adapter on automorphic functions, not the whole Hilbert space. -/
def squareIntegrableForms : Submodule ℂ D.forms where
  carrier := {f | (∀ (z : Subgroup.center G) g,
    f.val.val (z.val*g)=(chi.character z : ℂ)*f.val.val g) ∧
    MemLp (fun q => f.val.val (centralQuotientSection D q)) 2 (centralQuotientMeasure D)}
  zero_mem' := by sorry
  add_mem' := by sorry
  smul_mem' := by sorry

def squareIntegrableAction : GlobalHeckeModule (Arithmetic.FinitePoints F H)
    D.realDatum.pair (squareIntegrableForms D chi) := sorry

theorem squareIntegrableAction_lie (X) (f : squareIntegrableForms D chi) :
    ((squareIntegrableAction D chi).rho X f).val=D.functionAction.action.rho X f.val := sorry

theorem squareIntegrableAction_finite (g) (f : squareIntegrableForms D chi) :
    ((squareIntegrableAction D chi).finiteAction g f).val=
      D.functionAction.action.finiteAction g f.val := sorry

def centralCuspAction : GlobalHeckeModule (Arithmetic.FinitePoints F H)
    D.realDatum.pair (centralCuspForms D chi) := sorry

/-- Rapid decay supplies the MemLp proof for this actual inclusion. -/
def cuspToSquareIntegrable : GlobalHeckeModule.Hom (centralCuspAction D chi)
    (squareIntegrableAction D chi) := sorry

theorem cuspToSquareIntegrable_val (f : centralCuspForms D chi) :
    ((cuspToSquareIntegrable D chi).toLinearMap f).val=f.val.val := sorry

abbrev coherentCohomology_L2 (T : HermitianDatum D.realDatum)
    (sigma : Hermitian.HodgeCoefficient T)
    (hbal : Hermitian.TensorBalanced T
      (GKModule.restrict D.realDatum.pair.identityComponentHom
        (squareIntegrableAction D chi).toGKModule) sigma) (q : ℕ) :=
  coherentCohomology D.realDatum T
    (GKModule.restrict D.realDatum.pair.identityComponentHom
      (squareIntegrableAction D chi).toGKModule) sigma hbal q

abbrev coherentCohomology_cusp (T : HermitianDatum D.realDatum)
    (sigma : Hermitian.HodgeCoefficient T)
    (hbal : Hermitian.TensorBalanced T
      (GKModule.restrict D.realDatum.pair.identityComponentHom
        (centralCuspAction D chi).toGKModule) sigma) (q : ℕ) :=
  coherentCohomology D.realDatum T
    (GKModule.restrict D.realDatum.pair.identityComponentHom
      (centralCuspAction D chi).toGKModule) sigma hbal q

/-- The cohomology map is induced by the inclusion; injectivity is not assumed. -/
def coherentCohomology_cusp_to_L2 (T : HermitianDatum D.realDatum)
    (sigma : Hermitian.HodgeCoefficient T)
    (hcusp : Hermitian.TensorBalanced T
      (GKModule.restrict D.realDatum.pair.identityComponentHom
        (centralCuspAction D chi).toGKModule) sigma)
    (hL2 : Hermitian.TensorBalanced T
      (GKModule.restrict D.realDatum.pair.identityComponentHom
        (squareIntegrableAction D chi).toGKModule) sigma) (q : ℕ) :
    coherentCohomology_cusp D chi T sigma hcusp q →ₗ[ℂ]
      coherentCohomology_L2 D chi T sigma hL2 q := sorry

/-- Finite translations commute with the relative differential and induce these
smooth finite actions, from which the finite Hecke operators are integrated. -/
def coherentCohomology_L2_finiteAction (T : HermitianDatum D.realDatum)
    (sigma : Hermitian.HodgeCoefficient T)
    (hbal : Hermitian.TensorBalanced T
      (GKModule.restrict D.realDatum.pair.identityComponentHom
        (squareIntegrableAction D chi).toGKModule) sigma) (q : ℕ) :
    Representation ℂ (Arithmetic.FinitePoints F H) (coherentCohomology_L2 D chi T sigma hbal q) := sorry

def coherentCohomology_cusp_finiteAction (T : HermitianDatum D.realDatum)
    (sigma : Hermitian.HodgeCoefficient T)
    (hbal : Hermitian.TensorBalanced T
      (GKModule.restrict D.realDatum.pair.identityComponentHom
        (centralCuspAction D chi).toGKModule) sigma) (q : ℕ) :
    Representation ℂ (Arithmetic.FinitePoints F H) (coherentCohomology_cusp D chi T sigma hbal q) := sorry

theorem coherentCohomology_cusp_to_L2_finite (T : HermitianDatum D.realDatum)
    (sigma : Hermitian.HodgeCoefficient T) (hcusp hL2) (q : ℕ)
    (g : Arithmetic.FinitePoints F H) (v : coherentCohomology_cusp D chi T sigma hcusp q) :
    coherentCohomology_cusp_to_L2 D chi T sigma hcusp hL2 q
      (coherentCohomology_cusp_finiteAction D chi T sigma hcusp q g v)=
    coherentCohomology_L2_finiteAction D chi T sigma hL2 q g
      (coherentCohomology_cusp_to_L2 D chi T sigma hcusp hL2 q v) := sorry
end GlobalCoherentCohomology
