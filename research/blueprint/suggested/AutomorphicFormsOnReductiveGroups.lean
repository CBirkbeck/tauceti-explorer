theorem restriction_H1 (R : Type) [CommRing R] (p : PrimeAway N)
    (c : cohomology N R 1) (g : CongruenceSubgroup.Gamma0 (N*p.val.val)) :
    (groupCohomology.H1IsoOfIsTrivial (Rep.of (Representation.trivial R
      (CongruenceSubgroup.Gamma0 (N*p.val.val)) R))).hom
        (restriction N R p 1 c) (Additive.ofMul g)=
      H1Coordinates N R c (Additive.ofMul (conjugation N p g)) := sorry

/-- The transfer sums the Schreier elements of the actual inclusion. The
relations specify the coset permutation without a chosen uncharacterized map. -/
theorem transfer_H1 (R : Type) [CommRing R] (p : PrimeAway N)
    (c : groupCohomology (Rep.of (Representation.trivial R
      (CongruenceSubgroup.Gamma0 (N*p.val.val)) R)) 1)
    (reps : Fin (p.val.val+1) → Gamma N)
    (hcosets : Function.Bijective (fun i =>
      (QuotientGroup.mk (s := (inclusion N p).range) (reps i)⁻¹ : Gamma N ⧸ (inclusion N p).range)))
    (g : Gamma N) (perm : Equiv.Perm (Fin (p.val.val+1)))
    (h : Fin (p.val.val+1) → CongruenceSubgroup.Gamma0 (N*p.val.val))
    (hSchreier : ∀ i, reps i*g=(inclusion N p (h i))*reps (perm i)) :
    H1Coordinates N R (transfer N R p 1 c) (Additive.ofMul g)=
      ∑ i, (groupCohomology.H1IsoOfIsTrivial (Rep.of (Representation.trivial R
        (CongruenceSubgroup.Gamma0 (N*p.val.val)) R))).hom c (Additive.ofMul (h i)) := sorry

theorem eichlerShimuraClass_period (f : HeckeRing.GL2.Newform N 2)
    (hchi : f.χ=1) (g : Gamma N) :
    H1Coordinates N ℂ (eichlerShimuraClass N f hchi) (Additive.ofMul g)=
      newformPeriod N f g := sorry

theorem conjugateClass_period (c : cohomology N ℂ 1) (g : Gamma N) :
    H1Coordinates N ℂ (conjugateClass N c) (Additive.ofMul g)=
      star (H1Coordinates N ℂ c (Additive.ofMul g)) := sorry

theorem complexify_period (c : cohomology N ℤ 1) (g : Gamma N) :
    H1Coordinates N ℂ (complexify N c) (Additive.ofMul g)=
      (H1Coordinates N ℤ c (Additive.ofMul g) : ℂ) := sorry

theorem reduce_period (ell : Nat.Primes) (c : cohomology N ℤ 1) (g : Gamma N) :
    H1Coordinates N (ZMod ell.val) (reduce N ell 1 c) (Additive.ofMul g)=
      (H1Coordinates N ℤ c (Additive.ofMul g) : ZMod ell.val) := sorry
end TauCeti.Automorphic.CongruenceBetti

