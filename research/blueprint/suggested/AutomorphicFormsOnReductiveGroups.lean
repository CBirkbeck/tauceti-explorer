variable {N : ℕ} [NeZero N] {k : ℤ}

/-- The actual native newform determines the classical character-space vector. -/
def newformClassical (f : HeckeRing.GL2.Newform N k) : Classical N k f.χ := sorry

theorem newformClassical_val (f : HeckeRing.GL2.Newform N k) :
    (newformClassical f).val=(f.toCuspForm : ModularForm _ k) := sorry

abbrev arithmeticGroup := realPoints (Arithmetic.ArchCoordinate ℚ QCoordinate) × FiniteGroup

def detIdele : arithmeticGroup →* (NumberField.AdeleRing (NumberField.RingOfIntegers ℚ) ℚ)ˣ :=
  Matrix.GeneralLinearGroup.det.comp
    ((TauCeti.GeneralLinear.pointsMulEquiv 2).toMonoidHom.comp
      (Arithmetic.adelicSplit ℚ QCoordinate).symm.toMonoidHom)

/-- The global positive determinant norm includes finite primes. -/
def globalNormTwist (s : ℂ) : Arithmetic.Character datumQ := sorry

theorem globalNormTwist_value (s : ℂ) (g : arithmeticGroup) :
    ((globalNormTwist s).character g : ℂ)=Complex.exp
      (s*(Real.log ((Suppliers.GlobalNumberFields.ideleNorm (detIdele g) : ℝ≥0) : ℝ) : ℂ)) := sorry

/-- The unitary normalization is the irreducible cyclic submodule generated by
this adelization, with an actual injection into the automorphic functions. -/
def newformUnitaryModel (f : HeckeRing.GL2.Newform N k) (hk : 2≤k) :
    datumQ.representationModel := sorry

def newformInjection (f : HeckeRing.GL2.Newform N k) (hk : 2≤k) :
    GlobalHeckeModule.Hom (newformUnitaryModel f hk).action datumQ.functionAction.action := sorry

theorem newformInjection_injective (f : HeckeRing.GL2.Newform N k) (hk : 2≤k) :
    Function.Injective (newformInjection f hk).toLinearMap := sorry

theorem newformInjection_generatingVector (f : HeckeRing.GL2.Newform N k) (hk : 2≤k) :
    ∃ v : (newformUnitaryModel f hk).carrier,
      (newformInjection f hk).toLinearMap v=arithmeticForms (adelize N k f.χ (newformClassical f)) := sorry

def newformCentralCharacter (f : HeckeRing.GL2.Newform N k) : UnitaryCentralCharacter datumQ := sorry

theorem newformCentralCharacter_value (f : HeckeRing.GL2.Newform N k)
    (z : Subgroup.center arithmeticGroup) :
    (newformCentralCharacter f).character z=centralCharacter N k f.χ
      ⟨(archIdentification z.val.1,z.val.2),by sorry⟩ := sorry

def newformCuspidal (f : HeckeRing.GL2.Newform N k) (hk : 2≤k) :
    CuspidalRepresentation datumQ (newformCentralCharacter f) := sorry

theorem newformCuspidal_toAutomorphic (f : HeckeRing.GL2.Newform N k) (hk : 2≤k) :
    (newformCuspidal f hk).toAutomorphic=Quotient.mk _ (newformUnitaryModel f hk) := sorry

/-- The cohomological algebraic convention twists the unitary adelic model by
|det|^((2-k)/2). At infinity it is D_k(2-k), not D_k(0). -/
def newformCohomologicalModel (f : HeckeRing.GL2.Newform N k) (hk : 2≤k) :
    datumQ.representationModel :=
  AutomorphicRepresentation.twist datumQ (newformUnitaryModel f hk)
    (globalNormTwist ((2-(k : ℂ))/2))

def newformFactors (f : HeckeRing.GL2.Newform N k) (hk : 2≤k) :
    ArchFiniteFactorization datumQ (newformCohomologicalModel f hk) := sorry

def arithmeticRealIso : Datum.Iso datumQ.realDatum TauCeti.RealReductive.GL2.D := sorry

theorem arithmeticRealIso_points (g : realPoints (Arithmetic.ArchCoordinate ℚ QCoordinate)) :
    arithmeticRealIso.points g=archIdentification g := sorry

theorem newformFactors_arch (f : HeckeRing.GL2.Newform N k) (hk : 2≤k) :
    (IrrAdmissibleModel.isoSetoid TauCeti.RealReductive.GL2.D.pair).r
      (arithmeticRealIso.push (newformFactors f hk).arch)
      (IrrAdmissibleModel.ofHC TauCeti.RealReductive.GL2.D
        (TauCeti.RealReductive.GL2.discreteSeries k.toNat (by omega) (2-(k : ℂ)))
        (TauCeti.RealReductive.GL2.discreteSeries_irreducible k.toNat (by omega) (2-(k : ℂ)))) := sorry

-- test: rationality_modularForms_compat
example (f : HeckeRing.GL2.Newform N k) (hk : 2≤k) :
    rationalityField (newformFactors f hk).finite.action=
      (Suppliers.ModularForms.CoefficientField f).toSubfield := sorry

/-- The unitary spherical Hecke eigenvalue has the half-weight prime factor.
The algebraic convention removes it, explaining why the two fields can differ. -/
theorem newform_unitary_primeNormalization (f : HeckeRing.GL2.Newform N k) (hk : 2≤k)
    (p : ℕ) (hp : p.Prime) (hlevel : Nat.Coprime p N)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (hv : Ideal.absNorm v.asIdeal=p) (dg : Measure (primeLocalGroup v)) [dg.IsHaarMeasure]
    (hvol : dg (localCompact v : Set (primeLocalGroup v))=1) :
    Rp p hp v dg (adelize N k f.χ (newformClassical f))=
      ((Real.rpow p (1-(k : ℝ)/2) : ℂ)*(_root_.UpperHalfPlane.qExpansion 1 f.toCuspForm).coeff p) •
        adelize N k f.χ (newformClassical f) := sorry
end TauCeti.Automorphic.GL2

