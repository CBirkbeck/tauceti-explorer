namespace TauCeti.RealReductive
section SmoothFrechetTopology
variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {G : Type} [Group G] [TopologicalSpace G] [ChartedSpace E G] [LieGroup 𝓘(ℝ,E) ∞ G]
  (B : ℕ → Type) [∀ n, NormedAddCommGroup (B n)] [∀ n, NormedSpace ℂ (B n)]
  [∀ n, CompleteSpace (B n)] (V : Submodule ℂ (∀ n, B n))

/-- The smooth function carrier, with the actual Banach-coordinate criterion. -/
def SmoothVectorValued : Submodule ℂ (G → V) where
  carrier := {f | ∀ n, ContMDiff 𝓘(ℝ,E) 𝓘(ℝ,B n) ∞ (fun g => (f g).val n)}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

/-- Iterated left-invariant derivatives; the empty word is evaluation. -/
def smoothWordDerivative (n : ℕ) : List (GroupLieAlgebra 𝓘(ℝ,E) G) →
    (G → V) → G → B n
  | [], f, g => (f g).val n
  | X::xs, f, g => mfderiv 𝓘(ℝ,E) 𝓘(ℝ,B n)
      (smoothWordDerivative n xs f) g
      (mfderiv 𝓘(ℝ,E) 𝓘(ℝ,E) (fun y : G => g*y) 1 X)

/-- Compact-set derivative suprema determine the canonical smooth topology. -/
def SmoothVectorValued.seminorm (C : TopologicalSpace.Compacts G) (n : ℕ)
    (xs : List (GroupLieAlgebra 𝓘(ℝ,E) G)) :
    Seminorm ℂ (SmoothVectorValued (E := E) (G := G) B V) := sorry

theorem SmoothVectorValued.seminorm_apply (C : TopologicalSpace.Compacts G) (n : ℕ)
    (xs : List (GroupLieAlgebra 𝓘(ℝ,E) G)) (f : SmoothVectorValued (E := E) (G := G) B V) :
    SmoothVectorValued.seminorm B V C n xs f =
      sSup {r | ∃ g ∈ C, r=‖smoothWordDerivative B V n xs f.val g‖} := sorry

instance SmoothVectorValued.topology : TopologicalSpace (SmoothVectorValued (E := E) (G := G) B V) :=
  (SeminormFamily.moduleFilterBasis
    (fun i : TopologicalSpace.Compacts G × ℕ × List (GroupLieAlgebra 𝓘(ℝ,E) G) =>
      SmoothVectorValued.seminorm B V i.1 i.2.1 i.2.2)).topology

/-- The canonical topology on induced functions is the smooth-function subspace topology. -/
def normalizedInduction.smoothInclusion (P : Subgroup G) (σ : ContRepresentation ℂ P V)
    (delta : PositiveRealCharacter P) (eta : P →* ℂˣ) :
    normalizedInduction (E := E) B V P σ delta eta →ₗ[ℂ]
      SmoothVectorValued (E := E) (G := G) B V := sorry

instance normalizedInduction.topology (P : Subgroup G) (σ : ContRepresentation ℂ P V)
    (delta : PositiveRealCharacter P) (eta : P →* ℂˣ) :
    TopologicalSpace (normalizedInduction (E := E) B V P σ delta eta) :=
  TopologicalSpace.induced (normalizedInduction.smoothInclusion B V P σ delta eta)
    inferInstance

instance normalizedInduction.compactPictureTopology
    {Ek : Type} [NormedAddCommGroup Ek] [NormedSpace ℝ Ek] [FiniteDimensional ℝ Ek]
    {K : Type} [Group K] [TopologicalSpace K] [ChartedSpace Ek K] [LieGroup 𝓘(ℝ,Ek) ∞ K]
    (P : Subgroup G) (σ : ContRepresentation ℂ P V) (delta : PositiveRealCharacter P)
    (eta : P →* ℂˣ) (iota : K →* G) :
    TopologicalSpace (normalizedInduction.compactPicture (Ek := Ek) B V P σ delta eta iota) :=
  TopologicalSpace.induced
    (fun f : normalizedInduction.compactPicture (Ek := Ek) B V P σ delta eta iota =>
      (⟨f.val, f.property.1⟩ : SmoothVectorValued (E := Ek) (G := K) B V)) inferInstance
end SmoothFrechetTopology

section CanonicalCompactPicture
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A]
  [Algebra.FiniteType ℝ A] [Algebra.Smooth ℝ A] (D : Datum A)
  (B : ℕ → Type) [∀ n, NormedAddCommGroup (B n)] [∀ n, NormedSpace ℂ (B n)]
  [∀ n, CompleteSpace (B n)] (V : Submodule ℂ (∀ n, B n))
  (l : A →ₐc[ℝ] LaurentPolynomial ℝ) (σ : ContRepresentation ℂ (realParabolic l) V)
  (eta : InducingCharacter l)
  (hσ : ∀ (v : V) n, ContMDiff 𝓘(ℝ,realParabolicModel l) 𝓘(ℝ,B n) ∞
    (fun p => (σ p v).val n))

/-- Restriction to the actual maximal compact, with the native modular character.
The inverse is smooth equivariant extension along G=P K, independent of factorization. -/
def normalizedInduction.restrictK (hσ : ∀ (v : V) n,
    ContMDiff 𝓘(ℝ,realParabolicModel l) 𝓘(ℝ,B n) ∞ (fun p => (σ p v).val n)) :
    normalizedInduction (E := realPoints.Model A) B V (realParabolic l) σ (parabolicDelta l) eta.character
      ≃L[ℂ] normalizedInduction.compactPicture (Ek := D.KModel) B V
        (realParabolic l) σ (parabolicDelta l) eta.character D.K.subtype := sorry

theorem normalizedInduction.restrictK_apply
    (f : normalizedInduction (E := realPoints.Model A) B V
      (realParabolic l) σ (parabolicDelta l) eta.character) (k : D.K) :
    (normalizedInduction.restrictK D B V l σ eta hσ f).val k=f.val k.val := sorry

/-- The closed inducing equations inherit the canonical Fréchet topology. -/
theorem normalizedInduction.frechet (hV : IsClosed (V : Set (∀ n, B n))) :
    ∃ (U : UniformSpace (normalizedInduction (E := realPoints.Model A) B V
      (realParabolic l) σ (parabolicDelta l) eta.character)),
      U.toTopologicalSpace = (inferInstance : TopologicalSpace (normalizedInduction
        (E := realPoints.Model A) B V (realParabolic l) σ (parabolicDelta l) eta.character)) ∧
      @CompleteSpace (normalizedInduction (E := realPoints.Model A) B V
        (realParabolic l) σ (parabolicDelta l) eta.character) U ∧
      FirstCountableTopology (normalizedInduction (E := realPoints.Model A) B V
        (realParabolic l) σ (parabolicDelta l) eta.character) := sorry
end CanonicalCompactPicture
end TauCeti.RealReductive
