/-- On the constant automorphic realization every nontrivial unipotent Fourier
functional is zero. The character is on the actual arithmetic additive quotient. -/
theorem trivial_not_generic (psi : AddChar (SL2.AdditiveQuotient ℚ) ℂ)
    (hpsi : Continuous psi) (hne : ∃ b, psi b≠1) (g : SL2.Group ℚ) :
