section CanonicalGlobalization
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A)

/-- The inclusion is the original vector in the fixed Banach completion's
smooth-vector subspace, expressed in the specified Sobolev presentation. -/
def globalization_inclusion (X : HCModuleCat D.pair) :
    X.obj.carrier →ₗ[ℂ] ((globalizationFunctor D).obj X).S where
  toFun v := (globalizationCarrier.{0} D X).symm
    ⟨(globalizationNorm.{0} D ⟨X.obj.action,X.property.1,X.property.2⟩).embedding v,by sorry⟩
  map_add' := by sorry
  map_smul' := by sorry

theorem casselmanWallach_counit_identity (X : HCModuleCat D.pair) (v : X.obj.carrier) :
    (kFiniteFunctorCarrier D ((globalizationFunctor D).obj X)
      (((casselmanWallach D).counitIso.inv.app X).hom.toLinearMap v)).val=
        globalization_inclusion D X v := sorry

theorem globalization_map_inclusion {X Y : HCModuleCat D.pair}
    (f : X ⟶ Y) (v : X.obj.carrier) :
    ((globalizationFunctor D).map f).toContinuousLinearMap (globalization_inclusion D X v)=
      globalization_inclusion D Y (f.hom.toLinearMap v) := sorry

theorem kFiniteFunctorCarrier_lie (X : SAFModuleCat D)
    (u : complexAlgebraicLie A) (v : ((kFiniteFunctor D).obj X).obj.carrier) :
    (kFiniteFunctorCarrier D X (((kFiniteFunctor D).obj X).obj.action.rho u v)).val=
      SFRep.derivAction 𝓘(ℝ,realPoints.Model A) (realPoints A) X.B X.S
        X.representation (D.complexLieTangent u)
        (kFiniteFunctorCarrier D X v).val := sorry
end CanonicalGlobalization
end TauCeti.RealReductive

