section ReductivePairBridge
open TauCeti.RelativeLieCohomology
variable (A : Type) [CommRing A] [HopfAlgebra ℝ A]
  [Algebra.FiniteType ℝ A] [Algebra.Smooth ℝ A]

/-- Scalar extension of the native algebraic tangent Lie algebra. -/
abbrev complexAlgebraicLie := ℂ ⊗[ℝ] algebraicRealLie A

/-- A finite coordinate norm changes no algebraic action or tangent identification. -/
instance complexAlgebraicLie.normedAddCommGroup : NormedAddCommGroup (complexAlgebraicLie A) :=
  NormedAddCommGroup.induced _ _ (Module.finBasis ℂ (complexAlgebraicLie A)).equivFun.toAddMonoidHom
    (Module.finBasis ℂ (complexAlgebraicLie A)).equivFun.injective
instance complexAlgebraicLie.normedSpace : NormedSpace ℂ (complexAlgebraicLie A) :=
  NormedSpace.induced _ _ _ (Module.finBasis ℂ (complexAlgebraicLie A)).equivFun.toLinearMap
instance : NormedComplexLieAlgebra (complexAlgebraicLie A) :=
  { (inferInstance : NormedAddCommGroup (complexAlgebraicLie A)),
    (inferInstance : LieRing (complexAlgebraicLie A)),
    (inferInstance : NormedSpace ℂ (complexAlgebraicLie A)),
    (inferInstance : LieAlgebra ℂ (complexAlgebraicLie A)),
    (inferInstance : FiniteDimensional ℂ (complexAlgebraicLie A)) with }


variable {A}
abbrev Datum.KModel (D : Datum A) := EuclideanSpace ℝ (Fin (Module.finrank ℝ D.compactLie))
instance Datum.KchartedSpace (D : Datum A) : ChartedSpace D.KModel D.K := sorry
instance Datum.KmeasurableSpace (D : Datum A) : MeasurableSpace D.K := borel D.K
instance Datum.KborelSpace (D : Datum A) : BorelSpace D.K := ⟨rfl⟩
instance Datum.KlieGroup (D : Datum A) : LieGroup 𝓘(ℝ, D.KModel) ∞ D.K := sorry
attribute [local instance] LieGroup.minSmoothnessThree

/-- Derivative of the fixed-subgroup inclusion into the real point group. -/
def Datum.Klie (D : Datum A) :
    GroupLieAlgebra 𝓘(ℝ, D.KModel) D.K ≃ₗ[ℝ] D.compactLie := sorry

theorem Datum.Klie_inclusion (D : Datum A)
    (X : GroupLieAlgebra 𝓘(ℝ, D.KModel) D.K) :
    (D.Klie X).val = realPoints_lieAlgebra A
      (mfderiv 𝓘(ℝ, D.KModel) 𝓘(ℝ, realPoints.Model A)
        (fun k : D.K => k.val) 1 X) := sorry

/-- The actual reductive pair; its action is scalar extension of algebraic Ad. -/
def Datum.pair (D : Datum A) : Pair 𝓘(ℝ, D.KModel) D.K (complexAlgebraicLie A) := sorry

theorem Datum.pair_iota (D : Datum A)
    (X : GroupLieAlgebra 𝓘(ℝ, D.KModel) D.K) :
    D.pair.iota (1 ⊗ₜ[ℝ] X) = 1 ⊗ₜ[ℝ] (D.Klie X).val := sorry

theorem Datum.pair_Ad (D : Datum A) (k : D.K) (X : algebraicRealLie A) :
    D.pair.Ad k (1 ⊗ₜ[ℝ] X) = 1 ⊗ₜ[ℝ] realPoints.algebraicAd k.val X := sorry

variable (D : Datum A) {V : Type} [AddCommGroup V] [Module ℂ V]

/-- Connected algebraic reductivity gives invariance under every component of K. -/
theorem Datum.centre_invariant (M : GKModule D.pair V)
    (k : D.K) (z : Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ (complexAlgebraicLie A)))
    (v : V) : M.sigma k (envelopingAction M z.val v) =
      envelopingAction M z.val (M.sigma k v) := sorry

theorem admissible_of_irreducible (M : GKModule D.pair V)
    (hM : IsIrreducibleGK M) : IsAdmissible M := sorry

def HCModule.dual (M : HCModule (P := D.pair) (V := V)) :
    HCModule (P := D.pair) (V := kFinite (contragredient M.toGKModule)) where
  toGKModule := restrictedDual M.toGKModule
  admissible := sorry
  finitelyGenerated := sorry

variable {W : Type} [AddCommGroup W] [Module ℂ W]

def HCModule.tensorFinite (M : HCModule (P := D.pair) (V := V))
    (F : GKModule D.pair W) [FiniteDimensional ℂ W] :
    HCModule (P := D.pair) (V := V ⊗[ℂ] W) where
  toGKModule := GKModule.tensorFinite D.pair M.toGKModule F
  admissible := sorry
  finitelyGenerated := sorry

theorem HCModule.iff_zFinite (M : GKModule D.pair V) (hM : IsAdmissible M) :
    IsFinitelyGenerated M ↔ IsZFinite M := sorry

/-- Schur's central character, with the reductive component invariance supplied. -/
def infCharOfReductiveHC (M : HCModule (P := D.pair) (V := V))
    (hM : IsIrreducibleGK M.toGKModule) : InfChar (complexAlgebraicLie A) :=
  infCharOfHC M hM (D.centre_invariant M.toGKModule)

theorem infCharOfReductiveHC_eq_iff (M : HCModule (P := D.pair) (V := V))
    (hM : IsIrreducibleGK M.toGKModule) (χ : InfChar (complexAlgebraicLie A)) :
    infCharOfReductiveHC D M hM = χ ↔ HasInfChar M.toGKModule χ := sorry
end ReductivePairBridge
