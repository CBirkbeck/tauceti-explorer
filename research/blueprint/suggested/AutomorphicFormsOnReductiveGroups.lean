namespace TauCeti.Automorphic
section GrowthOperations
open MeasureTheory
variable {Ginf Gf : Type*} [Group Ginf] [TopologicalSpace Ginf]
  [IsTopologicalGroup Ginf] [LocallyCompactSpace Ginf] [T2Space Ginf]
  [SecondCountableTopology Ginf] [Group Gf] [TopologicalSpace Gf]
  [hFTop : IsTopologicalGroup Gf] [hFLocal : LocallyCompactSpace Gf] [TotallyDisconnectedSpace Gf]
  [hFT2 : T2Space Gf] [SecondCountableTopology Gf]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] (I : ModelWithCorners ℝ E H)
  [ChartedSpace H Ginf] [LieGroup I ∞ Ginf]
  (height : Ginf × Gf → ℝ) (h1 : ∀ g, 1≤height g)
  (hmul : ∀ g h, height (g*h)≤height g*height h)
  (Γ : Subgroup (Ginf × Gf)) (N : ℝ) (hN : 0≤N)
local notation "Sm" => SmoothAdelicFunction (Ginf := Ginf) (Gf := Gf) I
local notation "q" => TauCeti.ComplexGroupLie I Ginf
local notation "U" => UniversalEnvelopingAlgebra ℂ q

/-- This is induced by the actual adjoint derivative of conjugation. -/
def envelopingAd (y : Ginf) : U →ₐ[ℂ] U := sorry
theorem envelopingAd_iota (y : Ginf) (X : q) :
    envelopingAd I y (UniversalEnvelopingAlgebra.ι ℂ X)=
      UniversalEnvelopingAlgebra.ι ℂ (TauCeti.ComplexGroupLie.ad I Ginf y X) := sorry

def smoothRightTranslate (y : Ginf × Gf) : Sm →ₗ[ℂ] Sm where
  toFun f := ⟨rightTranslate y f.val, SmoothAdelicFunction.rightTranslate I f.property y⟩
  map_add' := sorry
  map_smul' := sorry

theorem rightDerivative_rightTranslate (u : U) (y : Ginf × Gf) (f : Sm) :
    rightDerivative I u (smoothRightTranslate I y f)=
      smoothRightTranslate I y (rightDerivative I (envelopingAd I y.1⁻¹ u) f) := sorry

theorem UniformModerateGrowth.rightTranslate_mem
    (h1 : ∀ g, 1≤height g) (hmul : ∀ g h, height (g*h)≤height g*height h)
    (hN : 0≤N) (y : Ginf × Gf) (f : UniformModerateGrowth I height Γ N) :
    smoothRightTranslate I y f.val∈UniformModerateGrowth I height Γ N := sorry

def UniformModerateGrowth.rightTranslate (y : Ginf × Gf) :
    UniformModerateGrowth I height Γ N →ₗ[ℂ] UniformModerateGrowth I height Γ N where
  toFun f := ⟨smoothRightTranslate I y f.val,
    UniformModerateGrowth.rightTranslate_mem (I := I) (height := height) (Γ := Γ) (N := N) h1 hmul hN y f⟩
  map_add' := sorry
  map_smul' := sorry

theorem UniformModerateGrowth.rightTranslate_seminorm (y : Ginf × Gf) (u : U)
    (f : UniformModerateGrowth I height Γ N) :
    UniformModerateGrowth.seminorm I height Γ N u
      (UniformModerateGrowth.rightTranslate (I := I) (height := height) (Γ := Γ) (N := N) h1 hmul hN y f)≤
      height y^N*UniformModerateGrowth.seminorm I height Γ N (envelopingAd I y.1⁻¹ u) f := sorry

def UniformModerateGrowth.derivative (u : U) :
    UniformModerateGrowth I height Γ N →ₗ[ℂ] UniformModerateGrowth I height Γ N := sorry

theorem UniformModerateGrowth.derivative_val (u : U)
    (f : UniformModerateGrowth I height Γ N) :
    (UniformModerateGrowth.derivative I height Γ N u f).val=rightDerivative I u f.val := sorry

theorem UniformModerateGrowth.derivative_seminorm (u v : U)
    (f : UniformModerateGrowth I height Γ N) :
    UniformModerateGrowth.seminorm I height Γ N v
      (UniformModerateGrowth.derivative I height Γ N u f)=
      UniformModerateGrowth.seminorm I height Γ N (v*u) f := sorry

variable [MeasurableSpace Ginf] [BorelSpace Ginf] [MeasurableSpace Gf] [hFBorel : BorelSpace Gf]
  (μ : Measure (Ginf × Gf)) [μ.IsHaarMeasure] [μ.IsMulRightInvariant]
  (hinv : ∀ g, height g⁻¹=height g) (hheight : Continuous height)
  (hint : ∃ r : ℕ, Integrable (fun g => height g^(-(r : ℝ))) μ)

/-- Schwartz convolution supplies the actual smooth function, rather than
postulating an arbitrary output with the desired growth property. -/
theorem UniformModerateGrowth.convolution_mem
    (h1 : ∀ g, 1≤height g) (hmul : ∀ g h, height (g*h)≤height g*height h)
    (hN : 0≤N)
    (hinv : ∀ g, height g⁻¹=height g) (hheight : Continuous height)
    (hint : ∃ r : ℕ, Integrable (fun g => height g^(-(r : ℝ))) μ)
    (φ : C(Ginf × Gf,ℂ))
    (hΓ : ∀ (γ : Γ) g, φ ((γ : Ginf × Gf)*g)=φ g)
    (C : ℝ) (hC : 0≤C) (hφ : ∀ g, ‖φ g‖≤C*height g^N)
    (f : SchwartzFunction I height) :
    ∃ F : UniformModerateGrowth I height Γ N, ∀ g,
      F.val.val g=∫ y, f.val.val y*φ (g*y) ∂μ := sorry

variable (μf : Measure Gf) [μf.IsHaarMeasure] [μf.IsMulRightInvariant]
  (J : Subgroup Gf) (ho : IsOpen (J : Set Gf)) (hc : IsCompact (J : Set Gf))

include hFTop hFLocal hFT2 hFBorel

/-- The finite Hecke kernel is the native finite test function with its left
J-invariance stated explicitly; its integral acts on the actual level space. -/
def heckeAction (hLie : LieGroup I ∞ Ginf) (hDim : FiniteDimensional ℝ E)
    (hFTop : IsTopologicalGroup Gf) (hFLocal : LocallyCompactSpace Gf)
    (hFT2 : T2Space Gf) (hFBorel : BorelSpace Gf) (h1 : ∀ g, 1≤height g)
    (hmul : ∀ g h, height (g*h)≤height g*height h) (hN : 0≤N)
    (hheight : Continuous height) (μf : Measure Gf)
    [μf.IsHaarMeasure] [μf.IsMulRightInvariant]
    (ho : IsOpen (J : Set Gf)) (hc : IsCompact (J : Set Gf)) (f : FiniteTestFunction (Gf := Gf))
    (hbi : ∀ (j k : J) y, f ((j : Gf)*y*(k : Gf))=f y) :
    Module.End ℂ (UniformModerateGrowth.level I height Γ N J) := sorry

theorem heckeAction_apply (f : FiniteTestFunction (Gf := Gf))
    (hbi : ∀ (j k : J) y, f ((j : Gf)*y*(k : Gf))=f y)
    (φ : UniformModerateGrowth.level I height Γ N J) (g : Ginf × Gf) :
    (heckeAction (I := I) (height := height) (Γ := Γ) (N := N) (J := J) inferInstance inferInstance inferInstance inferInstance inferInstance inferInstance
      h1 hmul hN hheight μf ho hc f hbi φ).val.val.val g=
      ∫ y, f y*φ.val.val.val (g.1,g.2*y) ∂μf := sorry
end GrowthOperations
end TauCeti.Automorphic

namespace TauCeti.RelativeLieCohomology
section LowDegreeBridge
variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {K : Type} [Group K] [TopologicalSpace K] [ChartedSpace H K]
  [LieGroup I ∞ K] [CompactSpace K] {q : Type} [NormedComplexLieAlgebra q]
  {P : Pair I K q} {V : Type} [AddCommGroup V] [Module ℂ V]

@[instance_reducible] def GKModule.toLieRingModule (A : GKModule P V) : LieRingModule q V where
  bracket X v := A.rho X v
  add_lie := sorry
  lie_add := sorry
  leibniz_lie := sorry

theorem GKModule.toLieModule (A : GKModule P V) :
    letI := GKModule.toLieRingModule A
    LieModule ℂ q V := sorry

theorem d_lowDegree_compat (A : GKModule P V) (w : cochains A 1) :
    letI := GKModule.toLieRingModule A
    letI := GKModule.toLieModule A
    AbsoluteLie.twoEquivMathlib ℂ q V ((differential A 1 w).val) =
      LieModule.Cohomology.d₁₂ ℂ q V (AbsoluteLie.oneEquivMathlib ℂ q V w.val) := sorry
end LowDegreeBridge
end TauCeti.RelativeLieCohomology

namespace TauCeti.RealReductive

/-! The algebraic/analytic bridge uses the pinned convolution points and
counit-valued derivations. It does not construct another algebraic-group API. -/
section AlgebraicRealPoints
variable (A : Type) [CommRing A] [HopfAlgebra ℝ A]

/-- The native convolution point group, tagged to carry its real manifold. -/
def realPoints : Type := WithConv (A →ₐ[ℝ] ℝ)

instance : Group (realPoints A) := by unfold realPoints; infer_instance

def realPoints.eval (g : realPoints A) (a : A) : ℝ := g.ofConv a

instance : TopologicalSpace (realPoints A) :=
  TopologicalSpace.induced (fun g a => realPoints.eval A g a) inferInstance
instance : IsTopologicalGroup (realPoints A) := sorry
instance : T2Space (realPoints A) := sorry

abbrev algebraicRealLie := Derivation ℝ A (TauCeti.Bialgebra.CounitAlgebra ℝ A ℝ)

variable [Algebra.FiniteType ℝ A]
instance : FiniteDimensional ℝ (algebraicRealLie A) := sorry
abbrev realPoints.Model := EuclideanSpace ℝ (Fin (Module.finrank ℝ (algebraicRealLie A)))

variable [Algebra.Smooth ℝ A]
instance realPoints.chartedSpace : ChartedSpace (realPoints.Model A) (realPoints A) := sorry
instance realPoints.lieGroup : LieGroup 𝓘(ℝ, realPoints.Model A) ∞ (realPoints A) := sorry
instance : LocallyCompactSpace (realPoints A) := sorry
instance : SecondCountableTopology (realPoints A) := sorry

local notation "IR" => 𝓘(ℝ, realPoints.Model A)
instance realPoints.minimumLieGroup : LieGroup IR (minSmoothness ℝ 3) (realPoints A) :=
  LieGroup.of_le (n := ∞) (by simp)
instance realPoints.groupLieRing : LieRing (GroupLieAlgebra IR (realPoints A)) :=
  instLieRingGroupLieAlgebra (I := IR) (G := realPoints A)
instance realPoints.groupLieAlgebra : LieAlgebra ℝ (GroupLieAlgebra IR (realPoints A)) :=
  instLieAlgebraGroupLieAlgebra (I := IR) (G := realPoints A)

/-- Differentiation of regular functions, rather than an unspecified isomorphism. -/
def realPoints_lieAlgebra : GroupLieAlgebra IR (realPoints A) ≃ₗ⁅ℝ⁆ algebraicRealLie A := sorry

theorem realPoints_lieAlgebra_eval (X : GroupLieAlgebra IR (realPoints A)) (a : A) :
    TauCeti.Bialgebra.CounitAlgebra.algEquivSelf ℝ A ℝ
      (realPoints_lieAlgebra A X a) =
        mfderiv IR 𝓘(ℝ, ℝ) (fun g => realPoints.eval A g a) 1 X := sorry

theorem realPoints_regular_smooth (a : A) :
    ContMDiff IR 𝓘(ℝ, ℝ) ∞ (fun g => realPoints.eval A g a) := sorry

theorem realPoints_finite_components : Finite (ConnectedComponents (realPoints A)) := sorry

variable {A} {B : Type} [CommRing B] [HopfAlgebra ℝ B]
  [Algebra.FiniteType ℝ B] [Algebra.Smooth ℝ B]

def realPoints_map (f : B →ₐc[ℝ] A) : realPoints A →* realPoints B where
  toFun g := WithConv.toConv (g.ofConv.comp f.toAlgHom)
  map_one' := sorry
  map_mul' := sorry

theorem realPoints_map_smooth (f : B →ₐc[ℝ] A) :
    ContMDiff 𝓘(ℝ, realPoints.Model A) 𝓘(ℝ, realPoints.Model B) ∞ (realPoints_map f) := sorry

theorem realPoints_map_differential (f : B →ₐc[ℝ] A)
    (X : GroupLieAlgebra 𝓘(ℝ, realPoints.Model A) (realPoints A)) :
    realPoints_lieAlgebra B
      (mfderiv 𝓘(ℝ, realPoints.Model A) 𝓘(ℝ, realPoints.Model B) (realPoints_map f) 1 X) =
        TauCeti.derivationCompLieHom (B := ℝ) f (realPoints_lieAlgebra A X) := sorry

theorem realPoints_map_id : realPoints_map (BialgHom.id ℝ A) = MonoidHom.id _ := sorry

theorem realPoints_map_comp {C : Type} [CommRing C] [HopfAlgebra ℝ C]
    [Algebra.FiniteType ℝ C] [Algebra.Smooth ℝ C]
    (f : B →ₐc[ℝ] A) (h : C →ₐc[ℝ] B) :
    realPoints_map (f.comp h) = (realPoints_map h).comp (realPoints_map f) := sorry

/-- Algebraic adjoint action transported through the native counit coefficient tag. -/
def realPoints.algebraicAd (g : realPoints A) : algebraicRealLie A →ₗ[ℝ] algebraicRealLie A := sorry

theorem realPoints.algebraicAd_eval (g : realPoints A) (X : algebraicRealLie A) :
    realPoints.algebraicAd g X = Derivation.adDerivation ℝ
      (WithConv.toConv ((TauCeti.Bialgebra.CounitAlgebra.algEquivSelf ℝ A ℝ).symm.toAlgHom.comp
        g.ofConv)) X := sorry

theorem realPoints_Ad (g : realPoints A)
    (X : GroupLieAlgebra 𝓘(ℝ, realPoints.Model A) (realPoints A)) :
    realPoints_lieAlgebra A
      (mfderiv 𝓘(ℝ, realPoints.Model A) 𝓘(ℝ, realPoints.Model A)
        (fun h : realPoints A => g*h*g⁻¹) 1 X) =
      realPoints.algebraicAd g (realPoints_lieAlgebra A X) := sorry
end AlgebraicRealPoints

end TauCeti.RealReductive

namespace TauCeti.RealReductive

section ReductiveDatum
variable (A : Type) [CommRing A] [HopfAlgebra ℝ A]
  [Algebra.FiniteType ℝ A] [Algebra.Smooth ℝ A]

/-- Complex points have the evaluation topology; the coefficient algebra is ℂ. -/
def complexPoints : Type := WithConv (A →ₐ[ℝ] ℂ)
instance : Group (complexPoints A) := by unfold complexPoints; infer_instance
instance : TopologicalSpace (complexPoints A) :=
  TopologicalSpace.induced (fun g a => g.ofConv a) inferInstance

/-- Coordinate form of the ALS.0 Cartan input. The compactness condition is
on the actual twisted real form, not on an arbitrary nominated subgroup. -/
structure Datum where
  reductive : TauCeti.reductiveCommHopfAlgProperty ℝ
    (TauCeti.FiniteTypeCommHopfAlgCat.of ℝ A)
  theta : A ≃ₐc[ℝ] A
  involutive : Function.Involutive theta
  twistedCompact : IsCompact {g : complexPoints A | ∀ a : A,
    g.ofConv a = star (g.ofConv (theta a))}

variable {A}

def Datum.thetaPoints (D : Datum A) : realPoints A ≃* realPoints A := sorry

theorem Datum.thetaPoints_eval (D : Datum A) (g : realPoints A) (a : A) :
    realPoints.eval A (D.thetaPoints g) a = realPoints.eval A g (D.theta a) := sorry

def Datum.K (D : Datum A) : Subgroup (realPoints A) where
  carrier := {g | D.thetaPoints g = g}
  one_mem' := sorry
  mul_mem' := sorry
  inv_mem' := sorry

instance (D : Datum A) : CompactSpace D.K := sorry

def Datum.thetaLie (D : Datum A) : algebraicRealLie A →ₗ⁅ℝ⁆ algebraicRealLie A :=
  TauCeti.derivationCompLieHom (B := ℝ) D.theta.toBialgHom

def Datum.compactLie (D : Datum A) : Submodule ℝ (algebraicRealLie A) :=
  LinearMap.ker (D.thetaLie.toLinearMap - LinearMap.id)

def Datum.noncompactLie (D : Datum A) : Submodule ℝ (algebraicRealLie A) :=
  LinearMap.ker (D.thetaLie.toLinearMap + LinearMap.id)

/-- The inverse is addition of the two eigenspace vectors. -/
def Datum.cartanDecomp (D : Datum A) :
    algebraicRealLie A ≃ₗ[ℝ] D.compactLie × D.noncompactLie := sorry

theorem Datum.cartanDecomp_symm (D : Datum A) (x : D.compactLie × D.noncompactLie) :
    D.cartanDecomp.symm x = x.1.val + x.2.val := sorry

theorem Datum.cartanDecomp_apply (D : Datum A) (X : algebraicRealLie A) :
    (D.cartanDecomp X).1.val = (1/2 : ℝ) • (X + D.thetaLie X) ∧
    (D.cartanDecomp X).2.val = (1/2 : ℝ) • (X - D.thetaLie X) := sorry

/-- Maximality and exhaustion of the connected components are consequences
of the imported Cartan theorem, rather than assumptions on the datum. -/
theorem Datum.maximalCompact (D : Datum A) (L : Subgroup (realPoints A))
    (hL : IsCompact (L : Set (realPoints A))) (hKL : D.K ≤ L) : L = D.K := sorry

instance componentSubgroupNormal {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] : (Subgroup.connectedComponentOfOne G).Normal := sorry

abbrev Datum.componentGroupOf {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] := G ⧸ Subgroup.connectedComponentOfOne G

/-- The induced map is inclusion K ↪ G on component classes. -/
def Datum.componentGroup (D : Datum A) :
    Datum.componentGroupOf (G := D.K) ≃* Datum.componentGroupOf (G := realPoints A) := sorry

theorem Datum.componentGroup_mk (D : Datum A) (k : D.K) :
    D.componentGroup (QuotientGroup.mk k) = QuotientGroup.mk k.val := sorry

instance : Finite (Datum.componentGroupOf (G := realPoints A)) := sorry
instance (D : Datum A) : Finite (Datum.componentGroupOf (G := D.K)) := sorry

/-- The ALS.0 existence theorem constructs θ; no chosen group isomorphism is an input. -/
def Datum.ofAlgebraic (hA : TauCeti.reductiveCommHopfAlgProperty ℝ
    (TauCeti.FiniteTypeCommHopfAlgCat.of ℝ A)) : Datum A := sorry

theorem Datum.conj (D D' : Datum A) :
    ∃ g : Subgroup.connectedComponentOfOne (realPoints A), ∀ x : realPoints A,
      D'.thetaPoints x = g.val * D.thetaPoints (g.val⁻¹*x*g.val) * g.val⁻¹ := sorry

-- test: datum_compact. Compact real points give the identity Cartan involution.
theorem datum_compact [CompactSpace (realPoints A)] (D : Datum A) :
    D.K = ⊤ ∧ D.noncompactLie = ⊥ := sorry

-- test: datum_compact
example [CompactSpace (realPoints A)] (D : Datum A) :
    D.K = ⊤ ∧ D.noncompactLie = ⊥ := sorry

end ReductiveDatum
end TauCeti.RealReductive

namespace TauCeti.RealReductive
section GLAdapter
open scoped Matrix.Norms.Operator
abbrev GLCoordinate (n : ℕ) := TauCeti.GeneralLinear.coordinateHopfAlgebra ℝ n
abbrev GLReal (n : ℕ) := realPoints (GLCoordinate n)
abbrev GLMatrix (n : ℕ) := Matrix (Fin n) (Fin n) ℝ
def realPoints.GL (n : ℕ) : GLReal n ≃* Matrix.GeneralLinearGroup (Fin n) ℝ :=
  TauCeti.GeneralLinear.pointsMulEquiv (R := ℝ) (A := ℝ) n

/-- Extend the inverse matrix evaluation only for expressing smoothness on the open unit locus. -/
def realPoints.GL_ofMatrix (n : ℕ) (m : GLMatrix n) : GLReal n :=
  by
  classical
  exact if h : IsUnit m then (realPoints.GL n).symm h.unit else 1

/-- Matrix evaluation and its inverse on the unit locus identify the Lie structures. -/
theorem realPoints_GL_compat (n : ℕ) :
    ContMDiff 𝓘(ℝ, realPoints.Model (GLCoordinate n)) 𝓘(ℝ, Fin n → Fin n → ℝ) ∞
      (fun (g : GLReal n) (i j : Fin n) => (realPoints.GL n g).val i j) ∧
    ContMDiffOn 𝓘(ℝ, Fin n → Fin n → ℝ) 𝓘(ℝ, realPoints.Model (GLCoordinate n)) ∞
      (fun m : Fin n → Fin n → ℝ => realPoints.GL_ofMatrix n m) {m | IsUnit m} ∧
    ∀ g : Matrix.GeneralLinearGroup (Fin n) ℝ,
      realPoints.GL_ofMatrix n g.val = (realPoints.GL n).symm g := sorry

abbrev realPoints.GLlie (n : ℕ) : algebraicRealLie (GLCoordinate n) ≃ₗ⁅ℝ⁆ GLMatrix n :=
  TauCeti.GeneralLinear.tangentLieEquivMatrix (R := ℝ) (B := ℝ) n

/-- The coordinate involution is characterized by inverse transpose on actual points. -/
def Datum.generalLinear (n : ℕ) : Datum (GLCoordinate n) := sorry

theorem Datum.generalLinear_theta (n : ℕ) (g : GLReal n) :
    ((realPoints.GL n ((Datum.generalLinear n).thetaPoints g)) : GLMatrix n) =
      ((realPoints.GL n g)⁻¹ : Matrix.GeneralLinearGroup (Fin n) ℝ).val.transpose := sorry

theorem Datum.generalLinear_thetaLie (n : ℕ) (X : algebraicRealLie (GLCoordinate n)) :
    realPoints.GLlie n ((Datum.generalLinear n).thetaLie X) = -(realPoints.GLlie n X).transpose := sorry

-- test: datum_GLn. Orthogonality, the symmetric tangent dimension and the two components.
theorem datum_GLn (n : ℕ) (hn : 0 < n) (g : GLReal n) :
    (g ∈ (Datum.generalLinear n).K ↔
      (realPoints.GL n g).val.transpose * (realPoints.GL n g).val = 1) ∧
    Module.finrank ℝ (Datum.generalLinear n).noncompactLie = n*(n+1)/2 ∧
    Nat.card (Datum.componentGroupOf (G := (Datum.generalLinear n).K)) = 2 := sorry

-- test: datum_GLn
example (n : ℕ) (hn : 0 < n) (g : GLReal n) :
    (g ∈ (Datum.generalLinear n).K ↔
      (realPoints.GL n g).val.transpose * (realPoints.GL n g).val = 1) ∧
    Module.finrank ℝ (Datum.generalLinear n).noncompactLie = n*(n+1)/2 ∧
    Nat.card (Datum.componentGroupOf (G := (Datum.generalLinear n).K)) = 2 := sorry

example : Subsingleton (GLReal 0) ∧
    Subsingleton (Datum.componentGroupOf (G := (Datum.generalLinear 0).K)) := sorry

-- test: datum_not_any_compact. The determinant-one rotations miss a component.
theorem datum_not_any_compact : ∃ g : (Datum.generalLinear 2).K,
    Matrix.det (realPoints.GL 2 g.val).val = -1 := sorry

-- test: datum_not_any_compact
example : ∃ g : (Datum.generalLinear 2).K,
    Matrix.det (realPoints.GL 2 g.val).val = -1 := sorry

-- test: datum_lie_compat. Cartan projections are the skew and symmetric parts.
theorem datum_lie_compat (n : ℕ) (X : algebraicRealLie (GLCoordinate n)) :
    realPoints.GLlie n (((Datum.generalLinear n).cartanDecomp X).1.val) =
      (1/2 : ℝ) • (realPoints.GLlie n X - (realPoints.GLlie n X).transpose) ∧
    realPoints.GLlie n (((Datum.generalLinear n).cartanDecomp X).2.val) =
      (1/2 : ℝ) • (realPoints.GLlie n X + (realPoints.GLlie n X).transpose) := sorry

-- test: datum_lie_compat
example (n : ℕ) (X : algebraicRealLie (GLCoordinate n)) :
    realPoints.GLlie n (((Datum.generalLinear n).cartanDecomp X).1.val) =
      (1/2 : ℝ) • (realPoints.GLlie n X - (realPoints.GLlie n X).transpose) ∧
    realPoints.GLlie n (((Datum.generalLinear n).cartanDecomp X).2.val) =
      (1/2 : ℝ) • (realPoints.GLlie n X + (realPoints.GLlie n X).transpose) := sorry

-- test: realPoints_trivial. The native trivial Hopf algebra has zero tangent space.
theorem realPoints_trivial : Subsingleton (realPoints ℝ) ∧ Module.finrank ℝ (algebraicRealLie ℝ) = 0 := sorry

-- test: realPoints_trivial
example : Subsingleton (realPoints ℝ) ∧ Module.finrank ℝ (algebraicRealLie ℝ) = 0 := sorry

end GLAdapter
end TauCeti.RealReductive

namespace TauCeti.RealReductive
section RealOrbits
variable {A B : Type} [CommRing A] [HopfAlgebra ℝ A]
  [Algebra.FiniteType ℝ A] [Algebra.Smooth ℝ A]
  [CommRing B] [HopfAlgebra ℝ B] [Algebra.FiniteType ℝ B] [Algebra.Smooth ℝ B]

/-- The algebraic point action is the native comodule contraction. -/
theorem realPoints_orbitMap (V : Type*) [NormedAddCommGroup V] [NormedSpace ℝ V]
    [FiniteDimensional ℝ V] [Comodule ℝ A V] (v : V) :
    ContMDiff 𝓘(ℝ, realPoints.Model A) 𝓘(ℝ, V) ∞
      (fun g : realPoints A => TauCeti.Comodule.basePointsRepresentation (H := A) V g v) := sorry

/-- A closed immersion is a surjection of coordinate Hopf algebras. -/
theorem realPoints_map_closedEmbedding (f : A →ₐc[ℝ] B) (hf : Function.Surjective f) :
    Topology.IsClosedEmbedding (realPoints_map f) := sorry

abbrev realPoints.quotient (f : A →ₐc[ℝ] B) :=
  realPoints A ⧸ (realPoints_map f).range

abbrev realPoints.tangentQuotient (f : A →ₐc[ℝ] B) :=
  algebraicRealLie A ⧸ (TauCeti.derivationCompLieHom (B := ℝ) f).toLinearMap.range

abbrev realPoints.quotientModel (f : A →ₐc[ℝ] B) :=
  EuclideanSpace ℝ (Fin (Module.finrank ℝ (realPoints.tangentQuotient f)))

instance (f : A →ₐc[ℝ] B) [Fact (Function.Surjective f)] :
    ChartedSpace (realPoints.quotientModel f) (realPoints.quotient f) := sorry
instance (f : A →ₐc[ℝ] B) [Fact (Function.Surjective f)] :
    IsManifold 𝓘(ℝ, realPoints.quotientModel f) ∞ (realPoints.quotient f) := sorry

/-- The inverse comparison is induced by the derivative of the coset projection. -/
def realPoints.quotientTangent (f : A →ₐc[ℝ] B) [Fact (Function.Surjective f)] :
    TangentSpace 𝓘(ℝ, realPoints.quotientModel f)
      ((QuotientGroup.mk : realPoints A → realPoints.quotient f) 1) ≃ₗ[ℝ]
        realPoints.tangentQuotient f := sorry

theorem realPoints.quotientTangent_projection (f : A →ₐc[ℝ] B)
    [Fact (Function.Surjective f)]
    (X : GroupLieAlgebra 𝓘(ℝ, realPoints.Model A) (realPoints A)) :
    realPoints.quotientTangent f
      (mfderiv 𝓘(ℝ, realPoints.Model A) 𝓘(ℝ, realPoints.quotientModel f)
        (QuotientGroup.mk : realPoints A → realPoints.quotient f) 1 X) =
      Submodule.Quotient.mk (realPoints_lieAlgebra A X) := sorry
end RealOrbits
end TauCeti.RealReductive

namespace TauCeti.RealReductive
section RealExamples
open scoped Matrix.Norms.Operator
attribute [local instance] LieGroup.minSmoothnessThree

/-- The native Lie-group exponential on the actual algebraic tangent carrier. -/
def realPoints.exp (A : Type) [CommRing A] [HopfAlgebra ℝ A]
    [Algebra.FiniteType ℝ A] [Algebra.Smooth ℝ A] (X : algebraicRealLie A) : realPoints A :=
  mulInvariantExp ((realPoints_lieAlgebra A).symm X)

/-- In rank one, evaluation on the single generic entry gives the unit. -/
def realPoints.GLone : GLReal 1 ≃* ℝˣ := sorry

theorem realPoints.GLone_eval (g : GLReal 1) :
    (realPoints.GLone g).val = (realPoints.GL 1 g).val 0 0 := sorry

-- test: realPoints_gl1. The positive ray is exactly the exponential image.
theorem realPoints_gl1 : Nat.card (Datum.componentGroupOf (G := GLReal 1)) = 2 ∧
    Module.finrank ℝ (algebraicRealLie (GLCoordinate 1)) = 1 ∧
    (∀ t : ℝ, (realPoints.GLone
      (realPoints.exp (GLCoordinate 1) ((realPoints.GLlie 1).symm (Matrix.diagonal (fun _ => t))))).val =
        Real.exp t) ∧
    Set.range (fun t : ℝ => realPoints.exp (GLCoordinate 1)
      ((realPoints.GLlie 1).symm (Matrix.diagonal (fun _ => t)))) =
        {g : GLReal 1 | 0 < (realPoints.GLone g).val} := sorry

-- test: realPoints_gl1
example : Nat.card (Datum.componentGroupOf (G := GLReal 1)) = 2 ∧
    Module.finrank ℝ (algebraicRealLie (GLCoordinate 1)) = 1 ∧
    (∀ t : ℝ, (realPoints.GLone
      (realPoints.exp (GLCoordinate 1) ((realPoints.GLlie 1).symm (Matrix.diagonal (fun _ => t))))).val =
        Real.exp t) ∧
    Set.range (fun t : ℝ => realPoints.exp (GLCoordinate 1)
      ((realPoints.GLlie 1).symm (Matrix.diagonal (fun _ => t)))) =
        {g : GLReal 1 | 0 < (realPoints.GLone g).val} := sorry

abbrev SO2Coordinate := TauCeti.SpecialOrthogonal.coordinateHopfAlgebra ℝ 2
local instance : Invertible (2 : ℝ) := invertibleOfNonzero (by norm_num)
instance : Algebra.FiniteType ℝ SO2Coordinate := sorry

/-- Rational entries in the actual algebraic SO₂ point group. -/
def realPoints.rationalRotations : Subgroup (realPoints SO2Coordinate) where
  carrier := {g | ∀ i j : Fin 2, ∃ q : ℚ,
    (TauCeti.SpecialOrthogonal.pointsMulEquiv ℝ 2 (A := ℝ) g).val i j = (q : ℝ)}
  one_mem' := sorry
  mul_mem' := sorry
  inv_mem' := sorry

-- test: realPoints_SO2_not_dense. Density does not turn this subgroup into closed real points.
theorem realPoints_SO2_not_dense : Module.finrank ℝ (algebraicRealLie SO2Coordinate) = 1 ∧
    Dense (realPoints.rationalRotations : Set (realPoints SO2Coordinate)) ∧
    ¬ IsClosed (realPoints.rationalRotations : Set (realPoints SO2Coordinate)) := sorry

-- test: realPoints_SO2_not_dense
example : Module.finrank ℝ (algebraicRealLie SO2Coordinate) = 1 ∧
    Dense (realPoints.rationalRotations : Set (realPoints SO2Coordinate)) ∧
    ¬ IsClosed (realPoints.rationalRotations : Set (realPoints SO2Coordinate)) := sorry

/-- Matrix coordinates used to present Res_{ℂ/ℝ}Gₘ as the centralizer of the complex structure. -/
def realPoints.GL2entry (i j : Fin 2) : GLCoordinate 2 :=
  TauCeti.GeneralLinear.coordinateHopfAlgebraAlgEquiv ℝ 2
    (TauCeti.GeneralLinear.coordinateRingMap ℝ 2 (MvPolynomial.X (i,j)))

def realPoints.deligneIdeal : HopfIdeal ℝ (GLCoordinate 2) := sorry

theorem realPoints.deligneIdeal_generators : realPoints.deligneIdeal.toIdeal =
    Ideal.span {realPoints.GL2entry 0 0 - realPoints.GL2entry 1 1,
      realPoints.GL2entry 0 1 + realPoints.GL2entry 1 0} := sorry

abbrev DeligneCoordinate := CommHopfAlgCat.quotient (GLCoordinate 2) realPoints.deligneIdeal
instance : Algebra.FiniteType ℝ DeligneCoordinate := sorry
instance : Algebra.Smooth ℝ DeligneCoordinate := sorry

def realPoints.deligneInclusion : realPoints DeligneCoordinate →* GLReal 2 :=
  realPoints_map (CommHopfAlgCat.mkQuotient (GLCoordinate 2) realPoints.deligneIdeal).hom

/-- The point a+bi is evaluated as the invertible matrix [[a,-b],[b,a]]. -/
def realPoints.deligneEquiv : realPoints DeligneCoordinate ≃* ℂˣ := sorry

theorem realPoints.deligneEquiv_matrix (g : realPoints DeligneCoordinate) :
    (realPoints.GL 2 (realPoints.deligneInclusion g)).val =
      !![(realPoints.deligneEquiv g).val.re, -(realPoints.deligneEquiv g).val.im;
        (realPoints.deligneEquiv g).val.im, (realPoints.deligneEquiv g).val.re] := sorry

def realPoints.deligneLie : algebraicRealLie DeligneCoordinate ≃ₗ[ℝ] ℂ := sorry

theorem realPoints.deligneLie_matrix (X : algebraicRealLie DeligneCoordinate) :
    realPoints.GLlie 2
      (TauCeti.derivationCompLieHom (B := ℝ)
        (CommHopfAlgCat.mkQuotient (GLCoordinate 2) realPoints.deligneIdeal).hom X) =
      !![(realPoints.deligneLie X).re, -(realPoints.deligneLie X).im;
        (realPoints.deligneLie X).im, (realPoints.deligneLie X).re] := sorry

-- test: realPoints_deligne_torus. Native matrix evaluations and their tangent comparison.
theorem realPoints_deligne_torus : ContMDiff 𝓘(ℝ, realPoints.Model DeligneCoordinate) 𝓘(ℝ, ℂ) ∞
    (fun g : realPoints DeligneCoordinate => (realPoints.deligneEquiv g).val) ∧
    ContMDiff 𝓘(ℝ, ℂ) 𝓘(ℝ, realPoints.Model DeligneCoordinate) ∞
      realPoints.deligneEquiv.symm ∧
    Module.finrank ℝ (algebraicRealLie DeligneCoordinate) = 2 := sorry

-- test: realPoints_deligne_torus
example : ContMDiff 𝓘(ℝ, realPoints.Model DeligneCoordinate) 𝓘(ℝ, ℂ) ∞
    (fun g : realPoints DeligneCoordinate => (realPoints.deligneEquiv g).val) ∧
    ContMDiff 𝓘(ℝ, ℂ) 𝓘(ℝ, realPoints.Model DeligneCoordinate) ∞
      realPoints.deligneEquiv.symm ∧
