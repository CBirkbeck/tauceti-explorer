/-- The positive SO₂ weight ray, in the same native finitely-supported carrier. -/
def HolomorphicWeights (k : ℕ) : Submodule ℂ WeightAmbient where
  carrier := {f | ∀ ell : ℤ, f ell≠0 → (k : ℤ)≤ell ∧ (ell-(k : ℤ))%2=0}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

def discreteSeries (k : ℕ) (hk : 1≤k) :
    HCModule (P := sl2SO2Pair) (V := HolomorphicWeights k) := sorry

theorem discreteSeries_rotation (k : ℕ) (hk : 1≤k) (t : ℝ)
    (f : HolomorphicWeights k) (ell : ℤ) :
    ((discreteSeries k hk).sigma (rotationSO2 t) f).val ell=
      Complex.exp (Complex.I*(ell : ℂ)*(t : ℂ))*f.val ell := sorry

theorem discreteSeries_lie (k : ℕ) (hk : 1≤k) (f : HolomorphicWeights k)
    (H X Y : traceZero)
    (hH : realPoints.GLcomplexLie 2 H.val=compactH)
    (hX : realPoints.GLcomplexLie 2 X.val=compactX)
    (hY : realPoints.GLcomplexLie 2 Y.val=compactY) :
    ((discreteSeries k hk).rho H f).val=weightH f.val ∧
    ((discreteSeries k hk).rho X f).val=weightX k f.val ∧
    ((discreteSeries k hk).rho Y f).val=weightY k f.val := sorry

def rotationWeightSpace (k : ℕ) (hk : 1≤k) (ell : ℤ) :
    Submodule ℂ (HolomorphicWeights k) where
  carrier := {f | ∀ t : ℝ, (discreteSeries k hk).sigma (rotationSO2 t) f=
    Complex.exp (Complex.I*(ell : ℂ)*(t : ℂ)) • f}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

theorem hcModule_discrete_series_SL2 (k : ℕ) (hk : 2≤k) (ell : ℤ) :
    Module.finrank ℂ (rotationWeightSpace k (by omega) ell)=
      if (k : ℤ)≤ell ∧ (ell-(k : ℤ))%2=0 then 1 else 0 := sorry

-- test: hcModule_discrete_series_SL2
example (k : ℕ) (hk : 2≤k) (ell : ℤ) :
    Module.finrank ℂ (rotationWeightSpace k (by omega) ell)=
      if (k : ℤ)≤ell ∧ (ell-(k : ℤ))%2=0 then 1 else 0 := sorry

theorem gkModule_sl2_weight (k : ℕ) (hk : 2≤k) (t : ℝ)
    (f : HolomorphicWeights k) (ell : ℤ) :
    ((discreteSeries k (by omega)).sigma (rotationSO2 t) f).val ell=
      Complex.exp (Complex.I*(ell : ℂ)*(t : ℂ))*f.val ell := sorry

-- test: gkModule_sl2_weight
example (k : ℕ) (hk : 2≤k) (t : ℝ)
    (f : HolomorphicWeights k) (ell : ℤ) :
    ((discreteSeries k (by omega)).sigma (rotationSO2 t) f).val ell=
      Complex.exp (Complex.I*(ell : ℂ)*(t : ℂ))*f.val ell := sorry

instance holomorphicTensorGroup (k l : ℕ) :
    AddCommGroup (HolomorphicWeights k ⊗[ℂ] HolomorphicWeights l) :=
  @TensorProduct.addCommGroup ℂ inferInstance (HolomorphicWeights k) (HolomorphicWeights l)
    inferInstance inferInstance inferInstance inferInstance

theorem hcModule_tensor_not_fg (k l : ℕ) (hk : 2≤k) (hl : 2≤l) :
    IsAdmissible (P := sl2SO2Pair) (V := HolomorphicWeights k ⊗[ℂ] HolomorphicWeights l)
      (GKModule.tensor (P := sl2SO2Pair) (discreteSeries k (by omega)).toGKModule
        (discreteSeries l (by omega)).toGKModule) ∧
    ¬IsFinitelyGenerated (P := sl2SO2Pair) (V := HolomorphicWeights k ⊗[ℂ] HolomorphicWeights l)
      (GKModule.tensor (P := sl2SO2Pair) (discreteSeries k (by omega)).toGKModule
        (discreteSeries l (by omega)).toGKModule) := sorry

-- test: hcModule_tensor_not_fg
example (k l : ℕ) (hk : 2≤k) (hl : 2≤l) :
    IsAdmissible (P := sl2SO2Pair) (V := HolomorphicWeights k ⊗[ℂ] HolomorphicWeights l)
      (GKModule.tensor (P := sl2SO2Pair) (discreteSeries k (by omega)).toGKModule
        (discreteSeries l (by omega)).toGKModule) ∧
    ¬IsFinitelyGenerated (P := sl2SO2Pair) (V := HolomorphicWeights k ⊗[ℂ] HolomorphicWeights l)
      (GKModule.tensor (P := sl2SO2Pair) (discreteSeries k (by omega)).toGKModule
        (discreteSeries l (by omega)).toGKModule) := sorry
