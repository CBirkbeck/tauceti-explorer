/-- Classification on actual (gl₂,O₂) carriers, rather than the unintegrated two-ray helper. -/
theorem classification (M : IrrAdmissibleModel.{0} D.pair) :
    FiniteDimensional ℂ M.carrier ∨
    (∃ (W : PrincipalCoefficient D) (hdim : W.dimension=1)
      (hirr : IsIrreducibleGK (principalSeries_kFinite D W).obj.action),
      (IrrAdmissibleModel.isoSetoid D.pair).r M
        (IrrAdmissibleModel.ofHC D
          ⟨(principalSeries_kFinite D W).obj.action,
            (principalSeries_kFinite D W).property.1,
            (principalSeries_kFinite D W).property.2⟩ hirr)) ∨
    ∃ (k : ℕ) (hk : 1≤k) (μ : ℂ),
      (IrrAdmissibleModel.isoSetoid D.pair).r M
        (IrrAdmissibleModel.ofHC D (discreteSeries k hk μ) (discreteSeries_irreducible k hk μ)) := sorry
end TauCeti.RealReductive.GL2

