section InvariantForms
attribute [local instance] LieGroup.minSmoothnessThree
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A)
  {V : Type} [NormedAddCommGroup V] [NormedSpace ℂ V] [FiniteDimensional ℂ V]
  (ρ : ContRepresentation ℂ (realPoints A) V)
  (hs : ∀ v, ContMDiff 𝓘(ℝ,realPoints.Model A) 𝓘(ℝ,V) ∞ (fun g => ρ g v))

/-- G-invariance is pullback equivariance on the actual quotient manifold. -/
def invariantForm (n : ℕ) : Submodule ℂ
    (smoothForms (E := D.symmetricModel) (M := D.symmetricSpace) (V := V) n) where
  carrier := {w | ∀ (g : realPoints A) (x : D.symmetricSpace) (v : Fin n → D.symmetricModel),
    w.val (D.symmetricAction g x)
      (fun i => mfderiv 𝓘(ℝ,D.symmetricModel) 𝓘(ℝ,D.symmetricModel)
        (D.symmetricAction g) x (v i))=ρ g (w.val x v)}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

def invariantFormsDifferential (n : ℕ) : invariantForm D ρ n →ₗ[ℂ] invariantForm D ρ (n+1) := sorry

theorem invariantFormsDifferential_val (n : ℕ) (w : invariantForm D ρ n) :
    (invariantFormsDifferential D ρ n w).val=exteriorDerivative n w.val := sorry

def invariantForms : CochainComplex (ModuleCat ℂ) ℕ :=
  CochainComplex.of (fun n => ModuleCat.of ℂ (invariantForm D ρ n))
    (fun n => ModuleCat.ofHom (invariantFormsDifferential D ρ n)) (by sorry)

/-- Evaluation at eK, followed by complex-linear extension of the real tangent arguments. -/
def invariantFormsEquivRelative (n : ℕ) : invariantForm D ρ n ≃ₗ[ℂ]
    cochains (D.finiteDimModule ρ hs) n := sorry

theorem invariantFormsEquivRelative_evaluation (n : ℕ) (w : invariantForm D ρ n)
    (X : Fin n → algebraicRealLie A) :
    (invariantFormsEquivRelative D ρ hs n w).val (fun i => 1 ⊗ₜ[ℝ] X i)=
      w.val.val (D.symmetricProjection 1) (fun i =>
        mfderiv 𝓘(ℝ,realPoints.Model A) 𝓘(ℝ,D.symmetricModel) D.symmetricProjection 1
          ((realPoints_lieAlgebra A).symm (X i))) := sorry

theorem invariantForms_d (n : ℕ) (w : invariantForm D ρ n) :
    invariantFormsEquivRelative D ρ hs (n+1) (invariantFormsDifferential D ρ n w)=
      differential (D.finiteDimModule ρ hs) n (invariantFormsEquivRelative D ρ hs n w) := sorry

def vanEstDifferentiation : smoothCochains (E := realPoints.Model A) ρ ⟶
    complex (D.finiteDimModule ρ hs) := sorry

/-- Alternated derivatives at the identity determine the map, rather than a chosen isomorphism. -/
theorem vanEstDifferentiation_degree_zero (f : smoothCochain (E := realPoints.Model A) ρ 0) :
    (((vanEstDifferentiation D ρ hs).f 0).hom f).val (fun _ : Fin 0 => 0)=
      f.val.val (fun _ => 1) := sorry

def vanEstIso (n : ℕ) : (continuousCochains ρ).homology n ≃ₗ[ℂ]
    cohomology (D.finiteDimModule ρ hs) n := sorry

theorem vanEstIso_smoothing (n : ℕ)
    (f : (smoothCochains (E := realPoints.Model A) ρ).homology n) :
    vanEstIso D ρ hs n (((HomologicalComplex.homologyMap (smoothingInclusion (E := realPoints.Model A) ρ) n)).hom f)=
      (cohomologyEquivMathlib (D.finiteDimModule ρ hs) n).symm
        ((HomologicalComplex.homologyMap (vanEstDifferentiation D ρ hs) n).hom f) := sorry

/-- Cartan's quotient diffeomorphism; quotient charts and inverse are supplier obligations. -/
def quotient_maximalCompact_euclidean : Diffeomorph 𝓘(ℝ,D.symmetricModel) 𝓘(ℝ,D.symmetricModel) D.symmetricSpace D.symmetricModel ∞ := sorry

-- test: invariantForms_compact
example (hc : D.K=⊤) (n : ℕ) (hn : 0<n) : Subsingleton (invariantForm D ρ n) := sorry

-- test: invariantForms_vector_group: the corresponding general homogeneous-space
-- adapter specializes to the additive Euclidean group; its derivative is zero.
example (n : ℕ) :
    (EuclideanSpace ℝ (Fin n) [⋀^Fin 0]→L[ℝ] ℂ) ≃ₗ[ℂ] ℂ := sorry
end InvariantForms
