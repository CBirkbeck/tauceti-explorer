example (J : Subgroup (FiniteGroup ℚ)) (k : ℤ) (C : ℝ) (hC : 0<C) :
    ¬∃ f : HolomorphicForm ℚ J k, ∀ y : ℝ, 1≤y →
      ‖f.val.val.val (upperHalfPlaneSection ℚ
        (fun _ => UpperHalfPlane.ofComplex (y*Complex.I)),1)‖=Real.exp (C*y) := sorry
