def H1Coordinates (R : Type) [CommRing R] :
    cohomology N R 1 ≃ₗ[R] (Additive (Gamma N) →+ R) where
  toFun := (groupCohomology.H1IsoOfIsTrivial (coefficients N R)).hom
  invFun := (groupCohomology.H1IsoOfIsTrivial (coefficients N R)).inv
  left_inv := by sorry
  right_inv := by sorry
