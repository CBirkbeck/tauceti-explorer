namespace GLn
variable (F : Type) [Field F] [NumberField F] (n : ℕ)
abbrev rationalCoordinate := TauCeti.GeneralLinear.coordinateHopfAlgebra F n

def arithmeticDatum (F : Type) [Field F] [NumberField F] (n : ℕ) :
    Arithmetic.Datum F (rationalCoordinate F n) := sorry

abbrev infinityDatum (v : NumberField.InfinitePlace F) :=
  Arithmetic.archPlaceDatum F (rationalCoordinate F n) (arithmeticDatum F n) v

def realPlaceIso (v : NumberField.InfinitePlace F) (hv : v.IsReal) :
    Datum.Iso (infinityDatum F n v) (Datum.generalLinear n) := sorry

def complexPlaceIso (v : NumberField.InfinitePlace F) (hv : v.IsComplex) :
    Datum.Iso (infinityDatum F n v) (complexGLDatum n) := sorry

/-- LLC restriction to ℂ× uses inclusion for W_R and the identity for W_C. -/
def parameterAt (v : NumberField.InfinitePlace F)
    (M : IrrAdmissibleModel.{0} (infinityDatum F n v).pair) :
    WeilParameter.classes ℂˣ n := sorry

theorem parameterAt_real (v : NumberField.InfinitePlace F) (hv : v.IsReal)
    (M : IrrAdmissibleModel.{0} (infinityDatum F n v).pair)
    (p : WeilParameter WeilGroupReal n)
    (hp : Quotient.mk _ p=recGL n (Quotient.mk _ ((realPlaceIso F n v hv).push M))) :
    ∃ q : WeilParameter ℂˣ n, Quotient.mk _ q=parameterAt F n v M ∧
      ∀ z x, q.representation z x=p.representation (WeilGroupReal.inclusion z) x := sorry

theorem parameterAt_complex (v : NumberField.InfinitePlace F) (hv : v.IsComplex)
    (M : IrrAdmissibleModel.{0} (infinityDatum F n v).pair) :
    parameterAt F n v M=recGLComplex n (Quotient.mk _ ((complexPlaceIso F n v hv).push M)) := sorry

/-- Complex-place C-algebraicity uses each factor of the complexified real Cartan. -/
def complexSplitCoefficientDatum (n : ℕ) : SplitCoefficientDatum (complexGLDatum n) := sorry

def IsAlgebraicAt (v : NumberField.InfinitePlace F)
    (M : IrrAdmissibleModel.{0} (infinityDatum F n v).pair) : Prop :=
  (∀ hv : v.IsReal, IsCAlgebraic (splitCoefficientDatum n)
    (Quotient.mk _ ((realPlaceIso F n v hv).push M))) ∧
  (∀ hv : v.IsComplex, IsCAlgebraic (complexSplitCoefficientDatum n)
    (Quotient.mk _ ((complexPlaceIso F n v hv).push M)))

def IsRegularAt (v : NumberField.InfinitePlace F)
    (M : IrrAdmissibleModel.{0} (infinityDatum F n v).pair) : Prop :=
  (∀ hv : v.IsReal, ∃ lam : AlgebraicWeight (splitCoefficientDatum n),
    AlgebraicWeight.IsRegular (splitCoefficientDatum n) lam ∧
    IrrAdmissible.infChar (Datum.generalLinear n).pair
      (Quotient.mk _ ((realPlaceIso F n v hv).push M))=
        infCharOf (splitCoefficientDatum n).cartan
          ((splitCoefficientDatum n).differential lam+(splitCoefficientDatum n).cartan.rho)) ∧
  (∀ hv : v.IsComplex, ∃ lam : AlgebraicWeight (complexSplitCoefficientDatum n),
    AlgebraicWeight.IsRegular (complexSplitCoefficientDatum n) lam ∧
    IrrAdmissible.infChar (complexGLDatum n).pair
      (Quotient.mk _ ((complexPlaceIso F n v hv).push M))=
        infCharOf (complexSplitCoefficientDatum n).cartan
          ((complexSplitCoefficientDatum n).differential lam+(complexSplitCoefficientDatum n).cartan.rho))

/-- The common norm exponent is recorded independently of the angular integral weights. -/
def IsPureParameter (p : WeilParameter.classes ℂˣ n) (w : ℝ) : Prop :=
  ∃ (a : WeilParameter ℂˣ n) (m : Fin n → ℤ) (e : (Fin n → ℂ) ≃ₗ[ℂ] (Fin n → ℂ)),
    Quotient.mk _ a=p ∧ ∀ z x i,
      e (a.representation z x) i=
        ((WeilGroupReal.complexCharacter (m i) (w : ℂ) z : ℂ)*e x i)

/-- At a complex place the normalized absolute value is the squared complex norm. -/
def complexNormTwist (n : ℕ) (s : ℂ) : SmoothCharacter (complexGLDatum n) := sorry

theorem complexNormTwist_value (n : ℕ) (s : ℂ) (g : realPoints (ComplexGLCoordinate n)) :
    ((complexNormTwist n s).character g : ℂ)=Complex.exp
      (s*(Real.log (‖(Matrix.GeneralLinearGroup.det (ComplexGLPoints n g) : ℂ)‖^2) : ℂ)) := sorry
end GLn

/-- Clozel purity first unitarizes and then restores a common global determinant exponent. -/
theorem clozelPurity (F : Type) [Field F] [NumberField F] (n : ℕ) (hn : 0<n)
    (π : (GLn.arithmeticDatum F n).representationModel)
    (hcusp : IsCuspidalSubquotient (GLn.arithmeticDatum F n) π)
    (f : ArchFiniteFactorization (GLn.arithmeticDatum F n) π)
    (a : ArchFactorization (GLn.arithmeticDatum F n) f.arch)
    (halg : ∀ v, GLn.IsAlgebraicAt F n v (a.localFactor v)) :
    ∃ w : ℤ, ∀ v : NumberField.InfinitePlace F,
      GLn.IsPureParameter n (GLn.parameterAt F n v (a.localFactor v)) w ∧
      (∀ hv : v.IsReal,
        IsTemperedClass (Datum.generalLinear n) (IrrAdmissible.twist (Datum.generalLinear n)
          (GLn.normTwist n (-(w : ℂ)/2)) (Quotient.mk _ ((GLn.realPlaceIso F n v hv).push (a.localFactor v))))) ∧
      (∀ hv : v.IsComplex,
        IsTemperedClass (complexGLDatum n) (IrrAdmissible.twist (complexGLDatum n)
          (GLn.complexNormTwist n (-(w : ℂ)/2)) (Quotient.mk _ ((GLn.complexPlaceIso F n v hv).push (a.localFactor v))))) := sorry

/-- The named GL_n theorem gives a model over the rationality field itself. -/
theorem clozelRationality (F : Type) [Field F] [NumberField F] (n : ℕ) (hn : 0<n)
    (π : (GLn.arithmeticDatum F n).representationModel)
    (hcusp : IsCuspidalSubquotient (GLn.arithmeticDatum F n) π)
    (f : ArchFiniteFactorization (GLn.arithmeticDatum F n) π)
    (a : ArchFactorization (GLn.arithmeticDatum F n) f.arch)
    (halg : ∀ v, GLn.IsAlgebraicAt F n v (a.localFactor v))
    (hreg : ∀ v, GLn.IsRegularAt F n v (a.localFactor v)) :
    FiniteDimensional ℚ (rationalityField f.finite.action) ∧
      Nonempty (FieldModel (rationalityField f.finite.action) f.finite.action) := sorry
end TauCeti.Automorphic

namespace TauCeti.RealReductive
open TauCeti.RelativeLieCohomology
namespace ArchGL

def Scalar (complexPlace : Bool) : Type := if complexPlace then ℂ else ℝ
instance (c : Bool) : NormedField (Scalar c) := by cases c <;> dsimp [Scalar] <;> infer_instance
instance (c : Bool) : Algebra ℝ (Scalar c) := by cases c <;> dsimp [Scalar] <;> infer_instance
instance (c : Bool) : FiniteDimensional ℝ (Scalar c) := by
  cases c
  · exact Module.Finite.self ℝ
  · exact inferInstanceAs (FiniteDimensional ℝ ℂ)

def Coordinate (c : Bool) (n : ℕ) : Type := if c then ComplexGLCoordinate n else GLCoordinate n
instance (c : Bool) (n : ℕ) : CommRing (Coordinate c n) := by cases c <;> dsimp [Coordinate] <;> infer_instance
instance (c : Bool) (n : ℕ) : HopfAlgebra ℝ (Coordinate c n) := by cases c <;> dsimp [Coordinate] <;> infer_instance
instance (c : Bool) (n : ℕ) : Algebra.FiniteType ℝ (Coordinate c n) := by cases c <;> dsimp [Coordinate] <;> infer_instance
instance (c : Bool) (n : ℕ) : Algebra.Smooth ℝ (Coordinate c n) := by cases c <;> dsimp [Coordinate] <;> infer_instance

def datum (c : Bool) (n : ℕ) : Datum (Coordinate c n) := by
  cases c
  · exact Datum.generalLinear n
  · exact complexGLDatum n

def points (c : Bool) (n : ℕ) : realPoints (Coordinate c n) ≃*
    Matrix.GeneralLinearGroup (Fin n) (Scalar c) := by
  cases c
  · exact realPoints.GL n
  · exact ComplexGLPoints n

def realPart (c : Bool) : Scalar c →ₗ[ℝ] ℝ := by
  cases c
  · exact LinearMap.id
  · exact Complex.reLm

def upperUnipotent (c : Bool) (n : ℕ) : Subgroup (Matrix.GeneralLinearGroup (Fin n) (Scalar c)) where
  carrier := {g | (∀ i, (g : Matrix (Fin n) (Fin n) (Scalar c)) i i=1) ∧
    ∀ i j, j < i → (g : Matrix (Fin n) (Fin n) (Scalar c)) i j=0}
  one_mem' := by sorry
  mul_mem' := by sorry
  inv_mem' := by sorry

def whittakerCharacter (c : Bool) (n : ℕ) : upperUnipotent c n →* ℂˣ := sorry

theorem whittakerCharacter_value (c : Bool) (n : ℕ) (g : upperUnipotent c n) :
    (whittakerCharacter c n g : ℂ)=Complex.exp (2*Real.pi*Complex.I*
      (∑ i : Fin n, if h : i.val+1<n then
        (realPart c ((g.val : Matrix (Fin n) (Fin n) (Scalar c)) i ⟨i.val+1,h⟩) : ℂ)
        else 0)) := sorry

def globalization (c : Bool) (n : ℕ) (M : IrrAdmissibleModel.{0} (datum c n).pair) :
    SAFModuleCat (datum c n) :=
  (globalizationFunctor (datum c n)).obj
    ⟨⟨M.carrier,M.action.toGKModule⟩,M.action.admissible,M.action.finitelyGenerated⟩

def IsGeneric (c : Bool) (n : ℕ) (M : IrrAdmissibleModel.{0} (datum c n).pair) : Prop :=
  ∃ ell : (globalization c n M).S →L[ℂ] ℂ, ell≠0 ∧
    ∀ g : upperUnipotent c n, ∀ v,
      ell ((globalization c n M).representation.π ((points c n).symm g.val) v)=
        (whittakerCharacter c n g : ℂ)*ell v

/-- The blocks have an actual diagonal embedding and native dynamic parabolic. -/
structure BlockPartition (n b : ℕ) where
  size : Fin b → ℕ
  positive : ∀ j, j.val≠b/2 → 0<size j
  total : ∑ j, size j=n

def blockCocharacter (c : Bool) {n b : ℕ} (B : BlockPartition n b) :
    Coordinate c n →ₐc[ℝ] LaurentPolynomial ℝ := sorry

def blockLevi (c : Bool) {n b : ℕ} (B : BlockPartition n b) :
    LeviDatum (datum c n) (blockCocharacter c B) := sorry

def blockPoints (c : Bool) {n b : ℕ} (B : BlockPartition n b) :
    realPoints (blockLevi c B).coordinate ≃*
      (∀ j : Fin b, realPoints (Coordinate c (B.size j))) := sorry

instance blockProductLieRing (c : Bool) {n b : ℕ} (B : BlockPartition n b) :
    LieRing (∀ j : Fin b, complexAlgebraicLie (Coordinate c (B.size j))) where
  bracket X Y := fun j => ⁅X j,Y j⁆
  add_lie := by sorry
  lie_add := by sorry
  lie_self := by sorry
  leibniz_lie := by sorry
instance blockProductLieAlgebra (c : Bool) {n b : ℕ} (B : BlockPartition n b) :
    LieAlgebra ℂ (∀ j : Fin b, complexAlgebraicLie (Coordinate c (B.size j))) where
  lie_smul := by sorry

def blockLie (c : Bool) {n b : ℕ} (B : BlockPartition n b) :
    complexAlgebraicLie (blockLevi c B).coordinate ≃ₗ⁅ℂ⁆
      (∀ j : Fin b, complexAlgebraicLie (Coordinate c (B.size j))) := sorry

def blockCompact (c : Bool) {n b : ℕ} (B : BlockPartition n b) :
    (blockLevi c B).datum.K ≃* (∀ j : Fin b, (datum c (B.size j)).K) := sorry

/-- Normalized block induction takes the genuine tensor of the tempered block carriers. -/
def blockTensor (c : Bool) {n b : ℕ} (B : BlockPartition n b)
    (M : ∀ j : Fin b, IrrAdmissibleModel.{0} (datum c (B.size j)).pair) :
    HCModuleCat (blockLevi c B).datum.pair := sorry

def blockTensorCarrier (c : Bool) {n b : ℕ} (B : BlockPartition n b)
    (M : ∀ j : Fin b, IrrAdmissibleModel.{0} (datum c (B.size j)).pair) :
    (blockTensor c B M).obj.carrier ≃ₗ[ℂ] PiTensorProduct ℂ (fun j => (M j).carrier) := sorry

theorem blockTensor_lie (c : Bool) {n b : ℕ} (B : BlockPartition n b)
    (M : ∀ j : Fin b, IrrAdmissibleModel.{0} (datum c (B.size j)).pair)
    (X : complexAlgebraicLie (blockLevi c B).coordinate) (v : ∀ j, (M j).carrier) :
    blockTensorCarrier c B M ((blockTensor c B M).obj.action.rho X
      ((blockTensorCarrier c B M).symm (PiTensorProduct.tprod ℂ v)))=
        ∑ j : Fin b, PiTensorProduct.tprod ℂ
          (Function.update v j ((M j).action.rho (blockLie c B X j) (v j))) := sorry

theorem blockTensor_compact (c : Bool) {n b : ℕ} (B : BlockPartition n b)
    (M : ∀ j : Fin b, IrrAdmissibleModel.{0} (datum c (B.size j)).pair)
    (k : (blockLevi c B).datum.K) (v : ∀ j, (M j).carrier) :
    blockTensorCarrier c B M ((blockTensor c B M).obj.action.sigma k
      ((blockTensorCarrier c B M).symm (PiTensorProduct.tprod ℂ v)))=
        PiTensorProduct.tprod ℂ (fun j => (M j).action.sigma (blockCompact c B k j) (v j)) := sorry

structure GenericUnitaryData (c : Bool) (n t : ℕ) where
  partition : BlockPartition n (2*t+1)
  blocks : ∀ j : Fin (2*t+1), IrrAdmissibleModel.{0} (datum c (partition.size j)).pair
  tempered : ∀ j, IsTemperedClass (datum c (partition.size j)) (Quotient.mk _ (blocks j))
  generic : ∀ j, IsGeneric c (partition.size j) (blocks j)
  beta : Fin t → ℝ
  positive : ∀ j, 0<beta j ∧ beta j<1/2
  decreasing : ∀ i j, i<j → beta j<beta i
  mirrorSize : ∀ j : Fin (2*t+1), partition.size j=partition.size j.rev
  mirror : ∀ j : Fin (2*t+1),
    (IrrAdmissibleModel.isoSetoid (datum c (partition.size j.rev)).pair).r
      (cast (congrArg (fun d => IrrAdmissibleModel.{0} (datum c d).pair) (mirrorSize j)) (blocks j))
      (blocks j.rev)

def GenericUnitaryData.exponents {c : Bool} {n t : ℕ} (B : GenericUnitaryData c n t)
    (j : Fin (2*t+1)) : ℝ :=
  if h : j.val<t then B.beta ⟨j.val,h⟩ else
    if h : j.rev.val<t then -B.beta ⟨j.rev.val,h⟩ else 0

def blockExponent (c : Bool) {n b : ℕ} (B : BlockPartition n b) (exponent : Fin b → ℝ) :
    InducingCharacter (blockCocharacter c B) := sorry

/-- The inducing character is fixed by its determinant formula on each actual Levi block. -/
theorem blockExponent_onLevi (c : Bool) {n b : ℕ} (B : BlockPartition n b)
    (exponent : Fin b → ℝ) (g : realPoints (blockLevi c B).coordinate) :
    ((blockExponent c B exponent).character ⟨realPoints_map (blockLevi c B).inclusion g,by sorry⟩ : ℂ)=
      Complex.exp ((∑ j : Fin b, exponent j *
        (if c then 2 else 1) * Real.log ‖Matrix.det
          ((points c (B.size j) (blockPoints c B g j) :
            Matrix.GeneralLinearGroup (Fin (B.size j)) (Scalar c)) :
              Matrix (Fin (B.size j)) (Fin (B.size j)) (Scalar c))‖ : ℝ) : ℂ) := sorry

def GenericUnitaryData.induced {c : Bool} {n t : ℕ} (B : GenericUnitaryData c n t) :
    SAFModuleCat (datum c n) := normalizedInduction.ofLevi (datum c n) (blockLevi c B.partition)
      ((globalizationFunctor.{0} (blockLevi c B.partition).datum).obj (blockTensor.{0} c B.partition B.blocks))
      (blockExponent c B.partition B.exponents)
end ArchGL

/-- Jiang–Zhang (B.6): both directions are on genuine Whittaker and Hilbert models. -/
theorem voganGenericUnitary (c : Bool) (n : ℕ) (hn : 0<n)
    (M : IrrAdmissibleModel.{0} (ArchGL.datum c n).pair) :
    (Nonempty (UnitaryModel (ArchGL.datum c n) M) ∧ ArchGL.IsGeneric c n M) ↔
      ∃ (t : ℕ) (B : ArchGL.GenericUnitaryData c n t)
        (e : M.carrier ≃ₗ[ℂ] ((kFiniteFunctor (ArchGL.datum c n)).obj B.induced).obj.carrier),
        (∀ X v, e (M.action.rho X v)=
          ((kFiniteFunctor (ArchGL.datum c n)).obj B.induced).obj.action.rho X (e v)) ∧
        ∀ k v, e (M.action.sigma k v)=
          ((kFiniteFunctor (ArchGL.datum c n)).obj B.induced).obj.action.sigma k (e v) := sorry
end TauCeti.RealReductive

namespace TauCeti.Automorphic.Suppliers.ReductiveGroupsPartII
open TauCeti.RealReductive

def splitHermitianMatrix (n : ℕ) {R : Type} [CommRing R] : Matrix (Fin (2*n)) (Fin (2*n)) R :=
  Matrix.diagonal (fun i => if i.val<n then 1 else -1)

def complexConjugationTensor (R : Type) [CommRing R] [Algebra ℝ R] :
    (ℂ ⊗[ℝ] R) →ₐ[ℝ] (ℂ ⊗[ℝ] R) :=
  Algebra.TensorProduct.map Complex.conjAe.toAlgHom (AlgHom.id ℝ R)

theorem complexConjugationTensor_tmul (R : Type) [CommRing R] [Algebra ℝ R] (z : ℂ) (r : R) :
    complexConjugationTensor R (z ⊗ₜ[ℝ] r)=star z ⊗ₜ[ℝ] r := sorry

def splitUnitaryValueGroup (n : ℕ) (R : Type) [CommRing R] [Algebra ℝ R] :
    Subgroup (Matrix.GeneralLinearGroup (Fin (2*n)) (ℂ ⊗[ℝ] R)) where
  carrier := {g | ((g : Matrix (Fin (2*n)) (Fin (2*n)) (ℂ ⊗[ℝ] R)).map
    (complexConjugationTensor R)).transpose * splitHermitianMatrix n *
      (g : Matrix (Fin (2*n)) (Fin (2*n)) (ℂ ⊗[ℝ] R))=splitHermitianMatrix n}
  one_mem' := by sorry
  mul_mem' := by sorry
  inv_mem' := by sorry

/-- RG2 unitary Weil restriction is the above matrix functor, for every real algebra. -/
def SplitUnitaryCoordinate (n : ℕ) : Type := sorry
instance (n : ℕ) : CommRing (SplitUnitaryCoordinate n) := sorry
instance (n : ℕ) : HopfAlgebra ℝ (SplitUnitaryCoordinate n) := sorry
instance (n : ℕ) : Algebra.FiniteType ℝ (SplitUnitaryCoordinate n) := sorry
instance (n : ℕ) : Algebra.Smooth ℝ (SplitUnitaryCoordinate n) := sorry

def splitUnitaryUniversal (n : ℕ) (R : Type) [CommRing R] [Algebra ℝ R] :
    WithConv (SplitUnitaryCoordinate n →ₐ[ℝ] R) ≃* splitUnitaryValueGroup n R := sorry

def splitUnitaryMatrixGroup (n : ℕ) : Subgroup (Matrix.GeneralLinearGroup (Fin (2*n)) ℂ) where
  carrier := {g | Matrix.conjTranspose (g : Matrix (Fin (2*n)) (Fin (2*n)) ℂ)*
    splitHermitianMatrix n*(g : Matrix (Fin (2*n)) (Fin (2*n)) ℂ)=splitHermitianMatrix n}
  one_mem' := by sorry
  mul_mem' := by sorry
  inv_mem' := by sorry

def splitUnitaryPoints (n : ℕ) : realPoints (SplitUnitaryCoordinate n) ≃* splitUnitaryMatrixGroup n := sorry

def splitUnitaryDatum (n : ℕ) : Datum (SplitUnitaryCoordinate n) := sorry

theorem splitUnitaryDatum_cartan (n : ℕ) (g : realPoints (SplitUnitaryCoordinate n)) :
    ((splitUnitaryPoints n ((splitUnitaryDatum n).thetaPoints g)).val :
      Matrix (Fin (2*n)) (Fin (2*n)) ℂ)=
        Matrix.conjTranspose ((splitUnitaryPoints n g⁻¹).val :
          Matrix (Fin (2*n)) (Fin (2*n)) ℂ) := sorry
end TauCeti.Automorphic.Suppliers.ReductiveGroupsPartII

namespace TauCeti.Automorphic.ClassicalHolomorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
open Suppliers.ReductiveGroupsPartII

abbrev SpCoordinate (n : ℕ) := TauCeti.Symplectic.coordinateHopfAlgebra ℝ n

def spDatum (n : ℕ) : Datum (SpCoordinate n) := sorry

/-- The Sp datum uses the already implemented standard symplectic matrix functor. -/
theorem spDatum_compact (n : ℕ) (g : realPoints (SpCoordinate n)) :
    g∈(spDatum n).K ↔
      Matrix.transpose ((TauCeti.Symplectic.pointsMulEquiv ℝ n (A := ℝ) g).val :
        Matrix (Fin (n+n)) (Fin (n+n)) ℝ)*
      ((TauCeti.Symplectic.pointsMulEquiv ℝ n (A := ℝ) g).val :
        Matrix (Fin (n+n)) (Fin (n+n)) ℝ)=1 := sorry

def Coordinate (unitary : Bool) (n : ℕ) : Type :=
  if unitary then SplitUnitaryCoordinate n else SpCoordinate n
instance (u : Bool) (n : ℕ) : CommRing (Coordinate u n) := by cases u <;> dsimp [Coordinate] <;> infer_instance
instance (u : Bool) (n : ℕ) : HopfAlgebra ℝ (Coordinate u n) := by cases u <;> dsimp [Coordinate] <;> infer_instance
instance (u : Bool) (n : ℕ) : Algebra.FiniteType ℝ (Coordinate u n) := by cases u <;> dsimp [Coordinate] <;> infer_instance
instance (u : Bool) (n : ℕ) : Algebra.Smooth ℝ (Coordinate u n) := by cases u <;> dsimp [Coordinate] <;> infer_instance

def datum (u : Bool) (n : ℕ) : Datum (Coordinate u n) := by
  cases u
  · exact spDatum n
  · exact splitUnitaryDatum n

def compactCartan (u : Bool) (n : ℕ) : CompactCartan (datum u n) := sorry
abbrev rank (u : Bool) (n : ℕ) := if u then 2*n else n

def cartanCoordinates (u : Bool) (n : ℕ) : (compactCartan u n).roots.h ≃ₗ[ℂ] (Fin (rank u n) → ℂ) := sorry

def weight (u : Bool) (n : ℕ) (mu : Fin (rank u n) → ℂ) :
    Module.Dual ℂ (compactCartan u n).roots.h where
  toFun H := Complex.I*∑ i, mu i*cartanCoordinates u n H i
  map_add' := by sorry
  map_smul' := by sorry

def minimalWeight (u : Bool) (n k : ℕ) : Fin (rank u n) → ℂ :=
  fun i => if u = true ∧ n ≤ i.val then -(k : ℂ) else k

def parameter (u : Bool) (n k : ℕ) : Fin (rank u n) → ℂ :=
  fun i => if u then
    if i.val<n then (k : ℂ)-(i.val : ℂ)-1/2
    else (2*n : ℂ)-(i.val : ℂ)-1/2-k
  else (k : ℂ)-(i.val : ℂ)-1

/-- Determinants of the actual compact complex blocks specify the scalar K-character. -/
def compactCharacter (u : Bool) (n : ℕ) : (datum u n).K →* ℂˣ := sorry

def compactComplexBlockSp (n : ℕ) : (spDatum n).K →* Matrix.GeneralLinearGroup (Fin n) ℂ := sorry

def compactComplexBlocksUnitary (n : ℕ) : (splitUnitaryDatum n).K →*
    (Matrix.GeneralLinearGroup (Fin n) ℂ × Matrix.GeneralLinearGroup (Fin n) ℂ) := sorry

theorem compactCharacter_sp (n : ℕ) (g : (spDatum n).K) :
    (compactCharacter false n g : ℂ)=Matrix.det
      ((compactComplexBlockSp n g : Matrix.GeneralLinearGroup (Fin n) ℂ) : Matrix (Fin n) (Fin n) ℂ) := sorry

theorem compactCharacter_unitary (n : ℕ) (g : (splitUnitaryDatum n).K) :
    (compactCharacter true n g : ℂ)=Matrix.det
      (((compactComplexBlocksUnitary n g).1 : Matrix.GeneralLinearGroup (Fin n) ℂ) :
        Matrix (Fin n) (Fin n) ℂ) * (Matrix.det
      (((compactComplexBlocksUnitary n g).2 : Matrix.GeneralLinearGroup (Fin n) ℂ) :
        Matrix (Fin n) (Fin n) ℂ))⁻¹ := sorry

/-- Vogan's norm uses μ+2ρ_K in the standard compact torus coordinates. -/
def compactTypeNorm (u : Bool) (n : ℕ) (mu : Module.Dual ℂ (compactCartan u n).roots.h) : ℝ :=
  ∑ i : Fin (rank u n), ‖(mu+2 • (compactCartan u n).rhoCompact)
    ((cartanCoordinates u n).symm (Pi.single i 1))‖^2

def HasMinimalKType (u : Bool) (n k : ℕ)
    (M : IrrAdmissibleModel.{0} (datum u n).pair) : Prop :=
  (∃ v : M.carrier, v≠0 ∧ ∀ g : (datum u n).K,
    M.action.sigma g v=(compactCharacter u n g : ℂ)^k • v) ∧
  ∀ mu : Module.Dual ℂ (compactCartan u n).roots.h,
    (∃ v, HasCompactHighestWeight (compactCartan u n)
      (GKModule.restrict (datum u n).pair.identityComponentHom M.action.toGKModule) mu v) →
    compactTypeNorm u n (weight u n (minimalWeight u n k))≤compactTypeNorm u n mu
end TauCeti.Automorphic.ClassicalHolomorphic

namespace TauCeti.Automorphic
open TauCeti.RealReductive

/-- Scholze Proposition V.1.1; uniqueness is for the actual scalar minimal K-type. -/
theorem holomorphicDiscreteSeries_minimalKType (u : Bool) (n k : ℕ) (hn : 0<n)
    (hk : if u then n≤k else n<k) :
    ∃! π : IrrAdmissible.{0} (ClassicalHolomorphic.datum u n).pair,
      IsDiscreteSeriesClass (ClassicalHolomorphic.datum u n) π ∧
      (∃ M : IrrAdmissibleModel.{0} (ClassicalHolomorphic.datum u n).pair,
        Quotient.mk _ M=π ∧ ClassicalHolomorphic.HasMinimalKType u n k M) ∧
      IrrAdmissible.infChar (ClassicalHolomorphic.datum u n).pair π=
        infCharOf (ClassicalHolomorphic.compactCartan u n).roots
          (ClassicalHolomorphic.weight u n (ClassicalHolomorphic.parameter u n k)) := sorry
end TauCeti.Automorphic

