/-- A compact weight, extended trivially over the lowering direction. -/
def coefficient (m : ℤ) : Hermitian.HodgeCoefficient hermitian := sorry

theorem coefficient_dimension (m : ℤ) : (coefficient m).dimension=1 := sorry

def coefficientCoordinates (m : ℤ) : (Fin (coefficient m).dimension → ℂ) ≃ₗ[ℂ] ℂ := sorry

theorem coefficient_rotation (m : ℤ) (t : ℝ)
    (v : Fin (coefficient m).dimension → ℂ) :
    coefficientCoordinates m ((coefficient m).action.sigma
      ⟨TauCeti.RealReductive.SL2.rotation t,by sorry⟩ v)=
        Complex.exp (Complex.I*(m : ℂ)*(t : ℂ))*coefficientCoordinates m v := sorry

theorem coefficient_lie (m : ℤ) (X : Hermitian.fullHodgeParabolic hermitian)
    (v : Fin (coefficient m).dimension → ℂ) :
    coefficientCoordinates m ((coefficient m).action.rho X v)=
      (m : ℂ)*(Complex.I/2)*
        ((TauCeti.RealReductive.SL2.lieMatrices X.val).val 0 1-
          (TauCeti.RealReductive.SL2.lieMatrices X.val).val 1 0)*coefficientCoordinates m v := sorry

/-- SL₂ has no split centre to balance. -/
theorem tensorBalanced {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : GKModule D.pair.identityComponent V) (m : ℤ) :
    Hermitian.TensorBalanced hermitian M (coefficient m) := sorry

