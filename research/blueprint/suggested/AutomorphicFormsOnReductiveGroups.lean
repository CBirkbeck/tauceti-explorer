      (cartanCoordinates X).1 (cartanCoordinates X).2.1 (cartanCoordinates X).2.2 := sorry

def parameter (lambda : ℝ × ℝ × ℝ) : Module.Dual ℂ cartan.h where
  toFun X := Complex.I*(lambda.1 : ℂ)*(cartanCoordinates X).1+
    Complex.I*(lambda.2.1 : ℂ)*(cartanCoordinates X).2.1+
    (lambda.2.2 : ℂ)*(cartanCoordinates X).2.2
  map_add' := by sorry
  map_smul' := by sorry

def compactRootCoordinates : Finset (ℤ × ℤ × ℤ) := {(1,-1,0),(-1,1,0)}
def plusRootCoordinates : Finset (ℤ × ℤ × ℤ) := {(2,0,0),(0,2,0),(1,1,0)}
