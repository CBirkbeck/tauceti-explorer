section VoganZuckermanHodge
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A) (T : HermitianDatum D) (C : FundamentalCartan D)

def hermitianPlus : Submodule ℂ (complexAlgebraicLie A) :=
  Submodule.comap (balancedProjection (A := A)).toLinearMap T.pPlus.toSubmodule

def hermitianMinus : Submodule ℂ (complexAlgebraicLie A) :=
  Submodule.comap (balancedProjection (A := A)).toLinearMap T.pMinus.toSubmodule

/-- A pure cochain vanishes on every plus/minus argument pattern with the
wrong number of holomorphic arguments. The definition uses the actual J-eigenspaces. -/
def hodgeCochains {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : GKModule D.pair V) (p q : ℕ) : Submodule ℂ (cochains M (p+q)) where
  carrier := {w | ∀ eps : Fin (p+q) → Bool, ∀ X : Fin (p+q) → complexAlgebraicLie A,
    (∀ i, X i∈if eps i then hermitianPlus D T else hermitianMinus D T) →
    (Finset.univ.filter (fun i => eps i=true)).card≠p → w.val X=0}
  zero_mem' := by sorry
  add_mem' := by sorry
  smul_mem' := by sorry

def hodgeClasses {V : Type} [AddCommGroup V] [Module ℂ V]
    (M : GKModule D.pair V) (p q : ℕ) : Submodule ℂ (cohomology M (p+q)) :=
  Submodule.map (classOf M (p+q))
    (Submodule.comap (LinearMap.ker (differential M (p+q))).subtype (hodgeCochains D T M p q))

def ThetaStableData.Rplus (S : ThetaStableData D C) : ℕ :=
  Module.finrank ℂ ↥(S.radical.toSubmodule ⊓ hermitianPlus D T)

def ThetaStableData.Rminus (S : ThetaStableData D C) : ℕ :=
  Module.finrank ℂ ↥(S.radical.toSubmodule ⊓ hermitianMinus D T)

/-- The Hermitian formula uses compact centre, so no split-central exterior
factor is silently assigned a holomorphic degree. The balanced quotient is the
corresponding statement for reductive groups with a noncompact split centre. -/
theorem voganZuckerman_hodge (hconn : ConnectedSpace (realPoints A))
    (hcentre : realSplitCentre (A := A)=⊥)
    (S : ThetaStableData D C) (lam : S.Parameter) (F : AlgebraicCoefficient (A := A))
    (hF : IsIrreducibleGK (F.action (D := D)))
    (hw : ∃ v, IsCartanHighestWeight S.adaptedCartan (F.action (D := D)) (S.weight lam) v) :
    (∀ i : ℕ, Nonempty
      ((hodgeClasses D T (GKModule.tensorFinite D.pair (S.induced lam).action.toGKModule
        (F.dual.action (D := D))) (i+ThetaStableData.Rplus (D := D) (T := T) (C := C) S) (i+ThetaStableData.Rminus (D := D) (T := T) (C := C) S)) ≃ₗ[ℂ]
          S.alternatingInvariants (2*i))) ∧
    ∀ p q : ℕ, (p : ℤ)-(q : ℤ)≠(ThetaStableData.Rplus (D := D) (T := T) (C := C) S : ℤ)-(ThetaStableData.Rminus (D := D) (T := T) (C := C) S : ℤ) →
      Subsingleton (hodgeClasses D T (GKModule.tensorFinite D.pair (S.induced lam).action.toGKModule
        (F.dual.action (D := D))) p q) := sorry
end VoganZuckermanHodge
end TauCeti.Automorphic

namespace TauCeti.RealReductive.ArchGL
/-- The ordered block coordinates have their standard cumulative matrix indices. -/
def blockIndex {n b : ℕ} (B : BlockPartition n b) :
    (Σ j : Fin b, Fin (B.size j)) ≃ Fin n := sorry

theorem blockIndex_value {n b : ℕ} (B : BlockPartition n b)
    (j : Fin b) (i : Fin (B.size j)) :
    (blockIndex B ⟨j,i⟩).val=(∑ k∈Finset.univ.filter (fun k : Fin b => k<j), B.size k)+i.val := sorry

theorem blockCocharacter_matrix (c : Bool) {n b : ℕ} (B : BlockPartition n b)
    (t : ℝˣ) (j k : Fin b) (i : Fin (B.size j)) (l : Fin (B.size k)) :
    ((points c n (TauCeti.Cocharacter.pointsHom ℝ (blockCocharacter c B) t) :
      Matrix.GeneralLinearGroup (Fin n) (Scalar c)) : Matrix (Fin n) (Fin n) (Scalar c))
      (blockIndex B ⟨j,i⟩) (blockIndex B ⟨k,l⟩)=
      if blockIndex B ⟨j,i⟩=blockIndex B ⟨k,l⟩ then
        algebraMap ℝ (Scalar c) ((t : ℝ)^((b : ℤ)-1-2*(j.val : ℤ))) else 0 := sorry

theorem blockPoints_matrix (c : Bool) {n b : ℕ} (B : BlockPartition n b)
    (g : realPoints (blockLevi c B).coordinate)
    (j k : Fin b) (i : Fin (B.size j)) (l : Fin (B.size k)) :
    ((points c n (realPoints_map (blockLevi c B).inclusion g) : Matrix.GeneralLinearGroup (Fin n) (Scalar c)) :
      Matrix (Fin n) (Fin n) (Scalar c)) (blockIndex B ⟨j,i⟩) (blockIndex B ⟨k,l⟩)=
      if h : j=k then
        ((points c (B.size j) (blockPoints c B g j) : Matrix.GeneralLinearGroup (Fin (B.size j)) (Scalar c)) :
          Matrix (Fin (B.size j)) (Fin (B.size j)) (Scalar c)) i (cast (by subst k; rfl) l)
      else 0 := sorry
end TauCeti.RealReductive.ArchGL

namespace TauCeti.Automorphic.GSp2g
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
open TauCeti.Automorphic.Suppliers.ReductiveGroupsPartII

/-- The unitary normalization cancels the inverse coefficient central character:
ν(aI)=a², so the determinant exponent is κ_c/2. -/
def unitarizingTwist (n : ℕ) (κ : Weight n) : SmoothCharacter (D n) := sorry

theorem unitarizingTwist_value (n : ℕ) (κ : Weight n) (g : realPoints (GSpCoordinate n)) :
    ((unitarizingTwist n κ).character g : ℂ)=
      Complex.exp (((κ.2 : ℂ)/2)*(Real.log |(multiplier n g : ℝ)| : ℂ)) := sorry

/-- The constructor is a genuine discrete or nondegenerate limit class after
its specified central normalization, not merely a module with that central character.
The chamber has positive roots w(Φ⁺); the compact-dominant parameter is
−w_M(κ+ρ), whereas −w⁻¹w_M(κ+ρ) labels the same Weyl-invariant infinitesimal character. -/
theorem limitModel_discreteSeries (n : ℕ) (hn : 0<n) (κ : Weight n)
    (hi : Integral n κ) (hd : LeviDominant n κ)
    (w : (compactCartan n).roots.R.weylGroup) (hw : w∈Ckappa n κ) :
    ∃ (C : CompactCartan (D n)) (hC : C.roots.h=(compactCartan n).roots.h)
      (p : DiscreteSeriesParameter C) (hnd : p.NonDegenerate),
      identityTwist (D n) (unitarizingTwist n κ)
        (Quotient.mk _ (limitModel n hn κ hi hd w hw))=
          identityDiscreteSeries (D n) C p hnd ∧
      (∀ H : (compactCartan n).roots.h,
        p.lambda ⟨H.val,by rw [hC]; exact H.property⟩=
          (-(longestLevi n • (compactWeight n κ+(compactCartan n).roots.rho))) H+
            (κ.2 : ℂ)*(compactCoordinates n H).2) ∧
      ∀ alpha : (compactCartan n).roots.rootIndex,
        (∃ beta : C.roots.rootIndex, C.roots.b.IsPos beta ∧
          ∀ H : (compactCartan n).roots.h,
            C.roots.R.root beta ⟨H.val,by rw [hC]; exact H.property⟩=
              (compactCartan n).roots.R.root alpha H) ↔
        ∃ beta : (compactCartan n).roots.rootIndex,
          (compactCartan n).roots.b.IsPos beta ∧
            w • (compactCartan n).roots.R.root beta=(compactCartan n).roots.R.root alpha := sorry
end TauCeti.Automorphic.GSp2g

/-! AA.3 owns the adelic height and its analytic estimates. These equations
specify the height used by the AF signatures on the actual local point functors. -/
namespace TauCeti.Automorphic.Arithmetic
open WithConv TauCeti.RealReductive
variable {F : Type} [Field F] [NumberField F] {H : Type} [CommRing H]
  [HopfAlgebra F H] [Algebra.FiniteType F H]

def Embedding.points (e : Embedding F H) (R : Type) [CommRing R] [Algebra F R] :
    WithConv (H →ₐ[F] R) →* Matrix.GeneralLinearGroup (Fin e.dimension) R := sorry

theorem Embedding.points_value (e : Embedding F H) (R : Type) [CommRing R] [Algebra F R]
    (g : WithConv (H →ₐ[F] R)) : e.points R g=
      TauCeti.GeneralLinear.pointsMulEquiv e.dimension
        (toConv (g.ofConv.comp e.coordinates.toAlgHom)) := sorry

/-- Archimedean evaluation is the component of the actual infinite adelic point. -/
def Embedding.archPoint (e : Embedding F H) (v : NumberField.InfinitePlace F)
    (g : realPoints (ArchCoordinate F H)) : WithConv (H →ₐ[F] v.Completion) := sorry

theorem Embedding.archPoint_value (e : Embedding F H) (v : NumberField.InfinitePlace F)
    (g : realPoints (ArchCoordinate F H)) (h : H) :
    (e.archPoint v g).ofConv h=(archPoints F H g).ofConv h v := sorry

/-- The row-sum operator bound and its inverse control both ends of GL_n. -/
def matrixArchHeight {R : Type} [NormedField R] {n : ℕ}
    (g : Matrix.GeneralLinearGroup (Fin n) R) : ℝ :=
  max 1 (max (sSup (Set.range (fun i : Fin n => ∑ j : Fin n, ‖(g : Matrix (Fin n) (Fin n) R) i j‖)))
    (sSup (Set.range (fun i : Fin n => ∑ j : Fin n, ‖(g⁻¹ : Matrix.GeneralLinearGroup (Fin n) R).val i j‖))))

/-- At a finite place the ultrametric max norm is already submultiplicative. -/
def matrixFiniteHeight {R : Type} [NormedField R] {n : ℕ}
    (g : Matrix.GeneralLinearGroup (Fin n) R) : ℝ :=
  max 1 (max (sSup (Set.range (fun ij : Fin n × Fin n => ‖(g : Matrix (Fin n) (Fin n) R) ij.1 ij.2‖)))
    (sSup (Set.range (fun ij : Fin n × Fin n => ‖(g⁻¹ : Matrix.GeneralLinearGroup (Fin n) R).val ij.1 ij.2‖))))

def Embedding.archHeight (e : Embedding F H) (v : NumberField.InfinitePlace F)
    (g : realPoints (ArchCoordinate F H)) : ℝ :=
  matrixArchHeight (e.points v.Completion (e.archPoint v g))^v.mult

def Embedding.finiteHeight (e : Embedding F H) (v : FinitePlaceIndex F)
    (g : FinitePoints F H) : ℝ :=
  matrixFiniteHeight (e.points (v.adicCompletion F) (localProjection F H v g))

theorem Embedding.finiteHeight_support (e : Embedding F H) (g : FinitePoints F H) :
    {v : FinitePlaceIndex F | e.finiteHeight v g≠1}.Finite := sorry

theorem Embedding.height_local (e : Embedding F H)
    (g : realPoints (ArchCoordinate F H) × FinitePoints F H) :
    e.height F H g=(∏ v : NumberField.InfinitePlace F, e.archHeight v g.1)*
      (∏ᶠ v : FinitePlaceIndex F, e.finiteHeight v g.2) := sorry
end TauCeti.Automorphic.Arithmetic

