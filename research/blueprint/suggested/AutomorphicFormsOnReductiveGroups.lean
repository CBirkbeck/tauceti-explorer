/-! These AA.1/RG2.0 supplier adapters specify existing proposed exports. They
are not additional AF targets. Their proof status stays in the AA/Weil-restriction gap. -/
namespace TauCeti.Automorphic.Arithmetic
open TauCeti.RealReductive
variable (F : Type) [Field F] [NumberField F]
  (H : Type) [CommRing H] [HopfAlgebra F H] [Algebra.FiniteType F H]

abbrev RationalPoints := WithConv (H →ₐ[F] F)
abbrev AdelicPoints := WithConv (H →ₐ[F] NumberField.AdeleRing (NumberField.RingOfIntegers F) F)
abbrev FinitePoints := WithConv (H →ₐ[F]
  IsDedekindDomain.FiniteAdeleRing (NumberField.RingOfIntegers F) F)
abbrev InfinitePoints := WithConv (H →ₐ[F] NumberField.InfiniteAdeleRing F)

instance : TopologicalSpace (FinitePoints F H) :=
  TopologicalSpace.induced (fun g a => g.ofConv a) inferInstance
instance : IsTopologicalGroup (FinitePoints F H) := sorry
instance : LocallyCompactSpace (FinitePoints F H) := sorry
instance : T2Space (FinitePoints F H) := sorry
instance : TotallyDisconnectedSpace (FinitePoints F H) := sorry
instance : SecondCountableTopology (FinitePoints F H) := sorry

instance : TopologicalSpace (InfinitePoints F H) :=
  TopologicalSpace.induced (fun g a => g.ofConv a) inferInstance

/-- The Weil restriction from the archimedean value algebra, represented as a real Hopf algebra. -/
instance finitePointsMeasurable : MeasurableSpace (FinitePoints F H) := borel _
instance finitePointsBorel : BorelSpace (FinitePoints F H) := ⟨rfl⟩

def ArchCoordinate (F : Type) [Field F] [NumberField F]
    (H : Type) [CommRing H] [HopfAlgebra F H] [Algebra.FiniteType F H] : Type := sorry
instance : CommRing (ArchCoordinate F H) := sorry
instance : HopfAlgebra ℝ (ArchCoordinate F H) := sorry
instance : Algebra.FiniteType ℝ (ArchCoordinate F H) := sorry
instance [Algebra.Smooth F H] : Algebra.Smooth ℝ (ArchCoordinate F H) := sorry

/-- AA.0's real scalar structure is transported through the native mixed-space ring map. -/
instance infiniteAdeleRealAlgebra : Algebra ℝ (NumberField.InfiniteAdeleRing F) :=
  ((NumberField.InfiniteAdeleRing.ringEquiv_mixedSpace F).symm.toRingHom.comp
    (algebraMap ℝ (NumberField.mixedEmbedding.mixedSpace F))).toAlgebra

/-- Base-change values in its universal property are genuine tensor algebras. -/
abbrev ArchValue (R : Type) [CommRing R] [Algebra ℝ R] :=
  NumberField.InfiniteAdeleRing F ⊗[ℝ] R
instance (R : Type) [CommRing R] [Algebra ℝ R] : Algebra F (ArchValue F R) := sorry

def archValueInclusion (R : Type) [CommRing R] [Algebra ℝ R] :
    NumberField.InfiniteAdeleRing F →ₐ[F] ArchValue F R := sorry

theorem archValueInclusion_apply (R : Type) [CommRing R] [Algebra ℝ R]
    (a : NumberField.InfiniteAdeleRing F) : archValueInclusion F R a=a ⊗ₜ[ℝ] (1 : R) := sorry

/-- The representing construction is characterized on every real value algebra. -/
def archCoordinateUniversal (R : Type) [CommRing R] [Algebra ℝ R] :
    WithConv (ArchCoordinate F H →ₐ[ℝ] R) ≃*
      WithConv (H →ₐ[F] ArchValue F R) := sorry

def archPoints : realPoints (ArchCoordinate F H) ≃* InfinitePoints F H := sorry

theorem archPoints_universal (g : realPoints (ArchCoordinate F H)) :
    archCoordinateUniversal F H ℝ g=
      WithConv.toConv ((archValueInclusion F ℝ).comp ((archPoints F H g).ofConv)) := sorry

theorem archPoints_continuous : Continuous (archPoints F H) ∧
    Continuous (archPoints F H).symm := sorry

def diagonalInfinite : RationalPoints F H →* InfinitePoints F H :=
  TauCeti.AlgHom.mapValue (Algebra.ofId F _)

def diagonalFinite : RationalPoints F H →* FinitePoints F H :=
  TauCeti.AlgHom.mapValue (Algebra.ofId F _)

def diagonal : RationalPoints F H →* (realPoints (ArchCoordinate F H) × FinitePoints F H) :=
  ((archPoints F H).symm.toMonoidHom.comp (diagonalInfinite F H)).prod (diagonalFinite F H)

/-- Rational invariance always means this diagonal, never an arbitrary subgroup. -/
def rationalSubgroup : Subgroup (realPoints (ArchCoordinate F H) × FinitePoints F H) :=
  (diagonal F H).range

/-- The finite and infinite algebra projections give the canonical point decomposition. -/
def adelicSplit : AdelicPoints F H ≃*
    (realPoints (ArchCoordinate F H) × FinitePoints F H) := sorry

theorem adelicSplit_finite (g : AdelicPoints F H) :
    (adelicSplit F H g).2=TauCeti.AlgHom.mapValue (AlgHom.snd F _ _) g := sorry

theorem adelicSplit_infinite (g : AdelicPoints F H) :
    archPoints F H (adelicSplit F H g).1=TauCeti.AlgHom.mapValue (AlgHom.fst F _ _) g := sorry

/-- A closed algebraic matrix immersion, carrying the same AA.3 height conventions. -/
structure Embedding where
  dimension : ℕ
  coordinates : (TauCeti.GeneralLinear.coordinateHopfAlgebra F dimension) →ₐc[F] H
  surjective : Function.Surjective coordinates

/-- AA.3's proper dual-augmented height. Local factors are defined below. -/
def Embedding.height (e : Embedding F H) :
    realPoints (ArchCoordinate F H) × FinitePoints F H → ℝ := sorry

theorem Embedding.height_one (e : Embedding F H) (g) : 1≤e.height F H g := sorry

theorem Embedding.height_continuous (e : Embedding F H) : Continuous (e.height F H) := sorry

theorem Embedding.height_mul (e : Embedding F H) (g h) :
    e.height F H (g*h)≤e.height F H g*e.height F H h := sorry

/-- The arithmetic datum contains only a Cartan choice and a faithful height embedding. -/
structure Datum [Algebra.Smooth F H] where
  reductive : TauCeti.reductiveCommHopfAlgProperty F
    (TauCeti.FiniteTypeCommHopfAlgCat.of F H)
  realDatum : TauCeti.RealReductive.Datum (ArchCoordinate F H)
  embedding : Embedding F H
end TauCeti.Automorphic.Arithmetic

namespace TauCeti.Automorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
section ArithmeticAutomorphicInterfaces
variable {F : Type} [Field F] [NumberField F] {H : Type} [CommRing H]
  [HopfAlgebra F H] [Algebra.FiniteType F H] [Algebra.Smooth F H]
  (D : Arithmetic.Datum F H)
local notation "A" => Arithmetic.ArchCoordinate F H
local notation "FinG" => Arithmetic.FinitePoints F H
local notation "G" => realPoints A × FinG
local notation "I" => 𝓘(ℝ,realPoints.Model A)
local notation "Z" => Subalgebra.center ℂ (UniversalEnvelopingAlgebra ℂ (TauCeti.ComplexGroupLie I (realPoints A)))
local notation "Γ" => Arithmetic.rationalSubgroup F H
local notation "ht" => D.embedding.height F H

abbrev Arithmetic.Datum.forms := AutomorphicForm I D.realDatum.K.subtype ht Γ
abbrev Arithmetic.Datum.smoothForms := SmoothAutomorphicForm I ht Γ

/-- This is the common-exponent conclusion for the genuine arithmetic diagonal. -/
theorem AutomorphicForm.mem_uniformModerateGrowth (f : D.forms) :
    ∃ N : ℕ, f.val ∈ UniformModerateGrowth I ht Γ N := sorry

/-- The source finiteness theorem retains finite level, K types and central codimension. -/
theorem AutomorphicForm.finiteDimensional_fixedType
    (Jf : Subgroup FinG) (hopen : IsOpen (Jf : Set FinG)) (hcompact : IsCompact (Jf : Set FinG))
    (J : Ideal Z) (hJ : FiniteDimensional ℂ (Z ⧸ J))
    {m : ℕ} (types : Fin m → Σ n : ℕ, Representation ℂ D.realDatum.K (Fin n → ℂ)) :
    FiniteDimensional ℂ (AutomorphicForm.fixedType I D.realDatum.K.subtype ht Γ Jf J types) := sorry

/-- K-finiteness is checked on the actual right action, through the underlying smooth function. -/
theorem SmoothAutomorphicForm.kFinite_eq (f : D.smoothForms) :
    f.val.val ∈ kFinite (K := D.realDatum.K)
      (rightKAction (Gf := FinG) I D.realDatum.K.subtype) ↔ f.val.val ∈ D.forms := sorry

/-- The fixed finite level and central ideal have a canonical Fréchet realization. -/
def SmoothAutomorphicForm.level (Jf : Subgroup FinG) (J : Ideal Z) :
    Submodule ℂ D.smoothForms where
  carrier := {f | (∀ g (j : Jf), f.val.val.val (g*(1,j.val))=f.val.val.val g) ∧
    ∀ z : Z, z∈J → SmoothAdelicFunction.envelopingAction I z.val f.val.val=0}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

def SmoothAutomorphicForm.globalization (Jf : Subgroup FinG)
    (hopen : IsOpen (Jf : Set FinG)) (hcompact : IsCompact (Jf : Set FinG))
    (J : Ideal Z) (hJ : FiniteDimensional ℂ (Z ⧸ J)) : SAFModuleCat D.realDatum := sorry

def SmoothAutomorphicForm.globalizationCarrier (Jf : Subgroup FinG)
    (hopen : IsOpen (Jf : Set FinG)) (hcompact : IsCompact (Jf : Set FinG))
    (J : Ideal Z) (hJ : FiniteDimensional ℂ (Z ⧸ J)) :
    (SmoothAutomorphicForm.globalization D Jf hopen hcompact J hJ).S ≃L[ℂ]
      SmoothAutomorphicForm.level D Jf J := sorry

theorem SmoothAutomorphicForm.globalization_action (Jf : Subgroup FinG)
    (hopen : IsOpen (Jf : Set FinG)) (hcompact : IsCompact (Jf : Set FinG))
    (J : Ideal Z) (hJ : FiniteDimensional ℂ (Z ⧸ J))
    (g : realPoints A) (v : (SmoothAutomorphicForm.globalization D Jf hopen hcompact J hJ).S)
    (x : G) :
    (SmoothAutomorphicForm.globalizationCarrier D Jf hopen hcompact J hJ
      ((SmoothAutomorphicForm.globalization D Jf hopen hcompact J hJ).representation.π g v)).val.val.val.val x=
      (SmoothAutomorphicForm.globalizationCarrier D Jf hopen hcompact J hJ v).val.val.val.val (x*(g,1)) := sorry

/-- Central translates of an automorphic form span a finite-dimensional space. -/
theorem centralTranslationFinite (f : D.forms) :
    FiniteDimensional ℂ (Submodule.span ℂ (Set.range
      (fun z : Subgroup.center G => fun x : G => f.val.val (x*z.val)))) := sorry

-- test: smoothAutomorphic_kfinite_compat
example (f : D.smoothForms) :
    f.val.val ∈ D.forms ↔ f.val.val ∈ kFinite (K := D.realDatum.K)
      (rightKAction (Gf := FinG) I D.realDatum.K.subtype) := sorry
end ArithmeticAutomorphicInterfaces
end TauCeti.Automorphic

namespace TauCeti.Automorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
section ArithmeticRepresentationInterfaces
variable {F : Type} [Field F] [NumberField F] {H : Type} [CommRing H]
  [HopfAlgebra F H] [Algebra.FiniteType F H] [Algebra.Smooth F H]
  (D : Arithmetic.Datum F H)
local notation "A" => Arithmetic.ArchCoordinate F H
local notation "FinG" => Arithmetic.FinitePoints F H
local notation "G" => realPoints A × FinG
local notation "I" => 𝓘(ℝ,realPoints.Model A)
local notation "P" => D.realDatum.pair
local notation "Γ" => Arithmetic.rationalSubgroup F H
local notation "ht" => D.embedding.height F H

def Arithmetic.Datum.functionAction : AutomorphicFunctionAction P D.realDatum.K.subtype ht Γ
    D.realDatum.complexLieTangent := sorry

abbrev Arithmetic.Datum.representationModel := AutomorphicRepresentationModel.{0} P
  D.realDatum.K.subtype ht Γ D.realDatum.complexLieTangent D.functionAction
abbrev Arithmetic.Datum.representations := AutomorphicRepresentation.{0} P
  D.realDatum.K.subtype ht Γ D.realDatum.complexLieTangent D.functionAction

theorem AutomorphicForm.heckeAction_compat (dg : Measure FinG) [dg.IsHaarMeasure]
    (J : Subgroup FinG) (hopen : IsOpen (J : Set FinG)) (hcompact : IsCompact (J : Set FinG))
    (a : FinG) {m : ℕ} (r : Fin m → FinG)
    (hcosets : ∀ y, y∈DoubleCoset.doubleCoset a (J : Set FinG) (J : Set FinG) ↔
      ∃ i, y∈(r i) • (J : Set FinG))
    (hdisjoint : Pairwise (fun i j => Disjoint ((r i) • (J : Set FinG)) ((r j) • (J : Set FinG))))
    (f : D.forms) (hlevel : ∀ g (j : J), f.val.val (g*(1,j.val))=f.val.val g) (g : G) :
    (∫ y : FinG, (Set.indicator (DoubleCoset.doubleCoset a (J : Set FinG) (J : Set FinG))
      (fun _ => (1 : ℂ)) y)*f.val.val (g*(1,y)) ∂dg)=
      (dg (J : Set FinG)).toReal*∑ i, f.val.val (g*(1,r i)) := sorry

theorem AutomorphicRepresentation.multiplicity_finite (π : D.representations) :
    AutomorphicRepresentation.multiplicity P D.realDatum.K.subtype ht Γ
      D.realDatum.complexLieTangent D.functionAction π<⊤ := sorry

theorem AutomorphicRepresentationModel.hom_finite (π : D.representationModel) :
    FiniteDimensional ℂ (AutomorphicRepresentationModel.homSpace P D.realDatum.K.subtype
      ht Γ D.realDatum.complexLieTangent D.functionAction π) := sorry

/-- Actual fixed-level vectors, including the finite action rather than a formal local factor. -/
def AutomorphicRepresentation.fixedLevel (π : D.representationModel) (J : Subgroup FinG) :
    Submodule ℂ π.carrier where
  carrier := {v | ∀ j : J, π.action.finiteAction j v=v}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

/-- Casselman–Wallach applied to each finite-level Harish-Chandra carrier. -/
def AutomorphicRepresentation.smooth (π : D.representationModel) (J : Subgroup FinG)
    (hopen : IsOpen (J : Set FinG)) (hcompact : IsCompact (J : Set FinG)) :
    SAFModuleCat D.realDatum := sorry

def AutomorphicRepresentation.smoothKFinite (π : D.representationModel) (J : Subgroup FinG)
    (hopen : IsOpen (J : Set FinG)) (hcompact : IsCompact (J : Set FinG)) :
    ((kFiniteFunctor D.realDatum).obj (AutomorphicRepresentation.smooth D π J hopen hcompact)).obj.carrier
      ≃ₗ[ℂ] AutomorphicRepresentation.fixedLevel D π J := sorry

def AutomorphicRepresentation.centralCharacter (π : D.representationModel) :
    Subgroup.center G →* ℂˣ := sorry

theorem AutomorphicRepresentation.centralCharacter_continuous (π : D.representationModel) :
    Continuous (AutomorphicRepresentation.centralCharacter D π) := sorry

theorem AutomorphicRepresentation.centralCharacter_rational (π : D.representationModel)
    (z : Subgroup.center G) (hz : z.val∈Γ) :
    AutomorphicRepresentation.centralCharacter D π z=1 := sorry

/-- Central elements preserve every finite level and act on its actual globalization. -/
def AutomorphicRepresentation.smoothCentre (π : D.representationModel) (J : Subgroup FinG)
    (hopen : IsOpen (J : Set FinG)) (hcompact : IsCompact (J : Set FinG)) :
    Representation ℂ (Subgroup.center G) (AutomorphicRepresentation.smooth D π J hopen hcompact).S := sorry

theorem AutomorphicRepresentation.centralCharacter_scalar (π : D.representationModel)
    (J : Subgroup FinG) (hopen : IsOpen (J : Set FinG)) (hcompact : IsCompact (J : Set FinG))
    (z : Subgroup.center G) (v : (AutomorphicRepresentation.smooth D π J hopen hcompact).S) :
    AutomorphicRepresentation.smoothCentre D π J hopen hcompact z v=
      (AutomorphicRepresentation.centralCharacter D π z : ℂ) • v := sorry

/-- Twisting characters live on the arithmetic quotient and themselves satisfy the scalar form conditions. -/
structure Arithmetic.Character (D : Arithmetic.Datum F H) where
  character : G →* ℂˣ
  continuous : Continuous character
  form : D.forms
  agrees : ∀ g, form.val.val g=(character g : ℂ)

/-- Multiplication by χ on automorphic functions transports actual subquotients. -/
def AutomorphicRepresentation.twist (π : D.representationModel) (χ : Arithmetic.Character D) :
    D.representationModel := sorry

def AutomorphicRepresentation.twistCarrier (π : D.representationModel) (χ : Arithmetic.Character D) :
    (AutomorphicRepresentation.twist D π χ).carrier ≃ₗ[ℂ] π.carrier := sorry

theorem AutomorphicRepresentation.twist_finite (π : D.representationModel) (χ : Arithmetic.Character D)
    (g : FinG) (v : (AutomorphicRepresentation.twist D π χ).carrier) :
    AutomorphicRepresentation.twistCarrier D π χ
      ((AutomorphicRepresentation.twist D π χ).action.finiteAction g v)=
        (χ.character (1,g) : ℂ) • π.action.finiteAction g
          (AutomorphicRepresentation.twistCarrier D π χ v) := sorry
end ArithmeticRepresentationInterfaces
end TauCeti.Automorphic

namespace TauCeti.Automorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
section RationalParabolicConstantTerms
variable {F : Type} [Field F] [NumberField F] {H : Type} [CommRing H]
  [HopfAlgebra F H] [Algebra.FiniteType F H] [Algebra.Smooth F H]
  (D : Arithmetic.Datum F H)
local notation "AA" => Arithmetic.ArchCoordinate F H
local notation "FinG" => Arithmetic.FinitePoints F H
local notation "GG" => realPoints AA × FinG
local notation "II" => 𝓘(ℝ,realPoints.Model AA)
local notation "Gam" => Arithmetic.rationalSubgroup F H
local notation "Ht" => D.embedding.height F H

/-- Rational cocharacters index actual parabolic point functors, including G itself. -/
abbrev Arithmetic.RationalParabolic := H →ₐc[F] LaurentPolynomial F

def Arithmetic.RationalParabolic.adelic (p : Arithmetic.RationalParabolic (F := F) (H := H)) :
    Subgroup GG := (TauCeti.Cocharacter.parabolic (NumberField.AdeleRing (NumberField.RingOfIntegers F) F) p).map
      (Arithmetic.adelicSplit F H).toMonoidHom

def Arithmetic.RationalParabolic.unipotent (p : Arithmetic.RationalParabolic (F := F) (H := H)) :
    Subgroup GG := (TauCeti.Cocharacter.unipotent (NumberField.AdeleRing (NumberField.RingOfIntegers F) F) p).map
      (Arithmetic.adelicSplit F H).toMonoidHom

def Arithmetic.RationalParabolic.levi (p : Arithmetic.RationalParabolic (F := F) (H := H)) :
    Subgroup GG := (TauCeti.Cocharacter.levi (NumberField.AdeleRing (NumberField.RingOfIntegers F) F) p).map
      (Arithmetic.adelicSplit F H).toMonoidHom

def Arithmetic.RationalParabolic.rationalLevi (p : Arithmetic.RationalParabolic (F := F) (H := H)) :
    Subgroup GG := (TauCeti.Cocharacter.levi F p).map (Arithmetic.diagonal F H)

/-- This is M_P(F)N_P(A), rather than G(F) or an assumed invariant family. -/
def Arithmetic.RationalParabolic.leftSubgroup (p : Arithmetic.RationalParabolic (F := F) (H := H)) :
    Subgroup GG := p.rationalLevi ⊔ p.unipotent

/-- AA.4's compact arithmetic unipotent quotient, specialized to native point functors. -/
instance Arithmetic.RationalParabolic.quotientCompact
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) :
    CompactSpace (UnipotentQuotient Gam p.unipotent) := sorry

theorem isCompact_unipotentQuotient
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) :
    IsCompact (Set.univ : Set (UnipotentQuotient Gam p.unipotent)) := sorry

/-- Canonical probability Haar normalization; uniqueness is a theorem, not an input. -/
def Arithmetic.RationalParabolic.probability
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) :
    QuotientProbability Gam p.unipotent := sorry

theorem Arithmetic.RationalParabolic.probability_unique
    (p : Arithmetic.RationalParabolic (F := F) (H := H))
    (dn : QuotientProbability Gam p.unipotent) : dn.measure=p.probability.measure := sorry

def Arithmetic.RationalParabolic.constantTerm
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) :
    ContinuousInvariant Gam →ₗ[ℂ] ContinuousInvariant p.leftSubgroup := sorry

theorem Arithmetic.RationalParabolic.constantTerm_integral
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) (f : ContinuousInvariant Gam) (g : GG) :
    p.constantTerm f g=TauCeti.Automorphic.constantTerm Gam p.unipotent p.probability f g := sorry

theorem Arithmetic.RationalParabolic.constantTerm_leftInvariant
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) (f : ContinuousInvariant Gam)
    (m : p.rationalLevi) (n : p.unipotent) (g : GG) :
    p.constantTerm f (m.val*n.val*g)=p.constantTerm f g := sorry

def Arithmetic.RationalParabolic.constantTerm_smooth
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) :
    {f : SmoothAdelicFunction (Ginf := realPoints AA) (Gf := FinG) II //
      ∀ γ : Gam, ∀ g, f.val (γ.val*g)=f.val g} →
    SmoothAdelicFunction (Ginf := realPoints AA) (Gf := FinG) II := sorry

theorem Arithmetic.RationalParabolic.constantTerm_smooth_val
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) (f) (g : GG) :
    (p.constantTerm_smooth f).val g=p.constantTerm ⟨f.val.val, by sorry⟩ g := sorry

/-- Actual automorphic target on M_P(F)N_P(A)\\G(A). -/
def Arithmetic.RationalParabolic.forms
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) :
    Submodule ℂ (SmoothAdelicFunction (Ginf := realPoints AA) (Gf := FinG) II) :=
    AutomorphicForm II D.realDatum.K.subtype Ht p.leftSubgroup

def Arithmetic.RationalParabolic.constantTerm_automorphicMap
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) : D.forms →ₗ[ℂ] p.forms D := sorry

theorem constantTerm_automorphic
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) (f : D.forms) (g : GG) :
    (p.constantTerm_automorphicMap D f).val.val g=
      p.constantTerm (AutomorphicForm.toContinuousInvariant (E := realPoints.Model AA) D.realDatum.K.subtype Ht Gam f) g := sorry

/-- Continuity is asserted on the actual growth pieces, with their defining seminorm topology. -/
def UniformModerateGrowth.ofParabolic
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) (N : ℝ) (hN : 0≤N) :
    UniformModerateGrowth II Ht Gam N →L[ℂ]
      UniformModerateGrowth II Ht p.leftSubgroup N := sorry

theorem UniformModerateGrowth.ofParabolic_val
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) (N : ℝ) (hN : 0≤N)
    (f : UniformModerateGrowth II Ht Gam N) (g : GG) :
    (UniformModerateGrowth.ofParabolic D p N hN f).val.val g=
      p.constantTerm ⟨f.val.val, by sorry⟩ g := sorry

/-- The second integration is along N_Q intersect M_P, in the already averaged quotient. -/
def Arithmetic.RationalParabolic.outerUnipotent
    (p q : Arithmetic.RationalParabolic (F := F) (H := H)) : Subgroup GG :=
    q.unipotent ⊓ p.levi

theorem Arithmetic.RationalParabolic.outerCompact
    (p q : Arithmetic.RationalParabolic (F := F) (H := H))
    (hqp : q.adelic≤p.adelic) :
    CompactSpace (UnipotentQuotient p.leftSubgroup (p.outerUnipotent q)) := sorry

def Arithmetic.RationalParabolic.outerProbability
    (p q : Arithmetic.RationalParabolic (F := F) (H := H))
    (hqp : q.adelic≤p.adelic) :
    QuotientProbability p.leftSubgroup (p.outerUnipotent q) := sorry

theorem constantTerm_constantTerm
    (p q : Arithmetic.RationalParabolic (F := F) (H := H)) (hqp : q.adelic≤p.adelic)
    (f : ContinuousInvariant Gam) (g : GG) :
    letI := Arithmetic.RationalParabolic.outerCompact p q hqp
    constantTerm p.leftSubgroup (p.outerUnipotent q)
      (p.outerProbability q hqp) (p.constantTerm f) g=q.constantTerm f g := sorry

/-- Properness and standardness refer to native rational subgroups, not a supplied index. -/
def Arithmetic.RationalParabolic.proper
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) : Prop :=
    TauCeti.Cocharacter.parabolic F p ≠ ⊤

def Arithmetic.RationalParabolic.standard
    (p0 p : Arithmetic.RationalParabolic (F := F) (H := H)) : Prop :=
    TauCeti.Cocharacter.parabolic F p0≤TauCeti.Cocharacter.parabolic F p

def Arithmetic.RationalParabolic.maximalProper
    (p : Arithmetic.RationalParabolic (F := F) (H := H)) : Prop := p.proper ∧
    ∀ q : Arithmetic.RationalParabolic (F := F) (H := H), q.proper →
      TauCeti.Cocharacter.parabolic F p≤TauCeti.Cocharacter.parabolic F q →
      TauCeti.Cocharacter.parabolic F p=TauCeti.Cocharacter.parabolic F q

def Arithmetic.Datum.cuspForms : Submodule ℂ D.forms where
  carrier := {f | ∀ p : Arithmetic.RationalParabolic (F := F) (H := H), p.proper →
    p.constantTerm_automorphicMap D f=0}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

theorem CuspForm.iff_maximal_standard
    (p0 : Arithmetic.RationalParabolic (F := F) (H := H))
    (hmin : ∀ p : Arithmetic.RationalParabolic (F := F) (H := H),
      TauCeti.Cocharacter.parabolic F p≤TauCeti.Cocharacter.parabolic F p0 →
      TauCeti.Cocharacter.parabolic F p=TauCeti.Cocharacter.parabolic F p0)
    (f : D.forms) : f∈D.cuspForms ↔ ∀ p : Arithmetic.RationalParabolic (F := F) (H := H),
      p0.standard p → p.maximalProper → p.constantTerm_automorphicMap D f=0 := sorry

/-- The action is inherited on the actual cuspidal kernel. -/
def CuspForm.submodule : GKModule D.realDatum.pair D.cuspForms := sorry

theorem CuspForm.submodule_lie (X : complexAlgebraicLie AA) (f : D.cuspForms) :
    ((CuspForm.submodule D).rho X f).val=
      D.functionAction.action.rho X f.val := sorry

theorem cuspForm_eq_top_of_anisotropic
    (haniso : ∀ p : Arithmetic.RationalParabolic (F := F) (H := H),
      TauCeti.Cocharacter.parabolic F p=⊤) : D.cuspForms=⊤ := sorry
end RationalParabolicConstantTerms
end TauCeti.Automorphic

/-! DifferentialGeometry 0.3–0.4 and 1.1 adapters. The native rough-form carrier
and chart formula specify the supplier imports; these are not new AF targets. -/
namespace TauCeti.Automorphic.Suppliers.DifferentialGeometry
section Forms
variable {E M V : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [TopologicalSpace M] [ChartedSpace E M] [IsManifold 𝓘(ℝ,E) ∞ M]
  [NormedAddCommGroup V] [NormedSpace ℂ V]
abbrev RoughForm (n : ℕ) := (x : M) → TangentSpace 𝓘(ℝ,E) x [⋀^Fin n]→L[ℝ] V

/-- Smoothness of the pulled-back coefficient functions in every manifold chart. -/
def SmoothAtCharts (n : ℕ) (w : RoughForm (E := E) (M := M) (V := V) n) : Prop :=
  ∀ x : M, ContDiffOn ℝ ∞
    (fun y : E => (w ((extChartAt 𝓘(ℝ,E) x).symm y)).compContinuousLinearMap
      (mfderiv 𝓘(ℝ,E) 𝓘(ℝ,E) (extChartAt 𝓘(ℝ,E) x).symm y))
    (extChartAt 𝓘(ℝ,E) x).target

def smoothForms (n : ℕ) : Submodule ℂ (RoughForm (E := E) (M := M) (V := V) n) where
  carrier := {w | SmoothAtCharts n w}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

/-- Supplier exterior derivative, fixed by its flat chart formula below. -/
def exteriorDerivative (n : ℕ) : smoothForms (E := E) (M := M) (V := V) n →ₗ[ℂ]
    smoothForms (E := E) (M := M) (V := V) (n+1) := sorry

theorem exteriorDerivative_chart (n : ℕ)
    (w : smoothForms (E := E) (M := M) (V := V) n) (x : M)
    (y : E) (hy : y∈(extChartAt 𝓘(ℝ,E) x).target) :
    ((exteriorDerivative n w).val ((extChartAt 𝓘(ℝ,E) x).symm y)).compContinuousLinearMap
      (mfderiv 𝓘(ℝ,E) 𝓘(ℝ,E) (extChartAt 𝓘(ℝ,E) x).symm y)=
      extDerivWithin (fun z => (w.val ((extChartAt 𝓘(ℝ,E) x).symm z)).compContinuousLinearMap
        (mfderiv 𝓘(ℝ,E) 𝓘(ℝ,E) (extChartAt 𝓘(ℝ,E) x).symm z))
          (extChartAt 𝓘(ℝ,E) x).target y := sorry

/-- Pullback uses the actual manifold derivative on every argument. -/
def pullback (f : M → M) (hf : ContMDiff 𝓘(ℝ,E) 𝓘(ℝ,E) ∞ f) (n : ℕ) :
    smoothForms (E := E) (M := M) (V := V) n →ₗ[ℂ]
      smoothForms (E := E) (M := M) (V := V) n := sorry

theorem pullback_val (f : M → M) (hf : ContMDiff 𝓘(ℝ,E) 𝓘(ℝ,E) ∞ f)
    (n : ℕ) (w : smoothForms (E := E) (M := M) (V := V) n) (x : M) (v : Fin n → E) :
    (pullback f hf n w).val x v=w.val (f x) (fun i => mfderiv 𝓘(ℝ,E) 𝓘(ℝ,E) f x (v i)) := sorry
end Forms
