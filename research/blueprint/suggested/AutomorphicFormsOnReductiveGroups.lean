variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] {D : Datum A}
  {minimal : A →ₐc[ℝ] LaurentPolynomial ℝ}

/-- The conjugacy relation specifies both parabolic and Levi point maps,
the tempered block, and the positive character. -/
def LanglandsData.KConjugate (d d' : LanglandsData D minimal) : Prop :=
  ∃ k : D.K, ∃ P : realParabolic d.cocharacter ≃* realParabolic d'.cocharacter,
    ∃ e : Datum.Iso d.levi.datum d'.levi.datum,
      (∀ p, (P p).val=k.val*p.val*k.val⁻¹) ∧
      (∀ m, realPoints_map d'.levi.inclusion (e.points m)=
        k.val*realPoints_map d.levi.inclusion m*k.val⁻¹) ∧
      (IrrAdmissibleModel.isoSetoid d'.levi.datum.pair).r (e.push d.sigma) d'.sigma ∧
      ∀ p, d'.exponent.character (P p)=d.exponent.character p

theorem langlandsClassification_data_unique
    (hmin : IsMinimalParabolic minimal) (d d' : LanglandsData D minimal)
    (pi : IrrAdmissible.{0} D.pair) (hd : d.IsQuotient pi) (hd' : d'.IsQuotient pi) :
    d.KConjugate d' := sorry
end LanglandsDataUniqueness
