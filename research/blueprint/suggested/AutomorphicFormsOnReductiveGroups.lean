section UnitaryClasses
attribute [local instance] LieGroup.minSmoothnessThree
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A)

/-- A Hilbert realization records an actual group action and the original HC carrier. -/
structure UnitaryModel (M : IrrAdmissibleModel.{0} D.pair) where
  H : Type
  [normedGroup : NormedAddCommGroup H]
  [innerProduct : InnerProductSpace ℂ H]
  [complete : CompleteSpace H]
  representation : ContRepresentation ℂ (realPoints A) H
  unitary : ∀ g v, ‖representation g v‖=‖v‖
  joint : Continuous (fun gv : realPoints A × H => representation gv.1 gv.2)
  character : Subgroup.center (realPoints A) →* ℂˣ
  central : ∀ z v, representation z.val v=(character z : ℂ) • v
  vectors : M.carrier ≃ₗ[ℂ] kFinite (representation.toRepresentation.comp D.K.subtype)
  compact : ∀ k v, vectors (M.action.sigma k v)=
    ⟨representation k.val (vectors v).val, by sorry⟩
  smooth : ∀ v, ContMDiff 𝓘(ℝ,realPoints.Model A) 𝓘(ℝ,H) ∞
    (fun g => representation g (vectors v).val)
  derivative : ∀ (X : algebraicRealLie A) v,
    (vectors (M.action.rho (1 ⊗ₜ[ℝ] X) v)).val=
      mfderiv 𝓘(ℝ,realPoints.Model A) 𝓘(ℝ,H)
        (fun g => representation g (vectors v).val) 1 ((realPoints_lieAlgebra A).symm X)
attribute [instance] UnitaryModel.normedGroup UnitaryModel.innerProduct UnitaryModel.complete

instance centreQuotientMeasurable : MeasurableSpace
    (realPoints A ⧸ Subgroup.center (realPoints A)) := borel _
instance centreQuotientBorel : BorelSpace
    (realPoints A ⧸ Subgroup.center (realPoints A)) := ⟨rfl⟩

def centreQuotientHaar : Measure (realPoints A ⧸ Subgroup.center (realPoints A)) := sorry
instance centreQuotientHaar_isHaar : (centreQuotientHaar (A := A)).IsHaarMeasure := sorry

def UnitaryModel.coefficients {M : IrrAdmissibleModel.{0} D.pair} (U : UnitaryModel D M) :
    CoefficientRealization (H := U.H) (Subgroup.center (realPoints A)) where
  π := U.representation
  joint := U.joint
  ψ := U.character
  central := U.central

def IsTemperedClass (π : IrrAdmissible.{0} D.pair) : Prop :=
  ∃ M : IrrAdmissibleModel.{0} D.pair, Quotient.mk _ M=π ∧
    ∃ U : UnitaryModel D M, IsTempered D.K.subtype continuous_subtype_val
      (centreQuotientHaar (A := A)) U.coefficients

def IsDiscreteSeriesClass (π : IrrAdmissible.{0} D.pair) : Prop :=
  ∃ M : IrrAdmissibleModel.{0} D.pair, Quotient.mk _ M=π ∧
    ∃ U : UnitaryModel D M, IsSquareIntegrable D.K.subtype continuous_subtype_val
      (centreQuotientHaar (A := A)) U.coefficients

/-- Essential square-integrability keeps the possibly nonunitary central twist explicit. -/
def IsEssentialDiscreteSeriesClass (π : IrrAdmissible.{0} D.pair) : Prop :=
  ∃ χ : SmoothCharacter D, IsDiscreteSeriesClass D (IrrAdmissible.twist D χ π)
end UnitaryClasses
