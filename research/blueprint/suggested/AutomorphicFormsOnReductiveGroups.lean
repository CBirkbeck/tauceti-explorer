attribute [local instance] LieGroup.minSmoothnessThree
/-- The central isogeny SL₂ → PGL₂ leaves these native arithmetic Lie algebras unchanged. -/
def pgl2LieDatum (F : Type) [Field F] [NumberField F] :
    Arithmetic.Datum F (TauCeti.SpecialLinear.coordinateHopfAlgebra F 2) := sorry

abbrev pgl2ArchLie (F : Type) [Field F] [NumberField F] :=
  algebraicRealLie (Arithmetic.ArchCoordinate F (TauCeti.SpecialLinear.coordinateHopfAlgebra F 2))
abbrev pgl2CompactLie (F : Type) [Field F] [NumberField F] :=
  GroupLieAlgebra 𝓘(ℝ,(pgl2LieDatum F).realDatum.KModel) (pgl2LieDatum F).realDatum.K
abbrev zeroSplitLie := Fin 0 → ℝ

theorem pgl2_absolute_ranks (F : Type) [Field F] [NumberField F] :
    LieAlgebra.rank ℝ (pgl2ArchLie F)=InfinitePlace.nrRealPlaces F+2*InfinitePlace.nrComplexPlaces F ∧
    LieAlgebra.rank ℝ (pgl2CompactLie F)=InfinitePlace.nrRealPlaces F+InfinitePlace.nrComplexPlaces F ∧
    Module.finrank ℝ (pgl2ArchLie F)=3*InfinitePlace.nrRealPlaces F+6*InfinitePlace.nrComplexPlaces F ∧
    Module.finrank ℝ (pgl2CompactLie F)=InfinitePlace.nrRealPlaces F+3*InfinitePlace.nrComplexPlaces F := sorry

-- test: ell0_PGL2_Q
example : ell0 (pgl2ArchLie ℚ) (pgl2CompactLie ℚ) zeroSplitLie=0 ∧
    q0 (pgl2ArchLie ℚ) (pgl2CompactLie ℚ) zeroSplitLie=1 := sorry

-- test: ell0_imag_quad
example (F : Type) [Field F] [NumberField F]
    (hreal : InfinitePlace.nrRealPlaces F=0) (hcomplex : InfinitePlace.nrComplexPlaces F=1) :
    ell0 (pgl2ArchLie F) (pgl2CompactLie F) zeroSplitLie=1 ∧
      q0 (pgl2ArchLie F) (pgl2CompactLie F) zeroSplitLie=1 := sorry

-- test: ell0_not_split_rank
example (F : Type) [Field F] [NumberField F]
    (hreal : InfinitePlace.nrRealPlaces F=0) (hcomplex : InfinitePlace.nrComplexPlaces F=1) :
    LieAlgebra.rank ℝ (pgl2ArchLie F)=2 ∧
    LieAlgebra.rank ℝ (pgl2CompactLie F)=1 ∧
    ell0 (pgl2ArchLie F) (pgl2CompactLie F) zeroSplitLie≠(1:ℤ)-1 := sorry
end ArithmeticRanks
end TauCeti.Automorphic

namespace TauCeti.Automorphic
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
section BalancedRelativeCohomology
attribute [local instance] LieGroup.minSmoothnessThree
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A)

/-- A specified split central Lie subspace; arithmetic applications use the
rational split centre of Res_{F/ℚ}G, which can be smaller than its real split centre. -/
structure CentralSplitData where
  realLie : LieSubalgebra ℝ (algebraicRealLie A)
  central : ∀ X : realLie, ∀ Y : algebraicRealLie A, ⁅X.val,Y⁆=0
  noncompact : realLie.toSubmodule≤D.noncompactLie
  complexLie : LieIdeal ℂ (complexAlgebraicLie A)
  complexification : complexLie.toSubmodule=Submodule.span ℂ
    {X | ∃ Y : realLie, X=1 ⊗ₜ[ℝ] Y.val}
  adjoint : ∀ k : D.K, ∀ X : complexLie, D.pair.Ad k X.val=X.val

namespace CentralSplitData
variable {D} (B : CentralSplitData D)
abbrev quotientLie := complexAlgebraicLie A ⧸ B.complexLie
instance quotientNormedAdd : NormedAddCommGroup B.quotientLie :=
  NormedAddCommGroup.induced _ _ (Module.finBasis ℂ B.quotientLie).equivFun.toAddMonoidHom
    (Module.finBasis ℂ B.quotientLie).equivFun.injective
instance quotientNormedSpace : NormedSpace ℂ B.quotientLie :=
  NormedSpace.induced _ _ _ (Module.finBasis ℂ B.quotientLie).equivFun.toLinearMap
instance quotientNormedLie : NormedComplexLieAlgebra B.quotientLie :=
  { (inferInstance : NormedAddCommGroup B.quotientLie),
    (inferInstance : LieRing B.quotientLie),
    (inferInstance : NormedSpace ℂ B.quotientLie),
    (inferInstance : LieAlgebra ℂ B.quotientLie),
    (inferInstance : FiniteDimensional ℂ B.quotientLie) with }

def projection : complexAlgebraicLie A →ₗ⁅ℂ⁆ B.quotientLie where
  toLinearMap := B.complexLie.toSubmodule.mkQ
  map_lie' := by sorry

def pair : Pair 𝓘(ℝ,D.KModel) (CompactIdentity (K := D.K)) B.quotientLie := sorry

theorem pair_iota (X : TauCeti.ComplexGroupLie 𝓘(ℝ,D.KModel) (CompactIdentity (K := D.K))) :
    B.pair.iota X=B.projection (D.pair.identityComponent.iota X) := sorry

def descend {V : Type} [AddCommGroup V] [Module ℂ V] (M : GKModule D.pair V)
    (hcentral : ∀ X : B.complexLie, M.rho X.val=0) : GKModule B.pair V := sorry

theorem descend_lie {V : Type} [AddCommGroup V] [Module ℂ V] (M : GKModule D.pair V)
    (hcentral : ∀ X : B.complexLie, M.rho X.val=0) (X : complexAlgebraicLie A) :
    (B.descend M hcentral).rho (B.projection X)=M.rho X := sorry

abbrev ell := ell0 (algebraicRealLie A) (GroupLieAlgebra 𝓘(ℝ,D.KModel) D.K) B.realLie
abbrev bottom := q0 (algebraicRealLie A) (GroupLieAlgebra 𝓘(ℝ,D.KModel) D.K) B.realLie

theorem nonnegative_integral : 0≤B.ell ∧ ∃ q : ℕ, B.bottom=q := sorry
end CentralSplitData

/-- Borel–Wallach VII.6.7; the balanced tensor, identity compact component and
bottom multiplicity are retained rather than suppressed. -/
theorem relativeCohomology_tempered_range (B : CentralSplitData D)
    (π : IrrAdmissibleModel.{0} D.pair)
    (htemp : IsTemperedClass D (Quotient.mk _ π))
    (V : AlgebraicCoefficient (A := A))
    (hbal : ∀ X : B.complexLie,
      (GKModule.tensorFinite D.pair π.action.toGKModule (V.action (D := D))).rho X.val=0)
    (hcoh : ∃ q : ℕ, Nontrivial (cohomology
      (B.descend (GKModule.tensorFinite D.pair π.action.toGKModule (V.action (D := D))) hbal) q)) :
    ∃ q0 ell : ℕ, B.bottom=q0 ∧ B.ell=ell ∧
      (∀ q : ℕ, (q<q0 ∨ q0+ell<q) → Subsingleton (cohomology
        (B.descend (GKModule.tensorFinite D.pair π.action.toGKModule (V.action (D := D))) hbal) q)) ∧
      (∀ i : ℕ, i≤ell → Module.finrank ℂ (cohomology
        (B.descend (GKModule.tensorFinite D.pair π.action.toGKModule (V.action (D := D))) hbal) (q0+i))=
          Nat.choose ell i*Module.finrank ℂ (cohomology
            (B.descend (GKModule.tensorFinite D.pair π.action.toGKModule (V.action (D := D))) hbal) q0)) := sorry
end BalancedRelativeCohomology
end TauCeti.Automorphic

namespace TauCeti.Automorphic.Suppliers.ReductiveGroupsPartII
open TauCeti.RealReductive
/-- Matrix specification of the GSp supplier, with multiplier retained as a unit. -/
def symplecticMatrix (n : ℕ) (R : Type) [CommRing R] : Matrix (Fin (2*n)) (Fin (2*n)) R :=
  fun i j => if i.val+j.val+1=2*n then (if i.val<n then 1 else -1) else 0

def similitudeMatrices (n : ℕ) (R : Type) [CommRing R] :
    Subgroup (Matrix.GeneralLinearGroup (Fin (2*n)) R × Rˣ) where
  carrier := {g | g.1.val.transpose*symplecticMatrix n R*g.1.val=g.2.val • symplecticMatrix n R}
  one_mem' := by sorry
  mul_mem' := by sorry
  inv_mem' := by sorry

/-- RG2's missing affine supplier is fixed by its represented matrix functor. -/
def GSpCoordinate (n : ℕ) : Type := sorry
instance (n : ℕ) : CommRing (GSpCoordinate n) := sorry
instance (n : ℕ) : HopfAlgebra ℝ (GSpCoordinate n) := sorry
instance (n : ℕ) : Algebra.FiniteType ℝ (GSpCoordinate n) := sorry
instance (n : ℕ) : Algebra.Smooth ℝ (GSpCoordinate n) := sorry

def similitudePoints (n : ℕ) (R : Type) [CommRing R] [Algebra ℝ R] :
    HopfAlgebra.points (R := ℝ) (H := GSpCoordinate n) (CommAlgCat.of ℝ R) ≃*
      similitudeMatrices n R := sorry

theorem similitudePoints_natural (n : ℕ) {R S : Type} [CommRing R] [CommRing S]
    [Algebra ℝ R] [Algebra ℝ S] (f : R →ₐ[ℝ] S)
    (g : HopfAlgebra.points (R := ℝ) (H := GSpCoordinate n) (CommAlgCat.of ℝ R)) :
    (similitudePoints n S (TauCeti.AlgHom.mapValue f g)).val=
      ((Matrix.GeneralLinearGroup.map f.toRingHom ((similitudePoints n R g).val.1)),
        Units.map f.toMonoidHom ((similitudePoints n R g).val.2)) := sorry

def similitudeLie (n : ℕ) : LieSubalgebra ℂ (Matrix (Fin (2*n)) (Fin (2*n)) ℂ × ℂ) where
  carrier := {X | X.1.transpose*symplecticMatrix n ℂ+symplecticMatrix n ℂ*X.1=X.2 • symplecticMatrix n ℂ}
  add_mem' := by sorry
  zero_mem' := by sorry
  smul_mem' := by sorry
  lie_mem' := by sorry

def similitudeLieEquiv (n : ℕ) : complexAlgebraicLie (GSpCoordinate n) ≃ₗ⁅ℂ⁆ similitudeLie n := sorry

def similitudeDatum (n : ℕ) : Datum (GSpCoordinate n) := sorry

theorem similitudeDatum_K (n : ℕ) (g : realPoints (GSpCoordinate n)) :
    g∈(similitudeDatum n).K ↔
      ((similitudePoints n ℝ g).val.1).val.transpose*((similitudePoints n ℝ g).val.1).val=1 := sorry

def multiplier (n : ℕ) : realPoints (GSpCoordinate n) →* ℝˣ :=
  (MonoidHom.snd _ _).comp ((similitudeMatrices n ℝ).subtype.comp (similitudePoints n ℝ).toMonoidHom)

def positiveSimilitudes (n : ℕ) : Subgroup (realPoints (GSpCoordinate n)) where
  carrier := {g | 0<(multiplier n g).val}
  one_mem' := by sorry
  mul_mem' := by sorry
  inv_mem' := by sorry
end TauCeti.Automorphic.Suppliers.ReductiveGroupsPartII

namespace TauCeti.Automorphic.GSp4
