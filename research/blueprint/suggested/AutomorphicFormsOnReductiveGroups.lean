/-- The exterior algebra's grading assigns the j-th generator degree 2j+1. -/
def oddExteriorPiece (n q : ℕ) : Submodule ℝ (ExteriorAlgebra ℝ (Fin n → ℝ)) :=
  Submodule.span ℝ {v | ∃ s : Finset (Fin n), (∑ j∈s, 2*j.val+1)=q ∧
    v=((s.sort (·≤·)).map (fun j => ExteriorAlgebra.ι ℝ (Pi.single j (1 : ℝ)))).prod}

instance complexCompactManifold (n : ℕ) :
    IsManifold 𝓘(ℝ,(complexGLDatum n).KModel) ∞ (complexGLDatum n).K := sorry

/-- The compact dual is the actual U(n) subgroup, with its ordinary de Rham complex. -/
def complexCompactDual (n q : ℕ) :
    (continuousCochains (ContRepresentation.trivial ℝ (realPoints (ComplexGLCoordinate n)) ℝ)).homology q ≃ₗ[ℝ]
      (realDeRhamComplex (E := (complexGLDatum n).KModel) (M := (complexGLDatum n).K)).homology q := sorry

/-- All degrees, including the unstable finite-n boundary, use the weighted exterior algebra. -/
def complexExteriorCohomology (n q : ℕ) :
    (continuousCochains (ContRepresentation.trivial ℝ (realPoints (ComplexGLCoordinate n)) ℝ)).homology q ≃ₗ[ℝ]
      oddExteriorPiece n q := sorry

/-- The four acceptance cases are on actual continuous and relative complexes. -/
theorem acceptance :
    (∀ (K : Type) [Group K] [TopologicalSpace K] [IsTopologicalGroup K] [CompactSpace K]
      [T2Space K] (V : Type) [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]
      (rho : ContRepresentation ℝ K V) (q : ℕ), 0<q → Subsingleton ((continuousCochains rho).homology q)) ∧
    (∀ n q : ℕ, Nonempty
      (((continuousCochains (ContRepresentation.trivial ℝ (Multiplicative (EuclideanSpace ℝ (Fin n))) ℝ)).homology q) ≃ₗ[ℝ]
        AlternatingMap ℝ (EuclideanSpace ℝ (Fin n)) ℝ (Fin q))) ∧
    (∀ n q : ℕ, Nonempty
      (((continuousCochains (ContRepresentation.trivial ℝ (realPoints (ComplexGLCoordinate n)) ℝ)).homology q) ≃ₗ[ℝ]
        oddExteriorPiece n q)) ∧
    (Subsingleton (cohomology (GKModule.trivial GL2.D.pair) 2) ∧
      Module.finrank ℂ (cohomology (GKModule.restrict GL2.D.pair.identityComponentHom
        (GKModule.trivial GL2.D.pair)) 2)=1 ∧
      ∀ c : cohomology (GKModule.restrict GL2.D.pair.identityComponentHom
          (GKModule.trivial GL2.D.pair)) 2,
        componentCohomologyAction (GKModule.trivial GL2.D.pair) 2
          (QuotientGroup.mk GL2.reflection) c=-c) := sorry

/-- Γ(3) has genus zero and four cusps, hence three independent degree-one classes.
These are arithmetic-quotient de Rham classes, rather than G-invariant forms. -/
-- test: invariantForms_not_all_forms
example : Module.finrank ℂ
    (groupCohomology (Rep.of (Representation.trivial ℂ (CongruenceSubgroup.Gamma 3) ℂ)) 1)=3 ∧
      Subsingleton (cohomology (GKModule.trivial GL2.sl2SO2Pair) 1) := sorry
end TauCeti.VanEst


namespace TauCeti.Automorphic
section QuotientHeightComparison
variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {Ginf : Type} [Group Ginf] [TopologicalSpace Ginf] [ChartedSpace E Ginf]
  [LieGroup 𝓘(ℝ,E) ∞ Ginf] {Gf : Type} [Group Gf] [TopologicalSpace Gf]
  [IsTopologicalGroup Gf] [LocallyCompactSpace Gf] [TotallyDisconnectedSpace Gf]
  [T2Space Gf] [SecondCountableTopology Gf]
local notation "I" => 𝓘(ℝ,E)
local notation "G" => Ginf × Gf

/-- Arthur's quotient height uses the actual rational left orbit. -/
def quotientHeight (height : G → ℝ) (Γ : Subgroup G) (g : G) : ℝ :=
  sInf (Set.range (fun gamma : Γ => height (gamma.val*g)))

/-- The same exponent bounds every enveloping derivative. This comparison also
applies after restriction to the norm-one adelic group in Arthur's convention. -/
-- test: uniformModerateGrowth_arthur_compat
theorem UniformModerateGrowth.arthur_compat (height : G → ℝ)
    (hheight : ∀ g, 1≤height g) (Γ : Subgroup G)
    (f : SmoothAdelicFunction (Ginf := Ginf) (Gf := Gf) I) :
    f∈UniformModerateGrowth.all I height Γ ↔
      (∀ (gamma : Γ) g, f.val (gamma.val*g)=f.val g) ∧
      ∃ N : ℕ, ∀ u : UniversalEnvelopingAlgebra ℂ (TauCeti.ComplexGroupLie I Ginf),
        ∃ C : ℝ, 0<C ∧ ∀ g,
          ‖(rightDerivative I u f).val g‖≤C*(quotientHeight height Γ g)^N := sorry

-- test: uniformModerateGrowth_arthur_compat
example (height : G → ℝ)
    (hheight : ∀ g, 1≤height g) (Γ : Subgroup G)
    (f : SmoothAdelicFunction (Ginf := Ginf) (Gf := Gf) I) :
    f∈UniformModerateGrowth.all I height Γ ↔
      (∀ (gamma : Γ) g, f.val (gamma.val*g)=f.val g) ∧
      ∃ N : ℕ, ∀ u : UniversalEnvelopingAlgebra ℂ (TauCeti.ComplexGroupLie I Ginf),
        ∃ C : ℝ, 0<C ∧ ∀ g,
          ‖(rightDerivative I u f).val g‖≤C*(quotientHeight height Γ g)^N := sorry
end QuotientHeightComparison

