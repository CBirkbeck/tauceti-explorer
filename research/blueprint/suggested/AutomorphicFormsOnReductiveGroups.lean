    ((ComplexGLPoints n ((complexGLDatum n).thetaPoints g) :
      Matrix.GeneralLinearGroup (Fin n) ℂ) : Matrix (Fin n) (Fin n) ℂ)=
        Matrix.conjTranspose ((ComplexGLPoints n g⁻¹ : Matrix.GeneralLinearGroup (Fin n) ℂ) :
          Matrix (Fin n) (Fin n) ℂ) := sorry

/-- rec_R is inverse to Knapp's ordered-block Langlands-quotient construction. -/
def recGL (n : ℕ) : IrrAdmissible.{0} (Datum.generalLinear n).pair ≃
    WeilParameter.classes WeilGroupReal n := sorry

