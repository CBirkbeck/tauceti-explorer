def borelCocharacter : Coordinate →ₐc[ℝ] LaurentPolynomial ℝ := sorry

theorem borel_parabolic (g : realPoints Coordinate) :
    g∈realParabolic borelCocharacter ↔ (points g).val 1 0=0 := sorry

def principalCoefficient (nu : ℂ) (epsilon : Bool) : PrincipalCoefficient datum := sorry

theorem principalCoefficient_data (nu : ℂ) (epsilon : Bool) :
    (principalCoefficient nu epsilon).dimension=1 ∧
    (principalCoefficient nu epsilon).cocharacter=borelCocharacter := sorry

/-- Evaluation identifies the one-dimensional inducing fibre with ℂ. -/
def principalFibre (nu : ℂ) (epsilon : Bool) :
    finiteCoefficient (principalCoefficient nu epsilon).dimension ≃L[ℂ] ℂ := sorry

theorem principalCoefficient_value (nu : ℂ) (epsilon : Bool)
    (p : realParabolic (principalCoefficient nu epsilon).cocharacter)
    (v : finiteCoefficient (principalCoefficient nu epsilon).dimension) :
    principalFibre nu epsilon ((principalCoefficient nu epsilon).representation p v)=
      Complex.exp ((nu+1)*(Real.log |(points p.val).val 0 0| : ℂ))*
        (if (points p.val).val 0 0<0 then (-1 : ℂ)^(if epsilon then 1 else 0) else 1)*
        principalFibre nu epsilon v := sorry

abbrev principal (nu : ℂ) (epsilon : Bool) := principalSeries_kFinite datum (principalCoefficient nu epsilon)

def principalHC (nu : ℂ) (epsilon : Bool) :
    HCModule (P := datum.pair) (V := (principal nu epsilon).obj.carrier) where
  toGKModule := (principal nu epsilon).obj.action
  admissible := (principal nu epsilon).property.1
  finitelyGenerated := (principal nu epsilon).property.2

def principalCompactValue (nu : ℂ) (epsilon : Bool) (f : (principal nu epsilon).obj.carrier)
    (t : ℝ) : ℂ := principalFibre nu epsilon
      ((principalSeries_restrictK datum (principalCoefficient nu epsilon) f).val.val (rotation t))

def principalL2Norm (nu : ℂ) (epsilon : Bool) : Seminorm ℂ (principal nu epsilon).obj.carrier := sorry

theorem principalL2Norm_value (nu : ℂ) (epsilon : Bool) (f : (principal nu epsilon).obj.carrier) :
    principalL2Norm nu epsilon f=Real.sqrt
      ((2*Real.pi)⁻¹*∫ t in (0 : ℝ)..(2*Real.pi), ‖principalCompactValue nu epsilon f t‖^2) := sorry

-- test: gContinuous_principalSeries
example (nu : ℂ) (epsilon : Bool) :
    ∃ p : GContinuousNorm (principalHC nu epsilon) datum.K.subtype datum.complexLieTangent,
      p.norm=principalL2Norm nu epsilon := sorry

def principalFourier (nu : ℂ) (epsilon : Bool) (f : (principal nu epsilon).obj.carrier) (ell : ℤ) : ℂ :=
  (2*Real.pi : ℂ)⁻¹*∫ t in (0 : ℝ)..(2*Real.pi),
    principalCompactValue nu epsilon f t*Complex.exp (-Complex.I*(ell : ℂ)*(t : ℂ))

def factorialNorm (nu : ℂ) : Seminorm ℂ (principal nu false).obj.carrier := sorry

theorem factorialNorm_value (nu : ℂ) (f : (principal nu false).obj.carrier) :
    factorialNorm nu f=∑' j : ℤ, ((1+j.natAbs).factorial : ℝ)*‖principalFourier nu false f (2*j)‖ := sorry

-- test: gContinuous_not_arbitrary
example (nu : ℂ) : ¬∃ p : GContinuousNorm (principalHC nu false)
    datum.K.subtype datum.complexLieTangent, p.norm=factorialNorm nu := sorry

/-- The even circle L² carrier realizes the spherical unitary principal series. -/
def evenCircleL2 : Submodule ℂ (Lp ℂ 2 (TauCeti.haarProb Circle)) where
  carrier := {f | ∀ᵐ z ∂TauCeti.haarProb Circle, f (-z)=f z}
