section TransportDatum
variable {A B : Type} [CommRing A] [CommRing B] [HopfAlgebra ℝ A] [HopfAlgebra ℝ B]
  [Algebra.FiniteType ℝ A] [Algebra.FiniteType ℝ B] [Algebra.Smooth ℝ A] [Algebra.Smooth ℝ B]
  (D : Datum A) (D' : Datum B)

structure Datum.Iso where
  points : realPoints A ≃* realPoints B
  smooth : ContMDiff 𝓘(ℝ,realPoints.Model A) 𝓘(ℝ,realPoints.Model B) ∞ points
  inverseSmooth : ContMDiff 𝓘(ℝ,realPoints.Model B) 𝓘(ℝ,realPoints.Model A) ∞ points.symm
  compact : D.K ≃* D'.K
  compact_val : ∀ k, (compact k).val=points k.val
  lie : complexAlgebraicLie A ≃ₗ⁅ℂ⁆ complexAlgebraicLie B
  derivative : ∀ X : algebraicRealLie A,
    lie (1 ⊗ₜ[ℝ] X)=1 ⊗ₜ[ℝ] (realPoints_lieAlgebra B
      (mfderiv 𝓘(ℝ,realPoints.Model A) 𝓘(ℝ,realPoints.Model B) points 1
        ((realPoints_lieAlgebra A).symm X)))

variable {D D'}
def Datum.Iso.push (e : Datum.Iso D D') (M : IrrAdmissibleModel.{0} D.pair) :
    IrrAdmissibleModel.{0} D'.pair := sorry

def Datum.Iso.pushCarrier (e : Datum.Iso D D') (M : IrrAdmissibleModel.{0} D.pair) :
    (e.push M).carrier ≃ₗ[ℂ] M.carrier := sorry

theorem Datum.Iso.push_lie (e : Datum.Iso D D') (M : IrrAdmissibleModel.{0} D.pair)
    (X : complexAlgebraicLie B) (v : (e.push M).carrier) :
    e.pushCarrier M ((e.push M).action.rho X v)=M.action.rho (e.lie.symm X) (e.pushCarrier M v) := sorry

theorem Datum.Iso.push_compact (e : Datum.Iso D D') (M : IrrAdmissibleModel.{0} D.pair)
    (k : D'.K) (v : (e.push M).carrier) :
    e.pushCarrier M ((e.push M).action.sigma k v)=M.action.sigma (e.compact.symm k) (e.pushCarrier M v) := sorry
end TransportDatum
