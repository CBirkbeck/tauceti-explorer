namespace TauCeti.Automorphic
section IntegralReduction
variable {T H Hk O k : Type} [CommRing T] [CommRing O] [Field k]
    [AddCommGroup H] [Module T H] [Module O H]
    [AddCommGroup Hk] [Module T Hk] [Module k Hk]

/-- Reduction applies to an integral characteristic-zero eigenclass with nonzero image. -/
def TorsionEigenSystem.of_char_zero [CharZero O]
    (e : TorsionEigenSystem T H O) (reduce : O →+* k)
    (map : H →ₛₗ[reduce] Hk) (hequiv : ∀ (t : T) (x : H), map (t • x)=t • map x)
    (hne : map e.c≠0) : TorsionEigenSystem T Hk k := e.map reduce map hequiv hne

theorem TorsionEigenSystem.of_char_zero_values [CharZero O]
    (e : TorsionEigenSystem T H O) (reduce : O →+* k)
    (map : H →ₛₗ[reduce] Hk) (hequiv : ∀ (t : T) (x : H), map (t • x)=t • map x)
    (hne : map e.c≠0) : (e.of_char_zero reduce map hequiv hne).sys=reduce.comp e.sys := rfl

/-- Away from the lattice index, the coefficient comparison induces this equivariant
Betti-cohomology isomorphism; both class and eigenvalue system are transported. -/
def TorsionEigenSystem.lattice_indep (e : TorsionEigenSystem T Hk k)
    {Hk' : Type} [AddCommGroup Hk'] [Module T Hk'] [Module k Hk']
    (comparison : Hk ≃ₗ[k] Hk')
    (hecke : ∀ (t : T) (x : Hk), comparison (t • x)=t • comparison x) : TorsionEigenSystem T Hk' k where
  sys := e.sys
  c := comparison e.c
  ne_zero := by sorry
  eigen := by sorry
end IntegralReduction

/-- The nonlifting mechanism is checked on the actual arithmetic group SL₂(ℤ):
its abelianization is ℤ/12; characteristic two creates H¹ although integral H¹ vanishes. -/
def integralSL2Coefficients : Rep ℤ (Matrix.SpecialLinearGroup (Fin 2) ℤ) :=
  Rep.of (Representation.trivial ℤ (Matrix.SpecialLinearGroup (Fin 2) ℤ) ℤ)

def modTwoSL2Coefficients : Rep (ZMod 2) (Matrix.SpecialLinearGroup (Fin 2) ℤ) :=
  Rep.of (Representation.trivial (ZMod 2) (Matrix.SpecialLinearGroup (Fin 2) ℤ) (ZMod 2))

-- test: torsion_not_lift
example : Subsingleton (groupCohomology integralSL2Coefficients 1) ∧
    Module.finrank (ZMod 2) (groupCohomology modTwoSL2Coefficients 1)=1 := sorry
end TauCeti.Automorphic

/-! General homogeneous-space contracts import DifferentialGeometry's quotient
charts; neither reductivity nor an algebraic presentation is required. -/
namespace TauCeti.VanEst
open TauCeti.RelativeLieCohomology CategoryTheory MeasureTheory
open TauCeti.Automorphic.Suppliers.DifferentialGeometry
section GeneralHomogeneous
attribute [local instance] LieGroup.minSmoothnessThree
variable {E Ek : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup Ek] [NormedSpace ℝ Ek] [FiniteDimensional ℝ Ek]
  {G : Type} [Group G] [TopologicalSpace G] [ChartedSpace E G]
  [LieGroup 𝓘(ℝ,E) ∞ G] [T2Space G] [IsTopologicalGroup G]
  [LocallyCompactSpace G] [SecondCountableTopology G]
  (K : Subgroup G) [CompactSpace K] [ChartedSpace Ek K] [LieGroup 𝓘(ℝ,Ek) ∞ K]
  {q : Type} [NormedComplexLieAlgebra q] (P : Pair 𝓘(ℝ,Ek) K q)
  [MeasurableSpace K] [BorelSpace K]

abbrev quotientAction (g : G) : G ⧸ K → G ⧸ K := Quotient.map (fun x => g*x) (by sorry)

/-- DG's quotient charts and tangent comparison are characterized by the quotient
projection's derivative. The Lie pair is tied to the actual compact inclusion. -/
structure HomogeneousLieDatum where
  phi : q ≃ₗ⁅ℂ⁆ TauCeti.ComplexGroupLie 𝓘(ℝ,E) G
  inclusion_smooth : ContMDiff 𝓘(ℝ,Ek) 𝓘(ℝ,E) ∞ K.subtype
  compact_derivative : ∀ X : GroupLieAlgebra 𝓘(ℝ,Ek) K,
    phi (P.iota (1 ⊗ₜ[ℝ] X))=1 ⊗ₜ[ℝ] (mfderiv 𝓘(ℝ,Ek) 𝓘(ℝ,E) K.subtype 1 X)
  adjoint : ∀ k X, phi (P.Ad k X)=TauCeti.ComplexGroupLie.ad 𝓘(ℝ,E) G k.val (phi X)
  dimension : ℕ
  [charts : ChartedSpace (EuclideanSpace ℝ (Fin dimension)) (G ⧸ K)]
  [manifold : IsManifold 𝓘(ℝ,EuclideanSpace ℝ (Fin dimension)) ∞ (G ⧸ K)]
  projection_smooth : ContMDiff 𝓘(ℝ,E) 𝓘(ℝ,EuclideanSpace ℝ (Fin dimension)) ∞
    (QuotientGroup.mk : G → G ⧸ K)
  action_smooth : ∀ g, ContMDiff 𝓘(ℝ,EuclideanSpace ℝ (Fin dimension))
    𝓘(ℝ,EuclideanSpace ℝ (Fin dimension)) ∞ (quotientAction K g)
  tangent : (ℂ ⊗[ℝ] EuclideanSpace ℝ (Fin dimension)) ≃ₗ[ℂ]
    (q ⧸ P.iota.range.toSubmodule)
  tangent_projection : ∀ X : GroupLieAlgebra 𝓘(ℝ,E) G,
    tangent (1 ⊗ₜ[ℝ] (mfderiv 𝓘(ℝ,E) 𝓘(ℝ,EuclideanSpace ℝ (Fin dimension))
      (QuotientGroup.mk : G → G ⧸ K) 1 X))=
        (Submodule.mkQ P.iota.range.toSubmodule) (phi.symm (1 ⊗ₜ[ℝ] X))
attribute [instance] HomogeneousLieDatum.charts HomogeneousLieDatum.manifold

variable {K P} (Z : HomogeneousLieDatum (E := E) K P)
abbrev HomogeneousLieDatum.model (Z : HomogeneousLieDatum (E := E) K P) := EuclideanSpace ℝ (Fin Z.dimension)

variable {V : Type} [NormedAddCommGroup V] [NormedSpace ℂ V] [FiniteDimensional ℂ V]
  (rho : ContRepresentation ℂ G V)
  (hs : ∀ v, ContMDiff 𝓘(ℝ,E) 𝓘(ℝ,V) ∞ (fun g => rho g v))

def HomogeneousLieDatum.module (Z : HomogeneousLieDatum (E := E) K P)
    (rho : ContRepresentation ℂ G V)
    (hs : ∀ v, ContMDiff 𝓘(ℝ,E) 𝓘(ℝ,V) ∞ (fun g => rho g v)) : GKModule P V := sorry

theorem HomogeneousLieDatum.module_compact (k : K) (v : V) :
    (Z.module rho hs).sigma k v=rho k.val v := sorry

theorem HomogeneousLieDatum.module_lie (X : GroupLieAlgebra 𝓘(ℝ,E) G) (v : V) :
    (Z.module rho hs).rho (Z.phi.symm (1 ⊗ₜ[ℝ] X)) v=
      mfderiv 𝓘(ℝ,E) 𝓘(ℝ,V) (fun g => rho g v) 1 X := sorry

def invariantForm (n : ℕ) : Submodule ℂ
    (smoothForms (E := Z.model) (M := G ⧸ K) (V := V) n) where
  carrier := {w | ∀ (g : G) (x : G ⧸ K) (v : Fin n → Z.model),
    w.val (quotientAction K g x)
      (fun i => mfderiv 𝓘(ℝ,Z.model) 𝓘(ℝ,Z.model) (quotientAction K g) x (v i))=
        rho g (w.val x v)}
  zero_mem' := by sorry
  add_mem' := by sorry
  smul_mem' := by sorry

def invariantFormsDifferential (n : ℕ) : invariantForm Z rho n →ₗ[ℂ] invariantForm Z rho (n+1) := sorry

theorem invariantFormsDifferential_val (n : ℕ) (w : invariantForm Z rho n) :
    (invariantFormsDifferential Z rho n w).val=exteriorDerivative n w.val := sorry

def invariantForms : CochainComplex (ModuleCat ℂ) ℕ :=
  CochainComplex.of (fun n => ModuleCat.of ℂ (invariantForm Z rho n))
    (fun n => ModuleCat.ofHom (invariantFormsDifferential Z rho n)) (by sorry)

def invariantFormsEquivRelative (n : ℕ) : invariantForm Z rho n ≃ₗ[ℂ] cochains (Z.module rho hs) n := sorry

theorem invariantFormsEquivRelative_evaluation (n : ℕ) (w : invariantForm Z rho n)
    (X : Fin n → GroupLieAlgebra 𝓘(ℝ,E) G) :
    (invariantFormsEquivRelative Z rho hs n w).val
      (fun i => Z.phi.symm (1 ⊗ₜ[ℝ] X i))=
    w.val.val (QuotientGroup.mk (1 : G)) (fun i => mfderiv 𝓘(ℝ,E) 𝓘(ℝ,Z.model)
      (QuotientGroup.mk : G → G ⧸ K) 1 (X i)) := sorry

theorem invariantForms_d (n : ℕ) (w : invariantForm Z rho n) :
    invariantFormsEquivRelative Z rho hs (n+1) (invariantFormsDifferential Z rho n w)=
      differential (Z.module rho hs) n (invariantFormsEquivRelative Z rho hs n w) := sorry

/-- The geometric component action is the deck transformation xK° ↦ xkK°,
combined with the coefficient action; its comparison is on connected cochains. -/
def invariantForms_componentAction (n : ℕ) :
    Representation ℂ (TauCeti.RealReductive.Datum.componentGroupOf (G := K))
      (cochains (GKModule.restrict P.identityComponentHom (Z.module rho hs)) n) :=
  componentAction (Z.module rho hs) n

theorem invariantForms_componentAction_mk (n : ℕ) (k : K)
    (w : cochains (GKModule.restrict P.identityComponentHom (Z.module rho hs)) n) (X : Fin n → q) :
    (invariantForms_componentAction Z rho hs n (QuotientGroup.mk k) w).val X=
      rho k.val (w.val (fun i => P.Ad k⁻¹ (X i))) := sorry

/-- Independent compact averaging in every homogeneous cochain variable makes
cochains descend to (G/K)^(n+1) before their alternated derivative is taken. -/
def compactAverage (K : Subgroup G) [CompactSpace K] (n : ℕ) : smoothCochain (E := E) rho n →ₗ[ℂ] smoothCochain (E := E) rho n := sorry

theorem compactAverage_value (n : ℕ) (f : smoothCochain (E := E) rho n) (x : Fin (n+1) → G) :
    (compactAverage rho K n f).val.val x=
      ∫ k : Fin (n+1) → K, f.val.val (fun i => x i*(k i).val)
        ∂Measure.pi (fun _ => TauCeti.haarProb K) := sorry

def identityCurve (X : GroupLieAlgebra 𝓘(ℝ,E) G) (t : ℝ) : G :=
  (extChartAt 𝓘(ℝ,E) (1 : G)).symm
    ((extChartAt 𝓘(ℝ,E) (1 : G)) 1+t • (show E from X))

def vanEstDifferentiation : smoothCochains (E := E) rho ⟶ complex (Z.module rho hs) := sorry

/-- The permutation sign and all n derivatives fix the CE convention. -/
theorem vanEstDifferentiation_formula (n : ℕ) (f : smoothCochain (E := E) rho n)
    (X : Fin n → GroupLieAlgebra 𝓘(ℝ,E) G) :
    (((vanEstDifferentiation Z rho hs).f n).hom f).val
      (fun i => Z.phi.symm (1 ⊗ₜ[ℝ] X i))=
    ∑ s : Equiv.Perm (Fin n), ((s.sign : ℤ) : ℂ) •
      iteratedFDeriv ℝ n (fun t : Fin n → ℝ =>
        (compactAverage rho K n f).val.val
          (Fin.cons 1 (fun i => identityCurve (X (s i)) (t i)))) 0
        (fun i => Pi.single i (1 : ℝ)) := sorry

/-- The actual quotient contraction is the hypothesis for the cohomology isomorphism. -/
def vanEstIso (contract : Diffeomorph 𝓘(ℝ,Z.model) 𝓘(ℝ,Z.model) (G ⧸ K) Z.model ∞)
    (n : ℕ) : (continuousCochains rho).homology n ≃ₗ[ℂ] cohomology (Z.module rho hs) n := sorry

theorem vanEstIso_smoothing
    (contract : Diffeomorph 𝓘(ℝ,Z.model) 𝓘(ℝ,Z.model) (G ⧸ K) Z.model ∞)
    (n : ℕ) (f : (smoothCochains (E := E) rho).homology n) :
    vanEstIso Z rho hs contract n
      ((HomologicalComplex.homologyMap (smoothingInclusion (E := E) rho) n).hom f)=
      (cohomologyEquivMathlib (Z.module rho hs) n).symm
        ((HomologicalComplex.homologyMap (vanEstDifferentiation Z rho hs) n).hom f) := sorry

/-- Cartan–Iwasawa–Malcev for any real Lie group with finitely many components. -/
def quotient_maximalCompact_euclidean [Finite (ConnectedComponents G)]
    (hmax : ∀ L : Subgroup G, IsCompact (L : Set G) → K≤L → L=K) :
    Diffeomorph 𝓘(ℝ,Z.model) 𝓘(ℝ,Z.model) (G ⧸ K) Z.model ∞ := sorry

/-- Compact averaging is a chain map and preserves the homology comparison. -/
theorem compactAverage_d (n : ℕ) (f : smoothCochain (E := E) rho n) :
    smoothDifferential (E := E) rho n (compactAverage rho K n f)=
      compactAverage rho K (n+1) (smoothDifferential (E := E) rho n f) := sorry
end GeneralHomogeneous
end TauCeti.VanEst

