/-! The GL₁ algebraicity supplier below restates the interface of the current
TauCeti.GlobalNumberFields.HeckeCharacter library, not a new AF definition.
It is needed only because that post-pin module is absent from the shared build.
Real sign characters are unrestricted in Weil's type A₀ convention. -/
namespace TauCeti.Automorphic.Suppliers.GlobalNumberFields
open NumberField NumberField.InfinitePlace.Completion
variable {F : Type} [Field F] [NumberField F]

def HeckeCharacter.realComponent (chi : HeckeCharacter F)
    (v : InfinitePlace F) (hv : v.IsReal) : ℝˣ →ₜ* ℂˣ where
  toMonoidHom := chi.toMonoidHom.comp
    ((IdeleClassGroup.ofCompletion (RingOfIntegers F) F v).comp
      (Units.map (ringEquivRealOfIsReal hv).symm.toMonoidHom))
  continuous_toFun := by sorry

def HeckeCharacter.complexComponent (chi : HeckeCharacter F)
    (v : InfinitePlace F) (hv : v.IsComplex) : ℂˣ →ₜ* ℂˣ where
  toMonoidHom := chi.toMonoidHom.comp
    ((IdeleClassGroup.ofCompletion (RingOfIntegers F) F v).comp
      (Units.map (ringEquivComplexOfIsComplex hv).symm.toMonoidHom))
  continuous_toFun := by sorry

/-- The identity-component criterion of the existing supplier: integer real
exponents, and integer powers of z and its conjugate at a complex place. -/
def HeckeCharacter.IsAlgebraic (chi : HeckeCharacter F) : Prop :=
  (∀ v : InfinitePlace F, ∀ hv : v.IsReal, ∃ m : ℤ, ∀ x : ℝˣ, 0<(x : ℝ) →
    (chi.realComponent v hv x : ℂ)=Complex.exp ((m : ℂ)*(Real.log (x : ℝ) : ℂ))) ∧
  (∀ v : InfinitePlace F, ∀ hv : v.IsComplex, ∃ a b : ℤ, ∀ z : ℂˣ,
    (chi.complexComponent v hv z : ℂ)=(z : ℂ)^a*(star (z : ℂ))^b)
end TauCeti.Automorphic.Suppliers.GlobalNumberFields

