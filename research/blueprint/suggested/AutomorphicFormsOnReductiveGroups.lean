namespace TauCeti.RelativeLieCohomology
section CupNaturality
variable {E E' : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup E'] [NormedSpace ℝ E'] [FiniteDimensional ℝ E']
  {H H' : Type} [TopologicalSpace H] [TopologicalSpace H']
  {I : ModelWithCorners ℝ E H} {I' : ModelWithCorners ℝ E' H'}
  {K K' : Type} [Group K] [Group K'] [TopologicalSpace K] [TopologicalSpace K']
  [ChartedSpace H K] [ChartedSpace H' K'] [LieGroup I ∞ K] [LieGroup I' ∞ K']
  [CompactSpace K] [CompactSpace K'] [IsTopologicalGroup K] [IsTopologicalGroup K']
  {q q' : Type} [NormedComplexLieAlgebra q] [NormedComplexLieAlgebra q']
  {P : Pair I K q} {P' : Pair I' K' q'}
  {V W V' W' : Type} [AddCommGroup V] [Module ℂ V] [AddCommGroup W] [Module ℂ W]
  [AddCommGroup V'] [Module ℂ V'] [AddCommGroup W'] [Module ℂ W']

def tensorHom {A : GKModule P V} {B : GKModule P W}
    {A' : GKModule P V'} {B' : GKModule P W'} (f : GKModule.Hom A A') (g : GKModule.Hom B B') :
    GKModule.Hom (A.tensor B) (A'.tensor B') where
  toLinearMap := TensorProduct.map f.toLinearMap g.toLinearMap
  lie := by sorry
  group := by sorry

theorem cup_coefficient_natural {A : GKModule P V} {B : GKModule P W}
    {A' : GKModule P V'} {B' : GKModule P W'} (f : GKModule.Hom A A') (g : GKModule.Hom B B')
    (p r : ℕ) (a : cohomology A p) (b : cohomology B r) :
    cohomology_map _ _ (tensorHom f g) (p+r) (cup A B p r a b)=
      cup A' B' p r (cohomology_map A A' f p a) (cohomology_map B B' g r b) := sorry

def restrictionTensor (h : Pair.Hom P P') (A : GKModule P' V) (B : GKModule P' W) :
    GKModule.Hom (GKModule.restrict h (A.tensor B))
      ((GKModule.restrict h A).tensor (GKModule.restrict h B)) where
  toLinearMap := LinearMap.id
  lie := by sorry
  group := by sorry

theorem cup_pairRestriction (h : Pair.Hom P P') (A : GKModule P' V) (B : GKModule P' W)
    (p r : ℕ) (a : cohomology A p) (b : cohomology B r) :
    cohomology_map _ _ (restrictionTensor h A B) (p+r)
      (cohomology_restrict h (A.tensor B) (p+r) (cup A B p r a b))=
      cup (GKModule.restrict h A) (GKModule.restrict h B) p r
        (cohomology_restrict h A p a) (cohomology_restrict h B r b) := sorry
end CupNaturality
end TauCeti.RelativeLieCohomology

namespace TauCeti.VanEst
open TauCeti.RelativeLieCohomology CategoryTheory
section FiniteCoefficientProducts
variable {E Ek : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup Ek] [NormedSpace ℝ Ek] [FiniteDimensional ℝ Ek]
  {G : Type} [Group G] [TopologicalSpace G] [ChartedSpace E G] [LieGroup 𝓘(ℝ,E) ∞ G]
  [T2Space G] [IsTopologicalGroup G] [LocallyCompactSpace G] [SecondCountableTopology G]
  {K : Subgroup G} [CompactSpace K] [ChartedSpace Ek K] [LieGroup 𝓘(ℝ,Ek) ∞ K]
  {q : Type} [NormedComplexLieAlgebra q] {P : Pair 𝓘(ℝ,Ek) K q}
  [MeasurableSpace K] [BorelSpace K] (Z : HomogeneousLieDatum (E := E) K P)
  {V W U : Type} [NormedAddCommGroup V] [NormedSpace ℂ V] [FiniteDimensional ℂ V]
  [NormedAddCommGroup W] [NormedSpace ℂ W] [FiniteDimensional ℂ W]
  [NormedAddCommGroup U] [NormedSpace ℂ U] [FiniteDimensional ℂ U]
  (rho : ContRepresentation ℂ G V) (sigma : ContRepresentation ℂ G W)
  (tau : ContRepresentation ℂ G U)
  (hr : ∀ v, ContMDiff 𝓘(ℝ,E) 𝓘(ℝ,V) ∞ (fun g => rho g v))
  (hs : ∀ v, ContMDiff 𝓘(ℝ,E) 𝓘(ℝ,W) ∞ (fun g => sigma g v))
  (ht : ∀ v, ContMDiff 𝓘(ℝ,E) 𝓘(ℝ,U) ∞ (fun g => tau g v))
  (beta : V →L[ℂ] W →L[ℂ] U)
  (hb : ∀ g v w, beta (rho g v) (sigma g w)=tau g (beta v w))

/-- A continuous equivariant pairing avoids imposing an arbitrary topology on
an algebraic tensor product. The universal tensor statement follows by transport. -/
def continuousCupWith (beta : V →L[ℂ] W →L[ℂ] U)
    (hb : ∀ g v w, beta (rho g v) (sigma g w)=tau g (beta v w)) (p r : ℕ) : (continuousCochains rho).homology p →ₗ[ℂ]
    (continuousCochains sigma).homology r →ₗ[ℂ] (continuousCochains tau).homology (p+r) := sorry

def continuousCupWithCochain (beta : V →L[ℂ] W →L[ℂ] U)
    (hb : ∀ g v w, beta (rho g v) (sigma g w)=tau g (beta v w)) (p r : ℕ) : continuousCochain rho p →ₗ[ℂ]
    continuousCochain sigma r →ₗ[ℂ] continuousCochain tau (p+r) := sorry

theorem continuousCupWithCochain_value (p r : ℕ) (a : continuousCochain rho p)
    (b : continuousCochain sigma r) (x : Fin (p+r+1) → G) :
    (continuousCupWithCochain rho sigma tau beta hb p r a b).val x=
      beta (a.val (fun i => x ⟨i.val,by omega⟩)) (b.val (fun i => x ⟨p+i.val,by omega⟩)) := sorry

def pairingHom (hb : ∀ g v w, beta (rho g v) (sigma g w)=tau g (beta v w)) : GKModule.Hom ((Z.module rho hr).tensor (Z.module sigma hs)) (Z.module tau ht) where
  toLinearMap := TensorProduct.lift (LinearMap.mk₂ ℂ (fun v w => beta v w)
    (by sorry) (by sorry) (by sorry) (by sorry))
  lie := by sorry
  group := by sorry

def continuousCohomologyClass {V : Type} [NormedAddCommGroup V] [NormedSpace ℂ V]
    (rho : ContRepresentation ℂ G V) (p : ℕ) :
    LinearMap.ker (continuousDifferential rho p) →ₗ[ℂ] (continuousCochains rho).homology p := sorry

theorem continuousCohomologyClass_kernel {V : Type} [NormedAddCommGroup V] [NormedSpace ℂ V]
    (rho : ContRepresentation ℂ G V) (p : ℕ) :
    LinearMap.ker (continuousCohomologyClass rho p)=
      Submodule.comap (LinearMap.ker (continuousDifferential rho p)).subtype
        (Submodule.span ℂ {f | ∃ n : ℕ, ∃ h : n+1=p, ∃ b : continuousCochain rho n,
          HEq f (continuousDifferential rho n b)}) := sorry

theorem continuousCupWith_represents (p r : ℕ)
    (a : LinearMap.ker (continuousDifferential rho p))
    (b : LinearMap.ker (continuousDifferential sigma r)) :
    ∃ z : LinearMap.ker (continuousDifferential tau (p+r)),
      z.val=continuousCupWithCochain rho sigma tau beta hb p r a.val b.val ∧
      continuousCupWith rho sigma tau beta hb p r
        ((continuousCohomologyClass rho p) a) ((continuousCohomologyClass sigma r) b)=
          continuousCohomologyClass tau (p+r) z := sorry

/-- Differentiation carries the homogeneous product to the relative shuffle
product followed by the specified coefficient pairing. -/
theorem vanEstIso_cup
    (contract : Diffeomorph 𝓘(ℝ,Z.model) 𝓘(ℝ,Z.model) (G ⧸ K) Z.model ∞)
    (p r : ℕ) (a : (continuousCochains rho).homology p)
    (b : (continuousCochains sigma).homology r) :
    vanEstIso Z tau ht contract (p+r) (continuousCupWith rho sigma tau beta hb p r a b)=
      cohomology_map _ _ (pairingHom Z rho sigma tau hr hs ht beta hb) (p+r)
        (cup (Z.module rho hr) (Z.module sigma hs) p r
          (vanEstIso Z rho hr contract p a) (vanEstIso Z sigma hs contract r b)) := sorry
end FiniteCoefficientProducts
end TauCeti.VanEst


namespace TauCeti.Automorphic.GSp4
open TauCeti.RealReductive TauCeti.RelativeLieCohomology
open TauCeti.Automorphic.Suppliers.ReductiveGroupsPartII

/-- Each closed compact-dominant chamber has its own positive root system,
even on a shared noncompact wall. -/
def chamberPositiveRoots (i : Fin 4) : Finset (ℤ × ℤ × ℤ) :=
  {(1,-1,0)} ∪ match i with
    | 0 => {(2,0,0),(0,2,0),(1,1,0)}
    | 1 => {(2,0,0),(0,-2,0),(1,1,0)}
    | 2 => {(2,0,0),(0,-2,0),(-1,-1,0)}
    | 3 => {(-2,0,0),(0,-2,0),(-1,-1,0)}

def centralUnitarizing (c : ℝ) : SmoothCharacter D := sorry

theorem centralUnitarizing_value (c : ℝ) (g : realPoints Coordinate) :
    ((centralUnitarizing c).character g : ℂ)=
      Complex.exp ((-(c : ℂ)/2)*(Real.log |(multiplier 2 g : ℝ)| : ℂ)) := sorry

/-- The constructor's normalized class is the classified discrete or
nondegenerate limit class for the actual Cartan and selected positive roots. -/
theorem dsRep_classified (lambda : ℝ × ℝ × ℝ) (i : Fin 4)
    (hc : lambda∈chamber i)
    (hint : ∃ a b c : ℤ, lambda=((a : ℝ),(b : ℝ),(c : ℝ)) ∧ (a+b-c)%2=1)
    (hnd : lambda.1≠lambda.2.1) :
    ∃ (C : CompactCartan D) (hC : C.roots.h=cartan.h)
      (p : DiscreteSeriesParameter C) (hp : p.NonDegenerate),
      identityTwist D (centralUnitarizing lambda.2.2) (dsRep lambda i hc hint hnd)=
        identityDiscreteSeries D C p hp ∧
      (∀ H : cartan.h, p.lambda ⟨H.val,by rw [hC]; exact H.property⟩=
        parameter (lambda.1,lambda.2.1,0) H) ∧
      ∀ alpha : ℤ × ℤ × ℤ, alpha∈chamberPositiveRoots i ↔
        ∃ beta : C.roots.rootIndex, C.roots.b.IsPos beta ∧
          ∀ H : cartan.h,
            C.roots.R.root beta ⟨H.val,by rw [hC]; exact H.property⟩=
              Complex.I*((alpha.1 : ℂ)*(cartanCoordinates H).1+
                (alpha.2.1 : ℂ)*(cartanCoordinates H).2.1) := sorry
end TauCeti.Automorphic.GSp4

