namespace TauCeti.RealReductive
open CategoryTheory TauCeti.RelativeLieCohomology
section InductionInStages
variable {A : Type} [CommRing A] [HopfAlgebra ℝ A] [Algebra.FiniteType ℝ A]
  [Algebra.Smooth ℝ A] (D : Datum A)
  {l : A →ₐc[ℝ] LaurentPolynomial ℝ} (L : LeviDatum D l)
  {r : L.coordinate →ₐc[ℝ] LaurentPolynomial ℝ} (R : LeviDatum L.datum r)

/-- RG2's nested parabolic and its Levi, specified on actual point inclusions.
No induction isomorphism or modular-character identity is an input. -/
structure LeviTower where
  nested : A →ₐc[ℝ] LaurentPolynomial ℝ
  direct : LeviDatum D nested
  inclusion : realParabolic nested≤realParabolic l
  parabolic : ∀ p : realParabolic l,
    p.val∈realParabolic nested ↔ L.parabolicMap D p∈realParabolic r
  leviIso : Datum.Iso R.datum direct.datum
  levi_points : ∀ m : realPoints R.coordinate,
    realPoints_map direct.inclusion (leviIso.points m)=
      realPoints_map L.inclusion (realPoints_map R.inclusion m)

variable {D L R}
def LeviTower.innerProjection (T : LeviTower D L R) :
    realParabolic T.nested →* realParabolic r := sorry

theorem LeviTower.innerProjection_val (T : LeviTower D L R)
    (p : realParabolic T.nested) :
    (T.innerProjection p).val=L.parabolicMap D ⟨p.val,T.inclusion p.property⟩ := sorry

theorem LeviTower.modular_product (T : LeviTower D L R)
    (p : realParabolic T.nested) :
    (parabolicDelta T.nested p : ℝ)=
      (parabolicDelta l ⟨p.val,T.inclusion p.property⟩ : ℝ)*
        (parabolicDelta r (T.innerProjection p) : ℝ) := sorry

def LeviTower.totalCharacter (T : LeviTower D L R)
    (outer : InducingCharacter l) (inner : InducingCharacter r) : InducingCharacter T.nested := sorry

theorem LeviTower.totalCharacter_value (T : LeviTower D L R)
    (outer : InducingCharacter l) (inner : InducingCharacter r) (p : realParabolic T.nested) :
    (T.totalCharacter outer inner).character p=
      outer.character ⟨p.val,T.inclusion p.property⟩*inner.character (T.innerProjection p) := sorry

/-- Transport retains the supplied smooth realization and its full topology. -/
def Datum.Iso.pushSAF {B : Type} [CommRing B] [HopfAlgebra ℝ B]
    [Algebra.FiniteType ℝ B] [Algebra.Smooth ℝ B] {D' : Datum B}
    (e : Datum.Iso D D') (sigma : SAFModuleCat D) : SAFModuleCat D' := sorry

def Datum.Iso.pushSAFCarrier {B : Type} [CommRing B] [HopfAlgebra ℝ B]
    [Algebra.FiniteType ℝ B] [Algebra.Smooth ℝ B] {D' : Datum B}
    (e : Datum.Iso D D') (sigma : SAFModuleCat D) :
    (e.pushSAF sigma).S ≃L[ℂ] sigma.S := sorry

theorem Datum.Iso.pushSAF_action {B : Type} [CommRing B] [HopfAlgebra ℝ B]
    [Algebra.FiniteType ℝ B] [Algebra.Smooth ℝ B] {D' : Datum B}
    (e : Datum.Iso D D') (sigma : SAFModuleCat D) (g : realPoints B) (v) :
    e.pushSAFCarrier sigma ((e.pushSAF sigma).representation.π g v)=
      sigma.representation.π (e.points.symm g) (e.pushSAFCarrier sigma v) := sorry

/-- Normalized induction in stages is an isomorphism of the two constructed SAF
objects. The half-modular exponents add by the determinant identity above. -/
def normalizedInduction.transitivity (T : LeviTower D L R)
    (sigma : SAFModuleCat R.datum) (outer : InducingCharacter l) (inner : InducingCharacter r) :
    normalizedInduction.ofLevi D L (normalizedInduction.ofLevi L.datum R sigma inner) outer ≅
      normalizedInduction.ofLevi D T.direct (T.leviIso.pushSAF sigma)
        (T.totalCharacter outer inner) := sorry

/-- Evaluation at the identity of the inner inducing function fixes this
isomorphism, in addition to its equivariance and continuous inverse. -/
theorem normalizedInduction.transitivity_evaluation (T : LeviTower D L R)
    (sigma : SAFModuleCat R.datum) (outer : InducingCharacter l) (inner : InducingCharacter r)
    (f : (normalizedInduction.ofLevi D L
      (normalizedInduction.ofLevi L.datum R sigma inner) outer).S) (g : realPoints A) :
    T.leviIso.pushSAFCarrier sigma
      ((normalizedInduction.ofLeviCarrier D T.direct (T.leviIso.pushSAF sigma)
        (T.totalCharacter outer inner)
        ((normalizedInduction.transitivity T sigma outer inner).hom.toContinuousLinearMap f)).val g)=
    (normalizedInduction.ofLeviCarrier L.datum R sigma inner
      ((normalizedInduction.ofLeviCarrier D L
        (normalizedInduction.ofLevi L.datum R sigma inner) outer f).val g)).val 1 := sorry
end InductionInStages
end TauCeti.RealReductive

