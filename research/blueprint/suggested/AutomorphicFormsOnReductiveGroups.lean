section ComponentAndProducts
variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {K : Type} [Group K] [TopologicalSpace K] [ChartedSpace H K]
  [LieGroup I ∞ K] [CompactSpace K] {q : Type} [NormedComplexLieAlgebra q]
  [IsTopologicalGroup K] (P : Pair I K q)

abbrev CompactIdentity := Subgroup.connectedComponentOfOne K

/-- The identity component is an open Lie subgroup, with the inherited charts. -/
instance : ChartedSpace H (CompactIdentity (K := K)) := sorry
instance : LieGroup I ∞ (CompactIdentity (K := K)) := sorry
instance : CompactSpace (CompactIdentity (K := K)) := sorry

def Pair.identityComponent (P : Pair I K q) : Pair I (CompactIdentity (K := K)) q := sorry

def Pair.identityComponentHom : Pair.Hom P.identityComponent P := sorry

theorem Pair.identityComponentHom_group (k : CompactIdentity (K := K)) :
    P.identityComponentHom.group k = k.val := sorry

theorem Pair.identityComponentHom_lie (X : q) :
    P.identityComponentHom.lie X = X := sorry

variable {P} {V W : Type} [AddCommGroup V] [Module ℂ V] [AddCommGroup W] [Module ℂ W]

/-- Tensor products are locally K-finite even when neither factor is finite dimensional. -/
def GKModule.tensor (A : GKModule P V) (B : GKModule P W) : GKModule P (V ⊗[ℂ] W) := sorry

theorem GKModule.tensor_lie (A : GKModule P V) (B : GKModule P W)
    (X : q) (v : V) (w : W) :
    (A.tensor B).rho X (v ⊗ₜ[ℂ] w) = A.rho X v ⊗ₜ[ℂ] w + v ⊗ₜ[ℂ] B.rho X w := sorry

def pairRestriction (h : Pair.Hom P P) (A : GKModule P V) (n : ℕ) :
    cochains A n →ₗ[ℂ] cochains (GKModule.restrict h A) n := sorry

theorem pairRestriction_apply (h : Pair.Hom P P) (A : GKModule P V) (n : ℕ)
    (w : cochains A n) (x : Fin n → q) :
    (pairRestriction h A n w).val x = w.val (fun i => h.lie (x i)) := sorry

def componentAction (A : GKModule P V) (n : ℕ) :
    Representation ℂ (TauCeti.RealReductive.Datum.componentGroupOf (G := K))
      (cochains (GKModule.restrict P.identityComponentHom A) n) := sorry

theorem componentAction_mk (A : GKModule P V) (n : ℕ) (k : K)
    (w : cochains (GKModule.restrict P.identityComponentHom A) n) (x : Fin n → q) :
    (componentAction A n (QuotientGroup.mk k) w).val x =
      A.sigma k (w.val (fun i => P.Ad k⁻¹ (x i))) := sorry

def componentCohomologyAction (A : GKModule P V) (n : ℕ) :
    Representation ℂ (TauCeti.RealReductive.Datum.componentGroupOf (G := K))
      (cohomology (GKModule.restrict P.identityComponentHom A) n) := sorry

def fixedVectors {L U : Type} [Group L] [AddCommGroup U] [Module ℂ U]
    (σ : Representation ℂ L U) : Submodule ℂ U where
  carrier := {v | ∀ l, σ l v = v}
  zero_mem' := sorry
  add_mem' := sorry
  smul_mem' := sorry

/-- Both cochains and cohomology retain the finite disconnected component action. -/
def disconnected (A : GKModule P V) (n : ℕ) :
    (cochains A n ≃ₗ[ℂ] fixedVectors (componentAction A n)) ×
    (cohomology A n ≃ₗ[ℂ] fixedVectors (componentCohomologyAction A n)) := sorry

def cupCochain (A : GKModule P V) (B : GKModule P W) (p r : ℕ) :
    cochains A p →ₗ[ℂ] cochains B r →ₗ[ℂ] cochains (A.tensor B) (p+r) := sorry

theorem cupCochain_apply (A : GKModule P V) (B : GKModule P W) (p r : ℕ)
    (a : cochains A p) (b : cochains B r) (x : Fin (p+r) → q) :
    (cupCochain A B p r a b).val x =
      ∑ σ : Equiv.Perm (Fin (p+r)),
        if (StrictMono (fun i : Fin p => σ (Fin.castAdd r i))) ∧
           (StrictMono (fun i : Fin r => σ (Fin.natAdd p i))) then
          ((σ.sign : ℤ) : ℂ) •
            (a.val (fun i => x (σ (Fin.castAdd r i))) ⊗ₜ[ℂ]
             b.val (fun i => x (σ (Fin.natAdd p i))))
        else 0 := sorry

theorem cupCochain_d (A : GKModule P V) (B : GKModule P W) (p r : ℕ)
    (a : cochains A p) (b : cochains B r) (x : Fin (p+r+1) → q) :
    (differential (A.tensor B) (p+r) (cupCochain A B p r a b)).val x =
      (cupCochain A B (p+1) r (differential A p a) b).val
        (fun i => x (Fin.cast (by omega) i)) +
        (-1 : ℂ)^p • (cupCochain A B p (r+1) a (differential B r b)).val
          (fun i => x (Fin.cast (by omega) i)) := sorry

def cup (A : GKModule P V) (B : GKModule P W) (p r : ℕ) :
    cohomology A p →ₗ[ℂ] cohomology B r →ₗ[ℂ] cohomology (A.tensor B) (p+r) := sorry
end ComponentAndProducts
end TauCeti.RelativeLieCohomology

namespace TauCeti.RelativeLieCohomology
section RelativeExt
open CategoryTheory
variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {K : Type} [Group K] [TopologicalSpace K] [ChartedSpace H K]
  [LieGroup I ∞ K] [CompactSpace K] {q : Type} [NormedComplexLieAlgebra q]
  (P : Pair I K q)

instance : Linear ℂ (GKModuleCat.{0} P) := sorry
/-- Relative induced modules provide projectives; compact K makes the coefficient
category semisimple, so exact sequences split on K. This is a proof obligation. -/
instance : EnoughProjectives (GKModuleCat.{0} P) := sorry

def GKModuleCat.of {V : Type} [AddCommGroup V] [Module ℂ V] (A : GKModule P V) :
    GKModuleCat.{0} P where
  carrier := V
  action := A

def relativeExt {V : Type} [AddCommGroup V] [Module ℂ V] (A : GKModule P V) (n : ℕ) :
    cohomology A n ≃ₗ[ℂ]
      (((Ext.{0,0,1} ℂ (GKModuleCat.{0} P) n).obj (Opposite.op (GKModuleCat.of P (GKModule.trivial P)))).obj
        (GKModuleCat.of P A)) := sorry
end RelativeExt

section PairRestriction
variable {E E' : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup E'] [NormedSpace ℝ E'] [FiniteDimensional ℝ E']
  {H H' : Type} [TopologicalSpace H] [TopologicalSpace H']
  {I : ModelWithCorners ℝ E H} {I' : ModelWithCorners ℝ E' H'}
  {K K' : Type} [Group K] [Group K'] [TopologicalSpace K] [TopologicalSpace K']
  [ChartedSpace H K] [ChartedSpace H' K'] [LieGroup I ∞ K] [LieGroup I' ∞ K']
  [CompactSpace K] [CompactSpace K'] {q q' : Type}
  [NormedComplexLieAlgebra q] [NormedComplexLieAlgebra q']
  {P : Pair I K q} {P' : Pair I' K' q'} {V : Type} [AddCommGroup V] [Module ℂ V]

def cochains_restrict (h : Pair.Hom P P') (A : GKModule P' V) (n : ℕ) :
    cochains A n →ₗ[ℂ] cochains (GKModule.restrict h A) n := sorry

theorem cochains_restrict_apply (h : Pair.Hom P P') (A : GKModule P' V) (n : ℕ)
    (w : cochains A n) (x : Fin n → q) :
    (cochains_restrict h A n w).val x = w.val (fun i => h.lie (x i)) := sorry

theorem cochains_restrict_d (h : Pair.Hom P P') (A : GKModule P' V) (n : ℕ) :
    (differential (GKModule.restrict h A) n).comp (cochains_restrict h A n) =
      (cochains_restrict h A (n+1)).comp (differential A n) := sorry

def cohomology_restrict (h : Pair.Hom P P') (A : GKModule P' V) (n : ℕ) :
    cohomology A n →ₗ[ℂ] cohomology (GKModule.restrict h A) n := sorry
end PairRestriction
