section StronglyTests

variable (p : ℕ) [Fact p.Prime]

/- Affinoid form: in characteristic `p`, strongly finite étale is finite étale (with natural
topology and integral-closure plus ring), by P3/finite-etale-covers-in-characteristic-p. -/
-- test PerfectoidSpace.IsStronglyFiniteEtale.test_charp (characterisation)
--   [P3/strongly-etale-morphisms-and-base-change]
example {R S : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CharP R p]
    [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S] [IsTateRing S]
    [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S] {P : Pair R} {Q : Pair S}
    (φ : Pair.Hom P Q) :
    Perfectoid.Pair.IsStronglyFiniteEtale p R φ ↔ φ.toRingHom.Finite ∧
      (letI := φ.toRingHom.toAlgebra; _root_.Algebra.Etale R S) ∧
      (letI := φ.toRingHom.toAlgebra; IsModuleTopology R S) ∧
      (Q.plus : Set S) = integralClosure (P.plus.map φ.toRingHom) S := sorry

-- PerfectoidSpace.IsStronglyEtale.test_open: not stated here; needs open immersions of
--   perfectoid spaces (supplier: AdicSpaces Layer 5) [degenerate test]

/- Affinoid form: `φ` is strongly finite étale iff `φ♭` is. -/
-- test PerfectoidSpace.IsStronglyFiniteEtale.test_tilt (compatibility)
--   [P3/strongly-etale-morphisms-and-base-change]
example {R S : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CommRing S]
    [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S]
    [T2Space S] [IsPerfectoidTateRing p S] {P : Pair R} {Q : Pair S} (φ : Pair.Hom P Q) :
    Perfectoid.Pair.IsStronglyFiniteEtale p R φ ↔
      Perfectoid.Pair.IsStronglyFiniteEtale p (tilt p R) (Perfectoid.Pair.tiltHom p φ) := sorry

/- Affinoid form: for a perfectoid field `K` and `K⁺ ⊊ K°`, the diagonal
`(K, K⁺) → (K × K, K° × K°)` is not strongly finite étale although `K → K × K` is finite
étale: the plus ring must be the integral closure `K⁺ × K⁺`. -/
-- test PerfectoidSpace.IsStronglyFiniteEtale.test_plus_ring (non-example)
--   [P3/strongly-etale-morphisms-and-base-change]
example (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [IsPerfectoidField p K] (P : Pair K) (hP : P.plus < powerBoundedSubring K) (Q : Pair (K × K))
    (hQ : Q.plus = (powerBoundedSubring K).prod (powerBoundedSubring K)) (φ : Pair.Hom P Q)
    (hφ : φ.toRingHom = RingHom.prod (RingHom.id K) (RingHom.id K)) :
    ¬ Perfectoid.Pair.IsStronglyFiniteEtale p K φ := sorry

