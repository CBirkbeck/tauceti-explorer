/-! ## PerfectoidSpaces:P5/countable-perfectoid-hull (lemma) -/

namespace Perfectoid

section CountablyGenerated

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P5/countable-perfectoid-hull (data): the family `𝒮(R)` of closed subrings `R' ⊆ R` containing
`ϖ^{±1}` and all `ϖ^{1/pⁿ}` that have a countable dense subset and are perfectoid Tate rings for
the subspace topology (ECD proof of Proposition 6.5). -/
def separablePerfectoidSubrings_P5 (ϖ : PseudoUniformizerRoots p R) : Set (Subring R) :=
  {R' | IsClosed (R' : Set R) ∧ (∀ n, ϖ.root n ∈ R') ∧ ((ϖ.zpow (-1) 0 : Rˣ) : R) ∈ R' ∧
    TopologicalSpace.SeparableSpace R' ∧
    ∃ (_ : IsTateRing R') (_ : CompleteSpace R'), IsPerfectoidTateRing p R'}

/-- P5/countable-perfectoid-hull (ECD proof of Proposition 6.5; ECD Remark 4.3): every countable
subset `C` of a perfectoid Tate ring lies in some `R' ∈ 𝒮(R)`; `R'⁺ = R' ∩ R⁺` is a ring of
integral elements of `R'`, `R'° = R' ∩ R°`, and `|R'| ≤ 2^{ℵ₀}`. -/
theorem exists_countable_perfectoid_hull (P : Pair R) (ϖ : PseudoUniformizerRoots p R)
    (hϖ : ∀ n, ϖ.root n ∈ P.plus) (C : Set R) (hC : C.Countable) :
    ∃ R' ∈ separablePerfectoidSubrings_P5 p ϖ, C ⊆ R' ∧ Cardinal.mk R' ≤ Cardinal.continuum ∧
      ∃ _ : IsTateRing R', IsRingOfIntegralElements (P.plus.comap R'.subtype) ∧
        (powerBoundedSubring R').map R'.subtype = R' ⊓ powerBoundedSubring R := sorry

end CountablyGenerated

end Perfectoid

/-! ## PerfectoidSpaces:P5/countably-generated-decomposition (theorem) -/

namespace Perfectoid

section Decomposition

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P5/countably-generated-decomposition (a), (b), (d) (ECD Proposition 6.5): `𝒮(R)` is
`ω₁`-directed (every countable subfamily has an upper bound in `𝒮(R)`), hence `ℵ₁`-filtered as a
poset, and exhausts `R`, so `colim_{R' ∈ 𝒮(R)} (R', R'⁺) → (R, R⁺)` is an isomorphism without
completion; every `R' ∈ 𝒮(R)` has `|R'| ≤ 2^{ℵ₀}`. -/
theorem iSup_perfectoidSeparableSubrings (ϖ : PseudoUniformizerRoots p R) :
    (∀ S ⊆ separablePerfectoidSubrings_P5 p ϖ, S.Countable →
      ∃ R' ∈ separablePerfectoidSubrings_P5 p ϖ, ∀ R'' ∈ S, R'' ≤ R') ∧
    IsCardinalFiltered (separablePerfectoidSubrings_P5 p ϖ) (Cardinal.aleph.{u} 1) ∧
    ⨆ (R' : Subring R) (_ : R' ∈ separablePerfectoidSubrings_P5 p ϖ), R' = ⊤ ∧
    ∀ R' ∈ separablePerfectoidSubrings_P5 p ϖ, Cardinal.mk R' ≤ Cardinal.continuum := sorry

end Decomposition

