/-! ## PerfectoidSpaces:P3/strongly-etale-morphisms-and-base-change (definition) -/

section StronglyFiniteEtale

variable (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P3/strongly-etale-morphisms-and-base-change (data): a morphism `φ : (R, R⁺) → (S, S⁺)` of
perfectoid Huber pairs is *strongly finite étale* (Sch12 Definition 7.2(i), over any perfectoid
base) if `R → S` is finite étale, `S` carries the natural topology, `S⁺` is the integral closure
of `R⁺`, and `S°ᵃ` is almost finite étale over `R°ᵃ` (stage P0). -/
structure Pair.IsStronglyFiniteEtale {S : Type u} [CommRing S] [UniformSpace S]
    [IsUniformAddGroup S] [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]
    [IsPerfectoidTateRing p S] {P : Pair R} {Q : Pair S} (φ : Pair.Hom P Q) : Prop where
  /-- `R → S` is finite. -/
  finite : φ.toRingHom.Finite
  /-- `R → S` is étale. -/
  etale : letI := φ.toRingHom.toAlgebra; _root_.Algebra.Etale R S
  /-- `S` carries its natural topology as a finite `R`-module. -/
  isModuleTopology : letI := φ.toRingHom.toAlgebra; IsModuleTopology R S
  /-- `S⁺` is the integral closure of `R⁺`. -/
  plus_eq : (Q.plus : Set S) = integralClosure (P.plus.map φ.toRingHom) S
  /-- `S°ᵃ` is almost finite étale over `R°ᵃ`. -/
  almostFiniteEtale : letI := (powerBoundedMap p φ.toRingHom φ.continuous_toRingHom).toAlgebra
    Almost.IsAlmostFiniteEtaleAlg (almostSetup p R) (powerBoundedSubring S)

end StronglyFiniteEtale

end Perfectoid

namespace PerfectoidSpace

open Perfectoid

section StronglyAffinoid

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  {S : Type u} [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S]
  [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S] {P : Pair R}
  {Q : Pair S}

/-- P3/strongly-etale-morphisms-and-base-change (a), affinoid core: `φ` is strongly finite étale
iff its tilt `φ♭` (stage P1's `Pair.tiltHom`) is (Sch12 after Definition 7.2). -/
theorem IsStronglyFiniteEtale.tilt_iff_affinoid (φ : Pair.Hom P Q) :
    Perfectoid.Pair.IsStronglyFiniteEtale p R φ ↔
      Perfectoid.Pair.IsStronglyFiniteEtale p (tilt p R) (Perfectoid.Pair.tiltHom p φ) := sorry

/-- P3/strongly-etale-morphisms-and-base-change (d), affinoid core (almost purity): a morphism
of perfectoid Huber pairs that is finite étale with natural topology and integral-closure plus
ring is strongly finite étale (Sch12 after Theorem 7.9; P3/etale-is-strongly-etale). -/
theorem IsStronglyFiniteEtale.iff_isFiniteEtale_affinoid (φ : Pair.Hom P Q) :
    Perfectoid.Pair.IsStronglyFiniteEtale p R φ ↔ φ.toRingHom.Finite ∧
      (letI := φ.toRingHom.toAlgebra; _root_.Algebra.Etale R S) ∧
      (letI := φ.toRingHom.toAlgebra; IsModuleTopology R S) ∧
      (Q.plus : Set S) = integralClosure (P.plus.map φ.toRingHom) S := sorry

/-- P3/strongly-etale-morphisms-and-base-change (c), affinoid core: composites of strongly finite
étale morphisms of perfectoid pairs are strongly finite étale (Sch12 Corollary 7.8). -/
theorem IsStronglyFiniteEtale.comp_affinoid {T : Type u} [CommRing T] [UniformSpace T]
    [IsUniformAddGroup T] [IsTopologicalRing T] [IsTateRing T] [CompleteSpace T] [T2Space T]
    [IsPerfectoidTateRing p T] {U : Pair T} {φ : Pair.Hom P Q} {ψ : Pair.Hom Q U}
    (hφ : Perfectoid.Pair.IsStronglyFiniteEtale p R φ)
    (hψ : Perfectoid.Pair.IsStronglyFiniteEtale p S ψ) :
    Perfectoid.Pair.IsStronglyFiniteEtale p R (ψ.comp φ) := sorry

/-- P3/finite-etale-morphism-of-perfectoid-spaces, affinoid core of
`PerfectoidSpace.IsFiniteEtale.spa`: for `S ∈ FÉt(R)` with its natural topology and `S⁺` the
integral closure of `R⁺`, the structure map `(R, R⁺) → (S, S⁺)` is strongly finite étale (ECD
Definition 6.2(i) and the paragraph after it). -/
theorem IsFiniteEtale.spa_affinoid [_root_.Algebra R S] [Module.Finite R S]
    [_root_.Algebra.Etale R S] [IsModuleTopology R S] (φ : Pair.Hom P Q)
    (hφ : φ.toRingHom = algebraMap R S)
    (hQ : (Q.plus : Set S) = integralClosure (P.plus.map (algebraMap R S)) S) :
    Perfectoid.Pair.IsStronglyFiniteEtale p R φ := sorry

end StronglyAffinoid

