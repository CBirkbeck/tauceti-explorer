/-! ## PerfectoidSpaces:P4/surjective-perfectoid-map-almost-surjective-on-plus-rings (lemma) -/

namespace Perfectoid

section AlmostSurjective

variable (p : ℕ) [Fact p.Prime] {R S : Type u} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R] [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
  [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S]

/-- P4/surjective-perfectoid-map-almost-surjective-on-plus-rings (AWS Lemma 2.8.5; KL
Proposition 3.6.9 (c)): a surjective continuous homomorphism `ψ : R → S` of perfectoid Tate rings
is almost surjective on power-bounded subrings: for every pseudo-uniformizer `ϖ` of `R` with
compatible roots, `S°/ψ(R°)` is killed by every `ϖ^{1/pⁿ}` (equivalently, the quotient seminorm of
the spectral norm of `R` is the spectral norm of `S`). -/
theorem almostSurjective_powerBounded_of_surjective (f : R →+* S) (hf : Continuous f)
    (hs : Function.Surjective f) (ϖ : PseudoUniformizerRoots p R) :
    ∀ n, ∀ s ∈ powerBoundedSubring S, f (ϖ.root n) * s ∈ (powerBoundedSubring R).map f := sorry

/-- P4/surjective-perfectoid-map-almost-surjective-on-plus-rings (Tor Lemma II.2.8): for rings of
integral elements `R⁺`, `S⁺` with `ψ(R⁺) ⊆ S⁺`, `S⁺/ψ(R⁺)` is killed by every `ϖ^{1/pⁿ}`. -/
theorem almostSurjective_plus_of_surjective {P : Pair R} {Q : Pair S} (f : Pair.Hom P Q)
    (hs : Function.Surjective f.toRingHom) (ϖ : PseudoUniformizerRoots p R) :
    ∀ n, ∀ s ∈ Q.plus, f.toRingHom (ϖ.root n) * s ∈ P.plus.map f.toRingHom := sorry

end AlmostSurjective

/-! ## PerfectoidSpaces:P4/surjections-and-closed-ideals-under-tilting (lemma) -/

section SurjectionsTilting

variable (p : ℕ) [Fact p.Prime] {R S : Type u} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R] [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
  [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]

/-- P4/surjections-and-closed-ideals-under-tilting (a) (AWS Theorem 2.4.4 (a)): a uniform complete
Tate ring `S` receiving a continuous surjection from a perfectoid Tate ring is perfectoid. -/
theorem isPerfectoidTateRing_of_surjective_of_isUniform
    (hS : IsBounded (powerBoundedSubring S : Set S)) (f : R →+* S) (hf : Continuous f)
    (hs : Function.Surjective f) : IsPerfectoidTateRing p S := sorry

/-- P4/surjections-and-closed-ideals-under-tilting (b) (AWS Theorem 2.4.4 (b)): a continuous
homomorphism of perfectoid Tate rings is surjective iff its tilt (P1 `tilt.map`) is. -/
theorem surjective_iff_tilt_surjective [IsPerfectoidTateRing p S] (f : R →+* S)
    (hf : Continuous f) : Function.Surjective f ↔ Function.Surjective (tilt.map p f hf) := sorry

/-- P4/surjections-and-closed-ideals-under-tilting (supporting): `I ⊆ R` is the kernel of a
continuous surjection onto a perfectoid Tate ring, i.e. `I` is closed and `R/I` is perfectoid
(equivalently uniform, (a)). -/
def IsPerfectoidQuotientIdeal_P4 (I : Ideal R) : Prop :=
  ∃ (T : PerfectoidRingCat.{u} p) (f : PerfectoidRingCat.of p R ⟶ T),
    Function.Surjective f.hom ∧ RingHom.ker f.hom = I

/-- P4/surjections-and-closed-ideals-under-tilting (supporting data): `I♭`, the ideal generated by
`{x ∈ R♭ : x♯ ∈ I}`; for `R/I` perfectoid it is `ker(R♭ → (R/I)♭)` and equals that set. -/
def tiltIdeal_P4 (I : Ideal R) : Ideal (tilt p R) :=
  Ideal.span (tilt.sharp ⁻¹' (I : Set R))

/-- P4/surjections-and-closed-ideals-under-tilting (supporting data): the inverse construction,
the closure of the ideal generated by `{x♯ : x ∈ J}`. -/
def untiltIdeal_P4 (J : Ideal (tilt p R)) : Ideal R :=
  (Ideal.span (tilt.sharp '' (J : Set (tilt p R)))).closure

/-- P4/surjections-and-closed-ideals-under-tilting (c) (AWS Corollary 2.4.5): `I ↦ I♭` is a
bijection from the closed ideals `I` with `R/I` perfectoid onto the closed perfect ideals of `R♭`,
with inverse `J ↦ closure (J♯)`, and `I♭ = {x : x♯ ∈ I}`. -/
theorem tiltIdeal_bijOn_P4 :
    Set.BijOn (tiltIdeal_P4 p) {I : Ideal R | IsPerfectoidQuotientIdeal_P4 p I}
        {J : Ideal (tilt p R) | IsClosed (J : Set (tilt p R)) ∧ ∀ x, x ^ p ∈ J → x ∈ J} ∧
      (∀ I : Ideal R, IsPerfectoidQuotientIdeal_P4 p I →
        untiltIdeal_P4 p (tiltIdeal_P4 p I) = I ∧
          ∀ x : tilt p R, x ∈ tiltIdeal_P4 p I ↔ tilt.sharp x ∈ I) ∧
      ∀ J : Ideal (tilt p R), IsClosed (J : Set (tilt p R)) → (∀ x, x ^ p ∈ J → x ∈ J) →
        tiltIdeal_P4 p (untiltIdeal_P4 p J) = J := sorry

/-- P4/surjections-and-closed-ideals-under-tilting (d) (AWS Corollary 2.4.6): `R/I` is perfectoid
(for closed `I`) iff `I` is the closure of the ideal generated by `(x^{1/pⁿ})♯` for `x` in some
subset of `R♭` and all `n ≥ 0`. -/
theorem isPerfectoidQuotientIdeal_iff_closure_span_sharp (I : Ideal R) :
    IsPerfectoidQuotientIdeal_P4 p I ↔ ∃ X : Set (tilt p R),
      I = (Ideal.span (⋃ n : ℕ, (fun x ↦ tilt.sharp ((⇑(frobeniusEquiv (tilt p R) p).symm)^[n] x))
        '' X)).closure := sorry

end SurjectionsTilting

end Perfectoid

/-! ## PerfectoidSpaces:P4/universal-perfectoid-zariski-closed (construction) -/

namespace PerfectoidSpace

open Perfectoid

section ZariskiClosedSubspace

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  (P : Pair R) (D : PairOfDefinition R) (I : Ideal R) (ϖ : PseudoUniformizerRoots p R)

namespace zariskiClosedSubspace

open scoped Classical in
/-- P4/universal-perfectoid-zariski-closed (supporting data): the presentation `({1} ∪ F)/1` of
the rational subset `U_F = {|g| ≤ 1, g ∈ F}` over the pair of definition `D`. -/
def presentation_affinoid (F : Finset R) : D.Presentation where
  num := insert 1 F
  den := 1
  hasDenominatorPower := sorry

/-- P4/universal-perfectoid-zariski-closed (supporting instance): finite subsets of `I` are
directed by inclusion. -/
instance instIsDirectedOrder_affinoid : IsDirectedOrder {F : Finset R // (F : Set R) ⊆ I} :=
  sorry

/-- P4/universal-perfectoid-zariski-closed (supporting instance). -/
instance instNonempty_affinoid : Nonempty {F : Finset R // (F : Set R) ⊆ I} :=
  ⟨⟨∅, by simp⟩⟩

/-- P4/universal-perfectoid-zariski-closed (supporting data): the base index `F = ∅`. -/
def base_affinoid : {F : Finset R // (F : Set R) ⊆ I} := ⟨∅, by simp⟩

/-- P4/universal-perfectoid-zariski-closed (supporting data): the filtered diagram
`𝒰_I = {U_F : F ⊆ I finite}`, `F ⊆ F'` giving `U_{F'} ⊆ U_F` (a refinement with cofactor `1`). -/
def diagram_affinoid :
    {F : Finset R // (F : Set R) ⊆ I} ⥤ {𝔭 : D.Presentation // Ideal.span (𝔭.num : Set R) = ⊤} :=
  Monotone.functor (f := fun F ↦ ⟨presentation_affinoid D F.1, sorry⟩) sorry

end zariskiClosedSubspace

-- PerfectoidSpace.zariskiClosedSubspace: not stated here; the affinoid perfectoid space
--   `Z_I = Spa(S_I, S_I⁺)` over `X` needs the anchor's adic spaces (supplier: AdicSpaces Layer 5;
--   PerfectoidSpaces:P2/affinoid-perfectoid-space). Ring-level core:
--   `zariskiClosedSubspace_affinoid`, `zariskiClosedSubspace.pair_affinoid`.

/-- P4/universal-perfectoid-zariski-closed (constructor, ring-level core of
`zariskiClosedSubspace`): the universal perfectoid quotient ring `S_I = S_I⁺[1/ϖ]`, `S_I⁺` the
`ϖ`-adic completion of `colim_F O⁺_X(U_F)`: the pro-rational ring of `𝒰_I` (Tor Lemma II.2.2 and
Remark II.2.3 without base field; Bhatt Proposition 9.4.1 (1)–(3); ECD Remark 7.9). -/
abbrev zariskiClosedSubspace_affinoid : Type u :=
  proRationalSubspace_affinoid p (zariskiClosedSubspace.diagram_affinoid D I)
    (zariskiClosedSubspace.base_affinoid I) ϖ

namespace zariskiClosedSubspace

/-- P4/universal-perfectoid-zariski-closed (data, ring-level core of `zariskiClosedSubspace`): the
Huber pair `(S_I, S_I⁺)`. -/
def pair_affinoid : Pair (zariskiClosedSubspace_affinoid p D I ϖ) :=
  proRationalSubspace.pair_affinoid p P (diagram_affinoid D I) (base_affinoid I) ϖ

-- PerfectoidSpace.zariskiClosedSubspace.ι: not stated here; the morphism `ι_I : Z_I → X` of
--   perfectoid spaces (supplier: AdicSpaces Layer 5). Affinoid core: `ι_affinoid`.

/-- P4/universal-perfectoid-zariski-closed (data, affinoid core of `ι`): the universal perfectoid
quotient `(R, R⁺) → (S_I, S_I⁺)`. -/
def ι_affinoid : Pair.Hom P (pair_affinoid p P D I ϖ) :=
  proRationalSubspace.structureMap_affinoid p P (diagram_affinoid D I) (base_affinoid I) ϖ

-- PerfectoidSpace.zariskiClosedSubspace.range_ι: not stated here; needs `ι` (supplier:
--   AdicSpaces Layer 5). Affinoid core: `range_ι_affinoid`.

/-- P4/universal-perfectoid-zariski-closed (characterisation core of `range_ι`): `Spa(S_I) → X`
is a homeomorphism onto `V(I)` (Tor Lemma II.2.2 (i)). -/
theorem range_ι_affinoid :
    IsEmbedding (ι_affinoid p P D I ϖ).spaComap ∧
      Set.range (ι_affinoid p P D I ϖ).spaComap = zeroLocus P I := sorry

-- PerfectoidSpace.zariskiClosedSubspace.lift: not stated here; morphisms `W → X` from perfectoid
--   spaces (supplier: AdicSpaces Layer 5). Affinoid core: `lift_affinoid`.

/-- P4/universal-perfectoid-zariski-closed (universal-property core of `lift`): for a morphism
`φ : (R, R⁺) → (B, B⁺)` to a perfectoid pair, `φ` kills `I` iff `Spa(φ)` lands in `V(I)` iff `φ`
factors through `(S_I, S_I⁺)`, and then uniquely (Tor Lemma II.2.2 (ii)). -/
theorem lift_affinoid {B : Type u} [CommRing B] [UniformSpace B] [IsUniformAddGroup B]
    [IsTopologicalRing B] [IsTateRing B] [CompleteSpace B] [T2Space B] [IsPerfectoidTateRing p B]
    {Q : Pair B} (φ : Pair.Hom P Q) :
    (I ≤ RingHom.ker φ.toRingHom ↔ ∀ y : spa Q.plus, φ.spaComap y ∈ zeroLocus P I) ∧
      (I ≤ RingHom.ker φ.toRingHom ↔
        ∃! ψ : Pair.Hom (pair_affinoid p P D I ϖ) Q, ψ.comp (ι_affinoid p P D I ϖ) = φ) := sorry

-- PerfectoidSpace.zariskiClosedSubspace.isZariskiClosedImmersion: not stated here; needs
--   `IsZariskiClosedImmersion` (supplier: AdicSpaces Layer 5). Affinoid core:
--   `isZariskiClosedImmersion_affinoid`.

/-- P4/universal-perfectoid-zariski-closed (relation core of `isZariskiClosedImmersion`): `ι_I` is
a Zariski closed immersion defined by `I` (Tor Lemma II.2.2; ECD Definition 5.7 (i)). -/
theorem isZariskiClosedImmersion_affinoid :
    IsZariskiClosedImmersion_affinoid p (ι_affinoid p P D I ϖ) I := sorry

-- PerfectoidSpace.zariskiClosedSubspace.denseRange: not stated here; stated on rings, where it is
--   `denseRange_affinoid` (the packet item is about `O_X(X) → O_{Z_I}(Z_I)`, supplier:
--   AdicSpaces Layer 5).

/-- P4/universal-perfectoid-zariski-closed (other, core of `denseRange`): `R → S_I` has dense
image (Tor Lemma II.2.2; its surjectivity is ECD Theorem 5.8, P6). -/
theorem denseRange_affinoid : DenseRange (ι_affinoid p P D I ϖ).toRingHom := sorry

-- PerfectoidSpace.zariskiClosedSubspace.ker_eq: not stated here; stated on rings, where it is
--   `ker_eq_affinoid` (the packet item is phrased for `Z_I` as a space, supplier: AdicSpaces
--   Layer 5).

/-- P4/universal-perfectoid-zariski-closed (characterisation core of `ker_eq`):
`I^perf = ker(R → S_I)` is a closed ideal containing `I`, equal to `{h : |h| = 0 on V(I)}`
(Tor Remark II.2.3). -/
theorem ker_eq_affinoid :
    I ≤ RingHom.ker (ι_affinoid p P D I ϖ).toRingHom ∧
      IsClosed (RingHom.ker (ι_affinoid p P D I ϖ).toRingHom : Set R) ∧
      ∀ h : R, h ∈ RingHom.ker (ι_affinoid p P D I ϖ).toRingHom ↔
        ∀ x ∈ zeroLocus P I, x.1.toValuativeRel.vle h 0 := sorry

-- PerfectoidSpace.zariskiClosedSubspace.congr: not stated here; an isomorphism of perfectoid
--   spaces over `X` (supplier: AdicSpaces Layer 5). Affinoid core: `congr_affinoid`.

/-- P4/universal-perfectoid-zariski-closed (extensionality core of `congr`): `V(I) = V(J)` gives a
unique isomorphism `S_I ≅ S_J` over `R` of topological rings matching the plus rings (Tor Lemma
II.2.2 (iii)). -/
theorem congr_affinoid (J : Ideal R) (h : zeroLocus P I = zeroLocus P J) :
    ∃ e : zariskiClosedSubspace_affinoid p D I ϖ ≃+* zariskiClosedSubspace_affinoid p D J ϖ,
      Continuous e ∧ Continuous e.symm ∧
      e.toRingHom.comp (ι_affinoid p P D I ϖ).toRingHom = (ι_affinoid p P D J ϖ).toRingHom ∧
      (pair_affinoid p P D I ϖ).plus.map e.toRingHom = (pair_affinoid p P D J ϖ).plus := sorry

-- PerfectoidSpace.zariskiClosedSubspace_sup: not stated here; `Z_{I+J} ≅ Z_I ×_X Z_J` needs
--   fibre products of perfectoid spaces (supplier:
--   PerfectoidSpaces:P2/fibre-products-of-perfectoid-spaces); on spaces it is `zeroLocus_sup`.
-- PerfectoidSpace.zariskiClosedSubspace.plus_mod: not stated here; phrased with the anchor's
--   `O⁺_X(U_F)` (supplier: AdicSpaces Layer 3). Ring-level core: `plus_mod_affinoid`.

/-- P4/universal-perfectoid-zariski-closed (simp core of `plus_mod`):
`S_I⁺/ϖ ≅ colim_F O⁺_X(U_F)/ϖ` (Tor Lemma II.2.2). -/
theorem plus_mod_affinoid :
    Nonempty ((pair_affinoid p P D I ϖ).plus ⧸
        Ideal.span {proRationalSubspace.toPlus_affinoid p P (diagram_affinoid D I)
          (base_affinoid I) ϖ (ϖ.rootPlus p P) ^ 1} ≃+*
      (colimit (proRationalSubspace.plusModDiagram_affinoid p P (diagram_affinoid D I) ϖ 1) :
        CommRingCat.{u})) := sorry

end zariskiClosedSubspace

-- PerfectoidSpace.zariskiClosedSubspace_bot: not stated here; `Z_0 = X` and `Z_R = ∅` as
--   perfectoid spaces (supplier: AdicSpaces Layer 5). Ring-level core:
--   `zariskiClosedSubspace_bot_affinoid`.

/-- P4/universal-perfectoid-zariski-closed (simp core of `zariskiClosedSubspace_bot`): `R → S_0`
is bijective and `S_R = 0`. -/
theorem zariskiClosedSubspace_bot_affinoid :
    Function.Bijective (zariskiClosedSubspace.ι_affinoid p P D ⊥ ϖ).toRingHom ∧
      Subsingleton (zariskiClosedSubspace_affinoid p D ⊤ ϖ) := sorry

end ZariskiClosedSubspace

section ZariskiClosedSubspaceTests

variable (p : ℕ) [Fact p.Prime]

-- The perfectoid disc `ℚ_p^cycl⟨T^{1/p^∞}⟩` (P1 `perfectedTateAlgebra`, one variable).
local notation "𝔻" => perfectedTateAlgebra p (padicCyclotomic p) Unit

-- Its Huber pair with plus ring `ℚ_p^cycl°⟨T^{1/p^∞}⟩` (P1 `perfectedTateAlgebra.plus`).
local notation "𝔻₊" =>
  (perfectedTateAlgebra.plus p (σ := Unit) (Pair.powerBounded (padicCyclotomic p)))

-- The coordinate `T`.
local notation "𝕋" => perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0)

-- The perfectoid disc `ℂ_p⟨T^{1/p^∞}⟩` and its coordinate `T`.
local notation "𝔻ℂ" => perfectedTateAlgebra p ℂ_[p] Unit

local notation "𝕋ℂ" => perfectedTateAlgebra.X p (R := ℂ_[p]) () (PDyadicExp.invPow p 0)

/- `I = (T)` in the perfectoid disc: `S_I = ℚ_p^cycl`, and `ker(R → S_I)` is the closure of
`(T^{1/pⁿ} : n ≥ 0)`, strictly bigger than `(T)`. -/
-- test zariskiClosedSubspace_T (computation) [P4/universal-perfectoid-zariski-closed]
example (D : PairOfDefinition 𝔻) (ϖ : PseudoUniformizerRoots p 𝔻) :
    RingHom.ker (zariskiClosedSubspace.ι_affinoid p 𝔻₊ D (Ideal.span {𝕋}) ϖ).toRingHom =
        (Ideal.span (Set.range fun n : ℕ ↦
          perfectedTateAlgebra.X p () (PDyadicExp.invPow p n))).closure ∧
      Nonempty (zariskiClosedSubspace_affinoid p D (Ideal.span {𝕋}) ϖ ≃+* padicCyclotomic p) :=
  sorry

/- `I = (T − 1)`: `S_I = C⁰(ℤ_p, ℂ_p)` (AWS Example 2.4.10). `V(T − 1)` lies in the rational
subset `{|T| = 1} = Spa(ℂ_p⟨T^{±1/p^∞}⟩)` of the disc, so `Z_I` is the same over the disc and over
`ℂ_p⟨T^{±1/p^∞}⟩` (P4/intersection-of-rational-subsets (d)); the disc carries P1's perfectoid
instance. -/
-- test zariskiClosedSubspace_T_sub_one (computation) [P4/universal-perfectoid-zariski-closed]
example (D : PairOfDefinition 𝔻ℂ) (ϖ : PseudoUniformizerRoots p 𝔻ℂ) :
    Nonempty (zariskiClosedSubspace_affinoid p D (Ideal.span {𝕋ℂ - 1}) ϖ ≃+* C(ℤ_[p], ℂ_[p])) :=
  sorry

-- test zariskiClosedSubspace_bot (degenerate) [P4/universal-perfectoid-zariski-closed]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R)
    (D : PairOfDefinition R) (ϖ : PseudoUniformizerRoots p R) :
    Function.Bijective (zariskiClosedSubspace.ι_affinoid p P D ⊥ ϖ).toRingHom ∧
      Subsingleton (zariskiClosedSubspace_affinoid p D ⊤ ϖ) := sorry

/- `R/(T)` is not reduced (AWS Example 2.4.9), so `Spa(R/(T), ·)` is not perfectoid, while
`S_{(T)} = ℚ_p^cycl`. -/
-- test zariskiClosedSubspace_ne_quotient (non-example) [P4/universal-perfectoid-zariski-closed]
example (D : PairOfDefinition 𝔻) (ϖ : PseudoUniformizerRoots p 𝔻) :
    ¬ IsReduced (𝔻 ⧸ Ideal.span {𝕋}) ∧
      Nonempty (zariskiClosedSubspace_affinoid p D (Ideal.span {𝕋}) ϖ ≃+* padicCyclotomic p) :=
  sorry

/- `Z_I` is the pro-rational subspace of `{U_F}` by construction; if `I` is generated by
`g♯` for `g` in a finite set `G ⊆ R♭` (compatible `p`-power roots), `R → S_I` is surjective with
kernel the closure of the ideal generated by all `(g^{1/pⁿ})♯` (P4/surjections-and-closed-ideals-
under-tilting (d), P4/strongly-zariski-closed-is-zariski-closed). -/
-- test zariskiClosedSubspace_eq_proRational (compatibility)
--   [P4/universal-perfectoid-zariski-closed]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R)
    (D : PairOfDefinition R) (ϖ : PseudoUniformizerRoots p R) (G : Finset (tilt p R))
    (I : Ideal R) (hI : I = Ideal.span (tilt.sharp '' (G : Set (tilt p R)))) :
    Function.Surjective (zariskiClosedSubspace.ι_affinoid p P D I ϖ).toRingHom ∧
      RingHom.ker (zariskiClosedSubspace.ι_affinoid p P D I ϖ).toRingHom =
        (Ideal.span (⋃ n : ℕ,
          (fun g ↦ tilt.sharp ((⇑(frobeniusEquiv (tilt p R) p).symm)^[n] g)) ''
            (G : Set (tilt p R)))).closure := sorry

end ZariskiClosedSubspaceTests

end PerfectoidSpace

namespace PerfectoidSpace

open Perfectoid

section ZariskiClosedUniversal

variable (p : ℕ) [Fact p.Prime] {R S : Type u} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R] [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
  [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S]
  (P : Pair R) (D : PairOfDefinition R) (ϖ : PseudoUniformizerRoots p R) {Q : Pair S}

/-! ## PerfectoidSpaces:P4/zariski-closed-immersion-is-universal (lemma) -/

-- PerfectoidSpace.IsZariskiClosedImmersion.isoZariskiClosedSubspace: not stated here; an
--   isomorphism of perfectoid spaces `Z ≅ Z_I` over `X` (supplier: AdicSpaces Layer 5). Affinoid
--   core: `IsZariskiClosedImmersion_affinoid.isoZariskiClosedSubspace`.

/-- P4/zariski-closed-immersion-is-universal (affinoid core; Tor after Remark II.2.3; ECD Remark
7.9): a Zariski closed immersion `Spa(S, S⁺) → Spa(R, R⁺)` defined by `I` is uniquely isomorphic
over `(R, R⁺)` to the universal one `(R, R⁺) → (S_I, S_I⁺)`, as topological Huber pairs. -/
theorem IsZariskiClosedImmersion_affinoid.isoZariskiClosedSubspace (I : Ideal R)
    (φ : Pair.Hom P Q) (h : IsZariskiClosedImmersion_affinoid p φ I) :
    ∃! e : Pair.Hom (zariskiClosedSubspace.pair_affinoid p P D I ϖ) Q,
      e.comp (zariskiClosedSubspace.ι_affinoid p P D I ϖ) = φ ∧ IsHomeomorph e.toRingHom ∧
        (zariskiClosedSubspace.pair_affinoid p P D I ϖ).plus.map e.toRingHom = Q.plus := sorry

/-! ## PerfectoidSpaces:P4/strongly-zariski-closed-is-zariski-closed (lemma) -/

-- PerfectoidSpace.IsStronglyZariskiClosed.isZariskiClosedImmersion: not stated here (see the
--   comment at P4/strongly-zariski-closed-immersion); affinoid core:
--   `IsStronglyZariskiClosed_affinoid.isZariskiClosedImmersion`.

/-- P4/strongly-zariski-closed-is-zariski-closed (affinoid core; ECD after Definition 5.7; Tor
after Definition II.2.6): a strongly Zariski closed `Spa(S, S⁺) → Spa(R, R⁺)` with `I = ker φ` is
a Zariski closed immersion defined by `I` (so `|Z| → V(I)` is a homeomorphism), and `I = I^perf`
is the kernel of the universal map `R → S_I`, so `S = S_I` (with
`IsZariskiClosedImmersion_affinoid.isoZariskiClosedSubspace`); `I` is closed and `(S, S⁺)` is the
quotient pair by `IsStronglyZariskiClosed_affinoid.isClosed_ker`, `iff_quotient`. The converse is
ECD Theorem 5.8 (PerfectoidSpaces:P6/zariski-closed-equals-strongly-zariski-closed). -/
theorem IsStronglyZariskiClosed_affinoid.isZariskiClosedImmersion (φ : Pair.Hom P Q)
    (h : IsStronglyZariskiClosed_affinoid φ) :
    IsZariskiClosedImmersion_affinoid p φ (RingHom.ker φ.toRingHom) ∧
      RingHom.ker (zariskiClosedSubspace.ι_affinoid p P D (RingHom.ker φ.toRingHom) ϖ).toRingHom =
        RingHom.ker φ.toRingHom := sorry

/-! ## PerfectoidSpaces:P4/strongly-zariski-closed-criterion (lemma) -/

-- PerfectoidSpace.isStronglyZariskiClosed_tfae: not stated here; phrased for morphisms of
--   affinoid perfectoid spaces (supplier: AdicSpaces Layer 5). Affinoid core:
--   `isStronglyZariskiClosed_tfae_affinoid`.

/-- P4/strongly-zariski-closed-criterion (affinoid core; Tor Definition II.2.6 and proof of Lemma
II.2.7): with `T⁺` the integral closure of the image of `R⁺` in `S`, the following are
equivalent: (a) `φ` is strongly Zariski closed; (b) `R⁺ → S⁺` is almost surjective and
`S⁺ = T⁺`; (c) `R⁺/ϖ → S⁺/ϖ` is almost surjective and `S⁺ = T⁺`. Almost surjectivity alone (Tor
Definition II.2.6) is strictly weaker (test `not_isStronglyZariskiClosed_ofPowerBounded`). -/
theorem isStronglyZariskiClosed_tfae_affinoid (φ : Pair.Hom P Q) :
    List.TFAE [IsStronglyZariskiClosed_affinoid φ,
      (∀ n, ∀ s ∈ Q.plus, φ.toRingHom (ϖ.root n) * s ∈ P.plus.map φ.toRingHom) ∧
        Q.plus = (integralClosure (P.plus.map φ.toRingHom) S).toSubring,
      (∀ n, ∀ s ∈ Q.plus, ∃ r ∈ P.plus, ∃ t ∈ Q.plus,
          φ.toRingHom (ϖ.root n) * s - φ.toRingHom r = φ.toRingHom (ϖ.root 0) * t) ∧
        Q.plus = (integralClosure (P.plus.map φ.toRingHom) S).toSubring] := sorry

/-! ## PerfectoidSpaces:P4/zariski-closed-base-change (lemma) -/

-- PerfectoidSpace.zariskiClosedSubspace_baseChange: not stated here; `Z_I ×_X X' ≅ Z_{IR'}` needs
--   fibre products of perfectoid spaces (supplier:
--   PerfectoidSpaces:P2/fibre-products-of-perfectoid-spaces). Cores: on spaces
--   `zariskiClosedSubspace_baseChange_affinoid`; part (ii) for strongly Zariski closed maps is
--   `IsStronglyZariskiClosed_affinoid.baseChange`.

/-- P4/zariski-closed-base-change (core of (i) on spaces; Tor Lemma II.2.9 (i)): for a morphism
`ψ : (R, R⁺) → (R', R'⁺)`, the preimage of `V(I)` under `Spa(ψ)` is `V(I R')`, the image of the
base change `Z_I ×_X X' → X'`. -/
theorem zariskiClosedSubspace_baseChange_affinoid {R' : Type u} [CommRing R'] [UniformSpace R']
    [IsUniformAddGroup R'] [IsTopologicalRing R'] [IsTateRing R'] [CompleteSpace R'] [T2Space R']
    [IsPerfectoidTateRing p R'] {P' : Pair R'} (ψ : Pair.Hom P P') (I : Ideal R) :
    ψ.spaComap ⁻¹' zeroLocus P I = zeroLocus P' (I.map ψ.toRingHom) := sorry

/-! ## PerfectoidSpaces:P4/anchor-closed-immersion-comparison (comparison) -/

-- PerfectoidSpace.isStronglyZariskiClosed_iff_quotientPair: not stated here; compares with the
--   anchor's closed immersions `Spa(A/J) → Spa(A)` of adic spaces (supplier: AdicSpaces Layer 5,
--   Layer 2.4; AdicSpacesPartII:R0/closed-adic-subspaces-and-embeddings). Affinoid core of (a):
--   `isStronglyZariskiClosed_iff_quotientPair_affinoid`; (c) is the test
--   `zariskiClosedSubspace_ne_quotient`; (b) (the global form) needs the anchor's closed
--   immersions of adic spaces.

/-- P4/anchor-closed-immersion-comparison (a), affinoid core: `φ` is strongly Zariski closed iff
`(S, S⁺)` is, over `(R, R⁺)`, Tau Ceti's quotient pair `(R, R⁺)/J` (`Pair.quotient`, the anchor's
closed immersion `Spa(R/J) → Spa(R)`, Wedhorn Proposition 7.38) for a closed ideal `J` (then
`J = ker φ` and `R/J = S` is perfectoid) (AWS Example 2.4.9; ECD Definition 5.7 (ii)). -/
theorem isStronglyZariskiClosed_iff_quotientPair_affinoid (φ : Pair.Hom P Q) :
    IsStronglyZariskiClosed_affinoid φ ↔ ∃ J : Ideal R, IsClosed (J : Set R) ∧
      ∃ e : Pair.Hom (P.quotient J) Q, e.comp (P.quotientHom J) = φ ∧ IsHomeomorph e.toRingHom ∧
        (P.quotient J).plus.map e.toRingHom = Q.plus := sorry

end ZariskiClosedUniversal

/-! ## PerfectoidSpaces:P4/closed-immersion-vs-zariski-closed (comparison) -/

-- PerfectoidSpace.exists_isClosedImmersion_not_isZariskiClosed: not stated here; phrased with
--   closed immersions of perfectoid spaces (supplier: AdicSpaces Layer 5). Affinoid core (c),
--   (d): `exists_isClosedImmersion_not_isZariskiClosed_affinoid`; (a) is
--   `IsStronglyZariskiClosed_affinoid.isZariskiClosedImmersion` and the field
--   `IsZariskiClosedImmersion_affinoid.isClosedImmersion`; (b) is the test
--   `not_isImmersion_image_closedPoint`.

section ClosedVsZariski

variable (p : ℕ) [Fact p.Prime]

-- The perfectoid disc `ℚ_p^cycl⟨T^{1/p^∞}⟩` (P1 `perfectedTateAlgebra`, one variable).
local notation "𝔻" => perfectedTateAlgebra p (padicCyclotomic p) Unit

-- Its Huber pair with plus ring `ℚ_p^cycl°⟨T^{1/p^∞}⟩` (P1 `perfectedTateAlgebra.plus`).
local notation "𝔻₊" =>
  (perfectedTateAlgebra.plus p (σ := Unit) (Pair.powerBounded (padicCyclotomic p)))

-- The coordinate `T`.
local notation "𝕋" => perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0)

/-- P4/closed-immersion-vs-zariski-closed (c), (d) (affinoid core; Berkeley remark after
Definition 17.4.2; ECD before Definition 5.7): for any presentations `𝒰` of the rational subsets
`{|ϖ^{1/pⁿ}| ≤ |T|}` of the perfectoid disc, `ι_𝒰 : Spa(S_𝒰) → X` is a closed immersion whose
image (the closure of the annulus `{|T| = 1}`) is not Zariski closed, and `R → S_𝒰` is not
surjective. -/
theorem exists_isClosedImmersion_not_isZariskiClosed_affinoid
    (ϖC : PseudoUniformizerRoots p (padicCyclotomic p)) (D : PairOfDefinition 𝔻)
    (𝒰 : ℕ ⥤ {𝔭 : D.Presentation // Ideal.span (𝔭.num : Set 𝔻) = ⊤})
    (h𝒰 : ∀ n, Subtype.val ⁻¹' rationalSubset 𝔻₊.plus (𝒰.obj n).1.num (𝒰.obj n).1.den =
      {x : spa 𝔻₊.plus |
        x.1.toValuativeRel.vle (algebraMap (padicCyclotomic p) 𝔻 (ϖC.root n)) 𝕋})
    (ϖ : PseudoUniformizerRoots p 𝔻) :
    IsClosedImmersion_affinoid p (proRationalSubspace.structureMap_affinoid p 𝔻₊ 𝒰 0 ϖ) ∧
      ¬ IsZariskiClosed 𝔻₊
        (Set.range (proRationalSubspace.structureMap_affinoid p 𝔻₊ 𝒰 0 ϖ).spaComap) ∧
      ¬ Function.Surjective (proRationalSubspace.structureMap_affinoid p 𝔻₊ 𝒰 0 ϖ).toRingHom :=
  sorry

end ClosedVsZariski

