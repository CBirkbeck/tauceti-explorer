/-! # Stage P3. Almost purity, Fontaine–Wintenberger, henselian finite étale approximation, and
the étale site of perfectoid spaces

Finite étale algebras are Mathlib's category `CommAlgCat.FiniteEtale A` (`Module.Finite` and
`Algebra.Etale`), written `FÉt(A)`; base change is `CommAlgCat.FiniteEtale.baseChange`.

* **Henselian prefix** (namespace `TauCeti`): filtered colimits of henselian pairs
  (`Ring.DirectLimit.henselianRing`), topologically henselian Tate rings
  (`Huber.IsTopologicallyHenselian`), Elkik's Jacobian ideal `jacobianIdeal` and the
  approximation theorems of Gabber–Ramero §5.4, the henselisation `Ring.henselization`, and the
  comparison `FÉt(R[t⁻¹]) ≃ FÉt(R^∧[t⁻¹])`. The `(t, I)`-adic completion `R^∧ = lim R ⧸ tⁿI` is
  the subring `tIAdicCompletion_P3 t I` of compatible sequences. Statements about schemes of
  sections, groupoids of such schemes and moduli schemes of algebra structures are given in their
  affine form or as comments.
* **Almost purity** (namespace `TauCeti.Perfectoid`): the untilting functor
  `FiniteEtale.untilt p R : FÉt(R♭) ⥤ FÉt(R)` for a perfectoid Tate ring `R` (stage P1), its full
  faithfulness and essential surjectivity, perfectoidness of finite étale algebras
  (`FiniteEtale.IsNaturallyPerfectoid`: perfectoid for the natural topology of a finite
  `R`-module), and the integral statement `FiniteEtale.IsAlmostFiniteEtaleIntegral` (`S°ᵃ` almost
  finite étale and uniformly almost finite projective over `R°ᵃ`, stage P0's
  `Almost.IsAlmostFiniteEtaleAlg` for the basic setup `Perfectoid.almostSetup p R` of stage P1).
  Perfectoid fields: finite extensions, algebraic closedness under tilting, Fontaine–Wintenberger.
* **Geometry** (namespace `TauCeti.PerfectoidSpace`): finite étale, étale, strongly (finite)
  étale morphisms of perfectoid spaces and the étale and finite étale sites need the anchor's
  category of adic spaces (AdicSpaces Layer 5), stage P2's `PerfectoidSpace` and
  AdicEtaleGeometry A1's morphism classes and sites; they are comments naming their supplier. The
  affinoid condition `Perfectoid.Pair.IsStronglyFiniteEtale` on morphisms of perfectoid Huber pairs
  is stated, with affinoid cores (`…_affinoid`) of the geometric statements.

Sources: ECD = Scholze, *Étale cohomology of diamonds*; Sch12 = Scholze, *Perfectoid spaces*;
Berkeley = Scholze–Weinstein, *Berkeley lectures*; KL = Kedlaya–Liu, *Relative p-adic Hodge
theory* I; AWS = Kedlaya, *Sheaves, stacks and shtukas*; Bhatt = Bhatt, *Lecture notes on
perfectoid spaces*; GR = Gabber–Ramero, *Almost ring theory*; Elkik = Elkik, *Solutions
d'équations à coefficients dans un anneau hensélien*; Stacks = the Stacks Project. -/

noncomputable section

namespace TauCeti

universe u

open Topology Filter CategoryTheory CategoryTheory.Limits TensorProduct
open Huber

/-! ## PerfectoidSpaces:P3/henselian-pairs-colimits-and-completions (lemma) -/

section HenselianColimit

variable {ι : Type u} [Preorder ι] (G : ι → Type u) [∀ i, CommRing (G i)]
  (f : ∀ i j, i ≤ j → G i →+* G j)

/-- P3/henselian-pairs-colimits-and-completions (data): for ideals `I i ⊆ G i` of a directed
system of rings, the ideal `colim I_i` of `colim G_i` generated by the images of the `I i`
(Stacks Tag 0FWT). -/
def Ring.DirectLimit.ideal (I : ∀ i, Ideal (G i)) :
    Ideal (_root_.Ring.DirectLimit G fun i j h ↦ f i j h) :=
  Ideal.span (⋃ i, _root_.Ring.DirectLimit.of G (fun i j h ↦ f i j h) i '' (I i : Set (G i)))

variable [IsDirectedOrder ι] [Nonempty ι] [DirectedSystem G fun i j h ↦ f i j h]

/-- P3/henselian-pairs-colimits-and-completions (b): a filtered colimit of henselian pairs, along
ring maps carrying `I i` into `I j`, is a henselian pair (Stacks Tag 0FWT). Part (a), that an
`I`-adically complete ring is henselian along `I`, is Mathlib's instance
`IsAdicComplete.henselianRing` (Stacks Tag 0ALJ). -/
theorem Ring.DirectLimit.henselianRing (I : ∀ i, Ideal (G i))
    (hI : ∀ i j h, (I i).map (f i j h) ≤ I j) [∀ i, HenselianRing (G i) (I i)] :
    HenselianRing (_root_.Ring.DirectLimit G fun i j h ↦ f i j h) (Ring.DirectLimit.ideal G f I) :=
  sorry

end HenselianColimit

section TopologicallyHenselian

variable (A : Type u) [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsTateRing A]

/-- P3/henselian-pairs-colimits-and-completions (definition, (c)): a Tate ring `A` is
*topologically henselian* if for every ring of definition `A₀` and every pseudouniformiser
`ϖ ∈ A₀` the pair `(A₀, ϖA₀)` is henselian (Sch12 §7 before Lemma 7.5; Bhatt Lemma 7.2.3). By (c)
one pair suffices (`isTopologicallyHenselian_iff_exists`), and it is equivalent to `(A°, A°°)`
or `(A⁺, A°°)` being henselian. -/
def Huber.IsTopologicallyHenselian : Prop :=
  ∀ (P : PairOfDefinition A) (ϖ : A) (h : ϖ ∈ P.ringOfDefinition), IsPseudoUniformizer ϖ →
    HenselianRing P.ringOfDefinition (Ideal.span {⟨ϖ, h⟩})

/-- P3/henselian-pairs-colimits-and-completions (c): henselianity along a pseudouniformiser does
not depend on the ring of definition nor on the pseudouniformiser (Bhatt Lemma 7.2.3(3)). -/
theorem Huber.isTopologicallyHenselian_iff_exists :
    IsTopologicallyHenselian A ↔ ∃ (P : PairOfDefinition A) (ϖ : A) (h : ϖ ∈ P.ringOfDefinition),
      IsPseudoUniformizer ϖ ∧ HenselianRing P.ringOfDefinition (Ideal.span {⟨ϖ, h⟩}) := sorry

/-- P3/henselian-pairs-colimits-and-completions (c): `A` is topologically henselian iff
`(A°, A°°)` is a henselian pair (Bhatt Lemma 7.2.3(5)). -/
theorem Huber.isTopologicallyHenselian_iff_powerBounded :
    IsTopologicallyHenselian A ↔
      HenselianRing (powerBoundedSubring A) (topologicallyNilpotentIdeal A) := sorry

/-- P3/henselian-pairs-colimits-and-completions (c): `A` is topologically henselian iff
`(A⁺, A°° ∩ A⁺)` is a henselian pair, for any ring of integral elements `A⁺`. -/
theorem Huber.isTopologicallyHenselian_iff_plus (P : Pair A) :
    IsTopologicallyHenselian A ↔ HenselianRing P.plus ((topologicallyNilpotentIdeal A).comap
      (Subring.inclusion P.isRingOfIntegralElements.le_powerBoundedSubring)) := sorry

end TopologicallyHenselian

/-- P3/henselian-pairs-colimits-and-completions: a complete Tate ring is topologically henselian,
its rings of definition containing `ϖ` being `ϖ`-adically complete (anchor Layer 0) and part (a)
applying (Bhatt Lemma 7.2.3). -/
theorem Huber.isTopologicallyHenselian_of_completeSpace (A : Type u) [CommRing A] [UniformSpace A]
    [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A] [CompleteSpace A] [T2Space A] :
    IsTopologicallyHenselian A := sorry

-- Huber.isTopologicallyHenselian_directLimit: not stated here; needs the colimit Tate topology on
--   a filtered colimit of Tate rings with ring of definition `colim A_{j,0}` (supplier: AdicSpaces
--   Layer 0). The statement: such a colimit of topologically henselian Tate rings is
--   topologically henselian, by (b) (`Ring.DirectLimit.henselianRing`).

/-! ## PerfectoidSpaces:P3/finite-etale-filtered-colimit-of-rings (lemma) -/

section FiniteEtaleColimit

variable {ι : Type u} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι] (G : ι → Type u)
  [∀ i, CommRing (G i)] (f : ∀ i j, i ≤ j → G i →+* G j) [DirectedSystem G fun i j h ↦ f i j h]

local notation "𝒢" => _root_.Ring.DirectLimit G fun i j h ↦ f i j h

/-- P3/finite-etale-filtered-colimit-of-rings (a): every finite étale algebra over `colim G_i` is
the base change of a finite étale `G_i`-algebra for some `i` (KL Remark 1.2.9; Sch12 proof of
Lemma 7.5(i); Bhatt proof of Corollary 10.0.5). -/
theorem Ring.DirectLimit.exists_finiteEtale_model (S : CommAlgCat.FiniteEtale.{u} 𝒢) :
    ∃ (i : ι) (Sᵢ : CommAlgCat.FiniteEtale.{u} (G i)),
      letI := (_root_.Ring.DirectLimit.of G (fun i j h ↦ f i j h) i).toAlgebra
      Nonempty ((CommAlgCat.FiniteEtale.baseChange.{u, u, u} (G i) 𝒢).obj Sᵢ ≅ S) := sorry

/-- P3/finite-etale-filtered-colimit-of-rings (b), on isomorphism classes: two finite étale
`G_i`-algebras that become isomorphic over `colim G_i` are isomorphic over some `G_j`, `j ≥ i`
(KL Remark 1.2.9). -/
theorem Ring.DirectLimit.exists_iso_of_iso_finiteEtale (i : ι)
    (S T : CommAlgCat.FiniteEtale.{u} (G i))
    (e : letI := (_root_.Ring.DirectLimit.of G (fun i j h ↦ f i j h) i).toAlgebra
      (CommAlgCat.FiniteEtale.baseChange.{u, u, u} (G i) 𝒢).obj S ≅
        (CommAlgCat.FiniteEtale.baseChange.{u, u, u} (G i) 𝒢).obj T) :
    ∃ (j : ι) (hij : i ≤ j), letI := (f i j hij).toAlgebra
      Nonempty ((CommAlgCat.FiniteEtale.baseChange.{u, u, u} (G i) (G j)).obj S ≅
        (CommAlgCat.FiniteEtale.baseChange.{u, u, u} (G i) (G j)).obj T) := sorry

/-- P3/finite-etale-filtered-colimit-of-rings (c): faithful flatness of a base change to
`colim G_i` descends to some finite stage (KL Remark 1.2.9). -/
theorem Ring.DirectLimit.exists_faithfullyFlat_finiteEtale (i : ι)
    (S : CommAlgCat.FiniteEtale.{u} (G i))
    (h : letI := (_root_.Ring.DirectLimit.of G (fun i j h ↦ f i j h) i).toAlgebra
      Module.FaithfullyFlat 𝒢 ((CommAlgCat.FiniteEtale.baseChange.{u, u, u} (G i) 𝒢).obj S)) :
    ∃ (j : ι) (hij : i ≤ j), letI := (f i j hij).toAlgebra
      Module.FaithfullyFlat (G j)
        ((CommAlgCat.FiniteEtale.baseChange.{u, u, u} (G i) (G j)).obj S) := sorry

end FiniteEtaleColimit

/-! ## PerfectoidSpaces:P3/approximate-solutions-over-complete-rings (lemma) -/

section Approximation

variable {R : Type u} [CommRing R] {ι σ : Type*} [Fintype ι] [Fintype σ]

open scoped Classical in
/-- P3/approximate-solutions-over-complete-rings (data): Elkik's Jacobian ideal
`H = Σ_α Δ_α · ((f_α) : J)` of the presentation `R[X_ι] ⧸ J`, `J = (f_s)_{s ∈ σ}`: for a finite
set `α` of equations, `Δ_α` is generated by the `|α| × |α|` minors of the Jacobian matrix
`(∂f_s/∂X_i)_{s ∈ α}` and `(f_α) : J` is the colon ideal (Elkik §0; GR 5.4.5; it lies in
`H_R(F, J) = Ann Ext¹(L_{S/R}, J/J²)` by GR Lemma 5.4.6). -/
def jacobianIdeal (f : σ → MvPolynomial ι R) : Ideal (MvPolynomial ι R) :=
  ⨆ α : Finset σ,
    Ideal.span (Set.range fun g : α ↪ ι ↦
        (Matrix.of fun s t : α ↦ MvPolynomial.pderiv (g t) (f s)).det) *
      Submodule.colon (Ideal.span (f '' (α : Set σ))) (Set.range f)

/-- P3/approximate-solutions-over-complete-rings (i): one approximation step. If `n > 2h`,
`tʰ ∈ H + p_a` and `f_s(a) ∈ tⁿI` for all `s`, there is `b ≡ a mod t^{n-h}I` with
`f_s(b) ∈ (t^{n-h}I)²` (GR Lemma 5.4.8). -/
theorem exists_approx_step {t : R} (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    (f : σ → MvPolynomial ι R) (a : ι → R) (n h : ℕ) (hn : 2 * h < n)
    (hjac : MvPolynomial.C (t ^ h) ∈ jacobianIdeal f ⊔ RingHom.ker (MvPolynomial.eval a))
    (happrox : ∀ s, MvPolynomial.eval a (f s) ∈ Ideal.span {t ^ n} * I) :
    ∃ b : ι → R, (∀ i, b i - a i ∈ Ideal.span {t ^ (n - h)} * I) ∧
      ∀ s, MvPolynomial.eval b (f s) ∈ (Ideal.span {t ^ (n - h)} * I) ^ 2 := sorry

/-- P3/approximate-solutions-over-complete-rings (ii): over a `tI`-adically complete ring an
approximate solution of a system smooth up to `tʰ` is `t^{n-h}I`-close to an exact solution
(GR Claim 5.4.14; Elkik Théorème 1 in the noetherian case). -/
theorem exists_solution_of_approx_of_isAdicComplete {t : R} (ht : t ∈ nonZeroDivisors R)
    (I : Ideal R) [IsAdicComplete (Ideal.span {t} * I) R] (f : σ → MvPolynomial ι R)
    (a : ι → R) (n h : ℕ) (hn : 2 * h < n)
    (hjac : MvPolynomial.C (t ^ h) ∈ jacobianIdeal f ⊔ RingHom.ker (MvPolynomial.eval a))
    (happrox : ∀ s, MvPolynomial.eval a (f s) ∈ Ideal.span {t ^ n} * I) :
    ∃ b : ι → R, (∀ i, b i - a i ∈ Ideal.span {t ^ (n - h)} * I) ∧
      ∀ s, MvPolynomial.eval b (f s) = 0 := sorry

end Approximation

/-! ## PerfectoidSpaces:P3/elkik-noetherian-henselian-approximation (theorem) -/

/-- P3/elkik-noetherian-henselian-approximation (Elkik Théorème 2, equivalent to Théorème 2 bis):
over a noetherian henselian pair `(A, J)`, for a presentation `A[X_ι] ⧸ (f_s)` and `h ≥ 0` there
are `n₀, r` such that every `a` with `f(a) ≡ 0 mod Jⁿ`, `n ≥ n₀`, and `Jʰ ⊆ H(a)` is
`J^{n-r}`-close to an exact solution (GR Lemma 5.4.12). -/
theorem elkik_approximation {A : Type u} [CommRing A] [IsNoetherianRing A] (J : Ideal A)
    [HenselianRing A J] {ι σ : Type*} [Fintype ι] [Fintype σ] (f : σ → MvPolynomial ι A)
    (h : ℕ) :
    ∃ n₀ r : ℕ, ∀ n : ℕ, n₀ ≤ n → ∀ a : ι → A, (∀ s, MvPolynomial.eval a (f s) ∈ J ^ n) →
      J ^ h ≤ (jacobianIdeal f).map (MvPolynomial.eval a) →
      ∃ b : ι → A, (∀ i, b i - a i ∈ J ^ (n - r)) ∧ ∀ s, MvPolynomial.eval b (f s) = 0 :=
  sorry

/-! ## PerfectoidSpaces:P3/henselisation-of-pairs (construction) -/

namespace Ring

variable (A : Type u) [CommRing A] (I : Ideal A)

/-- P3/henselisation-of-pairs (constructor): the henselisation `A^h` of a pair `(A, I)`, the
filtered colimit of the étale `A`-algebras `B` with `A ⧸ I ≅ B ⧸ IB` (Stacks Tag 0A02). -/
def henselization (A : Type u) [CommRing A] (_I : Ideal A) : Type u := sorry

/-- P3/henselisation-of-pairs (instance): the ring structure of `A^h`. -/
instance henselization.instCommRing : CommRing (henselization A I) := sorry

/-- P3/henselisation-of-pairs (data): the canonical map of pairs `A → A^h` (Stacks Tag 0A02). -/
def henselization.algebraMap : A →+* henselization A I := sorry

/-- P3/henselisation-of-pairs (instance): `A^h` as an `A`-algebra. -/
instance henselization.instAlgebra : _root_.Algebra A (henselization A I) :=
  (henselization.algebraMap A I).toAlgebra

/-- P3/henselisation-of-pairs (data): the ideal `I^h = I A^h` of the henselisation. -/
def henselization.ideal : Ideal (henselization A I) := I.map (henselization.algebraMap A I)

/-- P3/henselisation-of-pairs (instance): `(A^h, I^h)` is a henselian pair (Stacks Tag 0A02). -/
instance henselization.henselianRing :
    HenselianRing (henselization A I) (henselization.ideal A I) := sorry

/-- P3/henselisation-of-pairs (universal-property): a map of pairs `(A, I) → (C, J)` into a
henselian pair extends to `A^h → C` (Stacks Tag 0A02). -/
def henselization.lift {C : Type*} [CommRing C] (J : Ideal C) [HenselianRing C J] (φ : A →+* C)
    (hφ : I.map φ ≤ J) : henselization A I →+* C := sorry

/-- P3/henselisation-of-pairs (universal-property): `lift ∘ algebraMap = φ`. -/
theorem henselization.lift_comp_algebraMap {C : Type*} [CommRing C] (J : Ideal C)
    [HenselianRing C J] (φ : A →+* C) (hφ : I.map φ ≤ J) :
    (henselization.lift A I J φ hφ).comp (henselization.algebraMap A I) = φ := sorry

/-- P3/henselisation-of-pairs (extensionality): two maps of pairs `(A^h, I^h) → (C, J)` into a
henselian pair agreeing on `A` are equal (Stacks Tag 0A02). -/
theorem henselization.hom_ext {C : Type*} [CommRing C] (J : Ideal C) [HenselianRing C J]
    {g₁ g₂ : henselization A I →+* C} (h₁ : (henselization.ideal A I).map g₁ ≤ J)
    (h₂ : (henselization.ideal A I).map g₂ ≤ J)
    (h : g₁.comp (henselization.algebraMap A I) = g₂.comp (henselization.algebraMap A I)) :
    g₁ = g₂ := sorry

/-- P3/henselisation-of-pairs (instance): `A → A^h` is flat (Stacks Tag 0AGU). -/
instance henselization.flat : Module.Flat A (henselization A I) := sorry

/-- P3/henselisation-of-pairs (equivalence): `A ⧸ Iⁿ ≃ A^h ⧸ (I^h)ⁿ` for every `n`
(Stacks Tag 0AGU). -/
def henselization.quotientPowEquiv (n : ℕ) :
    (A ⧸ I ^ n) ≃ₐ[A] (henselization A I ⧸ henselization.ideal A I ^ n) := sorry

/-- P3/henselisation-of-pairs (instance): the henselisation of a noetherian ring is noetherian
(Stacks Tag 0AGV). -/
instance henselization.isNoetherianRing [IsNoetherianRing A] :
    IsNoetherianRing (henselization A I) := sorry

/-- P3/henselisation-of-pairs (compatibility): for `A` noetherian, `A` and `A^h` have the same
`I`-adic completion (Stacks Tag 0AGV). -/
def henselization.adicCompletionEquiv [IsNoetherianRing A] :
    AdicCompletion I A ≃ₐ[A] AdicCompletion (henselization.ideal A I) (henselization A I) := sorry

/-- P3/henselisation-of-pairs (supporting data): functoriality of the henselisation for maps of
pairs, `henselization.lift` of `A → B → B^h`. -/
def henselization.map {B : Type u} [CommRing B] {J : Ideal B} (φ : A →+* B) (hφ : I.map φ ≤ J) :
    henselization A I →+* henselization B J :=
  henselization.lift A I (henselization.ideal B J) ((henselization.algebraMap B J).comp φ) (by
    rw [← Ideal.map_map]
    exact Ideal.map_mono hφ)

/-- P3/henselisation-of-pairs (functoriality): henselisation commutes with filtered colimits of
pairs (Stacks Tag 0A04). -/
def henselization.directLimitEquiv {ι : Type u} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι]
    (G : ι → Type u) [∀ i, CommRing (G i)] (f : ∀ i j, i ≤ j → G i →+* G j)
    [DirectedSystem G fun i j h ↦ f i j h] (I : ∀ i, Ideal (G i))
    (hI : ∀ i j h, (I i).map (f i j h) ≤ I j) :
    henselization (_root_.Ring.DirectLimit G fun i j h ↦ f i j h) (DirectLimit.ideal G f I) ≃+*
      _root_.Ring.DirectLimit (fun i ↦ henselization (G i) (I i))
        fun i j h ↦ henselization.map (G i) (I i) (f i j h) (hI i j h) := sorry

end Ring

section HenselizationTests

/- For a henselian pair `(A, I)` the map `A → A^h` is an isomorphism; `(A, 0)` is henselian. -/
-- test Ring.henselization_test_self (degenerate) [P3/henselisation-of-pairs]
example (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I] :
    Function.Bijective (Ring.henselization.algebraMap A I) ∧
      Function.Bijective (Ring.henselization.algebraMap A ⊥) := sorry

/- The henselisation of `(ℤ, pℤ)` embeds into `ℤ_p` (a henselian local ring) with image the
elements algebraic over `ℚ`, and `ℤ^h ⧸ pⁿ = ℤ ⧸ pⁿ`. -/
-- test Ring.henselization_test_Zp (computation) [P3/henselisation-of-pairs]
example (p : ℕ) [Fact p.Prime]
    (hp : (Ideal.span {(p : ℤ)}).map (Int.castRingHom ℤ_[p]) ≤ IsLocalRing.maximalIdeal ℤ_[p]) :
    Function.Injective (Ring.henselization.lift ℤ (Ideal.span {(p : ℤ)})
        (IsLocalRing.maximalIdeal ℤ_[p]) (Int.castRingHom ℤ_[p]) hp) ∧
      Set.range (Ring.henselization.lift ℤ (Ideal.span {(p : ℤ)})
        (IsLocalRing.maximalIdeal ℤ_[p]) (Int.castRingHom ℤ_[p]) hp) =
        {x : ℤ_[p] | IsAlgebraic ℤ x} ∧
      ∀ n : ℕ, Nonempty (ZMod (p ^ n) ≃+* Ring.henselization ℤ (Ideal.span {(p : ℤ)}) ⧸
        Ring.henselization.ideal ℤ (Ideal.span {(p : ℤ)}) ^ n) := sorry

/- For `A` noetherian the `I`-adic completions of `A` and `A^h` agree and `A^h → Â` is
faithfully flat. -/
-- test Ring.henselization_test_completion (compatibility) [P3/henselisation-of-pairs]
example (A : Type u) [CommRing A] [IsNoetherianRing A] (I : Ideal A) :
    Nonempty (AdicCompletion I A ≃ₐ[A]
        AdicCompletion (Ring.henselization.ideal A I) (Ring.henselization A I)) ∧
      Module.FaithfullyFlat (Ring.henselization A I)
        (AdicCompletion (Ring.henselization.ideal A I) (Ring.henselization A I)) := sorry

-- test Ring.henselization_test_lift (characterisation) [P3/henselisation-of-pairs]
example (A : Type u) [CommRing A] (I : Ideal A) {C : Type u} [CommRing C] (J : Ideal C)
    [HenselianRing C J] (φ : A →+* C) (hφ : I.map φ ≤ J) :
    ∃! g : Ring.henselization A I →+* C, (Ring.henselization.ideal A I).map g ≤ J ∧
      g.comp (Ring.henselization.algebraMap A I) = φ := sorry

/- `ℤ^h` along `p` (which is `ℤ_(p)^h`) is countable, `ℤ_p` is not: `A^h ≠ Â` in general. -/
-- test Ring.henselization_test_not_completion (non-example) [P3/henselisation-of-pairs]
example (p : ℕ) [Fact p.Prime] :
    Countable (Ring.henselization ℤ (Ideal.span {(p : ℤ)})) ∧ ¬ Countable ℤ_[p] := sorry

end HenselizationTests

/-! ## PerfectoidSpaces:P3/henselian-approximate-solutions (lemma) -/

/-- P3/henselian-approximate-solutions (GR Proposition 5.4.13): the approximation of
`exists_solution_of_approx_of_isAdicComplete` holds over any henselian pair `(R, tI)`,
`t` a non-zero-divisor: the exact solution lies in `R` itself, not only in its completion. -/
theorem exists_solution_of_approx_of_henselian {R : Type u} [CommRing R] {ι σ : Type*}
    [Fintype ι] [Fintype σ] {t : R} (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [HenselianRing R (Ideal.span {t} * I)] (f : σ → MvPolynomial ι R) (a : ι → R) (n h : ℕ)
    (hn : 2 * h < n)
    (hjac : MvPolynomial.C (t ^ h) ∈ jacobianIdeal f ⊔ RingHom.ker (MvPolynomial.eval a))
    (happrox : ∀ s, MvPolynomial.eval a (f s) ∈ Ideal.span {t ^ n} * I) :
    ∃ b : ι → R, (∀ i, b i - a i ∈ Ideal.span {t ^ (n - h)} * I) ∧
      ∀ s, MvPolynomial.eval b (f s) = 0 := sorry

/-! ## PerfectoidSpaces:P3/smooth-sections-dense-over-henselian-pairs (lemma) -/

section TIAdic

variable {R : Type u} [CommRing R] (t : R) (I : Ideal R)

/-- P3/smooth-sections-dense-over-henselian-pairs (supporting data): the `(t, I)`-adic
completion `R^∧ = lim_n R ⧸ tⁿI` (GR 5.4.10), the subring of compatible sequences in
`∏ₙ R ⧸ tⁿI`. For `I = R` it is the `t`-adic completion. -/
def tIAdicCompletion_P3 : Subring (∀ n : ℕ, R ⧸ Ideal.span {t ^ n} * I) :=
  ⨅ (m : ℕ) (n : ℕ) (h : m ≤ n), RingHom.eqLocus
    ((Ideal.Quotient.factor (Ideal.mul_mono_left
        (Ideal.span_singleton_le_span_singleton.mpr (pow_dvd_pow t h)))).comp
      (Pi.evalRingHom (fun n : ℕ ↦ R ⧸ Ideal.span {t ^ n} * I) n))
    (Pi.evalRingHom (fun n : ℕ ↦ R ⧸ Ideal.span {t ^ n} * I) m)

/-- P3/smooth-sections-dense-over-henselian-pairs (supporting data): the completion map
`R → R^∧`. -/
def toTIAdicCompletion_P3 : R →+* tIAdicCompletion_P3 t I :=
  (RingHom.pi fun n : ℕ ↦ Ideal.Quotient.mk (Ideal.span {t ^ n} * I)).codRestrict _ fun _ ↦ sorry

/-- P3/smooth-sections-dense-over-henselian-pairs (supporting data): `R^∧[t⁻¹]`. -/
abbrev tIAdicCompletionAway_P3 : Type u :=
  Localization.Away (toTIAdicCompletion_P3 t I t)

/-- P3/smooth-sections-dense-over-henselian-pairs (supporting data): `R[t⁻¹] → R^∧[t⁻¹]`. -/
def awayToCompletionAway_P3 : Localization.Away t →+* tIAdicCompletionAway_P3 t I :=
  Localization.awayMap (toTIAdicCompletion_P3 t I) t

/-- P3/smooth-sections-dense-over-henselian-pairs (supporting data): the basic neighbourhoods
`tᵏI` of `0` in `R[t⁻¹]` for its `(t, I)`-adic topology with lattice `R` (GR 5.4.10). -/
def awayNhd_P3 (k : ℕ) : Set (Localization.Away t) :=
  algebraMap R (Localization.Away t) '' (Ideal.span {t ^ k} * I : Ideal R)

/-- P3/smooth-sections-dense-over-henselian-pairs (supporting data): the basic neighbourhoods of
`0` in `R^∧[t⁻¹]`, the images of the kernels of `R^∧ → R ⧸ tᵏI` (GR 5.4.10). -/
def completionAwayNhd_P3 (k : ℕ) : Set (tIAdicCompletionAway_P3 t I) :=
  algebraMap (tIAdicCompletion_P3 t I) (tIAdicCompletionAway_P3 t I) ''
    {x | (x : ∀ n : ℕ, R ⧸ Ideal.span {t ^ n} * I) k = 0}

end TIAdic

section SmoothSections

variable {R : Type u} [CommRing R] {t : R} (I : Ideal R) (B : Type u) [CommRing B]
  [Algebra (Localization.Away t) B]

/-- P3/smooth-sections-dense-over-henselian-pairs (a), affine form (GR Proposition 5.4.21): for
`(R, tI)` henselian and `B` smooth over `R[t⁻¹]`, the sections `B → R[t⁻¹]` are dense in the
sections `B → R^∧[t⁻¹]` for the `(t, I)`-adic topologies: every section over `R^∧[t⁻¹]` is
approximated, on any finite set of elements, modulo any basic neighbourhood. -/
theorem denseRange_sections_of_smooth_affine (ht : t ∈ nonZeroDivisors R)
    [HenselianRing R (Ideal.span {t} * I)] [Algebra.Smooth (Localization.Away t) B]
    (σ : letI := (awayToCompletionAway_P3 t I).toAlgebra
      B →ₐ[Localization.Away t] tIAdicCompletionAway_P3 t I) (s : Finset B) (k : ℕ) :
    ∃ τ : B →ₐ[Localization.Away t] Localization.Away t, ∀ b ∈ s,
      awayToCompletionAway_P3 t I (τ b) - σ b ∈ completionAwayNhd_P3 t I k := sorry

/-- P3/smooth-sections-dense-over-henselian-pairs (b), affine form (GR Proposition 5.4.30(ii)):
for a smooth map `B → C` of finitely presented `R[t⁻¹]`-algebras, `Spec C → Spec B` induces an
open map on `R[t⁻¹]`-sections for the `(t, I)`-adic topologies. -/
theorem isOpenMap_sections_of_smooth_affine (ht : t ∈ nonZeroDivisors R)
    [HenselianRing R (Ideal.span {t} * I)] (C : Type u) [CommRing C]
    [Algebra (Localization.Away t) C] [Algebra B C] [IsScalarTower (Localization.Away t) B C]
    [Algebra.Smooth B C] [Algebra.FinitePresentation (Localization.Away t) B]
    [Algebra.FinitePresentation (Localization.Away t) C]
    (σ : C →ₐ[Localization.Away t] Localization.Away t) (s : Finset C) (k : ℕ) :
    ∃ (s' : Finset B) (k' : ℕ), ∀ τ : B →ₐ[Localization.Away t] Localization.Away t,
      (∀ b ∈ s', τ b - σ (algebraMap B C b) ∈ awayNhd_P3 t I k') →
      ∃ σ' : C →ₐ[Localization.Away t] Localization.Away t,
        σ'.comp (IsScalarTower.toAlgHom (Localization.Away t) B C) = τ ∧
          ∀ c ∈ s, σ' c - σ c ∈ awayNhd_P3 t I k := sorry

end SmoothSections

-- denseRange_sections_of_smooth: not stated here; needs the `(t, I)`-adic topology on the sets of
--   sections `X(R[t⁻¹])` of quasi-projective `R[t⁻¹]`-schemes, glued from affine charts (GR
--   5.4.16–5.4.19) (supplier: PerfectoidSpaces:P3/smooth-sections-dense-over-henselian-pairs).
--   Affine core: `denseRange_sections_of_smooth_affine`, `isOpenMap_sections_of_smooth_affine`.

/-! ## PerfectoidSpaces:P3/groupoid-orbits-over-henselian-pairs (lemma) -/

-- groupoidOrbits_bijective: not stated here; needs groupoids `X₁ ⇉ X₀` in quasi-projective
--   `R[t⁻¹]`-schemes with the `(t, I)`-adic topology on their sections, and the sets `π₀(X₀(T))`
--   of isomorphism classes of `T`-points (supplier:
--   PerfectoidSpaces:P3/smooth-sections-dense-over-henselian-pairs). The statement: for `X₀` and
--   `(s, t) : X₁ → X₀ ×_{R[t⁻¹]} X₀` smooth, `π₀ X₀(R[t⁻¹]) → π₀ X₀(R^∧[t⁻¹])` is bijective (GR
--   Theorem 5.4.38). Its two instances are `projective_isoClass_bijective` and
--   `finiteEtale_baseChange_isEquivalence_of_henselian`.

/-! ## PerfectoidSpaces:P3/projective-modules-over-henselian-completion (lemma) -/

/-- P3/projective-modules-over-henselian-completion (GR Corollary 5.4.42): for `(R, tI)`
henselian, `t` a non-zero-divisor, base change `M ↦ R^∧[t⁻¹] ⊗ M` is a bijection between the
isomorphism classes of finitely generated projective `R[t⁻¹]`-modules and of `R^∧[t⁻¹]`-modules. -/
theorem projective_isoClass_bijective {R : Type u} [CommRing R] {t : R}
    (ht : t ∈ nonZeroDivisors R) (I : Ideal R) [HenselianRing R (Ideal.span {t} * I)] :
    letI := (awayToCompletionAway_P3 t I).toAlgebra
    (∀ (M N : Type u) [AddCommGroup M] [Module (Localization.Away t) M]
        [Module.Finite (Localization.Away t) M] [Module.Projective (Localization.Away t) M]
        [AddCommGroup N] [Module (Localization.Away t) N] [Module.Finite (Localization.Away t) N]
        [Module.Projective (Localization.Away t) N],
        Nonempty (tIAdicCompletionAway_P3 t I ⊗[Localization.Away t] M
          ≃ₗ[tIAdicCompletionAway_P3 t I] tIAdicCompletionAway_P3 t I ⊗[Localization.Away t] N) →
        Nonempty (M ≃ₗ[Localization.Away t] N)) ∧
    ∀ (P : Type u) [AddCommGroup P] [Module (tIAdicCompletionAway_P3 t I) P]
      [Module.Finite (tIAdicCompletionAway_P3 t I) P]
      [Module.Projective (tIAdicCompletionAway_P3 t I) P],
      ∃ (M : Type u) (_ : AddCommGroup M) (_ : Module (Localization.Away t) M),
        Module.Finite (Localization.Away t) M ∧ Module.Projective (Localization.Away t) M ∧
          Nonempty (tIAdicCompletionAway_P3 t I ⊗[Localization.Away t] M
            ≃ₗ[tIAdicCompletionAway_P3 t I] P) := sorry

/-! ## PerfectoidSpaces:P3/etale-algebra-structure-schemes (lemma) -/

-- etaleStructureScheme_smooth: not stated here; needs the moduli schemes `X_P ⊇ U_P` of
--   (étale) commutative algebra structures on a finitely generated projective `R[t⁻¹]`-module
--   `P` and the group scheme `Aut_P`, as representing objects over Mathlib's
--   `AlgebraicGeometry.Scheme` (supplier: PerfectoidSpaces:P3/etale-algebra-structure-schemes).
--   The statements: `X_P` is affine of finite presentation, `U_P` is the open where the
--   discriminant of the trace form is a unit and is smooth, and `Aut_P ×_{R[t⁻¹]} U_P → U_P ×
--   U_P` is étale (GR Lemmas 5.4.45, 5.4.46, 5.4.50, 5.4.53).
-- autActionMap_etale: not stated here; needs the same moduli schemes `Aut_P`, `U_P` (supplier:
--   PerfectoidSpaces:P3/etale-algebra-structure-schemes). The statement: the action map
--   `Aut_P ×_{R[t⁻¹]} U_P → U_P ×_{R[t⁻¹]} U_P`, `(g, µ) ↦ (µ^g, µ)`, is étale (GR Lemma 5.4.53).

/-- P3/etale-algebra-structure-schemes (b), pointwise core: an algebra structure on a finite free
module is étale iff its trace pairing is perfect, i.e. the discriminant of the trace form is a
unit (GR Lemma 5.4.46; Stacks Tag 0BVH). This is the condition cutting out `U_P ⊆ X_P`. -/
theorem etale_iff_bijective_traceForm (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    [Module.Free A B] [Module.Finite A B] :
    Algebra.Etale A B ↔ Function.Bijective (Algebra.traceForm A B) := sorry

/-! ## PerfectoidSpaces:P3/henselian-finite-etale-approximation (theorem) -/

/-- P3/henselian-finite-etale-approximation (a) (GR Proposition 5.4.54): for `(R, tI)` henselian
and `t` a non-zero-divisor, base change is an equivalence `FÉt(R[t⁻¹]) ≃ FÉt(R^∧[t⁻¹])`. -/
theorem finiteEtale_baseChange_isEquivalence_of_henselian {R : Type u} [CommRing R] {t : R}
    (ht : t ∈ nonZeroDivisors R) (I : Ideal R) [HenselianRing R (Ideal.span {t} * I)] :
    letI := (awayToCompletionAway_P3 t I).toAlgebra
    (CommAlgCat.FiniteEtale.baseChange.{u, u, u} (Localization.Away t)
      (tIAdicCompletionAway_P3 t I)).IsEquivalence := sorry

/-- P3/henselian-finite-etale-approximation (a): the equivalence `FÉt(R[t⁻¹]) ≌ FÉt(R^∧[t⁻¹])`
given by base change (`finiteEtale_baseChange_isEquivalence_of_henselian`). -/
def finiteEtaleEquivOfHenselian {R : Type u} [CommRing R] {t : R} (ht : t ∈ nonZeroDivisors R)
    (I : Ideal R) [HenselianRing R (Ideal.span {t} * I)] :
    CommAlgCat.FiniteEtale.{u} (Localization.Away t) ≌
      CommAlgCat.FiniteEtale.{u} (tIAdicCompletionAway_P3 t I) :=
  letI := (awayToCompletionAway_P3 t I).toAlgebra
  haveI := finiteEtale_baseChange_isEquivalence_of_henselian ht I
  (CommAlgCat.FiniteEtale.baseChange.{u, u, u} (Localization.Away t)
    (tIAdicCompletionAway_P3 t I)).asEquivalence

/-- P3/henselian-finite-etale-approximation (b) (Berkeley Theorem 7.4.8): for a topologically
henselian Tate ring `A`, base change to the completion is an equivalence `FÉt(A) ≃ FÉt(Â)`. -/
theorem Huber.finiteEtale_baseChange_completion_isEquivalence (A : Type u) [CommRing A]
    [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A]
    (hA : IsTopologicallyHenselian A) :
    (CommAlgCat.FiniteEtale.baseChange.{u, u, u} A (UniformSpace.Completion A)).IsEquivalence :=
  sorry

/-! ## PerfectoidSpaces:P3/finite-etale-completed-direct-limit (lemma) -/

-- Huber.finiteEtale_completedDirectLimit: not stated here; needs the colimit Tate topology on
--   `colim A_i` with ring of definition `colim A_{i,0}` and its completion (supplier: AdicSpaces
--   Layer 0). Perfectoid core (Sch12 Lemma 7.5(i)), over stage P1's completed colimit:
--   `Perfectoid.completedFilteredColimit.exists_finiteEtale_model`.

namespace Perfectoid

section CompletedColimit

variable (p : ℕ) [Fact p.Prime] {J : Type u} [SmallCategory J] [IsFiltered J]
  (F : J ⥤ PerfectoidRingCat.{u} p) (j₀ : J) (ϖ : PseudoUniformizerRoots p (F.obj j₀))

/-- P3/finite-etale-completed-direct-limit (perfectoid core; Sch12 Lemma 7.5(i)): every finite
étale algebra over the completed colimit of a filtered system of perfectoid Tate rings (stage P1)
is the base change of a finite étale algebra over some member. -/
theorem completedFilteredColimit.exists_finiteEtale_model
    (S : CommAlgCat.FiniteEtale.{u} (completedFilteredColimit p F j₀ ϖ)) :
    ∃ (j : J) (Sⱼ : CommAlgCat.FiniteEtale.{u} (F.obj j)),
      letI := (completedFilteredColimit.ι p F j₀ ϖ j).toAlgebra
      Nonempty ((CommAlgCat.FiniteEtale.baseChange.{u, u, u} (F.obj j)
        (completedFilteredColimit p F j₀ ϖ)).obj Sⱼ ≅ S) := sorry

/-- P3/finite-etale-completed-direct-limit (perfectoid core): two finite étale algebras over a
member that become isomorphic over the completed colimit are isomorphic at a later stage. -/
theorem completedFilteredColimit.exists_iso_of_iso_finiteEtale (j : J)
    (S T : CommAlgCat.FiniteEtale.{u} (F.obj j))
    (e : letI := (completedFilteredColimit.ι p F j₀ ϖ j).toAlgebra
      (CommAlgCat.FiniteEtale.baseChange.{u, u, u} (F.obj j)
        (completedFilteredColimit p F j₀ ϖ)).obj S ≅
      (CommAlgCat.FiniteEtale.baseChange.{u, u, u} (F.obj j)
        (completedFilteredColimit p F j₀ ϖ)).obj T) :
    ∃ (k : J) (g : j ⟶ k), letI := (PerfectoidRingCat.Hom.hom (F.map g)).toAlgebra
      Nonempty ((CommAlgCat.FiniteEtale.baseChange.{u, u, u} (F.obj j) (F.obj k)).obj S ≅
        (CommAlgCat.FiniteEtale.baseChange.{u, u, u} (F.obj j) (F.obj k)).obj T) := sorry

end CompletedColimit

/-! ## PerfectoidSpaces:P3/etale-over-perfect-is-perfect (lemma) -/

/-- P3/etale-over-perfect-is-perfect (a) (Bhatt Lemma 4.3.8): for a weakly étale map `A → B` of
`𝔽_p`-algebras the Frobenius square is a pushout: the relative Frobenius `B ⊗_{A,Φ} A → B` is an
isomorphism. -/
theorem isPushout_frobenius_of_weaklyEtale (p : ℕ) [Fact p.Prime] (A B : Type u) [CommRing A]
    [CommRing B] [_root_.Algebra A B] [CharP A p] [CharP B p] [_root_.Algebra.WeaklyEtale A B] :
    IsPushout (CommRingCat.ofHom (algebraMap A B)) (CommRingCat.ofHom (frobenius A p))
      (CommRingCat.ofHom (frobenius B p)) (CommRingCat.ofHom (algebraMap A B)) := sorry

/-- P3/etale-over-perfect-is-perfect (a): a weakly étale (for instance étale) algebra over a
perfect `𝔽_p`-algebra is perfect (Bhatt Lemma 4.3.8). -/
theorem perfectRing_of_etale (p : ℕ) [Fact p.Prime] (A B : Type u) [CommRing A] [CommRing B]
    [_root_.Algebra A B] [CharP A p] [CharP B p] [PerfectRing A p]
    [_root_.Algebra.WeaklyEtale A B] : PerfectRing B p := sorry

-- Almost.IsAlmostWeaklyEtaleAlg.frobenius_isPushout: not stated here; needs the Frobenius
--   endomorphism and Frobenius base change of almost algebras over a basic setup of
--   characteristic `p`, which stage P0 does not build (supplier:
--   PerfectoidSpaces:P0/almost-algebras).
--   The statement is GR Theorem 3.5.13(ii): for a weakly étale morphism of almost algebras the
--   Frobenius square is cocartesian.

/-! ## PerfectoidSpaces:P3/finite-etale-under-completed-perfection (lemma) -/

/-- P3/finite-etale-under-completed-perfection (Sch12 Lemma 7.5(ii), without base field): if
`φ : (S, S⁺) → (R, R⁺)` exhibits `R` as the completed perfection of the complete Tate ring `S` of
characteristic `p` (stage P2's `IsCompletedPerfection`), base change is an equivalence
`FÉt(S) ≃ FÉt(R)` (topological invariance of the étale site, Stacks Tag 04DZ). -/
theorem _root_.TauCeti.Huber.finiteEtale_completedPerfection (p : ℕ) [Fact p.Prime]
    {S R : Type u} [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S]
    [IsTateRing S] [CompleteSpace S] [T2Space S] [CharP S p] [CommRing R] [UniformSpace R]
    [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    {Q : Pair S} {P : Pair R} (φ : Pair.Hom Q P) (hφ : Perfectoid.IsCompletedPerfection p φ) :
    letI := φ.toRingHom.toAlgebra
    (CommAlgCat.FiniteEtale.baseChange.{u, u, u} S R).IsEquivalence := sorry

end Perfectoid

/-! ## PerfectoidSpaces:P3/residue-field-finite-etale-colimit (lemma) -/

-- Huber.finiteEtale_residueField_colim: not stated here; needs the presentation-independent
--   rational localisations `O(U)` with their restriction maps and the completed residue field
--   `k(x)^` of a point `x ∈ Spa(A, A⁺)` as a complete nonarchimedean field (supplier: AdicSpaces
--   Layer 3). The statement: base change gives `2-colim_{U ∋ x} FÉt(O(U)) ≃ FÉt(k(x)^)` (Berkeley
--   Lemma 7.4.6; KL Lemma 2.2.3(a)).

/-! ## PerfectoidSpaces:P3/finite-etale-over-uniform-is-uniform (lemma) -/

section FiniteEtaleUniform

variable {A B : Type u} [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A]
  [IsTateRing A] [CompleteSpace A] [T2Space A] [CommRing B] [Algebra A B] [Module.Finite A B]
  [Algebra.Etale A B] [TopologicalSpace B] [IsModuleTopology A B] [IsTopologicalRing B]
  [IsTateRing B]

/-- P3/finite-etale-over-uniform-is-uniform (a) (AWS Lemma 1.10.1): a finite étale algebra with
its natural topology over a complete uniform Tate ring is uniform. -/
theorem Huber.isBounded_powerBoundedSubring_of_finiteEtale
    (hA : IsBounded (powerBoundedSubring A : Set A)) :
    IsBounded (powerBoundedSubring B : Set B) := sorry

/-- P3/finite-etale-over-uniform-is-uniform (b) (AWS Lemma 1.10.1): `B°` is the integral closure
of `A°` in `B`. -/
theorem Huber.finiteEtale_powerBounded_eq_integralClosure
    (hA : IsBounded (powerBoundedSubring A : Set A)) :
    (powerBoundedSubring B : Set B) = integralClosure (powerBoundedSubring A) B := sorry

/-- P3/finite-etale-over-uniform-is-uniform (c) (AWS proof of Lemma 1.10.1): `Tr_{B/A}(B°) ⊆ A°`,
here for `B` free over `A` (Mathlib's `Algebra.trace` is the trace of free modules). -/
theorem Huber.trace_mem_powerBoundedSubring_of_finiteEtale [Module.Free A B]
    (hA : IsBounded (powerBoundedSubring A : Set A)) {b : B} (hb : b ∈ powerBoundedSubring B) :
    Algebra.trace A B b ∈ powerBoundedSubring A := sorry

end FiniteEtaleUniform

namespace Perfectoid

namespace FiniteEtale

/-- P3/finite-etale-over-uniform-is-uniform (supporting data): for `A` uniform Tate and `B`
finite étale over `A` with its natural topology, the `A°`-algebra structure on `B°` restricting
`A → B` (`B` is uniform by `Huber.isBounded_powerBoundedSubring_of_finiteEtale`, and `A → B` is
continuous). -/
@[instance_reducible]
def powerBoundedAlgebra (A B : Type u) [CommRing A] [UniformSpace A] [IsUniformAddGroup A]
    [IsTopologicalRing A] [IsTateRing A] [CompleteSpace A] [T2Space A] [CommRing B]
    [_root_.Algebra A B] [Module.Finite A B] [_root_.Algebra.Etale A B] [TopologicalSpace B]
    [IsModuleTopology A B] [IsTopologicalRing B] [IsTateRing B]
    (hA : IsBounded (powerBoundedSubring A : Set A)) :
    _root_.Algebra (powerBoundedSubring A) (powerBoundedSubring B) :=
  ((algebraMap A B).restrict _ _ fun _ hx ↦
    map_mem_powerBoundedSubring (Huber.isBounded_powerBoundedSubring_of_finiteEtale hA) _
      (continuous_algebraMap A B) hx).toAlgebra

section Predicates

variable (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R]

/-- P3/finite-etale-over-perfectoid-is-perfectoid (supporting definition): the `R`-algebra `S`,
with its natural topology as a finite `R`-module (Mathlib `IsModuleTopology`, with the uniformity
of the additive group), is a complete Hausdorff perfectoid Tate ring. -/
def IsNaturallyPerfectoid (S : Type u) [CommRing S] [_root_.Algebra R S] : Prop :=
  ∀ [UniformSpace S] [IsUniformAddGroup S] [IsModuleTopology R S] [IsTopologicalRing S],
    ∃ (_ : IsTateRing S) (_ : CompleteSpace S) (_ : T2Space S), IsPerfectoidTateRing p S

variable [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R]

/-- P3/integral-closure-almost-finite-etale (supporting definition): for `S` finite étale over the
perfectoid Tate ring `R` with its natural topology, `S°ᵃ` is almost finite étale over `R°ᵃ`
(stage P0's `Almost.IsAlmostFiniteEtaleAlg` for the basic setup `(R°, R°°)` of stage P1) and
uniformly almost finite projective (KL Definition 5.5.8). -/
def IsAlmostFiniteEtaleIntegral (S : Type u) [CommRing S] [_root_.Algebra R S]
    [Module.Finite R S] [_root_.Algebra.Etale R S] [TopologicalSpace S] [IsModuleTopology R S]
    [IsTopologicalRing S] [IsTateRing S] : Prop :=
  letI := powerBoundedAlgebra R S (IsPerfectoidTateRing.isBounded_powerBoundedSubring p)
  Almost.IsAlmostFiniteEtaleAlg (almostSetup p R) (powerBoundedSubring S) ∧
    ∃ n : ℕ, Almost.Module.UniformlyAlmostFiniteProjective
      (Almost.relModule (almostSetup p R) (powerBoundedSubring S)) n

/-- P3/almost-finite-etale-equivalence (supporting definition): `(R°ᵃ)_afet`, stage P0's
category of almost finite étale algebras over the almost algebra `R°ᵃ` of the basic setup
`(R°, R°°)`. -/
abbrev AlmostCat : Type (u + 1) :=
  Almost.Algebra.FiniteEtale (Almost.Algebra.of (almostSetup p R) (powerBoundedSubring R))

end Predicates

end FiniteEtale

/-! ## PerfectoidSpaces:P3/finite-etale-covers-in-characteristic-p (theorem) -/

section CharP

variable (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  [CharP R p]

/-- P3/finite-etale-covers-in-characteristic-p (i) (Sch12 Proposition 5.23; Bhatt Proposition
4.3.4): a finite étale algebra over a perfectoid Tate ring of characteristic `p` is perfect,
complete and uniform for its natural topology, hence perfectoid. -/
theorem isPerfectoid_of_finiteEtale_charP (S : Type u) [CommRing S] [_root_.Algebra R S]
    [Module.Finite R S] [_root_.Algebra.Etale R S] : FiniteEtale.IsNaturallyPerfectoid p R S :=
  sorry

/-- P3/finite-etale-covers-in-characteristic-p (ii)–(iv) (Sch12 Proposition 5.23; GR Theorem
3.5.28): `S°ᵃ` is almost finite étale and uniformly almost finite projective over `R°ᵃ`. -/
theorem almostFiniteEtale_powerBounded_charP (S : Type u) [CommRing S]
    [_root_.Algebra R S] [Module.Finite R S] [_root_.Algebra.Etale R S] [TopologicalSpace S]
    [IsModuleTopology R S] [IsTopologicalRing S] [IsTateRing S] :
    FiniteEtale.IsAlmostFiniteEtaleIntegral p R S := sorry

/-- P3/finite-etale-covers-in-characteristic-p (v): for `S` faithfully flat over `R`, `S°ᵃ` is
almost faithfully flat over `R°ᵃ` (Bhatt Remark 4.3.5). -/
theorem almostFaithfullyFlat_powerBounded_charP (S : Type u) [CommRing S] [_root_.Algebra R S]
    [Module.Finite R S] [_root_.Algebra.Etale R S] [Module.FaithfullyFlat R S] [TopologicalSpace S]
    [IsModuleTopology R S] [IsTopologicalRing S] [IsTateRing S] :
    letI := FiniteEtale.powerBoundedAlgebra R S
      (IsPerfectoidTateRing.isBounded_powerBoundedSubring p)
    Almost.IsAlmostFaithfullyFlatAlg (almostSetup p R) (powerBoundedSubring S) := sorry

/-! ## PerfectoidSpaces:P3/characteristic-p-almost-purity-equivalence (theorem) -/

/-- P3/characteristic-p-almost-purity-equivalence (GR Theorem 3.5.28; Bhatt Theorem 4.3.6): for
a perfectoid Tate ring of characteristic `p`, `A ↦ A_*[ϖ⁻¹]` is an equivalence
`(R°ᵃ)_afet ≃ FÉt(R)`, with quasi-inverse `S ↦ S°ᵃ`. -/
def almostFiniteEtaleEquivCharP :
    FiniteEtale.AlmostCat p R ≌ CommAlgCat.FiniteEtale.{u} R := sorry

/-- P3/characteristic-p-almost-purity-equivalence: for every `A ∈ (R°ᵃ)_afet`, the ring of
almost elements `A_*` is perfect (GR Theorem 3.5.28). -/
theorem perfectRing_elements_of_almostFiniteEtale_charP (A : FiniteEtale.AlmostCat p R) :
    PerfectRing ((Almost.Algebra.elements (almostSetup p R)).obj A.obj.right) p := sorry

end CharP

/-! ## PerfectoidSpaces:P3/finite-etale-untilting-functor (construction) -/

section Untilt

variable (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P3/finite-etale-untilting-functor (supporting data): the untilting functor for the choice of
`ϖ♭` with `ϖ = (ϖ♭)♯`, `ϖ ^ p ∣ p`: the composite `FÉt(R♭) ≃ (R♭°ᵃ)_afet → (R♭°ᵃ/ϖ♭)_afet =
(R°ᵃ/ϖ)_afet ≃ (R°ᵃ)_afet → FÉt(R)`, `T ↦ A_*[ϖ⁻¹]` with `A` the unique flat deformation of
`T°ᵃ/ϖ♭` (Sch12 Proposition 5.22 and the diagram after it; Bhatt §6.2). -/
def FiniteEtale.untiltOf (ϖ : PseudoUniformizerRoots p R) :
    CommAlgCat.FiniteEtale.{u} (tilt p R) ⥤ CommAlgCat.FiniteEtale.{u} R := sorry

/-- P3/finite-etale-untilting-functor (constructor): the untilting functor
`FÉt(R♭) ⥤ FÉt(R)`, `T ↦ T♯` (Sch12 Proposition 5.22; AWS Lemma 2.8.10; KL Lemma 3.6.20), for an
arbitrary choice of `ϖ♭` (`FiniteEtale.untilt_independent`). -/
def FiniteEtale.untilt :
    CommAlgCat.FiniteEtale.{u} (tilt p R) ⥤ CommAlgCat.FiniteEtale.{u} R :=
  FiniteEtale.untiltOf p R (Classical.arbitrary _)

/-- P3/finite-etale-untilting-functor (instance): `T♯` with its natural topology is a perfectoid
Tate ring (Sch12 Proposition 5.22). -/
theorem FiniteEtale.untilt_isPerfectoid (T : CommAlgCat.FiniteEtale.{u} (tilt p R)) :
    FiniteEtale.IsNaturallyPerfectoid p R ((FiniteEtale.untilt p R).obj T) := sorry

/-- P3/finite-etale-untilting-functor (equivalence): `(T♯)♭ ≅ T` as `R♭`-algebras (Sch12
Proposition 5.22; compatible with stage P1's `tiltingEquivalence`). -/
def FiniteEtale.tiltUntiltIso (T : CommAlgCat.FiniteEtale.{u} (tilt p R))
    [UniformSpace ((FiniteEtale.untilt p R).obj T)]
    [IsUniformAddGroup ((FiniteEtale.untilt p R).obj T)]
    [IsModuleTopology R ((FiniteEtale.untilt p R).obj T)]
    [IsTopologicalRing ((FiniteEtale.untilt p R).obj T)]
    [IsTateRing ((FiniteEtale.untilt p R).obj T)] [CompleteSpace ((FiniteEtale.untilt p R).obj T)]
    [T2Space ((FiniteEtale.untilt p R).obj T)]
    [IsPerfectoidTateRing p ((FiniteEtale.untilt p R).obj T)] :
    letI := (tilt.map p (algebraMap R ((FiniteEtale.untilt p R).obj T))
      (continuous_algebraMap _ _)).toAlgebra
    tilt p ((FiniteEtale.untilt p R).obj T) ≃ₐ[tilt p R] T := sorry

/-- P3/finite-etale-untilting-functor (projection): `(T♯)°ᵃ` is almost finite étale and uniformly
almost finite projective over `R°ᵃ` (Sch12 Proposition 5.22). -/
theorem FiniteEtale.untilt_almostFiniteEtale (T : CommAlgCat.FiniteEtale.{u} (tilt p R))
    [TopologicalSpace ((FiniteEtale.untilt p R).obj T)]
    [IsModuleTopology R ((FiniteEtale.untilt p R).obj T)]
    [IsTopologicalRing ((FiniteEtale.untilt p R).obj T)]
    [IsTateRing ((FiniteEtale.untilt p R).obj T)] :
    FiniteEtale.IsAlmostFiniteEtaleIntegral p R ((FiniteEtale.untilt p R).obj T) := sorry

/-- P3/finite-etale-untilting-functor (functoriality): for a continuous map `φ : R → R'` of
perfectoid Tate rings, `(T ⊗_{R♭} R'♭)♯ ≅ T♯ ⊗_R R'` (KL Lemma 3.6.20; ECD Theorem 6.1). -/
def FiniteEtale.untiltBaseChangeIso {R' : Type u} [CommRing R'] [UniformSpace R']
    [IsUniformAddGroup R'] [IsTopologicalRing R'] [IsTateRing R'] [CompleteSpace R'] [T2Space R']
    [IsPerfectoidTateRing p R'] (φ : R →+* R') (hφ : Continuous φ) :
    letI := φ.toAlgebra
    letI := (tilt.map p φ hφ).toAlgebra
    FiniteEtale.untilt p R ⋙ CommAlgCat.FiniteEtale.baseChange.{u, u, u} R R' ≅
      CommAlgCat.FiniteEtale.baseChange.{u, u, u} (tilt p R) (tilt p R') ⋙
        FiniteEtale.untilt p R' := sorry

/-- P3/finite-etale-untilting-functor (simp): the rank of `T♯` at a point `x` of `Spa(R, R⁺)`
(at the prime `supp x`) is the rank of `T` at `x♭` (stage P2's tilting map `spaTilt`). -/
@[simp] theorem FiniteEtale.untilt_rank (P : Pair R) (T : CommAlgCat.FiniteEtale.{u} (tilt p R))
    (x : ValuationSpectrum.spa P.plus) :
    Module.rankAtStalk ((FiniteEtale.untilt p R).obj T) ⟨x.1.supp, inferInstance⟩ =
      Module.rankAtStalk T ⟨(PerfectoidSpace.spaTilt p P x).1.supp, inferInstance⟩ := sorry

/-- P3/finite-etale-untilting-functor (structure): `(T₁ ⊗ T₂)♯ ≅ T₁♯ ⊗ T₂♯`; the untilting
functor is monoidal (Sch12 Theorem 5.25). -/
def FiniteEtale.untiltTensorIso (T₁ T₂ : CommAlgCat.FiniteEtale.{u} (tilt p R))
    [_root_.Algebra.Etale (tilt p R) (T₁ ⊗[tilt p R] T₂)]
    [_root_.Algebra.Etale R
      ((FiniteEtale.untilt p R).obj T₁ ⊗[R] (FiniteEtale.untilt p R).obj T₂)] :
    (FiniteEtale.untilt p R).obj (CommAlgCat.FiniteEtale.of (tilt p R) (T₁ ⊗[tilt p R] T₂)) ≅
      CommAlgCat.FiniteEtale.of R
        ((FiniteEtale.untilt p R).obj T₁ ⊗[R] (FiniteEtale.untilt p R).obj T₂) := sorry

/-- P3/finite-etale-untilting-functor (characterisation): `T♯` is faithfully flat over `R` iff
`T` is faithfully flat over `R♭`. -/
theorem FiniteEtale.untilt_faithfullyFlat_iff (T : CommAlgCat.FiniteEtale.{u} (tilt p R)) :
    Module.FaithfullyFlat R ((FiniteEtale.untilt p R).obj T) ↔ Module.FaithfullyFlat (tilt p R) T :=
  sorry

/-- P3/finite-etale-untilting-functor (compatibility): `T♯ ≅ W(T°)[1/[ϖ♭]] ⧸ ξ`, stage P1's
untilt of the perfectoid `R♭`-algebra `T` along the extension of `ker(θ : W(R♭°) → R°)`
(KL Lemma 3.6.20; AWS Lemma 2.8.10; P1/untilt-construction). -/
def FiniteEtale.untiltIsoWitt [Nontrivial R] (T : CommAlgCat.FiniteEtale.{u} (tilt p R))
    [UniformSpace T] [IsUniformAddGroup T] [IsModuleTopology (tilt p R) T] [IsTopologicalRing T]
    [IsTateRing T] [CompleteSpace T] [T2Space T] [IsPerfectoidTateRing p T] :
    (FiniteEtale.untilt p R).obj T ≃+*
      Perfectoid.untilt p (Pair.powerBounded T)
        ((RingHom.ker (theta p (Pair.powerBounded R))).map
          (WittVector.map (PerfectoidAlgebra.tiltPlusHom p (Under.mk
            (Y := PerfectoidRingCat.of p T)
            (PerfectoidRingCat.Hom.mk (algebraMap (tilt p R) T)
              (continuous_algebraMap _ _)))))) := sorry

/-- P3/finite-etale-untilting-functor (other): different choices of `ϖ♭` give canonically
isomorphic untilting functors (Sch12 Proposition 5.22). -/
theorem FiniteEtale.untilt_independent (ϖ ϖ' : PseudoUniformizerRoots p R) :
    Nonempty (FiniteEtale.untiltOf p R ϖ ≅ FiniteEtale.untiltOf p R ϖ') := sorry

end Untilt

section UntiltTests

variable (p : ℕ) [Fact p.Prime]

/- `R♭♯ = R`, and `T♯` is the zero ring iff `T` is. -/
-- test Perfectoid.FiniteEtale.untilt_test_self (degenerate) [P3/finite-etale-untilting-functor]
example (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
    (T : CommAlgCat.FiniteEtale.{u} (tilt p R)) :
    Nonempty ((FiniteEtale.untilt p R).obj (CommAlgCat.FiniteEtale.of (tilt p R) (tilt p R)) ≅
        CommAlgCat.FiniteEtale.of R R) ∧
      (Subsingleton ((FiniteEtale.untilt p R).obj T) ↔ Subsingleton T) := sorry

/- `K = ℚ_p(p^{1/p^∞})^` (stage P1's `padicPRootTower`), `t ∈ K♭` with `t♯ = p`, `p` odd: the
untilt of `K♭[u]/(u² − t)` is `K[u]/(u² − p)` (Bhatt Example 3.2.9). -/
-- test Perfectoid.FiniteEtale.untilt_test_quadratic (computation)
--   [P3/finite-etale-untilting-functor]
example (hp : p ≠ 2) (t : tilt p (padicPRootTower p)) (ht : tilt.sharp t = (p : padicPRootTower p))
    [Module.Finite (tilt p (padicPRootTower p))
      (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C t))]
    [_root_.Algebra.Etale (tilt p (padicPRootTower p))
      (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C t))]
    [Module.Finite (padicPRootTower p)
      (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C (p : padicPRootTower p)))]
    [_root_.Algebra.Etale (padicPRootTower p)
      (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C (p : padicPRootTower p)))] :
    Nonempty ((FiniteEtale.untilt p (padicPRootTower p)).obj
        (CommAlgCat.FiniteEtale.of _ (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C t))) ≅
      CommAlgCat.FiniteEtale.of _
        (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C (p : padicPRootTower p)))) := sorry

/- `(T♯)♭ ≅ T`, and `T♯` is stage P1's untilt of the perfectoid `R♭`-algebra `T` under the
tilting equivalence of perfectoid algebras. -/
-- test Perfectoid.FiniteEtale.untilt_test_tilt (compatibility) [P3/finite-etale-untilting-functor]
example (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
    (T : CommAlgCat.FiniteEtale.{u} (tilt p R)) [UniformSpace T] [IsUniformAddGroup T]
    [IsModuleTopology (tilt p R) T] [IsTopologicalRing T] [IsTateRing T] [CompleteSpace T]
    [T2Space T] [IsPerfectoidTateRing p T] :
    Nonempty (((tiltingEquivalence p R).inverse.obj (Under.mk (Y := PerfectoidRingCat.of p T)
        (PerfectoidRingCat.Hom.mk (algebraMap (tilt p R) T)
          (continuous_algebraMap _ _)))).right ≃+* (FiniteEtale.untilt p R).obj T) := sorry

/- `T♯` is the finite étale `R`-algebra `S` whose reduction `S° ⧸ ϖ` is `T° ⧸ ϖ♭` over
`R° ⧸ ϖ ≅ R♭° ⧸ ϖ♭` (stage P1's `sharpQuotEquiv`). -/
-- test Perfectoid.FiniteEtale.untilt_test_mod_varpi (characterisation)
--   [P3/finite-etale-untilting-functor]
example (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
    (ϖ : PseudoUniformizerRoots p R) (T : CommAlgCat.FiniteEtale.{u} (tilt p R))
    [TopologicalSpace T] [IsModuleTopology (tilt p R) T] [IsTopologicalRing T] [IsTateRing T]
    (S : CommAlgCat.FiniteEtale.{u} R) [TopologicalSpace S] [IsModuleTopology R S]
    [IsTopologicalRing S] [IsTateRing S] :
    letI := FiniteEtale.powerBoundedAlgebra R S
      (IsPerfectoidTateRing.isBounded_powerBoundedSubring p)
    letI := FiniteEtale.powerBoundedAlgebra (tilt p R) T
      (IsPerfectoidTateRing.isBounded_powerBoundedSubring p)
    Nonempty ((FiniteEtale.untilt p R).obj T ≅ S) ↔
      ∃ e : powerBoundedSubring S ⧸ Ideal.span {algebraMap _ _ (ϖ.rootPB 0)} ≃+*
          powerBoundedSubring T ⧸ Ideal.span {algebraMap _ _ (ϖ.toTiltPB p)},
        ∀ (x : powerBoundedSubring (tilt p R)) (y : powerBoundedSubring R),
          tilt.sharpQuotEquiv ϖ (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y →
          e (Ideal.Quotient.mk _ (algebraMap _ (powerBoundedSubring S) y)) =
            Ideal.Quotient.mk _ (algebraMap _ (powerBoundedSubring T) x) := sorry

/- There is no ring map `ℚ_p^cycl♭ → ℚ_p^cycl` (characteristics `p` and `0`), and `♯` is not
additive: the untilt is not a base change along a ring map `R♭ → R`. -/
-- test Perfectoid.FiniteEtale.untilt_test_not_basechange (non-example)
--   [P3/finite-etale-untilting-functor]
example : IsEmpty (tilt p (padicCyclotomic p) →+* padicCyclotomic p) ∧
    ¬ ∀ x y : tilt p (padicCyclotomic p), tilt.sharp (x + y) = tilt.sharp x + tilt.sharp y :=
  sorry

end UntiltTests

/-! ## PerfectoidSpaces:P3/tilting-finite-etale-algebras-fully-faithful (theorem) -/

section FullyFaithful

variable (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P3/tilting-finite-etale-algebras-fully-faithful (Sch12 Theorem 5.25): the untilting functor is
full. -/
instance FiniteEtale.untilt_full : (FiniteEtale.untilt p R).Full := sorry

/-- P3/tilting-finite-etale-algebras-fully-faithful (Sch12 Theorem 5.25): the untilting functor is
faithful. -/
instance FiniteEtale.untilt_faithful : (FiniteEtale.untilt p R).Faithful := sorry

/-- P3/tilting-finite-etale-algebras-fully-faithful (Sch12 Theorem 5.25): the essential image of
the untilting functor is the finite étale `R`-algebras that are perfectoid for their natural
topology with `S°ᵃ` almost finite étale over `R°ᵃ`. -/
theorem FiniteEtale.mem_essImage_untilt_iff (S : CommAlgCat.FiniteEtale.{u} R) [TopologicalSpace S]
    [IsModuleTopology R S] [IsTopologicalRing S] [IsTateRing S] :
    (FiniteEtale.untilt p R).essImage S ↔
      FiniteEtale.IsNaturallyPerfectoid p R S ∧ FiniteEtale.IsAlmostFiniteEtaleIntegral p R S :=
  sorry

end FullyFaithful

/-! ## PerfectoidSpaces:P3/untilt-of-algebraically-closed-field (lemma) -/

/-- P3/untilt-of-algebraically-closed-field (Sch12 Proposition 3.8; Bhatt Proposition 3.2.10): if
the tilt of a perfectoid field is algebraically closed, so is the field. -/
theorem isAlgClosed_of_isAlgClosed_tilt (p : ℕ) [Fact p.Prime] (K : Type u)
    [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K] [IsPerfectoidField p K]
    [IsAlgClosed (tilt p K)] : IsAlgClosed K := sorry

/-! ## PerfectoidSpaces:P3/finite-extensions-of-perfectoid-fields (theorem) -/

section FiniteExtensions

variable (p : ℕ) [Fact p.Prime] (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K]
  [CompleteSpace K] [IsPerfectoidField p K]

/-- P3/finite-extensions-of-perfectoid-fields (i) (Sch12 Theorem 3.7(i); KL Theorem 3.5.6): a
finite extension `L` of a perfectoid field, with the unique extension of the absolute value, is
a perfectoid field. -/
theorem isPerfectoidField_of_finite (L : Type u) [NontriviallyNormedField L]
    [NormedAlgebra K L] [FiniteDimensional K L] [IsUltrametricDist L] [CompleteSpace L] :
    IsPerfectoidField p L := sorry

/-- P3/finite-extensions-of-perfectoid-fields (ii) (Sch12 Theorem 3.7(ii); Berkeley Theorem
7.3.2): untilting is an equivalence `FÉt(K♭) ≃ FÉt(K)`. -/
instance FiniteEtale.untilt_isEquivalence_field : (FiniteEtale.untilt p K).IsEquivalence := sorry

/-- P3/finite-extensions-of-perfectoid-fields (ii): untilting preserves degrees. -/
theorem FiniteEtale.finrank_untilt_field (T : CommAlgCat.FiniteEtale.{u} (tilt p K)) :
    Module.finrank K ((FiniteEtale.untilt p K).obj T) = Module.finrank (tilt p K) T := sorry

/-- P3/finite-extensions-of-perfectoid-fields (iii) (Sch12 Theorem 3.7): `K` is algebraically
closed iff `K♭` is. -/
theorem isAlgClosed_iff_tilt : IsAlgClosed K ↔ IsAlgClosed (tilt p K) := sorry

/-- P3/finite-extensions-of-perfectoid-fields (iv) (Tate; GR §6.6; Berkeley Example 7.3.3): for a
finite extension `L/K`, `L°ᵃ` is almost finite étale and uniformly almost finite projective over
`K°ᵃ`. -/
theorem almostFiniteEtale_powerBounded_of_finite (L : Type u) [NontriviallyNormedField L]
    [NormedAlgebra K L] [FiniteDimensional K L] [IsUltrametricDist L] [_root_.Algebra.Etale K L]
    [IsModuleTopology K L] : FiniteEtale.IsAlmostFiniteEtaleIntegral p K L := sorry

end FiniteExtensions

/-! ## PerfectoidSpaces:P3/cyclotomic-completion-of-finite-extension (lemma) -/

section Cyclotomic

variable (p : ℕ) [Fact p.Prime]

/-- P3/cyclotomic-completion-of-finite-extension (data): for a subextension `K ⊆ ℂ_p` of `ℚ_p`,
the closure `L` of `K(μ_{p^∞})` in `ℂ_p`, the closure of the compositum of `K` with stage P1's
`ℚ_p^cycl`. -/
def cyclotomicCompositum (K : IntermediateField ℚ_[p] ℂ_[p]) : Subfield ℂ_[p] :=
  (K.toSubfield ⊔ padicCyclotomic p).topologicalClosure

/-- P3/cyclotomic-completion-of-finite-extension (instance): `L` is complete, being closed. -/
instance cyclotomicCompositum.instCompleteSpace (K : IntermediateField ℚ_[p] ℂ_[p]) :
    CompleteSpace (cyclotomicCompositum p K) :=
  (Subfield.isClosed_topologicalClosure _).completeSpace_coe

/-- P3/cyclotomic-completion-of-finite-extension (instance): the absolute value of `L` is
nontrivial. -/
instance cyclotomicCompositum.instNontriviallyNormedField (K : IntermediateField ℚ_[p] ℂ_[p]) :
    NontriviallyNormedField (cyclotomicCompositum p K) :=
  { (inferInstance : NormedField (cyclotomicCompositum p K)) with non_trivial := sorry }

/-- P3/cyclotomic-completion-of-finite-extension (Sch12 Theorem 3.7(i); KL Remark 3.5.12): for
`K/ℚ_p` finite, `L` is a perfectoid field, finite over `ℚ_p^cycl` of degree at most `[K : ℚ_p]`,
with `K(μ_{p^∞})` dense in it. -/
theorem cyclotomicCompositum.isPerfectoidField (K : IntermediateField ℚ_[p] ℂ_[p])
    [FiniteDimensional ℚ_[p] K] :
    IsPerfectoidField p (cyclotomicCompositum p K) ∧
      padicCyclotomic p ≤ cyclotomicCompositum p K ∧
      Module.finrank (padicCyclotomic p)
          (IntermediateField.adjoin (padicCyclotomic p) (K : Set ℂ_[p])) ≤
        Module.finrank ℚ_[p] K ∧
      ((IntermediateField.adjoin (padicCyclotomic p) (K : Set ℂ_[p])).toSubfield =
        cyclotomicCompositum p K) := sorry

end Cyclotomic

/-! ## PerfectoidSpaces:P3/completed-tensor-plus-ring-not-integrally-closed (lemma) -/

/-- P3/completed-tensor-plus-ring-not-integrally-closed (AWS proof of Lemma 2.8.7): for `K`
perfectoid with algebraically closed residue field (every monic polynomial over `K°` of positive
degree has a root modulo `K°°`), `ℓ ∤ p(p - 1)` prime and `L = K(p^{1/ℓ})`, the closure of the
subring of `L ⊗̂_K L` generated by the images of `L° ⊗ 1` and `1 ⊗ L°` is strictly smaller than
the plus ring of the completed tensor product (the integral closure): the completed tensor
product of plus rings is not integrally closed. -/
theorem completedTensor_plus_ne_closure (p : ℕ) [Fact p.Prime] (K L : Type u)
    [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K] [IsPerfectoidField p K]
    [NontriviallyNormedField L] [NormedAlgebra K L] [IsUltrametricDist L] [CompleteSpace L]
    [IsAdicHom (algebraMap K L)]
    (hres : ∀ g : Polynomial (powerBoundedSubring K), g.Monic → 0 < g.natDegree →
      ∃ x : powerBoundedSubring K, ‖((g.eval x : powerBoundedSubring K) : K)‖ < 1)
    (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓp : ¬ ℓ ∣ p * (p - 1)) (π : L)
    (hπ : π ^ ℓ = algebraMap K L p) (hL : Algebra.adjoin K {π} = ⊤)
    (h : ∀ a ∈ (Pair.powerBounded K).plus, algebraMap K L a ∈ (Pair.powerBounded L).plus) :
    ((Subring.closure
        ((Pair.completedTensor.inl (Pair.powerBounded K) (Pair.powerBounded L)
            (Pair.powerBounded L) h h).toRingHom '' (powerBoundedSubring L : Set L) ∪
          (Pair.completedTensor.inr (Pair.powerBounded K) (Pair.powerBounded L)
            (Pair.powerBounded L) h h).toRingHom '' (powerBoundedSubring L : Set L))
      ).topologicalClosure ≠ (Pair.completedTensor (Pair.powerBounded K) (Pair.powerBounded L)
          (Pair.powerBounded L) h h).plus) := sorry

/-! ## PerfectoidSpaces:P3/fontaine-wintenberger (theorem) -/

/-- P3/fontaine-wintenberger (Sch12 Theorem 1.1 and §1; Berkeley Theorem 7.3.1(2)): the absolute
Galois groups of a perfectoid field and of its tilt are isomorphic as profinite groups, via
`L ↦ L♭` on finite Galois subextensions (with Mathlib's algebraic closures; the canonical form
uses a completed algebraic closure `C` of `K` and `K♭^sep ⊆ C♭`). -/
def absoluteGaloisGroupTiltEquiv (p : ℕ) [Fact p.Prime] (K : Type u) [NontriviallyNormedField K]
    [IsUltrametricDist K] [CompleteSpace K] [IsPerfectoidField p K] :
    Field.absoluteGaloisGroup K ≃ₜ* Field.absoluteGaloisGroup (tilt p K) := sorry

/-! ## PerfectoidSpaces:P3/finite-etale-tilting-equivalence (theorem) -/

section TiltingEquivalence

variable (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P3/finite-etale-tilting-equivalence (ECD Theorem 6.1(ii); KL Theorem 3.6.21): over any
perfectoid Tate ring the untilting functor `FÉt(R♭) ⥤ FÉt(R)` is an equivalence. -/
instance FiniteEtale.untilt_isEquivalence : (FiniteEtale.untilt p R).IsEquivalence := sorry

/-- P3/finite-etale-tilting-equivalence: the tilting equivalence `FÉt(R) ≌ FÉt(R♭)`, `S ↦ S♭`,
the inverse of the untilting functor. -/
def finiteEtaleTiltEquiv :
    CommAlgCat.FiniteEtale.{u} R ≌ CommAlgCat.FiniteEtale.{u} (tilt p R) :=
  (FiniteEtale.untilt p R).asEquivalence.symm

end TiltingEquivalence

/-! ## PerfectoidSpaces:P3/finite-etale-over-perfectoid-is-perfectoid (theorem) -/

section FiniteEtalePerfectoid

variable (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P3/finite-etale-over-perfectoid-is-perfectoid (ECD Theorem 6.1(i); Berkeley Theorem 7.4.5;
AWS Theorem 2.5.9(a)): a finite étale algebra over a perfectoid Tate ring is perfectoid for its
natural topology. -/
theorem isPerfectoid_of_finiteEtale (S : Type u) [CommRing S] [_root_.Algebra R S]
    [Module.Finite R S] [_root_.Algebra.Etale R S] : FiniteEtale.IsNaturallyPerfectoid p R S :=
  sorry

/-- P3/finite-etale-over-perfectoid-is-perfectoid: for `R⁺ ⊆ R°` and `S⁺` the integral closure of
`R⁺` in `S`, the tilt `S♭⁺` is the integral closure of `R♭⁺` in `S♭` (ECD Theorem 6.1). -/
theorem tilt_plus_eq_integralClosure_of_finiteEtale (P : Pair R) (S : Type u) [CommRing S]
    [_root_.Algebra R S] [Module.Finite R S] [_root_.Algebra.Etale R S] [UniformSpace S]
    [IsUniformAddGroup S] [IsModuleTopology R S] [IsTopologicalRing S] [IsTateRing S]
    [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S] (Q : Pair S)
    (hQ : (Q.plus : Set S) = integralClosure (P.plus.map (algebraMap R S)) S) :
    ((Pair.tilt p Q).plus : Set (tilt p S)) =
      integralClosure ((Pair.tilt p P).plus.map
        (tilt.map p (algebraMap R S) (continuous_algebraMap R S))) (tilt p S) := sorry

end FiniteEtalePerfectoid

/-! ## PerfectoidSpaces:P3/almost-finite-etale-equivalence (theorem) -/

section AlmostEquivalence

variable (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P3/almost-finite-etale-equivalence (a) (Sch12 Theorem 7.9(i); Bhatt Theorem 6.2.10(2)):
`A ↦ A_*[ϖ⁻¹]` is an equivalence `(R°ᵃ)_afet ≃ FÉt(R)` with quasi-inverse `S ↦ S°ᵃ`. -/
def almostFiniteEtaleEquiv : FiniteEtale.AlmostCat p R ≌ CommAlgCat.FiniteEtale.{u} R := sorry

/-- P3/almost-finite-etale-equivalence (b) (Sch12 diagram after Proposition 5.22): the almost
categories of `R` and `R♭` are equivalent (through `(R°ᵃ/ϖ)_afet = (R♭°ᵃ/ϖ♭)_afet`), and the
composite with the equivalences of (a) is the untilting functor. -/
theorem almostFiniteEtaleEquiv_tilt :
    ∃ E : FiniteEtale.AlmostCat p (tilt p R) ≌ FiniteEtale.AlmostCat p R,
      Nonempty ((almostFiniteEtaleEquiv p (tilt p R)).inverse ⋙ E.functor ⋙
        (almostFiniteEtaleEquiv p R).functor ≅ FiniteEtale.untilt p R) := sorry

/-- P3/almost-finite-etale-equivalence (c) (ECD after Definition 3.23): `R⁺ᵃ = R°ᵃ`, so the almost
finite étale categories of `(R⁺, R°°)` and `(R°, R°°)` agree. -/
def almostFiniteEtalePlusEquiv (P : Pair R) :
    Almost.Algebra.FiniteEtale (Almost.Algebra.of (almostSetupPlus p R P) P.plus) ≌
      FiniteEtale.AlmostCat p R := sorry

end AlmostEquivalence

/-! ## PerfectoidSpaces:P3/integral-closure-almost-finite-etale (theorem) -/

section IntegralClosure

variable (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  (S : Type u) [CommRing S] [_root_.Algebra R S] [Module.Finite R S] [_root_.Algebra.Etale R S]
  [TopologicalSpace S] [IsModuleTopology R S] [IsTopologicalRing S] [IsTateRing S]

/-- P3/integral-closure-almost-finite-etale (i)–(ii) (ECD Theorem 6.1(iii); KL Theorem 5.5.9):
for `S` finite étale over a perfectoid Tate ring, `S°ᵃ` is almost finite étale and uniformly
almost finite projective over `R°ᵃ`. Neither `S°` finite, flat or étale over `R°` nor `S` free
over `R` is claimed. -/
theorem almostFiniteEtale_powerBounded :
    FiniteEtale.IsAlmostFiniteEtaleIntegral p R S := sorry

/-- P3/integral-closure-almost-finite-etale (iv) (KL II Corollary 3.3.24): if `S` is faithfully
flat over `R`, then `S°ᵃ` is almost faithfully flat over `R°ᵃ`. -/
theorem almostFaithfullyFlat_powerBounded [Module.FaithfullyFlat R S] :
    letI := FiniteEtale.powerBoundedAlgebra R S
      (IsPerfectoidTateRing.isBounded_powerBoundedSubring p)
    Almost.IsAlmostFaithfullyFlatAlg (almostSetup p R) (powerBoundedSubring S) := sorry

end IntegralClosure

/-! ## PerfectoidSpaces:P3/almost-purity-theorem (theorem) -/

/-- P3/almost-purity-theorem (ECD Theorem 6.1; Sch12 Theorem 1.10; Berkeley Theorem 7.4.5): over
a perfectoid Tate ring `R`, (i) every finite étale `R`-algebra is perfectoid for its natural
topology, (ii) untilting `FÉt(R♭) ⥤ FÉt(R)` is an equivalence, and (iii) `S°ᵃ` is almost finite
étale and uniformly almost finite projective over `R°ᵃ` for every `S ∈ FÉt(R)`. -/
theorem almostPurity (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R]
    [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] :
    (∀ S : CommAlgCat.FiniteEtale.{u} R, FiniteEtale.IsNaturallyPerfectoid p R S) ∧
      (FiniteEtale.untilt p R).IsEquivalence ∧
      ∀ (S : CommAlgCat.FiniteEtale.{u} R) [TopologicalSpace S] [IsModuleTopology R S]
        [IsTopologicalRing S] [IsTateRing S], FiniteEtale.IsAlmostFiniteEtaleIntegral p R S :=
  sorry

