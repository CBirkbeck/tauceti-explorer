/-! ## PerfectoidSpaces:P4/zariski-closed-immersion (definition) -/

namespace PerfectoidSpace

open Perfectoid

section ZeroLocus

variable {A : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsHuberRing A]
  (P : Pair A)

/-- P4/zariski-closed-immersion (data): the zero locus
`V(I) = {x ∈ |Spa(A, A⁺)| : |g(x)| = 0 for all g ∈ I}` of an ideal `I ⊆ A` (Tor Definition II.2.1;
ECD Definition 5.7 (i)); the underlying space of the affinoid is Tau Ceti's `spa`. -/
def zeroLocus (I : Ideal A) : Set (spa P.plus) :=
  {x | ∀ g ∈ I, x.1.toValuativeRel.vle g 0}

/-- P4/zariski-closed-immersion (other): `V(I)` is closed (Tor Definition II.2.1). -/
theorem isClosed_zeroLocus (I : Ideal A) : IsClosed (zeroLocus P I) := sorry

/-- P4/zariski-closed-immersion (simp): `V(I + J) = V(I) ∩ V(J)`. -/
@[simp] theorem zeroLocus_sup (I J : Ideal A) :
    zeroLocus P (I ⊔ J) = zeroLocus P I ∩ zeroLocus P J := sorry

/-- P4/zariski-closed-immersion (simp): `V(I J) = V(I ∩ J) = V(I) ∪ V(J)` (supports are prime). -/
theorem zeroLocus_mul (I J : Ideal A) :
    zeroLocus P (I * J) = zeroLocus P I ∪ zeroLocus P J ∧
      zeroLocus P (I ⊓ J) = zeroLocus P I ∪ zeroLocus P J := sorry

/-- P4/zariski-closed-immersion (simp): `V(I)` depends only on the closure and on the radical of
`I` (supports of continuous valuations are closed prime ideals). -/
theorem zeroLocus_closure (I : Ideal A) :
    zeroLocus P I.closure = zeroLocus P I ∧ zeroLocus P I.radical = zeroLocus P I := sorry

/-- P4/zariski-closed-immersion (structure): a subset of `|Spa(A, A⁺)|` is *Zariski closed* if it
is `V(I)` for some ideal `I` (Tor Definition II.2.1). -/
def IsZariskiClosed (Z : Set (spa P.plus)) : Prop :=
  ∃ I : Ideal A, Z = zeroLocus P I

end ZeroLocus

section ZeroLocusTate

variable {A : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsTateRing A]
  (P : Pair A)

open scoped Classical in
/-- P4/zariski-closed-immersion (characterisation): over a Tate ring,
`V(I) = ⋂_{F ⊆ I finite} U_F` with `U_F = {|g| ≤ 1, g ∈ F} = U((F ∪ {1})/1)` rational, because `I`
is an ideal and `|ϖ(x)|ⁿ → 0` at every point (Tor proof of Lemma II.2.2). -/
theorem zeroLocus_eq_iInter_rational (I : Ideal A) :
    zeroLocus P I = ⋂ (F : Finset A) (_ : (F : Set A) ⊆ I),
      Subtype.val ⁻¹' rationalSubset P.plus (insert 1 F) 1 := sorry

/-- P4/zariski-closed-immersion (other): over a Tate ring, `V(I)` is stable under generalization
(generalizations of analytic points have the same support). -/
theorem stableUnderGeneralization_zeroLocus (I : Ideal A) :
    StableUnderGeneralization (zeroLocus P I) := sorry

end ZeroLocusTate

