/-! ## PerfectoidSpaces:P6/kappa-small-perfectoid-subpairs (lemma) -/

namespace Perfectoid

section Subpairs

variable (p : ℕ) [Fact p.Prime] {S : Type u} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
  [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S]

/-- P6/kappa-small-perfectoid-subpairs: for a perfectoid Tate pair `(S, S⁺)`, a pseudo-uniformizer
`ϖ ∈ S°` with `ϖ^p ∣ p` in `S°` and a subset `A ⊆ S`, there is a closed subring `S' ⊆ S`
containing `A ∪ {ϖ, ϖ⁻¹}` with `#S' ≤ (#A + ℵ₀)^ℵ₀` which is a perfectoid Tate ring in the
subspace topology (bundled as `T : PerfectoidRingCat p` with a uniform embedding `ι : T → S` onto
`S'`), with `S'° = S' ∩ S°` and `(S', S' ∩ S⁺)` a perfectoid Tate pair (ECD proof of Proposition
6.5, with `A` of any size; for countable `A` this is PerfectoidSpaces:P5/
countably-generated-decomposition). -/
theorem exists_perfectoid_subring (Q : Pair S) (A : Set S) (ϖ : Sˣ)
    (hϖ : IsPseudoUniformizer (ϖ : S))
    (hϖp : ∃ c ∈ powerBoundedSubring S, (p : S) = (ϖ : S) ^ p * c) :
    ∃ (T : PerfectoidRingCat.{u} p) (ι : T →+* S), IsUniformEmbedding ι ∧
      IsClosed (Set.range ι) ∧ A ∪ {(ϖ : S), ((ϖ⁻¹ : Sˣ) : S)} ⊆ Set.range ι ∧
      #T ≤ (#A + ℵ₀) ^ ℵ₀ ∧
      (∀ x : T, x ∈ powerBoundedSubring T ↔ ι x ∈ powerBoundedSubring S) ∧
      ∃ Q' : Pair T, ∀ x : T, x ∈ Q'.plus ↔ ι x ∈ Q.plus := sorry

variable {R : Type u} [CommRing R]

/-- P6/kappa-small-perfectoid-subpairs (data): for a map `φ : R → S`, the set `P_κ(Y/X)` of the
closed subrings `S' ⊆ S` of cardinality `< κ` containing `φ(R)` that are perfectoid Tate rings in
the subspace topology (ECD proof of Proposition 8.2), ordered by inclusion. -/
def kappaSmallSubrings (κ : Cardinal.{u}) (φ : R →+* S) : Set (Subring S) :=
  {S' | IsClosed (S' : Set S) ∧ φ.range ≤ S' ∧ #S' < κ ∧
    ∃ (T : PerfectoidRingCat.{u} p) (ι : T →+* S), IsUniformEmbedding ι ∧ ι.range = S'}

variable {p} {κ : Cardinal.{u}} {φ : R →+* S}

/-- P6/kappa-small-perfectoid-subpairs (a): `P_κ(Y/X)` is directed, for κ an uncountable strong
limit and `#R < κ` (ECD proof of Proposition 8.2: "a κ-filtered colimit of κ-small perfectoid
rings", which holds in this bounded form). -/
theorem kappaSmallSubrings.directedOn (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (hR : #R < κ) :
    DirectedOn (· ≤ ·) (kappaSmallSubrings p κ φ) := sorry

/-- P6/kappa-small-perfectoid-subpairs (a): a subfamily of `P_κ(Y/X)` with at most `μ` members,
each of cardinality `≤ μ` (`ℵ₀ ≤ μ < κ`, `#R ≤ μ`), has an upper bound in `P_κ(Y/X)` of
cardinality `≤ μ ^ ℵ₀`; in particular `P_κ(Y/X)` is `ω₁`-directed (ECD proof of Proposition
6.5: "automatically ω₁-filtered"). It is not κ-directed for singular κ. -/
theorem kappaSmallSubrings.exists_le (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) {μ : Cardinal.{u}}
    (hμ₀ : ℵ₀ ≤ μ) (hμ : μ < κ) (hR : #R ≤ μ) (𝒮 : Set (Subring S))
    (h𝒮 : 𝒮 ⊆ kappaSmallSubrings p κ φ) (h𝒮μ : #𝒮 ≤ μ) (hmem : ∀ S' ∈ 𝒮, #S' ≤ μ) :
    ∃ S'' ∈ kappaSmallSubrings p κ φ, (∀ S' ∈ 𝒮, S' ≤ S'') ∧ #S'' ≤ μ ^ ℵ₀ := sorry

/-- P6/kappa-small-perfectoid-subpairs (b): `⋃ S' = S` and `⋃ (S' ∩ S⁺) = S⁺` over `P_κ(Y/X)`
(for `#R < κ`); so the colimit of the plus rings is already complete (ECD proofs of Propositions
6.5 and 8.2). -/
theorem kappaSmallSubrings.iUnion_eq (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (hR : #R < κ)
    (Q : Pair S) :
    ⋃ S' ∈ kappaSmallSubrings p κ φ, (S' : Set S) = Set.univ ∧
      ⋃ S' ∈ kappaSmallSubrings p κ φ, ((S' : Set S) ∩ Q.plus) = Q.plus := sorry

end Subpairs

