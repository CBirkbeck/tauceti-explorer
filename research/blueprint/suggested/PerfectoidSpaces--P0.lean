/-! ## PerfectoidSpaces:P0/almost-exal-ext-comparison (theorem) -/

/-- P0/almost-exal-ext-comparison: a square-zero `A`-extension `0 → M → E → B → 0` of `B` by a
`B`-module `M`, with `M · M = 0` in `E` and the induced `B`-module structure on `M` the given one
(GR 2.5.2–2.5.7). -/
structure SqZeroExtension {A B : Algebra S} (f : A ⟶ B) (M : Algebra.ModuleCat S B) where
  /-- The total almost algebra `E`. -/
  E : Algebra S
  /-- The structure map `A ⟶ E`. -/
  toE : A ⟶ E
  /-- The projection `E ⟶ B`. -/
  p : E ⟶ B
  /-- The inclusion of the square-zero ideal `M`. -/
  ι : M.X ⟶ E.X
  w : toE ≫ p = f
  zero : ι ≫ p.hom.hom = 0
  shortExact : (ShortComplex.mk ι p.hom.hom zero).ShortExact
  sq_zero : (ι ⊗ₘ ι) ≫ MonObj.mul = 0
  smul_compat : (E.X ◁ ι) ≫ MonObj.mul =
    (p.hom.hom ▷ M.X) ≫ ModObj.smul (M := B.X) (X := M.X) ≫ ι

/-- P0/almost-exal-ext-comparison: `Exal_A(B, M)`, the isomorphism classes of square-zero
extensions (GR 2.5.7). -/
def Exal {A B : Algebra S} (f : A ⟶ B) (M : Algebra.ModuleCat S B) : Type (u + 1) :=
  Quot (fun X Y : SqZeroExtension S f M ↦ ∃ e : X.E ≅ Y.E,
    X.toE ≫ e.hom = Y.toE ∧ e.hom ≫ Y.p = X.p ∧ X.ι ≫ e.hom.hom.hom = Y.ι)

/-- P0/almost-exal-ext-comparison: the conormal module `I/I²` of an epimorphism `A ⟶ B` with kernel
`I`, as a `B`-module (GR Proposition 2.5.29). -/
def Algebra.conormal {A B : Algebra S} (f : A ⟶ B) : Algebra.ModuleCat S B := sorry

/-- P0/almost-exal-ext-comparison (iii): for an epimorphism `A ⟶ B` with kernel `I`,
`Hom_B(I/I², M) ≅ Exal_A(B, M)` via pullback of `0 → I/I² → A/I² → B → 0` (GR Proposition
2.5.29). -/
def exalEquivConormal {A B : Algebra S} (f : A ⟶ B) [Epi f.hom.hom] (M : Algebra.ModuleCat S B) :
    Exal S f M ≃ (Algebra.conormal S f ⟶ M) := sorry

-- Almost.almostExalEquivExtOne: not stated here; needs the cotangent complex, for
--   `Exal_A(B, M) ≅ Ext¹(L^a_{B/A}, M)` (GR Theorem 2.5.30, part (ii) of the node) (supplier:
--   DerivedDeRhamCohomology:DD.0)
-- Part (i) of the node (GR Lemma 2.5.17(i): almostification `Exal_{A_!!}(B_!!, M_*) →
-- Exal_A(B, M)` is an equivalence) is not stated: Mathlib packages no category of square-zero
-- extensions of rings to compare with.

/-! ## PerfectoidSpaces:P0/almost-local-flatness-criterion (lemma) -/

/-- P0/almost-local-flatness-criterion (i): the classical local flatness criterion for a square-zero
ideal: `M` is flat iff `M/JM` is `R/J`-flat and `J ⊗_R M → M` is injective (GR (3.2.19)). -/
theorem flat_iff_of_sq_eq_zero (R : Type u) [CommRing R] (J : Ideal R) (hJ : J ^ 2 = ⊥)
    (M : Type u) [AddCommGroup M] [_root_.Module R M] :
    _root_.Module.Flat R M ↔ _root_.Module.Flat (R ⧸ J) ((R ⧸ J) ⊗[R] M) ∧
      Function.Injective (TensorProduct.lift ((LinearMap.lsmul R M).comp J.subtype)) := sorry

/-- P0/almost-local-flatness-criterion (ii): the almost version for `R → R'` and a square-zero
ideal `J ⊆ R`: `R'^a` is flat iff its reduction is flat over `(R/J)^a` and `J ⊗_R R' → JR'` is an
almost isomorphism (GR Lemma 3.2.6). -/
theorem almostFlat_iff_of_sq_eq_zero {R : Type u} [CommRing R] (T : BasicSetup R) (R' : Type u)
    [CommRing R'] [_root_.Algebra R R'] (J : Ideal R) (hJ : J ^ 2 = ⊥) :
    IsAlmostFlatAlg T R' ↔ IsAlmostFlatAlg (T.baseChange (R ⧸ J)) ((R ⧸ J) ⊗[R] R') ∧
      T.IsAlmostZero (LinearMap.ker
        (TensorProduct.lift ((LinearMap.lsmul R R').comp J.subtype))) := sorry

/-! ## PerfectoidSpaces:P0/almost-deformation-theory (theorem) -/

-- Almost.exists_flatDeformation: not stated here; needs the cotangent complex, for the obstruction
--   class in `Ext²(L^a_{C₀/B₀}, C₀ ⊗ I)` (GR Proposition 3.2.9, Corollary 3.2.11(i)) (supplier:
--   DerivedDeRhamCohomology:DD.0)
-- Almost.flatDeformation_torsor: not stated here; needs the cotangent complex, for the torsor under
--   `Ext¹(L^a_{C₀/B₀}, C₀ ⊗ I)` (GR Corollary 3.2.11(ii)) (supplier: DerivedDeRhamCohomology:DD.0)

section deformation

variable {B : Type u} [CommRing B] (T : BasicSetup B) (I : Ideal B) (C : Type u) [CommRing C]
  [_root_.Algebra B C]

/-- P0/almost-deformation-theory: the almost `C₀`-module `C₀ ⊗_{B₀} I` of a deformation `C` of
`C₀ = (B/I) ⊗_B C` over `B₀ = B/I` (`I = I/I²` for `I² = 0`) (GR Proposition 3.2.9). -/
abbrev deformationCoeff : Module ((T.baseChange (B ⧸ I)).baseChange ((B ⧸ I) ⊗[B] C)) :=
  (toAlmost _).obj (ModuleCat.of ((B ⧸ I) ⊗[B] C) (((B ⧸ I) ⊗[B] C) ⊗[B ⧸ I] I.Cotangent))

/-- P0/almost-deformation-theory (iii): the automorphisms of a flat deformation `C` of `C₀` over a
square-zero thickening, inducing the identity on `C₀`, are the almost derivations
`Der_{B₀}(C₀, C₀ ⊗ I)` (GR Corollary 3.2.11(iii), without the identification with `Ext⁰` of the
cotangent complex). -/
theorem nonempty_flatDeformation_autEquiv (hI : I ^ 2 = ⊥) (hC : IsAlmostFlatAlg T C) :
    Nonempty ({φ : Algebra.of T C ≅ Algebra.of T C //
        φ.hom ≫ Algebra.ofHom T (_root_.Algebra.TensorProduct.includeRight :
          C →ₐ[B] (B ⧸ I) ⊗[B] C) =
          Algebra.ofHom T (_root_.Algebra.TensorProduct.includeRight :
            C →ₐ[B] (B ⧸ I) ⊗[B] C)} ≃
      Algebra.Derivation (T.baseChange (B ⧸ I)) ((B ⧸ I) ⊗[B] C) (deformationCoeff T I C)) :=
  sorry

end deformation

/-! ## PerfectoidSpaces:P0/almost-morphism-lifting (theorem) -/

-- Almost.lift_obstruction: not stated here; needs the cotangent complex, for the obstruction in
--   `Ext¹(L^a_{C₀¹/B₀}, J²)` and the torsor of lifts under `Ext⁰` (GR Proposition 3.2.16)
--   (supplier: DerivedDeRhamCohomology:DD.0)

/-- P0/almost-morphism-lifting: the case `L^a_{C₀/B₀} ≃ 0` of GR Proposition 3.2.16, for a weakly
étale reduction (GR Theorem 2.5.36): morphisms between flat deformations over a square-zero
thickening lift uniquely from the reduction (Sch12 Theorem 5.12). -/
theorem existsUnique_lift_of_isAlmostWeaklyEtaleAlg {B : Type u} [CommRing B] (T : BasicSetup B)
    (I : Ideal B) (hI : I ^ 2 = ⊥) (C C' : Type u) [CommRing C] [CommRing C'] [_root_.Algebra B C]
    [_root_.Algebra B C'] (hC : IsAlmostFlatAlg T C) (hC' : IsAlmostFlatAlg T C')
    (hw : IsAlmostWeaklyEtaleAlg (T.baseChange (B ⧸ I)) ((B ⧸ I) ⊗[B] C))
    (f₀ : Algebra.of T ((B ⧸ I) ⊗[B] C) ⟶ Algebra.of T ((B ⧸ I) ⊗[B] C')) :
    ∃! f : Algebra.of T C ⟶ Algebra.of T C',
      Algebra.ofHom T _root_.Algebra.TensorProduct.includeRight ≫ f₀ =
        f ≫ Algebra.ofHom T _root_.Algebra.TensorProduct.includeRight := sorry

/-! ## PerfectoidSpaces:P0/nilpotent-lifting-of-etale-almost-algebras (theorem) -/

/-- P0/nilpotent-lifting-of-etale-almost-algebras (i): for `R'` weakly étale over `R` and `J ⊆ C`
nilpotent, `R^a`-algebra maps `R'^a → C^a` biject with maps `R'^a → (C/J)^a`
(GR Theorem 3.2.18(i)). -/
theorem bijective_hom_reduction_of_isWeaklyEtale {R : Type u} [CommRing R] (T : BasicSetup R)
    (R' C : Type u) [CommRing R'] [_root_.Algebra R R'] [CommRing C] [_root_.Algebra R C]
    (J : Ideal C) (hJ : IsNilpotent J) (h : IsAlmostWeaklyEtaleAlg T R')
    (ψ : Algebra.of T R' ⟶ Algebra.of T (C ⧸ J))
    (hψ : Algebra.ofHom T (_root_.Algebra.ofId R R') ≫ ψ =
      Algebra.ofHom T (_root_.Algebra.ofId R (C ⧸ J))) :
    ∃! φ : Algebra.of T R' ⟶ Algebra.of T C,
      Algebra.ofHom T (_root_.Algebra.ofId R R') ≫ φ = Algebra.ofHom T (_root_.Algebra.ofId R C) ∧
        φ ≫ Algebra.ofHom T (Ideal.Quotient.mkₐ R J) = ψ := sorry

/-- P0/nilpotent-lifting-of-etale-almost-algebras (iv): finite étale almost algebras lift along a
nilpotent ideal (GR Theorem 3.2.28(ii)); the lift is unique by (i). -/
theorem exists_finiteEtale_lift_of_isNilpotent {R : Type u} [CommRing R] (T : BasicSetup R)
    (I : Ideal R) (hI : IsNilpotent I) (R₀' : Type u) [CommRing R₀'] [_root_.Algebra (R ⧸ I) R₀']
    (h₀ : IsAlmostFiniteEtaleAlg (T.baseChange (R ⧸ I)) R₀') :
    ∃ (R' : Type u) (_ : CommRing R') (_ : _root_.Algebra R R'), IsAlmostFiniteEtaleAlg T R' ∧
      Nonempty (Algebra.of (T.baseChange (R ⧸ I)) ((R ⧸ I) ⊗[R] R') ≅
        Algebra.of (T.baseChange (R ⧸ I)) R₀') := sorry

/-- P0/nilpotent-lifting-of-etale-almost-algebras (ii), (iii): weakly étale and étale almost
algebras lift along a nilpotent ideal (GR Theorem 3.2.18(iii)). -/
theorem exists_etale_lift_of_isNilpotent {R : Type u} [CommRing R] (T : BasicSetup R)
    (I : Ideal R) (hI : IsNilpotent I) (R₀' : Type u) [CommRing R₀'] [_root_.Algebra (R ⧸ I) R₀'] :
    (IsAlmostWeaklyEtaleAlg (T.baseChange (R ⧸ I)) R₀' →
      ∃ (R' : Type u) (_ : CommRing R') (_ : _root_.Algebra R R'), IsAlmostWeaklyEtaleAlg T R' ∧
        Nonempty (Algebra.of (T.baseChange (R ⧸ I)) ((R ⧸ I) ⊗[R] R') ≅
          Algebra.of (T.baseChange (R ⧸ I)) R₀')) ∧
    (IsAlmostEtaleAlg (T.baseChange (R ⧸ I)) R₀' →
      ∃ (R' : Type u) (_ : CommRing R') (_ : _root_.Algebra R R'), IsAlmostEtaleAlg T R' ∧
        Nonempty (Algebra.of (T.baseChange (R ⧸ I)) ((R ⧸ I) ⊗[R] R') ≅
          Algebra.of (T.baseChange (R ⧸ I)) R₀')) := sorry

/-! ## PerfectoidSpaces:P0/lower-shriek-shriek-faithful-flatness (lemma) -/

/-- P0/lower-shriek-shriek-faithful-flatness (iii): `f` is faithfully flat iff `f_!!` is a
faithfully flat ring map (GR Remark 3.1.3(ii)). -/
theorem Algebra.isFaithfullyFlat_iff_shriekShriek {A B : Algebra S} (f : A ⟶ B) :
    Algebra.IsFaithfullyFlat f ↔
      ((Algebra.shriekShriek S).map f).hom.toRingHom.FaithfullyFlat := sorry

/-- P0/almost-algebra-lower-shriek-shriek (characterisation): `f_!!` is faithfully flat iff `f` is
(P0/lower-shriek-shriek-faithful-flatness; GR Remark 3.1.3(ii)). -/
theorem Algebra.shriekShriek_faithfullyFlat_iff {A B : Algebra S} (f : A ⟶ B) :
    ((Algebra.shriekShriek S).map f).hom.toRingHom.FaithfullyFlat ↔ Algebra.IsFaithfullyFlat f :=
  sorry

/-- P0/lower-shriek-shriek-faithful-flatness (ii): `f` is a monomorphism iff `f_!!` is injective
(GR Remark 3.1.3(ii)). -/
theorem Algebra.mono_iff_injective_shriekShriek {A B : Algebra S} (f : A ⟶ B) :
    Mono f.hom.hom ↔ Function.Injective ((Algebra.shriekShriek S).map f).hom := sorry

/-! ## PerfectoidSpaces:P0/almost-faithfully-flat-descent (theorem) -/

/-- P0/almost-faithfully-flat-descent (i): almost extension of scalars along a faithfully flat
`R^a → R'^a` is comonadic, i.e. of effective descent for almost modules (GR (3.4.1)). -/
@[instance_reducible]
def comonadicAlmostExtendScalars {R : Type u} [CommRing R] (T : BasicSetup R)
    (R' : Type u) [CommRing R'] [_root_.Algebra R R'] (h : IsAlmostFaithfullyFlatAlg T R') :
    ComonadicLeftAdjoint (Module.extendScalars T R') := sorry

/-- P0/almost-faithfully-flat-descent (iv): flatness, almost finite generation and presentation and
almost finite projectivity descend along a faithfully flat `R^a → R'^a` (GR (3.4.1)). -/
theorem almostFiniteProjective_of_descent {R : Type u} [CommRing R] (T : BasicSetup R)
    (R' : Type u) [CommRing R'] [_root_.Algebra R R'] (h : IsAlmostFaithfullyFlatAlg T R')
    (X : Module T) :
    (Module.Flat ((Module.extendScalars T R').obj X) → Module.Flat X) ∧
    (Module.AlmostFiniteProjective ((Module.extendScalars T R').obj X) →
      Module.AlmostFiniteProjective X) := sorry

/-- P0/almost-faithfully-flat-descent (iv): weakly étale, étale and finite étale descend along a
faithfully flat `R^a → R'^a` (GR (3.4.1)). -/
theorem isAlmostEtaleAlg_of_descent {R : Type u} [CommRing R] (T : BasicSetup R)
    (R' C : Type u) [CommRing R'] [_root_.Algebra R R'] [CommRing C] [_root_.Algebra R C]
    (h : IsAlmostFaithfullyFlatAlg T R') :
    (IsAlmostWeaklyEtaleAlg (T.baseChange R') (R' ⊗[R] C) → IsAlmostWeaklyEtaleAlg T C) ∧
    (IsAlmostEtaleAlg (T.baseChange R') (R' ⊗[R] C) → IsAlmostEtaleAlg T C) ∧
    (IsAlmostFiniteEtaleAlg (T.baseChange R') (R' ⊗[R] C) → IsAlmostFiniteEtaleAlg T C) := sorry

-- Descent of almost projectivity along a general faithfully flat map is not claimed: GR Remark
-- 3.2.26(iii) leaves it open; the node only claims it for `R'` almost finitely presented.

/-! ## PerfectoidSpaces:P0/almost-amitsur-complex-exact (lemma) -/

/-- P0/almost-amitsur-complex-exact: for `R'^a` faithfully flat over `R^a` and an `R`-module `N`,
the augmented Amitsur complex `0 → N → N ⊗ R' → N ⊗ R' ⊗ R'` has almost zero cohomology in degrees
`0` and `1`, so `N^a` is the equalizer of `(N ⊗ R')^a ⇉ (N ⊗ R' ⊗ R')^a` (GR (3.4.1), ECD proof
of Proposition 8.8). -/
theorem isAlmostZero_amitsur {R : Type u} [CommRing R] (T : BasicSetup R) (R' : Type u)
    [CommRing R'] [_root_.Algebra R R'] (h : IsAlmostFaithfullyFlatAlg T R') (N : Type u)
    [AddCommGroup N] [_root_.Module R N] :
    T.IsAlmostZero (LinearMap.ker ((TensorProduct.mk R N R').flip 1)) ∧
    T.IsAlmostZero (LinearMap.ker ((_root_.Algebra.TensorProduct.includeRight.toLinearMap -
        _root_.Algebra.TensorProduct.includeLeft.toLinearMap :
          R' →ₗ[R] R' ⊗[R] R').lTensor N) ⧸
      Submodule.comap (LinearMap.ker ((_root_.Algebra.TensorProduct.includeRight.toLinearMap -
        _root_.Algebra.TensorProduct.includeLeft.toLinearMap :
          R' →ₗ[R] R' ⊗[R] R').lTensor N)).subtype
        (LinearMap.range ((TensorProduct.mk R N R').flip 1))) := sorry

/-! ## PerfectoidSpaces:P0/tight-ideal (definition) -/

namespace Algebra

/-- P0/tight-ideal (data): an ideal `I` of `A_*` is *tight* if `m · Iⁿ ⊆ m₀ A_*` for a finitely
generated `m₀ ⊆ m` and some `n`, i.e. `Iⁿ ⊆ m₀ A` in the almost sense (GR Definition 5.1.5). -/
def Ideal.IsTight {A : Algebra S} (I : _root_.Ideal ((Algebra.elements S).obj A)) : Prop :=
  ∃ m₀ : _root_.Ideal V, m₀ ≤ S.ideal ∧ m₀.FG ∧ ∃ n : ℕ,
    ∀ x ∈ I ^ n, ∀ ε ∈ S.ideal, ε • x ∈ m₀.map (algebraMap V ((Algebra.elements S).obj A))

/-- P0/tight-ideal (example): `ϖA` is tight for `ϖ ∈ m` (GR Definition 5.1.5). -/
theorem isTight_span {A : Algebra S} (ϖ : V) (hϖ : ϖ ∈ S.ideal) :
    Ideal.IsTight S (_root_.Ideal.span {algebraMap V ((Algebra.elements S).obj A) ϖ}) := sorry

/-- P0/tight-ideal (relation): subideals and powers of tight ideals are tight (GR Definition
5.1.5). -/
theorem Ideal.IsTight.mono {A : Algebra S} {I J : _root_.Ideal ((Algebra.elements S).obj A)}
    (hJ : J ≤ I) (hI : Ideal.IsTight S I) : Ideal.IsTight S J ∧ ∀ k, Ideal.IsTight S (I ^ k) :=
  sorry

/-- P0/tight-ideal (functoriality): tightness is preserved by base change along `A ⟶ A'`
(GR Definition 5.1.5). -/
theorem Ideal.IsTight.map {A B : Algebra S} (f : A ⟶ B)
    {I : _root_.Ideal ((Algebra.elements S).obj A)} (hI : Ideal.IsTight S I) :
    Ideal.IsTight S (I.map ((Algebra.elements S).map f).hom) := sorry

/-- P0/tight-ideal (constructor): the Jacobson radical `rad(A) := rad(A_*)^a`, recorded on almost
elements (GR Definition 5.1.1). -/
def jacobson (A : Algebra S) : _root_.Ideal ((Algebra.elements S).obj A) :=
  _root_.Ideal.jacobson ⊥

/-- P0/tight-ideal (characterisation): `J^a ⊆ rad(R^a)` iff `m J ⊆ rad(R)` (GR Lemma 5.1.2). -/
theorem le_jacobson_toAlmost_iff (R : Type u) [CommRing R] [_root_.Algebra V R]
    (J : _root_.Ideal R) :
    S.ideal.map (algebraMap V R) * J ≤ _root_.Ideal.jacobson ⊥ ↔
      J.map ((Algebra.adj S).unit.app (CommAlgCat.of V R)).hom ≤ jacobson S (Algebra.of S R) :=
  sorry

/-- P0/tight-ideal (data): `(A, I)` is a *henselian pair* if `I ⊆ rad(A)` and `(A_*, m · I)` is
henselian (GR Definition 5.1.8). -/
def IsHenselianPair {A : Algebra S} (I : _root_.Ideal ((Algebra.elements S).obj A)) : Prop :=
  I ≤ jacobson S A ∧
    HenselianRing ((Algebra.elements S).obj A) (S.ideal.map (algebraMap V _) * I)

/-- P0/tight-ideal (characterisation): `(R^a, J^a)` is henselian iff `(R, m J)` is
(GR Lemma 5.1.10). -/
theorem isHenselianPair_toAlmost_iff (R : Type u) [CommRing R] [_root_.Algebra V R]
    (J : _root_.Ideal R) (hJ : J ≤ _root_.Ideal.jacobson ⊥) :
    IsHenselianPair S (J.map ((Algebra.adj S).unit.app (CommAlgCat.of V R)).hom) ↔
      HenselianRing R (S.ideal.map (algebraMap V R) * J) := sorry

/-- P0/tight-ideal (compatibility): an `I`-adically complete almost algebra is henselian along `I`
(GR Remark 5.3.7). -/
theorem isHenselianPair_of_isAdicComplete {A : Algebra S}
    (I : _root_.Ideal ((Algebra.elements S).obj A)) [IsAdicComplete I ((Algebra.elements S).obj A)]
    (hI : I ≤ jacobson S A) : IsHenselianPair S I := sorry

/-- P0/tight-ideal (relation): a tight ideal with `m I ⊆ rad(A_*)` lies in `rad(A_*)`
(GR Corollary 5.1.16). -/
theorem Ideal.IsTight.elements_le_jacobson {A : Algebra S}
    {I : _root_.Ideal ((Algebra.elements S).obj A)} (hI : Ideal.IsTight S I)
    (hrad : S.ideal.map (algebraMap V _) * I ≤ jacobson S A) : I ≤ jacobson S A := sorry

end Algebra

-- test Almost.Algebra.IsTight_test_varpi (computation) [P0/tight-ideal]
example (A : Algebra S) (ϖ : V) (hϖ : ϖ ∈ S.ideal) :
    Algebra.Ideal.IsTight S (Ideal.span {algebraMap V ((Algebra.elements S).obj A) ϖ}) :=
  Algebra.isTight_span S ϖ hϖ

-- test Almost.Algebra.IsTight_test_unit (non-example) [P0/tight-ideal]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) :
    ¬ Algebra.Ideal.IsTight (BasicSetup.ofValuationRing O h)
      (⊤ : Ideal ((Algebra.elements _).obj (Algebra.of _ O))) := sorry

-- test Almost.Algebra.IsTight_test_zero (degenerate) [P0/tight-ideal]
example (A : Algebra S) : Algebra.Ideal.IsTight S (⊥ : Ideal ((Algebra.elements S).obj A)) :=
  sorry

-- test Almost.Algebra.IsHenselianPair_test_classical (compatibility) [P0/tight-ideal]
example (R : Type u) [CommRing R] [_root_.Algebra V R] (J : Ideal R)
    (hJ : J ≤ Ideal.jacobson ⊥) :
    Algebra.IsHenselianPair (BasicSetup.classical V)
      (J.map ((Algebra.adj _).unit.app (CommAlgCat.of V R)).hom) ↔ HenselianRing R J := sorry

/-! ## PerfectoidSpaces:P0/almost-nakayama (lemma) -/

/-- P0/almost-nakayama (i): for `I ⊆ rad` tight and `N` almost finitely generated with `IN = N`,
`N` is almost zero (GR Lemma 5.1.6). -/
theorem isAlmostZero_of_tight_smul_eq {R : Type u} [CommRing R] (T : BasicSetup R) (I : Ideal R)
    (m₀ : Ideal R) (hm₀ : m₀ ≤ T.ideal) (hfg : m₀.FG) (n : ℕ) (hn : I ^ n ≤ m₀)
    (hrad : T.ideal * I ≤ Ideal.jacobson ⊥) (N : Type u) [AddCommGroup N] [_root_.Module R N]
    (hN : Module.AlmostFG T N) (hIN : (I • ⊤ : Submodule R N) = ⊤) : T.IsAlmostZero N := sorry

/-- P0/almost-nakayama (ii): a morphism of almost finite projective modules which is an
isomorphism modulo a tight `I ⊆ rad` is an isomorphism (GR Corollary 5.1.7). -/
theorem isIso_of_reduction {R : Type u} [CommRing R] (T : BasicSetup R) (I : Ideal R)
    (m₀ : Ideal R) (hm₀ : m₀ ≤ T.ideal) (hfg : m₀.FG) (n : ℕ) (hn : I ^ n ≤ m₀)
    (hrad : T.ideal * I ≤ Ideal.jacobson ⊥) {X Y : Module T} (φ : X ⟶ Y)
    (hX : Module.AlmostFiniteProjective X) (hY : Module.AlmostFiniteProjective Y)
    (hφ : IsIso ((Module.extendScalars T (R ⧸ I)).map φ)) : IsIso φ := sorry

/-- P0/almost-nakayama (iii): an almost finitely generated `X` with `X ⊗ A/I ≅ 0` is zero
(GR Corollary 5.1.7). -/
theorem isZero_of_reduction {R : Type u} [CommRing R] (T : BasicSetup R) (I : Ideal R)
    (m₀ : Ideal R) (hm₀ : m₀ ≤ T.ideal) (hfg : m₀.FG) (n : ℕ) (hn : I ^ n ≤ m₀)
    (hrad : T.ideal * I ≤ Ideal.jacobson ⊥) (X : Module T)
    (hX : Module.AlmostFG T ((Module.elements T).obj X))
    (h : IsZero ((Module.extendScalars T (R ⧸ I)).obj X)) : IsZero X := sorry

/-! ## PerfectoidSpaces:P0/tight-henselian-idempotent-lifting (lemma) -/

/-- P0/tight-henselian-idempotent-lifting: along a tight henselian pair, idempotents of `A_*` lift
uniquely from `A_*/I` (GR Proposition 5.1.17, Proposition 2.5.13(i)). -/
theorem bijective_idempotents_of_tightHenselian {A : Algebra S}
    (I : Ideal ((Algebra.elements S).obj A)) (hI : Algebra.Ideal.IsTight S I)
    (hH : Algebra.IsHenselianPair S I) :
    Function.Bijective (fun e : {e : (Algebra.elements S).obj A // IsIdempotentElem e} ↦
      (⟨Ideal.Quotient.mk I e.1, e.2.map _⟩ : {e : _ ⧸ I // IsIdempotentElem e})) := sorry

/-! ## PerfectoidSpaces:P0/adic-almost-projective-modules (theorem) -/

/-- P0/adic-almost-projective-modules: an `I`-adically complete module whose reductions
modulo `I^{n+1}` are almost finite projective is almost finite projective (GR Theorem 5.3.24). -/
theorem almostFiniteProjective_of_isAdicComplete {R : Type u} [CommRing R] (T : BasicSetup R)
    (I : Ideal R) (hI : ∃ m₀ : Ideal R, m₀ ≤ T.ideal ∧ m₀.FG ∧ ∃ n, I ^ n ≤ m₀)
    [IsAdicComplete I R] (N : Type u) [AddCommGroup N] [_root_.Module R N] [IsAdicComplete I N]
    (hN : ∀ n : ℕ, Module.AlmostFiniteProjective
      ((Module.extendScalars T (R ⧸ I ^ (n + 1))).obj ((toAlmost T).obj (ModuleCat.of R N)))) :
    Module.AlmostFiniteProjective ((toAlmost T).obj (ModuleCat.of R N)) := sorry

/-- P0/adic-almost-projective-modules: an almost finite projective `P` is the limit of its
reductions, `P ≅ lim_n P ⊗ R/I^{n+1}` (GR Theorem 5.3.24, (5.3.21)). -/
theorem isIso_toAdicCompletion_of_almostFiniteProjective {R : Type u} [CommRing R]
    (T : BasicSetup R) (I : Ideal R) (hI : ∃ m₀ : Ideal R, m₀ ≤ T.ideal ∧ m₀.FG ∧ ∃ n, I ^ n ≤ m₀)
    [IsAdicComplete I R] (N : Type u) [AddCommGroup N] [_root_.Module R N]
    (hN : Module.AlmostFiniteProjective ((toAlmost T).obj (ModuleCat.of R N))) :
    IsIso ((toAlmost T).map (ModuleCat.ofHom (AdicCompletion.of I N))) := sorry

/-! ## PerfectoidSpaces:P0/unramified-lifts-from-complete-reduction (lemma) -/

/-- P0/unramified-lifts-from-complete-reduction (ii): for `R` complete along a tight ideal `I` and
`R'^a` almost finite projective, unramified modulo `I` implies unramified (GR Theorem 5.2.12(ii),
Claim 5.3.29). -/
theorem isAlmostUnramifiedAlg_of_reduction {R : Type u} [CommRing R] (T : BasicSetup R)
    (R' : Type u) [CommRing R'] [_root_.Algebra R R'] (I : Ideal R)
    (hI : ∃ m₀ : Ideal R, m₀ ≤ T.ideal ∧ m₀.FG ∧ ∃ n, I ^ n ≤ m₀) [IsAdicComplete I R]
    (hP : Module.AlmostFiniteProjective (relModule T R'))
    (h₀ : IsAlmostUnramifiedAlg (T.baseChange (R ⧸ I)) ((R ⧸ I) ⊗[R] R')) :
    IsAlmostUnramifiedAlg T R' := sorry

/-- P0/unramified-lifts-from-complete-reduction (i): unramified modulo `I` and modulo `J` implies
unramified modulo `IJ` (GR Theorem 5.2.12(ii)). -/
theorem isAlmostUnramifiedAlg_mul {R : Type u} [CommRing R] (T : BasicSetup R)
    (R' : Type u) [CommRing R'] [_root_.Algebra R R'] (I J : Ideal R)
    (hI : IsAlmostUnramifiedAlg (T.baseChange (R ⧸ I)) ((R ⧸ I) ⊗[R] R'))
    (hJ : IsAlmostUnramifiedAlg (T.baseChange (R ⧸ J)) ((R ⧸ J) ⊗[R] R')) :
    IsAlmostUnramifiedAlg (T.baseChange (R ⧸ I * J)) ((R ⧸ I * J) ⊗[R] R') := sorry

/-! ## PerfectoidSpaces:P0/finite-etale-lifting-along-complete-flat-almost-algebras (theorem) -/

/-- P0/finite-etale-lifting-along-complete-flat-almost-algebras: essential surjectivity of
`A_fet → (A/I)_fet` for `R` complete along a tight ideal `I` (GR Theorem 5.3.27; Sch12 Theorem
4.17 over any basic setup). -/
theorem exists_finiteEtale_lift_of_isAdicComplete {R : Type u} [CommRing R] (T : BasicSetup R)
    (I : Ideal R) (hI : ∃ m₀ : Ideal R, m₀ ≤ T.ideal ∧ m₀.FG ∧ ∃ n, I ^ n ≤ m₀)
    [IsAdicComplete I R] (R₀' : Type u) [CommRing R₀'] [_root_.Algebra (R ⧸ I) R₀']
    (h₀ : IsAlmostFiniteEtaleAlg (T.baseChange (R ⧸ I)) R₀') :
    ∃ (R' : Type u) (_ : CommRing R') (_ : _root_.Algebra R R'), IsAlmostFiniteEtaleAlg T R' ∧
      Nonempty (Algebra.of (T.baseChange (R ⧸ I)) ((R ⧸ I) ⊗[R] R') ≅
        Algebra.of (T.baseChange (R ⧸ I)) R₀') := sorry

/-- P0/finite-etale-lifting-along-complete-flat-almost-algebras: full faithfulness of the
reduction on finite étale almost algebras (GR Theorem 5.3.27, Sch12 Theorem 4.17). -/
theorem existsUnique_hom_lift_of_isAdicComplete {R : Type u} [CommRing R] (T : BasicSetup R)
    (I : Ideal R) (hI : ∃ m₀ : Ideal R, m₀ ≤ T.ideal ∧ m₀.FG ∧ ∃ n, I ^ n ≤ m₀)
    [IsAdicComplete I R] (R' R'' : Type u) [CommRing R'] [_root_.Algebra R R'] [CommRing R'']
    [_root_.Algebra R R''] (h' : IsAlmostFiniteEtaleAlg T R') (h'' : IsAlmostFiniteEtaleAlg T R'')
    (ψ : Algebra.of T ((R ⧸ I) ⊗[R] R') ⟶ Algebra.of T ((R ⧸ I) ⊗[R] R''))
    (hψ : Algebra.ofHom T (_root_.Algebra.ofId R _) ≫ ψ =
      Algebra.ofHom T (_root_.Algebra.ofId R _)) :
    ∃! φ : Algebra.of T R' ⟶ Algebra.of T R'',
      Algebra.ofHom T (_root_.Algebra.ofId R R') ≫ φ = Algebra.ofHom T (_root_.Algebra.ofId R R'') ∧
        Algebra.ofHom T _root_.Algebra.TensorProduct.includeRight ≫ ψ =
          φ ≫ Algebra.ofHom T _root_.Algebra.TensorProduct.includeRight := sorry

/-! ## PerfectoidSpaces:P0/finite-etale-lift-flat-and-complete (lemma) -/

/-- P0/finite-etale-lift-flat-and-complete: a finite étale algebra over a `ϖ`-adically complete
`R` flat over `V^a` is flat over `V^a` and `ϖ`-adically complete (Sch12 Theorem 4.17). -/
theorem flat_and_complete_of_finiteEtale (R R' : Type u) [CommRing R] [_root_.Algebra V R]
    [CommRing R'] [_root_.Algebra R R'] [_root_.Algebra V R'] [IsScalarTower V R R'] (ϖ : V)
    (hϖ : ϖ ∈ S.ideal) [IsAdicComplete (Ideal.span {algebraMap V R ϖ}) R]
    (h : IsAlmostFiniteEtaleAlg (S.baseChange R) R')
    (hR : Module.Flat ((toAlmost S).obj (ModuleCat.of V R))) :
    Module.Flat ((toAlmost S).obj (ModuleCat.of V R')) ∧
      IsIso ((toAlmost (S.baseChange R)).map (ModuleCat.ofHom
        (AdicCompletion.of (Ideal.span {algebraMap V R ϖ}) R'))) := sorry

/-! ## PerfectoidSpaces:P0/uniform-finite-projectivity-mod-varpi (lemma) -/

/-- P0/uniform-finite-projectivity-mod-varpi: for a root setup and `R` `ϖ_0`-adically complete, a
finite étale `R'` is uniformly almost finitely generated with bound `r` iff `R'/ϖ_0` is
(Sch12 Theorem 4.17, last sentence). -/
theorem uniformlyAlmostFG_iff_reduction {R : Type u} [CommRing R] (p : ℕ) (hp : 2 ≤ p)
    (ϖ : ℕ → R) (hϖ : ∀ n, ϖ (n + 1) ^ p = ϖ n) [IsAdicComplete (Ideal.span {ϖ 0}) R]
    (R' : Type u) [CommRing R'] [_root_.Algebra R R']
    (h : IsAlmostFiniteEtaleAlg (BasicSetup.ofCompatibleRoots p hp ϖ hϖ) R') (r : ℕ) :
    Module.UniformlyAlmostFG (BasicSetup.ofCompatibleRoots p hp ϖ hϖ) R' r ↔
      Module.UniformlyAlmostFG
        ((BasicSetup.ofCompatibleRoots p hp ϖ hϖ).baseChange (R ⧸ Ideal.span {ϖ 0}))
        ((R ⧸ Ideal.span {ϖ 0}) ⊗[R] R') r := sorry

/-! ## PerfectoidSpaces:P0/almost-completeness-via-almost-elements (lemma) -/

section completion

open scoped Pointwise

/-- P0/almost-completeness-via-almost-elements: the tower `n ↦ X/ϖⁿX` of an almost module
(Sch12 Lemma 5.3(iv)). -/
def Module.adicTower (X : Module S) (ϖ : V) : ℕᵒᵖ ⥤ Module S := sorry

/-- P0/almost-completeness-via-almost-elements: the comparison `X ⟶ lim_n X/ϖⁿX`
(Sch12 Lemma 5.3(iv)). -/
def Module.toAdicLimit (X : Module S) (ϖ : V) : X ⟶ limit (Module.adicTower S X ϖ) := sorry

/-- P0/almost-completeness-via-almost-elements: the map `X_*/ϖⁿX_* → (X/ϖⁿX)_*`
(Bhatt Lemma 4.4.1(3)). -/
def Module.elementsModMap (X : Module S) (ϖ : V) (n : ℕ) :
    ((Module.elements S).obj X ⧸ (ϖ ^ n • ⊤ : Submodule V ((Module.elements S).obj X))) →ₗ[V]
      (Module.elements S).obj ((Module.adicTower S X ϖ).obj (Opposite.op n)) := sorry

/-- P0/almost-completeness-via-almost-elements (iii): for `X_*` without `ϖ`-torsion, `X` is
`ϖ`-adically complete iff `X_*` is (Sch12 Lemma 5.3(iv), Bhatt Lemma 4.4.1(3)). -/
theorem isAdicComplete_elements_iff (X : Module S) (ϖ : V) (hϖ : ϖ ∈ S.ideal)
    (htf : IsSMulRegular ((Module.elements S).obj X) ϖ) :
    IsAdicComplete (Ideal.span {ϖ}) ((Module.elements S).obj X) ↔
      IsIso (Module.toAdicLimit S X ϖ) := sorry

/-- P0/almost-completeness-via-almost-elements (ii): `X_*/ϖⁿX_* → (X/ϖⁿX)_*` is injective with
almost zero cokernel (Bhatt Lemma 4.4.1(3)). -/
theorem elementsModMap_injective_and_isAlmostIso (X : Module S) (ϖ : V) (hϖ : ϖ ∈ S.ideal)
    (htf : IsSMulRegular ((Module.elements S).obj X) ϖ) (n : ℕ) :
    Function.Injective (Module.elementsModMap S X ϖ n) ∧
      S.IsAlmostIso (Module.elementsModMap S X ϖ n) := sorry

end completion

/-! ## PerfectoidSpaces:P0/almost-exactness-passes-to-completion (lemma) -/

/-- P0/almost-exactness-passes-to-completion: a complex of `ϖ`-torsion-free `ϖ`-adically complete
modules whose reduction mod `ϖ` has almost zero cohomology has almost zero cohomology, its
reductions mod `ϖⁿ` too, and it becomes exact after inverting `ϖ`; the `lim¹` term of the Milnor
sequence is almost zero (ECD proof of Proposition 8.8, Berkeley proof of Proposition 8.2.8,
GR Lemma 2.4.2). -/
theorem isAlmostZero_homology_of_complete (ϖ : V) (hϖ : ϖ ∈ S.ideal)
    (C : CochainComplex (ModuleCat.{u} V) ℕ) (htf : ∀ i, IsSMulRegular (C.X i) ϖ)
    (hc : ∀ i, IsAdicComplete (Ideal.span {ϖ}) (C.X i))
    (hmod : ∀ i, (S.baseChange (V ⧸ Ideal.span {ϖ})).IsAlmostZero
      ((((ModuleCat.extendScalars (Ideal.Quotient.mk (Ideal.span {ϖ}))).mapHomologicalComplex
        _).obj C).homology i)) :
    (∀ (n i : ℕ), 1 ≤ n → (S.baseChange (V ⧸ Ideal.span {ϖ ^ n})).IsAlmostZero
      ((((ModuleCat.extendScalars (Ideal.Quotient.mk (Ideal.span {ϖ ^ n}))).mapHomologicalComplex
        _).obj C).homology i)) ∧
    (∀ i, S.IsAlmostZero (C.homology i)) ∧
    ∀ i, IsZero ((((ModuleCat.extendScalars
      (algebraMap V (Localization.Away ϖ))).mapHomologicalComplex _).obj C).homology i) := sorry

/-! ## PerfectoidSpaces:P0/almost-cech-and-sheaf-cohomology (construction) -/

namespace Sheaf

variable {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)

/-- P0/almost-cech-and-sheaf-cohomology (data): a sheaf of `V`-modules is *almost zero* if all its
sections are (GR (3.3.1)). -/
def IsAlmostZero (F : CategoryTheory.Sheaf J (ModuleCat.{u} V)) : Prop :=
  ∀ U : Cᵒᵖ, S.IsAlmostZero (F.obj.obj U)

/-- P0/almost-cech-and-sheaf-cohomology: the almost zero sheaves as an object property. -/
def almostZero : ObjectProperty (CategoryTheory.Sheaf J (ModuleCat.{u} V)) :=
  fun F ↦ IsAlmostZero S J F

variable [HasSheafify J (ModuleCat.{u} V)]

/-- P0/almost-cech-and-sheaf-cohomology (instance): almost zero sheaves form a Serre class of the
abelian category of sheaves (GR (3.3.1)). -/
instance almostZero_isSerreClass : (almostZero S J).IsSerreClass := sorry

end Sheaf

/-- P0/almost-cech-and-sheaf-cohomology (data): sheaves of almost `V`-modules, the Serre
localisation of sheaves of `V`-modules at the almost isomorphisms (GR (3.3.1)–(3.3.2)). -/
abbrev Sheaf {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)
    [HasSheafify J (ModuleCat.{u} V)] : Type (u + 1) :=
  (Sheaf.almostZero S J).isoModSerre.Localization

namespace Sheaf

variable {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)

/-- P0/almost-cech-and-sheaf-cohomology (constructor): the exact localisation `F ↦ F^a`
(GR (3.3.2)). -/
def toAlmost [HasSheafify J (ModuleCat.{u} V)] :
    CategoryTheory.Sheaf J (ModuleCat.{u} V) ⥤ Almost.Sheaf S J :=
  (almostZero S J).isoModSerre.Q

variable [HasSheafify J AddCommGrpCat.{u}] [HasExt.{u} (CategoryTheory.Sheaf J AddCommGrpCat.{u})]
  [J.HasSheafCompose (forget₂ (ModuleCat.{u} V) AddCommGrpCat.{u})]

/-- P0/almost-cech-and-sheaf-cohomology: the underlying abelian sheaf of a sheaf of `V`-modules. -/
def toAb (F : CategoryTheory.Sheaf J (ModuleCat.{u} V)) :
    CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
  (sheafCompose J (forget₂ (ModuleCat.{u} V) AddCommGrpCat.{u})).obj F

/-- P0/almost-cech-and-sheaf-cohomology (structure): `H^n(X, F)` (Mathlib `Sheaf.H'`) is a
`V`-module through the action of `V` on `F` (GR (3.3.1)). -/
instance cohomologyModule (F : CategoryTheory.Sheaf J (ModuleCat.{u} V)) (n : ℕ) (X : C) :
    _root_.Module V ((toAb J F).H' n X) := sorry

/-- P0/almost-cech-and-sheaf-cohomology (constructor): `H^n(X, F)^a` (GR (3.3.2)). -/
def almostH (F : CategoryTheory.Sheaf J (ModuleCat.{u} V)) (n : ℕ) (X : C) : Almost.Module S :=
  (Almost.toAlmost S).obj (ModuleCat.of V ((toAb J F).H' n X))

/-- P0/almost-cech-and-sheaf-cohomology (data): `F` is *almost acyclic* on `X` if
`H^n(X, F)^a = 0` for `n > 0` (ECD proof of Proposition 8.8). -/
def IsAlmostAcyclic (F : CategoryTheory.Sheaf J (ModuleCat.{u} V)) (X : C) : Prop :=
  ∀ n : ℕ, 0 < n → IsZero (almostH S J F n X)

/-- P0/almost-cech-and-sheaf-cohomology (constructor): the almost Čech complex of a family
`U : ι → C` (products taken in `C`; for a covering of `X` apply it over `X`), the almostification
of Mathlib's `cechComplexFunctor` (ECD proof of Proposition 8.8). -/
def almostCech [HasFiniteProducts C] {ι : Type u} (U : ι → C)
    (F : CategoryTheory.Sheaf J (ModuleCat.{u} V)) : CochainComplex (Almost.Module S) ℕ :=
  ((Almost.toAlmost S).mapHomologicalComplex _).obj ((cechComplexFunctor U).obj F.obj)

/-- P0/almost-cech-and-sheaf-cohomology (relation): almost zero sheaves have almost zero cohomology
in all degrees, so `almostH` factors through `F ↦ F^a` (GR (3.3.2)). -/
theorem almostH_eq_zero_of_isAlmostZero (F : CategoryTheory.Sheaf J (ModuleCat.{u} V))
    (hF : IsAlmostZero S J F) (n : ℕ) (X : C) : IsZero (almostH S J F n X) := sorry

/-- P0/almost-cech-and-sheaf-cohomology (compatibility): `H^n(X, F)^a ≅ 0` implies
`H^n(X, F)[1/ϖ] = 0` for `ϖ ∈ m` (P0/almost-inversion-and-completion). -/
theorem almostH_localization (F : CategoryTheory.Sheaf J (ModuleCat.{u} V)) (n : ℕ) (X : C)
    (ϖ : V) (hϖ : ϖ ∈ S.ideal) (h : IsZero (almostH S J F n X)) :
    Subsingleton (LocalizedModule (Submonoid.powers ϖ) ((toAb J F).H' n X)) := sorry

end Sheaf

-- test Almost.Sheaf.test_point (degenerate) [P0/almost-cech-and-sheaf-cohomology]
example (J : GrothendieckTopology (Discrete PUnit.{u + 1})) (hJ : J = ⊥)
    [HasSheafify J AddCommGrpCat.{u}] [HasExt.{u} (CategoryTheory.Sheaf J AddCommGrpCat.{u})]
    [J.HasSheafCompose (forget₂ (ModuleCat.{u} V) AddCommGrpCat.{u})]
    (F : CategoryTheory.Sheaf J (ModuleCat.{u} V)) :
    Sheaf.IsAlmostAcyclic S J F ⟨PUnit.unit⟩ := sorry

/- The constant sheaf `k = K°/K°°` is almost zero, so its almost cohomology vanishes even where
`H^n(X, k) ≠ 0`. -/
-- test Almost.Sheaf.test_constant_residue (computation) [P0/almost-cech-and-sheaf-cohomology]
example {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u}] [HasExt.{u} (CategoryTheory.Sheaf J AddCommGrpCat.{u})]
    [J.HasSheafCompose (forget₂ (ModuleCat.{u} V) AddCommGrpCat.{u})]
    (F : CategoryTheory.Sheaf J (ModuleCat.{u} V)) (hF : Sheaf.IsAlmostZero S J F) (n : ℕ)
    (X : C) : IsZero (Sheaf.almostH S J F n X) :=
  Sheaf.almostH_eq_zero_of_isAlmostZero S J F hF n X

/- The circle with the constant sheaf `k = V/m`: `H¹ = k ≠ 0` is almost zero. -/
-- test Almost.Sheaf.test_not_acyclic (non-example) [P0/almost-cech-and-sheaf-cohomology]
example {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u}] [HasExt.{u} (CategoryTheory.Sheaf J AddCommGrpCat.{u})]
    [J.HasSheafCompose (forget₂ (ModuleCat.{u} V) AddCommGrpCat.{u})]
    (F : CategoryTheory.Sheaf J (ModuleCat.{u} V)) (X : C) (hF : Sheaf.IsAlmostZero S J F)
    (hne : Nontrivial ((Sheaf.toAb J F).H' 1 X)) :
    Sheaf.IsAlmostAcyclic S J F X ∧ ¬ Subsingleton ((Sheaf.toAb J F).H' 1 X) := sorry

-- test Almost.Sheaf.test_classical (compatibility) [P0/almost-cech-and-sheaf-cohomology]
example {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u}] [HasExt.{u} (CategoryTheory.Sheaf J AddCommGrpCat.{u})]
    [J.HasSheafCompose (forget₂ (ModuleCat.{u} V) AddCommGrpCat.{u})]
    (F : CategoryTheory.Sheaf J (ModuleCat.{u} V)) (n : ℕ) (X : C) :
    Nonempty ((Module.classicalEquiv V).inverse.obj
        (Sheaf.almostH (BasicSetup.classical V) J F n X) ≅
      ModuleCat.of V ((Sheaf.toAb J F).H' n X)) := sorry

/-! ## PerfectoidSpaces:P0/almost-cech-acyclicity-criterion (lemma) -/

/-- P0/almost-cech-acyclicity-criterion: almost Čech acyclicity on a basis `𝔅` (every covering of
a `𝔅`-object refined by `𝔅`-objects) implies almost acyclicity on `𝔅` (ECD proof of Proposition
8.8, Berkeley proof of Theorem 7.4.4). -/
theorem Sheaf.isAlmostAcyclic_of_cech {C : Type u} [SmallCategory C] [HasFiniteProducts C]
    (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{u}]
    [HasExt.{u} (CategoryTheory.Sheaf J AddCommGrpCat.{u})]
    [J.HasSheafCompose (forget₂ (ModuleCat.{u} V) AddCommGrpCat.{u})] (𝔅 : ObjectProperty C)
    (F : CategoryTheory.Sheaf J (ModuleCat.{u} V))
    (hcov : ∀ X, 𝔅 X → ∀ R ∈ J X, ∃ (ι : Type u) (U : ι → C) (f : ∀ i, U i ⟶ X),
      (∀ i, 𝔅 (U i)) ∧ (∀ i, R (f i)) ∧ Sieve.ofArrows U f ∈ J X)
    (hcech : ∀ (ι : Type u) (U : ι → C), (∀ i, 𝔅 (U i)) →
      ∀ n, 0 < n → IsZero ((Sheaf.almostCech S J U F).homology n)) :
    ∀ X, 𝔅 X → Sheaf.IsAlmostAcyclic S J F X := sorry

end Almost

end TauCeti

end

/-! # Stage P1. Perfectoid Tate rings, tilts, Fontaine's θ, untilts and the tilting equivalence

Everything of this stage lives in `TauCeti.Perfectoid`, except two Huber-ring instances in
`TauCeti.Huber` (a nonarchimedean field is Tate, a product of Tate rings is Tate).

* **Perfectoid Tate rings.** `IsPerfectoidTateRing p R` is a `Prop`-valued class on a complete
  Hausdorff Tate ring `[CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
  [IsTateRing R] [CompleteSpace R] [T2Space R]`, with the two conditions of ECD Definition 3.1 as
  fields: `R°` is bounded, and some pseudo-uniformizer `ϖ ∈ R°` has `ϖ ^ p ∣ p` in `R°` and a
  bijective Frobenius `frobeniusModPow p ϖ h : R° ⧸ (ϖ) → R° ⧸ (ϖ ^ p)`. A perfectoid Huber pair
  is `IsPerfectoidPair p P`; the bundled category of perfectoid Tate rings (continuous ring maps)
  is `PerfectoidRingCat p`, and perfectoid `R`-algebras are its slice `PerfectoidAlgebra p R`.
* **Tilts.** `tilt p R` is a type synonym of Mathlib's monoid `Perfection R p` carrying the ring
  structure with limit addition (sorried instances), the inverse-limit uniformity (a real
  instance), coordinates `tilt.coeff n`, the sharp map `tilt.sharp = tilt.coeff 0`, functoriality
  `tilt.map p f hf` and the tilt of a Huber pair `Pair.tilt p P` (plus ring `{x | x♯ ∈ R⁺}`). The
  tilt of a complete uniform Tate ring that is not perfectoid is `uniformTilt p B`.
* **Mathlib comparison.** `tilt.integralEquivPreTilt` identifies `(tilt p R)°` with Mathlib's
  `PreTilt R° p`, and `theta p P : W((Pair.tilt p P)⁺) →+* P⁺` is Mathlib's
  `WittVector.fontaineTheta` transported along `Pair.tiltPlusEquivPreTilt`.
* **Untilts.** `IsPrimitive ξ`, `IsPrimitiveIdeal J`; the untilt `untilt p P J` of a
  characteristic-`p` perfectoid pair along a primitive ideal is the localisation of `W(R⁺) ⧸ J` at
  the Teichmüller lifts of all pseudo-uniformizers (so no choice of `ϖ` enters), with plus ring
  `untiltPlus p P J`; marked untilts are `MarkedUntilt p P`.
* **Examples.** `ℂ_p` (Mathlib `PadicComplex`), and `ℚ_p^cycl`, realised as the closed subfield
  `padicCyclotomic p` of `ℂ_p` generated by the `p`-power roots of unity.

Perfectoid *spaces* and everything geometric are not part of this stage. The almost setup of a
perfectoid Tate ring uses stage P0 (`Almost.BasicSetup`, `Almost.Module`, `Almost.Algebra`).
Sources: ECD = Scholze, *Étale cohomology of diamonds*; Sch12 = Scholze, *Perfectoid spaces*;
Berkeley = Scholze–Weinstein, *Berkeley lectures*; KL = Kedlaya–Liu, *Relative p-adic Hodge
theory* I, II; AWS = Kedlaya, *Sheaves, stacks and shtukas* (Arizona Winter School); BMS1 =
Bhatt–Morrow–Scholze, *Integral p-adic Hodge theory*; Bhatt = Bhatt, *Lecture notes on perfectoid
spaces*. -/

noncomputable section

namespace TauCeti

universe u

open Topology Filter CategoryTheory CategoryTheory.Limits
open scoped Pointwise

namespace Perfectoid

open Huber

/-! ## PerfectoidSpaces:P1/perfectoid-tate-rings-and-algebras (definition) -/

section Frobenius

variable (p : ℕ) [hp : Fact p.Prime]

/-- P1/perfectoid-tate-rings-and-algebras (data): for ideals `I, J` of a commutative ring `A`
with `p ∈ J` and `x ^ p ∈ J` for `x ∈ I`, the Frobenius `Φ : A ⧸ I → A ⧸ J`, `[x] ↦ [x ^ p]`
(ECD §3, the notational convention before Definition 3.1). -/
def frobeniusQuot {A : Type*} [CommRing A] (I J : Ideal A) (hpJ : (p : A) ∈ J)
    (hIJ : ∀ x ∈ I, x ^ p ∈ J) : A ⧸ I →+* A ⧸ J :=
  Ideal.Quotient.lift I
    { toFun := fun x ↦ Ideal.Quotient.mk J (x ^ p)
      map_one' := by simp
      map_mul' := fun x y ↦ by simp [mul_pow]
      map_zero' := by simp [zero_pow hp.out.ne_zero]
      map_add' := sorry }
    sorry

/-- P1/perfectoid-tate-rings-and-algebras (simp): `Φ [x] = [x ^ p]` (ECD §3). -/
@[simp] theorem frobeniusQuot_mk {A : Type*} [CommRing A] (I J : Ideal A) (hpJ : (p : A) ∈ J)
    (hIJ : ∀ x ∈ I, x ^ p ∈ J) (x : A) :
    frobeniusQuot p I J hpJ hIJ (Ideal.Quotient.mk I x) = Ideal.Quotient.mk J (x ^ p) := sorry

/-- P1/perfectoid-tate-rings-and-algebras (data): the Frobenius `Φ : A ⧸ (ϖ) → A ⧸ (ϖ ^ p)` of
`frobeniusQuot` for `ϖ ^ p ∣ p`, the map of ECD Definition 3.1 (b) for `A = R°`. -/
def frobeniusModPow {A : Type*} [CommRing A] (ϖ : A) (h : ϖ ^ p ∣ (p : A)) :
    A ⧸ Ideal.span {ϖ} →+* A ⧸ Ideal.span {ϖ ^ p} :=
  frobeniusQuot p _ _ (Ideal.mem_span_singleton.mpr h) fun _ hx ↦
    Ideal.mem_span_singleton.mpr (pow_dvd_pow_of_dvd (Ideal.mem_span_singleton.mp hx) p)

end Frobenius

section Definition

variable (p : ℕ) [Fact p.Prime]

/-- P1/perfectoid-tate-rings-and-algebras (structure): a complete Hausdorff Tate ring `R` is a
*perfectoid Tate ring* (ECD Definition 3.1) if (a) it is uniform, `R°` bounded, and (b) some
pseudo-uniformizer `ϖ ∈ R°` has `ϖ ^ p ∣ p` in `R°` and a bijective Frobenius
`Φ : R° ⧸ (ϖ) → R° ⧸ (ϖ ^ p)`. No base field is fixed: characteristic `0`, `p` and mixed
characteristic (`p` a nonzero nonunit) are allowed. -/
class IsPerfectoidTateRing (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] : Prop where
  /-- (a) `R` is uniform: the power-bounded subring `R°` is bounded. -/
  isBounded_powerBoundedSubring : IsBounded (powerBoundedSubring R : Set R)
  /-- (b) a pseudo-uniformizer `ϖ ∈ R°` with `ϖ ^ p ∣ p` in `R°` and `Φ` bijective. -/
  exists_pseudoUniformizer : ∃ (ϖ : powerBoundedSubring R)
    (h : ϖ ^ p ∣ (p : powerBoundedSubring R)),
    IsPseudoUniformizer (ϖ : R) ∧ Function.Bijective (frobeniusModPow p ϖ h)

variable {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
  [IsTateRing R] [CompleteSpace R] [T2Space R]

/-- P1/perfectoid-tate-rings-and-algebras (constructor): a complete Hausdorff uniform Tate ring
with a pseudo-uniformizer `ϖ ∈ R°`, `ϖ ^ p ∣ p` in `R°` and `Φ : R°/ϖ → R°/ϖ^p` surjective is
perfectoid; injectivity is automatic (ECD Remark 3.2,
P1/perfectoid-condition-independent-of-pseudouniformizer). -/
theorem IsPerfectoidTateRing.of_surjective (hb : IsBounded (powerBoundedSubring R : Set R))
    (ϖ : powerBoundedSubring R) (hϖ : IsPseudoUniformizer (ϖ : R))
    (h : ϖ ^ p ∣ (p : powerBoundedSubring R))
    (hs : Function.Surjective (frobeniusModPow p ϖ h)) : IsPerfectoidTateRing p R := sorry

/-- P1/perfectoid-tate-rings-and-algebras (characterisation): in a perfectoid Tate ring,
`Φ : R°/ϖ → R°/ϖ^p` is bijective for *every* pseudo-uniformizer `ϖ` with `ϖ ^ p ∣ p` in `R°`
(ECD Remark 3.2, P1/perfectoid-condition-independent-of-pseudouniformizer). -/
theorem IsPerfectoidTateRing.frobenius_bijective [IsPerfectoidTateRing p R]
    (ϖ : powerBoundedSubring R) (hϖ : IsPseudoUniformizer (ϖ : R))
    (h : ϖ ^ p ∣ (p : powerBoundedSubring R)) :
    Function.Bijective (frobeniusModPow p ϖ h) := sorry

/-- P1/perfectoid-tate-rings-and-algebras (characterisation): `R` is perfectoid iff it is
uniform, has a pseudo-uniformizer `ϖ ∈ R°` with `ϖ ^ p ∣ p` in `R°`, and Frobenius is surjective
on `R° ⧸ p` (ECD Remark 3.2, Berkeley Remark 6.1.3,
P1/perfectoid-condition-independent-of-pseudouniformizer). -/
theorem IsPerfectoidTateRing.iff_frobenius_surjective_modP :
    IsPerfectoidTateRing p R ↔ IsBounded (powerBoundedSubring R : Set R) ∧
      (∃ ϖ : powerBoundedSubring R, IsPseudoUniformizer (ϖ : R) ∧
        ϖ ^ p ∣ (p : powerBoundedSubring R)) ∧
      Function.Surjective fun x : ModP (powerBoundedSubring R) p ↦ x ^ p := sorry

/-- P1/perfectoid-tate-rings-and-algebras (other): a perfectoid Tate ring is reduced
(Sch12 Proposition 5.8, P1/perfectoid-tate-ring-is-reduced). -/
theorem IsPerfectoidTateRing.isReduced [IsPerfectoidTateRing p R] : IsReduced R := sorry

/-- P1/perfectoid-tate-rings-and-algebras (characterisation): in characteristic `p`, perfectoid
is perfect (ECD Proposition 3.5, P1/characteristic-p-perfectoid-iff-perfect). -/
theorem IsPerfectoidTateRing.iff_perfectRing [CharP R p] :
    IsPerfectoidTateRing p R ↔ PerfectRing R p := sorry

/-- P1/perfectoid-tate-rings-and-algebras (functoriality): the class transports along a ring
isomorphism that is a homeomorphism (via Tau Ceti `map_powerBoundedSubring`). -/
theorem IsPerfectoidTateRing.of_ringEquiv {S : Type*} [CommRing S] [UniformSpace S]
    [IsUniformAddGroup S] [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]
    [IsPerfectoidTateRing p R] (e : R ≃+* S) (he : Continuous e) (he' : Continuous e.symm) :
    IsPerfectoidTateRing p S := sorry

/-- P1/perfectoid-tate-rings-and-algebras (other): in a perfectoid Tate ring, Frobenius on
`R⁺ ⧸ p` is surjective for every ring of integral elements `R⁺`, not only for `R°`
(P1/frobenius-surjective-on-plus-ring). -/
theorem IsPerfectoidTateRing.frobenius_surjective_plus [IsPerfectoidTateRing p R] (P : Pair R) :
    Function.Surjective fun x : ModP P.plus p ↦ x ^ p := sorry

-- Perfectoid.IsPerfectoidTateRing.isUniform: not stated here; needs the anchor's uniformity
--   predicate for Tate rings (Hansen–Kedlaya Definition 2.3), which is not in Tau Ceti at the
--   pin; condition (a) is stated directly as `IsBounded (powerBoundedSubring R)` (supplier:
--   AdicSpaces Layer 4)

/-- P1/perfectoid-tate-rings-and-algebras (structure): a Huber pair `(R, R⁺)` is *perfectoid*
if `R` is a perfectoid Tate ring; the condition does not involve `R⁺`
(P1/frobenius-surjective-on-plus-ring). -/
def IsPerfectoidPair (_P : Pair R) : Prop := IsPerfectoidTateRing p R

end Definition

section MapPowerBounded

/-- P1/perfectoid-tate-rings-and-algebras (other): a continuous ring homomorphism from a Tate ring
into a *uniform* Tate ring carries `A°` into `S°`: for `x ∈ A°` and a pseudo-uniformizer `ϖ`,
`f(ϖ) f(x) ^ N` is topologically nilpotent, so `{f(x) ^ N} ⊆ f(ϖ)⁻¹ S°`, a bounded set. -/
theorem map_mem_powerBoundedSubring {A S : Type*} [CommRing A] [TopologicalSpace A]
    [IsTopologicalRing A] [IsTateRing A] [CommRing S] [TopologicalSpace S] [IsTopologicalRing S]
    [IsTateRing S] (hS : IsBounded (powerBoundedSubring S : Set S)) (f : A →+* S)
    (hf : Continuous f) {x : A} (hx : x ∈ powerBoundedSubring A) :
    f x ∈ powerBoundedSubring S := sorry

end MapPowerBounded

/-- P1/perfectoid-tate-rings-and-algebras (instance): a product of Tate rings is a Tate ring,
with pair of definition `(A₀ × B₀, I × J)` and pseudo-uniformizer `(ϖ_A, ϖ_B)`; used for
`IsPerfectoidTateRing.prod`. -/
instance _root_.TauCeti.Huber.IsTateRing.instProd {A B : Type*} [CommRing A] [TopologicalSpace A]
    [IsTopologicalRing A] [IsTateRing A] [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
    [IsTateRing B] : IsTateRing (A × B) := sorry

/-- P1/perfectoid-field-definition (instance): a nontrivially normed ultrametric field is a Tate
ring, with ring of definition the closed unit ball and pseudo-uniformizer any `0 < ‖ϖ‖ < 1`; its
power-bounded subring is the closed unit ball and `K°°` the open unit ball. Stated here because
the examples of this node (`ℂ_p`, `ℚ_p^cycl`) use it. -/
instance _root_.TauCeti.Huber.isTateRing_of_nontriviallyNormedField (K : Type*)
    [NontriviallyNormedField K] [IsUltrametricDist K] : IsTateRing K := sorry

section Prod

variable (p : ℕ) [Fact p.Prime] {R S : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [CommRing S] [UniformSpace S]
  [IsUniformAddGroup S] [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]

/-- P1/perfectoid-tate-rings-and-algebras (instance): `R × S` is perfectoid when `R` and `S`
are: `(R × S)° = R° × S°`, and `(ϖ_R, ϖ_S)` is a pseudo-uniformizer with the required properties
(ECD Example 3.4, products such as `K × K♭`). -/
instance IsPerfectoidTateRing.prod [IsPerfectoidTateRing p R] [IsPerfectoidTateRing p S] :
    IsPerfectoidTateRing p (R × S) := sorry

end Prod

section Examples

variable (p : ℕ) [Fact p.Prime]

/-- P1/perfectoid-tate-rings-and-algebras (instance): `ℂ_p` is a perfectoid Tate ring, with
`ϖ = p ^ {1/p}` (ECD Example 3.4, P1/perfectoid-examples (1)); the field form is
`isPerfectoidField_padicComplex` (P1/perfectoid-field-definition). -/
instance instIsPerfectoidTateRingPadicComplex : IsPerfectoidTateRing p ℂ_[p] := sorry

/-- P1/cyclotomic-perfectoid-field (data): `ℚ_p^cycl`, the completion of `ℚ_p(μ_{p^∞})`,
realised as the closure in `ℂ_p` of the subfield generated by the `p`-power roots of unity (it
contains `ℚ_p`, the closure of `ℚ`). Declared here because the examples of the tilt use it. -/
def padicCyclotomic : Subfield ℂ_[p] :=
  (Subfield.closure {ζ : ℂ_[p] | ∃ n : ℕ, ζ ^ p ^ n = 1}).topologicalClosure

/-- P1/cyclotomic-perfectoid-field (instance): `ℚ_p^cycl` is complete, being closed in `ℂ_p`. -/
instance padicCyclotomic.instCompleteSpace : CompleteSpace (padicCyclotomic p) :=
  (Subfield.isClosed_topologicalClosure _).completeSpace_coe

/-- P1/cyclotomic-perfectoid-field (instance): the absolute value of `ℚ_p^cycl` is nontrivial
(`‖p‖ = p⁻¹`). -/
instance padicCyclotomic.instNontriviallyNormedField :
    NontriviallyNormedField (padicCyclotomic p) :=
  { (inferInstance : NormedField (padicCyclotomic p)) with non_trivial := sorry }

/-- P1/cyclotomic-perfectoid-field (instance): `ℚ_p^cycl` is a perfectoid Tate ring
(ECD Example 3.4(i); the field statement is `isPerfectoidField_padicCyclotomic`). -/
instance padicCyclotomic.instIsPerfectoidTateRing :
    IsPerfectoidTateRing p (padicCyclotomic p) := sorry

/-- P1/perfectoid-tate-rings-and-algebras (example): the Tate ring `ℂ_p[ε]/(ε²)` with the product
topology on `ℂ_p ⊕ ℂ_p ε` (ECD Remark 3.3's companion non-example; Tau Ceti has no instance). -/
instance dualNumberPadicComplex.instIsTateRing : IsTateRing (DualNumber ℂ_[p]) := sorry

end Examples

section ExampleTests

variable (p : ℕ) [Fact p.Prime]

/- `ϖ ∈ ℚ_p` pseudo-uniformizer has `|ϖ| = p^{-k}`, `k ≥ 1`, so `ϖ ^ p ∤ p` in `ℤ_p`, although
Frobenius on `ℤ_p ⧸ p = 𝔽_p` is bijective (ECD Remark 3.3). -/
-- test Perfectoid.not_isPerfectoidTateRing_padic (non-example)
--   [P1/perfectoid-tate-rings-and-algebras]
example : ¬ IsPerfectoidTateRing p ℚ_[p] ∧
    Function.Surjective fun x : ModP (powerBoundedSubring ℚ_[p]) p ↦ x ^ p := sorry

/- `R = ℂ_p[ε]/(ε²)`: `ϖ = p^{1/p}` satisfies `ϖ ^ p = p`, Frobenius is surjective on
`R° ⧸ p = 𝒪_{ℂ_p} ⧸ p` (`ℂ_p ε ⊆ R°` and `ℂ_p ε = p ℂ_p ε`), but `R° ⊇ ℂ_p ε` is unbounded. -/
-- test Perfectoid.IsPerfectoidTateRing.not_of_not_uniform (non-example)
--   [P1/perfectoid-tate-rings-and-algebras]
example : ¬ IsBounded (powerBoundedSubring (DualNumber ℂ_[p]) : Set (DualNumber ℂ_[p])) ∧
    (∃ ϖ : powerBoundedSubring (DualNumber ℂ_[p]), IsPseudoUniformizer (ϖ : DualNumber ℂ_[p]) ∧
      ϖ ^ p ∣ (p : powerBoundedSubring (DualNumber ℂ_[p]))) ∧
    (Function.Surjective fun x : ModP (powerBoundedSubring (DualNumber ℂ_[p])) p ↦ x ^ p) ∧
    ¬ IsPerfectoidTateRing p (DualNumber ℂ_[p]) := sorry

-- test Perfectoid.isPerfectoidTateRing_zero (degenerate) [P1/perfectoid-tate-rings-and-algebras]
example (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [Subsingleton R] :
    IsPerfectoidTateRing p R := sorry

/- `ϖ = p^{1/p}`: `ϖ ^ p = p` and `Φ : 𝒪/ϖ → 𝒪/p` is bijective, every element of `𝒪_{ℂ_p}`
having a `p`-th root. -/
-- test Perfectoid.isPerfectoidTateRing_padicComplex (computation)
--   [P1/perfectoid-tate-rings-and-algebras]
example (ϖ : powerBoundedSubring ℂ_[p]) (hϖ : ϖ ^ p = p) :
    ∃ h : ϖ ^ p ∣ (p : powerBoundedSubring ℂ_[p]),
      IsPseudoUniformizer (ϖ : ℂ_[p]) ∧ Function.Bijective (frobeniusModPow p ϖ h) ∧
      IsPerfectoidTateRing p ℂ_[p] := sorry

/- The completed perfection of `𝔽_p((t))` is `tilt p (padicCyclotomic p)`
(P1/cyclotomic-perfectoid-field, `t = ε - 1`); for it both sides hold. For `𝔽_p((t))` itself both
fail; the statement for a general complete Tate ring of characteristic `p` is
`IsPerfectoidTateRing.iff_perfectRing`. -/
-- test Perfectoid.isPerfectoidTateRing_iff_perfect_laurent (characterisation)
--   [P1/perfectoid-tate-rings-and-algebras]
example (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [CharP R p] (t : R) (ht : IsPseudoUniformizer t)
    (hnot : ¬ ∃ s : R, s ^ p = t) :
    ¬ IsPerfectoidTateRing p R ∧ ¬ PerfectRing R p := sorry

end ExampleTests

section Category

variable (p : ℕ) [Fact p.Prime]

/-- P1/perfectoid-tate-rings-and-algebras (structure): the category of perfectoid Tate rings
with continuous ring homomorphisms (the objects of ECD §3; the source and target of the tilting
functor `tiltFunctor`). -/
structure PerfectoidRingCat : Type (u + 1) where
  /-- The underlying type. -/
  carrier : Type u
  /-- The ring structure. -/
  [commRing : CommRing carrier]
  /-- The uniformity. -/
  [uniformSpace : UniformSpace carrier]
  /-- The uniformity is that of the additive group. -/
  [isUniformAddGroup : IsUniformAddGroup carrier]
  /-- A topological ring. -/
  [isTopologicalRing : IsTopologicalRing carrier]
  /-- A Tate ring. -/
  [isTateRing : IsTateRing carrier]
  /-- Complete. -/
  [completeSpace : CompleteSpace carrier]
  /-- Hausdorff. -/
  [t2Space : T2Space carrier]
  /-- Perfectoid. -/
  [isPerfectoidTateRing : IsPerfectoidTateRing p carrier]

attribute [instance] PerfectoidRingCat.commRing PerfectoidRingCat.uniformSpace
  PerfectoidRingCat.isUniformAddGroup PerfectoidRingCat.isTopologicalRing
  PerfectoidRingCat.isTateRing PerfectoidRingCat.completeSpace PerfectoidRingCat.t2Space
  PerfectoidRingCat.isPerfectoidTateRing

namespace PerfectoidRingCat

instance : CoeSort (PerfectoidRingCat.{u} p) (Type u) := ⟨PerfectoidRingCat.carrier⟩

/-- P1/perfectoid-tate-rings-and-algebras (constructor): the bundled perfectoid Tate ring. -/
abbrev of (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] :
    PerfectoidRingCat.{u} p :=
  ⟨R⟩

/-- P1/perfectoid-tate-rings-and-algebras (structure): morphisms are continuous ring
homomorphisms. -/
structure Hom (X Y : PerfectoidRingCat.{u} p) where
  /-- The ring homomorphism. -/
  hom : X →+* Y
  /-- It is continuous. -/
  continuous_hom : Continuous hom

/-- P1/perfectoid-tate-rings-and-algebras (instance): the category of perfectoid Tate rings. -/
instance instCategory : Category.{u} (PerfectoidRingCat.{u} p) where
  Hom X Y := Hom p X Y
  id X := ⟨RingHom.id X, continuous_id⟩
  comp f g := ⟨g.hom.comp f.hom, g.continuous_hom.comp f.continuous_hom⟩
  id_comp := sorry
  comp_id := sorry
  assoc := sorry

end PerfectoidRingCat

/-- P1/perfectoid-tate-rings-and-algebras (structure): the category of perfectoid `R`-algebras,
perfectoid Tate rings `S` with a continuous ring homomorphism `R → S`, morphisms continuous
`R`-algebra homomorphisms: the slice category under `R`. -/
abbrev PerfectoidAlgebra (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] : Type (u + 1) :=
  Under (PerfectoidRingCat.of p R)

end Category

/-! ## PerfectoidSpaces:P1/integral-elements-adically-complete (lemma) -/

section IntegralComplete

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]

/-- P1/integral-elements-adically-complete (a): in a complete Hausdorff uniform Tate ring, a ring
of integral elements `R⁺` is `ϖ`-adically complete and separated for every pseudo-uniformizer
`ϖ ∈ R⁺`, and its subspace topology is the `ϖ`-adic one (Tau Ceti `IsAdic`). -/
theorem isAdicComplete_span_pseudoUniformizer (hb : IsBounded (powerBoundedSubring R : Set R))
    (P : Pair R) (ϖ : P.plus) (hϖ : IsPseudoUniformizer (ϖ : R)) :
    IsAdicComplete (Ideal.span {ϖ}) P.plus ∧ IsAdic (Ideal.span {ϖ}) := sorry

/-- P1/integral-elements-adically-complete (b): `ϖ` is a nonzerodivisor of `R⁺` and
`R = R⁺[1/ϖ]`. -/
theorem isLocalization_away_pseudoUniformizer (P : Pair R) (ϖ : P.plus)
    (hϖ : IsPseudoUniformizer (ϖ : R)) :
    IsSMulRegular P.plus ϖ ∧
      @IsLocalization.Away P.plus _ ϖ R _ P.plus.subtype.toAlgebra := sorry

/-- P1/integral-elements-adically-complete (c): if a pseudo-uniformizer `ϖ ∈ R⁺` divides `p`
in `R⁺`, then `R⁺` is `p`-adically complete and separated. -/
theorem isAdicComplete_span_p (hb : IsBounded (powerBoundedSubring R : Set R)) (P : Pair R)
    (ϖ : P.plus) (hϖ : IsPseudoUniformizer (ϖ : R)) (hdvd : ϖ ∣ (p : P.plus)) :
    IsAdicComplete (Ideal.span {(p : P.plus)}) P.plus := sorry

/-- P1/integral-elements-adically-complete (d): if `R ≠ 0` and `p` is topologically nilpotent in
`R`, then `p` is not a unit of `R⁺`. -/
theorem not_isUnit_p [Nontrivial R] (P : Pair R) (hp : IsTopologicallyNilpotent (p : R)) :
    ¬ IsUnit (p : P.plus) := sorry

/-- P1/integral-elements-adically-complete: `R°` is bounded in a perfectoid Tate ring, as a
`Fact` (the hypothesis of `uniformTilt`). -/
theorem IsPerfectoidTateRing.fact_isBounded (h : IsPerfectoidTateRing p R) :
    Fact (IsBounded (powerBoundedSubring R : Set R)) :=
  ⟨h.isBounded_powerBoundedSubring⟩

/-- P1/integral-elements-adically-complete: `p` is topologically nilpotent in a perfectoid Tate
ring (`p ∈ ϖ ^ p R°`), as a `Fact` (the hypothesis of `uniformTilt`). -/
theorem IsPerfectoidTateRing.fact_isTopologicallyNilpotent_p (h : IsPerfectoidTateRing p R) :
    Fact (IsTopologicallyNilpotent (p : R)) := ⟨sorry⟩

variable [IsPerfectoidTateRing p R]

/-- P1/integral-elements-adically-complete (instance): for `R ≠ 0` perfectoid, `p` is not a unit
of `R⁺`: Mathlib's standing hypothesis for `PreTilt R⁺ p` and `WittVector.fontaineTheta`. -/
instance fact_not_isUnit_p_plus [Nontrivial R] (P : Pair R) : Fact (¬ IsUnit (p : P.plus)) :=
  ⟨sorry⟩

/-- P1/integral-elements-adically-complete (instance): for `R` perfectoid, `R⁺` is `p`-adically
complete: Mathlib's standing hypothesis for `PreTilt.untilt` and `WittVector.fontaineTheta`. -/
instance isAdicComplete_p_plus (P : Pair R) :
    IsAdicComplete (Ideal.span {(p : P.plus)}) P.plus := sorry

/-- P1/integral-elements-adically-complete (instance): the case `R⁺ = R°` of
`fact_not_isUnit_p_plus`. -/
instance fact_not_isUnit_p_powerBounded [Nontrivial R] :
    Fact (¬ IsUnit (p : powerBoundedSubring R)) := ⟨sorry⟩

/-- P1/integral-elements-adically-complete (instance): the case `R⁺ = R°` of
`isAdicComplete_p_plus`. -/
instance isAdicComplete_p_powerBounded :
    IsAdicComplete (Ideal.span {(p : powerBoundedSubring R)}) (powerBoundedSubring R) := sorry



end IntegralComplete

/-! ## PerfectoidSpaces:P1/frobenius-surjectivity-criterion (lemma) -/

section SurjectivityCriterion

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]

/-- P1/frobenius-surjectivity-criterion: for a complete Hausdorff uniform Tate ring, a ring of
integral elements `R⁺` (e.g. `R°`, `Pair.powerBounded R`) and a pseudo-uniformizer `ϖ ∈ R⁺` with
`ϖ ^ p ∣ p` in `R⁺`, the following are equivalent: `Φ : R⁺/ϖ → R⁺/ϖ^p` is surjective; Frobenius
on `R⁺ ⧸ p` is surjective; every element of `R⁺ ⧸ ϖp` is a `p`-th power (ECD proof of Lemma 3.10,
KL I Remark 3.4.9 for the necessity of the divisibility). -/
theorem frobenius_surjective_tfae (hb : IsBounded (powerBoundedSubring R : Set R)) (P : Pair R)
    (ϖ : P.plus) (hϖ : IsPseudoUniformizer (ϖ : R)) (h : ϖ ^ p ∣ (p : P.plus)) :
    List.TFAE [Function.Surjective (frobeniusModPow p ϖ h),
      Function.Surjective fun x : ModP P.plus p ↦ x ^ p,
      ∀ y : P.plus, ∃ x : P.plus, y - x ^ p ∈ Ideal.span {ϖ * p}] := sorry

/- `ℤ_p[p^{1/p}] ⊆ ℚ_p(p^{1/p})` with `ϖ = p^{1/p}`: Frobenius of `R°/ϖ = 𝔽_p` is surjective,
but `Φ : R°/ϖ → R°/ϖ^p` is not. -/
/-- P1/frobenius-surjectivity-criterion: surjectivity of the Frobenius *endomorphism* of `R⁺/ϖ`
is weaker than surjectivity of `Φ : R⁺/ϖ → R⁺/ϖ^p`; the latter implies the former
(KL I Remark 3.4.9). -/
theorem surjective_frobenius_modPseudoUniformizer (P : Pair R) (ϖ : P.plus)
    (h : ϖ ^ p ∣ (p : P.plus)) (hs : Function.Surjective (frobeniusModPow p ϖ h)) :
    Function.Surjective fun x : P.plus ⧸ Ideal.span {ϖ} ↦ x ^ p := sorry

end SurjectivityCriterion

/-! ## PerfectoidSpaces:P1/perfectoid-condition-independent-of-pseudouniformizer (lemma) -/

section Independence

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]

/-- P1/perfectoid-condition-independent-of-pseudouniformizer (c): for a ring of integral elements
`R⁺`, a pseudo-uniformizer `ϖ ∈ R⁺` with `ϖ ^ p ∣ p` in `R⁺`, and `x ∈ R⁺` with
`x ^ p ∈ ϖ ^ p R⁺`, already `x ∈ ϖ R⁺` (`R⁺` is integrally closed and `ϖ` a unit of `R`). -/
theorem mem_span_of_pow_mem_span_pow (P : Pair R) (ϖ : P.plus)
    (hϖ : IsPseudoUniformizer (ϖ : R)) {x : P.plus} (hx : x ^ p ∈ Ideal.span {ϖ ^ p}) :
    x ∈ Ideal.span {ϖ} := sorry

/-- P1/perfectoid-condition-independent-of-pseudouniformizer (a): `Φ : R⁺/ϖ → R⁺/ϖ^p` is always
injective (ECD Remark 3.2). -/
theorem frobeniusModPow_injective (P : Pair R) (ϖ : P.plus) (hϖ : IsPseudoUniformizer (ϖ : R))
    (h : ϖ ^ p ∣ (p : P.plus)) : Function.Injective (frobeniusModPow p ϖ h) := sorry

/-- P1/perfectoid-condition-independent-of-pseudouniformizer (b): for a complete Hausdorff
uniform Tate ring, `Φ` is bijective for `ϖ` iff it is for `ϖ'` (ECD Remark 3.2, Berkeley Remark
6.1.3). -/
theorem frobeniusModPow_bijective_iff (hb : IsBounded (powerBoundedSubring R : Set R))
    (P : Pair R) (ϖ ϖ' : P.plus) (hϖ : IsPseudoUniformizer (ϖ : R))
    (hϖ' : IsPseudoUniformizer (ϖ' : R)) (h : ϖ ^ p ∣ (p : P.plus))
    (h' : ϖ' ^ p ∣ (p : P.plus)) :
    Function.Bijective (frobeniusModPow p ϖ h) ↔ Function.Bijective (frobeniusModPow p ϖ' h') :=
  sorry

end Independence

/-! ## PerfectoidSpaces:P1/perfectoid-tate-ring-is-reduced (lemma) -/

/-- P1/perfectoid-tate-ring-is-reduced: a Hausdorff uniform Tate ring is reduced (Sch12
Proposition 5.8; Berkeley proof of Proposition 6.1.6): a nilpotent `x` has `ϖ⁻ⁿ x` power-bounded
for all `n`, so `x ∈ ⋂ ϖⁿ R° = 0`. Uniformity is essential (`ℂ_p[ε]/(ε²)`). -/
theorem isReduced_of_isBounded {R : Type*} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
    [IsTateRing R] [T2Space R] (hb : IsBounded (powerBoundedSubring R : Set R)) :
    IsReduced R := sorry

/-! ## PerfectoidSpaces:P1/perfect-complete-tate-ring-is-uniform (lemma) -/

/-- P1/perfect-complete-tate-ring-is-uniform: a perfect complete Hausdorff Tate ring of
characteristic `p` is uniform (open mapping theorem: Frobenius is a continuous bijection, hence a
homeomorphism, and `(R°)^{1/p} = R°`). -/
theorem isBounded_powerBoundedSubring_of_perfectRing (p : ℕ) [Fact p.Prime] {R : Type*}
    [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R]
    [CompleteSpace R] [T2Space R] [CharP R p] [PerfectRing R p] :
    IsBounded (powerBoundedSubring R : Set R) := sorry

/-! ## PerfectoidSpaces:P1/characteristic-p-perfectoid-iff-perfect (theorem) -/

section CharP

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [CharP R p]

/-- P1/characteristic-p-perfectoid-iff-perfect: in characteristic `p`, a perfectoid Tate ring
has `R°` and every ring of integral elements perfect (ECD Proposition 3.5); the equivalence with
perfectness is `IsPerfectoidTateRing.iff_perfectRing`. -/
theorem IsPerfectoidTateRing.perfectRing_plus [IsPerfectoidTateRing p R] (P : Pair R) :
    PerfectRing P.plus p := sorry

/-- P1/characteristic-p-perfectoid-iff-perfect: in characteristic `p` every pseudo-uniformizer
`ϖ ∈ R°` of a perfectoid Tate ring satisfies ECD Definition 3.1 (`ϖ ^ p ∣ p = 0` is vacuous). -/
theorem IsPerfectoidTateRing.frobeniusModPow_bijective_of_charP [IsPerfectoidTateRing p R]
    (ϖ : powerBoundedSubring R) (hϖ : IsPseudoUniformizer (ϖ : R)) :
    ∃ h : ϖ ^ p ∣ (p : powerBoundedSubring R), Function.Bijective (frobeniusModPow p ϖ h) :=
  sorry

/-- P1/characteristic-p-perfectoid-iff-perfect: a perfect complete Hausdorff Tate ring of
characteristic `p` is perfectoid (ECD Proposition 3.5, `←`). -/
theorem IsPerfectoidTateRing.of_perfectRing [PerfectRing R p] : IsPerfectoidTateRing p R :=
  sorry

/-- P1/characteristic-p-perfectoid-iff-perfect (instance): a perfectoid Tate ring of
characteristic `p` is perfect (ECD Proposition 3.5, `→`). -/
instance IsPerfectoidTateRing.instPerfectRing [IsPerfectoidTateRing p R] : PerfectRing R p :=
  (IsPerfectoidTateRing.iff_perfectRing p).mp inferInstance

end CharP

/-! ## PerfectoidSpaces:P1/inverse-limit-of-integral-elements-along-frobenius (lemma) -/

section InverseLimit

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]

/-- P1/inverse-limit-of-integral-elements-along-frobenius: for `R ≠ 0` and a pseudo-uniformizer
`ϖ₀ ∈ R⁺` dividing `p`, `R⁺ ⧸ ϖ₀` has characteristic `p`. -/
theorem charP_quotient_pseudoUniformizer [Nontrivial R] (P : Pair R) (ϖ₀ : P.plus)
    (hϖ₀ : IsPseudoUniformizer (ϖ₀ : R)) (hdvd : ϖ₀ ∣ (p : P.plus)) :
    CharP (P.plus ⧸ Ideal.span {ϖ₀}) p := sorry

/-- P1/inverse-limit-of-integral-elements-along-frobenius (ECD Lemma 3.10, first part): for
`R ≠ 0` complete Hausdorff uniform, `R⁺` a ring of integral elements and `ϖ₀ ∈ R⁺` a
pseudo-uniformizer dividing `p`, reduction `(x⁽ⁿ⁾) ↦ (x⁽ⁿ⁾ mod ϖ₀)` is a multiplicative bijection
`lim_{x ↦ x^p} R⁺ → lim_Φ R⁺/ϖ₀` (Mathlib `Perfection.quotientMulEquiv`); its inverse sends
`(x̄ᵢ)` to `x⁽ⁱ⁾ = lim x_{n+i}^{p^n}` for arbitrary lifts. The same holds for `p` in place of
`ϖ₀`. -/
theorem bijective_perfection_mapMonoidHom_quotient [Nontrivial R]
    (hb : IsBounded (powerBoundedSubring R : Set R)) (P : Pair R) (ϖ₀ : P.plus)
    (hϖ₀ : IsPseudoUniformizer (ϖ₀ : R)) (hdvd : ϖ₀ ∣ (p : P.plus)) :
    Function.Bijective (Perfection.mapMonoidHom p (Ideal.Quotient.mk (Ideal.span {ϖ₀}) :
        P.plus →* P.plus ⧸ Ideal.span {ϖ₀})) ∧
      Function.Bijective (Perfection.mapMonoidHom p (Ideal.Quotient.mk (Ideal.span {(p : P.plus)}) :
        P.plus →* ModP P.plus p)) := sorry

/-- P1/inverse-limit-of-integral-elements-along-frobenius: the ring homomorphism
`lim_Φ R⁺/p → lim_Φ R⁺/ϖ₀` induced by the quotient map is an isomorphism; with Mathlib's
`PreTilt R⁺ p = Perfection (ModP R⁺ p) p` (ECD Lemma 3.10). -/
def preTiltEquivPerfectionQuotient [IsPerfectoidTateRing p R] [Nontrivial R] (P : Pair R)
    (ϖ₀ : P.plus) [CharP (P.plus ⧸ Ideal.span {ϖ₀}) p] (hϖ₀ : IsPseudoUniformizer (ϖ₀ : R))
    (hdvd : ϖ₀ ∣ (p : P.plus)) : PreTilt P.plus p ≃+* Perfection (P.plus ⧸ Ideal.span {ϖ₀}) p :=
  sorry

end InverseLimit

/-! ## PerfectoidSpaces:P1/pseudouniformizer-with-compatible-roots (definition) -/

section Roots

variable (p : ℕ) [Fact p.Prime] (R : Type*) [CommRing R] [TopologicalSpace R]
  [IsTopologicalRing R] [IsTateRing R]

/-- P1/pseudouniformizer-with-compatible-roots (structure): a *pseudo-uniformizer with compatible
`p`-power roots* `ϖ♭ = (ϖ^{1/pⁿ})ₙ ∈ lim_{x ↦ x^p} R` (Mathlib `Perfection R p`) whose zeroth
coordinate `ϖ` is a pseudo-uniformizer lying in `R°` with `ϖ ^ p ∣ p` in `R°` (ECD Lemma 3.10;
Sch12 Lemma 3.4, Remark 3.5). Defined for any Tate ring; P1/metric-perfectoid-criterion uses it
on rings not assumed perfectoid. -/
structure PseudoUniformizerRoots where
  /-- The compatible system `(ϖ^{1/pⁿ})ₙ`. -/
  roots : Perfection R p
  /-- `ϖ = ϖ^{1/p⁰}` is power-bounded. -/
  mem_powerBoundedSubring : Perfection.coeffMonoidHom R p 0 roots ∈ powerBoundedSubring R
  /-- `ϖ` is a pseudo-uniformizer. -/
  isPseudoUniformizer : IsPseudoUniformizer (Perfection.coeffMonoidHom R p 0 roots)
  /-- `ϖ ^ p ∣ p` in `R°`. -/
  pow_dvd_p : (⟨_, mem_powerBoundedSubring⟩ : powerBoundedSubring R) ^ p ∣
    (p : powerBoundedSubring R)

namespace PseudoUniformizerRoots

variable {p R} (ϖ : PseudoUniformizerRoots p R)

/-- P1/pseudouniformizer-with-compatible-roots (data): `root n = ϖ^{1/pⁿ}`, the `n`-th coordinate
(Mathlib `Perfection.coeffMonoidHom R p n`). -/
def root (n : ℕ) : R := Perfection.coeffMonoidHom R p n ϖ.roots

/-- P1/pseudouniformizer-with-compatible-roots (simp): `(ϖ^{1/p^{n+1}}) ^ p = ϖ^{1/pⁿ}`. -/
@[simp] theorem root_pow (n : ℕ) : ϖ.root (n + 1) ^ p = ϖ.root n := sorry

omit [Fact p.Prime] in
/-- P1/pseudouniformizer-with-compatible-roots (simp): `root 0 = ϖ`. -/
theorem root_zero : ϖ.root 0 = Perfection.coeffMonoidHom R p 0 ϖ.roots := rfl

/-- P1/pseudouniformizer-with-compatible-roots (characterisation): every `ϖ^{1/pⁿ}` is a
pseudo-uniformizer lying in `R°`. -/
theorem isPseudoUniformizer_root (n : ℕ) :
    IsPseudoUniformizer (ϖ.root n) ∧ ϖ.root n ∈ powerBoundedSubring R := sorry

/-- P1/pseudouniformizer-with-compatible-roots (data): `ϖ^{1/pⁿ}` as an element of `R°`. -/
def rootPB (n : ℕ) : powerBoundedSubring R := ⟨ϖ.root n, (ϖ.isPseudoUniformizer_root n).2⟩

/-- P1/pseudouniformizer-with-compatible-roots (data): `ϖ ^ (m / pⁿ)` for `m / pⁿ ∈ ℤ[1/p]`, as a
unit of `R`: `(ϖ^{1/pⁿ}) ^ m`. It depends only on `m / pⁿ` (`zpow_mul_p`); `zpow m n ∈ R°` for
`m ≥ 0`. -/
def zpow (m : ℤ) (n : ℕ) : Rˣ := ((ϖ.isPseudoUniformizer_root n).1.1.unit) ^ m

/-- P1/pseudouniformizer-with-compatible-roots: `ϖ ^ (m / pⁿ)` depends only on `m / pⁿ`. -/
theorem zpow_mul_p (m : ℤ) (n : ℕ) : ϖ.zpow (m * p) (n + 1) = ϖ.zpow m n := sorry

/-- P1/pseudouniformizer-with-compatible-roots: `ϖ ^ (a + b) = ϖ ^ a ϖ ^ b`. -/
theorem zpow_add (m m' : ℤ) (n : ℕ) : ϖ.zpow (m + m') n = ϖ.zpow m n * ϖ.zpow m' n := sorry

/-- P1/pseudouniformizer-with-compatible-roots: `ϖ ^ (m / 1) = ϖ ^ m`. -/
theorem zpow_natCast (m : ℕ) : (ϖ.zpow m 0 : R) = ϖ.root 0 ^ m := sorry

/-- P1/pseudouniformizer-with-compatible-roots: `ϖ ^ q ∈ R°` for `q ≥ 0`. -/
theorem zpow_mem_powerBoundedSubring (m : ℕ) (n : ℕ) :
    (ϖ.zpow m n : R) ∈ powerBoundedSubring R := sorry

/-- P1/pseudouniformizer-with-compatible-roots (data): the spectral gauge
`|x|_ϖ = inf {2^{-q} : q ∈ ℤ[1/p], ϖ^{-q} x ∈ R°}` (normalised by `|ϖ|_ϖ = 1/2`), with
`q = m / pⁿ`. -/
def gauge (x : R) : NNReal :=
  sInf ((fun mn : ℤ × ℕ ↦ (2 : NNReal) ^ (-(mn.1 : ℝ) / (p : ℝ) ^ mn.2)) ''
    {mn | ((ϖ.zpow (-mn.1) mn.2 : Rˣ) : R) * x ∈ powerBoundedSubring R})

end PseudoUniformizerRoots

end Roots

section RootsPerfectoid

variable {p : ℕ} [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]

namespace PseudoUniformizerRoots

variable (ϖ : PseudoUniformizerRoots p R)

/-- P1/pseudouniformizer-with-compatible-roots (structure): for `R` complete Hausdorff and
uniform (in particular perfectoid), `|·|_ϖ` is a submultiplicative ultrametric norm:
`|xy| ≤ |x||y|`, `|x + y| ≤ max |x| |y|` and `|x| = 0 ↔ x = 0`. -/
theorem gauge_mul_le (hb : IsBounded (powerBoundedSubring R : Set R)) :
    (∀ x y, ϖ.gauge (x * y) ≤ ϖ.gauge x * ϖ.gauge y) ∧
      (∀ x y, ϖ.gauge (x + y) ≤ max (ϖ.gauge x) (ϖ.gauge y)) ∧
      ∀ x, ϖ.gauge x = 0 ↔ x = 0 := sorry

/-- P1/pseudouniformizer-with-compatible-roots (characterisation): the gauge is
power-multiplicative, `|xⁿ| = |x|ⁿ` (`R°` is integrally closed in `R`). -/
theorem gauge_pow (x : R) (n : ℕ) : ϖ.gauge (x ^ n) = ϖ.gauge x ^ n := sorry

/-- P1/pseudouniformizer-with-compatible-roots (simp): `|ϖ^q x| = 2^{-q} |x|`. -/
@[simp] theorem gauge_zpow_mul (m : ℤ) (n : ℕ) (x : R) :
    ϖ.gauge ((ϖ.zpow m n : R) * x) = (2 : NNReal) ^ (-(m : ℝ) / (p : ℝ) ^ n) * ϖ.gauge x :=
  sorry

/-- P1/pseudouniformizer-with-compatible-roots (characterisation): `R° = {|x| ≤ 1}` and
`R°° = {|x| < 1}`. -/
theorem mem_powerBoundedSubring_iff_gauge_le_one (x : R) :
    (x ∈ powerBoundedSubring R ↔ ϖ.gauge x ≤ 1) ∧
      (IsTopologicallyNilpotent x ↔ ϖ.gauge x < 1) := sorry

/-- P1/pseudouniformizer-with-compatible-roots (other): the sets `ϖ^q R°`, `q ∈ ℤ[1/p]`, form a
basis of neighbourhoods of `0`, so the gauge defines the topology of `R`. -/
theorem hasBasis_nhds_zero (hb : IsBounded (powerBoundedSubring R : Set R)) :
    (𝓝 (0 : R)).HasBasis (fun _ : ℤ × ℕ ↦ True)
      fun mn ↦ ((ϖ.zpow mn.1 mn.2 : Rˣ) : R) • (powerBoundedSubring R : Set R) := sorry

/-- P1/pseudouniformizer-with-compatible-roots (constructor): every perfectoid Tate ring admits a
pseudo-uniformizer with compatible roots, starting from any `ϖ₁ ∈ R°` with `ϖ₁ ^ p ∣ p`: one whose
`ϖ` is a unit multiple of `ϖ₁` in `R°` (ECD Lemma 3.10,
P1/exists-pseudouniformizer-with-compatible-roots). -/
theorem «exists» [IsPerfectoidTateRing p R] (ϖ₁ : powerBoundedSubring R)
    (hϖ₁ : IsPseudoUniformizer (ϖ₁ : R)) (h : ϖ₁ ^ p ∣ (p : powerBoundedSubring R)) :
    ∃ ϖ : PseudoUniformizerRoots p R, ∃ v : (powerBoundedSubring R)ˣ,
      ϖ.rootPB 0 = ϖ₁ * v := sorry

/-- P1/pseudouniformizer-with-compatible-roots (instance): a perfectoid Tate ring has a
pseudo-uniformizer with compatible roots. -/
instance instNonempty [IsPerfectoidTateRing p R] : Nonempty (PseudoUniformizerRoots p R) :=
  sorry

end PseudoUniformizerRoots

end RootsPerfectoid

section RootsTests

variable (p : ℕ) [Fact p.Prime]

/- `ϖ♭ = (p^{1/pⁿ})ₙ`: `|x|_ϖ = 2^{-v_p(x)}` and `v_p(x) = -log_p ‖x‖`. -/
-- test Perfectoid.PseudoUniformizerRoots.gauge_padicComplex (computation)
--   [P1/pseudouniformizer-with-compatible-roots]
example (ϖ : PseudoUniformizerRoots p ℂ_[p]) (hϖ : ϖ.root 0 = p) (x : ℂ_[p]) (hx : x ≠ 0) :
    (ϖ.gauge x : ℝ) = 2 ^ Real.logb p ‖x‖ := sorry

/- A pseudo-uniformizer of `ℚ_p` has valuation `k ≥ 1`, not divisible by every `pⁿ`. -/
-- test Perfectoid.PseudoUniformizerRoots.isEmpty_padic (non-example)
--   [P1/pseudouniformizer-with-compatible-roots]
example : IsEmpty (PseudoUniformizerRoots p ℚ_[p]) := sorry

-- test Perfectoid.PseudoUniformizerRoots.subsingleton_of_charP (degenerate)
--   [P1/pseudouniformizer-with-compatible-roots]
example (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [CharP R p] [IsPerfectoidTateRing p R] (x : R) :
    Subsingleton {ϖ : PseudoUniformizerRoots p R // ϖ.root 0 = x} := sorry

-- test Perfectoid.PseudoUniformizerRoots.iUnion_zpow_eq (characterisation)
--   [P1/pseudouniformizer-with-compatible-roots]
example (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
    (ϖ : PseudoUniformizerRoots p R) :
    ⋃ (m : ℕ) (n : ℕ) (_ : 0 < m), ((ϖ.zpow m n : Rˣ) : R) • (powerBoundedSubring R : Set R) =
      {x : R | IsTopologicallyNilpotent x} := sorry

end RootsTests

/-! ## PerfectoidSpaces:P1/exists-pseudouniformizer-with-compatible-roots (lemma) -/

section ExistsRoots

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P1/exists-pseudouniformizer-with-compatible-roots (ECD Lemma 3.10): for `ϖ₁ ∈ R°` a
pseudo-uniformizer with `ϖ₁ ^ p ∣ p`, there is `ϖ♭ ∈ lim_{x ↦ x^p} R°` with
`ϖ = ϖ♭⁽⁰⁾ ≡ ϖ₁ mod ϖ₁ ^ p R°`; then `ϖ R° = ϖ₁ R°` and `ϖ♭` has compatible roots. -/
theorem PseudoUniformizerRoots.exists_root_zero_sub_mem (ϖ₁ : powerBoundedSubring R)
    (hϖ₁ : IsPseudoUniformizer (ϖ₁ : R)) (h : ϖ₁ ^ p ∣ (p : powerBoundedSubring R)) :
    ∃ ϖ : PseudoUniformizerRoots p R, ϖ.rootPB 0 - ϖ₁ ∈ Ideal.span {ϖ₁ ^ p} ∧
      Ideal.span {ϖ.rootPB 0} = Ideal.span {ϖ₁} := sorry

/-- P1/exists-pseudouniformizer-with-compatible-roots: in characteristic `p` every
pseudo-uniformizer has unique compatible roots (`R` is perfect). -/
theorem PseudoUniformizerRoots.existsUnique_of_charP [CharP R p] (ϖ₁ : R)
    (hϖ₁ : IsPseudoUniformizer ϖ₁) (h₁ : ϖ₁ ∈ powerBoundedSubring R) :
    ∃! ϖ : Perfection R p, Perfection.coeffMonoidHom R p 0 ϖ = ϖ₁ := sorry

end ExistsRoots

/-! ## PerfectoidSpaces:P1/frobenius-surjective-on-plus-ring (lemma) -/

section PlusRing

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P1/frobenius-surjective-on-plus-ring (b): every ring of integral elements `R⁺` of a
perfectoid Tate ring contains a pseudo-uniformizer `ϖ` with `ϖ ^ p ∣ p` in `R⁺` and `p / ϖ ^ p`
topologically nilpotent. -/
theorem IsPerfectoidTateRing.exists_pseudoUniformizer_plus (P : Pair R) :
    ∃ (ϖ : P.plus) (c : P.plus), IsPseudoUniformizer (ϖ : R) ∧ (p : P.plus) = ϖ ^ p * c ∧
      IsTopologicallyNilpotent (c : R) := sorry

/-- P1/frobenius-surjective-on-plus-ring (b), (c): `Φ : R⁺/ϖ → R⁺/ϖ^p` is bijective for every
pseudo-uniformizer `ϖ ∈ R⁺` with `ϖ ^ p ∣ p` in `R⁺`, so `(R, R⁺)` satisfies ECD Definition 3.1
with `R⁺` in place of `R°` (the form of AWS Definition 2.1.1 and KL II Definition 3.3.1). -/
theorem IsPerfectoidTateRing.frobeniusModPow_bijective_plus (P : Pair R) (ϖ : P.plus)
    (hϖ : IsPseudoUniformizer (ϖ : R)) (h : ϖ ^ p ∣ (p : P.plus)) :
    Function.Bijective (frobeniusModPow p ϖ h) := sorry

/-- P1/frobenius-surjective-on-plus-ring (a): every element of `R⁺ ⧸ ϖp` is a `p`-th power. -/
theorem IsPerfectoidTateRing.exists_pow_sub_mem_plus (P : Pair R) (ϖ : P.plus)
    (hϖ : IsPseudoUniformizer (ϖ : R)) (h : ϖ ^ p ∣ (p : P.plus)) (y : P.plus) :
    ∃ x : P.plus, y - x ^ p ∈ Ideal.span {ϖ * p} := sorry

end PlusRing

/-! ## PerfectoidSpaces:P1/metric-perfectoid-criterion (lemma) -/

section MetricCriterion

variable (p : ℕ) [Fact p.Prime] {B : Type*} [CommRing B] [UniformSpace B] [IsUniformAddGroup B]
  [IsTopologicalRing B] [IsTateRing B] [CompleteSpace B] [T2Space B]

/-- P1/metric-perfectoid-criterion (a): on a complete Hausdorff uniform Tate ring with a
pseudo-uniformizer `ϖ` with compatible roots and `ϖ ^ p ∣ p`, the spectral gauge is a
power-multiplicative ultrametric norm with `B° = {|x| ≤ 1}` (AWS Lemma 2.8.3). -/
theorem PseudoUniformizerRoots.gauge_isPowMul (hb : IsBounded (powerBoundedSubring B : Set B))
    (ϖ : PseudoUniformizerRoots p B) :
    (∀ x : B, ∀ n : ℕ, ϖ.gauge (x ^ n) = ϖ.gauge x ^ n) ∧
      (∀ x y : B, ϖ.gauge (x + y) ≤ max (ϖ.gauge x) (ϖ.gauge y)) ∧
      (∀ x : B, ϖ.gauge x = 0 ↔ x = 0) ∧
      ∀ x : B, x ∈ powerBoundedSubring B ↔ ϖ.gauge x ≤ 1 := sorry

/-- P1/metric-perfectoid-criterion (b): `B` is perfectoid iff some `c ∈ (0, 1)` has: every `x`
is within `c |x|` of a `p`-th power (AWS Lemma 2.8.3; KL I Proposition 3.6.2(c)). -/
theorem isPerfectoidTateRing_iff_exists_pow_approx
    (hb : IsBounded (powerBoundedSubring B : Set B)) (ϖ : PseudoUniformizerRoots p B) :
    IsPerfectoidTateRing p B ↔ ∃ c : NNReal, 0 < c ∧ c < 1 ∧
      ∀ x : B, ∃ y : B, ϖ.gauge (x - y ^ p) ≤ c * ϖ.gauge x := sorry

/-- P1/metric-perfectoid-criterion (c): if `B` is perfectoid, every `c ∈ (2^{-p}, 1)` works, and
`y` can be taken in `B°` when `x ∈ B°`. -/
theorem IsPerfectoidTateRing.exists_pow_approx [IsPerfectoidTateRing p B]
    (ϖ : PseudoUniformizerRoots p B) (c : NNReal) (hc : (2 : NNReal) ^ (-(p : ℝ)) < c)
    (hc1 : c < 1) (x : B) :
    ∃ y : B, ϖ.gauge (x - y ^ p) ≤ c * ϖ.gauge x ∧
      (x ∈ powerBoundedSubring B → y ∈ powerBoundedSubring B) := sorry

end MetricCriterion

/-! ## PerfectoidSpaces:P1/tilt-of-perfectoid-tate-ring (construction) -/

section TiltDef

variable (p : ℕ) [Fact p.Prime] (R : Type*) [CommRing R]

/-- P1/tilt-of-perfectoid-tate-ring (data): the tilt `R♭ = lim_{x ↦ x^p} R` (ECD Definition
3.9), a type synonym of Mathlib's monoid `Perfection R p` of sequences `(x⁽ⁿ⁾)ₙ` with
`(x⁽ⁿ⁺¹⁾) ^ p = x⁽ⁿ⁾`. For `R` perfectoid it carries the ring structure with pointwise
multiplication and `(x + y)⁽ⁱ⁾ = lim_n (x⁽ⁱ⁺ⁿ⁾ + y⁽ⁱ⁺ⁿ⁾) ^ pⁿ` (ECD Lemma 3.10, AWS Lemma 2.7.1),
and the inverse-limit topology. -/
def tilt : Type _ := Perfection R p

namespace tilt

/-- P1/tilt-of-perfectoid-tate-ring (instance): the inverse-limit uniformity of `R♭`, induced
from `ℕ → R`. -/
instance instUniformSpace [UniformSpace R] : UniformSpace (tilt p R) :=
  inferInstanceAs (UniformSpace {f : ℕ → R // ∀ n, f (n + 1) ^ p = f n})

/-- P1/tilt-of-perfectoid-tate-ring (instance): `R♭` is Hausdorff (a subspace of `ℕ → R`). -/
instance instT2Space [UniformSpace R] [T2Space R] : T2Space (tilt p R) :=
  inferInstanceAs (T2Space {f : ℕ → R // ∀ n, f (n + 1) ^ p = f n})

variable [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R]
  [CompleteSpace R] [T2Space R]

/-- P1/tilt-of-perfectoid-tate-ring (instance): the ring structure of `R♭`: the multiplication
of `Perfection R p` (`tilt.coeff_mul`) and the limit addition (`tilt.coeff_add`); it does not
depend on choices (ECD Lemma 3.10). -/
instance instCommRing [IsPerfectoidTateRing p R] : CommRing (tilt p R) := sorry

/-- P1/tilt-of-perfectoid-tate-ring (instance): the inverse-limit uniformity is that of the
additive group of `R♭`. -/
instance instIsUniformAddGroup [IsPerfectoidTateRing p R] : IsUniformAddGroup (tilt p R) := sorry

/-- P1/tilt-of-perfectoid-tate-ring (instance): `R♭` is a topological ring. -/
instance instIsTopologicalRing [IsPerfectoidTateRing p R] : IsTopologicalRing (tilt p R) := sorry

/-- P1/tilt-of-perfectoid-tate-ring (instance): `R♭` has characteristic `p`. -/
instance charP [IsPerfectoidTateRing p R] : CharP (tilt p R) p := sorry

/-- P1/tilt-of-perfectoid-tate-ring (instance): `R♭` is perfect. -/
instance perfectRing [IsPerfectoidTateRing p R] : PerfectRing (tilt p R) p := sorry

/-- P1/tilt-of-perfectoid-tate-ring (instance): `R♭` is a Tate ring, with pseudo-uniformizer
`ϖ♭` for any `ϖ♭` with compatible roots (P1/tilt-integral-subrings). -/
instance instIsTateRing [IsPerfectoidTateRing p R] : IsTateRing (tilt p R) := sorry

/-- P1/tilt-of-perfectoid-tate-ring (instance): `R♭` is complete (a closed subspace of `ℕ → R`
for the limit addition, P1/tilt-is-perfectoid-tate-ring). -/
instance instCompleteSpace [IsPerfectoidTateRing p R] : CompleteSpace (tilt p R) := sorry

/-- P1/tilt-of-perfectoid-tate-ring (instance): `R♭` is a perfectoid Tate ring of characteristic
`p` (P1/tilt-is-perfectoid-tate-ring). -/
instance isPerfectoidTateRing [IsPerfectoidTateRing p R] : IsPerfectoidTateRing p (tilt p R) :=
  sorry

variable {p R} [IsPerfectoidTateRing p R]

/-- P1/tilt-of-perfectoid-tate-ring (projection): the `n`-th coordinate `x ↦ x⁽ⁿ⁾`, the monoid
homomorphism `Perfection.coeffMonoidHom R p n` of Mathlib. -/
def coeff (n : ℕ) : tilt p R →* R where
  toFun x := Perfection.coeffMonoidHom R p n x
  map_one' := sorry
  map_mul' := sorry

/-- P1/tilt-of-perfectoid-tate-ring (simp): `coeff (n + 1) x ^ p = coeff n x`. -/
@[simp] theorem coeff_pow (x : tilt p R) (n : ℕ) : coeff (n + 1) x ^ p = coeff n x := sorry

/-- P1/tilt-of-perfectoid-tate-ring (extensionality): an element of `R♭` is determined by its
coordinates. -/
theorem ext {x y : tilt p R} : x = y ↔ ∀ n, coeff n x = coeff n y := sorry

/-- P1/tilt-of-perfectoid-tate-ring (characterisation): the addition of `R♭` is the limit
`(x + y)⁽ⁱ⁾ = lim_m (x⁽ⁱ⁺ᵐ⁾ + y⁽ⁱ⁺ᵐ⁾) ^ pᵐ` (ECD Lemma 3.10). -/
theorem coeff_add (x y : tilt p R) (i : ℕ) :
    Tendsto (fun m : ℕ ↦ (coeff (i + m) x + coeff (i + m) y) ^ p ^ m) atTop
      (𝓝 (coeff i (x + y))) := sorry

/-- P1/tilt-of-perfectoid-tate-ring (simp): multiplication is coordinatewise: the monoid
structure of `R♭` is that of `Perfection R p`. -/
@[simp] theorem coeff_mul (x y : tilt p R) (n : ℕ) :
    coeff n (x * y) = coeff n x * coeff n y := sorry

/-- P1/tilt-of-perfectoid-tate-ring (simp): `coeff n 1 = 1`. -/
@[simp] theorem coeff_one (n : ℕ) : coeff n (1 : tilt p R) = 1 := sorry

/-- P1/tilt-of-perfectoid-tate-ring (simp): `coeff n 0 = 0`. -/
@[simp] theorem coeff_zero (n : ℕ) : coeff n (0 : tilt p R) = 0 := sorry

/-- P1/tilt-of-perfectoid-tate-ring (simp): the inverse Frobenius shifts the coordinates. -/
@[simp] theorem coeff_frobeniusEquiv_symm (x : tilt p R) (n : ℕ) :
    coeff n ((frobeniusEquiv (tilt p R) p).symm x) = coeff (n + 1) x := sorry

/-- P1/tilt-of-perfectoid-tate-ring (characterisation): `R♭° = lim_{x ↦ x^p} R° = {x : x⁽⁰⁾ ∈ R°}`
(ECD Lemma 3.10, P1/tilt-integral-subrings). -/
theorem mem_powerBoundedSubring_iff (x : tilt p R) :
    (x ∈ powerBoundedSubring (tilt p R) ↔ ∀ n, coeff n x ∈ powerBoundedSubring R) ∧
      (x ∈ powerBoundedSubring (tilt p R) ↔ coeff 0 x ∈ powerBoundedSubring R) := sorry

/-- P1/tilt-of-perfectoid-tate-ring (equivalence): in characteristic `p`, `x ↦ x⁽⁰⁾` is a ring
isomorphism `R♭ ≃+* R` (ECD Lemma 3.10). -/
def equivOfCharP [CharP R p] : tilt p R ≃+* R := sorry

/-- P1/tilt-of-perfectoid-tate-ring (simp): `equivOfCharP x = x⁽⁰⁾`. -/
@[simp] theorem equivOfCharP_apply [CharP R p] (x : tilt p R) : equivOfCharP x = coeff 0 x :=
  sorry

/-- P1/tilt-of-perfectoid-tate-ring (other): `equivOfCharP` is a homeomorphism. -/
theorem continuous_equivOfCharP [CharP R p] :
    Continuous (equivOfCharP : tilt p R ≃+* R) ∧
      Continuous (equivOfCharP : tilt p R ≃+* R).symm := sorry

/-- P1/tilt-of-perfectoid-tate-ring (compatibility): `R♭° ≃+* PreTilt R° p`,
`x ↦ (x⁽ⁿ⁾ mod p)ₙ`, the identification of the integral tilt with Mathlib's `PreTilt`
(P1/tilt-comparison-with-mathlib-pretilt). -/
def integralEquivPreTilt [Nontrivial R] :
    powerBoundedSubring (tilt p R) ≃+* PreTilt (powerBoundedSubring R) p := sorry

end tilt

variable {R} [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R]
  [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P1/pseudouniformizer-with-compatible-roots (projection): `ϖ♭` as an element of the ring
`R♭`; a pseudo-uniformizer of `R♭` with `ϖ♭♯ = ϖ` (P1/tilt-integral-subrings). -/
def PseudoUniformizerRoots.toTilt {p} [Fact p.Prime] (ϖ : PseudoUniformizerRoots p R) :
    tilt p R :=
  ϖ.roots

/-- P1/tilt-of-perfectoid-tate-ring (constructor): the tilt of a Huber pair `(R, R⁺)` with `R`
perfectoid: `(R♭, R♭⁺)` with `R♭⁺ = lim_{x ↦ x^p} R⁺ = {x : x⁽⁰⁾ ∈ R⁺}` (ECD Lemma 3.11,
P1/rings-of-integral-elements-under-tilting). -/
def Pair.tilt (P : Pair R) : Pair (Perfectoid.tilt p R) where
  plus :=
    { carrier := {x | Perfectoid.tilt.coeff 0 x ∈ P.plus}
      mul_mem' := sorry
      one_mem' := sorry
      add_mem' := sorry
      zero_mem' := sorry
      neg_mem' := sorry }
  isRingOfIntegralElements := sorry

/-- P1/rings-of-integral-elements-under-tilting (characterisation): `x ∈ R♭⁺ ↔ x⁽⁰⁾ ∈ R⁺`. -/
theorem Pair.mem_tilt_plus_iff (P : Pair R) (x : Perfectoid.tilt p R) :
    x ∈ (Pair.tilt p P).plus ↔ Perfectoid.tilt.coeff 0 x ∈ P.plus := sorry

end TiltDef

section TiltTests

variable (p : ℕ) [Fact p.Prime]

/- The completed perfection of `𝔽_p((t))` is the tilt of `ℚ_p^cycl` (P1/cyclotomic-perfectoid-field,
`t = ε - 1`), a perfectoid Tate ring of characteristic `p`. -/
-- test Perfectoid.tilt.equivOfCharP_laurent (compatibility) [P1/tilt-of-perfectoid-tate-ring]
example : (∀ x : tilt p (tilt p (padicCyclotomic p)), tilt.equivOfCharP x = tilt.coeff 0 x) ∧
    Continuous (tilt.equivOfCharP : tilt p (tilt p (padicCyclotomic p)) ≃+* _) ∧
    Continuous (tilt.equivOfCharP : tilt p (tilt p (padicCyclotomic p)) ≃+* _).symm := sorry

-- test Perfectoid.tilt.coeff_epsilon (computation) [P1/tilt-of-perfectoid-tate-ring]
example : ∃ ε : tilt p (padicCyclotomic p),
    (∀ n, IsPrimitiveRoot (tilt.coeff n ε) (p ^ n)) ∧ ε ≠ 1 := sorry

/- Coordinatewise subtraction is not the ring structure of the tilt. -/
-- test Perfectoid.tilt.coeff_zero_sub_ne (non-example) [P1/tilt-of-perfectoid-tate-ring]
example (ε : tilt p (padicCyclotomic p)) (hε : ∀ n, IsPrimitiveRoot (tilt.coeff n ε) (p ^ n)) :
    tilt.coeff 0 (ε - 1) ≠ tilt.coeff 0 ε - tilt.coeff 0 (1 : tilt p (padicCyclotomic p)) := sorry

-- test Perfectoid.tilt.nontrivial_iff (degenerate) [P1/tilt-of-perfectoid-tate-ring]
example (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] :
    Nontrivial (tilt p R) ↔ Nontrivial R := sorry

-- test Perfectoid.tilt.isPerfectoidTateRing_charP (characterisation)
--   [P1/tilt-of-perfectoid-tate-ring]
example (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] :
    IsPerfectoidTateRing p (tilt p R) ∧ CharP (tilt p R) p := sorry

end TiltTests

/-! ## PerfectoidSpaces:P1/tilt-integral-subrings (lemma) -/

section TiltIntegral

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P1/tilt-integral-subrings (b): `ϖ♭` is a pseudo-uniformizer of `R♭` lying in `R♭°`
(ECD Lemma 3.10). -/
theorem PseudoUniformizerRoots.isPseudoUniformizer_toTilt (ϖ : PseudoUniformizerRoots p R) :
    IsPseudoUniformizer ϖ.toTilt ∧ ϖ.toTilt ∈ powerBoundedSubring (tilt p R) := sorry

/-- P1/tilt-integral-subrings (data): `ϖ♭` as an element of `R♭°`. -/
def PseudoUniformizerRoots.toTiltPB (ϖ : PseudoUniformizerRoots p R) :
    powerBoundedSubring (tilt p R) :=
  ⟨ϖ.toTilt, (ϖ.isPseudoUniformizer_toTilt p).2⟩

/-- P1/tilt-integral-subrings (a): for a pseudo-uniformizer `ϖ₀ ∈ R°` dividing `p`, reduction
`x ↦ (x⁽ⁿ⁾ mod ϖ₀)ₙ` is a ring isomorphism `R♭° ≅ lim_Φ R°/ϖ₀` (ECD Lemma 3.10). -/
def tilt.powerBoundedEquivPerfectionQuot (ϖ₀ : powerBoundedSubring R)
    [CharP (powerBoundedSubring R ⧸ Ideal.span {ϖ₀}) p] (hϖ₀ : IsPseudoUniformizer (ϖ₀ : R))
    (hdvd : ϖ₀ ∣ (p : powerBoundedSubring R)) :
    powerBoundedSubring (tilt p R) ≃+* Perfection (powerBoundedSubring R ⧸ Ideal.span {ϖ₀}) p :=
  sorry

/-- P1/tilt-integral-subrings (b): `R♭ = R♭°[1/ϖ♭]`, and `R♭°` is open and bounded with the
`ϖ♭`-adic topology (ECD Lemma 3.10). -/
theorem tilt.isLocalization_toTiltPB (ϖ : PseudoUniformizerRoots p R) :
    @IsLocalization.Away _ _ (ϖ.toTiltPB p) (tilt p R) _
      (powerBoundedSubring (tilt p R)).subtype.toAlgebra ∧
      IsOpen (powerBoundedSubring (tilt p R) : Set (tilt p R)) ∧
      IsAdic (Ideal.span {ϖ.toTiltPB p}) := sorry

/-- P1/tilt-integral-subrings (d): the kernel of `R♭° → R°/ϖ`, `x ↦ x⁽⁰⁾ mod ϖ`, is `ϖ♭ R♭°`;
with `tilt.sharpQuotEquiv` this gives (c) `R♭°/ϖ♭ ≅ R°/ϖ` (the same holds for `ϖ^q`,
`0 < q ≤ p`, ECD Lemma 3.10). -/
theorem tilt.coeff_zero_mem_span_iff (ϖ : PseudoUniformizerRoots p R)
    (x : powerBoundedSubring (tilt p R)) :
    (⟨tilt.coeff 0 (x : tilt p R), ((tilt.mem_powerBoundedSubring_iff _).2.mp x.2)⟩ :
        powerBoundedSubring R) ∈ Ideal.span {ϖ.rootPB 0} ↔
      x ∈ Ideal.span {ϖ.toTiltPB p} := sorry

end TiltIntegral

/-! ## PerfectoidSpaces:P1/tilt-is-perfectoid-tate-ring (lemma) -/

section TiltPerfectoid

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P1/tilt-is-perfectoid-tate-ring: `R♭` is a complete Hausdorff uniform perfect Tate ring of
characteristic `p` with pair of definition `(R♭°, ϖ♭ R♭°)`, hence perfectoid (ECD Lemma 3.10, "a
perfectoid `𝔽_p`-algebra"). -/
theorem tilt.isBounded_powerBoundedSubring (ϖ : PseudoUniformizerRoots p R) :
    IsBounded (powerBoundedSubring (tilt p R) : Set (tilt p R)) ∧
      ∃ P : PairOfDefinition (tilt p R),
        P.ringOfDefinition = powerBoundedSubring (tilt p R) ∧
        ∃ h : ϖ.toTilt ∈ P.ringOfDefinition,
          P.idealOfDefinition = Ideal.span {⟨ϖ.toTilt, h⟩} := sorry

/-- P1/tilt-is-perfectoid-tate-ring: `R♭ ≠ 0 ↔ R ≠ 0`. -/
theorem tilt.nontrivial_iff_nontrivial : Nontrivial (tilt p R) ↔ Nontrivial R := sorry

end TiltPerfectoid

/-! ## PerfectoidSpaces:P1/sharp-map (construction) -/

section Sharp

variable {p : ℕ} [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

namespace tilt

/-- P1/sharp-map (data): the sharp map `♯ : R♭ → R`, `x ↦ x⁽⁰⁾` (Mathlib
`Perfection.coeffMonoidHom R p 0`): continuous and multiplicative, not additive. -/
def sharp : tilt p R →* R := coeff 0

/-- P1/sharp-map (data): the sharp map as a monoid-with-zero homomorphism (`0♯ = 0`). -/
def sharp₀ : tilt p R →*₀ R where
  toFun := sharp
  map_zero' := sorry
  map_one' := sorry
  map_mul' := sorry

/-- P1/sharp-map (structure): `♯` is continuous. -/
theorem continuous_sharp : Continuous (sharp : tilt p R → R) := sorry

/-- P1/sharp-map (simp): `((x^{1/pⁿ})♯) ^ pⁿ = x♯` (as Mathlib's
`PreTilt.untilt_iterate_frobeniusEquiv_symm_pow`); indeed `(x^{1/pⁿ})♯ = x⁽ⁿ⁾`. -/
@[simp] theorem sharp_iterate_frobeniusEquiv_symm_pow (x : tilt p R) (n : ℕ) :
    sharp (((frobeniusEquiv (tilt p R) p).symm)^[n] x) ^ p ^ n = sharp x := sorry

/-- P1/sharp-map (characterisation): `x ∈ R♭° ↔ x♯ ∈ R°`. -/
theorem mem_powerBoundedSubring_iff_sharp (x : tilt p R) :
    x ∈ powerBoundedSubring (tilt p R) ↔ sharp x ∈ powerBoundedSubring R := sorry

/-- P1/sharp-map (characterisation): `x♯ = 0 ↔ x = 0`. -/
theorem sharp_eq_zero_iff (x : tilt p R) : sharp x = 0 ↔ x = 0 := sorry

/-- P1/sharp-map (relation): for `x, y ∈ R♭°`, `(x + y)♯ ≡ x♯ + y♯ mod p R°`. -/
theorem sharp_add_sub_mem {x y : tilt p R} (hx : x ∈ powerBoundedSubring (tilt p R))
    (hy : y ∈ powerBoundedSubring (tilt p R)) :
    sharp (x + y) - sharp x - sharp y ∈ (p : R) • (powerBoundedSubring R : Set R) := sorry

/-- P1/sharp-map (other): every element of `R°` is congruent mod `p R°` to some `y♯`,
`y ∈ R♭°`. -/
theorem exists_sharp_sub_mem {x : R} (hx : x ∈ powerBoundedSubring R) :
    ∃ y ∈ powerBoundedSubring (tilt p R), x - sharp y ∈ (p : R) • (powerBoundedSubring R : Set R) :=
  sorry

/-- P1/sharp-map (equivalence): reduction of `♯` modulo `ϖ` is a ring isomorphism
`R♭° ⧸ ϖ♭ ≃+* R° ⧸ ϖ` (ECD Lemma 3.10, P1/tilt-integral-subrings (c)). -/
def sharpQuotEquiv (ϖ : PseudoUniformizerRoots p R) :
    powerBoundedSubring (tilt p R) ⧸ Ideal.span {ϖ.toTiltPB p} ≃+*
      powerBoundedSubring R ⧸ Ideal.span {ϖ.rootPB 0} := sorry

/-- P1/sharp-map (characterisation): `sharpQuotEquiv` is induced by `♯`. -/
theorem sharpQuotEquiv_mk (ϖ : PseudoUniformizerRoots p R) (x : powerBoundedSubring (tilt p R)) :
    sharpQuotEquiv ϖ (Ideal.Quotient.mk _ x) =
      Ideal.Quotient.mk _ ⟨sharp (x : tilt p R), (mem_powerBoundedSubring_iff_sharp _).mp x.2⟩ :=
  sorry

/-- P1/sharp-map (simp): `ϖ♭♯ = ϖ`. -/
@[simp] theorem sharp_toTilt (ϖ : PseudoUniformizerRoots p R) : sharp ϖ.toTilt = ϖ.root 0 :=
  sorry

/-- P1/sharp-map (compatibility): under `R♭° ≃+* PreTilt R° p`, `♯` is Mathlib's
`PreTilt.untilt` (P1/tilt-comparison-with-mathlib-pretilt). -/
theorem sharp_eq_untilt [Nontrivial R] (x : powerBoundedSubring (tilt p R)) :
    sharp (x : tilt p R) =
      ((PreTilt.untilt (integralEquivPreTilt x) : powerBoundedSubring R) : R) := sorry

end tilt

/-- P1/spectral-norm-under-sharp (data): the pseudo-uniformizer `ϖ♭` of `R♭` with its compatible
roots `(ϖ♭^{1/pⁿ})ₙ`, `ϖ♭^{1/pⁿ} = φ⁻ⁿ(ϖ♭)`, used for the gauge `|·|_{ϖ♭}` of `R♭`. -/
def PseudoUniformizerRoots.tiltRoots (ϖ : PseudoUniformizerRoots p R) :
    PseudoUniformizerRoots p (tilt p R) where
  roots := ⟨fun n ↦ ((frobeniusEquiv (tilt p R) p).symm)^[n] ϖ.toTilt, sorry⟩
  mem_powerBoundedSubring := sorry
  isPseudoUniformizer := sorry
  pow_dvd_p := sorry

/-- P1/sharp-map (compatibility): `|x♯|_ϖ = |x|_{ϖ♭}` (P1/spectral-norm-under-sharp). -/
theorem tilt.gauge_sharp (ϖ : PseudoUniformizerRoots p R) (x : tilt p R) :
    ϖ.gauge (tilt.sharp x) = ϖ.tiltRoots.gauge x := sorry

end Sharp

section SharpTests

variable (p : ℕ) [Fact p.Prime]

/- `sharp (ε - 1) ≠ sharp ε - sharp 1 = 0` in `tilt ℚ_p^cycl`: `♯` is not additive. -/
-- test Perfectoid.tilt.sharp_sub_ne (non-example) [P1/sharp-map]
example (ε : tilt p (padicCyclotomic p)) (hε : ∀ n, IsPrimitiveRoot (tilt.coeff n ε) (p ^ n)) :
    tilt.sharp (ε - 1) ≠ tilt.sharp ε - tilt.sharp (1 : tilt p (padicCyclotomic p)) := sorry

-- test Perfectoid.tilt.sharp_epsilon (computation) [P1/sharp-map]
example (ε : tilt p (padicCyclotomic p)) (hε : ∀ n, IsPrimitiveRoot (tilt.coeff n ε) (p ^ n))
    (pflat : tilt p ℂ_[p]) (hpflat : tilt.coeff 1 pflat ^ p = p) (h0 : tilt.coeff 0 pflat = p) :
    tilt.sharp ε = 1 ∧ tilt.sharp pflat = p := sorry

-- test Perfectoid.tilt.sharp_ringEquiv_of_charP (degenerate) [P1/sharp-map]
example (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CharP R p]
    (x y : tilt p R) :
    tilt.sharp (x + y) = tilt.sharp x + tilt.sharp y ∧ tilt.sharp x = tilt.equivOfCharP x := sorry

/- `ℂ_p × ℂ_p♭` is a perfectoid Tate ring in which `p` is a nonzero nonunit. -/
-- test Perfectoid.tilt.sharp_eq_zero_iff_test (characterisation) [P1/sharp-map]
example (x : tilt p (ℂ_[p] × tilt p ℂ_[p])) : tilt.sharp x = 0 ↔ x = 0 := sorry

end SharpTests

/-! ## PerfectoidSpaces:P1/spectral-norm-under-sharp (lemma) -/

/-- P1/spectral-norm-under-sharp (Sch12 Lemma 5.21 over a perfectoid base; the norm KL put on the
tilt): the spectral gauge of `R♭` for `ϖ♭` is the pullback of that of `R` along `♯`, both
normalised by `|ϖ| = |ϖ♭| = 1/2`. -/
theorem tilt.gauge_comp_sharp {p : ℕ} [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R]
    [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] (ϖ : PseudoUniformizerRoots p R) :
    ϖ.tiltRoots.gauge = (fun x ↦ ϖ.gauge (tilt.sharp x)) ∧ ϖ.gauge (ϖ.root 0) = 2⁻¹ ∧
      ϖ.tiltRoots.gauge ϖ.toTilt = 2⁻¹ := sorry

/-! ## PerfectoidSpaces:P1/tilt-functoriality (construction) -/

section Functoriality

variable (p : ℕ) [Fact p.Prime] {R S T : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S] [IsTateRing S]
  [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S]
  [CommRing T] [UniformSpace T] [IsUniformAddGroup T] [IsTopologicalRing T] [IsTateRing T]
  [CompleteSpace T] [T2Space T] [IsPerfectoidTateRing p T]

namespace tilt

/-- P1/tilt-functoriality (data): the tilt `f♭ : R♭ → S♭`, `(x⁽ⁿ⁾) ↦ (f(x⁽ⁿ⁾))`, of a continuous
ring homomorphism (Mathlib `Perfection.mapMonoidHom p f` on the underlying monoids); additivity
uses continuity of `f`. -/
def map (f : R →+* S) (hf : Continuous f) : tilt p R →+* tilt p S where
  toFun x := Perfection.mapMonoidHom p (f : R →* S) x
  map_one' := sorry
  map_mul' := sorry
  map_zero' := sorry
  map_add' := sorry

variable {p}

/-- P1/tilt-functoriality (simp): `(f♭ x)⁽ⁿ⁾ = f(x⁽ⁿ⁾)`. -/
@[simp] theorem coeff_map (f : R →+* S) (hf : Continuous f) (x : tilt p R) (n : ℕ) :
    coeff n (map p f hf x) = f (coeff n x) := sorry

/-- P1/tilt-functoriality (simp): `(f♭ x)♯ = f(x♯)`. -/
@[simp] theorem sharp_map (f : R →+* S) (hf : Continuous f) (x : tilt p R) :
    sharp (map p f hf x) = f (sharp x) := sorry

/-- P1/tilt-functoriality (functoriality): `id♭ = id`. -/
@[simp] theorem map_id : map p (RingHom.id R) continuous_id = RingHom.id (tilt p R) := sorry

/-- P1/tilt-functoriality (functoriality): `(g ∘ f)♭ = g♭ ∘ f♭`. -/
theorem map_comp (f : R →+* S) (hf : Continuous f) (g : S →+* T) (hg : Continuous g) :
    map p (g.comp f) (hg.comp hf) = (map p g hg).comp (map p f hf) := sorry

/-- P1/tilt-functoriality (structure): `f♭` is continuous. -/
theorem continuous_map (f : R →+* S) (hf : Continuous f) : Continuous (map p f hf) := sorry

/-- P1/tilt-functoriality (other): `f♭(R♭°) ⊆ S♭°`. -/
theorem map_mem_powerBoundedSubring (f : R →+* S) (hf : Continuous f) {x : tilt p R}
    (hx : x ∈ powerBoundedSubring (tilt p R)) :
    map p f hf x ∈ powerBoundedSubring (tilt p S) := sorry

variable (p)

/-- P1/tilt-functoriality (data): `f♭` restricted to `R♭° → S♭°`. -/
def mapPB (f : R →+* S) (hf : Continuous f) :
    powerBoundedSubring (tilt p R) →+* powerBoundedSubring (tilt p S) :=
  (map p f hf).restrict _ _ fun _ hx ↦ map_mem_powerBoundedSubring f hf hx

end tilt

/-- P1/tilt-functoriality (data): a continuous `f : R → S` restricted to `R° → S°` (`S` is
uniform, `map_mem_powerBoundedSubring`). -/
def powerBoundedMap (f : R →+* S) (hf : Continuous f) :
    powerBoundedSubring R →+* powerBoundedSubring S :=
  f.restrict _ _ fun _ hx ↦
    map_mem_powerBoundedSubring (IsPerfectoidTateRing.isBounded_powerBoundedSubring (p := p)) f hf
      hx

/-- P1/tilt-functoriality (data): the image `(f(ϖ^{1/pⁿ}))ₙ` of a pseudo-uniformizer with
compatible roots, again one (`f` continuous, `S` uniform). -/
def PseudoUniformizerRoots.map (f : R →+* S) (hf : Continuous f)
    (ϖ : PseudoUniformizerRoots p R) : PseudoUniformizerRoots p S where
  roots := Perfection.mapMonoidHom p (f : R →* S) ϖ.roots
  mem_powerBoundedSubring := sorry
  isPseudoUniformizer := sorry
  pow_dvd_p := sorry

/-- P1/tilt-functoriality (compatibility): on `R♭°/ϖ♭ ≅ R°/ϖ`, `f♭` induces the reduction of
`f`: the square `R♭°/ϖ♭ ≅ R°/ϖ → S°/f(ϖ) ≅ S♭°/f♭(ϖ♭)` commutes. -/
theorem tilt.mapQuot_comm (f : R →+* S) (hf : Continuous f) (ϖ : PseudoUniformizerRoots p R)
    (x : powerBoundedSubring (tilt p R)) (y : powerBoundedSubring R)
    (hxy : tilt.sharpQuotEquiv ϖ (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y) :
    tilt.sharpQuotEquiv (ϖ.map p f hf) (Ideal.Quotient.mk _ (tilt.mapPB p f hf x)) =
      Ideal.Quotient.mk _ (powerBoundedMap p f hf y) := sorry

/-- P1/tilt-functoriality (functoriality): a morphism of perfectoid Huber pairs induces a morphism
of the tilt pairs. -/
def Pair.tiltHom {P : Pair R} {Q : Pair S} (f : Pair.Hom P Q) :
    Pair.Hom (Pair.tilt p P) (Pair.tilt p Q) where
  toRingHom := tilt.map p f.toRingHom f.continuous_toRingHom
  continuous_toRingHom := tilt.continuous_map _ _
  map_mem_plus := sorry

/-- P1/tilt-functoriality (functoriality): `Pair.tiltHom` preserves identities. -/
theorem Pair.tiltHom_id (P : Pair R) : Pair.tiltHom p (Pair.Hom.id P) = Pair.Hom.id _ := sorry

/-- P1/tilt-functoriality (functoriality): `Pair.tiltHom` preserves composition. -/
theorem Pair.tiltHom_comp {P : Pair R} {Q : Pair S} {U : Pair T} (f : Pair.Hom P Q)
    (g : Pair.Hom Q U) : Pair.tiltHom p (g.comp f) = (Pair.tiltHom p g).comp (Pair.tiltHom p f) :=
  sorry

/-- P1/tilt-functoriality (equivalence): a ring isomorphism that is a homeomorphism induces
`R♭ ≃+* S♭`. -/
def tilt.mapEquiv (e : R ≃+* S) (he : Continuous e) (he' : Continuous e.symm) :
    tilt p R ≃+* tilt p S :=
  RingEquiv.ofRingHom (tilt.map p e he) (tilt.map p e.symm he') sorry sorry

/-- P1/tilt-functoriality (functoriality): the tilting functor on perfectoid Tate rings (with
continuous ring homomorphisms); its values have characteristic `p`. -/
def tiltFunctor : PerfectoidRingCat.{u} p ⥤ PerfectoidRingCat.{u} p where
  obj X := PerfectoidRingCat.of p (tilt p X)
  map f := ⟨tilt.map p f.hom f.continuous_hom, tilt.continuous_map _ _⟩
  map_id := sorry
  map_comp := sorry

/-- P1/tilt-functoriality (functoriality): the slice form `S ↦ S♭` from perfectoid `R`-algebras to
perfectoid `R♭`-algebras. -/
def tiltAlgebraFunctor (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] : PerfectoidAlgebra p R ⥤ PerfectoidAlgebra p (tilt p R) :=
  Under.post (tiltFunctor p)

end Functoriality

section FunctorialityTests

variable (p : ℕ) [Fact p.Prime]

-- test Perfectoid.tilt.map_id_test (degenerate) [P1/tilt-functoriality]
example : tilt.map p (RingHom.id ℂ_[p]) continuous_id = RingHom.id (tilt p ℂ_[p]) := sorry

-- test Perfectoid.tilt.map_inclusion_epsilon (computation) [P1/tilt-functoriality]
example (ε : tilt p (padicCyclotomic p)) (hε : ∀ n, IsPrimitiveRoot (tilt.coeff n ε) (p ^ n))
    (n : ℕ) :
    tilt.coeff n (tilt.map p (padicCyclotomic p).subtype continuous_subtype_val ε) =
      ((tilt.coeff n ε : padicCyclotomic p) : ℂ_[p]) ∧
      IsPrimitiveRoot (tilt.coeff n (tilt.map p (padicCyclotomic p).subtype
        continuous_subtype_val ε)) (p ^ n) := sorry

-- test Perfectoid.tilt.map_equivOfCharP (characterisation) [P1/tilt-functoriality]
example {R S : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CharP R p]
    [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S] [IsTateRing S]
    [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S] [CharP S p] (f : R →+* S)
    (hf : Continuous f) :
    (tilt.equivOfCharP : tilt p S ≃+* S).toRingHom.comp (tilt.map p f hf) =
      f.comp (tilt.equivOfCharP : tilt p R ≃+* R).toRingHom := sorry

-- test Perfectoid.Pair.tiltHom_plus (compatibility) [P1/tilt-functoriality]
example {R S : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
    [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S] [IsTateRing S]
    [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S] {P : Pair R} {Q : Pair S}
    (f : Pair.Hom P Q) (x : tilt p R) (hx : x ∈ (Pair.tilt p P).plus) :
    (Pair.tiltHom p f).toRingHom x ∈ (Pair.tilt p Q).plus := sorry

end FunctorialityTests

/-! ## PerfectoidSpaces:P1/tilt-of-uniform-tate-ring (construction) -/

section UniformTilt

variable (p : ℕ) [Fact p.Prime] (B : Type*) [CommRing B]

/-- P1/tilt-of-uniform-tate-ring (data): the tilt `B♭ = lim_{x ↦ x^p} B` (Mathlib
`Perfection B p`) of a complete Hausdorff uniform Tate ring in which `p` is topologically
nilpotent, not assumed perfectoid, with the limit addition (AWS Lemma 2.7.1). -/
def uniformTilt : Type _ := Perfection B p

namespace uniformTilt

/-- P1/tilt-of-uniform-tate-ring (instance): the inverse-limit uniformity. -/
instance instUniformSpace [UniformSpace B] : UniformSpace (uniformTilt p B) :=
  inferInstanceAs (UniformSpace {f : ℕ → B // ∀ n, f (n + 1) ^ p = f n})

/-- P1/tilt-of-uniform-tate-ring (instance): `B♭` is Hausdorff. -/
instance instT2Space [UniformSpace B] [T2Space B] : T2Space (uniformTilt p B) :=
  inferInstanceAs (T2Space {f : ℕ → B // ∀ n, f (n + 1) ^ p = f n})

variable [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B]
  [CompleteSpace B] [T2Space B]

/-- P1/tilt-of-uniform-tate-ring (instance): the ring structure with limit addition, for `B`
uniform with `p` topologically nilpotent (AWS Lemma 2.7.1 (a)). -/
instance instCommRing [Fact (IsBounded (powerBoundedSubring B : Set B))]
    [Fact (IsTopologicallyNilpotent (p : B))] : CommRing (uniformTilt p B) := sorry

variable [Fact (IsBounded (powerBoundedSubring B : Set B))]
  [Fact (IsTopologicallyNilpotent (p : B))]

/-- P1/tilt-of-uniform-tate-ring (instance): the uniformity is that of the additive group. -/
instance instIsUniformAddGroup : IsUniformAddGroup (uniformTilt p B) := sorry

/-- P1/tilt-of-uniform-tate-ring (instance): `B♭` is a topological ring. -/
instance instIsTopologicalRing : IsTopologicalRing (uniformTilt p B) := sorry

/-- P1/tilt-of-uniform-tate-ring (instance): `B♭` is nonarchimedean. -/
instance instNonarchimedeanRing : NonarchimedeanRing (uniformTilt p B) := sorry

/-- P1/tilt-of-uniform-tate-ring (instance): `B♭` has characteristic `p`. -/
instance charP : CharP (uniformTilt p B) p := sorry

/-- P1/tilt-of-uniform-tate-ring (instance): `B♭` is perfect. -/
instance perfectRing : PerfectRing (uniformTilt p B) p := sorry

/-- P1/tilt-of-uniform-tate-ring (instance): `B♭` is complete. -/
instance instCompleteSpace : CompleteSpace (uniformTilt p B) := sorry

variable {p B}

/-- P1/tilt-of-uniform-tate-ring (data): the `n`-th coordinate `B♭ →* B`. -/
def coeff (n : ℕ) : uniformTilt p B →* B where
  toFun x := Perfection.coeffMonoidHom B p n x
  map_one' := sorry
  map_mul' := sorry

/-- P1/tilt-of-uniform-tate-ring (projection): `♯ : B♭ →* B`, `x ↦ x⁽⁰⁾`, continuous, with
`((x^{1/pⁿ})♯) ^ pⁿ = x♯`. -/
def sharp : uniformTilt p B →* B := coeff 0

/-- P1/tilt-of-uniform-tate-ring (projection): `♯` is continuous and
`((x^{1/pⁿ})♯) ^ pⁿ = x♯`. -/
theorem sharp_spec :
    Continuous (sharp : uniformTilt p B → B) ∧ ∀ (x : uniformTilt p B) (n : ℕ),
      sharp (((frobeniusEquiv (uniformTilt p B) p).symm)^[n] x) ^ p ^ n = sharp x := sorry

/-- P1/tilt-of-uniform-tate-ring (characterisation): the limit formula for the addition. -/
theorem coeff_add (x y : uniformTilt p B) (i : ℕ) :
    Tendsto (fun n : ℕ ↦ (coeff (i + n) x + coeff (i + n) y) ^ p ^ n) atTop
      (𝓝 (coeff i (x + y))) := sorry

variable (p) in
/-- P1/tilt-of-uniform-tate-ring (data): `B♭⁺ = lim_{x ↦ x^p} B⁺ = {x : x♯ ∈ B⁺}`, an open
subring. -/
def plus (P : Pair B) : Subring (uniformTilt p B) where
  carrier := {x | sharp x ∈ P.plus}
  mul_mem' := sorry
  one_mem' := sorry
  add_mem' := sorry
  zero_mem' := sorry
  neg_mem' := sorry

/-- P1/tilt-of-uniform-tate-ring (equivalence): `B♭⁺ ≃+* PreTilt B⁺ p`, `x ↦ (x⁽ⁿ⁾ mod p)ₙ`
(AWS Lemma 2.7.1 (b)). -/
def plusEquiv (P : Pair B) [Fact (¬ IsUnit (p : P.plus))] : plus p P ≃+* PreTilt P.plus p :=
  sorry

/-- P1/tilt-of-uniform-tate-ring (equivalence): for an ideal of definition `I ⊆ B⁺` with
`p ∈ I`, reduction is an isomorphism `B♭⁺ ≃+* lim_Φ B⁺/I` (Mathlib
`Perfection.quotientMulEquiv` on monoids), a homeomorphism for discrete factors. -/
def plusEquivQuot (P : Pair B) (I : Ideal P.plus) [CharP (P.plus ⧸ I) p] (hpI : (p : P.plus) ∈ I)
    (hI : IsAdic I) : plus p P ≃+* Perfection (P.plus ⧸ I) p := sorry

/-- P1/tilt-of-uniform-tate-ring (characterisation): `x ∈ B♭° ↔ x♯ ∈ B°`, and likewise for
`B♭⁺`. -/
theorem mem_powerBoundedSubring_iff (x : uniformTilt p B) :
    x ∈ powerBoundedSubring (uniformTilt p B) ↔ sharp x ∈ powerBoundedSubring B := sorry

variable (p) in
/-- P1/tilt-of-uniform-tate-ring (functoriality): the tilt `g♭` of a continuous ring
homomorphism, continuous, with `(g♭ x)♯ = g(x♯)`, functorially (AWS Lemma 2.7.1 (d)). -/
def map {C : Type*} [CommRing C] [UniformSpace C] [IsUniformAddGroup C] [IsTopologicalRing C]
    [IsTateRing C] [CompleteSpace C] [T2Space C] [Fact (IsBounded (powerBoundedSubring C : Set C))]
    [Fact (IsTopologicallyNilpotent (p : C))] (g : B →+* C) (hg : Continuous g) :
    uniformTilt p B →+* uniformTilt p C where
  toFun x := Perfection.mapMonoidHom p (g : B →* C) x
  map_one' := sorry
  map_mul' := sorry
  map_zero' := sorry
  map_add' := sorry

/-- P1/tilt-of-uniform-tate-ring (functoriality): `g♭` is continuous and `(g♭ x)♯ = g(x♯)`. -/
theorem map_spec {C : Type*} [CommRing C] [UniformSpace C] [IsUniformAddGroup C]
    [IsTopologicalRing C] [IsTateRing C] [CompleteSpace C] [T2Space C]
    [Fact (IsBounded (powerBoundedSubring C : Set C))] [Fact (IsTopologicallyNilpotent (p : C))]
    (g : B →+* C) (hg : Continuous g) :
    Continuous (map p g hg) ∧ ∀ x, sharp (map p g hg x) = g (sharp x) := sorry

/-- P1/tilt-of-uniform-tate-ring (instance): if some `ϖ♭ ∈ B♭` has `ϖ♭♯` a pseudo-uniformizer
of `B` in `B°` with `(ϖ♭♯) ^ p ∣ p` in `B°`, then `B♭` is a uniform Tate ring and perfectoid, and
`|x|_{ϖ♭} = |x♯|_{ϖ♭♯}` (AWS Lemma 2.7.1 (c)). -/
theorem isTateRing_of_sharp (ϖ : uniformTilt p B) (hϖ : IsPseudoUniformizer (sharp ϖ))
    (hmem : sharp ϖ ∈ powerBoundedSubring B)
    (hdvd : (⟨sharp ϖ, hmem⟩ : powerBoundedSubring B) ^ p ∣ (p : powerBoundedSubring B)) :
    ∃ _ : IsTateRing (uniformTilt p B),
      IsBounded (powerBoundedSubring (uniformTilt p B) : Set (uniformTilt p B)) ∧
      IsPerfectoidTateRing p (uniformTilt p B) := sorry

/-- P1/tilt-of-uniform-tate-ring (other): under the hypotheses of `isTateRing_of_sharp`, the
closure of the range of a ring homomorphism from a perfect ring whose range contains `ϖ♭` and
`ϖ♭⁻¹` is a perfectoid Tate ring of characteristic `p`. -/
theorem isPerfectoidTateRing_closure (ϖ : uniformTilt p B) (hϖ : IsPseudoUniformizer (sharp ϖ))
    (hmem : sharp ϖ ∈ powerBoundedSubring B)
    (hdvd : (⟨sharp ϖ, hmem⟩ : powerBoundedSubring B) ^ p ∣ (p : powerBoundedSubring B))
    {T : Type*} [CommRing T] [CharP T p] [PerfectRing T p] (g : T →+* uniformTilt p B)
    (hg : ϖ ∈ g.range) (hg' : ∃ y ∈ g.range, ϖ * y = 1) :
    ∃ (_ : IsUniformAddGroup g.range.topologicalClosure) (_ : IsTateRing g.range.topologicalClosure)
      (_ : CompleteSpace g.range.topologicalClosure),
      IsPerfectoidTateRing p g.range.topologicalClosure := sorry

/-- P1/tilt-of-uniform-tate-ring (compatibility): `θ_B : W(B♭⁺) →+* B⁺`, Mathlib's
`WittVector.fontaineTheta B⁺ p` transported along `plusEquiv`; `θ_B [x] = x♯` (AWS Lemma 2.7.1
(e)). -/
def theta (P : Pair B) [Fact (¬ IsUnit (p : P.plus))]
    [IsAdicComplete (Ideal.span {(p : P.plus)}) P.plus] :
    WittVector p (plus p P) →+* P.plus :=
  (WittVector.fontaineTheta P.plus p).comp (WittVector.map (plusEquiv P).toRingHom)

/-- P1/tilt-of-uniform-tate-ring (compatibility): `θ_B [x] = x♯`, and `θ` is natural:
`θ_C ∘ W(g♭) = g ∘ θ_B` for a morphism of pairs. -/
theorem theta_teichmuller (P : Pair B) [Fact (¬ IsUnit (p : P.plus))]
    [IsAdicComplete (Ideal.span {(p : P.plus)}) P.plus] (x : plus p P) :
    ((theta P (WittVector.teichmuller p x) : P.plus) : B) = sharp (x : uniformTilt p B) := sorry

/-- P1/tilt-of-uniform-tate-ring (compatibility): for `B` perfectoid, `uniformTilt p B` and
`tilt p B` are the same ring structure on `Perfection B p`: the identity is a topological ring
isomorphism commuting with `♯` and with the maps (P1/tilt-of-perfectoid-tate-ring). -/
def equivTilt [IsPerfectoidTateRing p B] : uniformTilt p B ≃+* tilt p B :=
  { Equiv.refl (Perfection B p) with
    map_mul' := sorry
    map_add' := sorry }

/-- P1/tilt-of-uniform-tate-ring (compatibility): `equivTilt` commutes with `♯` and is a
homeomorphism. -/
theorem equivTilt_spec [IsPerfectoidTateRing p B] :
    (∀ x : uniformTilt p B, tilt.sharp (equivTilt x) = sharp x) ∧
      Continuous (equivTilt : uniformTilt p B ≃+* tilt p B) ∧
      Continuous (equivTilt : uniformTilt p B ≃+* tilt p B).symm := sorry

end uniformTilt

end UniformTilt

section UniformTiltTests

variable (p : ℕ) [Fact p.Prime]

-- test Perfectoid.uniformTilt_equiv_tilt (compatibility) [P1/tilt-of-uniform-tate-ring]
example (B : Type*) [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B]
    [IsTateRing B] [CompleteSpace B] [T2Space B] [IsPerfectoidTateRing p B]
    [Fact (IsBounded (powerBoundedSubring B : Set B))] [Fact (IsTopologicallyNilpotent (p : B))]
    (x : uniformTilt p B) (n : ℕ) :
    tilt.coeff n (uniformTilt.equivTilt x) = uniformTilt.coeff n x ∧
      tilt.sharp (uniformTilt.equivTilt x) = uniformTilt.sharp x := sorry

/- `ℚ_p♭ = 𝔽_p` (Teichmüller representatives, discrete): not a Tate ring; `ℚ_p` has no
pseudo-uniformizer `ϖ` with `ϖ ^ p ∣ p`, so `isTateRing_of_sharp` does not apply. -/
