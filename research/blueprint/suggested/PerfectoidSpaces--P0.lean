/-! ## PerfectoidSpaces:P4/qcqs-isomorphism-criterion (theorem) -/

-- PerfectoidSpace.isIso_tfae_of_quasiCompact: not stated here; needs qcqs morphisms of perfectoid
--   spaces and their field points (supplier: AdicSpaces Layer 5;
--   PerfectoidSpaces:P2/fibre-products-of-perfectoid-spaces). Affinoid core (conditions (i),
--   (iii), (iv); condition (ii) needs completed residue fields):
--   `isIso_tfae_of_quasiCompact_affinoid`.

section IsoCriterion

variable (p : ℕ) [Fact p.Prime] {R S : Type u} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R] [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
  [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S]
  {P : Pair R} {Q : Pair S}

/-- P4/qcqs-isomorphism-criterion (affinoid core; ECD Lemma 5.4): for a morphism `φ : P → Q` of
perfectoid Huber pairs (a map `Spa(Q) → Spa(P)` of affinoid perfectoid spaces, which is qcqs), the
following are equivalent: (i) `φ` is an isomorphism of Huber pairs; (iii) for every affinoid
perfectoid field `(K, K⁺)`, `Spa(Q)(K, K⁺) → Spa(P)(K, K⁺)`, `a ↦ a ∘ φ`, is bijective; (iv) the
same for algebraically closed `K`. -/
theorem isIso_tfae_of_quasiCompact_affinoid (φ : Pair.Hom P Q) :
    List.TFAE [∃ ψ : Pair.Hom Q P, ψ.comp φ = Pair.Hom.id P ∧ φ.comp ψ = Pair.Hom.id Q,
      ∀ (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
        (F : AffinoidField p K), Function.Bijective fun a : Pair.Hom Q F.toPair ↦ a.comp φ,
      ∀ (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
        [IsAlgClosed K] (F : AffinoidField p K),
        Function.Bijective fun a : Pair.Hom Q F.toPair ↦ a.comp φ] := sorry

end IsoCriterion

/-! ## PerfectoidSpaces:P4/injection-criteria (theorem) -/

-- PerfectoidSpace.isInjection_tfae: not stated here; needs `IsInjection`, field points and
--   completed residue fields of perfectoid spaces (supplier: AdicSpaces Layer 5;
--   PerfectoidSpaces:P2/completed-residue-fields). Affinoid core (conditions (i), (ii), (ii')):
--   `isInjection_tfae_affinoid`.

section InjectionCriteria

variable (p : ℕ) [Fact p.Prime] {R S : Type u} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R] [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
  [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S]
  {P : Pair R} {Q : Pair S}

/-- P4/injection-criteria (affinoid core; ECD Proposition 5.3 (i) ⇔ (ii); Berkeley
Definition/Proposition 8.3.3 (3)): for affinoid perfectoid `Spa(Q) → Spa(P)`, being an injection
(on affinoid perfectoid test objects) is equivalent to injectivity on `(K, K⁺)`-points for all
affinoid perfectoid fields, and to injectivity on `(C, C⁺)`-points for algebraically closed
ones. -/
theorem isInjection_tfae_affinoid (φ : Pair.Hom P Q) :
    List.TFAE [IsInjection_affinoid p φ,
      ∀ (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
        (F : AffinoidField p K), Function.Injective fun a : Pair.Hom Q F.toPair ↦ a.comp φ,
      ∀ (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
        [IsAlgClosed K] (F : AffinoidField p K),
        Function.Injective fun a : Pair.Hom Q F.toPair ↦ a.comp φ] := sorry

end InjectionCriteria

