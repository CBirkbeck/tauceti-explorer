namespace PerfectoidSpace

open Perfectoid

section ProdProfiniteInstances

/-- P6/product-with-profinite-set (supporting instance): the compact-convergence uniformity on
`C(α, β)` is that of the additive group, for a uniform additive group `β`. -/
instance prodProfinite.instIsUniformAddGroup {α β : Type*} [TopologicalSpace α] [UniformSpace β]
    [AddCommGroup β] [IsUniformAddGroup β] : IsUniformAddGroup C(α, β) := sorry

/-- P6/product-with-profinite-set (supporting instance): for compact `α` and a Tate ring `β`,
`C(α, β)` is a Tate ring, with ring of definition `C(α, β₀)` and pseudo-uniformizer the constant
`ϖ` (ECD after Definition 7.8). -/
instance prodProfinite.instIsTateRing {α β : Type*} [TopologicalSpace α] [CompactSpace α]
    [T2Space α] [CommRing β] [TopologicalSpace β] [IsTopologicalRing β] [IsTateRing β] :
    IsTateRing C(α, β) := sorry

/-- P6/product-with-profinite-set (supporting instance): for a profinite `α` and a perfectoid
Tate ring `R`, `C(α, R)` is perfectoid: `C(α, R)° = C(α, R°)` and `C(α, R°)/ϖ = C(α, R°/ϖ)`, the
locally constant functions (ECD after Definition 7.8, for `R = K` a perfectoid field). -/
instance prodProfinite.instIsPerfectoidTateRing (p : ℕ) [Fact p.Prime] {α R : Type*}
    [TopologicalSpace α] [CompactSpace α] [T2Space α] [TotallyDisconnectedSpace α] [CommRing R]
    [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R]
    [T2Space R] [IsPerfectoidTateRing p R] : IsPerfectoidTateRing p C(α, R) := sorry

end ProdProfiniteInstances

section ProdProfinite

variable {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
  [IsTateRing R]

/-- P6/product-with-profinite-set (constructor, affinoid core of `PerfectoidSpace.prodProfinite`):
for `X = Spa(R, R⁺)` and a profinite set `S = lim Sᵢ`, `X × S = lim X × Sᵢ` (ECD after Definition
7.8; Berkeley Example 8.2.2) is `Spa(C⁰(S, R), C⁰(S, R⁺))`, with the compact-convergence
topology: the plus ring is the functions with values in `R⁺`. -/
def prodProfinite_affinoid (P : Pair R) (S : Profinite.{u}) : Pair C(S, R) where
  plus := ⨅ s : S, P.plus.comap (ContinuousMap.evalAlgHom R R s : C(S, R) →+* R)
  isRingOfIntegralElements := sorry

variable (P : Pair R) (S : Profinite.{u})

/-- P6/product-with-profinite-set (projection, affinoid core of `prodProfinite.fst`): the
projection `X × S → X`, on rings the constant functions `R → C(S, R)` (ECD after Definition
7.8). -/
def prodProfinite.fst_affinoid : Pair.Hom P (prodProfinite_affinoid P S) where
  toRingHom := ContinuousMap.C
  continuous_toRingHom := sorry
  map_mem_plus := sorry

/-- P6/product-with-profinite-set (characterisation, affinoid core of `prodProfinite.plusEquiv`):
`O⁺(X × S) ≅ C⁰(S, O⁺(X))`; `O(X × S) = C⁰(S, O(X))` holds by construction (Berkeley Example
8.2.2). -/
def prodProfinite.plusEquiv_affinoid : (prodProfinite_affinoid P S).plus ≃+* C(S, P.plus) :=
  sorry

/-- P6/product-with-profinite-set (functoriality, affinoid core of `prodProfinite.map`): a
continuous map `S → S'` induces `X × S → X × S'`, on rings `g ↦ g ∘ f`; it commutes with the
projections (Berkeley Example 8.2.2). -/
def prodProfinite.map_affinoid {S S' : Profinite.{u}} (f : C(S, S')) :
    Pair.Hom (prodProfinite_affinoid P S') (prodProfinite_affinoid P S) where
  toRingHom := (ContinuousMap.compRightAlgHom R R f : C(S', R) →+* C(S, R))
  continuous_toRingHom := sorry
  map_mem_plus := sorry

/-- P6/product-with-profinite-set (compatibility, affinoid core of `prodProfinite.homeomorph`):
`|X × S| ≃ₜ |X| × S` (ECD after Definition 7.8; `|lim X × Sᵢ| = lim |X| × Sᵢ`, ECD Proposition
6.4(o)). -/
def prodProfinite.homeomorph_affinoid : spa (prodProfinite_affinoid P S).plus ≃ₜ spa P.plus × S :=
  sorry

/-- P6/product-with-profinite-set (example, affinoid core of `prodProfinite.ofFinite`): for a
finite `S`, `O(X × S) = O(X)^S`, i.e. `X × S = ⊔_{s ∈ S} X` (Berkeley Example 8.2.2). -/
def prodProfinite.ofFinite_affinoid [Finite S] : C(S, R) ≃+* (S → R) := sorry

variable (p : ℕ) [Fact p.Prime] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P6/product-with-profinite-set (a), affinoid core of `prodProfinite.homEquiv`: for a
perfectoid Tate pair `(B, B⁺)` over `(R, R⁺)`, morphisms `C(S, R) → B` over `R` correspond to
continuous maps `|Spa(B, B⁺)| → S` (ECD after Definition 7.8; the idempotents of `B` are the
clopen subsets of `|Spa(B, B⁺)|`, PerfectoidSpaces:P2/sheaf-theorem-and-almost-acyclicity). -/
def prodProfinite.homEquiv_affinoid {B : Type u} [CommRing B] [UniformSpace B]
    [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B] [CompleteSpace B] [T2Space B]
    [IsPerfectoidTateRing p B] (Q : Pair B) (ψ : Pair.Hom P Q) :
    {φ : Pair.Hom (prodProfinite_affinoid P S) Q // φ.comp (prodProfinite.fst_affinoid P S) = ψ}
      ≃ C(spa Q.plus, S) := sorry

/-- P6/product-with-profinite-set (f), affinoid core of `prodProfinite.tilt`:
`(X × S)♭ = X♭ × S`, on rings `C(S, R)♭ ≅ C(S, R♭)` (both are `lim_{x ↦ x^p}` computed
pointwise; ECD after Lemma 3.10 and after Definition 7.8). -/
def prodProfinite.tilt_affinoid : tilt p C(S, R) ≃+* C(S, tilt p R) := sorry

end ProdProfinite

section ProdProfiniteTests

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/- Affinoid core: for a finite discrete `S`, `O(X × S) = O(X)^S`. -/
-- test prodProfinite_finite (computation) [P6/product-with-profinite-set]
example (F : FintypeCat.{u}) : Nonempty (C(FintypeCat.toProfinite.obj F, R) ≃+* (F → R)) :=
  sorry

/- Affinoid core: `X × {pt} ≅ X` and `X × ∅ = ∅ = Spa(0, 0)`. -/
-- test prodProfinite_punit (degenerate) [P6/product-with-profinite-set]
example : Nonempty (C(Profinite.of PUnit.{u + 1}, R) ≃+* R) ∧
    Subsingleton C(Profinite.of PEmpty.{u + 1}, R) := sorry

/- Affinoid core: `O(Spa(ℂ_p, 𝒪_{ℂ_p}) × ℤ_p) = C⁰(ℤ_p, ℂ_p)` by construction, and
`O⁺ = C⁰(ℤ_p, 𝒪_{ℂ_p})`. -/
-- test prodProfinite_Zp_sections (computation) [P6/product-with-profinite-set]
example : Nonempty ((prodProfinite_affinoid (Pair.powerBounded ℂ_[p]) (Profinite.of ℤ_[p])).plus
    ≃+* C(ℤ_[p], powerBoundedSubring ℂ_[p])) := sorry

/- Affinoid core: for `|X|` connected, the sections of `X × S → X` are the points of `S`. -/
-- test prodProfinite_homEquiv_connected (characterisation) [P6/product-with-profinite-set]
example (P : Pair R) (S : Profinite.{u}) [ConnectedSpace (spa P.plus)] :
    Nonempty ({φ : Pair.Hom (prodProfinite_affinoid P S) P //
      φ.comp (prodProfinite.fst_affinoid P S) = Pair.Hom.id P} ≃ S) := sorry

/- Affinoid core: for infinite `S` the ring of `⊔_{s ∈ S} X` would be `∏_{s ∈ S} O(X)`, and
`C⁰(S, O(X)) → ∏_{s ∈ S} O(X)` is not surjective. -/
-- test not_prodProfinite_eq_sigma (non-example) [P6/product-with-profinite-set]
example (S : Profinite.{u}) [Infinite S] [Nontrivial R] :
    ¬ Function.Surjective (fun f : C(S, R) ↦ (f : S → R)) := sorry

/- Affinoid core: `(X × S)♭ ≅ X♭ × S` compatibly with the projections. -/
-- test prodProfinite_tilt (compatibility) [P6/product-with-profinite-set]
example (P : Pair R) (S : Profinite.{u}) (x : tilt p R) :
    prodProfinite.tilt_affinoid S p
        (tilt.map p (prodProfinite.fst_affinoid P S).toRingHom
          (prodProfinite.fst_affinoid P S).continuous_toRingHom x) =
      ContinuousMap.C x := sorry

end ProdProfiniteTests

