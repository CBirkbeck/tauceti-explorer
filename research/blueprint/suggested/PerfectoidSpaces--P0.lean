/-! ## PerfectoidSpaces:P5/omega1-cofiltered-uncompleted-colimit (theorem) -/

namespace Perfectoid

namespace completedColimit

variable {p : ℕ} [Fact p.Prime] {I : Type u} [SmallCategory I] [IsCofiltered I]
  {D : PairDiagram p I} (c : CompatiblePseudouniformizer D)

/-- P5/omega1-cofiltered-uncompleted-colimit (ECD Proposition 6.5): if `Iᵒᵖ` is `ℵ₁`-filtered (a
countable diagram in `I` has a cone), then `A = colim R_i⁺` is `ϖ`-adically separated and
complete, so `colim R_i⁺ → R⁺` and `colim R_i → R` are bijective: `O(lim X_i) = colim O(X_i)`.
For `I = ℕᵒᵖ` both fail in general (the tests of P5/completed-colimit-of-perfectoid-pairs). -/
theorem bijective_of_isCardinalFiltered [IsCardinalFiltered Iᵒᵖ (Cardinal.aleph.{u} 1)] :
    IsAdicComplete (Ideal.span {c.varpiColim}) (plusColimit D) ∧
      Function.Bijective (algebraMap (plusColimit D) (integral c)) ∧
      Function.Bijective (fromColimit c) := sorry

end completedColimit

