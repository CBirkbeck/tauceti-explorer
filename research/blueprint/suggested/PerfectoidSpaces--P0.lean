    ¬ ∃ e ∈ IsLocalRing.maximalIdeal O, ∀ x ∈ IsLocalRing.maximalIdeal O, e * x = x := sorry

/-! ## PerfectoidSpaces:P0/almost-cotangent-complex (construction) -/

-- Almost.cotangentComplex: not stated here; needs the classical cotangent complex
--   `L_{B̃_!!/Ã_!!}` of a ring map, an object of the derived category built from a simplicial
--   polynomial resolution, which Mathlib does not have (only the naive complex
--   `Algebra.Extension.cotangentComplex`) (supplier: DerivedDeRhamCohomology:DD.0)
-- Almost.almostCotangentComplex: not stated here; needs the cotangent complex `L_{B/A}` of
--   `Almost.cotangentComplex`, whose almostification it is (supplier:
--   DerivedDeRhamCohomology:DD.0); its naive truncation is `Almost.almostCotangentComplex_naive`

section cotangent

variable {R : Type u} [CommRing R] (T : BasicSetup R) (R' : Type u) [CommRing R']
  [_root_.Algebra R R']

/-- P0/almost-cotangent-complex (naive core of `Almost.almostCotangentComplex`): the almostified
naive cotangent complex `(I/I²)^a ⟶ (⊕ R' dxᵢ)^a` of a presentation `P` of `R'` over `R`
(Mathlib `Algebra.Extension.cotangentComplex`), the truncation `τ_{≥ -1}` of `L^a_{R'^a/R^a}`
(GR Definition 2.5.20). -/
def almostCotangentComplex_naive {ι : Type u} (P : _root_.Algebra.Generators R R' ι) :
    (toAlmost (T.baseChange R')).obj (ModuleCat.of R' P.toExtension.Cotangent) ⟶
      (toAlmost (T.baseChange R')).obj (ModuleCat.of R' P.toExtension.CotangentSpace) :=
  (toAlmost (T.baseChange R')).map (ModuleCat.ofHom P.toExtension.cotangentComplex)

-- Almost.cotangentComplex_H0: not stated here; needs the cotangent complex `L^a_{B/A}` (supplier:
--   DerivedDeRhamCohomology:DD.0); its naive core is `Almost.cotangentComplex_H0_naive`

/-- P0/almost-cotangent-complex (naive core of `Almost.cotangentComplex_H0`): `H_0` of the almost
naive cotangent complex is `Ω_{R'^a/R^a}` (GR 2.5.20, 2.5.25; Mathlib
`Algebra.Extension.exact_cotangentComplex_toKaehler`). -/
theorem cotangentComplex_H0_naive {ι : Type u} (P : _root_.Algebra.Generators R R' ι) :
    Nonempty (cokernel (almostCotangentComplex_naive T R' P) ≅
      Algebra.kaehlerDifferential T R') := sorry

/-- P0/almost-cotangent-complex: `H_1` of the almost naive cotangent complex is
`(H_1(L_{R'/R}))^a` for Mathlib's `Algebra.H1Cotangent` (GR 2.5.20). -/
theorem cotangentComplex_H1_naive {ι : Type u} (P : _root_.Algebra.Generators R R' ι) :
    Nonempty (kernel (almostCotangentComplex_naive T R' P) ≅
      (toAlmost (T.baseChange R')).obj (ModuleCat.of R' (_root_.Algebra.H1Cotangent R R'))) :=
  sorry

-- Almost.cotangentComplex_ext_iso: not stated here; needs the cotangent complex, for
--   `Ext^i_{B_!!}(L_{B/A}, M_!) ≅ Ext^i_B(L^a_{B/A}, M)` (GR (3.2.8)) (supplier:
--   DerivedDeRhamCohomology:DD.0)
-- Almost.cotangentComplex_ext_zero: not stated here; needs the cotangent complex, for
--   `Ext⁰(L^a_{B/A}, M) ≅ Der_A(B, M)` (GR Proposition 2.5.29) (supplier:
--   DerivedDeRhamCohomology:DD.0); on `H_0` it is `Algebra.kaehlerDifferential.liftEquiv`
-- Almost.cotangentComplex_ext_one: not stated here; needs the cotangent complex, for
--   `Ext¹(L^a_{B/A}, M) ≅ Exal_A(B, M)` (GR Theorem 2.5.30) (supplier:
--   DerivedDeRhamCohomology:DD.0); `Exal` is `Almost.Exal` (P0/almost-exal-ext-comparison)
-- Almost.cotangentComplex_transitivity: not stated here; needs the cotangent complex, for the
--   distinguished triangle of GR Theorem 2.5.32 (supplier: DerivedDeRhamCohomology:DD.0); its naive
--   core is `Almost.cotangentComplex_transitivity_naive`

/-- P0/almost-cotangent-complex (naive core of `Almost.cotangentComplex_transitivity`): the
Jacobi–Zariski sequence `H_1(L_{R''/R'}) → R'' ⊗ Ω_{R'/R} → Ω_{R''/R} → Ω_{R''/R'}` is exact
(Mathlib `Algebra.H1Cotangent.exact_δ_mapBaseChange`), hence so is its almostification, `M ↦ M^a`
being exact (GR Theorem 2.5.32 on `H_0`, `H_1`). -/
theorem cotangentComplex_transitivity_naive (R'' : Type u) [CommRing R''] [_root_.Algebra R' R'']
    [_root_.Algebra R R''] [IsScalarTower R R' R''] :
    Function.Exact (_root_.Algebra.H1Cotangent.δ R R' R'')
      (KaehlerDifferential.mapBaseChange R R' R'') ∧
    Function.Exact (KaehlerDifferential.mapBaseChange R R' R'')
      (KaehlerDifferential.map R R' R'' R'') := sorry

-- Almost.cotangentComplex_baseChange: not stated here; needs the cotangent complex, for its
--   Tor-independent base change (GR Theorem 2.5.35) (supplier: DerivedDeRhamCohomology:DD.0); on
--   `H_0` it is `Algebra.kaehlerDifferential.baseChangeIso`
-- Almost.cotangentComplex_colim: not stated here; needs the cotangent complex, for its commuting
--   with filtered colimits (GR Proposition 2.5.33) (supplier: DerivedDeRhamCohomology:DD.0)
-- Almost.cotangentComplex_toAlmost: not stated here; needs the cotangent complex, for
--   `L^a_{R'^a/R^a} ≅ (L_{R'/R})^a` (GR Proposition 8.1.7) (supplier:
--   DerivedDeRhamCohomology:DD.0); its naive core is `Almost.cotangentComplex_toAlmost_naive`

/-- P0/almost-cotangent-complex (naive core of `Almost.cotangentComplex_toAlmost`): if
`R^a → R'^a` is an isomorphism, `Ω_{R'/R}` and `H_1(L_{R'/R})` are almost zero (GR Proposition
