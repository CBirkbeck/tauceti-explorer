/-! ## PerfectoidSpaces:P7/compact-open-subgroup-cofinality (lemma) -/

section CompactOpenCofinality

variable {K : Type u} [Group K] [TopologicalSpace K] [IsTopologicalGroup K]

/-- P7/compact-open-subgroup-cofinality: in a compact Hausdorff (e.g. profinite) group, a
downward-directed family of closed subgroups is cofinal among the open neighbourhoods of `1` iff
its intersection is trivial (CHJ proof of Lemma 2.24; BHW proof of Theorem 5.11). Compactness is
essential. -/
theorem compactOpen_cofinal_iff [CompactSpace K] [T2Space K] {ι : Type*} [Nonempty ι]
    (Kn : ι → Subgroup K) (hK : Directed (· ≥ ·) Kn) (hcl : ∀ i, IsClosed (Kn i : Set K)) :
    (∀ U : Set K, IsOpen U → 1 ∈ U → ∃ i, (Kn i : Set K) ⊆ U) ↔ ⨅ i, Kn i = ⊥ := sorry

/-- P7/compact-open-subgroup-cofinality: the sequence form: a decreasing sequence of closed
subgroups of a profinite group is cofinal iff `⋂_n K_n = {1}`. -/
theorem compactOpen_cofinal_iff_of_antitone [CompactSpace K] [T2Space K]
    [TotallyDisconnectedSpace K] (Kn : ℕ → Subgroup K) (hK : Antitone Kn)
    (hcl : ∀ n, IsClosed (Kn n : Set K)) :
    (∀ U : OpenSubgroup K, ∃ n, Kn n ≤ U.toSubgroup) ↔ ⨅ n, Kn n = ⊥ := sorry

/-- P7/compact-open-subgroup-cofinality (ii): a family of subgroups all containing a fixed
`g ≠ 1` of a Hausdorff group is not cofinal (`Γ₀(p^n)`, `Γ₁(p^n)` contain `(1 1; 0 1)`). -/
theorem compactOpen_not_cofinal_of_mem [T2Space K] {ι : Type*} (Kn : ι → Subgroup K)
    {g : K} (hg : g ≠ 1) (h : ∀ i, g ∈ Kn i) :
    ¬ ∀ U : Set K, IsOpen U → 1 ∈ U → ∃ i, (Kn i : Set K) ⊆ U := sorry

/-- P7/compact-open-subgroup-cofinality (iii): a family below a cofinal family is cofinal. -/
theorem compactOpen_cofinal_mono {ι : Type*} (Kn Kn' : ι → Subgroup K)
    (h : ∀ i, Kn' i ≤ Kn i) (hK : ∀ U : Set K, IsOpen U → 1 ∈ U → ∃ i, (Kn i : Set K) ⊆ U) :
    ∀ U : Set K, IsOpen U → 1 ∈ U → ∃ i, (Kn' i : Set K) ⊆ U := sorry

end CompactOpenCofinality

