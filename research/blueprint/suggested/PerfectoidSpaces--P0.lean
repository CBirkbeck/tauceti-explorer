    (hcov : spa P.plus ⊆ ⋃ i, rationalSubset P.plus (𝔭 i).num (𝔭 i).den)
    (h : ∀ i, #(RationalLoc (𝔭 i)) < κ) : IsKappaSmall_affinoid κ P := sorry

