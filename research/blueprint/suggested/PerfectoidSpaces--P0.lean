/-! ## PerfectoidSpaces:P0/finite-etale-localizes (comparison) -/

/-- P0/finite-etale-localizes (i): a Mathlib finite étale algebra is almost finite étale
(GR (3.4.44)). -/
theorem isAlmostFiniteEtaleAlg_of_etale {R : Type u} [CommRing R] (T : BasicSetup R)
    (R' : Type u) [CommRing R'] [_root_.Algebra R R'] [_root_.Algebra.Etale R R']
    [_root_.Module.Finite R R'] : IsAlmostFiniteEtaleAlg T R' :=
  Algebra.isFiniteEtale_toAlmost T R'

/-- P0/finite-etale-localizes (ii): in the classical setup almost finite étale is Mathlib's finite
étale (GR (3.4.44)). -/
theorem isAlmostFiniteEtaleAlg_classical_iff (R R' : Type u) [CommRing R] [CommRing R']
    [_root_.Algebra R R'] :
    IsAlmostFiniteEtaleAlg (BasicSetup.classical R) R' ↔
      _root_.Algebra.Etale R R' ∧ _root_.Module.Finite R R' := sorry

/-- P0/finite-etale-localizes (iii): after inverting `ϖ ∈ m`, an almost finite étale algebra is
finite étale in Mathlib's sense (Bhatt Construction 4.3.3). -/
theorem etale_localization_of_isAlmostFiniteEtaleAlg {R : Type u} [CommRing R] (T : BasicSetup R)
    (ϖ : R) (hϖ : ϖ ∈ T.ideal) (R' : Type u) [CommRing R'] [_root_.Algebra R R']
    (h : IsAlmostFiniteEtaleAlg T R') :
    _root_.Algebra.Etale (Localization.Away ϖ) (Localization.Away ϖ ⊗[R] R') ∧
      _root_.Module.Finite (Localization.Away ϖ) (Localization.Away ϖ ⊗[R] R') := sorry

/-- P0/finite-etale-localizes (iv): a Mathlib étale algebra is étale in GR's sense for the classical
setup (GR Remark 3.1.3(i)). -/
theorem isAlmostEtaleAlg_classical_of_etale (R R' : Type u) [CommRing R] [CommRing R']
    [_root_.Algebra R R'] [_root_.Algebra.Etale R R'] :
    IsAlmostEtaleAlg (BasicSetup.classical R) R' := sorry

/-! ## PerfectoidSpaces:P0/almost-differentials (construction) -/

section differentials

variable {R : Type u} [CommRing R] (T : BasicSetup R) (R' : Type u) [CommRing R']
  [_root_.Algebra R R']

/-- P0/almost-differentials (constructor): `Ω_{R'^a/R^a} := I/I²` for `I` the kernel of
`μ : R' ⊗_R R' → R'`, almostified; Mathlib's `KaehlerDifferential R R'` is by definition `I/I²`,
so this is `(Ω_{R'/R})^a`, an almost `R'`-module (GR Definition 2.5.22(ii), Proposition
2.5.25). -/
def Algebra.kaehlerDifferential : Module (T.baseChange R') :=
  (Almost.toAlmost (T.baseChange R')).obj (_root_.ModuleCat.of R' (KaehlerDifferential R R'))

/-- P0/almost-differentials (data): almost `R`-derivations of `R'^a` into an almost `R'`-module
`M`, as derivations `R' → M_*` (GR (2.5.23)). -/
def Algebra.Derivation (M : Module (T.baseChange R')) : Type u :=
  letI := _root_.Module.compHom ((Module.elements (T.baseChange R')).obj M) (algebraMap R R')
  _root_.Derivation R R' ((Module.elements (T.baseChange R')).obj M)

/-- P0/almost-differentials (data): the universal derivation `δ : R'^a → Ω_{R'^a/R^a}`,
`b ↦ 1 ⊗ b − b ⊗ 1` (GR Definition 2.5.22(ii)). -/
def Algebra.kaehlerDifferential.d :
    Algebra.Derivation T R' (Algebra.kaehlerDifferential T R') := sorry

/-- P0/almost-differentials (universal-property): `Hom(Ω_{R'^a/R^a}, M) ≃ Der(R'^a, M)`,
`f ↦ f ∘ δ` (GR (2.5.23)). -/
def Algebra.kaehlerDifferential.liftEquiv (M : Module (T.baseChange R')) :
    (Algebra.kaehlerDifferential T R' ⟶ M) ≃ Algebra.Derivation T R' M := sorry

/-- P0/almost-differentials (compatibility): `Ω_{C ⊗ R'/C} ≅ (C ⊗_R R') ⊗_{R'} Ω_{R'/R}`
(GR Proposition 2.5.25(i); Mathlib `KaehlerDifferential.tensorKaehlerEquiv`). -/
def Algebra.kaehlerDifferential.baseChangeIso (C : Type u) [CommRing C] [_root_.Algebra R C] :
    letI := _root_.Algebra.TensorProduct.rightAlgebra (R := R) (A := C) (B := R')
    Algebra.kaehlerDifferential (T.baseChange C) (C ⊗[R] R') ≅
      (Almost.toAlmost ((T.baseChange C).baseChange (C ⊗[R] R'))).obj
        (_root_.ModuleCat.of (C ⊗[R] R') ((C ⊗[R] R') ⊗[R'] KaehlerDifferential R R')) := sorry

/-- P0/almost-differentials (relation): for `R → R' → R''` the sequence
`R'' ⊗ Ω_{R'/R} → Ω_{R''/R} → Ω_{R''/R'} → 0` is exact, and stays so after almostification
(GR Proposition 2.5.25(ii)). -/
theorem Algebra.kaehlerDifferential.exact_seq (R'' : Type u) [CommRing R''] [_root_.Algebra R' R'']
    [_root_.Algebra R R''] [IsScalarTower R R' R''] :
    Function.Exact (KaehlerDifferential.mapBaseChange R R' R'')
      (KaehlerDifferential.map R R' R'' R'') ∧
    Epi ((Almost.toAlmost (T.baseChange R'')).map
      (_root_.ModuleCat.ofHom (KaehlerDifferential.map R R' R'' R''))) := sorry

/-- P0/almost-differentials (compatibility): `(Ω_{B/A})_! ≅ Ω_{B!!/A!!}` for a morphism `f` of
almost algebras (GR 2.5.28). -/
def Algebra.kaehlerDifferential.shriekIso {A B : Algebra S} (f : A ⟶ B) :
    letI := ((Algebra.shriekShriek S).map f).hom.toRingHom.toAlgebra
    (Module.shriek ((S.baseChange ((Algebra.shriekShriek S).obj A)).baseChange
        ((Algebra.shriekShriek S).obj B))).obj
      (Algebra.kaehlerDifferential (S.baseChange ((Algebra.shriekShriek S).obj A))
        ((Algebra.shriekShriek S).obj B)) ≅
    _root_.ModuleCat.of _ (KaehlerDifferential ((Algebra.shriekShriek S).obj A)
      ((Algebra.shriekShriek S).obj B)) := sorry

/-- P0/almost-differentials (compatibility): `Ω_{R'^a/R^a} ≅ (Ω_{R'/R})^a` (Mathlib
`KaehlerDifferential`; by definition here, GR Proposition 2.5.25). -/
def Algebra.kaehlerDifferential_toAlmost :
    Algebra.kaehlerDifferential T R' ≅
      (Almost.toAlmost (T.baseChange R')).obj (_root_.ModuleCat.of R' (KaehlerDifferential R R')) :=
  Iso.refl _

/-- P0/almost-differentials (relation): unramified implies `Ω_{R'^a/R^a} ≅ 0` (GR Proposition
2.5.25). -/
theorem Algebra.kaehlerDifferential_eq_zero_of_isUnramified (h : IsAlmostUnramifiedAlg T R') :
    IsZero (Algebra.kaehlerDifferential T R') := sorry

end differentials

-- test Almost.Algebra.kaehler_test_polynomial (computation) [P0/almost-differentials]
example (R : Type u) [CommRing R] (T : BasicSetup R) :
    Nonempty (Algebra.kaehlerDifferential T (Polynomial R) ≅
      (toAlmost (T.baseChange (Polynomial R))).obj (ModuleCat.of _ (Polynomial R))) := sorry

-- test Almost.Algebra.kaehler_test_self (degenerate) [P0/almost-differentials]
example (R : Type u) [CommRing R] (T : BasicSetup R) (J : Ideal R) :
    IsZero (Algebra.kaehlerDifferential T R) ∧ IsZero (Algebra.kaehlerDifferential T (R ⧸ J)) :=
  sorry

-- test Almost.Algebra.kaehler_test_mathlib (compatibility) [P0/almost-differentials]
example (R R' : Type u) [CommRing R] [CommRing R'] [_root_.Algebra R R'] (T : BasicSetup R) :
    Nonempty (Algebra.kaehlerDifferential T R' ≅
      (toAlmost (T.baseChange R')).obj (ModuleCat.of R' (KaehlerDifferential R R'))) :=
  ⟨Algebra.kaehlerDifferential_toAlmost T R'⟩

/- `B = V^a` over `ofValuationRing O`: `B_! = m̃ ≅ 𝔪` has no unit element, so Mathlib's
`KaehlerDifferential` (of unital commutative rings) does not apply to `B_!`, and `Ω_{B/A}` is read
on `B_*` or on `B_!!` (`Algebra.kaehlerDifferential.shriekIso`, GR 2.5.28). -/
-- test Almost.Algebra.kaehler_test_not_elements (non-example) [P0/almost-differentials]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) :
    Nonempty ((Module.shriek (BasicSetup.ofValuationRing O h)).obj
