/-! ## PerfectoidSpaces:P5/spa-of-filtered-colimit-of-tate-pairs (lemma) -/

namespace Perfectoid

namespace completedColimit

variable {p : ℕ} [Fact p.Prime] {I : Type u} [SmallCategory I] [IsCofiltered I]
  {D : PairDiagram p I} (c : CompatiblePseudouniformizer D)

/-- P5/spa-of-filtered-colimit-of-tate-pairs (b), (d) (data): the map
`Spa(R, R⁺) → lim_i Spa(R_i, R_i⁺)` given by the Tau Ceti maps `(ι c i).spaComap`, into Mathlib's
limit `TopCat.limitCone` of `PairDiagram.spaFunctor`. -/
def spaToLimit : C(spa (completedColimitPair c).plus, (TopCat.limitCone D.spaFunctor).pt) :=
  sorry

/-- P5/spa-of-filtered-colimit-of-tate-pairs (b), (d): the components of `spaToLimit` are the
`(ι c i).spaComap`. -/
theorem spaToLimit_apply (x : spa (completedColimitPair c).plus) (i : I) :
    ((TopCat.limitCone D.spaFunctor).π.app i) (spaToLimit c x) = (ι c i).spaComap x := sorry

/-- P5/spa-of-filtered-colimit-of-tate-pairs (b), (d): `Spa(R, R⁺) → lim_i Spa(R_i, R_i⁺)` is a
homeomorphism: first for the uncompleted colimit `(colim R_i, colim R_i⁺)` (Sch12 proof of
Lemma 6.13 (ii); KL Remark 2.6.3), then through `Spa(Â, Â⁺) ≅ Spa(A, A⁺)` (Wedhorn
Proposition 7.48 = Huber 1993 Proposition 3.9, requested from anchor Layer 2). -/
theorem isHomeomorph_spaToLimit : IsHomeomorph (spaToLimit c) := sorry

/-- P5/spa-of-filtered-colimit-of-tate-pairs (c), (d): every rational subset `R(T/s)` of
`Spa(R, R⁺)` is the preimage of a rational subset `R(T_i/s_i)` of some `Spa(R_i, R_i⁺)`, with
`T_i` generating the unit ideal (Sch12 proof of Lemma 6.13 (ii); KL Remark 2.6.3). -/
theorem exists_rationalSubset_preimage_eq (T : Finset (completedColimit c)) (s : completedColimit c)
    (hT : Ideal.span (T : Set (completedColimit c)) = ⊤) :
    ∃ (i : I) (Ti : Finset (D.ring.obj (op i))) (si : D.ring.obj (op i)),
      Ideal.span (Ti : Set (D.ring.obj (op i))) = ⊤ ∧
      (ι c i).spaComap ⁻¹' (Subtype.val ⁻¹' rationalSubset (D.pair i).plus Ti si) =
        Subtype.val ⁻¹' rationalSubset (completedColimitPair c).plus T s := sorry

/-- P5/spa-of-filtered-colimit-of-tate-pairs (d): `lim_i Spa(R_i, R_i⁺)` is a spectral space, and
the transition maps and the maps `(ι c i).spaComap` are spectral (Tau Ceti: each
`Spa(R_i, R_i⁺)` is spectral; Wedhorn Remark 7.11 (1)). -/
theorem spectralSpace_limit_spa :
    SpectralSpace (TopCat.limitCone D.spaFunctor).pt ∧
      (∀ {i j : I} (a : j ⟶ i), IsSpectralMap (D.hom a).spaComap) ∧
      ∀ i, IsSpectralMap (ι c i).spaComap := sorry

end completedColimit

end Perfectoid

/-! ## PerfectoidSpaces:P5/limit-underlying-space-homeomorphism (theorem) -/

namespace PerfectoidSpace

open Perfectoid Perfectoid.completedColimit

-- PerfectoidSpace.cofilteredLimit.homeomorph_spectral: not stated here; needs the underlying
--   space of the limit perfectoid space (supplier: PerfectoidSpaces:P2/perfectoid-space). Affinoid
--   core: `cofilteredLimit.homeomorph_affinoid` below.

section Homeomorph

variable {p : ℕ} [Fact p.Prime] {I : Type u} [SmallCategory I] [IsCofiltered I]
  {D : PairDiagram p I} (c : CompatiblePseudouniformizer D)

/-- P5/limit-underlying-space-homeomorphism (affinoid core of `cofilteredLimit.homeomorph`, ECD
Proposition 6.4 (o)): `|Spa(R, R⁺)| ≃ₜ lim_i |Spa(R_i, R_i⁺)|`, the inverse limit in topological
spaces (Mathlib `TopCat.limitCone`), via the projections. -/
def cofilteredLimit.homeomorph_affinoid :
    spa (completedColimitPair c).plus ≃ₜ (TopCat.limitCone D.spaFunctor).pt :=
  (isHomeomorph_spaToLimit c).homeomorph

/-- P5/limit-underlying-space-homeomorphism (ECD Proposition 6.4 (o)): the homeomorphism is one of
spectral spaces with spectral projections, and every rational subset of `Spa(R, R⁺)` is the
preimage of a rational subset of some `Spa(R_i, R_i⁺)`. -/
theorem cofilteredLimit.homeomorph_affinoid_spec (x : spa (completedColimitPair c).plus) (i : I) :
    ((TopCat.limitCone D.spaFunctor).π.app i) (homeomorph_affinoid c x) = (ι c i).spaComap x ∧
      SpectralSpace (TopCat.limitCone D.spaFunctor).pt ∧ IsSpectralMap (ι c i).spaComap ∧
      ∀ (T : Finset (completedColimit c)) (s : completedColimit c),
        Ideal.span (T : Set (completedColimit c)) = ⊤ →
        ∃ (j : I) (Tj : Finset (D.ring.obj (op j))) (sj : D.ring.obj (op j)),
          (ι c j).spaComap ⁻¹' (Subtype.val ⁻¹' rationalSubset (D.pair j).plus Tj sj) =
            Subtype.val ⁻¹' rationalSubset (completedColimitPair c).plus T s := sorry

end Homeomorph

end PerfectoidSpace

/-! ## PerfectoidSpaces:P5/quasicompact-opens-in-limits-of-spectral-spaces (lemma) -/

namespace SpectralSpace

variable {I : Type u} [SmallCategory I] [IsCofiltered I] (F : I ⥤ TopCat.{u})
  [∀ i, SpectralSpace (F.obj i)]

/-- P5/quasicompact-opens-in-limits-of-spectral-spaces (a): in a cofiltered limit of spectral
spaces with spectral transition maps, every quasicompact open is the preimage of a quasicompact
open of a finite stage (Stacks Tag 0A30). -/
theorem exists_isCompact_isOpen_preimage_eq (hF : ∀ {i j : I} (a : i ⟶ j), IsSpectralMap (F.map a))
    (U : Set (TopCat.limitCone F).pt) (hU : IsOpen U) (hUc : IsCompact U) :
    ∃ (i : I) (Ui : Set (F.obj i)), IsOpen Ui ∧ IsCompact Ui ∧
      ((TopCat.limitCone F).π.app i) ⁻¹' Ui = U := sorry

/-- P5/quasicompact-opens-in-limits-of-spectral-spaces (a): more generally every constructible
subset of the limit (Mathlib `Topology.IsConstructible`) is the preimage of a constructible subset
of a finite stage (Stacks Tag 0A2Y). -/
theorem exists_isConstructible_preimage_eq
    (hF : ∀ {i j : I} (a : i ⟶ j), IsSpectralMap (F.map a)) (Z : Set (TopCat.limitCone F).pt)
    (hZ : Topology.IsConstructible Z) :
    ∃ (i : I) (Zi : Set (F.obj i)), Topology.IsConstructible Zi ∧
      ((TopCat.limitCone F).π.app i) ⁻¹' Zi = Z := sorry

/-- P5/quasicompact-opens-in-limits-of-spectral-spaces (b): if quasicompact opens `U, V` of a
finite stage satisfy `p_i⁻¹(U) ⊆ p_i⁻¹(V)`, then `f_a⁻¹(U) ⊆ f_a⁻¹(V)` for some `a : j ⟶ i`
(Stacks Tag 0A30); with `V = S_i` or `U = ∅` this detects `p_i⁻¹(U) = S`, `= ∅`. -/
theorem exists_preimage_subset_of_preimage_subset
    (hF : ∀ {i j : I} (a : i ⟶ j), IsSpectralMap (F.map a)) {i : I} (U V : Set (F.obj i))
    (hU : IsOpen U ∧ IsCompact U) (hV : IsOpen V ∧ IsCompact V)
    (h : ((TopCat.limitCone F).π.app i) ⁻¹' U ⊆ ((TopCat.limitCone F).π.app i) ⁻¹' V) :
    ∃ (j : I) (a : j ⟶ i), F.map a ⁻¹' U ⊆ F.map a ⁻¹' V := sorry

/-- P5/quasicompact-opens-in-limits-of-spectral-spaces (b), (c): the version with equality, and
for finitely many identities at once (a common finite stage, `I` being cofiltered). -/
theorem exists_preimage_eq_of_preimage_eq
    (hF : ∀ {i j : I} (a : i ⟶ j), IsSpectralMap (F.map a)) {i : I} {ι : Type*} [Finite ι]
    (U V : ι → Set (F.obj i)) (hU : ∀ k, IsOpen (U k) ∧ IsCompact (U k))
    (hV : ∀ k, IsOpen (V k) ∧ IsCompact (V k))
    (h : ∀ k, ((TopCat.limitCone F).π.app i) ⁻¹' U k = ((TopCat.limitCone F).π.app i) ⁻¹' V k) :
    ∃ (j : I) (a : j ⟶ i), ∀ k, F.map a ⁻¹' U k = F.map a ⁻¹' V k := sorry

/-- P5/quasicompact-opens-in-limits-of-spectral-spaces (d): if `p_i⁻¹(U)` is open and closed for
a quasicompact open `U`, then `f_a⁻¹(U)` is open and closed for some `a : j ⟶ i` (ECD proof of
Proposition 6.4 (iii); Sch12 Lemma 6.13 (iv)). -/
theorem exists_isClopen_preimage (hF : ∀ {i j : I} (a : i ⟶ j), IsSpectralMap (F.map a))
    {i : I} (U : Set (F.obj i)) (hU : IsOpen U ∧ IsCompact U)
    (h : IsClopen (((TopCat.limitCone F).π.app i) ⁻¹' U)) :
    ∃ (j : I) (a : j ⟶ i), IsClopen (F.map a ⁻¹' U) := sorry

end SpectralSpace

