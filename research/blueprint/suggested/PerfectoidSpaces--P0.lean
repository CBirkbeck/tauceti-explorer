section Diagonal

variable (p : ℕ) [Fact p.Prime] {A B : Type u}
  [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A]
  [CompleteSpace A] [T2Space A] [IsPerfectoidTateRing p A]
  [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B]
  [CompleteSpace B] [T2Space B] [IsPerfectoidTateRing p B]
  [Algebra A B] [IsAdicHom (algebraMap A B)]
  (S : Pair A) (T : Pair B) (hT : ∀ a ∈ S.plus, algebraMap A B a ∈ T.plus)

/-- P4/diagonal-of-perfectoid-map (b) (affinoid core; ECD Proposition 5.9 and proof): for a map
`Spa(B, B⁺) → Spa(A, A⁺)` of affinoid perfectoid spaces, the diagonal
`Spa(B, B⁺) → Spa(B ⊗̂_A B)` is induced by the multiplication `m : B ⊗̂_A B → B` (the unique
morphism with `m ∘ inl = m ∘ inr = id`), and `m` is strongly Zariski closed. -/
theorem isStronglyZariskiClosed_diagonal_affinoid
    (m : Pair.Hom (Pair.completedTensor S T T hT hT) T)
    (hl : m.comp (Pair.completedTensor.inl S T T hT hT) = Pair.Hom.id T)
    (hr : m.comp (Pair.completedTensor.inr S T T hT hT) = Pair.Hom.id T) :
    IsStronglyZariskiClosed_affinoid m := sorry

end Diagonal

