-- test Perfectoid.uniformTilt_charP (degenerate) [P1/tilt-of-uniform-tate-ring]
example (B : Type*) [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B]
    [IsTateRing B] [CompleteSpace B] [T2Space B] [CharP B p] [PerfectRing B p]
    [Fact (IsBounded (powerBoundedSubring B : Set B))] [Fact (IsTopologicallyNilpotent (p : B))] :
    ∃ e : uniformTilt p B ≃+* B, (∀ x, e x = uniformTilt.sharp x) ∧ Continuous e ∧
