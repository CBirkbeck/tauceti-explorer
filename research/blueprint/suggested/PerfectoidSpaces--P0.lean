    Nonempty ((Module.shriek S).obj ((toAlmost S).obj N) ≅ ModuleCat.of V (S.tilde ⊗[V] N)) :=
  sorry

/-! ## PerfectoidSpaces:P0/almost-isomorphisms-are-monoidal (lemma) -/

/-- P0/almost-isomorphisms-are-monoidal: `X ⊗ f` is an almost isomorphism if `f` is
(GR (2.2.5), Bhatt Proposition 4.1.7(3)). -/
theorem isAlmostIso_lTensor (X : Type u) [AddCommGroup X] [_root_.Module V X] {M N : Type u}
    [AddCommGroup M] [_root_.Module V M] [AddCommGroup N] [_root_.Module V N] (f : M →ₗ[V] N)
    (hf : S.IsAlmostIso f) : S.IsAlmostIso (f.lTensor X) := sorry

/-- P0/almost-isomorphisms-are-monoidal (instance; packet name of
P0/almost-tensor-and-internal-hom): the almost isomorphisms form a monoidal morphism property of
`ModuleCat V` (GR (2.2.5)). -/
instance isoModSerre_isMonoidal : S.almostZero.isoModSerre.IsMonoidal := sorry

/-! ## PerfectoidSpaces:P0/almost-tensor-and-internal-hom (construction) -/

/-- P0/almost-tensor-and-internal-hom (instance): the monoidal structure of `V^a-Mod` localised from
`ModuleCat V` (Mathlib `LocalizedMonoidal`, unit `V^a`; Sch12 Proposition 4.5). -/
instance Module.monoidalCategory : MonoidalCategory (Module S) :=
  inferInstanceAs (MonoidalCategory
    (LocalizedMonoidal (toAlmost S) S.almostZero.isoModSerre (Iso.refl _)))

/-- P0/almost-tensor-and-internal-hom (instance): the symmetric structure (GR (2.2.10)). -/
instance Module.symmetricCategory : SymmetricCategory (Module S) :=
  inferInstanceAs (SymmetricCategory
    (LocalizedMonoidal (toAlmost S) S.almostZero.isoModSerre (Iso.refl _)))

/-- P0/almost-tensor-and-internal-hom (instance): `M ↦ M^a` is monoidal,
`M^a ⊗ N^a ≅ (M ⊗_V N)^a` (Sch12 Proposition 4.5). -/
instance toAlmostMonoidal : (toAlmost S).Monoidal :=
  inferInstanceAs (Localization.Monoidal.toMonoidalCategory (toAlmost S)
    S.almostZero.isoModSerre (Iso.refl _)).Monoidal

/-- P0/almost-tensor-and-internal-hom: `M ↦ M^a` is braided (GR (2.2.10)). -/
instance toAlmostBraided : (toAlmost S).Braided :=
  inferInstanceAs (Localization.Monoidal.toMonoidalCategory (toAlmost S)
    S.almostZero.isoModSerre (Iso.refl _)).Braided

/-- P0/almost-tensor-and-internal-hom (characterisation): `M ⊗ N ≅ (M_* ⊗_V N_*)^a`
(GR (2.2.10)). -/
def Module.tensorIsoElements (X Y : Module S) :
    X ⊗ Y ≅ (toAlmost S).obj ((Module.elements S).obj X ⊗ (Module.elements S).obj Y) := sorry

/-- P0/almost-tensor-and-internal-hom (constructor): the internal hom
`alHom(X, Y) := (Hom(X, Y))^a` (GR (2.2.11), Sch12 Proposition 4.5). -/
def Module.alHom (X Y : Module S) : Module S :=
  (toAlmost S).obj (ModuleCat.of V (X ⟶ Y))

/-- P0/almost-tensor-and-internal-hom (instance): `V^a-Mod` is closed, with internal hom `alHom`
(GR (2.2.11)). -/
instance Module.monoidalClosed : MonoidalClosed (Module S) := sorry

/-- P0/almost-tensor-and-internal-hom: the internal hom of the closed structure is `alHom`
(GR (2.2.11)). -/
def Module.ihomIsoAlHom (X Y : Module S) : (ihom X).obj Y ≅ Module.alHom S X Y := sorry

/-- P0/almost-tensor-and-internal-hom (compatibility): `alHom(M^a, N^a) ≅ (Hom_V(m̃ ⊗ M, N))^a`
(GR (2.2.11), P0/almost-hom-formula). -/
def Module.alHom_toAlmost (M N : ModuleCat.{u} V) :
    Module.alHom S ((toAlmost S).obj M) ((toAlmost S).obj N) ≅
      (toAlmost S).obj (ModuleCat.of V (S.tilde ⊗[V] M →ₗ[V] N)) := sorry

/-- P0/almost-tensor-and-internal-hom (compatibility): `(M ⊗ N)_! ≅ M_! ⊗_V N_!`
(GR (2.2.10), Sch12 Proposition 4.5). -/
def Module.shriekTensorIso (X Y : Module S) :
    (Module.shriek S).obj (X ⊗ Y) ≅ (Module.shriek S).obj X ⊗ (Module.shriek S).obj Y := sorry

/-- P0/almost-tensor-and-internal-hom (instance): `M ↦ M_*` is lax monoidal (GR (2.2.10)). -/
instance Module.elementsLaxMonoidal : (Module.elements S).LaxMonoidal := sorry

/-- P0/almost-tensor-and-internal-hom (instance): `X ⊗ −` is right exact (Sch12 Proposition 4.5). -/
instance Module.tensor_preservesFiniteColimits (X : Module S) :
    PreservesFiniteColimits (tensorLeft X) := sorry

/-- P0/almost-tensor-and-internal-hom: `− ⊗ X` is right exact (Sch12 Proposition 4.5). -/
instance Module.tensorRight_preservesFiniteColimits (X : Module S) :
    PreservesFiniteColimits (tensorRight X) := sorry

/- `O = K°`, `k` its residue field: `k^a ⊗ X ≅ 0`, and `(K°°)^a ⊗ (K°°)^a ≅ 𝟙_`. -/
-- test Almost.Module.tensor_test_residue (computation) [P0/almost-tensor-and-internal-hom]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) (X : Module (BasicSetup.ofValuationRing O h)) :
    IsZero ((toAlmost _).obj (ModuleCat.of O (IsLocalRing.ResidueField O)) ⊗ X) ∧
      Nonempty ((toAlmost (BasicSetup.ofValuationRing O h)).obj
          (ModuleCat.of O (IsLocalRing.maximalIdeal O)) ⊗
        (toAlmost _).obj (ModuleCat.of O (IsLocalRing.maximalIdeal O)) ≅ 𝟙_ _) := sorry

-- test Almost.Module.tensor_test_unit (degenerate) [P0/almost-tensor-and-internal-hom]
example : Nonempty ((toAlmost S).obj (ModuleCat.of V V) ≅ 𝟙_ (Module S)) ∧
    Nonempty ((toAlmost S).obj (ModuleCat.of V S.ideal) ≅ 𝟙_ (Module S)) := sorry

-- test Almost.Module.tensor_test_mathlib (compatibility) [P0/almost-tensor-and-internal-hom]
example (M N : ModuleCat.{u} V) :
    Nonempty ((toAlmost S).obj M ⊗ (toAlmost S).obj N ≅ (toAlmost S).obj (M ⊗ N)) :=
  ⟨Functor.Monoidal.μIso (toAlmost S) M N⟩

-- test Almost.Module.tensor_test_unit_not_ideal (non-example) [P0/almost-tensor-and-internal-hom]
example (h : S.ideal ≠ ⊤) :
    Subsingleton (S.ideal ⊗[V] (V ⧸ S.ideal)) ∧ Nontrivial (V ⧸ S.ideal) := sorry

/-! ## PerfectoidSpaces:P0/almost-algebras (definition) -/

/-- P0/almost-algebras (data): almost `V`-algebras, the commutative monoids of `V^a-Mod`
(GR (2.2.5), Sch12 after Proposition 4.6). -/
abbrev Algebra : Type (u + 1) := CommMon (Module S)

/-- P0/almost-algebras (constructor): `R ↦ R^a` on commutative `V`-algebras (GR (2.2.5)). -/
def Algebra.toAlmost : CommAlgCat.{u} V ⥤ Algebra S := sorry

/-- P0/almost-algebras (projection): `A ↦ A_* = Hom(V^a, A)`, a commutative `V`-algebra
(Bhatt Remark 4.2.8). -/
def Algebra.elements : Algebra S ⥤ CommAlgCat.{u} V := sorry

/-- P0/almost-algebras (universal-property): `R ↦ R^a` is left adjoint to `A ↦ A_*`
(Bhatt Remark 4.2.8). -/
def Algebra.adj : Algebra.toAlmost S ⊣ Algebra.elements S := sorry

/-- P0/almost-algebras (equivalence): the counit `(A_*)^a ≅ A`; `A ↦ A_*` is fully faithful
(Bhatt Remark 4.2.8). -/
def Algebra.counitIso : Algebra.elements S ⋙ Algebra.toAlmost S ≅ 𝟭 (Algebra S) := sorry

/-- P0/almost-algebras (characterisation): morphisms of almost algebras are the `V`-algebra maps of
almost elements (Bhatt Remark 4.2.8). -/
def Algebra.homEquiv (A B : Algebra S) :
    (A ⟶ B) ≃ ((Algebra.elements S).obj A →ₐ[V] (Algebra.elements S).obj B) := sorry

/-- P0/almost-algebras: the almost algebra `R^a` of a commutative `V`-algebra `R`. -/
abbrev Algebra.of (R : Type u) [CommRing R] [_root_.Algebra V R] : Algebra S :=
  (Algebra.toAlmost S).obj (CommAlgCat.of V R)

/-- P0/almost-algebras: the morphism `f^a` of a `V`-algebra map `f`. -/
abbrev Algebra.ofHom {R R' : Type u} [CommRing R] [_root_.Algebra V R] [CommRing R']
    [_root_.Algebra V R'] (f : R →ₐ[V] R') : Algebra.of S R ⟶ Algebra.of S R' :=
  (Algebra.toAlmost S).map (CommAlgCat.ofHom f)

/-- P0/almost-algebras (data): the category `A-Mod` of module objects over `A` in `V^a-Mod`
(GR (2.2.5)). -/
abbrev Algebra.ModuleCat (A : Algebra S) : Type (u + 1) := CategoryTheory.Mod (Module S) A.X

/-- P0/almost-algebras (equivalence): `A-Mod ≃ Almost.Module (S.baseChange A_*)`
(GR Remark 2.2.12, Proposition 2.2.13). -/
def Algebra.moduleEquiv (A : Algebra S) :
    Algebra.ModuleCat S A ≌ Module (S.baseChange ((Algebra.elements S).obj A)) := sorry

/-- P0/almost-algebras (instance): the closed symmetric monoidal structure on `A-Mod`,
`M ⊗_A N = (M_* ⊗_{A_*} N_*)^a` (GR (2.2.5)). -/
instance Algebra.monoidalCategory (A : Algebra S) : MonoidalCategory (Algebra.ModuleCat S A) :=
  sorry

/-- P0/almost-algebras (constructor): the free `A`-module `A^{(I)} = ((A_*)^{(I)})^a`
(GR (2.2.18)). -/
def Algebra.free (A : Algebra S) (I : Type u) : Algebra.ModuleCat S A := sorry

/-- P0/almost-algebras (constructor): the quotient `A/I := (A_*/I)^a` by an ideal of almost
elements; `A ⟶ A/I` is an epimorphism (GR (2.2.5)). -/
def Algebra.quotient (A : Algebra S) (I : Ideal ((Algebra.elements S).obj A)) : Algebra S :=
  Algebra.of S ((Algebra.elements S).obj A ⧸ I)

/-- P0/almost-algebras (constructor): the product `A × B := (A_* × B_*)^a`, with
`(A × B)_* = A_* × B_*` (GR (2.2.5)). -/
def Algebra.prod (A B : Algebra S) : Algebra S :=
  Algebra.of S ((Algebra.elements S).obj A × (Algebra.elements S).obj B)

/-- P0/almost-algebras (constructor): the pushout `B ⊗_A C ≅ (B_* ⊗_{A_*} C_*)^a` of almost
algebras (GR (2.2.5)). -/
def Algebra.tensor {A B C : Algebra S} (f : A ⟶ B) (g : A ⟶ C) : Algebra S := sorry

/-- P0/almost-algebras: `B ⊗_A C` is the pushout of `f` and `g`. -/
theorem Algebra.isPushout_tensor {A B C : Algebra S} (f : A ⟶ B) (g : A ⟶ C) :
    ∃ (i : B ⟶ Algebra.tensor S f g) (j : C ⟶ Algebra.tensor S f g), IsPushout f g i j := sorry

/- `O = K°`, `ϖ ∈ K°°`: the almost elements of `(K°/ϖ)^a` are `Hom_{K°}(K°°, K°/ϖ) ⊋ K°/ϖ`. -/
-- test Almost.Algebra.test_mod_varpi (computation) [P0/almost-algebras]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) (π : O) :
    Nonempty ((Module.elements _).obj ((toAlmost (BasicSetup.ofValuationRing O h)).obj
      (ModuleCat.of O (O ⧸ Ideal.span {π}))) ≅
        ModuleCat.of O (IsLocalRing.maximalIdeal O →ₗ[O] O ⧸ Ideal.span {π})) := sorry

-- test Almost.Algebra.test_classical (degenerate) [P0/almost-algebras]
example : (Algebra.toAlmost (BasicSetup.classical V)).IsEquivalence := sorry

-- test Almost.Algebra.test_modules (compatibility) [P0/almost-algebras]
example (R : CommAlgCat.{u} V) :
    Nonempty (Algebra.ModuleCat S ((Algebra.toAlmost S).obj R) ≌
      Module (S.baseChange ((Algebra.elements S).obj ((Algebra.toAlmost S).obj R)))) :=
  ⟨Algebra.moduleEquiv S _⟩

-- test Almost.Algebra.test_hom_elements (characterisation) [P0/almost-algebras]
example (A B : Algebra S) :
    Nonempty ((A ⟶ B) ≃ ((Algebra.elements S).obj A →ₐ[V] (Algebra.elements S).obj B)) :=
  ⟨Algebra.homEquiv S A B⟩

/-! ## PerfectoidSpaces:P0/change-of-basic-setup (lemma) -/

/-- P0/change-of-basic-setup: restriction of scalars `Almost.Module (S.baseChange W) ⥤
Almost.Module S`, `M ↦ (M_* as a V-module)^a` (GR Remark 2.2.12). -/
def Module.restrictScalars (W : Type u) [CommRing W] [_root_.Algebra V W] :
    Module (S.baseChange W) ⥤ Module S :=
  Module.elements (S.baseChange W) ⋙ ModuleCat.restrictScalars (algebraMap V W) ⋙ toAlmost S

/-- P0/change-of-basic-setup: extension of scalars `M ↦ (W ⊗_V M_*)^a` (GR Remark 2.2.12). -/
def Module.extendScalars (W : Type u) [CommRing W] [_root_.Algebra V W] :
    Module S ⥤ Module (S.baseChange W) :=
  Module.elements S ⋙ ModuleCat.extendScalars (algebraMap V W) ⋙ toAlmost (S.baseChange W)

/-- P0/change-of-basic-setup: extension of scalars is compatible with `M ↦ M^a`
(GR Remark 2.2.12). -/
def Module.extendScalarsToAlmostIso (W : Type u) [CommRing W] [_root_.Algebra V W] :
    toAlmost S ⋙ Module.extendScalars S W ≅
      ModuleCat.extendScalars (algebraMap V W) ⋙ toAlmost (S.baseChange W) := sorry

/-- P0/change-of-basic-setup: restriction of scalars commutes with almost elements
(GR Remark 2.2.12). -/
def Module.restrictScalarsElementsIso (W : Type u) [CommRing W] [_root_.Algebra V W] :
    Module.restrictScalars S W ⋙ Module.elements S ≅
      Module.elements (S.baseChange W) ⋙ ModuleCat.restrictScalars (algebraMap V W) := sorry

/-- P0/change-of-basic-setup (ii): if `V → W` is an almost isomorphism, restriction of scalars is an
equivalence `W^a-Mod ≃ V^a-Mod` (GR Remark 2.2.12; the case `R⁺ ⊆ R°` of ECD after Definition
3.23). -/
theorem Module.restrictScalars_isEquivalence_of_isAlmostIso (W : Type u) [CommRing W]
    [_root_.Algebra V W] (h : S.IsAlmostIso (_root_.Algebra.linearMap V W)) :
    (Module.restrictScalars S W).IsEquivalence := sorry

/-- P0/change-of-basic-setup: basic setups with the same ideal are equal. -/
theorem BasicSetup.eq_iff_ideal_eq {S₁ S₂ : BasicSetup V} : S₁ = S₂ ↔ S₁.ideal = S₂.ideal :=
  sorry

/-- P0/change-of-basic-setup: base change of setups is transitive (GR Remark 2.1.4(ii)). -/
theorem BasicSetup.baseChange_baseChange (W W' : Type u) [CommRing W] [CommRing W']
    [_root_.Algebra V W] [_root_.Algebra W W'] [_root_.Algebra V W'] [IsScalarTower V W W'] :
    (S.baseChange W).baseChange W' = S.baseChange W' := sorry

/-- P0/change-of-basic-setup: the identification of the almost categories of equal setups. -/
def Module.equivOfEq {S₁ S₂ : BasicSetup V} (h : S₁ = S₂) : Module S₁ ≌ Module S₂ := by
  subst h
  exact CategoryTheory.Equivalence.refl

/-! ## PerfectoidSpaces:P0/almost-algebra-lower-shriek-shriek (construction) -/

/-- P0/almost-algebra-lower-shriek-shriek (constructor): `B ↦ B_!! = (V ⊕ B_!)/I`, `I` spanned by
the `(xy, −x ⊗ y ⊗ 1)` (GR Proposition 2.2.27). -/
def Algebra.shriekShriek : Algebra S ⥤ CommAlgCat.{u} V := sorry

/-- P0/almost-algebra-lower-shriek-shriek (universal-property): `B ↦ B_!!` is left adjoint to
`R ↦ R^a` (GR Proposition 2.2.27; the relative form over `A` is the same with `A_!!`-algebras). -/
def Algebra.shriekShriekAdj : Algebra.shriekShriek S ⊣ Algebra.toAlmost S := sorry

/-- P0/almost-algebra-lower-shriek-shriek (equivalence): the unit `B ≅ (B_!!)^a`
(GR Proposition 2.2.27). -/
def Algebra.shriekShriekUnitIso :
    𝟭 (Algebra S) ≅ Algebra.shriekShriek S ⋙ Algebra.toAlmost S := sorry

/-- P0/almost-algebra-lower-shriek-shriek: the unit almost element `1 ∈ B_*`. -/
def Algebra.oneElement (B : Algebra S) : (Module.elements S).obj B.X :=
  (Functor.Monoidal.εIso (Almost.toAlmost S)).inv ≫ (MonObj.one : 𝟙_ (Module S) ⟶ B.X)

/-- P0/almost-algebra-lower-shriek-shriek: the map `m̃ → V ⊕ B_!`, `x ⊗ y ↦ (xy, −(x ⊗ y ⊗ 1))`
of GR Definition 2.2.25. -/
def Algebra.exactnessMap (B : Algebra S) :
    S.tilde →ₗ[V] V × (S.tilde ⊗[V] (Module.elements S).obj B.X) :=
  LinearMap.prod S.tildeMul ((TensorProduct.mk V S.tilde _).flip (-Algebra.oneElement S B))

/-- P0/almost-algebra-lower-shriek-shriek (data): `B` is *exact* if
`0 → m̃ → V ⊕ B_! → B_!! → 0` is exact, i.e. the first map is injective (GR Definition 2.2.25). -/
def Algebra.IsExact (B : Algebra S) : Prop := Function.Injective (Algebra.exactnessMap S B)

/-- P0/almost-algebra-lower-shriek-shriek (relation): if `m̃ → m` is bijective (e.g. `m` flat),
every almost algebra is exact (GR Remark 2.2.26). -/
theorem Algebra.isExact_of_bijective
    (h : Function.Injective S.tildeMul ∧ LinearMap.range S.tildeMul = S.ideal) (B : Algebra S) :
    Algebra.IsExact S B := sorry

/-- P0/almost-algebra-lower-shriek-shriek (example): `V^a × B` is always exact
(GR Remark 2.2.26). -/
theorem Algebra.isExact_prod (B : Algebra S) :
    Algebra.IsExact S (Algebra.prod S (Algebra.of S V) B) := sorry

/-- P0/almost-algebra-lower-shriek-shriek (instance): `B ↦ B_!!` preserves colimits, in particular
`(B ⊗_A C)_!! ≅ B_!! ⊗_{A_!!} C_!!` (GR Proposition 2.2.27). -/
instance Algebra.shriekShriek_preservesColimits : PreservesColimits (Algebra.shriekShriek S) :=
  sorry

/-- P0/almost-algebra-lower-shriek-shriek (data): the natural map `B_!! → B_*`, an almost
isomorphism (GR Proposition 2.2.27). -/
def Algebra.shriekShriekToElements : Algebra.shriekShriek S ⟶ Algebra.elements S := sorry

-- test Almost.Algebra.shriekShriek_test_unit (computation) [P0/almost-algebra-lower-shriek-shriek]
example : Nonempty ((Algebra.shriekShriek S).obj (Algebra.of S V) ≅ CommAlgCat.of V V) := sorry

/- `O = K°` with residue field `k`: the flat projection `V × V → V` becomes `V ×_k V → V` under
`(−)^a` then `(−)_!!`, which is not flat (GR Remark 3.1.3(ii)). -/
-- test Almost.Algebra.shriekShriek_test_not_flat (non-example)
--   [P0/almost-algebra-lower-shriek-shriek]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) :
    (AlgHom.fst O O O).toRingHom.Flat ∧
    ¬ ((Algebra.shriekShriek (BasicSetup.ofValuationRing O h)).map
      (Algebra.ofHom _ (AlgHom.fst O O O))).hom.toRingHom.Flat := sorry

-- test Almost.Algebra.shriekShriek_test_classical (degenerate)
--   [P0/almost-algebra-lower-shriek-shriek]
example (B : Algebra (BasicSetup.classical V)) :
    IsIso ((Algebra.shriekShriekToElements (BasicSetup.classical V)).app B) := sorry

-- test Almost.Algebra.shriekShriek_test_elements (compatibility)
--   [P0/almost-algebra-lower-shriek-shriek]
example (B : Algebra S) :
    S.IsAlmostIso ((Algebra.shriekShriekToElements S).app B).hom.toLinearMap := sorry

/-! ## PerfectoidSpaces:P0/almost-finitely-generated-and-presented (definition) -/

namespace Module

/-- P0/almost-finitely-generated-and-presented (data): `N^a` is *almost finitely generated*: for
every finitely generated `m₀ ⊆ m` there is `φ : Vⁿ → N` whose cokernel is killed by `m₀`
(GR Proposition 2.3.10(i)). For an almost algebra `A`, apply it to `S.baseChange A_*` and `M_*`. -/
def AlmostFG (S : BasicSetup V) (N : Type*) [AddCommGroup N] [_root_.Module V N] : Prop :=
  ∀ m₀ : Ideal V, m₀ ≤ S.ideal → m₀.FG → ∃ (n : ℕ) (φ : (Fin n → V) →ₗ[V] N),
    ∀ ε ∈ m₀, ∀ x : N, ε • x ∈ LinearMap.range φ

/-- P0/almost-finitely-generated-and-presented (data): *uniformly* almost finitely generated with
bound `n`: one `n` works for every `m₀` (GR Definition 2.3.8(iii), Remark 2.3.9). -/
def UniformlyAlmostFG (S : BasicSetup V) (N : Type*) [AddCommGroup N] [_root_.Module V N]
    (n : ℕ) : Prop :=
  ∀ m₀ : Ideal V, m₀ ≤ S.ideal → m₀.FG → ∃ φ : (Fin n → V) →ₗ[V] N,
    ∀ ε ∈ m₀, ∀ x : N, ε • x ∈ LinearMap.range φ

/-- P0/almost-finitely-generated-and-presented (data): *almost finitely presented*: for every
finitely generated `m₀ ⊆ m` there is a complex `V^k → Vⁿ → N` with `m₀ · coker φ = 0` and
`m₀ · ker φ ⊆ im ψ` (GR Proposition 2.3.10(ii)(c)). -/
def AlmostFP (S : BasicSetup V) (N : Type*) [AddCommGroup N] [_root_.Module V N] : Prop :=
  ∀ m₀ : Ideal V, m₀ ≤ S.ideal → m₀.FG → ∃ (k n : ℕ) (ψ : (Fin k → V) →ₗ[V] (Fin n → V))
    (φ : (Fin n → V) →ₗ[V] N), φ ∘ₗ ψ = 0 ∧ (∀ ε ∈ m₀, ∀ x : N, ε • x ∈ LinearMap.range φ) ∧
      ∀ ε ∈ m₀, ∀ y ∈ LinearMap.ker φ, ε • y ∈ LinearMap.range ψ

variable {N N' : Type*} [AddCommGroup N] [_root_.Module V N] [AddCommGroup N']
  [_root_.Module V N']

/-- P0/almost-finitely-generated-and-presented (extensionality): the three predicates depend only
on `N^a`: they are invariant under almost isomorphisms (GR Proposition 2.3.10). -/
theorem AlmostFG.of_almostIso (f : N →ₗ[V] N') (hf : S.IsAlmostIso f) :
    (AlmostFG S N ↔ AlmostFG S N') ∧ (AlmostFP S N ↔ AlmostFP S N') ∧
      ∀ n, UniformlyAlmostFG S N n ↔ UniformlyAlmostFG S N' n := sorry

/-- P0/almost-finitely-generated-and-presented (compatibility): finitely generated modules are
almost finitely generated (GR Proposition 2.3.10). -/
theorem almostFG_of_finite [_root_.Module.Finite V N] : AlmostFG S N := sorry

/-- P0/almost-finitely-generated-and-presented (compatibility): finitely presented modules are
almost finitely presented (GR Proposition 2.3.10). -/
theorem almostFP_of_finitePresentation [_root_.Module.FinitePresentation V N] : AlmostFP S N :=
  sorry

/-- P0/almost-finitely-generated-and-presented (relation): extensions of almost finitely generated
modules are almost finitely generated (GR Lemma 2.3.17). -/
theorem AlmostFG.extension {N₁ N₂ N₃ : Type*} [AddCommGroup N₁] [_root_.Module V N₁]
    [AddCommGroup N₂] [_root_.Module V N₂] [AddCommGroup N₃] [_root_.Module V N₃]
    (f : N₁ →ₗ[V] N₂) (g : N₂ →ₗ[V] N₃) (hfg : Function.Exact f g) (hf : Function.Injective f)
    (hg : Function.Surjective g) (h₁ : AlmostFG S N₁) (h₃ : AlmostFG S N₃) : AlmostFG S N₂ :=
  sorry

/-- P0/almost-finitely-generated-and-presented: extensions of almost finitely presented modules
are almost finitely presented; for `N₂` almost finitely presented, `N₃` is almost finitely
presented iff `N₁` is almost finitely generated (GR Lemma 2.3.17). -/
theorem AlmostFP.extension {N₁ N₂ N₃ : Type*} [AddCommGroup N₁] [_root_.Module V N₁]
    [AddCommGroup N₂] [_root_.Module V N₂] [AddCommGroup N₃] [_root_.Module V N₃]
    (f : N₁ →ₗ[V] N₂) (g : N₂ →ₗ[V] N₃) (hfg : Function.Exact f g) (hf : Function.Injective f)
    (hg : Function.Surjective g) :
    (AlmostFP S N₁ → AlmostFP S N₃ → AlmostFP S N₂) ∧
      (AlmostFP S N₂ → (AlmostFP S N₃ ↔ AlmostFG S N₁)) := sorry

/-- P0/almost-finitely-generated-and-presented (functoriality): base change along `V → W`
preserves almost finite generation, almost finite presentation and uniform bounds
(GR Proposition 2.3.10). -/
theorem AlmostFG.baseChange (W : Type*) [CommRing W] [_root_.Algebra V W] :
    (AlmostFG S N → AlmostFG (S.baseChange W) (W ⊗[V] N)) ∧
      (AlmostFP S N → AlmostFP (S.baseChange W) (W ⊗[V] N)) ∧
      ∀ n, UniformlyAlmostFG S N n → UniformlyAlmostFG (S.baseChange W) (W ⊗[V] N) n := sorry

/-- P0/almost-finitely-generated-and-presented (characterisation): `N^a` is almost finitely
presented iff `alHom(N^a, −)` commutes with filtered colimits, i.e. for every filtered diagram `F`
the comparison `colim Hom_V(m̃ ⊗ N, F j) → Hom_V(m̃ ⊗ N, colim F)` is an almost isomorphism
(GR Proposition 2.3.15, through P0/almost-hom-formula). -/
theorem almostFP_iff_alHom_colim (N : Type u) [AddCommGroup N] [_root_.Module V N] :
    AlmostFP S N ↔ ∀ (J : Type u) [SmallCategory J] [IsFiltered J] (F : J ⥤ ModuleCat.{u} V),
      S.IsAlmostIso (colimit.post F ((linearCoyoneda V (ModuleCat.{u} V)).obj
        (Opposite.op (ModuleCat.of V (S.tilde ⊗[V] N))))).hom := sorry

/-- P0/almost-finitely-generated-and-presented (characterisation): under condition (A), `N^a` is
almost finitely generated iff for every `ε ∈ m` there is a finitely generated `N_ε → N` with
kernel and cokernel killed by `ε` (P0/almost-finite-generation-epsilon-criterion; Sch12
Definition/Proposition 4.7(iii)). -/
theorem almostFG_iff_epsilon (hA : S.IsFilteredPrincipal) :
    AlmostFG S N ↔ ∀ ε ∈ S.ideal, ∃ (P : Type u) (_ : AddCommGroup P) (_ : _root_.Module V P)
      (_ : _root_.Module.Finite V P) (f : P →ₗ[V] N),
        (∀ x ∈ LinearMap.ker f, ε • x = 0) ∧ ∀ y : N, ε • y ∈ LinearMap.range f := sorry

end Module

/- `K` the completion of `ℚ_p(p^{1/p^∞})`, `p ≠ 2`, `N = 𝒪_{K(√p)}`; `hR` records the free rank-2
submodules `R_n = K° ⊕ p^{1/2p^n} K°` whose cokernels are killed by `p^{1/p^{n-1}}`
(Bhatt Example 4.2.7). -/
-- test Almost.Module.AlmostFG_test_quadratic (computation)
--   [P0/almost-finitely-generated-and-presented]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) (N : Type u) [AddCommGroup N] [_root_.Module O N]
    (hR : ∀ ε ∈ IsLocalRing.maximalIdeal O, ∃ φ : (Fin 2 → O) →ₗ[O] N,
      Function.Injective φ ∧ ∀ x : N, ε • x ∈ LinearMap.range φ) :
    Module.UniformlyAlmostFG (BasicSetup.ofValuationRing O h) N 2 ∧
      Module.AlmostFP (BasicSetup.ofValuationRing O h) N := sorry

-- test Almost.Module.AlmostFG_test_zero (degenerate) [P0/almost-finitely-generated-and-presented]
example (N : Type u) [AddCommGroup N] [_root_.Module V N] (hN : S.IsAlmostZero N) :
    Module.UniformlyAlmostFG S N 0 ∧ Module.AlmostFP S N := sorry

-- test Almost.Module.AlmostFG_test_classical (compatibility)
--   [P0/almost-finitely-generated-and-presented]
example (N : Type u) [AddCommGroup N] [_root_.Module V N] :
    (Module.AlmostFG (BasicSetup.classical V) N ↔ _root_.Module.Finite V N) ∧
      (Module.AlmostFP (BasicSetup.classical V) N ↔ _root_.Module.FinitePresentation V N) :=
  sorry

-- test Almost.Module.AlmostFG_test_infinite_sum (non-example)
--   [P0/almost-finitely-generated-and-presented]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) :
    ¬ Module.AlmostFG (BasicSetup.ofValuationRing O h) (ℕ →₀ O) := sorry

/-! ## PerfectoidSpaces:P0/almost-flat-projective-finiteness (definition) -/

namespace Module

variable {S}

/-- P0/almost-flat-projective-finiteness (data): `X` is *flat* if `X ⊗ −` is exact
(GR Definition 2.4.4; `X ⊗ −` is always right exact). -/
class Flat (X : Module S) : Prop where
  /-- `X ⊗ −` preserves finite limits. -/
  preservesFiniteLimits : PreservesFiniteLimits (tensorLeft X)

/-- P0/almost-flat-projective-finiteness (data): *faithfully flat*: flat, and `X ⊗ Y ≅ 0` only
for `Y ≅ 0` (GR Definition 2.4.4). -/
class FaithfullyFlat (X : Module S) : Prop extends Flat X where
  /-- `X ⊗ −` reflects zero objects. -/
  isZero_of_isZero_tensor : ∀ Y : Module S, IsZero (X ⊗ Y) → IsZero Y

/-- P0/almost-flat-projective-finiteness (data): *almost projective*: `alHom(X, −)` is exact, i.e.
preserves epimorphisms (GR Definition 2.4.4); categorical projectivity is never used. -/
class AlmostProjective (X : Module S) : Prop where
  /-- `alHom(X, −)` preserves epimorphisms. -/
  preservesEpimorphisms : (ihom X).PreservesEpimorphisms

/-- P0/almost-flat-projective-finiteness (data): *almost finite projective*: almost projective and
almost finitely generated (on `X_*`) (GR Definition 2.4.4, KL Definition 5.5.8). -/
def AlmostFiniteProjective (X : Module S) : Prop :=
  AlmostProjective X ∧ AlmostFG S ((Module.elements S).obj X)

/-- P0/almost-flat-projective-finiteness (data): *uniformly almost finite projective* with bound
`n` (KL Definition 5.5.8). -/
def UniformlyAlmostFiniteProjective (X : Module S) (n : ℕ) : Prop :=
  AlmostProjective X ∧ UniformlyAlmostFG S ((Module.elements S).obj X) n

/-- P0/almost-flat-projective-finiteness (compatibility): `N` flat implies `N^a` flat
(GR (2.4.8)). -/
theorem flat_toAlmost (N : ModuleCat.{u} V) [_root_.Module.Flat V N] :
    Flat ((toAlmost S).obj N) := sorry

/-- P0/almost-flat-projective-finiteness (compatibility): `N` faithfully flat implies `N^a`
faithfully flat (GR (2.4.8)). -/
theorem faithfullyFlat_toAlmost (N : ModuleCat.{u} V) [_root_.Module.FaithfullyFlat V N] :
    FaithfullyFlat ((toAlmost S).obj N) := sorry

/-- P0/almost-flat-projective-finiteness (compatibility): `N` projective implies `N^a` almost
projective (GR (2.4.8)). -/
theorem almostProjective_toAlmost (N : ModuleCat.{u} V) [_root_.Module.Projective V N] :
    AlmostProjective ((toAlmost S).obj N) := sorry

/-- P0/almost-flat-projective-finiteness (relation): almost projective modules are flat
(GR Remark 2.4.12(i)). -/
theorem AlmostProjective.flat (X : Module S) [AlmostProjective X] : Flat X := sorry

/-- P0/almost-flat-projective-finiteness (structure): flatness and almost projectivity are stable
under `⊗` and under base change (GR Lemma 2.4.7). -/
theorem Flat.tensor (X Y : Module S) :
    (Flat X → Flat Y → Flat (X ⊗ Y)) ∧
      (AlmostProjective X → AlmostProjective Y → AlmostProjective (X ⊗ Y)) := sorry

/-- P0/almost-flat-projective-finiteness (structure): flatness and almost projectivity are stable
under base change `W ⊗ −` (GR Lemma 2.4.7). -/
theorem Flat.extendScalars (W : Type u) [CommRing W] [_root_.Algebra V W] (X : Module S) :
    (Flat X → Flat ((Module.extendScalars S W).obj X)) ∧
      (AlmostProjective X → AlmostProjective ((Module.extendScalars S W).obj X)) := sorry

/-- P0/almost-flat-projective-finiteness (functoriality): a flat module over a flat `V`-algebra `R`
is flat over `V` (GR Lemma 2.4.7). -/
theorem Flat.trans (R : Type u) [CommRing R] [_root_.Algebra V R]
    (hR : Flat ((toAlmost S).obj (ModuleCat.of V R))) (N : Type u) [AddCommGroup N]
    [_root_.Module R N] [_root_.Module V N] [IsScalarTower V R N]
    (hN : Flat ((toAlmost (S.baseChange R)).obj (ModuleCat.of R N))) :
    Flat ((toAlmost S).obj (ModuleCat.of V N)) := sorry

/-- P0/almost-flat-projective-finiteness (characterisation): `N^a` is flat iff `Tor_i^V(N, X)` is
almost zero for all `X` and `i > 0` (P0/almost-flatness-tor-criterion; GR (2.4.10)). -/
theorem flat_iff_tor (N : ModuleCat.{u} V) :
    Flat ((toAlmost S).obj N) ↔ ∀ (X : ModuleCat.{u} V) (i : ℕ), 0 < i →
      S.IsAlmostZero (((Tor (ModuleCat.{u} V) i).obj N).obj X) := sorry

/-- P0/almost-flat-projective-finiteness (characterisation): for `X` almost finitely generated,
`X` is almost projective iff for every `ε ∈ m` the endomorphism `ε • 𝟙 X` factors through a
finite free module (P0/almost-projective-epsilon-factorisation; GR Lemma 2.4.15). -/
theorem almostProjective_iff_factor (X : Module S)
    (hX : AlmostFG S ((Module.elements S).obj X)) :
    AlmostProjective X ↔ ∀ ε ∈ S.ideal, ∃ (n : ℕ)
      (u : X ⟶ (toAlmost S).obj (ModuleCat.of V (Fin n → V)))
      (v : (toAlmost S).obj (ModuleCat.of V (Fin n → V)) ⟶ X), u ≫ v = ε • 𝟙 X := sorry

/-- P0/almost-flat-projective-finiteness (characterisation): almost finite projective iff flat and
almost finitely presented (P0/almost-finite-projective-iff; GR Proposition 2.4.18, Sch12
Proposition 4.10). -/
theorem almostFiniteProjective_iff (X : Module S) :
    AlmostFiniteProjective X ↔ Flat X ∧ AlmostFP S ((Module.elements S).obj X) := sorry

end Module

/- `O = K°`, `π ∈ K°°` nonzero: `(K°)^a` is flat and `(K°/π)^a` is not. -/
-- test Almost.Module.Flat_test_valuation (computation) [P0/almost-flat-projective-finiteness]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) (π : O) (hπ : π ∈ IsLocalRing.maximalIdeal O)
    (hπ0 : π ≠ 0) :
    Module.Flat ((toAlmost (BasicSetup.ofValuationRing O h)).obj (ModuleCat.of O O)) ∧
      ¬ Module.Flat ((toAlmost (BasicSetup.ofValuationRing O h)).obj
        (ModuleCat.of O (O ⧸ Ideal.span {π}))) := sorry

-- test Almost.Module.AlmostProjective_test_not_projective (non-example)
--   [P0/almost-flat-projective-finiteness]
example [IsLocalRing V] (h : S.ideal ≠ ⊤) (h0 : S.ideal ≠ ⊥) :
    Module.AlmostProjective ((toAlmost S).obj (ModuleCat.of V V)) ∧
      ¬ Projective ((toAlmost S).obj (ModuleCat.of V V)) := sorry

-- test Almost.Module.Flat_test_classical (compatibility) [P0/almost-flat-projective-finiteness]
example (N : ModuleCat.{u} V) :
    (Module.Flat ((toAlmost (BasicSetup.classical V)).obj N) ↔ _root_.Module.Flat V N) ∧
    (Module.FaithfullyFlat ((toAlmost (BasicSetup.classical V)).obj N) ↔
      _root_.Module.FaithfullyFlat V N) ∧
    (Module.AlmostProjective ((toAlmost (BasicSetup.classical V)).obj N) ↔
      _root_.Module.Projective V N) := sorry

-- test Almost.Module.FaithfullyFlat_test_zero (degenerate) [P0/almost-flat-projective-finiteness]
example (Z : Module S) (hZ : IsZero Z) (hS : ¬ IsZero (𝟙_ (Module S))) :
    Module.Flat Z ∧ Module.AlmostProjective Z ∧ ¬ Module.FaithfullyFlat Z := sorry

/-! ## PerfectoidSpaces:P0/almost-flatness-tor-criterion (lemma) -/

/-- P0/almost-flatness-tor-criterion (iii): `N^a` is almost projective iff `m` kills
`Ext^i_V(N, X)` for all `X` and `i > 0`; `ε` acts by precomposition with `ε • 𝟙 N`
(GR Remark 2.4.12(i)). -/
theorem Module.almostProjective_iff_ext [HasExt.{u} (ModuleCat.{u} V)] (N : ModuleCat.{u} V) :
    Module.AlmostProjective ((toAlmost S).obj N) ↔ ∀ (X : ModuleCat.{u} V) (i : ℕ), 0 < i →
      ∀ ε ∈ S.ideal, ∀ e : Abelian.Ext N X i, (Abelian.Ext.mk₀ (ε • 𝟙 N)).comp e (zero_add i) = 0 :=
  sorry

/-- P0/almost-flatness-tor-criterion (iv): `N^a` is faithfully flat iff it is flat and
`N ⊗_V X` almost zero implies `X` almost zero (Sch12 Definition/Proposition 4.7(i)). -/
theorem Module.faithfullyFlat_iff (N : ModuleCat.{u} V) :
    Module.FaithfullyFlat ((toAlmost S).obj N) ↔ Module.Flat ((toAlmost S).obj N) ∧
      ∀ X : ModuleCat.{u} V, S.IsAlmostZero (N ⊗[V] X) → S.IsAlmostZero X := sorry

/-- P0/almost-flatness-tor-criterion (i): `Tor_i^V(−, N)` carries almost isomorphisms to almost
isomorphisms, so `Tor_i^V(M, N)^a` depends only on `M^a`; this is the form in which
`Tor_i^{V^a}(M^a, N^a) ≅ Tor_i^V(M, N)^a` is used (Mathlib's `Tor` needs projective resolutions,
which `V^a-Mod` lacks) (GR (2.4.10)). -/
theorem isAlmostIso_tor_map {M M' : ModuleCat.{u} V} (f : M ⟶ M') (hf : S.IsAlmostIso f.hom)
    (N : ModuleCat.{u} V) (i : ℕ) :
    S.IsAlmostIso (((Tor (ModuleCat.{u} V) i).map f).app N).hom := sorry

/-! ## PerfectoidSpaces:P0/almost-projective-epsilon-factorisation (lemma) -/

/-- P0/almost-projective-epsilon-factorisation (i): `X` is almost projective iff for every `ε ∈ m`
the endomorphism `ε • 𝟙 X` factors through a free module `A^{(I)}` (GR Lemma 2.4.15). -/
theorem Module.almostProjective_iff_factor_free (X : Module S) :
    Module.AlmostProjective X ↔ ∀ ε ∈ S.ideal, ∃ (I : Type u)
      (u : X ⟶ (toAlmost S).obj (ModuleCat.of V (I →₀ V)))
      (v : (toAlmost S).obj (ModuleCat.of V (I →₀ V)) ⟶ X), u ≫ v = ε • 𝟙 X := sorry

/-- P0/almost-projective-epsilon-factorisation (ii): uniformly almost finite projective with bound
`n` iff every `ε • 𝟙 X` factors through `Vⁿ` with `n` independent of `ε` (GR Lemma 2.4.15,
KL Definition 5.5.8). -/
theorem Module.uniformlyAlmostFiniteProjective_iff_factor (X : Module S) (n : ℕ) :
    Module.UniformlyAlmostFiniteProjective X n ↔ ∀ ε ∈ S.ideal, ∃
      (u : X ⟶ (toAlmost S).obj (ModuleCat.of V (Fin n → V)))
      (v : (toAlmost S).obj (ModuleCat.of V (Fin n → V)) ⟶ X), u ≫ v = ε • 𝟙 X := sorry

/-! ## PerfectoidSpaces:P0/almost-finite-generation-epsilon-criterion (lemma) -/

/-- P0/almost-finite-generation-epsilon-criterion: under condition (A), `N^a` is almost finitely
presented iff for every `ε ∈ m` there is a finitely presented `N_ε → N` with kernel and cokernel
killed by `ε` (GR Remark 2.3.9, Sch12 Definition/Proposition 4.7(iii)). -/
theorem Module.almostFP_iff_epsilon (hA : S.IsFilteredPrincipal) (N : Type*) [AddCommGroup N]
    [_root_.Module V N] :
    Module.AlmostFP S N ↔ ∀ ε ∈ S.ideal, ∃ (P : Type u) (_ : AddCommGroup P)
      (_ : _root_.Module V P) (_ : _root_.Module.FinitePresentation V P) (f : P →ₗ[V] N),
        (∀ x ∈ LinearMap.ker f, ε • x = 0) ∧ ∀ y : N, ε • y ∈ LinearMap.range f := sorry

/-- P0/almost-finite-generation-epsilon-criterion: under condition (A), uniformly almost finitely
generated with bound `n` iff for every `ε ∈ m` some `Vⁿ → N` has cokernel killed by `ε`
(GR Remark 2.3.9). -/
theorem Module.uniformlyAlmostFG_iff_epsilon (hA : S.IsFilteredPrincipal) (N : Type*)
    [AddCommGroup N] [_root_.Module V N] (n : ℕ) :
    Module.UniformlyAlmostFG S N n ↔ ∀ ε ∈ S.ideal, ∃ φ : (Fin n → V) →ₗ[V] N,
      ∀ y : N, ε • y ∈ LinearMap.range φ := sorry

/-! ## PerfectoidSpaces:P0/almost-finite-projective-iff (lemma) -/

/-- P0/almost-finite-projective-iff (iii): if `R^a → R'^a` is a monomorphism and `N` is almost
finitely generated with `N^a` flat and `R' ⊗_R N` almost finitely presented, then `N` is almost
finitely presented (Sch12 after Proposition 4.10). -/
theorem Module.almostFP_of_mono_baseChange {R : Type u} [CommRing R] (T : BasicSetup R)
    (R' : Type u) [CommRing R'] [_root_.Algebra R R']
    (hmono : Mono ((toAlmost T).map (ModuleCat.ofHom (_root_.Algebra.linearMap R R'))))
    (N : Type u) [AddCommGroup N] [_root_.Module R N] (hfg : Module.AlmostFG T N)
    (hflat : Module.Flat ((toAlmost T).obj (ModuleCat.of R N)))
    (hfp : Module.AlmostFP (T.baseChange R') (R' ⊗[R] N)) : Module.AlmostFP T N := sorry

/-! ## PerfectoidSpaces:P0/tensor-hom-comparison-almost-projective (lemma) -/

/-- P0/tensor-hom-comparison-almost-projective: the natural map
`E ⊗ alHom(F, N) ⟶ alHom(F, E ⊗ N)` (GR (2.4.27)). -/
def Module.tensorIhomMap (E F N : Module S) : E ⊗ (ihom F).obj N ⟶ (ihom F).obj (E ⊗ N) :=
  MonoidalClosed.curry ((α_ F E _).inv ≫ (β_ F E).hom ▷ _ ≫ (α_ E F _).hom ≫
    E ◁ (ihom.ev F).app N)

/-- P0/tensor-hom-comparison-almost-projective (i): the comparison is an isomorphism if `E` or `F`
is almost finite projective (GR Lemma 2.4.29). -/
theorem Module.isIso_tensorIhomMap (E F N : Module S)
    (h : Module.AlmostFiniteProjective E ∨ Module.AlmostFiniteProjective F) :
    IsIso (Module.tensorIhomMap S E F N) := sorry

/-- P0/tensor-hom-comparison-almost-projective (i): the comparison is an isomorphism if `E` is flat
and `F` almost finitely presented (GR Lemma 2.4.29(i)(b)). -/
theorem Module.isIso_tensorIhomMap_of_flat (E F N : Module S) (hE : Module.Flat E)
    (hF : Module.AlmostFP S ((Module.elements S).obj F)) :
    IsIso (Module.tensorIhomMap S E F N) := sorry

/-- P0/tensor-hom-comparison-almost-projective (ii): the comparison is a monomorphism if `E` is
flat and `F` almost finitely generated, or `E` almost projective (GR Lemma 2.4.29). -/
theorem Module.mono_tensorIhomMap (E F N : Module S)
    (h : (Module.Flat E ∧ Module.AlmostFG S ((Module.elements S).obj F)) ∨
      Module.AlmostProjective E) :
    Mono (Module.tensorIhomMap S E F N) := sorry

/-! ## PerfectoidSpaces:P0/almost-dual-and-trace (construction) -/

namespace Module

/-- P0/almost-dual-and-trace (constructor): the dual `P* := alHom(P, 𝟙)`, with evaluation
`(ihom.ev P).app 𝟙 : P ⊗ P* ⟶ 𝟙` (GR Definition 4.1.1). -/
def dual (P : Module S) : Module S := (ihom P).obj (𝟙_ (Module S))

/-- P0/almost-dual-and-trace (equivalence): `ω_{P/A} : P ⊗ P* ≅ End(P)^a` for `P` almost finite
projective, the comparison of P0/tensor-hom-comparison-almost-projective (GR Lemma 2.4.31(ii)). -/
def dualTensorHomIso (P : Module S) (hP : AlmostFiniteProjective P) :
    P ⊗ dual S P ≅ (ihom P).obj P :=
  @asIso _ _ _ _ (tensorIhomMap S P P (𝟙_ (Module S)) ≫ (ihom P).map (ρ_ P).hom) sorry

/-- P0/almost-dual-and-trace (constructor): the trace `tr_{P/A} := ev ∘ ω⁻¹ : End(P)^a ⟶ 𝟙`
(GR Definition 4.1.1). -/
def trace (P : Module S) (hP : AlmostFiniteProjective P) : (ihom P).obj P ⟶ 𝟙_ (Module S) :=
  (dualTensorHomIso S P hP).inv ≫ (ihom.ev P).app (𝟙_ (Module S))

/-- P0/almost-dual-and-trace: the trace of an endomorphism `φ`, an endomorphism of the unit (an
almost element of `V^a`) (GR Definition 4.1.1). -/
def traceEnd (P : Module S) (hP : AlmostFiniteProjective P) (φ : P ⟶ P) :
    𝟙_ (Module S) ⟶ 𝟙_ (Module S) :=
  MonoidalClosed.curry ((ρ_ P).hom ≫ φ) ≫ trace S P hP

/-- P0/almost-dual-and-trace (relation): `tr(ψ ∘ φ) = tr(φ ∘ ψ)` (GR Lemma 4.1.2). -/
theorem trace_comp_comm (M N : Module S) (hM : AlmostFiniteProjective M)
    (hN : AlmostFiniteProjective N) (φ : M ⟶ N) (ψ : N ⟶ M) :
    traceEnd S M hM (φ ≫ ψ) = traceEnd S N hN (ψ ≫ φ) := sorry

/-- P0/almost-dual-and-trace (relation): `tr(φ ⊗ ψ) = tr(φ) · tr(ψ)`, the product of `End(𝟙)`
being composition (GR Lemma 4.1.2). -/
theorem trace_tensor (M N : Module S) (hM : AlmostFiniteProjective M)
    (hN : AlmostFiniteProjective N) (hMN : AlmostFiniteProjective (M ⊗ N)) (φ : M ⟶ M)
    (ψ : N ⟶ N) :
    traceEnd S (M ⊗ N) hMN (φ ⊗ₘ ψ) = traceEnd S M hM φ ≫ traceEnd S N hN ψ := sorry

/-- P0/almost-dual-and-trace (relation): additivity of the trace on short exact sequences of almost
finite projective modules with compatible endomorphisms (GR Lemma 4.1.2). -/
theorem trace_additive (sc : ShortComplex (Module S)) (hsc : sc.ShortExact)
    (h₁ : AlmostFiniteProjective sc.X₁) (h₂ : AlmostFiniteProjective sc.X₂)
    (h₃ : AlmostFiniteProjective sc.X₃) (φ : sc ⟶ sc) :
    traceEnd S _ h₂ φ.τ₂ = traceEnd S _ h₁ φ.τ₁ + traceEnd S _ h₃ φ.τ₃ := sorry

/-- P0/almost-dual-and-trace: the biduality map `P ⟶ P**` (GR Lemma 2.4.31(ii)). -/
def toDoubleDual (P : Module S) : P ⟶ dual S (dual S P) :=
  MonoidalClosed.curry ((β_ (dual S P) P).hom ≫ (ihom.ev P).app (𝟙_ (Module S)))

/-- P0/almost-dual-and-trace (characterisation): an almost finite projective module is reflexive
(GR Lemma 2.4.31(ii)). -/
theorem isReflexive (P : Module S) (hP : AlmostFiniteProjective P) :
    IsIso (toDoubleDual S P) := sorry

end Module

section trace

variable {R : Type u} [CommRing R] (T : BasicSetup R)

/-- P0/almost-dual-and-trace: `R'^a` as an almost `R`-module, for a setup `T` on `R` and an
`R`-algebra `R'` (the honest representative of an almost algebra). -/
abbrev relModule (R' : Type u) [CommRing R'] [_root_.Algebra R R'] : Module T :=
  (toAlmost T).obj (ModuleCat.of R R')

variable (R' : Type u) [CommRing R'] [_root_.Algebra R R']

/-- P0/almost-dual-and-trace (constructor): the almost trace `Tr_{R'^a/R^a} := tr ∘ μ : R'^a ⟶ R^a`
for `R'^a` almost finite projective over `R^a` (GR Definition 4.1.1, (4.1.7)). -/
def Algebra.trace (h : Module.AlmostFiniteProjective (relModule T R')) :
    relModule T R' ⟶ relModule T R := sorry

/-- P0/almost-dual-and-trace (compatibility): `Tr_{C ⊗ R'/C} = 1_C ⊗ Tr_{R'/R}` (GR Lemma
4.1.2). -/
theorem Algebra.trace_baseChange (C : Type u) [CommRing C] [_root_.Algebra R C]
    (h : Module.AlmostFiniteProjective (relModule T R'))
    (h' : Module.AlmostFiniteProjective (relModule (T.baseChange C) (C ⊗[R] R'))) :
    ∃ (e₁ : (Module.extendScalars T C).obj (relModule T R') ≅
          relModule (T.baseChange C) (C ⊗[R] R'))
      (e₂ : (Module.extendScalars T C).obj (relModule T R) ≅ relModule (T.baseChange C) C),
      (Module.extendScalars T C).map (Algebra.trace T R' h) ≫ e₂.hom =
        e₁.hom ≫ Algebra.trace (T.baseChange C) (C ⊗[R] R') h' := sorry

/-- P0/almost-dual-and-trace (functoriality): `Tr_{R''/R} = Tr_{R'/R} ∘ Tr_{R''/R'}` (GR Lemma
4.1.2). -/
theorem Algebra.trace_trans (R'' : Type u) [CommRing R''] [_root_.Algebra R' R'']
    [_root_.Algebra R R''] [IsScalarTower R R' R'']
    (h₁ : Module.AlmostFiniteProjective (relModule T R'))
    (h₂ : Module.AlmostFiniteProjective (relModule (T.baseChange R') R''))
    (h₁₂ : Module.AlmostFiniteProjective (relModule T R'')) :
    ∃ (e₁ : (Module.restrictScalars T R').obj (relModule (T.baseChange R') R'') ≅
          relModule T R'')
      (e₂ : (Module.restrictScalars T R').obj (relModule (T.baseChange R') R') ≅
          relModule T R'),
      Algebra.trace T R'' h₁₂ = e₁.inv ≫
        (Module.restrictScalars T R').map (Algebra.trace (T.baseChange R') R'' h₂) ≫
          e₂.hom ≫ Algebra.trace T R' h₁ := sorry

/-- P0/almost-dual-and-trace (simp): if `R → R'` is an isomorphism, `Tr_{R'/R}` is its inverse
(GR Lemma 4.1.2). -/
theorem Algebra.trace_of_iso (e : R ≃ₐ[R] R')
    (h : Module.AlmostFiniteProjective (relModule T R')) :
    Algebra.trace T R' h = (Almost.toAlmost T).map (ModuleCat.ofHom e.symm.toLinearMap) := sorry

/-- P0/almost-dual-and-trace (constructor): the trace form `t(b, b') = Tr(bb')`,
`(R' ⊗_R R')^a ⟶ R^a` (GR Definition 4.1.1). -/
def Algebra.traceForm (h : Module.AlmostFiniteProjective (relModule T R')) :
    relModule T (R' ⊗[R] R') ⟶ relModule T R :=
  (Almost.toAlmost T).map (ModuleCat.ofHom (_root_.Algebra.TensorProduct.lmul' R).toLinearMap) ≫
    Algebra.trace T R' h

/-- P0/almost-dual-and-trace: `τ : R'^a ⟶ (R'^a)*` induced by the trace form
(GR Definition 4.1.1). -/
def Algebra.traceFormDual (h : Module.AlmostFiniteProjective (relModule T R')) :
    relModule T R' ⟶ Module.dual T (relModule T R') :=
  MonoidalClosed.curry ((Functor.Monoidal.μIso (Almost.toAlmost T) _ _).hom ≫
    Algebra.traceForm T R' h ≫ (Functor.Monoidal.εIso (Almost.toAlmost T)).inv)

/-- P0/almost-dual-and-trace (data): the trace form is *perfect*: `τ` is an isomorphism
(GR Definition 4.1.1). -/
def Algebra.IsPerfectTraceForm (h : Module.AlmostFiniteProjective (relModule T R')) : Prop :=
  IsIso (Algebra.traceFormDual T R' h)

/-- P0/almost-dual-and-trace (compatibility): the trace form dual is compatible with base change,
so perfect trace forms stay perfect (GR Lemma 4.1.13). -/
theorem Algebra.traceFormDual_baseChange (C : Type u) [CommRing C] [_root_.Algebra R C]
    (h : Module.AlmostFiniteProjective (relModule T R'))
    (h' : Module.AlmostFiniteProjective (relModule (T.baseChange C) (C ⊗[R] R')))
    (hP : Algebra.IsPerfectTraceForm T R' h) :
    Algebra.IsPerfectTraceForm (T.baseChange C) (C ⊗[R] R') h' := sorry

end trace

-- test Almost.Module.trace_test_free (compatibility) [P0/almost-dual-and-trace]
example (n : ℕ) (f : (Fin n → V) →ₗ[V] (Fin n → V))
    (hP : Module.AlmostFiniteProjective ((toAlmost S).obj (ModuleCat.of V (Fin n → V)))) :
    Module.traceEnd S _ hP ((toAlmost S).map (ModuleCat.ofHom f)) =
      LinearMap.trace V _ f • 𝟙 (𝟙_ (Module S)) := sorry

/- `K` the completion of `ℚ_p(p^{1/p^∞})`, `O' = 𝒪_{K(√p)}`, `p ≠ 2`; `he` records the almost
diagonal idempotent of Bhatt Example 4.3.2. -/
-- test Almost.Algebra.trace_test_quadratic (computation) [P0/almost-dual-and-trace]
example (O O' : Type u) [CommRing O] [IsDomain O] [ValuationRing O] [CommRing O']
    [_root_.Algebra O O'] (h : ¬ (IsLocalRing.maximalIdeal O).FG)
    (hP : Module.AlmostFiniteProjective (relModule (BasicSetup.ofValuationRing O h) O'))
    (he : ∀ ε ∈ IsLocalRing.maximalIdeal O, ∃ e : O' ⊗[O] O',
      _root_.Algebra.TensorProduct.lmul' O e = algebraMap O O' ε ∧ e * e = ε • e ∧
        ∀ x, _root_.Algebra.TensorProduct.lmul' O x = 0 → x * e = 0) :
    Algebra.IsPerfectTraceForm (BasicSetup.ofValuationRing O h) O' hP := sorry

-- test Almost.Module.trace_test_zero (degenerate) [P0/almost-dual-and-trace]
example (Z : Module S) (hZ : IsZero Z) (hP : Module.AlmostFiniteProjective Z) :
    Module.traceEnd S Z hP (𝟙 Z) = 0 := sorry

/- `L°` is not a free `K°`-module, so Mathlib's `LinearMap.trace` of a representative vanishes,
while the almost trace of `1` is `2`. -/
-- test Almost.Module.trace_test_not_linearMap_trace (non-example) [P0/almost-dual-and-trace]
example (O : Type u) [CommRing O] (N : Type u) [AddCommGroup N] [_root_.Module O N]
    (hN : ¬ ∃ s : Finset N, Nonempty (_root_.Module.Basis s O N)) :
    LinearMap.trace O N LinearMap.id = 0 := sorry

/-! ## PerfectoidSpaces:P0/rank-decomposition-of-finite-projective (theorem) -/

section rank

variable {R : Type u} [CommRing R] (T : BasicSetup R)

/-- P0/rank-decomposition-of-finite-projective: an almost module `L` is *invertible* if the
evaluation `L ⊗ L* ⟶ 𝟙` is an isomorphism (GR Definition 4.3.9(iv)). -/
def Module.IsInvertibleAlmost {R₁ : Type u} [CommRing R₁] {T₁ : BasicSetup R₁} (L : Module T₁) :
    Prop :=
  IsIso ((ihom.ev L).app (𝟙_ (Module T₁)))

/-- P0/rank-decomposition-of-finite-projective: under condition (B), an almost projective module
with `Λ^r P ≅ 0` decomposes along idempotents `e_0, …, e_{r-1}` into pieces of constant rank `i`
(`Λ^{i+1} P_i ≅ 0`, `Λ^i P_i` invertible), for `R` equal to its almost elements (`hclosed`)
(GR Proposition 4.3.27). -/
theorem Module.exists_rank_decomposition (hB : T.PowersGenerate)
    (hclosed : IsIso ((Algebra.adj T).unit.app (CommAlgCat.of R R))) (N : Type u)
    [AddCommGroup N] [_root_.Module R N] (r : ℕ)
    (hN : Module.AlmostProjective ((toAlmost T).obj (ModuleCat.of R N)))
    (hΛ : T.IsAlmostZero (ExteriorAlgebra.exteriorPower R r N)) :
    ∃ e : Fin r → R, (∀ i, IsIdempotentElem (e i)) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧
      ∑ i, e i = 1 ∧ ∀ i : Fin r,
        (T.baseChange (Localization.Away (e i))).IsAlmostZero
          (ExteriorAlgebra.exteriorPower (Localization.Away (e i)) ((i : ℕ) + 1)
            (LocalizedModule (Submonoid.powers (e i)) N)) ∧
        Module.IsInvertibleAlmost ((toAlmost (T.baseChange (Localization.Away (e i)))).obj
          (ModuleCat.of _ (ExteriorAlgebra.exteriorPower (Localization.Away (e i)) i
            (LocalizedModule (Submonoid.powers (e i)) N)))) := sorry

/-- P0/rank-decomposition-of-finite-projective: under condition (B), a uniformly almost finite
projective module has finite rank, `Λ^{n+1} P ≅ 0` (GR Remark 4.3.10(i)). -/
theorem Module.finiteRank_of_uniformlyAlmostFG (hB : T.PowersGenerate) (N : Type u)
    [AddCommGroup N] [_root_.Module R N] (n : ℕ)
    (hN : Module.AlmostProjective ((toAlmost T).obj (ModuleCat.of R N)))
    (hU : Module.UniformlyAlmostFG T N n) :
    T.IsAlmostZero (ExteriorAlgebra.exteriorPower R (n + 1) N) := sorry

end rank

/-! ## PerfectoidSpaces:P0/almost-finite-projective-and-finite-etale-algebras (definition) -/

section etale

variable {R : Type u} [CommRing R] (T : BasicSetup R) (R' : Type u) [CommRing R']
  [_root_.Algebra R R']

/-- P0/almost-finite-projective-and-finite-etale-algebras: `R'^a` as an almost
`(R' ⊗_R R')`-module through the multiplication `μ : R' ⊗_R R' → R'` (GR Definition 3.1.1). -/
abbrev diagModule : Module (T.baseChange (R' ⊗[R] R')) :=
  letI : _root_.Module (R' ⊗[R] R') R' :=
    (_root_.Algebra.TensorProduct.lmul' R).toRingHom.toModule
  (toAlmost (T.baseChange (R' ⊗[R] R'))).obj (ModuleCat.of (R' ⊗[R] R') R')

/-- P0/almost-finite-projective-and-finite-etale-algebras: `R^a → R'^a` is *flat*
(GR Definition 3.1.1(i)). -/
def IsAlmostFlatAlg : Prop := Module.Flat (relModule T R')

/-- P0/almost-finite-projective-and-finite-etale-algebras: `R^a → R'^a` is *faithfully flat*
(GR Definition 3.1.1(i)). -/
def IsAlmostFaithfullyFlatAlg : Prop := Module.FaithfullyFlat (relModule T R')

/-- P0/almost-finite-projective-and-finite-etale-algebras: *unramified*: `R'^a` is almost
projective over `(R' ⊗_R R')^a` (GR Definition 3.1.1(iii)). -/
def IsAlmostUnramifiedAlg : Prop := Module.AlmostProjective (diagModule T R')

/-- P0/almost-finite-projective-and-finite-etale-algebras: *weakly unramified*: `R'^a` is flat
over `(R' ⊗_R R')^a` (GR Definition 3.1.1(iii)). -/
def IsAlmostWeaklyUnramifiedAlg : Prop := Module.Flat (diagModule T R')

/-- P0/almost-finite-projective-and-finite-etale-algebras: *étale*: flat and unramified
(GR Definition 3.1.1(iv)). -/
def IsAlmostEtaleAlg : Prop := IsAlmostFlatAlg T R' ∧ IsAlmostUnramifiedAlg T R'

/-- P0/almost-finite-projective-and-finite-etale-algebras: *weakly étale*: flat and weakly
unramified (GR Definition 3.1.1(iv)). -/
def IsAlmostWeaklyEtaleAlg : Prop := IsAlmostFlatAlg T R' ∧ IsAlmostWeaklyUnramifiedAlg T R'

/-- P0/almost-finite-projective-and-finite-etale-algebras: *finite étale*: étale and almost
finitely presented (Sch12 Definition 4.13, GR `A-Ét_afp`). -/
def IsAlmostFiniteEtaleAlg : Prop := IsAlmostEtaleAlg T R' ∧ Module.AlmostFP T R'

end etale

namespace Algebra

variable {S}

/-- P0/almost-finite-projective-and-finite-etale-algebras: the `A_*`-algebra structure on `B_*`
given by `f : A ⟶ B` (GR Remark 2.2.12). -/
abbrev algebraOfHom {A B : Algebra S} (f : A ⟶ B) :
    _root_.Algebra ((Algebra.elements S).obj A) ((Algebra.elements S).obj B) :=
  ((Algebra.elements S).map f).hom.toRingHom.toAlgebra

/-- P0/almost-finite-projective-and-finite-etale-algebras (data): `f : A ⟶ B` is *flat*: `B` is a
flat `A`-module (GR Definition 3.1.1(i)). -/
def IsFlat {A B : Algebra S} (f : A ⟶ B) : Prop :=
  letI := algebraOfHom f
  IsAlmostFlatAlg (S.baseChange ((Algebra.elements S).obj A)) ((Algebra.elements S).obj B)

/-- P0/almost-finite-projective-and-finite-etale-algebras: `f` is *faithfully flat*
(GR Definition 3.1.1(i)). -/
def IsFaithfullyFlat {A B : Algebra S} (f : A ⟶ B) : Prop :=
  letI := algebraOfHom f
  IsAlmostFaithfullyFlatAlg (S.baseChange ((Algebra.elements S).obj A))
    ((Algebra.elements S).obj B)

/-- P0/almost-finite-projective-and-finite-etale-algebras (data): `f` is *unramified*: `B` is
almost projective over `B ⊗_A B` via `μ_{B/A}` (GR Definition 3.1.1(iii)). -/
def IsUnramified {A B : Algebra S} (f : A ⟶ B) : Prop :=
  letI := algebraOfHom f
  IsAlmostUnramifiedAlg (S.baseChange ((Algebra.elements S).obj A)) ((Algebra.elements S).obj B)

/-- P0/almost-finite-projective-and-finite-etale-algebras: `f` is *weakly unramified*
(GR Definition 3.1.1(iii)). -/
def IsWeaklyUnramified {A B : Algebra S} (f : A ⟶ B) : Prop :=
  letI := algebraOfHom f
  IsAlmostWeaklyUnramifiedAlg (S.baseChange ((Algebra.elements S).obj A))
    ((Algebra.elements S).obj B)

/-- P0/almost-finite-projective-and-finite-etale-algebras (data): `f` is *étale*: flat and
unramified (GR Definition 3.1.1(iv)). -/
def IsEtale {A B : Algebra S} (f : A ⟶ B) : Prop := IsFlat f ∧ IsUnramified f

/-- P0/almost-finite-projective-and-finite-etale-algebras: `f` is *weakly étale*: flat and weakly
unramified (GR Definition 3.1.1(iv)). -/
def IsWeaklyEtale {A B : Algebra S} (f : A ⟶ B) : Prop := IsFlat f ∧ IsWeaklyUnramified f

/-- P0/almost-finite-projective-and-finite-etale-algebras (data): `f` is *finite étale*: étale and
`B` almost finitely presented over `A` (Sch12 Definition 4.13). -/
def IsFiniteEtale {A B : Algebra S} (f : A ⟶ B) : Prop :=
  letI := algebraOfHom f
  IsAlmostFiniteEtaleAlg (S.baseChange ((Algebra.elements S).obj A)) ((Algebra.elements S).obj B)

/-- P0/almost-finite-projective-and-finite-etale-algebras (data): `A_fet`, the full subcategory of
`A`-algebras that are finite étale over `A` (Sch12 Definition 4.13). -/
abbrev FiniteEtale (A : Algebra S) : Type (u + 1) :=
  ObjectProperty.FullSubcategory (fun B : Under A ↦ IsFiniteEtale B.hom)

/-- P0/almost-finite-projective-and-finite-etale-algebras (compatibility): étale morphisms are
stable under base change (P0/etale-morphisms-stability; GR Lemma 3.1.2(i)). -/
theorem IsEtale.baseChange {A B C D : Algebra S} {f : A ⟶ B} {g : A ⟶ C} {g' : B ⟶ D}
    {f' : C ⟶ D} (h : IsPushout f g g' f') (hf : IsEtale f) : IsEtale f' := sorry

/-- P0/almost-finite-projective-and-finite-etale-algebras: flat, weakly étale and finite étale
morphisms are stable under base change (GR Lemma 3.1.2(i)). -/
theorem IsFiniteEtale.baseChange {A B C D : Algebra S} {f : A ⟶ B} {g : A ⟶ C} {g' : B ⟶ D}
    {f' : C ⟶ D} (h : IsPushout f g g' f') :
    (IsFlat f → IsFlat f') ∧ (IsWeaklyEtale f → IsWeaklyEtale f') ∧
      (IsFiniteEtale f → IsFiniteEtale f') := sorry

/-- P0/almost-finite-projective-and-finite-etale-algebras (functoriality): étale morphisms are
stable under composition (P0/etale-morphisms-stability; GR Lemma 3.1.2(ii)). -/
theorem IsEtale.comp {A B C : Algebra S} {f : A ⟶ B} {g : B ⟶ C} (hf : IsEtale f)
    (hg : IsEtale g) : IsEtale (f ≫ g) := sorry

/-- P0/almost-finite-projective-and-finite-etale-algebras: flat, weakly étale and finite étale
morphisms are stable under composition (GR Lemma 3.1.2(ii)). -/
theorem IsFiniteEtale.comp {A B C : Algebra S} {f : A ⟶ B} {g : B ⟶ C} :
    (IsFlat f → IsFlat g → IsFlat (f ≫ g)) ∧
      (IsWeaklyEtale f → IsWeaklyEtale g → IsWeaklyEtale (f ≫ g)) ∧
      (IsFiniteEtale f → IsFiniteEtale g → IsFiniteEtale (f ≫ g)) := sorry

/-- P0/almost-finite-projective-and-finite-etale-algebras (characterisation): `f` is unramified
iff there is an idempotent almost element `e` of `B ⊗_A B` with `μ(e) = 1` and `I_{B/A} · e = 0`
(P0/unramified-idempotent-characterisation; GR Proposition 3.1.4). Here `B ⊗_A B` is presented
by a pushout and `μ` is the codiagonal. -/
theorem isUnramified_iff_exists_idempotent {A B D : Algebra S} (f : A ⟶ B) (i₁ i₂ : B ⟶ D)
    (hD : IsPushout f f i₁ i₂) (μ : D ⟶ B) (hμ₁ : i₁ ≫ μ = 𝟙 B) (hμ₂ : i₂ ≫ μ = 𝟙 B) :
    IsUnramified f ↔ ∃ e : (Algebra.elements S).obj D, IsIdempotentElem e ∧
      ((Algebra.elements S).map μ).hom e = 1 ∧
        ∀ x, ((Algebra.elements S).map μ).hom x = 0 → x * e = 0 := sorry

/-- P0/almost-finite-projective-and-finite-etale-algebras (characterisation): for `R'^a` almost
finite projective over `R^a`, étale iff the trace form is perfect (P0/trace-form-criterion;
GR Theorem 4.1.14, Sch12 Theorem 4.16). -/
theorem isEtale_iff_isPerfectTraceForm {R : Type u} [CommRing R] (T : BasicSetup R)
    (R' : Type u) [CommRing R'] [_root_.Algebra R R']
    (h : Module.AlmostFiniteProjective (relModule T R')) :
    IsAlmostEtaleAlg T R' ↔ Almost.Algebra.IsPerfectTraceForm T R' h := sorry

/-- P0/almost-finite-projective-and-finite-etale-algebras (relation): a finite étale `B` is almost
finite projective over `A` (P0/almost-finite-projective-iff; Sch12 Proposition 4.10). -/
theorem IsFiniteEtale.almostFiniteProjective {A B : Algebra S} {f : A ⟶ B}
    (hf : IsFiniteEtale f) :
    letI := algebraOfHom f
    Module.AlmostFiniteProjective (relModule (S.baseChange ((Algebra.elements S).obj A))
      ((Algebra.elements S).obj B)) := sorry

/-- P0/almost-finite-projective-and-finite-etale-algebras (compatibility): a finite étale algebra
in Mathlib's sense gives a finite étale almost algebra (P0/finite-etale-localizes; GR (3.4.44)). -/
theorem isFiniteEtale_toAlmost {R : Type u} [CommRing R] (T : BasicSetup R) (R' : Type u)
    [CommRing R'] [_root_.Algebra R R'] [_root_.Algebra.Etale R R'] [_root_.Module.Finite R R'] :
    IsAlmostFiniteEtaleAlg T R' := sorry

end Algebra

/- `K` the completion of `ℚ_p(p^{1/p^∞})`, `O' = 𝒪_{K(√p)}`, `p ≠ 2`: `O'` is flat, uniformly
almost finitely generated with bound `2`, and has almost diagonal idempotents `he`. -/
-- test Almost.Algebra.IsFiniteEtale_test_quadratic (computation)
--   [P0/almost-finite-projective-and-finite-etale-algebras]
example (O O' : Type u) [CommRing O] [IsDomain O] [ValuationRing O] [CommRing O']
    [_root_.Algebra O O'] (h : ¬ (IsLocalRing.maximalIdeal O).FG)
    (hflat : _root_.Module.Flat O O')
    (hq : Module.UniformlyAlmostFG (BasicSetup.ofValuationRing O h) O' 2)
    (he : ∀ ε ∈ IsLocalRing.maximalIdeal O, ∃ e : O' ⊗[O] O',
      _root_.Algebra.TensorProduct.lmul' O e = algebraMap O O' ε ∧ e * e = ε • e ∧
        ∀ x, _root_.Algebra.TensorProduct.lmul' O x = 0 → x * e = 0) :
    IsAlmostFiniteEtaleAlg (BasicSetup.ofValuationRing O h) O' := sorry

/- In the same example the diagonal idempotent is only an almost element: `O' ⊗_O O'` has no
honest diagonal idempotent, so `O → O'` is not finite étale in Mathlib's sense. -/
-- test Almost.Algebra.IsFiniteEtale_test_idempotent_not_honest (non-example)
--   [P0/almost-finite-projective-and-finite-etale-algebras]
example (O O' : Type u) [CommRing O] [IsDomain O] [ValuationRing O] [CommRing O']
    [_root_.Algebra O O'] (h : ¬ (IsLocalRing.maximalIdeal O).FG)
    (hnot : ¬ ∃ e : O' ⊗[O] O', IsIdempotentElem e ∧ _root_.Algebra.TensorProduct.lmul' O e = 1 ∧
      ∀ x, _root_.Algebra.TensorProduct.lmul' O x = 0 → x * e = 0)
    (hfe : IsAlmostFiniteEtaleAlg (BasicSetup.ofValuationRing O h) O') :
    ¬ (_root_.Algebra.Etale O O' ∧ _root_.Module.Finite O O') := sorry

-- test Almost.Algebra.IsFiniteEtale_test_classical (compatibility)
--   [P0/almost-finite-projective-and-finite-etale-algebras]
example (R R' : Type u) [CommRing R] [CommRing R'] [_root_.Algebra R R'] :
    IsAlmostFiniteEtaleAlg (BasicSetup.classical R) R' ↔
      _root_.Algebra.Etale R R' ∧ _root_.Module.Finite R R' := sorry

-- test Almost.Algebra.IsFiniteEtale_test_trivial (degenerate)
--   [P0/almost-finite-projective-and-finite-etale-algebras]
example (A : Algebra S) : Algebra.IsFiniteEtale (𝟙 A) ∧ IsAlmostFiniteEtaleAlg S V ∧
    IsAlmostFiniteEtaleAlg S (V × V) := sorry

/-! ## PerfectoidSpaces:P0/unramified-idempotent-characterisation (lemma) -/

/-- P0/unramified-idempotent-characterisation: `R'^a` is unramified over `R^a` iff there is an
idempotent almost element `e` of `(R' ⊗_R R')^a` with `μ(e) = 1` and `x · e = 0` for `x` in the
kernel of `μ` (GR Proposition 3.1.4, Sch12 Definition 4.12(i)). -/
theorem isAlmostUnramifiedAlg_iff_idempotent {R : Type u} [CommRing R] (T : BasicSetup R)
    (R' : Type u) [CommRing R'] [_root_.Algebra R R'] :
    IsAlmostUnramifiedAlg T R' ↔
      ∃ e : (Algebra.elements T).obj (Algebra.of T (R' ⊗[R] R')), IsIdempotentElem e ∧
        ((Algebra.elements T).map (Algebra.ofHom T (_root_.Algebra.TensorProduct.lmul' R))).hom e
          = 1 ∧
        ∀ x, ((Algebra.elements T).map
          (Algebra.ofHom T (_root_.Algebra.TensorProduct.lmul' R))).hom x = 0 → x * e = 0 := sorry

/-- P0/unramified-idempotent-characterisation: the diagonal idempotent is unique (GR Remark
3.1.8). -/
theorem diagonalIdempotent_unique {R : Type u} [CommRing R] (T : BasicSetup R)
    (R' : Type u) [CommRing R'] [_root_.Algebra R R']
    (e e' : (Algebra.elements T).obj (Algebra.of T (R' ⊗[R] R')))
    (he : IsIdempotentElem e ∧
      ((Algebra.elements T).map (Algebra.ofHom T (_root_.Algebra.TensorProduct.lmul' R))).hom e
        = 1 ∧ ∀ x, ((Algebra.elements T).map
          (Algebra.ofHom T (_root_.Algebra.TensorProduct.lmul' R))).hom x = 0 → x * e = 0)
    (he' : IsIdempotentElem e' ∧
      ((Algebra.elements T).map (Algebra.ofHom T (_root_.Algebra.TensorProduct.lmul' R))).hom e'
        = 1 ∧ ∀ x, ((Algebra.elements T).map
          (Algebra.ofHom T (_root_.Algebra.TensorProduct.lmul' R))).hom x = 0 → x * e' = 0) :
    e = e' := sorry

/-! ## PerfectoidSpaces:P0/etale-morphisms-stability (lemma) -/

/-- P0/etale-morphisms-stability (i): étale is stable under base change along `R → C`
(GR Lemma 3.1.2(i)). -/
theorem IsAlmostEtaleAlg.baseChange {R : Type u} [CommRing R] (T : BasicSetup R) (R' C : Type u)
    [CommRing R'] [_root_.Algebra R R'] [CommRing C] [_root_.Algebra R C]
    (h : IsAlmostEtaleAlg T R') : IsAlmostEtaleAlg (T.baseChange C) (C ⊗[R] R') := sorry

/-- P0/etale-morphisms-stability (ii): étale is stable under composition (GR Lemma 3.1.2(ii)). -/
theorem IsAlmostEtaleAlg.trans {R : Type u} [CommRing R] (T : BasicSetup R) (R' R'' : Type u)
    [CommRing R'] [_root_.Algebra R R'] [CommRing R''] [_root_.Algebra R' R'']
    [_root_.Algebra R R''] [IsScalarTower R R' R''] (h : IsAlmostEtaleAlg T R')
    (h' : IsAlmostEtaleAlg (T.baseChange R') R'') :
    IsAlmostEtaleAlg T R'' := sorry

/-- P0/etale-morphisms-stability (iii), (iv), (v), (viii): cancellation properties of flat,
weakly unramified, unramified and étale morphisms (GR Lemma 3.1.2(iii)-(v), (viii)). -/
theorem Algebra.isFlat_cancel {A B C : Algebra S} (f : A ⟶ B) (g : B ⟶ C) :
    (Algebra.IsFlat f → Algebra.IsFaithfullyFlat (f ≫ g) → Algebra.IsFaithfullyFlat f) ∧
    (Algebra.IsWeaklyUnramified f → Algebra.IsFlat (f ≫ g) → Algebra.IsFlat g) ∧
    (Algebra.IsWeaklyUnramified f → Algebra.IsWeaklyEtale (f ≫ g) → Algebra.IsWeaklyEtale g) ∧
    (Algebra.IsUnramified f → Algebra.IsEtale (f ≫ g) → Algebra.IsEtale g) ∧
    (Algebra.IsFaithfullyFlat g → Algebra.IsFlat (f ≫ g) → Algebra.IsFlat f) ∧
    (Algebra.IsFaithfullyFlat g → Algebra.IsWeaklyUnramified (f ≫ g) →
      Algebra.IsWeaklyUnramified f) := sorry

/-- P0/etale-morphisms-stability (vi): `R^a → R'^a` is faithfully flat iff it is a monomorphism
with flat cokernel (GR Lemma 3.1.2(vi)). -/
theorem faithfullyFlat_relModule_iff {R : Type u} [CommRing R] (T : BasicSetup R) (R' : Type u)
    [CommRing R'] [_root_.Algebra R R'] :
    Module.FaithfullyFlat (relModule T R') ↔
      Mono ((toAlmost T).map (ModuleCat.ofHom (_root_.Algebra.linearMap R R'))) ∧
        Module.Flat ((toAlmost T).obj
          (ModuleCat.of R (R' ⧸ LinearMap.range (_root_.Algebra.linearMap R R')))) := sorry

/-- P0/etale-morphisms-stability (vii): almost finite and weakly unramified implies unramified
(GR Lemma 3.1.2(vii)). -/
theorem isAlmostUnramifiedAlg_of_almostFG {R : Type u} [CommRing R] (T : BasicSetup R)
    (R' : Type u) [CommRing R'] [_root_.Algebra R R'] (hfg : Module.AlmostFG T R')
    (h : IsAlmostWeaklyUnramifiedAlg T R') : IsAlmostUnramifiedAlg T R' := sorry

/-! ## PerfectoidSpaces:P0/trace-form-criterion (theorem) -/

/-- P0/trace-form-criterion: for `R'` almost finitely presented and flat over `R`, `R'^a` is
finite étale iff the trace form is perfect (GR Theorem 4.1.14, Remark 4.1.17; Sch12 Theorem
4.16). -/
theorem isAlmostFiniteEtaleAlg_iff_isPerfectTraceForm {R : Type u} [CommRing R]
    (T : BasicSetup R) (R' : Type u) [CommRing R'] [_root_.Algebra R R']
    (hfp : Module.AlmostFP T R') (hflat : IsAlmostFlatAlg T R')
    (h : Module.AlmostFiniteProjective (relModule T R')) :
    IsAlmostFiniteEtaleAlg T R' ↔ Algebra.IsPerfectTraceForm T R' h := sorry

/-! ## PerfectoidSpaces:P0/almost-inversion-and-completion (construction) -/

section invert

variable (ϖ : V)

/-- P0/almost-inversion-and-completion (constructor): inverting `ϖ`, `M ↦ M_*[1/ϖ]`, a functor
`V^a-Mod ⥤ ModuleCat V[1/ϖ]`; for `ϖ ∈ m` it is exact and `(M^a)[1/ϖ] ≅ M[1/ϖ]`
(GR proof of Corollary 5.2.15, Bhatt Exercise 4.1.9). -/
def invert : Module S ⥤ ModuleCat.{u} (Localization.Away ϖ) :=
  Module.elements S ⋙ ModuleCat.extendScalars (algebraMap V (Localization.Away ϖ))

/-- P0/almost-inversion-and-completion (compatibility): for `ϖ ∈ m`,
`toAlmost S ⋙ invert S ϖ ≅ (−)[1/ϖ]` (Bhatt Exercise 4.1.9). -/
def toAlmostCompInvertIso (hϖ : ϖ ∈ S.ideal) :
    toAlmost S ⋙ invert S ϖ ≅ ModuleCat.extendScalars (algebraMap V (Localization.Away ϖ)) :=
  sorry

/-- P0/almost-inversion-and-completion (instance): for `ϖ ∈ m`, inverting `ϖ` is exact
(Bhatt Exercise 4.1.9). -/
instance invert_preservesFiniteLimits [Fact (ϖ ∈ S.ideal)] :
    PreservesFiniteLimits (invert S ϖ) := sorry

/-- P0/almost-inversion-and-completion: for `ϖ ∈ m`, inverting `ϖ` is exact. -/
instance invert_preservesFiniteColimits [Fact (ϖ ∈ S.ideal)] :
    PreservesFiniteColimits (invert S ϖ) := sorry

/-- P0/almost-inversion-and-completion (characterisation): `(invert ϖ).obj M ≅ M_*[1/ϖ]` as a
`LocalizedModule` (Bhatt Exercise 4.1.9). -/
def invertElementsIso (M : Module S) :
    (invert S ϖ).obj M ≅ ModuleCat.of (Localization.Away ϖ)
      (LocalizedModule (Submonoid.powers ϖ) ((Module.elements S).obj M)) := sorry

/-- P0/almost-inversion-and-completion (relation): almost isomorphisms become isomorphisms after
inverting `ϖ ∈ m` (GR proof of Corollary 5.2.15). -/
theorem isIso_localization_of_isAlmostIso (hϖ : ϖ ∈ S.ideal) {M N : ModuleCat.{u} V}
    (f : M ⟶ N) (hf : S.IsAlmostIso f.hom) :
    IsIso ((ModuleCat.extendScalars (algebraMap V (Localization.Away ϖ))).map f) := sorry

/-- P0/almost-inversion-and-completion (relation): almost zero modules die after inverting
`ϖ ∈ m` (Bhatt Exercise 4.1.9). -/
theorem localization_subsingleton_of_isAlmostZero (hϖ : ϖ ∈ S.ideal) (M : Type*)
    [AddCommGroup M] [_root_.Module V M] (hM : S.IsAlmostZero M) :
    Subsingleton (LocalizedModule (Submonoid.powers ϖ) M) := sorry

/-- P0/almost-inversion-and-completion (example): the setup base-changed to `V[1/ϖ]`, `ϖ ∈ m`, is
classical (GR proof of Corollary 5.2.15). -/
theorem BasicSetup.baseChange_away_eq_classical (hϖ : ϖ ∈ S.ideal) :
    S.baseChange (Localization.Away ϖ) = BasicSetup.classical (Localization.Away ϖ) := sorry

/-- P0/almost-inversion-and-completion (instance): for `ϖ ∈ m`, inverting `ϖ` is monoidal
(Berkeley proof of Proposition 8.2.8). -/
instance invertMonoidal [Fact (ϖ ∈ S.ideal)] : (invert S ϖ).Monoidal := sorry

/-- P0/almost-inversion-and-completion: inverting `ϖ` on almost algebras,
`A ↦ A_*[1/ϖ]` (Berkeley proof of Proposition 8.2.8). -/
def Algebra.invert : Algebra S ⥤ CommAlgCat.{u} (Localization.Away ϖ) := sorry

/-- P0/almost-inversion-and-completion (relation): a complex with almost zero cohomology becomes
exact after inverting `ϖ ∈ m` (Berkeley proof of Proposition 8.2.8). -/
theorem exact_invert_of_almostExact (hϖ : ϖ ∈ S.ideal) (C : CochainComplex (ModuleCat.{u} V) ℕ)
    (hC : ∀ i, S.IsAlmostZero (C.homology i)) (i : ℕ) :
    IsZero ((((ModuleCat.extendScalars (algebraMap V (Localization.Away ϖ))).mapHomologicalComplex
      _).obj C).homology i) := sorry

end invert

/- `O = K°`, `ϖ ∈ K°°` nonzero: `(K°/ϖ)^a` dies and `(K°)^a` becomes `K = K°[1/ϖ]`. -/
-- test Almost.invert_test_residue (computation) [P0/almost-inversion-and-completion]
