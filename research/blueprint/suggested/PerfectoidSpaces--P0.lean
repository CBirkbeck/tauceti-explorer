    Nonempty ((S.firm.obj (ModuleCat.of V V)).obj ≅ ModuleCat.of V S.tilde) := sorry

-- test BasicSetup.Firm.test_ring_not_firm (non-example) [P0/firm-module-model]
example (h : S.ideal ≠ ⊤) : ¬ S.IsFirm V := sorry

-- test BasicSetup.Firm.test_classical (degenerate) [P0/firm-module-model]
example (M : Type u) [AddCommGroup M] [Module V M] : (classical V).IsFirm M := sorry

-- test BasicSetup.Firm.test_mathlib_localization (compatibility) [P0/firm-module-model]
example : S.firm.IsLocalization S.almostZero.isoModSerre := sorry

end BasicSetup

/-! ## PerfectoidSpaces:P0/almost-modules-over-perfectoid-base (definition) -/

variable {V : Type u} [CommRing V] (S : BasicSetup V)

/-- P0/almost-modules-over-perfectoid-base (data): the category `V^a-Mod` of almost `V`-modules,
Mathlib's localisation of `ModuleCat V` at the almost isomorphisms `S.almostZero.isoModSerre`
(the Serre quotient by the almost zero modules), realised by the `HasLocalization.{u}` instance of
the firm model so that Hom-types lie in `Type u` (Sch12 Definition 4.3, GR (2.2.2)). -/
abbrev Module : Type (u + 1) := S.almostZero.isoModSerre.Localization'

/-- P0/almost-modules-over-perfectoid-base (constructor): the localisation functor `M ↦ M^a`
(Sch12 Definition 4.3). -/
abbrev toAlmost : ModuleCat.{u} V ⥤ Module S := S.almostZero.isoModSerre.Q'

/-- P0/almost-modules-over-perfectoid-base (instance): `M ↦ M^a` is a localisation functor for the
almost isomorphisms. -/
instance toAlmost_isLocalization : (toAlmost S).IsLocalization S.almostZero.isoModSerre :=
  inferInstance

/-- P0/almost-modules-over-perfectoid-base: the preadditive structure of the localisation
(Mathlib `Localization.preadditive`, the almost isomorphisms having a calculus of fractions). -/
instance : Preadditive (Module S) :=
  Localization.preadditive (toAlmost S) S.almostZero.isoModSerre

/-- P0/almost-modules-over-perfectoid-base: `M ↦ M^a` is additive. -/
instance : (toAlmost S).Additive :=
  Localization.functor_additive (toAlmost S) S.almostZero.isoModSerre

/-- P0/almost-modules-over-perfectoid-base: `V^a-Mod` is `V`-linear (Mathlib
`Localization.linear`). -/
instance Module.linear : Linear V (Module S) :=
  Localization.linear V (toAlmost S) S.almostZero.isoModSerre

/-- P0/almost-modules-over-perfectoid-base: `M ↦ M^a` is `V`-linear. -/
instance : (toAlmost S).Linear V :=
  Localization.functor_linear V (toAlmost S) S.almostZero.isoModSerre

/-- P0/almost-modules-over-perfectoid-base (instance): `V^a-Mod` is abelian (Mathlib
`SerreClassLocalization.abelian`; Sch12 Definition 4.3). -/
instance Module.instAbelian : Abelian (Module S) :=
  ObjectProperty.SerreClassLocalization.abelian (toAlmost S) S.almostZero

/-- P0/almost-modules-over-perfectoid-base (instance): `M ↦ M^a` is exact (GR (2.2.2)). -/
instance toAlmost_preservesFiniteLimits : PreservesFiniteLimits (toAlmost S) := sorry

/-- P0/almost-modules-over-perfectoid-base (instance): `M ↦ M^a` is exact (GR (2.2.2)). -/
instance toAlmost_preservesFiniteColimits : PreservesFiniteColimits (toAlmost S) := sorry

/-- P0/almost-modules-over-perfectoid-base (characterisation): `M^a ≅ 0` iff `M` is almost zero
(Sch12 Definition 4.3). -/
theorem isZero_toAlmost_iff (M : ModuleCat.{u} V) :
    IsZero ((toAlmost S).obj M) ↔ S.IsAlmostZero M := sorry

/-- P0/almost-modules-over-perfectoid-base (characterisation): `f^a` is an isomorphism iff `f` is
an almost isomorphism (GR (2.2.2)). -/
theorem isIso_toAlmost_map_iff {M N : ModuleCat.{u} V} (f : M ⟶ N) :
    IsIso ((toAlmost S).map f) ↔ S.IsAlmostIso f.hom := sorry

/-- P0/almost-modules-over-perfectoid-base (instance): every almost module is some `M^a`
(take `M = N_*`). -/
instance toAlmost_essSurj : (toAlmost S).EssSurj :=
  Localization.essSurj _ S.almostZero.isoModSerre

/-- P0/almost-modules-over-perfectoid-base (characterisation): a functor out of `V^a-Mod` into an
abelian category is exact iff its composite with `M ↦ M^a` is (Mathlib
`SerreClassLocalization.preservesFiniteLimits_comp_iff`). -/
theorem exact_iff_comp_toAlmost {E : Type*} [Category E] [Abelian E] (G : Module S ⥤ E) :
    (PreservesFiniteLimits G ∧ PreservesFiniteColimits G) ↔
      (PreservesFiniteLimits (toAlmost S ⋙ G) ∧ PreservesFiniteColimits (toAlmost S ⋙ G)) :=
  sorry

/-- P0/almost-modules-over-perfectoid-base (universal-property): an exact functor out of
`ModuleCat V` killing almost zero modules factors through `M ↦ M^a` (Mathlib `Localization.lift`;
GR (2.2.2)). -/
def liftExact {E : Type*} [Category E] [Abelian E] (F : ModuleCat.{u} V ⥤ E)
    [PreservesFiniteLimits F] [PreservesFiniteColimits F]
    (hF : ∀ M : ModuleCat.{u} V, S.IsAlmostZero M → IsZero (F.obj M)) : Module S ⥤ E :=
  Localization.lift (W := S.almostZero.isoModSerre) F sorry (toAlmost S)

/-- P0/almost-modules-over-perfectoid-base (universal-property): the factorisation
`toAlmost S ⋙ liftExact F ≅ F`; it is exact and unique up to unique isomorphism. -/
def liftExactIso {E : Type*} [Category E] [Abelian E] (F : ModuleCat.{u} V ⥤ E)
    [PreservesFiniteLimits F] [PreservesFiniteColimits F]
    (hF : ∀ M : ModuleCat.{u} V, S.IsAlmostZero M → IsZero (F.obj M)) :
    toAlmost S ⋙ liftExact S F hF ≅ F := sorry

/-- P0/almost-modules-over-perfectoid-base (equivalence): for the classical setup, almost modules
are modules (GR Example 2.1.2(ii)). -/
def Module.classicalEquiv (V : Type u) [CommRing V] :
    ModuleCat.{u} V ≌ Module (BasicSetup.classical V) := sorry

/-- P0/almost-modules-over-perfectoid-base (structure): the `V`-module structure on the Hom-types
of `V^a-Mod` (P0/almost-hom-formula; GR (2.2.4)). -/
abbrev Module.homModule (X Y : Module S) : _root_.Module V (X ⟶ Y) := Linear.homModule X Y

/- `O` a valuation domain with non-finitely-generated maximal ideal (e.g. `𝒪_{ℂ_p}`), `π = p`,
`s = p^{1/2}`. -/
-- test Almost.Module.test_residue_field (computation) [P0/almost-modules-over-perfectoid-base]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) (π s : O) (hs : s * s = π)
    (hsm : s ∈ IsLocalRing.maximalIdeal O) (hs0 : s ∉ Ideal.span {π}) :
    IsZero ((toAlmost (BasicSetup.ofValuationRing O h)).obj
      (ModuleCat.of O (IsLocalRing.ResidueField O))) ∧
    ¬ IsZero ((toAlmost (BasicSetup.ofValuationRing O h)).obj
      (ModuleCat.of O (O ⧸ Ideal.span {π}))) := sorry

-- test Almost.Module.test_classical (compatibility) [P0/almost-modules-over-perfectoid-base]
example : (toAlmost (BasicSetup.classical V)).IsEquivalence := sorry

-- test Almost.Module.test_zero_setup (degenerate) [P0/almost-modules-over-perfectoid-base]
example (S : BasicSetup V) (h : S.ideal = ⊥) (X : Module S) : IsZero X := sorry

/- `O = 𝒪_K`, `K` the completion of `ℚ_p(p^{1/p^∞})`, `π = p`; `hnot` is Sch12 Remark 4.8
(`Hom(𝔪, O/π)` is bigger than `O/π`). -/
-- test Almost.Module.test_not_projective (non-example) [P0/almost-modules-over-perfectoid-base]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) (π : O)
    (hnot : ¬ Function.Surjective (fun x : O ⧸ Ideal.span {π} ↦
      (LinearMap.toSpanSingleton O (O ⧸ Ideal.span {π}) x).domRestrict
        (IsLocalRing.maximalIdeal O))) :
    ¬ Projective ((toAlmost (BasicSetup.ofValuationRing O h)).obj (ModuleCat.of O O)) := sorry

-- test Almost.Module.test_hom_formula (characterisation) [P0/almost-modules-over-perfectoid-base]
example (M N : ModuleCat.{u} V) :
    Nonempty (((toAlmost S).obj M ⟶ (toAlmost S).obj N) ≃ₗ[V] (S.tilde ⊗[V] M →ₗ[V] N)) := sorry

/-! ## PerfectoidSpaces:P0/almost-hom-formula (lemma) -/

/-- P0/almost-hom-formula: `Hom(M^a, N^a) ≅ Hom_V(m̃ ⊗_V M, N)`, `V`-linearly and naturally
(GR (2.2.4), Sch12 Proposition 4.4). -/
def homEquivTilde (M N : ModuleCat.{u} V) :
    ((toAlmost S).obj M ⟶ (toAlmost S).obj N) ≃ₗ[V] (S.tilde ⊗[V] M →ₗ[V] N) := sorry

/-- P0/almost-hom-formula: Hom-types of `V^a-Mod` have no nonzero almost zero elements
(GR after (2.2.4)). -/
theorem eq_zero_of_smul_eq_zero {X Y : Module S} (f : X ⟶ Y) (hf : ∀ ε ∈ S.ideal, ε • f = 0) :
    f = 0 := sorry

/-! ## PerfectoidSpaces:P0/almost-hom-and-adjoints (construction) -/

/-- P0/almost-hom-and-adjoints (constructor): the functor of almost elements
`M ↦ M_* = Hom(V^a, M)`, with its `V`-module structure (GR Proposition 2.2.13(ii)). -/
def Module.elements : Module S ⥤ ModuleCat.{u} V :=
  (linearCoyoneda V (Module S)).obj (Opposite.op ((toAlmost S).obj (ModuleCat.of V V)))

/-- P0/almost-hom-and-adjoints (universal-property): `M ↦ M^a` is left adjoint to `M ↦ M_*`
(GR Proposition 2.2.13(ii)). -/
def Module.adjElements : toAlmost S ⊣ Module.elements S := sorry

/-- P0/almost-hom-and-adjoints (equivalence): the counit `(M_*)^a ≅ M` is an isomorphism, so
`M ↦ M_*` is fully faithful (GR Proposition 2.2.13(ii)). -/
def Module.elementsCounitIso : Module.elements S ⋙ toAlmost S ≅ 𝟭 (Module S) := sorry

/-- P0/almost-hom-and-adjoints (characterisation): `(N^a)_* ≅ Hom_V(m̃, N)`, naturally in `N`
(GR Proposition 2.2.13(ii)). -/
def elementsToAlmostIso : toAlmost S ⋙ Module.elements S ≅ S.firm ⋙ S.closure := sorry

/-- P0/almost-hom-and-adjoints (constructor): `M ↦ M_! = m̃ ⊗_V M_*` (GR Proposition 2.2.21). -/
def Module.shriek : Module S ⥤ ModuleCat.{u} V :=
  Module.elements S ⋙ tensorLeft (ModuleCat.of V S.tilde)

/-- P0/almost-hom-and-adjoints (universal-property): `M ↦ M_!` is left adjoint to `M ↦ M^a`
(GR Proposition 2.2.21). -/
def Module.adjShriek : Module.shriek S ⊣ toAlmost S := sorry

/-- P0/almost-hom-and-adjoints (equivalence): the unit `M ≅ (M_!)^a` is an isomorphism, so
`M ↦ M_!` is fully faithful (GR Proposition 2.2.21). -/
def Module.shriekUnitIso : 𝟭 (Module S) ≅ Module.shriek S ⋙ toAlmost S := sorry

/-- P0/almost-hom-and-adjoints (instance): `M ↦ M_!` is exact since `m̃` is flat (GR Corollary
2.2.22). -/
instance Module.shriek_preservesFiniteLimits : PreservesFiniteLimits (Module.shriek S) := sorry

/-- P0/almost-hom-and-adjoints (characterisation): the unit `N → (N^a)_*` is an almost isomorphism
(GR Proposition 2.2.13(iii)). -/
theorem isAlmostIso_unit (N : ModuleCat.{u} V) :
    S.IsAlmostIso ((Module.adjElements S).unit.app N).hom := sorry

/-- P0/almost-hom-and-adjoints: the natural transformation `m̃ ⊗_V − ⟶ 𝟭`, `x ⊗ y ⊗ z ↦ (xy)z`. -/
def BasicSetup.tildeActNat : tensorLeft (ModuleCat.of V S.tilde) ⟶ 𝟭 (ModuleCat.{u} V) where
  app M := ModuleCat.ofHom (S.tildeAct M)
  naturality := sorry

/-- P0/almost-hom-and-adjoints (data): the natural map `M_! → M_*`, induced by `m̃ → V`; it is an
almost isomorphism objectwise (GR Proposition 2.2.21). -/
def Module.shriekToElements : Module.shriek S ⟶ Module.elements S :=
  Functor.whiskerLeft (Module.elements S) S.tildeActNat ≫ (Functor.rightUnitor _).hom

/-- P0/almost-hom-and-adjoints (instance): `V^a-Mod` has enough injectives, and `M ↦ M_*`,
`M ↦ M^a` preserve injective objects (GR Corollary 2.2.19). -/
instance Module.enoughInjectives : EnoughInjectives (Module S) := sorry

/-- P0/almost-hom-and-adjoints (instance): `V^a-Mod` is complete (GR Corollary 2.2.19). -/
instance Module.hasLimits : HasLimits (Module S) := sorry

/-- P0/almost-hom-and-adjoints (instance): `V^a-Mod` is cocomplete (GR Corollary 2.2.19). -/
instance Module.hasColimits : HasColimits (Module S) := sorry

/-- P0/almost-hom-and-adjoints (relation): almost elements lift along epimorphisms up to `m`
(GR Proposition 2.2.13(iii)). -/
theorem Module.exists_elements_lift_smul {X Y : Module S} (φ : X ⟶ Y) [Epi φ]
    (y : (Module.elements S).obj Y) (ε : V) (hε : ε ∈ S.ideal) :
    ∃ x : (Module.elements S).obj X, ((Module.elements S).map φ).hom x = ε • y := sorry

/- `O = K°` for a valuation domain with non-finitely-generated maximal ideal `K°°`. -/
-- test Almost.Module.elements_test_valuation (computation) [P0/almost-hom-and-adjoints]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
