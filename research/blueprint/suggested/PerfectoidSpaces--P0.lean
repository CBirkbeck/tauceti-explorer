/-! # Stage P4. Morphisms of perfectoid spaces: injections, immersions, Zariski closed
immersions, diagonals and separatedness; integral perfectoid criteria

Names live in `TauCeti.Perfectoid` (ring level) and `TauCeti.PerfectoidSpace` (maps of
perfectoid spaces and of their affinoid spectra).

* **Geometry is a comment, the affinoid core is a declaration.** Morphisms of perfectoid spaces
  are morphisms in the full subcategory `PerfectoidSpace` (PerfectoidSpaces:P2/perfectoid-space)
  of the anchor's adic spaces (AdicSpaces Layer 5), which Tau Ceti does not have. Every packet
  item about such morphisms (field points `X(K, K⁺)`, injections, immersions, quasicompact and
  separated maps, diagonals, the spaces `Z_𝒰`, `Z_I`) is a comment naming its supplier. Where the
  item has content for affinoid source and target, that content is stated for a morphism
  `φ : Pair.Hom P Q` of Huber pairs (a map `Spa(Q) → Spa(P)`, whose map on points is Tau Ceti's
  `Pair.Hom.spaComap`) under the packet name with the suffix `_affinoid` or `_core`. An
  *injection* of affinoid perfectoid spaces is tested on affinoid perfectoid sources:
  `IsInjection_affinoid p φ` says that `φ` is an epimorphism towards perfectoid pairs.
* **Affinoid perfectoid fields** `AffinoidField p K` (a perfectoid field with an open bounded
  valuation subring) are ring-level data and are stated under their packet names, with their
  closed point in Tau Ceti's `spa`.
* **Pro-rational subspaces and Zariski closed subspaces at ring level.** For a filtered diagram
  `𝒰 : J ⥤ {presentations}` of rational subsets of `Spa(R, R⁺)`, the ring `S_𝒰` of the
  intersection is stage P1's completed filtered colimit of the per-presentation rational
  localisations of stage P2a (`proRationalSubspace_affinoid`); the universal perfectoid quotient
  `R → S_I` of an ideal `I` is its instance for the rational subsets `U_F = {|g| ≤ 1, g ∈ F}`,
  `F ⊆ I` finite (`zariskiClosedSubspace_affinoid`). Zero loci `zeroLocus P I ⊆ spa P.plus` and
  strongly Zariski closed maps (`IsStronglyZariskiClosed_affinoid`) are stated for Huber pairs.
* **Ring level.** The almost integral perfectoid criterion, the integral perfectoid criterion
  (BMS1 Lemma 3.21), almost surjectivity of surjections on plus rings, and surjections and closed
  ideals under tilting (Kedlaya AWS Theorem 2.4.4) are stated in `TauCeti.Perfectoid`.

Sources: ECD = Scholze, *Étale cohomology of diamonds*; Sch12 = Scholze, *Perfectoid spaces*;
Berkeley = Scholze–Weinstein, *Berkeley lectures*; KL = Kedlaya–Liu, *Relative p-adic Hodge
theory* I; AWS = Kedlaya, *Sheaves, stacks and shtukas*; BMS1 = Bhatt–Morrow–Scholze, *Integral
p-adic Hodge theory*; Tor = Scholze, *On torsion in the cohomology of locally symmetric
varieties*, §II.2; Bhatt = Bhatt, *Lecture notes on perfectoid spaces*. -/

noncomputable section

namespace TauCeti

universe u

open Topology Filter CategoryTheory CategoryTheory.Limits
open Huber ValuationSpectrum

/-! ## PerfectoidSpaces:P4/affinoid-perfectoid-field-points (definition) -/

namespace PerfectoidSpace

open Perfectoid

section AffinoidFieldDef

variable (p : ℕ) [Fact p.Prime] (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K]
  [CompleteSpace K]

/-- P4/affinoid-perfectoid-field-points (structure): an *affinoid perfectoid field* structure
`(K, K⁺)` on `K`: `K` is a perfectoid field (ECD Definition 3.6, P1 `IsPerfectoidField`) and `K⁺`
is an open and bounded valuation subring (ECD Proposition 5.3 (ii); Berkeley Definition/Proposition
8.3.3, "perfectoid affinoid field"); equivalently `K°° ⊆ K⁺ ⊆ K°`. A morphism (an extension)
`(K, K⁺) → (L, L⁺)` is a morphism of Huber pairs `F.toPair → G.toPair`. -/
structure AffinoidField where
  /-- `K` is a perfectoid field. -/
  isPerfectoidField : IsPerfectoidField p K
  /-- The valuation subring `K⁺`. -/
  plus : ValuationSubring K
  /-- `K⁺` is open. -/
  isOpen_plus : IsOpen (plus : Set K)
  /-- `K⁺` is bounded. -/
  isBounded_plus : IsBounded (plus : Set K)

namespace AffinoidField

variable {p K}

/-- P4/affinoid-perfectoid-field-points (coercion): the underlying Tau Ceti Huber pair `(K, K⁺)`
(an open bounded valuation subring is a ring of integral elements). -/
def toPair (F : AffinoidField p K) : Pair K where
  plus := F.plus.toSubring
  isRingOfIntegralElements := sorry

variable (p K) in
/-- P4/affinoid-perfectoid-field-points (constructor): the affinoid perfectoid field `(K, K°)`,
`K° = {x : ‖x‖ ≤ 1}` (ECD Proposition 5.3; Berkeley Definition/Proposition 8.3.3). -/
def ofRankOne [IsPerfectoidField p K] : AffinoidField p K where
  isPerfectoidField := inferInstance
  plus :=
    { carrier := {x | ‖x‖ ≤ 1}
      mul_mem' := sorry
      one_mem' := sorry
      add_mem' := sorry
      zero_mem' := sorry
      neg_mem' := sorry
      mem_or_inv_mem' := sorry }
  isOpen_plus := sorry
  isBounded_plus := sorry

/-- P4/affinoid-perfectoid-field-points (simp): the plus ring of `ofRankOne` is `K°` (Tau Ceti
`powerBoundedSubring`). -/
@[simp] theorem ofRankOne_toPair_plus [IsPerfectoidField p K] :
    (ofRankOne p K).toPair.plus = powerBoundedSubring K := sorry

/-- P4/affinoid-perfectoid-field-points (data): the point `K⁺` of `|Spa(K, K⁺)|` (Tau Ceti `spa`),
the class of the valuation whose valuation ring is `K⁺`; it is the unique closed point
(ECD proof of Lemma 5.4). -/
def closedPoint (F : AffinoidField p K) : spa F.toPair.plus := sorry

/-- P4/affinoid-perfectoid-field-points (data): every point of `Spa(K, K⁺)` specializes to the
closed point, and the closed point is closed (ECD proof of Lemma 5.4). -/
theorem specializes_closedPoint (F : AffinoidField p K) (x : spa F.toPair.plus) :
    x ⤳ F.closedPoint ∧ IsClosed ({F.closedPoint} : Set (spa F.toPair.plus)) := sorry

/-- P4/affinoid-perfectoid-field-points (characterisation): a point `v` of `Spv K` lies in
`Spa(K, K⁺)` iff its valuation ring `{a : |a(v)| ≤ 1}` is a valuation subring `V` with
`K⁺ ⊆ V ⊆ K°` (ECD proof of Lemma 5.4; the maximum `K°` is the unique rank-one point). -/
theorem mem_spa_iff (F : AffinoidField p K) (v : Spv K) :
    v ∈ spa F.toPair.plus ↔ ∃ V : ValuationSubring K, F.plus ≤ V ∧
      V.toSubring ≤ powerBoundedSubring K ∧ ∀ a : K, v.toValuativeRel.vle a 1 ↔ a ∈ V := sorry

/-- P4/affinoid-perfectoid-field-points (characterisation): the points of `Spa(K, K⁺)` form a
chain under specialization (overrings of the valuation ring `K⁺` are localizations at primes). -/
theorem specializes_total (F : AffinoidField p K) (x y : spa F.toPair.plus) :
    x ⤳ y ∨ y ⤳ x := sorry

/-- P4/affinoid-perfectoid-field-points (characterisation): the nonempty quasicompact open
subsets of `Spa(K, K⁺)` are the `Spa(K, K'⁺)` for valuation subrings `K⁺ ⊆ K'⁺ ⊆ K°` (the rational
subsets `{|f| ≤ 1}`); every open subset is a union of these (ECD proof of Lemma 5.4). -/
theorem isOpen_iff (F : AffinoidField p K) (U : Set (spa F.toPair.plus)) :
    IsOpen U ∧ IsCompact U ∧ U.Nonempty ↔ ∃ V : ValuationSubring K, F.plus ≤ V ∧
      V.toSubring ≤ powerBoundedSubring K ∧ U = Subtype.val ⁻¹' spa V.toSubring := sorry

-- PerfectoidSpace.AffinoidField.spa: not stated here; needs the affinoid perfectoid space
--   `Spa(K, K⁺)` as an object of the anchor's category of adic spaces (supplier: AdicSpaces
--   Layer 5; PerfectoidSpaces:P2/affinoid-perfectoid-space). Its underlying space is Tau Ceti's
--   `spa F.toPair.plus`, used above.

end AffinoidField

-- PerfectoidSpace.fieldPoints: not stated here; `X(K, K⁺) = Hom(Spa(K, K⁺), X)` needs
--   morphisms of perfectoid spaces (supplier: AdicSpaces Layer 5;
--   PerfectoidSpaces:P2/perfectoid-space). For affinoid `X = Spa(R, R⁺)` it is Tau Ceti's
--   `Pair.Hom P F.toPair`.
-- PerfectoidSpace.fieldPoints.map: not stated here; needs `fieldPoints` (supplier: AdicSpaces
--   Layer 5). For affinoids it is `Pair.Hom.comp`.
-- PerfectoidSpace.fieldPoints.restrict: not stated here; needs `fieldPoints` (supplier:
--   AdicSpaces Layer 5). For affinoids it is `Pair.Hom.comp` with an extension `F → G`.
-- PerfectoidSpace.fieldPoints.closedPointImage: not stated here; needs `fieldPoints` and the
--   underlying space of a perfectoid space (supplier: AdicSpaces Layer 5). Affinoid core:
--   `fieldPoints.closedPointImage_affinoid`.
-- PerfectoidSpace.fieldPoints_affinoidEquiv: not stated here; the universal property of affinoid
--   adic spaces `Hom(W, Spa(R, R⁺)) ≃ Pair.Hom (R, R⁺) (O(W), O⁺(W))` (supplier: AdicSpaces
--   Layer 5); it identifies `X(K, K⁺)` with `Pair.Hom P F.toPair`.

variable {p K} in
/-- P4/affinoid-perfectoid-field-points (projection, affinoid core of
`fieldPoints.closedPointImage`): for `X = Spa(R, R⁺)` and a `(K, K⁺)`-point
`φ : (R, R⁺) → (K, K⁺)`, the image `Spa(φ)(K⁺)` of the closed point. -/
def fieldPoints.closedPointImage_affinoid {R : Type*} [CommRing R] [TopologicalSpace R]
    [IsTopologicalRing R] [IsHuberRing R] {P : Pair R} (F : AffinoidField p K)
    (φ : Pair.Hom P F.toPair) : spa P.plus :=
  φ.spaComap F.closedPoint

end AffinoidFieldDef

section AffinoidFieldTests

variable (p : ℕ) [Fact p.Prime]

-- test AffinoidField.subsingleton_spa_ofRankOne (computation) [P4/affinoid-perfectoid-field-points]
example (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [IsPerfectoidField p K] : Nonempty (Unique (spa (AffinoidField.ofRankOne p K).toPair.plus)) :=
  sorry

/- `K⁺` the preimage of a rank-one valuation ring of the residue field `K°/K°°` is the same as:
`K⁺ ⊊ K°` with no valuation subring strictly between them. -/
-- test AffinoidField.card_spa_eq_two (computation) [P4/affinoid-perfectoid-field-points]
example (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    (F : AffinoidField p K) (hne : F.toPair.plus ≠ powerBoundedSubring K)
    (h : ∀ V : ValuationSubring K, F.plus ≤ V → V.toSubring ≤ powerBoundedSubring K →
      V = F.plus ∨ V.toSubring = powerBoundedSubring K) :
    Nat.card (spa F.toPair.plus) = 2 ∧
      ∀ x : spa F.toPair.plus, IsClosed ({x} : Set (spa F.toPair.plus)) ↔ x = F.closedPoint :=
  sorry

-- AffinoidField.fieldPoints_affinoidEquiv_closedPoint: not stated here; needs `fieldPoints`,
--   `fieldPoints.closedPointImage` and `fieldPoints_affinoidEquiv` for a perfectoid space
--   (supplier: AdicSpaces Layer 5); on the affinoid side the closed-point image is
--   `fieldPoints.closedPointImage_affinoid` by definition [compatibility test]

/- `ℚ_p` is not a perfectoid field (ECD Remark 3.3), so it carries no affinoid perfectoid field
structure. -/
-- test AffinoidField.not_padic (non-example) [P4/affinoid-perfectoid-field-points]
example : IsEmpty (AffinoidField p ℚ_[p]) := sorry

/- Two incomparable open valuation subrings `V₁, V₂ ⊆ K°` (preimages of incomparable valuation
rings of the residue field): `V₁ ∩ V₂` is a ring of integral elements, not a valuation subring,
and `Spa(K, V₁ ∩ V₂)` has at least two closed points. -/
-- test AffinoidField.not_of_intersection (non-example) [P4/affinoid-perfectoid-field-points]
example (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [IsPerfectoidField p K] (V₁ V₂ : ValuationSubring K) (h₁ : IsOpen (V₁ : Set K))
    (h₂ : IsOpen (V₂ : Set K)) (hb₁ : V₁.toSubring ≤ powerBoundedSubring K)
    (hb₂ : V₂.toSubring ≤ powerBoundedSubring K) (hinc : ¬ V₁ ≤ V₂ ∧ ¬ V₂ ≤ V₁) :
    IsRingOfIntegralElements (V₁.toSubring ⊓ V₂.toSubring) ∧
      (∀ V : ValuationSubring K, V.toSubring ≠ V₁.toSubring ⊓ V₂.toSubring) ∧
      ∃ x y : spa (V₁.toSubring ⊓ V₂.toSubring), x ≠ y ∧
        IsClosed ({x} : Set (spa (V₁.toSubring ⊓ V₂.toSubring))) ∧
        IsClosed ({y} : Set (spa (V₁.toSubring ⊓ V₂.toSubring))) := sorry

end AffinoidFieldTests

