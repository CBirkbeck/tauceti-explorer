/-! ## PerfectoidSpaces:P2/perfectoid-fibre-product-universal-property (theorem) -/

/-! For affinoid perfectoid `X = Spa(A, A⁺)`, `Y = Spa(B, B⁺)`, `Z = Spa(C, C⁺)`, `Spa(B ⊗̂_A C)`
with `Spa(inl)`, `Spa(inr)` is a fibre product in the anchor's adic spaces. By Wedhorn Proposition
8.25 this is the pushout property of `(D, D⁺)` among complete Huber pairs, stated as
`PerfectoidSpace.spaCompletedTensor_isPullback_core`; clause (d) is
`PerfectoidSpace.pullback.surjective_points_affinoid`. -/

-- PerfectoidSpace.spaCompletedTensor_isPullback: not stated here; needs `Spa` of complete Huber
--   pairs in `AdicSpace` and `IsPullback` there (supplier: AdicSpaces Layer 5).
--   `Spa(B ⊗̂_A C)` with `Spa(inl)`, `Spa(inr)` is a pullback of `Spa B → Spa A ← Spa C`, also
--   over rational subsets and arbitrary opens (AdicSpacesPartII:R0/affinoid-fibre-product).
--   Pair-level core: `PerfectoidSpace.spaCompletedTensor_isPullback_core`.

namespace PerfectoidSpace

open Perfectoid

section FibreProductCore

variable (p : ℕ) [Fact p.Prime] {A B C : Type*}
  [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A]
  [CompleteSpace A] [T2Space A] [IsPerfectoidTateRing p A]
  [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B]
  [CompleteSpace B] [T2Space B] [IsPerfectoidTateRing p B]
  [CommRing C] [UniformSpace C] [IsUniformAddGroup C] [IsTopologicalRing C] [IsTateRing C]
  [CompleteSpace C] [T2Space C] [IsPerfectoidTateRing p C]
  [Algebra A B] [Algebra A C] [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]
  (S : Pair A) (T : Pair B) (U : Pair C) (hT : ∀ a ∈ S.plus, algebraMap A B a ∈ T.plus)
  (hU : ∀ a ∈ S.plus, algebraMap A C a ∈ U.plus)

omit [Fact p.Prime] [IsPerfectoidTateRing p A] [IsPerfectoidTateRing p B]
  [IsPerfectoidTateRing p C] in
/-- P2/perfectoid-fibre-product-universal-property (a), pair-level core: `(B ⊗̂_A C, D⁺)` with
`inl`, `inr` is a pushout of `(B, B⁺) ← (A, A⁺) → (C, C⁺)` among complete Hausdorff Huber pairs;
through Wedhorn Proposition 8.25 (`Hom(Y, Spa(R, R⁺)) = Pair.Hom (R, R⁺) (O_Y(Y), O_Y⁺(Y))`) this
is the universal property of `Spa(B ⊗̂_A C)` as a fibre product in adic spaces. For perfectoid test
pairs it is clause (ii) of PerfectoidSpaces:P2/completed-tensor-of-perfectoid-is-perfectoid. -/
theorem spaCompletedTensor_isPullback_core {E : Type*} [CommRing E] [UniformSpace E]
    [IsUniformAddGroup E] [IsTopologicalRing E] [IsHuberRing E] [CompleteSpace E] [T2Space E]
    (V : Pair E) (φ : Pair.Hom T V) (ψ : Pair.Hom U V)
    (h : φ.toRingHom.comp (algebraMap A B) = ψ.toRingHom.comp (algebraMap A C)) :
    ∃! χ : Pair.Hom (Pair.completedTensor S T U hT hU) V,
      χ.comp (Pair.completedTensor.inl S T U hT hU) = φ ∧
        χ.comp (Pair.completedTensor.inr S T U hT hU) = ψ := sorry

end FibreProductCore

end PerfectoidSpace

/-! ## PerfectoidSpaces:P2/fibre-products-of-perfectoid-spaces (construction) -/

/-! `Y ×_X Z` is glued from the affinoid perfectoid pieces `Spa(O_Y(U) ⊗̂_{O_X(U')} O_Z(V))`; the
plus ring is R0's (closure of the integral closure of the image of `O_Y⁺(U) ⊗ O_Z⁺(V)`), almost
but not exactly the completed tensor product of plus rings
(`Perfectoid.completedTensor_plus_almostIso`), and no uniformisation is performed
(`Perfectoid.isIso_toUniformization_completedTensor`). -/

-- PerfectoidSpace.pullback: not stated here; needs `PerfectoidSpace` and gluing of adic spaces
--   (supplier: PerfectoidSpaces:P2/perfectoid-space, AdicSpaces Layer 5). The fibre product
--   `Y ×_X Z` as an object of `Perfd`.
-- PerfectoidSpace.pullback.fst: not stated here; needs `PerfectoidSpace.pullback` (supplier:
--   PerfectoidSpaces:P2/fibre-products-of-perfectoid-spaces, AdicSpaces Layer 5). The projection
--   `Y ×_X Z → Y`; likewise `pullback.snd`.
-- PerfectoidSpace.pullback.condition: not stated here; needs `PerfectoidSpace.pullback` (supplier:
--   AdicSpaces Layer 5). `fst ≫ f = snd ≫ g`.
-- PerfectoidSpace.pullback.lift: not stated here; needs morphisms of adic spaces (supplier:
--   AdicSpaces Layer 5). The unique `T → Y ×_X Z` for an adic space `T` (not necessarily
--   perfectoid); affinoid pair-level core: `PerfectoidSpace.spaCompletedTensor_isPullback_core`.
-- PerfectoidSpace.hasPullbacks: not stated here; needs `PerfectoidSpace` (supplier:
--   PerfectoidSpaces:P2/perfectoid-space). `HasPullbacks PerfectoidSpace`.
-- PerfectoidSpace.pullback.isPullback_toAdicSpace: not stated here; needs `IsPullback` in
--   `AdicSpace` (supplier: AdicSpaces Layer 5). The inclusion `Perfd ⥤ AdicSpace` preserves the
--   fibre product square.
-- PerfectoidSpace.pullbackSpaIso: not stated here; needs `Spa` in `AdicSpace` (supplier:
--   AdicSpaces Layer 5). `Spa(B, B⁺) ×_{Spa(A, A⁺)} Spa(C, C⁺) ≅ Spa(B ⊗̂_A C)` over the
--   projections; pair-level core: `PerfectoidSpace.spaCompletedTensor_isPullback_core`.
-- PerfectoidSpace.pullback.isAffinoidPerfectoid: not stated here; needs
--   `PerfectoidSpace.IsAffinoidPerfectoid` (supplier: AdicSpaces Layer 5). Ring-level core: the
--   instance `Perfectoid.isPerfectoidTateRing_completedTensor`.
-- PerfectoidSpace.pullbackRestrictIso: not stated here; needs open subspaces (supplier:
--   AdicSpaces Layer 5). `p⁻¹(U) ∩ q⁻¹(V) ≅ U ×_X V` over `U` and `V`.
-- PerfectoidSpace.pullback.surjective_points: not stated here; needs the underlying spaces of adic
--   spaces (supplier: AdicSpaces Layer 5). `|Y ×_X Z| → |Y| ×_{|X|} |Z|` is surjective; affinoid
--   core: `PerfectoidSpace.pullback.surjective_points_affinoid`.
-- PerfectoidSpace.Perf.hasPullbacks: not stated here; needs `PerfectoidSpace.Perf` (supplier:
--   PerfectoidSpaces:P2/perfectoid-space). `Perf` is closed under fibre products.
-- PerfectoidSpace.over_hasBinaryProducts: not stated here; needs slice categories of `Perfd`
--   (supplier: PerfectoidSpaces:P2/perfectoid-space). `Perfd/X` has binary products (Mathlib
--   `Over.ConstructProducts.over_binaryProduct_of_pullback`).
-- PerfectoidSpace.pullbackTiltIso: not stated here; needs `PerfectoidSpace.tilt` (supplier:
--   PerfectoidSpaces:P2/perfectoid-spaces-and-glued-tilting); see
--   PerfectoidSpaces:P2/tilting-commutes-with-fibre-products.

namespace PerfectoidSpace

open Perfectoid

section FibrePoints

variable (p : ℕ) [Fact p.Prime] {A B C : Type*}
  [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A]
  [CompleteSpace A] [T2Space A] [IsPerfectoidTateRing p A]
  [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B]
  [CompleteSpace B] [T2Space B] [IsPerfectoidTateRing p B]
  [CommRing C] [UniformSpace C] [IsUniformAddGroup C] [IsTopologicalRing C] [IsTateRing C]
  [CompleteSpace C] [T2Space C] [IsPerfectoidTateRing p C]
  [Algebra A B] [Algebra A C] [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]
  (S : Pair A) (T : Pair B) (U : Pair C) (hT : ∀ a ∈ S.plus, algebraMap A B a ∈ T.plus)
  (hU : ∀ a ∈ S.plus, algebraMap A C a ∈ U.plus)

omit [Fact p.Prime] [IsPerfectoidTateRing p A] [IsPerfectoidTateRing p B]
  [IsPerfectoidTateRing p C] in
/-- P2/fibre-products-of-perfectoid-spaces, affinoid core of `pullback.surjective_points`: every
pair of points of `Spa(B, B⁺)` and `Spa(C, C⁺)` over the same point of `Spa(A, A⁺)` comes from a
point of `Spa(B ⊗̂_A C)` (AdicSpacesPartII:R0/fibre-product-points, by amalgamation of
valuations). The map is not injective in general (finite Galois extensions of perfectoid
fields). -/
theorem pullback.surjective_points_affinoid (y : spa T.plus) (z : spa U.plus)
    (h : Pair.Hom.spaComap (⟨algebraMap A B, IsAdicHom.continuous _, hT⟩ : Pair.Hom S T) y =
      Pair.Hom.spaComap (⟨algebraMap A C, IsAdicHom.continuous _, hU⟩ : Pair.Hom S U) z) :
    ∃ w : spa (Pair.completedTensor S T U hT hU).plus,
      (Pair.completedTensor.inl S T U hT hU).spaComap w = y ∧
        (Pair.completedTensor.inr S T U hT hU).spaComap w = z := sorry

end FibrePoints

end PerfectoidSpace

-- pullback_perfectedDiscs: not stated here; needs `PerfectoidSpace.pullback` (supplier:
--   PerfectoidSpaces:P2/fibre-products-of-perfectoid-spaces, AdicSpaces Layer 5).
