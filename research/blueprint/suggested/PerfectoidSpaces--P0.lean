/-! ## PerfectoidSpaces:P7/frobenius-tower-uniformity-bound (lemma) -/

namespace Perfectoid.FrobeniusTower

variable {p : ℕ} [Fact p.Prime] (T : FrobeniusTower.{u} p)

/-- P7/frobenius-tower-uniformity-bound (other): `p ∈ ϖ^p A_∞⁺`. -/
theorem pow_dvd_p_completedPlus : T.varpiCompleted ^ p ∣ (p : T.completedPlus) := sorry

/-- P7/frobenius-tower-uniformity-bound (i): `Φ : A_∞⁺/ϖ → A_∞⁺/ϖ^p` is bijective (it is the
colimit of the `Φ_m`, `frobenius_colimit_bijective`, under `completedPlus_quotient`; Torsion,
proof of Corollary III.2.19). -/
theorem frobeniusModPow_completedPlus_bijective :
    Function.Bijective (frobeniusModPow p T.varpiCompleted T.pow_dvd_p_completedPlus) := sorry

/-- P7/frobenius-tower-uniformity-bound (ii): `A_∞⁺` is an integral perfectoid ring (BMS1
Definition 3.5, Lemma 3.10 (ii); P1 `IsIntegralPerfectoid`). -/
theorem isIntegralPerfectoid_completedPlus : IsIntegralPerfectoid p T.completedPlus := sorry

/-- P7/frobenius-tower-uniformity-bound (iii): `A_∞⁺ ⊆ A_∞°`. -/
theorem completedPlus_le_powerBounded :
    (algebraMap T.completedPlus T.completed).range ≤ powerBoundedSubring T.completed := sorry

/-- P7/frobenius-tower-uniformity-bound (iii), the uniformity bound: `ϖ·A_∞° ⊆ A_∞⁺`
(BMS1 Lemma 3.21). -/
theorem pseudoUniformizer_mul_powerBounded_le (x : T.completed)
    (hx : x ∈ powerBoundedSubring T.completed) :
    algebraMap T.completedPlus T.completed T.varpiCompleted * x ∈
      (algebraMap T.completedPlus T.completed).range := sorry

/-- P7/frobenius-tower-uniformity-bound (iii): `A_∞°` is bounded, so `A_∞` is uniform and the
`ϖ`-adic topology of `A_∞⁺` is that of the spectral norm. -/
theorem isBounded_powerBoundedSubring_completed :
    IsBounded (powerBoundedSubring T.completed : Set T.completed) := sorry

/-- P7/frobenius-tower-uniformity-bound (iii): after replacing `ϖ` by a unit multiple with a
compatible system of `p`-power roots (BMS1 Lemma 3.9), the cokernel of `A_∞⁺ → A_∞°` is killed by
every `ϖ^{1/pⁿ}`: an almost isomorphism for `(ϖ^{1/p^∞})` (P1/perfectoid-almost-setup). -/
theorem exists_roots_almost_completedPlus :
    ∃ (ϖ' : PseudoUniformizerRoots p T.completed) (v : T.completedPlusˣ),
      ϖ'.root 0 = algebraMap T.completedPlus T.completed (v * T.varpiCompleted) ∧
        ∀ (n : ℕ) (x : T.completed), x ∈ powerBoundedSubring T.completed →
          ϖ'.root n * x ∈ (algebraMap T.completedPlus T.completed).range := sorry

/-- P7/frobenius-tower-uniformity-bound (iv): `A_∞⁺ ⊆ A_∞⁺⁺ ⊆ A_∞° ⊆ ϖ⁻¹A_∞⁺`. -/
theorem completedPair_plus_le :
    (algebraMap T.completedPlus T.completed).range ≤ T.completedPair.plus ∧
      T.completedPair.plus ≤ powerBoundedSubring T.completed := sorry

/-! ## PerfectoidSpaces:P7/perfectoid-frobenius-criterion-for-towers (theorem) -/

/-- P7/perfectoid-frobenius-criterion-for-towers (i): `A_∞` is a perfectoid Tate ring (ECD
Definition 3.1; Torsion, proof of Corollary III.2.19), by the uniformity bound and P1
`isPerfectoidTateRing_of_isIntegralPerfectoid`. -/
instance completed_isPerfectoidTateRing : IsPerfectoidTateRing p T.completed := sorry

/-- P7/perfectoid-frobenius-criterion-for-towers (i): `(A_∞, A_∞⁺⁺)` is a perfectoid Tate pair,
of characteristic `p` iff `A_0⁺` is. -/
theorem isPerfectoidPair_completedPair :
    IsPerfectoidPair p T.completedPair ∧ ((p : T.completed) = 0 ↔ (p : T.A 0) = 0) := sorry

/-- P7/perfectoid-frobenius-criterion-for-towers (ii), affinoid core: `Spa(A_∞, A_∞⁺⁺) ~
lim_m Spa(A_m, A_m⁺⁺)`: the restriction map is a homeomorphism onto the limit and the `A_m` are
dense in `A_∞` (via `isCompletedDirectLimit` and
PerfectoidSpaces:P7/tilde-limit-from-completed-colimit). -/
theorem isTildeLimit_genericFibres_affinoid :
    PerfectoidSpace.IsTildeLimit_affinoid T.genericFibre
      (fun a ↦ T.genericFibreHom _ _ (leOfHom a)) T.completedPair T.toCompletedPair := sorry

