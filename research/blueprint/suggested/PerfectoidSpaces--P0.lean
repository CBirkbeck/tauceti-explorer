/-! ## PerfectoidSpaces:P4/almost-integral-perfectoid-criterion (lemma) -/

namespace Perfectoid

section AlmostIntegralCriterion

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]

/-- P4/almost-integral-perfectoid-criterion (Sch12 Lemma 5.6 in Tate-ring form, no base field;
Tor proof of Lemma II.2.2): let `A⁺ ⊆ R` be an open subring carrying the `ϖ`-adic topology with
`R = A⁺[1/ϖ]`, where `ϖ = ϖRoot 0 ∈ A⁺` is a pseudo-uniformizer with compatible `p`-power roots
`ϖRoot n = ϖ^{1/pⁿ} ∈ A⁺` and `ϖ ^ p ∣ p` in `A⁺`, and `A⁺` is `ϖ`-adically complete. If Frobenius
`Φ : A⁺/ϖ^{1/p} → A⁺/ϖ` is an almost isomorphism for the root ideal `⋃ₙ ϖ^{1/pⁿ} A⁺`
(P0 root-ideal basic setup), elementwise: every `ϖ^{1/pⁿ}` kills its kernel (`hker`) and its
cokernel (`hcoker`), then `R` is a perfectoid Tate ring with pseudo-uniformizer `ϖ`. -/
theorem isPerfectoidTateRing_of_almost_frobenius (A₀ : Subring R) (ϖRoot : ℕ → A₀)
    (hroot : ∀ n, ϖRoot (n + 1) ^ p = ϖRoot n) (hopen : IsOpen (A₀ : Set R))
    (hadic : IsAdic (Ideal.span {ϖRoot 0})) (hϖ : IsPseudoUniformizer (ϖRoot 0 : R))
    (hloc : @IsLocalization.Away A₀ _ (ϖRoot 0) R _ A₀.subtype.toAlgebra)
    (hdvd : ϖRoot 0 ^ p ∣ (p : A₀)) (hcompl : IsAdicComplete (Ideal.span {ϖRoot 0}) A₀)
    (hker : ∀ x : A₀, x ^ p ∈ Ideal.span {ϖRoot 0} → ∀ n, ϖRoot n * x ∈ Ideal.span {ϖRoot 1})
    (hcoker : ∀ (y : A₀) (n : ℕ), ∃ x : A₀, ϖRoot n * y - x ^ p ∈ Ideal.span {ϖRoot 0}) :
    IsPerfectoidTateRing p R := sorry

/-- P4/almost-integral-perfectoid-criterion (characterisation, Sch12 Lemmas 5.6, 5.7): under the
hypotheses of `isPerfectoidTateRing_of_almost_frobenius`, `A⁺ ⊆ R°`, the power-bounded subring is
the ring of almost elements `A⁺_* = {x : ϖ^{1/pⁿ} x ∈ A⁺ for all n}` (so `R°/A⁺` is almost zero),
and the integral closure of `A⁺` in `R` is a ring of integral elements. -/
theorem powerBoundedSubring_eq_almostElements_of_almost_frobenius (A₀ : Subring R)
    (ϖRoot : ℕ → A₀) (hroot : ∀ n, ϖRoot (n + 1) ^ p = ϖRoot n) (hopen : IsOpen (A₀ : Set R))
    (hadic : IsAdic (Ideal.span {ϖRoot 0})) (hϖ : IsPseudoUniformizer (ϖRoot 0 : R))
    (hloc : @IsLocalization.Away A₀ _ (ϖRoot 0) R _ A₀.subtype.toAlgebra)
    (hdvd : ϖRoot 0 ^ p ∣ (p : A₀)) (hcompl : IsAdicComplete (Ideal.span {ϖRoot 0}) A₀)
    (hker : ∀ x : A₀, x ^ p ∈ Ideal.span {ϖRoot 0} → ∀ n, ϖRoot n * x ∈ Ideal.span {ϖRoot 1})
    (hcoker : ∀ (y : A₀) (n : ℕ), ∃ x : A₀, ϖRoot n * y - x ^ p ∈ Ideal.span {ϖRoot 0}) :
    A₀ ≤ powerBoundedSubring R ∧
      (∀ x : R, x ∈ powerBoundedSubring R ↔ ∀ n, (ϖRoot n : R) * x ∈ A₀) ∧
      IsRingOfIntegralElements (integralClosure A₀ R).toSubring := sorry

end AlmostIntegralCriterion

/-! ## PerfectoidSpaces:P4/integral-perfectoid-criterion-for-annuli (lemma) -/

section IntegralCriterion

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]

/-- P4/integral-perfectoid-criterion-for-annuli (BMS1 Lemma 3.21, with Lemmas 3.9 and 3.10 (ii)):
let `R₀ ⊆ R` be an open subring carrying the `π`-adic topology with `R = R₀[1/π]`, `π` a
pseudo-uniformizer (a non-zero-divisor of `R₀`) with `π ^ p ∣ p`, `R₀` `π`-adically complete and
*integral perfectoid* (P1 `IsIntegralPerfectoid`, BMS1 Definition 3.5; the pair `(R₀, π)` is the
hypothesis, never the name of an integral model). Then `R` is a perfectoid Tate ring, `R₀ ⊆ R°`,
`π R° ⊆ R₀`, and some unit multiple `ϖ` of `π` has compatible `p`-power roots in `R₀` with
`R°/R₀` killed by every `ϖ^{1/pⁿ}`. -/
theorem isPerfectoidTateRing_localization_of_isIntegralPerfectoid (R₀ : Subring R) (π : R₀)
    (hopen : IsOpen (R₀ : Set R)) (hadic : IsAdic (Ideal.span {π}))
    (hπ : IsPseudoUniformizer (π : R))
    (hloc : @IsLocalization.Away R₀ _ π R _ R₀.subtype.toAlgebra) (hdvd : π ^ p ∣ (p : R₀))
    (hcompl : IsAdicComplete (Ideal.span {π}) R₀) (h : IsIntegralPerfectoid p R₀) :
    IsPerfectoidTateRing p R ∧ R₀ ≤ powerBoundedSubring R ∧
      (∀ x ∈ powerBoundedSubring R, (π : R) * x ∈ R₀) ∧
      ∃ (v : R₀ˣ) (ϖRoot : ℕ → R₀), ϖRoot 0 = v * π ∧ (∀ n, ϖRoot (n + 1) ^ p = ϖRoot n) ∧
        ∀ n, ∀ x ∈ powerBoundedSubring R, (ϖRoot n : R) * x ∈ R₀ := sorry

/-- P4/integral-perfectoid-criterion-for-annuli (supporting data): for a pseudo-uniformizer `ϖ`
with compatible roots and `a = m/p^k`, the ring
`R°[T^{1/p^∞}, S^{1/p^∞}] / (T^{1/pⁿ} S^{1/pⁿ} − ϖ^{a/pⁿ} : n ≥ 0)` (exponents in P1
`PDyadicExp`, `ϖ^{a/pⁿ} = (ϖ^{1/p^{n+k}})^m`), before `ϖ`-adic completion. -/
abbrev annulusPolyQuot_P4 (ϖ : PseudoUniformizerRoots p R) (m k : ℕ) : Type u :=
  AddMonoidAlgebra (powerBoundedSubring R) (PDyadicExp p × PDyadicExp p) ⧸
    Ideal.span (Set.range fun n : ℕ ↦
      AddMonoidAlgebra.single (PDyadicExp.invPow p n, PDyadicExp.invPow p n) 1 -
        AddMonoidAlgebra.single 0 (ϖ.rootPB (n + k) ^ m))

/-- P4/integral-perfectoid-criterion-for-annuli (supporting data): the image of `ϖ` in
`annulusPolyQuot_P4`. -/
def annulusPolyQuot_P4.varpi (ϖ : PseudoUniformizerRoots p R) (m k : ℕ) :
    annulusPolyQuot_P4 p ϖ m k :=
  Ideal.Quotient.mk _ (AddMonoidAlgebra.single 0 (ϖ.rootPB 0))

/-- P4/integral-perfectoid-criterion-for-annuli (supporting data): the integral model `A⁺` of the
compatible-root annulus `R⟨T^{1/p^∞}, (ϖ^a/T)^{1/p^∞}⟩`, the `ϖ`-adic completion of
`annulusPolyQuot_P4`. -/
abbrev annulusModel_P4 (ϖ : PseudoUniformizerRoots p R) (m k : ℕ) : Type u :=
  AdicCompletion (Ideal.span {annulusPolyQuot_P4.varpi p ϖ m k}) (annulusPolyQuot_P4 p ϖ m k)

/-- P4/integral-perfectoid-criterion-for-annuli (application, compatible-root annuli): for `R`
perfectoid and `a = m/p^k > 0`, the annulus model `A⁺` is integral perfectoid and `ϖ` is a
non-zero-divisor on it (it is free over `R°` on the monomials modulo the relations, and Frobenius
`A⁺/ϖ^{1/p} → A⁺/ϖ` is bijective on that basis), so
`isPerfectoidTateRing_localization_of_isIntegralPerfectoid` makes `A⁺[1/ϖ]` perfectoid. Without
the roots of `T` this fails: `R⟨T, ϖ^a/T⟩` is not perfectoid. -/
theorem isIntegralPerfectoid_annulusModel_P4 [IsPerfectoidTateRing p R]
    (ϖ : PseudoUniformizerRoots p R) (m k : ℕ) (hm : 0 < m) :
    IsIntegralPerfectoid p (annulusModel_P4 p ϖ m k) ∧
      IsSMulRegular (annulusModel_P4 p ϖ m k)
        (AdicCompletion.of (Ideal.span {annulusPolyQuot_P4.varpi p ϖ m k})
          (annulusPolyQuot_P4 p ϖ m k) (annulusPolyQuot_P4.varpi p ϖ m k) :
            annulusModel_P4 p ϖ m k) := sorry

end IntegralCriterion

end Perfectoid

/-! ## PerfectoidSpaces:P4/intersection-of-rational-subsets (construction) -/

namespace PerfectoidSpace

open Perfectoid

section ProRational

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  (P : Pair R) {D : PairOfDefinition R} {J : Type u} [SmallCategory J] [IsFiltered J]
  (𝒰 : J ⥤ {𝔭 : D.Presentation // Ideal.span (𝔭.num : Set R) = ⊤}) (j₀ : J)
  (ϖ : PseudoUniformizerRoots p R)

-- PerfectoidSpace.proRationalSubspace: not stated here; the affinoid perfectoid space
--   `Z_𝒰 = Spa(S_𝒰, S⁺_𝒰)` as an object over `X` needs the anchor's adic spaces (supplier:
--   AdicSpaces Layer 5; PerfectoidSpaces:P2/affinoid-perfectoid-space). Ring-level core:
--   `proRationalSubspace_affinoid` with the Huber pair `proRationalSubspace.pair_affinoid`.

/-- P4/intersection-of-rational-subsets (constructor, ring-level core of `proRationalSubspace`):
for a filtered diagram `𝒰 : J ⥤ {presentations}` of rational subsets `U_j = U(T_j/s_j)` of
`X = Spa(R, R⁺)` (Tau Ceti's refinement preorder: an arrow `j → j'` means `U_{j'} ⊆ U_j`), the
ring `S_𝒰 = S⁺_𝒰[1/ϖ]`, `S⁺_𝒰` the `ϖ`-adic completion of `colim_j O⁺_X(U_j)`: stage P1's
completed filtered colimit of the rational localisations `O_X(U_j) = R⟨T_j/s_j⟩` (P2a
`rationalPairFunctor_affinoid`), for the image of a pseudo-uniformizer `ϖ` of `R` with compatible
roots (ECD remark after Lemma 7.6; Bhatt Proposition 9.4.1 (3)). -/
abbrev proRationalSubspace_affinoid : Type u :=
  completedFilteredColimit p (𝒰 ⋙ rationalPairFunctor_affinoid p D) j₀
    (PseudoUniformizerRoots.map p (RationalLoc.toLoc (𝒰.obj j₀).1)
      (RationalLoc.continuous_toLoc _) ϖ)

namespace proRationalSubspace

/-- P4/intersection-of-rational-subsets (data, supporting): the canonical maps
`ι_j : O_X(U_j) → S_𝒰` (P1 `completedFilteredColimit.ι`). -/
def ι_affinoid (j : J) : RationalLoc (𝒰.obj j).1 →+* proRationalSubspace_affinoid p 𝒰 j₀ ϖ :=
  completedFilteredColimit.ι p (𝒰 ⋙ rationalPairFunctor_affinoid p D) j₀
    (PseudoUniformizerRoots.map p (RationalLoc.toLoc (𝒰.obj j₀).1)
      (RationalLoc.continuous_toLoc _) ϖ) j

/-- P4/intersection-of-rational-subsets (data, ring-level core of `proRationalSubspace`): the
Huber pair `(S_𝒰, S⁺_𝒰)`, `S⁺_𝒰` the closure of the subring generated by the images of the
`O⁺_X(U_j)` (P2a `RationalLoc.pair`), which is the `ϖ`-adic completion of their colimit. -/
def pair_affinoid : Pair (proRationalSubspace_affinoid p 𝒰 j₀ ϖ) where
  plus := (Subring.closure (⋃ j, ι_affinoid p 𝒰 j₀ ϖ j ''
    ((RationalLoc.pair (𝒰.obj j).1 P).plus : Set (RationalLoc (𝒰.obj j).1)))).topologicalClosure
  isRingOfIntegralElements := sorry

-- PerfectoidSpace.proRationalSubspace.ι: not stated here; the morphism `ι_𝒰 : Z_𝒰 → X` of
--   perfectoid spaces needs the anchor's adic spaces (supplier: AdicSpaces Layer 5). Affinoid
--   core: `proRationalSubspace.structureMap_affinoid`.

/-- P4/intersection-of-rational-subsets (data, affinoid core of `proRationalSubspace.ι`): the
morphism of Huber pairs `(R, R⁺) → (S_𝒰, S⁺_𝒰)` inducing `ι_𝒰`. -/
def structureMap_affinoid : Pair.Hom P (pair_affinoid p P 𝒰 j₀ ϖ) where
  toRingHom := (ι_affinoid p 𝒰 j₀ ϖ j₀).comp (RationalLoc.toLoc (𝒰.obj j₀).1)
  continuous_toRingHom := sorry
  map_mem_plus := sorry

/-- P4/intersection-of-rational-subsets (data, supporting): the structure map on plus rings
`R⁺ → S⁺_𝒰`. -/
def toPlus_affinoid : P.plus →+* (pair_affinoid p P 𝒰 j₀ ϖ).plus :=
  (structureMap_affinoid p P 𝒰 j₀ ϖ).toRingHom.restrict _ _
    (structureMap_affinoid p P 𝒰 j₀ ϖ).map_mem_plus

/-- P4/intersection-of-rational-subsets (data, supporting): the diagram
`j ↦ O⁺_X(U_j) ⧸ ϖⁿ` of commutative rings (its maps are the restriction maps of P2a
`rationalPairFunctor_affinoid` on plus rings, not constructed at the pin). -/
def plusModDiagram_affinoid (n : ℕ) : J ⥤ CommRingCat.{u} where
  obj j := CommRingCat.of ((RationalLoc.pair (𝒰.obj j).1 P).plus ⧸
    Ideal.span {RationalLoc.toPlus (𝒰.obj j).1 P (ϖ.rootPlus p P) ^ n})
  map := sorry
  map_id := sorry
  map_comp := sorry

-- PerfectoidSpace.proRationalSubspace.plus_mod_pow: not stated here; needs `O⁺_X(U)` as a
--   presheaf on rational subsets (supplier: AdicSpaces Layer 3). Ring-level core:
--   `proRationalSubspace.plus_mod_pow_affinoid`.

/-- P4/intersection-of-rational-subsets (simp core of `plus_mod_pow`): `S⁺_𝒰/ϖⁿ ≅
colim_j O⁺_X(U_j)/ϖⁿ` for every `n` (ECD remark after Lemma 7.6; Bhatt Proposition 9.4.1). -/
theorem plus_mod_pow_affinoid (n : ℕ) :
    Nonempty ((pair_affinoid p P 𝒰 j₀ ϖ).plus ⧸
        Ideal.span {toPlus_affinoid p P 𝒰 j₀ ϖ (ϖ.rootPlus p P) ^ n} ≃+*
      (colimit (plusModDiagram_affinoid p P 𝒰 ϖ n) : CommRingCat.{u})) := sorry

-- PerfectoidSpace.proRationalSubspace.range_ι: not stated here; `|ι_𝒰|` for the morphism of
--   perfectoid spaces (supplier: AdicSpaces Layer 5). Affinoid core: `range_ι_affinoid`.

/-- P4/intersection-of-rational-subsets (characterisation core of `range_ι`): `Spa(S_𝒰) → X` is a
homeomorphism onto `T = ⋂_j U_j` with its subspace topology, and `T` is stable under
generalization (ECD remark after Lemma 7.6; Bhatt Proposition 9.4.1 (3)). -/
theorem range_ι_affinoid :
    IsEmbedding (structureMap_affinoid p P 𝒰 j₀ ϖ).spaComap ∧
      Set.range (structureMap_affinoid p P 𝒰 j₀ ϖ).spaComap =
        ⋂ j, Subtype.val ⁻¹' rationalSubset P.plus (𝒰.obj j).1.num (𝒰.obj j).1.den ∧
      StableUnderGeneralization
        (⋂ j, Subtype.val ⁻¹' rationalSubset P.plus (𝒰.obj j).1.num (𝒰.obj j).1.den :
          Set (spa P.plus)) := sorry

-- PerfectoidSpace.proRationalSubspace.lift: not stated here; a morphism `W → X` from a
--   perfectoid space needs the anchor's adic spaces (supplier: AdicSpaces Layer 5). Affinoid
--   core: `lift_affinoid`.

/-- P4/intersection-of-rational-subsets (universal-property core of `lift`): a morphism
`φ : (R, R⁺) → (B, B⁺)` to a perfectoid pair factors through `(S_𝒰, S⁺_𝒰)` iff `Spa(φ)` lands in
`⋂_j U_j`, and then uniquely (ECD remark after Lemma 7.6). -/
theorem lift_affinoid {B : Type u} [CommRing B] [UniformSpace B] [IsUniformAddGroup B]
    [IsTopologicalRing B] [IsTateRing B] [CompleteSpace B] [T2Space B] [IsPerfectoidTateRing p B]
    {Q : Pair B} (φ : Pair.Hom P Q) :
    (∀ y : spa Q.plus, (φ.spaComap y).1 ∈ ⋂ j, rationalSubset P.plus (𝒰.obj j).1.num
      (𝒰.obj j).1.den) ↔
      ∃! ψ : Pair.Hom (pair_affinoid p P 𝒰 j₀ ϖ) Q,
        ψ.comp (structureMap_affinoid p P 𝒰 j₀ ϖ) = φ := sorry

-- PerfectoidSpace.proRationalSubspace.isInjection: not stated here; needs `IsInjection` of
--   perfectoid spaces (supplier: AdicSpaces Layer 5). Affinoid core: `isInjection_affinoid`.

/-- P4/intersection-of-rational-subsets (other, affinoid core of `isInjection`): `ι_𝒰` is an
injection on affinoid perfectoid test objects (the uniqueness in `lift_affinoid`). -/
theorem isInjection_affinoid : IsInjection_affinoid p (structureMap_affinoid p P 𝒰 j₀ ϖ) :=
  sorry

-- PerfectoidSpace.proRationalSubspace.isLimit: not stated here; a limit cone in the category of
--   perfectoid spaces (supplier: AdicSpaces Layer 5). Ring level: P1
--   `completedFilteredColimit.isColimit` for the diagram `𝒰 ⋙ rationalPairFunctor_affinoid`.
-- PerfectoidSpace.proRationalSubspace.congr: not stated here; an isomorphism of perfectoid spaces
--   over `X` (supplier: AdicSpaces Layer 5). Affinoid core: `congr_affinoid`.

/-- P4/intersection-of-rational-subsets (extensionality core of `congr`): if two filtered
families of rational subsets have the same intersection, their rings `S_𝒰`, `S_𝒱` are
isomorphic over `R`, as topological rings and compatibly with the plus rings (ECD remark after
Lemma 7.6 (d)). -/
theorem congr_affinoid {J' : Type u} [SmallCategory J'] [IsFiltered J']
    (𝒱 : J' ⥤ {𝔭 : D.Presentation // Ideal.span (𝔭.num : Set R) = ⊤}) (j₁ : J')
    (h : ⋂ j, rationalSubset P.plus (𝒰.obj j).1.num (𝒰.obj j).1.den =
      ⋂ j, rationalSubset P.plus (𝒱.obj j).1.num (𝒱.obj j).1.den) :
    ∃ e : proRationalSubspace_affinoid p 𝒰 j₀ ϖ ≃+* proRationalSubspace_affinoid p 𝒱 j₁ ϖ,
      Continuous e ∧ Continuous e.symm ∧
      e.toRingHom.comp (structureMap_affinoid p P 𝒰 j₀ ϖ).toRingHom =
        (structureMap_affinoid p P 𝒱 j₁ ϖ).toRingHom ∧
      (pair_affinoid p P 𝒰 j₀ ϖ).plus.map e.toRingHom = (pair_affinoid p P 𝒱 j₁ ϖ).plus :=
  sorry

-- PerfectoidSpace.proRationalSubspace.isPerfectoid: not stated here; an instance on the
--   perfectoid space `Z_𝒰` (supplier: AdicSpaces Layer 5). Ring-level core:
--   `isPerfectoid_affinoid`.

/-- P4/intersection-of-rational-subsets (instance core of `isPerfectoid`): `S_𝒰` is a perfectoid
Tate ring (P1 `completedFilteredColimit.isPerfectoidTateRing`) and `S°_𝒰/S⁺_𝒰` is almost zero:
every `ϖ^{1/pⁿ}` multiplies `S°_𝒰` into `S⁺_𝒰` (ECD remark after Lemma 7.6 (a), via
P4/almost-integral-perfectoid-criterion). -/
theorem isPerfectoid_affinoid :
    IsPerfectoidTateRing p (proRationalSubspace_affinoid p 𝒰 j₀ ϖ) ∧
      ∀ n, ∀ x ∈ powerBoundedSubring (proRationalSubspace_affinoid p 𝒰 j₀ ϖ),
        (structureMap_affinoid p P 𝒰 j₀ ϖ).toRingHom (ϖ.root n) * x ∈
          (pair_affinoid p P 𝒰 j₀ ϖ).plus := sorry

-- PerfectoidSpace.proRationalSubspace.denseRange: not stated here; stated on rings, where it is
--   `denseRange_affinoid` (the packet item is about `O_X(U)` for the anchor's presheaf, supplier:
--   AdicSpaces Layer 3).

/-- P4/intersection-of-rational-subsets (other, core of `denseRange`): each
`O_X(U_j) → S_𝒰` has dense image (ECD remark after Lemma 7.6 (a)). -/
theorem denseRange_affinoid (j : J) : DenseRange (ι_affinoid p 𝒰 j₀ ϖ j) := sorry

/-- P4/intersection-of-rational-subsets (supporting, used by P4/residue-field-point-injection):
`𝒰` is a diagram of rational neighbourhoods of `x`: every `U_j` contains `x`, and every rational
subset `U(T/s)` (`T` generating the unit ideal) containing `x` contains some `U_j`. -/
def IsRationalNhds (x : spa P.plus) : Prop :=
  (∀ j, x.1 ∈ rationalSubset P.plus (𝒰.obj j).1.num (𝒰.obj j).1.den) ∧
    ∀ 𝔭 : D.Presentation, Ideal.span (𝔭.num : Set R) = ⊤ →
      x.1 ∈ rationalSubset P.plus 𝔭.num 𝔭.den →
        ∃ j, rationalSubset P.plus (𝒰.obj j).1.num (𝒰.obj j).1.den ⊆
          rationalSubset P.plus 𝔭.num 𝔭.den

end proRationalSubspace

end ProRational

section ProRationalTests

variable (p : ℕ) [Fact p.Prime]

/- For a constant diagram `𝒰 = {U}`, `O_X(U) → S_𝒰` is an isomorphism matching the plus rings:
`Z_𝒰 = U`. -/
-- test proRationalSubspace_singleton (degenerate) [P4/intersection-of-rational-subsets]
example {R : Type} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R)
    {D : PairOfDefinition R} (𝔭 : {𝔭 : D.Presentation // Ideal.span (𝔭.num : Set R) = ⊤})
    (ϖ : PseudoUniformizerRoots p R) :
    Function.Bijective (proRationalSubspace.ι_affinoid p ((Functor.const ℕ).obj 𝔭) 0 ϖ 0) ∧
      (proRationalSubspace.pair_affinoid p P ((Functor.const ℕ).obj 𝔭) 0 ϖ).plus =
        (RationalLoc.pair 𝔭.1 P).plus.map
          (proRationalSubspace.ι_affinoid p ((Functor.const ℕ).obj 𝔭) 0 ϖ 0) := sorry

/- For the rational neighbourhoods of `x`, `S_𝒰` is a field (the completed residue field `K(x)`,
ECD Example 5.2) and `Spa(S_𝒰) → X` has image the generalizations of `x`, compatibly with
P4/residue-field-point-injection. -/
-- test proRationalSubspace_rationalNhds (compatibility) [P4/intersection-of-rational-subsets]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R)
    {D : PairOfDefinition R} {J : Type u} [SmallCategory J] [IsFiltered J]
    (𝒰 : J ⥤ {𝔭 : D.Presentation // Ideal.span (𝔭.num : Set R) = ⊤}) (j₀ : J)
    (ϖ : PseudoUniformizerRoots p R) (x : spa P.plus)
    (hx : proRationalSubspace.IsRationalNhds P 𝒰 x) :
    IsField (proRationalSubspace_affinoid p 𝒰 j₀ ϖ) ∧
      Set.range (proRationalSubspace.structureMap_affinoid p P 𝒰 j₀ ϖ).spaComap =
        {y | y ⤳ x} := sorry

-- The perfectoid disc `ℚ_p^cycl⟨T^{1/p^∞}⟩` (P1 `perfectedTateAlgebra`, one variable).
local notation "𝔻" => perfectedTateAlgebra p (padicCyclotomic p) Unit

-- Its Huber pair with plus ring `ℚ_p^cycl°⟨T^{1/p^∞}⟩` (P1 `perfectedTateAlgebra.plus`).
local notation "𝔻₊" =>
  (perfectedTateAlgebra.plus p (σ := Unit) (Pair.powerBounded (padicCyclotomic p)))

-- The coordinate `T`.
local notation "𝕋" => perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0)

/- The family `{|ϖ^{1/pⁿ}| ≤ |T|}` of the perfectoid disc (any presentations of these rational
subsets): `S_𝒰 = C⟨T^{±1/p^∞}⟩` (P1 `completedMonoidAlgebra` over `ℤ[1/p]`), with `T ↦ T`. -/
-- test proRationalSubspace_annulusClosure (computation) [P4/intersection-of-rational-subsets]
example (ϖC : PseudoUniformizerRoots p (padicCyclotomic p)) (D : PairOfDefinition 𝔻)
    (𝒰 : ℕ ⥤ {𝔭 : D.Presentation // Ideal.span (𝔭.num : Set 𝔻) = ⊤})
    (h𝒰 : ∀ n, Subtype.val ⁻¹' rationalSubset 𝔻₊.plus (𝒰.obj n).1.num (𝒰.obj n).1.den =
      {x : spa 𝔻₊.plus |
        x.1.toValuativeRel.vle (algebraMap (padicCyclotomic p) 𝔻 (ϖC.root n)) 𝕋})
    (ϖ : PseudoUniformizerRoots p 𝔻) :
    ∃ e : proRationalSubspace_affinoid p 𝒰 0 ϖ ≃+*
        completedMonoidAlgebra p (padicCyclotomic p) (PDyadicInt p),
      e (proRationalSubspace.ι_affinoid p 𝒰 0 ϖ 0 (RationalLoc.toLoc (𝒰.obj 0).1 𝕋)) =
        completedMonoidAlgebra.monomial p (PDyadicInt p)
          ⟨1, AddSubgroup.subset_closure ⟨0, by simp⟩⟩ := sorry

-- test proRationalSubspace_empty (degenerate) [P4/intersection-of-rational-subsets]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R)
    {D : PairOfDefinition R} {J : Type u} [SmallCategory J] [IsFiltered J]
    (𝒰 : J ⥤ {𝔭 : D.Presentation // Ideal.span (𝔭.num : Set R) = ⊤}) (j₀ : J)
    (ϖ : PseudoUniformizerRoots p R)
    (h : ⋂ j, rationalSubset P.plus (𝒰.obj j).1.num (𝒰.obj j).1.den = ∅) :
    Subsingleton (proRationalSubspace_affinoid p 𝒰 j₀ ϖ) := sorry

/- For the rational neighbourhoods of a rank-one point `η` whose singleton is not open (the Gauss
point of the perfectoid disc), `ι_𝒰` is an injection whose image `{η}` is not open, so it is not
an open immersion. -/
-- test proRationalSubspace_not_open (non-example) [P4/intersection-of-rational-subsets]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R)
    {D : PairOfDefinition R} {J : Type u} [SmallCategory J] [IsFiltered J]
    (𝒰 : J ⥤ {𝔭 : D.Presentation // Ideal.span (𝔭.num : Set R) = ⊤}) (j₀ : J)
    (ϖ : PseudoUniformizerRoots p R) (η : spa P.plus)
    (hη : proRationalSubspace.IsRationalNhds P 𝒰 η) (hrk : ∀ y : spa P.plus, y ⤳ η → y = η)
    (hopen : ¬ IsOpen ({η} : Set (spa P.plus))) :
    IsInjection_affinoid p (proRationalSubspace.structureMap_affinoid p P 𝒰 j₀ ϖ) ∧
      Set.range (proRationalSubspace.structureMap_affinoid p P 𝒰 j₀ ϖ).spaComap = {η} ∧
      ¬ IsOpen (Set.range (proRationalSubspace.structureMap_affinoid p P 𝒰 j₀ ϖ).spaComap) :=
  sorry

end ProRationalTests

/-! ## PerfectoidSpaces:P4/residue-field-point-injection (construction) -/

section ResidueFieldPoint

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  (P : Pair R) {D : PairOfDefinition R} {J : Type u} [SmallCategory J] [IsFiltered J]
  (𝒰 : J ⥤ {𝔭 : D.Presentation // Ideal.span (𝔭.num : Set R) = ⊤}) (j₀ : J)
  (ϖ : PseudoUniformizerRoots p R)

/-! The completed residue field `K(x)` of the anchor (AdicSpaces Layer 3.3) is not in Tau Ceti
(P2a comments on `completedResidueField`). By ECD Example 5.2 (a), `(K(x), K(x)⁺)` is the
pro-rational pair `(S_𝒰, S⁺_𝒰)` of the rational neighbourhoods `𝒰` of `x`; the affinoid cores
below are stated for that pair, and `i_x` restricted to an affinoid neighbourhood is
`proRationalSubspace.structureMap_affinoid`. -/

-- PerfectoidSpace.residueFieldPoint: not stated here; the morphism
--   `i_x : Spa(K(x), K(x)⁺) → X` of perfectoid spaces needs the anchor's adic spaces and the
--   completed residue field (supplier: AdicSpaces Layer 5, Layer 3;
--   PerfectoidSpaces:P2/completed-residue-fields). Affinoid core:
--   `proRationalSubspace.structureMap_affinoid` for rational neighbourhoods, with
--   `residueFieldPoint.isField_affinoid`.

/-- P4/residue-field-point-injection (constructor core of `residueFieldPoint`): for a diagram `𝒰`
of rational neighbourhoods of `x`, `S_𝒰` is a field (`K(x)`) and `S⁺_𝒰` is a valuation ring of it
(`K(x)⁺`: for every `a`, `a ∈ S⁺_𝒰` or `a` has an inverse in `S⁺_𝒰`) (ECD Example 5.2). -/
theorem residueFieldPoint.isField_affinoid (x : spa P.plus)
    (hx : proRationalSubspace.IsRationalNhds P 𝒰 x) :
    IsField (proRationalSubspace_affinoid p 𝒰 j₀ ϖ) ∧
      ∀ a : proRationalSubspace_affinoid p 𝒰 j₀ ϖ,
        a ∈ (proRationalSubspace.pair_affinoid p P 𝒰 j₀ ϖ).plus ∨
          ∃ b ∈ (proRationalSubspace.pair_affinoid p P 𝒰 j₀ ϖ).plus, a * b = 1 := sorry

-- PerfectoidSpace.residueFieldPoint_closedPoint: not stated here; needs `residueFieldPoint`
--   (supplier: AdicSpaces Layer 5). Affinoid core: `residueFieldPoint_closedPoint_affinoid`.

/-- P4/residue-field-point-injection (simp core of `residueFieldPoint_closedPoint`): `Spa(S_𝒰)`
has a closed point (every point specializes to it) and it maps to `x` (ECD Example 5.2). -/
theorem residueFieldPoint_closedPoint_affinoid (x : spa P.plus)
    (hx : proRationalSubspace.IsRationalNhds P 𝒰 x) :
    ∃ z : spa (proRationalSubspace.pair_affinoid p P 𝒰 j₀ ϖ).plus,
      (∀ w, w ⤳ z) ∧ (proRationalSubspace.structureMap_affinoid p P 𝒰 j₀ ϖ).spaComap z = x :=
  sorry

-- PerfectoidSpace.residueFieldPoint_isInjection: not stated here; needs `IsInjection` (supplier:
--   AdicSpaces Layer 5). Affinoid core: `proRationalSubspace.isInjection_affinoid`.
-- PerfectoidSpace.range_residueFieldPoint: not stated here; needs `residueFieldPoint` (supplier:
--   AdicSpaces Layer 5). Affinoid core: `range_residueFieldPoint_affinoid`.

/-- P4/residue-field-point-injection (characterisation core of `range_residueFieldPoint`):
`Spa(K(x), K(x)⁺) → X` is a homeomorphism onto the set of generalizations of `x`
(ECD Example 5.2 (b)). -/
theorem range_residueFieldPoint_affinoid (x : spa P.plus)
    (hx : proRationalSubspace.IsRationalNhds P 𝒰 x) :
    IsEmbedding (proRationalSubspace.structureMap_affinoid p P 𝒰 j₀ ϖ).spaComap ∧
      Set.range (proRationalSubspace.structureMap_affinoid p P 𝒰 j₀ ϖ).spaComap =
        {y | y ⤳ x} := sorry

-- PerfectoidSpace.residueFieldPoint_factor: not stated here; needs `fieldPoints` (supplier:
--   AdicSpaces Layer 5). Affinoid core: `residueFieldPoint_factor_affinoid`.

/-- P4/residue-field-point-injection (universal-property core of `residueFieldPoint_factor`): a
`(K, K⁺)`-point `φ : (R, R⁺) → (K, K⁺)` whose closed point maps to `x` factors uniquely through
`(K(x), K(x)⁺) = (S_𝒰, S⁺_𝒰)` (ECD Example 5.2 (c)). -/
theorem residueFieldPoint_factor_affinoid (x : spa P.plus)
    (hx : proRationalSubspace.IsRationalNhds P 𝒰 x) {K : Type u} [NontriviallyNormedField K]
    [IsUltrametricDist K] [CompleteSpace K] (F : AffinoidField p K) (φ : Pair.Hom P F.toPair)
    (hφ : fieldPoints.closedPointImage_affinoid F φ = x) :
    ∃! ψ : Pair.Hom (proRationalSubspace.pair_affinoid p P 𝒰 j₀ ϖ) F.toPair,
      ψ.comp (proRationalSubspace.structureMap_affinoid p P 𝒰 j₀ ϖ) = φ := sorry

-- PerfectoidSpace.residueFieldPoint_naturality: not stated here; `f ∘ i_y = i_{f(y)} ∘ Spa(K(f(y))
--   → K(y))` needs morphisms of perfectoid spaces and completed residue fields (supplier:
--   AdicSpaces Layer 5; PerfectoidSpaces:P2/completed-residue-fields).
-- PerfectoidSpace.residueFieldPoint_plus_mod: not stated here; `K(x)⁺/ϖ = colim_{V∋x} O⁺_X(V)/ϖ`
--   needs the anchor's presheaf `O⁺_X` (supplier: AdicSpaces Layer 3). Affinoid core:
--   `proRationalSubspace.plus_mod_pow_affinoid` with `n = 1` for rational neighbourhoods.
-- PerfectoidSpace.residueFieldPoint_eq_proRationalSubspace: not stated here; compares two
--   morphisms of perfectoid spaces over `X` (supplier: AdicSpaces Layer 5); in the affinoid cores
--   above `i_x` is the pro-rational structure map by construction.
-- PerfectoidSpace.residueFieldPoint_isRankOne_iff: not stated here; needs `residueFieldPoint`
--   (supplier: AdicSpaces Layer 5). Affinoid core: `residueFieldPoint_isRankOne_iff_affinoid`.

/-- P4/residue-field-point-injection (characterisation core of `residueFieldPoint_isRankOne_iff`):
`x` is a rank-one point (it has no proper generalization) iff `K(x)⁺ = K(x)°` iff
`Spa(K(x), K(x)⁺)` is a single point (ECD Example 5.2). -/
theorem residueFieldPoint_isRankOne_iff_affinoid (x : spa P.plus)
    (hx : proRationalSubspace.IsRationalNhds P 𝒰 x) :
    List.TFAE [∀ y : spa P.plus, y ⤳ x → y = x,
      (proRationalSubspace.pair_affinoid p P 𝒰 j₀ ϖ).plus =
        powerBoundedSubring (proRationalSubspace_affinoid p 𝒰 j₀ ϖ),
      Subsingleton (spa (proRationalSubspace.pair_affinoid p P 𝒰 j₀ ϖ).plus)] := sorry

end ResidueFieldPoint

section ResidueFieldPointTests

variable (p : ℕ) [Fact p.Prime]

/- For `X = Spa(K, K⁺)` and `x` its closed point, `K → K(x)` is an isomorphism matching the plus
rings: `i_x` is the identity. -/
-- test residueFieldPoint_closedPoint (degenerate) [P4/residue-field-point-injection]
example {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    (F : AffinoidField p K) [IsPerfectoidField p K] {D : PairOfDefinition K} {J : Type u}
    [SmallCategory J] [IsFiltered J]
    (𝒰 : J ⥤ {𝔭 : D.Presentation // Ideal.span (𝔭.num : Set K) = ⊤}) (j₀ : J)
    (ϖ : PseudoUniformizerRoots p K)
    (hx : proRationalSubspace.IsRationalNhds F.toPair 𝒰 F.closedPoint) :
    Function.Bijective (proRationalSubspace.structureMap_affinoid p F.toPair 𝒰 j₀ ϖ).toRingHom ∧
      (proRationalSubspace.pair_affinoid p F.toPair 𝒰 j₀ ϖ).plus =
        F.toPair.plus.map (proRationalSubspace.structureMap_affinoid p F.toPair 𝒰 j₀ ϖ).toRingHom :=
  sorry

-- residueFieldPoint_gauss: not stated here; needs the Gauss point of the perfectoid disc as a
--   point of `spa` and the completion of `C(T^{1/p^∞})` for the Gauss norm, neither constructed
--   (supplier: PerfectoidSpaces:P2/completed-residue-fields; AdicSpaces Layer 3)
--   [computation test]
-- residueFieldPoint_not_isOpenImmersion: not stated here; needs `IsOpenImmersion` of perfectoid
--   spaces (supplier: AdicSpaces Layer 5); the affinoid content is the test
--   `proRationalSubspace_not_open` [non-example test]
-- residueFieldPoint_eq_proRationalSubspace: not stated here; compares two morphisms of
--   perfectoid spaces over `X` (supplier: AdicSpaces Layer 5) [compatibility test]

end ResidueFieldPointTests

/-! ## PerfectoidSpaces:P4/qcqs-with-unique-closed-point-is-a-field-point (lemma) -/

-- PerfectoidSpace.isIso_residueFieldPoint_of_unique_closedPoint: not stated here; for a qcqs
--   perfectoid space it needs `residueFieldPoint` (supplier: AdicSpaces Layer 5). Affinoid core:
--   `isIso_residueFieldPoint_of_unique_closedPoint_affinoid`.

section UniqueClosedPoint

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  (P : Pair R) {D : PairOfDefinition R} {J : Type u} [SmallCategory J] [IsFiltered J]
  (𝒰 : J ⥤ {𝔭 : D.Presentation // Ideal.span (𝔭.num : Set R) = ⊤}) (j₀ : J)
  (ϖ : PseudoUniformizerRoots p R)

/-- P4/qcqs-with-unique-closed-point-is-a-field-point (affinoid core; ECD Example 5.2, last
paragraph): if `Spa(R, R⁺)` has a unique closed point `x`, then `i_x` is an isomorphism:
`(R, R⁺) → (K(x), K(x)⁺)` is bijective and matches the plus rings, so `R` is the perfectoid field
`K(x)`. -/
theorem isIso_residueFieldPoint_of_unique_closedPoint_affinoid (x : spa P.plus)
    (hx : proRationalSubspace.IsRationalNhds P 𝒰 x)
    (huniq : ∀ y : spa P.plus, IsClosed ({y} : Set (spa P.plus)) → y = x) :
    Function.Bijective (proRationalSubspace.structureMap_affinoid p P 𝒰 j₀ ϖ).toRingHom ∧
      (proRationalSubspace.pair_affinoid p P 𝒰 j₀ ϖ).plus =
        P.plus.map (proRationalSubspace.structureMap_affinoid p P 𝒰 j₀ ϖ).toRingHom ∧
      IsField R := sorry

end UniqueClosedPoint

/-! ## PerfectoidSpaces:P4/fibre-product-points-surjective (lemma) -/

-- PerfectoidSpace.surjective_pullback_base: not stated here; `|Y₁ ×_X Y₂| → |Y₁| ×_{|X|} |Y₂|`
--   needs fibre products of perfectoid spaces (supplier:
--   PerfectoidSpaces:P2/fibre-products-of-perfectoid-spaces; AdicSpaces Layer 5). Affinoid cores:
--   `surjective_pullback_base_affinoid`, `exists_fieldPoints_of_pullback_affinoid`, on the
--   completed tensor product of the prelude (AdicSpacesPartII:R0/completed-tensor-product).

section FibreProductPoints

variable (p : ℕ) [Fact p.Prime] {A B C : Type u}
  [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A]
  [CompleteSpace A] [T2Space A] [IsPerfectoidTateRing p A]
  [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B]
  [CompleteSpace B] [T2Space B] [IsPerfectoidTateRing p B]
  [CommRing C] [UniformSpace C] [IsUniformAddGroup C] [IsTopologicalRing C] [IsTateRing C]
  [CompleteSpace C] [T2Space C] [IsPerfectoidTateRing p C]
  [Algebra A B] [Algebra A C] [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]
  (S : Pair A) (T : Pair B) (U : Pair C) (hT : ∀ a ∈ S.plus, algebraMap A B a ∈ T.plus)
  (hU : ∀ a ∈ S.plus, algebraMap A C a ∈ U.plus)

/-- P4/fibre-product-points-surjective (affinoid core; ECD proofs of Proposition 5.3 and
Corollary 5.5; AdicSpacesPartII:R0/fibre-product-points): for affinoid perfectoid
`Y₁ = Spa(B, B⁺)`, `Y₂ = Spa(C, C⁺)` over `X = Spa(A, A⁺)`, every pair of points with the same
image in `X` comes from a point of `Spa(B ⊗̂_A C)`. -/
theorem surjective_pullback_base_affinoid (y₁ : spa T.plus) (y₂ : spa U.plus)
    (h : ValuationSpectrum.comap (algebraMap A B) y₁.1 =
      ValuationSpectrum.comap (algebraMap A C) y₂.1) :
    ∃ w : spa (Pair.completedTensor S T U hT hU).plus,
      (Pair.completedTensor.inl S T U hT hU).spaComap w = y₁ ∧
        (Pair.completedTensor.inr S T U hT hU).spaComap w = y₂ := sorry

/-- P4/fibre-product-points-surjective (affinoid core, consequence): for such `y₁, y₂` there are
an affinoid perfectoid field `(L, L⁺)` (the completed residue pair of a point of the fibre
product) and `(L, L⁺)`-points of `Y₁`, `Y₂` agreeing on `X` whose closed points map to `y₁, y₂`
(ECD proof of Proposition 5.3). -/
theorem exists_fieldPoints_of_pullback_affinoid (y₁ : spa T.plus) (y₂ : spa U.plus)
    (h : ValuationSpectrum.comap (algebraMap A B) y₁.1 =
      ValuationSpectrum.comap (algebraMap A C) y₂.1) :
    ∃ (L : Type u) (_ : NontriviallyNormedField L) (_ : IsUltrametricDist L) (_ : CompleteSpace L)
      (F : AffinoidField p L) (a : Pair.Hom T F.toPair) (b : Pair.Hom U F.toPair),
      a.toRingHom.comp (algebraMap A B) = b.toRingHom.comp (algebraMap A C) ∧
        fieldPoints.closedPointImage_affinoid F a = y₁ ∧
        fieldPoints.closedPointImage_affinoid F b = y₂ := sorry

end FibreProductPoints

/-! ## PerfectoidSpaces:P4/algebraically-closed-extension-of-affinoid-field (lemma) -/

section AlgClosedExtension

variable (p : ℕ) [Fact p.Prime] {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K]
  [CompleteSpace K]

/-- P4/algebraically-closed-extension-of-affinoid-field (a), (b) (ECD proof of Lemma 5.4; Sch12
proof of Theorem 3.7): every affinoid perfectoid field `(K, K⁺)` has an extension `(C, C⁺)` with
`C` algebraically closed (the completion of an algebraic closure, `C⁺` dominating `K⁺`),
`C⁺ ∩ K = K⁺`, and `Spa(C, C⁺) → Spa(K, K⁺)` sends the closed point to the closed point. Part (c)
(`Y(K, K⁺) → Y(C, C⁺)` injective for every perfectoid space `Y`) needs `fieldPoints` (supplier:
AdicSpaces Layer 5). -/
theorem AffinoidField.exists_isAlgClosed_extension (F : AffinoidField p K) :
    ∃ (C : Type u) (_ : NontriviallyNormedField C) (_ : IsUltrametricDist C) (_ : CompleteSpace C)
      (G : AffinoidField p C) (ι : Pair.Hom F.toPair G.toPair), IsAlgClosed C ∧
      G.plus.comap ι.toRingHom = F.plus ∧ ι.spaComap G.closedPoint = F.closedPoint := sorry

end AlgClosedExtension

end PerfectoidSpace

/-! ## PerfectoidSpaces:P4/completed-tensor-over-analytic-field-kernel (lemma) -/

namespace Huber

-- Huber.completedTensor_ker_of_field: not stated here; parts (a)–(c) are about completed
