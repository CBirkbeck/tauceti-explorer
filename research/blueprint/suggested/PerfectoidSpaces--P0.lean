/-! ## PerfectoidSpaces:P4/zariski-closed-tilting (comparison) -/

-- PerfectoidSpace.isStronglyZariskiClosed_iff_tilt: not stated here; (a) compares a morphism of
--   perfectoid spaces with its tilt (supplier:
--   PerfectoidSpaces:P2/perfectoid-spaces-and-glued-tilting; P2/tilting-slice-equivalence).
--   Affinoid core of (b): `IsStronglyZariskiClosed_affinoid.tilt`; of (c):
--   `zariskiClosed_tilt_affinoid`.

section ZariskiClosedTilting

variable (p : ℕ) [Fact p.Prime] {R S : Type u} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R] [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
  [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S]
  {P : Pair R} {Q : Pair S}

/-- P4/zariski-closed-tilting (c) (affinoid core; Tor proof of Lemma II.2.7; ECD Lemma 3.11; AWS
Theorem 2.4.4): for strongly Zariski closed `φ` with `I = ker φ`, `I♭ = ker(R♭ → S♭)` is a closed
perfect ideal, `I` is the closure of the ideal generated by `♯(I♭)`, and the tilting homeomorphism
(P2a `spaTilt`) carries `V(I)` onto `V(I♭)`. -/
theorem zariskiClosed_tilt_affinoid (φ : Pair.Hom P Q) (h : IsStronglyZariskiClosed_affinoid φ) :
    IsClosed (RingHom.ker (tilt.map p φ.toRingHom φ.continuous_toRingHom) : Set (tilt p R)) ∧
      (∀ x : tilt p R, x ^ p ∈ RingHom.ker (tilt.map p φ.toRingHom φ.continuous_toRingHom) →
        x ∈ RingHom.ker (tilt.map p φ.toRingHom φ.continuous_toRingHom)) ∧
      RingHom.ker φ.toRingHom = (Ideal.span (tilt.sharp ''
        (RingHom.ker (tilt.map p φ.toRingHom φ.continuous_toRingHom) : Set (tilt p R)))).closure ∧
      spaTilt p P '' zeroLocus P (RingHom.ker φ.toRingHom) =
        zeroLocus (Pair.tilt p P) (RingHom.ker (tilt.map p φ.toRingHom φ.continuous_toRingHom)) :=
  sorry

end ZariskiClosedTilting

end PerfectoidSpace

