    (h : ∀ (C : Type u) [NontriviallyNormedField C] [IsUltrametricDist C] [CompleteSpace C]
      [IsPerfectoidField p C] [IsAlgClosed C] (σ τ : L →+* C), Continuous σ → Continuous τ →
        σ.comp ι = τ.comp ι → σ = τ) :
