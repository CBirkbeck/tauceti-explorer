section ImmersionCore

variable (p : ℕ) [Fact p.Prime] {R S : Type u} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S] [IsTateRing S]
  [CompleteSpace S] [T2Space S] {P : Pair R} {Q : Pair S}

/-- P4/perfectoid-immersion (structure, affinoid core of `IsImmersion`; ECD Definition 5.6): the
map `Spa(Q) → Spa(P)` of `φ` is an injection and a locally closed embedding. -/
structure IsImmersion_affinoid (φ : Pair.Hom P Q) : Prop where
  /-- `φ` is an injection on affinoid perfectoid test objects. -/
  isInjection : IsInjection_affinoid p φ
  /-- `|Spa(φ)|` is a topological embedding. -/
  isEmbedding : IsEmbedding φ.spaComap
  /-- The image of `|Spa(φ)|` is locally closed. -/
  isLocallyClosed_range : IsLocallyClosed (Set.range φ.spaComap)

/-- P4/perfectoid-immersion (structure, affinoid core of `IsOpenImmersion`; ECD Definition 5.6):
an injection whose map on spaces is an open embedding. -/
structure IsOpenImmersion_affinoid (φ : Pair.Hom P Q) : Prop where
  /-- `φ` is an injection on affinoid perfectoid test objects. -/
  isInjection : IsInjection_affinoid p φ
  /-- `|Spa(φ)|` is an open embedding. -/
  isOpenEmbedding : IsOpenEmbedding φ.spaComap

/-- P4/perfectoid-immersion (structure, affinoid core of `IsClosedImmersion`; ECD Definition
5.6): an injection whose map on spaces is a closed embedding. -/
structure IsClosedImmersion_affinoid (φ : Pair.Hom P Q) : Prop where
  /-- `φ` is an injection on affinoid perfectoid test objects. -/
  isInjection : IsInjection_affinoid p φ
  /-- `|Spa(φ)|` is a closed embedding. -/
  isClosedEmbedding : IsClosedEmbedding φ.spaComap

end ImmersionCore

