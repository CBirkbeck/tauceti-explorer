namespace PerfectoidSpace

-- PerfectoidSpace.isAdicComplete_plusSections: not stated here; needs the integral sections
--   `O_Y⁺(Y)` of a perfectoid space `Y` and their restriction maps to affinoid perfectoid opens
--   (supplier: PerfectoidSpaces:P2/perfectoid-space, over AdicSpaces Layer 5). Affinoid core:
--   `isAdicComplete_plusSections_affinoid`; completeness of `R⁺` itself is stage P1's
--   `Perfectoid.isAdicComplete_span_pseudoUniformizer`.

section IntegralSections

open Perfectoid

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P5/integral-sections-are-varpi-complete (affinoid core): for an affinoid perfectoid
`Y = Spa(R, R⁺)` and a ring map `f : B → R⁺` sending `b` to a pseudo-uniformizer, `R⁺` is
`f(b)`-adically complete and separated, and `f` extends uniquely to the `b`-adic completion `B̂`:
the "uniformity of perfectoid spaces" used for the universal property of the limit (ECD proof of
Proposition 6.5). -/
theorem isAdicComplete_plusSections_affinoid (P : Pair R) {B : Type u} [CommRing B] (b : B)
    (f : B →+* P.plus) (hf : IsPseudoUniformizer (f b : R)) :
    IsAdicComplete (Ideal.span {f b}) P.plus ∧
      ∃! g : AdicCompletion (Ideal.span {b}) B →+* P.plus,
        g.comp (algebraMap B (AdicCompletion (Ideal.span {b}) B)) = f := sorry

end IntegralSections

end PerfectoidSpace

