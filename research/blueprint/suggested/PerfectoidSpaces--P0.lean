/-! # Stage P0. Almost mathematics over an abstract basic setup

Everything of this stage lives in `TauCeti.Almost`. A *basic setup* `S : Almost.BasicSetup V` is
data (an idempotent ideal `m` of `V` with `m ⊗_V m` flat), not a class, because one ring carries
several setups. The almost category `Almost.Module S` is Mathlib's Serre-class localisation of
`ModuleCat V` at the almost isomorphisms `S.almostZero.isoModSerre`, realised through the
`HasLocalization.{u}` instance supplied by the firm-module model (`S.Firm`, `S.firm`), so that its
Hom-types are `V`-modules in `Type u`; it is abelian by `SerreClassLocalization.abelian`, `V`-linear
by `Localization.linear`, and symmetric monoidal by `LocalizedMonoidal`. Almost algebras are
`CommMon (Almost.Module S)`. Module-theoretic and étale notions for almost algebras are carried by
honest representatives: for a setup `T` on `R` and an `R`-algebra `R'`, the predicates
`IsAlmostFlatAlg T R'`, `IsAlmostEtaleAlg T R'`, `IsAlmostFiniteEtaleAlg T R'` … are statements
about `R'^a` over `R^a`, and a morphism `f : A ⟶ B` of almost algebras is flat, étale, … if `B_*`
is so over `A_*` through `f_*` (GR Remark 2.2.12).

Sources: GR = Gabber–Ramero, *Almost ring theory* (arXiv math/0201175 v3; its numbering, not the
LNM 1800 numbering); Sch12 = Scholze, *Perfectoid spaces* (arXiv 1111.4914 v1); Bhatt = Bhatt,
*Lecture notes on perfectoid spaces* (2017); ECD = Scholze, *Étale cohomology of diamonds* (arXiv
1709.07343 v4); KL = Kedlaya–Liu, *Relative p-adic Hodge theory: foundations* (arXiv 1301.0792 v5);
Berkeley = Scholze–Weinstein, *Berkeley lectures on p-adic geometry*.

The classical cotangent complex is not in Mathlib at the pin (only the naive one,
`Algebra.Extension.cotangentComplex`, `Algebra.H1Cotangent`); the almost cotangent complex and the
deformation theory built on it are comments naming the supplier `DerivedDeRhamCohomology:DD.0`,
with naive-cotangent cores stated under suffixed names. -/

noncomputable section

namespace TauCeti

universe u

open CategoryTheory Limits MonoidalCategory TensorProduct

namespace Almost

/-! ## PerfectoidSpaces:P0/almost-basic-setup (definition) -/

/-- P0/almost-basic-setup (structure): a *basic setup* `(V, m)`: an ideal `m` of `V` with
`m * m = m` (Gabber–Ramero's basic setup, GR (2.1.1)) such that `m̃ = m ⊗_V m` is flat (GR's
standing assumption from (2.5.14) on). Data, not a class: one ring carries several setups. -/
structure BasicSetup (V : Type u) [CommRing V] where
  /-- The ideal `m`. -/
  ideal : Ideal V
  /-- `m * m = m`, in the semiring `Ideal V`. -/
  isIdempotentElem : IsIdempotentElem ideal
  /-- `m̃ = m ⊗_V m` is a flat `V`-module. -/
  flat_tilde : Module.Flat V (ideal ⊗[V] ideal)

namespace BasicSetup

variable {V : Type u} [CommRing V] (S : BasicSetup V)

/-- P0/almost-basic-setup (data): the `V`-module `m̃ := m ⊗_V m` (GR (2.1.1)). -/
abbrev tilde : Type u := S.ideal ⊗[V] S.ideal

/-- P0/almost-basic-setup (data): the multiplication map `m̃ → V`, `x ⊗ y ↦ xy`, whose image is
`m · m = m` (GR (2.1.1)). -/
def tildeMul : S.tilde →ₗ[V] V :=
  TensorProduct.lift ((LinearMap.mul V V).compl₁₂ S.ideal.subtype S.ideal.subtype)

/-- P0/almost-basic-setup (simp): `m * m = m` (GR (2.1.1)). -/
@[simp] theorem ideal_mul_self : S.ideal * S.ideal = S.ideal := sorry

/-- P0/almost-basic-setup (data): a `V`-module `M` is *almost zero* if `m · M = 0`
(GR (2.1.3)). -/
def IsAlmostZero (M : Type*) [AddCommGroup M] [Module V M] : Prop :=
  ∀ ε ∈ S.ideal, ∀ x : M, ε • x = 0

/-- P0/almost-basic-setup (data): a `V`-linear map is an *almost isomorphism* if its kernel and
cokernel are almost zero (GR (2.2.2)). -/
def IsAlmostIso {M N : Type*} [AddCommGroup M] [Module V M] [AddCommGroup N] [Module V N]
    (f : M →ₗ[V] N) : Prop :=
  S.IsAlmostZero (LinearMap.ker f) ∧ S.IsAlmostZero (N ⧸ LinearMap.range f)

/-- P0/almost-basic-setup (data): the almost zero `V`-modules, as an object property of
`ModuleCat V` (GR (2.2.2)). -/
def almostZero : ObjectProperty (ModuleCat.{u} V) := fun M ↦ S.IsAlmostZero M

/-- P0/almost-basic-setup (example): the classical setup `(V, V)`, the "classical limit" of
GR Example 2.1.2(ii). -/
def classical (V : Type u) [CommRing V] : BasicSetup V where
  ideal := ⊤
  isIdempotentElem := sorry
  flat_tilde := sorry

/-- P0/almost-basic-setup (characterisation): for the classical setup, almost zero means zero
(GR Example 2.1.2(ii)). -/
theorem isAlmostZero_classical_iff (M : Type*) [AddCommGroup M] [Module V M] :
    (classical V).IsAlmostZero M ↔ Subsingleton M := sorry

/-- P0/almost-basic-setup (constructor): the base change `(W, m·W)` of a setup along `V → W`
(P0/basic-setup-base-change, GR Remark 2.1.4(ii)). -/
def baseChange (W : Type*) [CommRing W] [Algebra V W] : BasicSetup W where
  ideal := S.ideal.map (algebraMap V W)
  isIdempotentElem := sorry
  flat_tilde := sorry

/-- P0/almost-basic-setup (data): condition (A) of GR (2.1.6): `m` is the directed union of the
principal ideals it contains, i.e. any two elements of `m` lie in one principal ideal `zV ⊆ m`. -/
def IsFilteredPrincipal : Prop :=
  ∀ x ∈ S.ideal, ∀ y ∈ S.ideal, ∃ z ∈ S.ideal, x ∈ Ideal.span {z} ∧ y ∈ Ideal.span {z}

/-- P0/almost-basic-setup (data): condition (B) of GR (2.1.6): for every `k ≥ 1` the `k`-th
powers of elements of `m` generate `m`. -/
def PowersGenerate : Prop :=
  ∀ k : ℕ, 1 ≤ k → S.ideal = Ideal.span {y | ∃ x ∈ S.ideal, y = x ^ k}

/-- P0/almost-basic-setup (relation): condition (A) implies condition (B) (GR (2.1.6)). -/
theorem IsFilteredPrincipal.powersGenerate {S : BasicSetup V} (h : S.IsFilteredPrincipal) :
    S.PowersGenerate := sorry

/-- P0/almost-basic-setup (characterisation): `M` is almost zero iff `m̃ ⊗_V M = 0`
(P0/almost-zero-iff-tilde-tensor-zero, GR Remark 2.1.4(i)). -/
theorem isAlmostZero_iff_tensor_eq_zero (M : Type*) [AddCommGroup M] [Module V M] :
    S.IsAlmostZero M ↔ Subsingleton (S.tilde ⊗[V] M) := sorry

-- test BasicSetup.test_classical (degenerate) [P0/almost-basic-setup]
example (M : Type u) [AddCommGroup M] [Module V M] :
    (classical V).ideal = ⊤ ∧ ((classical V).IsAlmostZero M ↔ Subsingleton M) := sorry

-- test BasicSetup.test_zero_ideal (degenerate) [P0/almost-basic-setup]
example : ∃ S : BasicSetup V, S.ideal = ⊥ ∧
    ∀ (M : Type u) [AddCommGroup M] [Module V M], S.IsAlmostZero M := sorry

/- `ℤ_p` with its maximal ideal `pℤ_p`: `m * m = p²ℤ_p ≠ m`, so no basic setup has this ideal. -/
-- test BasicSetup.test_not_dvr (non-example) [P0/almost-basic-setup]
example (p : ℕ) [Fact p.Prime] : ¬ IsIdempotentElem (IsLocalRing.maximalIdeal ℤ_[p]) := sorry

/- A valuation ring `O` with maximal ideal `m` (e.g. `O = 𝒪_{ℂ_p}`), `π = p` and `s = p^{1/2}`: the
residue field is almost zero, `O/πO` is not (`s • 1 ≠ 0` in it). -/
-- test BasicSetup.test_valuation_ring (computation) [P0/almost-basic-setup]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O] (S : BasicSetup O)
    (hS : S.ideal = IsLocalRing.maximalIdeal O) (π s : O) (hs : s * s = π)
    (hsm : s ∈ IsLocalRing.maximalIdeal O) (hs0 : s ∉ Ideal.span {π}) :
    S.IsAlmostZero (IsLocalRing.ResidueField O) ∧ ¬ S.IsAlmostZero (O ⧸ Ideal.span {π}) := sorry

-- test BasicSetup.test_isIdempotentElem (compatibility) [P0/almost-basic-setup]
example : S.ideal * S.ideal = S.ideal ∧ (Module.Flat V S.ideal →
    Function.Injective S.tildeMul ∧ LinearMap.range S.tildeMul = S.ideal) := sorry

/-! ## PerfectoidSpaces:P0/almost-zero-iff-tilde-tensor-zero (lemma) -/

/-- P0/almost-zero-iff-tilde-tensor-zero: `m · M = 0` iff `m ⊗_V M = 0` (GR Remark 2.1.4(i)). -/
theorem isAlmostZero_iff_ideal_tensor (M : Type*) [AddCommGroup M] [Module V M] :
    S.IsAlmostZero M ↔ Subsingleton (S.ideal ⊗[V] M) := sorry

/-- P0/almost-zero-iff-tilde-tensor-zero: `f` is an almost isomorphism iff `1 ⊗ f` is an
isomorphism on `m̃ ⊗_V −` (GR Remark 2.1.4(i)). -/
theorem isAlmostIso_iff_bijective_lTensor {M N : Type*} [AddCommGroup M] [Module V M]
    [AddCommGroup N] [Module V N] (f : M →ₗ[V] N) :
    S.IsAlmostIso f ↔ Function.Bijective (f.lTensor S.tilde) := sorry

/-- P0/almost-zero-iff-tilde-tensor-zero: if `m` is flat, the multiplication `m̃ → m` is an
isomorphism (GR (2.1.3)). -/
theorem tildeMul_injective_of_flat (h : Module.Flat V S.ideal) :
    Function.Injective S.tildeMul ∧ LinearMap.range S.tildeMul = S.ideal := sorry

/-! ## PerfectoidSpaces:P0/tilde-ideal-idempotent (lemma) -/

/-- P0/tilde-ideal-idempotent: `m̃ ⊗_V m ≅ m̃`, `x ⊗ y ⊗ z ↦ x ⊗ yz` (GR Claim 2.1.10). -/
def tildeTensorIdealEquiv : S.tilde ⊗[V] S.ideal ≃ₗ[V] S.tilde := sorry

/-- P0/tilde-ideal-idempotent: the multiplication `m̃ ⊗_V m̃ ≅ m̃`; `m̃` is an idempotent
`V`-module (GR Claim 2.1.10). -/
def tildeTensorTildeEquiv : S.tilde ⊗[V] S.tilde ≃ₗ[V] S.tilde := sorry

/-- P0/tilde-ideal-idempotent: symmetric tensors of `m`: `x ⊗ y = y ⊗ x` in `m̃`
(proof of GR Claim 2.1.10). -/
theorem tmul_comm_tilde (x y : S.ideal) : (x ⊗ₜ[V] y : S.tilde) = y ⊗ₜ x := sorry

/-! ## PerfectoidSpaces:P0/basic-setup-base-change (lemma) -/

/-- P0/basic-setup-base-change: `W ⊗_V m̃ ≅ (mW) ⊗_W (mW)`, so `(mW)~` is `W`-flat and
`S.baseChange W` is a basic setup (GR Remark 2.1.4(ii)). -/
def baseChangeTildeEquiv (W : Type*) [CommRing W] [Algebra V W] :
    W ⊗[V] S.tilde ≃ₗ[W] (S.baseChange W).tilde := sorry

/-- P0/basic-setup-base-change: the ideal of the base-changed setup (GR Remark 2.1.4(ii)). -/
@[simp] theorem baseChange_ideal (W : Type*) [CommRing W] [Algebra V W] :
    (S.baseChange W).ideal = S.ideal.map (algebraMap V W) := rfl

/-! ## PerfectoidSpaces:P0/filtered-principal-union-tilde-flat (lemma) -/

/-- P0/filtered-principal-union-tilde-flat: an idempotent ideal satisfying condition (A) has a flat
`m ⊗_V m` (GR Proposition 2.1.7(i)). -/
theorem flat_tensor_of_filteredPrincipal (m : Ideal V) (hm : IsIdempotentElem m)
    (hA : ∀ x ∈ m, ∀ y ∈ m, ∃ z ∈ m, x ∈ Ideal.span {z} ∧ y ∈ Ideal.span {z}) :
    Module.Flat V (m ⊗[V] m) := sorry

/-- P0/filtered-principal-union-tilde-flat (constructor): the basic setup of an idempotent ideal
satisfying condition (A) (GR Proposition 2.1.7(i)). -/
def ofFilteredPrincipal (m : Ideal V) (hm : IsIdempotentElem m)
    (hA : ∀ x ∈ m, ∀ y ∈ m, ∃ z ∈ m, x ∈ Ideal.span {z} ∧ y ∈ Ideal.span {z}) :
    BasicSetup V where
  ideal := m
  isIdempotentElem := hm
  flat_tilde := flat_tensor_of_filteredPrincipal m hm hA

/-! ## PerfectoidSpaces:P0/root-ideal-basic-setup (construction) -/

/-- P0/root-ideal-basic-setup (constructor): the *root setup* of a sequence `ϖ` with
`ϖ (n + 1) ^ p = ϖ n`, `p ≥ 2`: the ideal `m = ⋃ ϖ_n V` (ECD Definition 3.21, Bhatt Example
4.1.3). -/
def ofCompatibleRoots (p : ℕ) (hp : 2 ≤ p) (ϖ : ℕ → V) (hϖ : ∀ n, ϖ (n + 1) ^ p = ϖ n) :
    BasicSetup V where
  ideal := Ideal.span (Set.range ϖ)
  isIdempotentElem := sorry
  flat_tilde := sorry

section roots

open scoped Pointwise

variable (p : ℕ) (hp : 2 ≤ p) (ϖ : ℕ → V) (hϖ : ∀ n, ϖ (n + 1) ^ p = ϖ n)

/-- P0/root-ideal-basic-setup (simp): the ideal of the root setup (ECD Definition 3.21). -/
@[simp] theorem ofCompatibleRoots_ideal :
    (ofCompatibleRoots p hp ϖ hϖ).ideal = Ideal.span (Set.range ϖ) := rfl

/-- P0/root-ideal-basic-setup (characterisation): `x ∈ m` iff some `ϖ_n` divides `x`, `m` being
the increasing union of the `ϖ_n V` (Bhatt Example 4.1.3). -/
theorem mem_ofCompatibleRoots_ideal (x : V) :
    x ∈ (ofCompatibleRoots p hp ϖ hϖ).ideal ↔ ∃ n, ϖ n ∣ x := sorry

/-- P0/root-ideal-basic-setup (characterisation): almost zero means killed by every `ϖ_n`
(ECD Definition 3.21). -/
theorem ofCompatibleRoots_isAlmostZero_iff (M : Type*) [AddCommGroup M] [Module V M] :
    (ofCompatibleRoots p hp ϖ hϖ).IsAlmostZero M ↔
      ∀ n, ϖ n • (⊤ : Submodule V M) = ⊥ := sorry

/-- P0/root-ideal-basic-setup (relation): the root setup satisfies condition (A)
(Bhatt Example 4.1.3). -/
theorem ofCompatibleRoots_isFilteredPrincipal :
    (ofCompatibleRoots p hp ϖ hϖ).IsFilteredPrincipal := sorry

/-- P0/root-ideal-basic-setup (other): if `ϖ_0` is a nonzerodivisor then `m` is flat and the
multiplication `m̃ → m` is an isomorphism (Bhatt Example 4.1.3). -/
theorem ofCompatibleRoots_flat_ideal (h0 : IsSMulRegular V (ϖ 0)) :
    Module.Flat V (ofCompatibleRoots p hp ϖ hϖ).ideal ∧
      Function.Injective (ofCompatibleRoots p hp ϖ hϖ).tildeMul ∧
      LinearMap.range (ofCompatibleRoots p hp ϖ hϖ).tildeMul =
        (ofCompatibleRoots p hp ϖ hϖ).ideal := sorry

/-- P0/root-ideal-basic-setup (extensionality): shifting the sequence gives the same setup
(ECD Definition 3.21). -/
theorem ofCompatibleRoots_shift (k : ℕ) :
    ofCompatibleRoots p hp (fun n ↦ ϖ (k + n)) (fun n ↦ hϖ (k + n)) =
      ofCompatibleRoots p hp ϖ hϖ := sorry

/-- P0/root-ideal-basic-setup (extensionality): sequences generating the same principal ideals
from some index on give the same setup (ECD Definition 3.21). -/
theorem ofCompatibleRoots_eq_of_span_eq (ϖ' : ℕ → V) (hϖ' : ∀ n, ϖ' (n + 1) ^ p = ϖ' n) (c N : ℕ)
    (h : ∀ n, N ≤ n → Ideal.span {ϖ' n} = Ideal.span {ϖ (n + c)}) :
    ofCompatibleRoots p hp ϖ' hϖ' = ofCompatibleRoots p hp ϖ hϖ := sorry

/-- P0/root-ideal-basic-setup (compatibility): base change of a root setup is the root setup of
the image sequence (GR Remark 2.1.4(ii)). -/
theorem ofCompatibleRoots_baseChange (W : Type*) [CommRing W] [Algebra V W] :
    (ofCompatibleRoots p hp ϖ hϖ).baseChange W =
      ofCompatibleRoots p hp (fun n ↦ algebraMap V W (ϖ n))
        (fun n ↦ by rw [← map_pow, hϖ]) := sorry

/-- P0/root-ideal-basic-setup (simp): every `ϖ_n` lies in the ideal of the root setup. -/
@[simp] theorem ofCompatibleRoots_mem (n : ℕ) : ϖ n ∈ (ofCompatibleRoots p hp ϖ hϖ).ideal :=
  sorry

end roots

/- `V = 𝔽_p[t^{1/p^∞}]` and `ϖ_n = t^{1/p^n}`: `V/(t)` is not almost zero (`t^{1/p} ≠ 0` in it)
while `V/m ≅ 𝔽_p` is. -/
-- test BasicSetup.ofCompatibleRoots_test_perfect_polynomial (computation)
--   [P0/root-ideal-basic-setup]
example (p : ℕ) (hp : 2 ≤ p) (t : ℕ → V) (ht : ∀ n, t (n + 1) ^ p = t n)
    (hnz : t 1 ∉ Ideal.span {t 0}) :
    ¬ (ofCompatibleRoots p hp t ht).IsAlmostZero (V ⧸ Ideal.span {t 0}) ∧
      (ofCompatibleRoots p hp t ht).IsAlmostZero (V ⧸ (ofCompatibleRoots p hp t ht).ideal) :=
  sorry

-- test BasicSetup.ofCompatibleRoots_test_unit (degenerate) [P0/root-ideal-basic-setup]
example (p : ℕ) (hp : 2 ≤ p) :
    ofCompatibleRoots p hp (fun _ ↦ (1 : V)) (fun _ ↦ one_pow p) = classical V := sorry

-- test BasicSetup.ofCompatibleRoots_test_no_roots (non-example) [P0/root-ideal-basic-setup]
example (p : ℕ) [Fact p.Prime] :
    ¬ IsIdempotentElem (Ideal.span {(Polynomial.X : Polynomial (ZMod p))}) := sorry

/- A valuation ring with `ϖ_n = p^{1/p^n}` cofinal in `m` (e.g. `𝒪_{ℂ_p}`): the root setup has the
maximal ideal as ideal. -/
-- test BasicSetup.ofCompatibleRoots_test_valuation (compatibility) [P0/root-ideal-basic-setup]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O] (p : ℕ) (hp : 2 ≤ p)
    (ϖ : ℕ → O) (hϖ : ∀ n, ϖ (n + 1) ^ p = ϖ n)
    (hcof : ∀ x ∈ IsLocalRing.maximalIdeal O, ∃ n, ϖ n ∣ x)
    (h0 : ϖ 0 ∈ IsLocalRing.maximalIdeal O) :
    (ofCompatibleRoots p hp ϖ hϖ).ideal = IsLocalRing.maximalIdeal O := sorry

/-! ## PerfectoidSpaces:P0/valuation-ring-basic-setup (construction) -/

/-- P0/valuation-ring-basic-setup (constructor): the setup `(O, 𝔪)` of a valuation domain whose
maximal ideal is not finitely generated (GR Example 2.1.2(i), Sch12 Lemma 4.2, ECD Example
3.22(i)). -/
def ofValuationRing (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) : BasicSetup O where
  ideal := IsLocalRing.maximalIdeal O
  isIdempotentElem := sorry
  flat_tilde := sorry

section valuation

variable (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
  (h : ¬ (IsLocalRing.maximalIdeal O).FG)

/-- P0/valuation-ring-basic-setup (simp): the ideal of `ofValuationRing` is the maximal ideal. -/
@[simp] theorem ofValuationRing_ideal :
    (ofValuationRing O h).ideal = IsLocalRing.maximalIdeal O := rfl

/-- P0/valuation-ring-basic-setup (characterisation): for a valuation domain, `𝔪² = 𝔪` iff `𝔪` is
not finitely generated (Sch12 proof of Lemma 4.2). -/
theorem isIdempotentElem_maximalIdeal_iff :
    IsIdempotentElem (IsLocalRing.maximalIdeal O) ↔ ¬ (IsLocalRing.maximalIdeal O).FG := sorry

/-- P0/valuation-ring-basic-setup (characterisation): almost zero means killed by `𝔪`, i.e. a
vector space over the residue field (Sch12 §4). -/
theorem ofValuationRing_isAlmostZero_iff (M : Type*) [AddCommGroup M] [Module O M] :
    (ofValuationRing O h).IsAlmostZero M ↔
      IsLocalRing.maximalIdeal O • (⊤ : Submodule O M) = ⊥ := sorry

/-- P0/valuation-ring-basic-setup (example): the residue field is almost zero (Sch12 §4). -/
theorem ofValuationRing_isAlmostZero_residueField :
    (ofValuationRing O h).IsAlmostZero (IsLocalRing.ResidueField O) := sorry

/-- P0/valuation-ring-basic-setup (other): `𝔪` is torsion-free hence flat, and `m̃ ≅ 𝔪` through the
multiplication (Sch12 proof of Lemma 4.2). -/
theorem ofValuationRing_flat_ideal :
    Module.Flat O (IsLocalRing.maximalIdeal O) ∧ Function.Injective (ofValuationRing O h).tildeMul
      := sorry

/-- P0/valuation-ring-basic-setup (relation): the valuation setup satisfies condition (A)
(GR Example 2.1.2(i)). -/
theorem ofValuationRing_isFilteredPrincipal : (ofValuationRing O h).IsFilteredPrincipal := sorry

/-- P0/valuation-ring-basic-setup (compatibility): the valuation setup is the root setup of any
compatible system of `p`-power roots `ϖ_n ∈ 𝔪` that is cofinal in `𝔪` (ECD Example 3.22(i)). -/
theorem ofValuationRing_eq_ofCompatibleRoots (p : ℕ) (hp : 2 ≤ p) (ϖ : ℕ → O)
    (hϖ : ∀ n, ϖ (n + 1) ^ p = ϖ n) (hcof : ∀ x ∈ IsLocalRing.maximalIdeal O, ∃ n, ϖ n ∣ x)
    (h0 : ϖ 0 ∈ IsLocalRing.maximalIdeal O) :
    ofValuationRing O h = ofCompatibleRoots p hp ϖ hϖ := sorry

end valuation

/- `O = 𝒪_{ℂ_p}`, `π = p`, `s = p^{1/2}`: the residue field is almost zero and `O/pO` is not. -/
-- test BasicSetup.ofValuationRing_test_Cp (computation) [P0/valuation-ring-basic-setup]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) (π s : O) (hs : s * s = π)
    (hsm : s ∈ IsLocalRing.maximalIdeal O) (hs0 : s ∉ Ideal.span {π}) :
    (ofValuationRing O h).IsAlmostZero (IsLocalRing.ResidueField O) ∧
      ¬ (ofValuationRing O h).IsAlmostZero (O ⧸ Ideal.span {π}) := sorry

-- test BasicSetup.ofValuationRing_test_dvr (non-example) [P0/valuation-ring-basic-setup]
example (p : ℕ) [Fact p.Prime] :
    (IsLocalRing.maximalIdeal ℤ_[p]).FG ∧ ¬ IsIdempotentElem (IsLocalRing.maximalIdeal ℤ_[p]) :=
  sorry

-- test BasicSetup.ofValuationRing_test_field (degenerate) [P0/valuation-ring-basic-setup]
example (K : Type u) [Field K] :
    (IsLocalRing.maximalIdeal K).FG ∧ ∃ S : BasicSetup K, S.ideal = ⊥ := sorry

-- test BasicSetup.ofValuationRing_test_roots (compatibility) [P0/valuation-ring-basic-setup]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) (p : ℕ) (hp : 2 ≤ p) (ϖ : ℕ → O)
    (hϖ : ∀ n, ϖ (n + 1) ^ p = ϖ n) (hcof : ∀ x ∈ IsLocalRing.maximalIdeal O, ∃ n, ϖ n ∣ x)
    (h0 : ϖ 0 ∈ IsLocalRing.maximalIdeal O) :
    ofValuationRing O h = ofCompatibleRoots p hp ϖ hϖ :=
  ofValuationRing_eq_ofCompatibleRoots O h p hp ϖ hϖ hcof h0

/-! ## PerfectoidSpaces:P0/almost-zero-serre-class (lemma) -/

/-- P0/almost-zero-serre-class: almost zero modules form a Serre class of `ModuleCat V`: they are
closed under submodules, quotients and extensions (Sch12 Lemma 4.2, GR (2.2.2)). -/
instance almostZero_isSerreClass : S.almostZero.IsSerreClass := sorry

/-- P0/almost-zero-serre-class: almost zero modules form a tensor ideal (GR (2.2.2)). -/
theorem isAlmostZero_tensor_left (M N : Type*) [AddCommGroup M] [Module V M] [AddCommGroup N]
    [Module V N] (hM : S.IsAlmostZero M) : S.IsAlmostZero (M ⊗[V] N) := sorry

/-- P0/almost-zero-serre-class: `Hom_V(M, N)` and `Hom_V(N, M)` are almost zero if `M` is
(GR (2.2.2)). -/
theorem isAlmostZero_linearMap (M N : Type*) [AddCommGroup M] [Module V M] [AddCommGroup N]
    [Module V N] (hM : S.IsAlmostZero M) :
    S.IsAlmostZero (M →ₗ[V] N) ∧ S.IsAlmostZero (N →ₗ[V] M) := sorry

/-! ## PerfectoidSpaces:P0/almost-zero-limits-and-colimits (lemma) -/

/-- P0/almost-zero-limits-and-colimits: products of almost zero modules are almost zero
(GR Lemma 2.4.2(i)). -/
theorem isAlmostZero_pi {ι : Type*} (M : ι → Type*) [∀ i, AddCommGroup (M i)]
    [∀ i, Module V (M i)] (h : ∀ i, S.IsAlmostZero (M i)) : S.IsAlmostZero (∀ i, M i) := sorry

/-- P0/almost-zero-limits-and-colimits: limits of almost zero modules are almost zero
(GR Lemma 2.4.2(i)). -/
theorem isAlmostZero_limit {J : Type u} [SmallCategory J] (F : J ⥤ ModuleCat.{u} V)
    (h : ∀ j, S.almostZero (F.obj j)) : S.almostZero (limit F) := sorry

/-- P0/almost-zero-limits-and-colimits: colimits (in particular direct sums) of almost zero
modules are almost zero (GR Lemma 2.4.2(i)). -/
theorem isAlmostZero_colimit {J : Type u} [SmallCategory J] (F : J ⥤ ModuleCat.{u} V)
    (h : ∀ j, S.almostZero (F.obj j)) : S.almostZero (colimit F) := sorry

/-- P0/almost-zero-limits-and-colimits: `lim¹` of an `ℕ`-indexed inverse system of almost zero
modules, the cokernel of `(x_n) ↦ (x_n − φ_n(x_{n+1}))` on `∏ N_n`, is almost zero
(GR Lemma 2.4.2(ii)). -/
theorem isAlmostZero_limOne (N : ℕ → Type*) [∀ n, AddCommGroup (N n)] [∀ n, Module V (N n)]
    (φ : ∀ n, N (n + 1) →ₗ[V] N n) (h : ∀ n, S.IsAlmostZero (N n)) :
    S.IsAlmostZero ((∀ n, N n) ⧸ LinearMap.range
      (LinearMap.pi fun n ↦ LinearMap.proj n - (φ n).comp (LinearMap.proj (n + 1)))) := sorry

/-- P0/almost-zero-limits-and-colimits: a map of `ℕ`-indexed inverse systems which is termwise an
almost isomorphism induces an almost isomorphism on limits (GR Lemma 2.4.2(ii)). -/
theorem isAlmostIso_limMap {F G : ℕᵒᵖ ⥤ ModuleCat.{u} V} (α : F ⟶ G)
    (h : ∀ n, S.IsAlmostIso (α.app n).hom) : S.IsAlmostIso (limMap α).hom := sorry

/-- P0/almost-zero-limits-and-colimits: `Tor_i^V(M, N)` and `Tor_i^V(N, M)` are almost zero if `M`
is (GR Lemma 2.4.2(i)). -/
theorem isAlmostZero_tor (M N : ModuleCat.{u} V) (hM : S.almostZero M) (i : ℕ) :
    S.almostZero (((Tor (ModuleCat.{u} V) i).obj M).obj N) ∧
      S.almostZero (((Tor (ModuleCat.{u} V) i).obj N).obj M) := sorry

/-- P0/almost-zero-limits-and-colimits: `Ext^i_V(M, N)` and `Ext^i_V(N, M)` are killed by `m` if `M`
is almost zero; the action of `ε` is through `ε • 𝟙` (GR Lemma 2.4.2(i)). -/
theorem ext_smul_eq_zero_of_isAlmostZero [HasExt.{u} (ModuleCat.{u} V)] (M N : ModuleCat.{u} V)
    (hM : S.almostZero M) (i : ℕ) (ε : V) (hε : ε ∈ S.ideal) :
    (∀ e : Abelian.Ext M N i, (Abelian.Ext.mk₀ (ε • 𝟙 M)).comp e (zero_add i) = 0) ∧
      ∀ e : Abelian.Ext N M i, e.comp (Abelian.Ext.mk₀ (ε • 𝟙 M)) (add_zero i) = 0 := sorry

/-! ## PerfectoidSpaces:P0/firm-module-model (construction) -/

/-- P0/firm-module-model (data): the multiplication `m̃ ⊗_V M → M`, `x ⊗ y ⊗ z ↦ (xy) • z`
(Bhatt Construction 4.1.5). -/
def tildeAct (M : Type*) [AddCommGroup M] [Module V M] : S.tilde ⊗[V] M →ₗ[V] M :=
  TensorProduct.lift ((LinearMap.lsmul V M).comp S.tildeMul)

/-- P0/firm-module-model (data): `M` is *firm* if `m̃ ⊗_V M → M` is bijective
(Bhatt Construction 4.1.5). -/
def IsFirm (M : Type*) [AddCommGroup M] [Module V M] : Prop :=
  Function.Bijective (S.tildeAct M)

/-- P0/firm-module-model (data): the firm modules, as an object property of `ModuleCat V`. -/
def isFirm : ObjectProperty (ModuleCat.{u} V) := fun M ↦ S.IsFirm M

/-- P0/firm-module-model (structure): the full subcategory of firm `V`-modules
(Bhatt Construction 4.1.5). -/
abbrev Firm : Type (u + 1) := S.isFirm.FullSubcategory

/-- P0/firm-module-model (projection): the inclusion `j_! : S.Firm ⥤ ModuleCat V`
(Bhatt Construction 4.1.5). -/
abbrev Firm.ι : S.Firm ⥤ ModuleCat.{u} V := S.isFirm.ι

/-- P0/firm-module-model (constructor): `j^* : M ↦ m̃ ⊗_V M`, which lands in firm modules since
`m̃ ⊗ m̃ ≅ m̃` (Bhatt Construction 4.1.5). -/
def firm : ModuleCat.{u} V ⥤ S.Firm :=
  S.isFirm.lift (tensorLeft (ModuleCat.of V S.tilde)) (fun _ ↦ sorry)

/-- P0/firm-module-model (constructor): `j_* : N ↦ Hom_V(m̃, N)` (Bhatt Construction 4.1.5). -/
def closure : S.Firm ⥤ ModuleCat.{u} V :=
  Firm.ι S ⋙ ihom (ModuleCat.of V S.tilde)

/-- P0/firm-module-model (universal-property): `j_! ⊣ j^*` (Bhatt Construction 4.1.5). -/
def firmInclusionAdj : Firm.ι S ⊣ S.firm := sorry

/-- P0/firm-module-model (universal-property): `j^* ⊣ j_*` (Bhatt Construction 4.1.5). -/
def firmAdj : S.firm ⊣ S.closure := sorry

/-- P0/firm-module-model: `j_*` is fully faithful (Bhatt Proposition 4.1.7(2)). -/
instance : S.closure.Full := sorry

/-- P0/firm-module-model: `j_*` is fully faithful (Bhatt Proposition 4.1.7(2)). -/
instance : S.closure.Faithful := sorry

/-- P0/firm-module-model: `j^*` is exact, as `m̃` is flat (Bhatt Construction 4.1.5). -/
instance : PreservesFiniteLimits S.firm := sorry

/-- P0/firm-module-model: `j^*` is exact, as `m̃` is flat (Bhatt Construction 4.1.5). -/
instance : PreservesFiniteColimits S.firm := sorry

/-- P0/firm-module-model: `j^*` is additive. -/
instance : S.firm.Additive := sorry

/-- P0/firm-module-model: firm modules are closed under finite biproducts. -/
instance : HasFiniteProducts S.Firm := sorry

/-- P0/firm-module-model (instance): `S.Firm` is abelian, `j^*` being an exact reflector with the
fully faithful right adjoint `j_*` (Bhatt Construction 4.1.5; Mathlib `abelianOfAdjunction`). -/
instance Firm.abelian : Abelian S.Firm :=
  abelianOfAdjunction S.closure S.firm (asIso S.firmAdj.counit) S.firmAdj

/-- P0/firm-module-model (characterisation): the kernel of `j^*` is the class of almost zero
modules (Bhatt Construction 4.1.5, P0/almost-zero-iff-tilde-tensor-zero). -/
theorem firm_kernel : S.firm.kernel = S.almostZero := sorry

/-- P0/firm-module-model (example): `m̃` is firm (GR Claim 2.1.10). -/
theorem isFirm_tilde : S.IsFirm S.tilde := sorry

/-- P0/firm-module-model (instance): the almost isomorphisms have a localised category with
Hom-types in `Type u`, namely `S.Firm` with the localisation functor `j^*` (Mathlib
`Abelian.isLocalization_isoModSerre_kernel_of_leftAdjoint`; Bhatt Proposition 4.1.7(2)). -/
instance hasLocalization : MorphismProperty.HasLocalization.{u} S.almostZero.isoModSerre where
  D := S.Firm
  L := S.firm
  hL := by
    have := Abelian.isLocalization_isoModSerre_kernel_of_leftAdjoint S.firmAdj
    convert this using 2
    exact S.firm_kernel.symm

