/-- P4/completed-tensor-over-analytic-field-kernel (ring-level core; KL Lemma 2.2.9, ECD proof of
Proposition 5.3): for an isometric embedding `K → L` of complete nonarchimedean fields and a Huber
`K`-algebra `B`, `B → L ⊗̂_K B` is injective; in particular `L ⊗̂_K B = 0` forces `B = 0`. -/
theorem completedTensor_ker_of_field_ring {K L B : Type*} [NontriviallyNormedField K]
    [IsUltrametricDist K] [CompleteSpace K] [NontriviallyNormedField L] [IsUltrametricDist L]
    [CompleteSpace L] [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsHuberRing B]
    [Algebra K L] [Algebra K B] [IsAdicHom (algebraMap K L)] [IsAdicHom (algebraMap K B)]
    (hisom : ∀ x : K, ‖algebraMap K L x‖ = ‖x‖) :
    Function.Injective (fun b : B ↦ Pair.completedTensor.tmul K L B ((1 : L) ⊗ₜ[K] b)) ∧
      (Subsingleton (CompletedTensor K L B) → Subsingleton B) := sorry

end Huber

/-! ## PerfectoidSpaces:P4/rank-one-residue-field-rigidity (lemma) -/

namespace Perfectoid

/-- P4/rank-one-residue-field-rigidity (ECD proof of Proposition 5.3; AWS Theorem 2.4.1; KL
Proposition 3.6.11): a continuous homomorphism `ι : K → L` of perfectoid fields such that any two
continuous homomorphisms `L → C` into an algebraically closed perfectoid field agreeing on `K`
are equal is an isomorphism. -/
theorem bijective_of_injective_on_geometricPoints (p : ℕ) [Fact p.Prime] {K L : Type u}
    [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K] [IsPerfectoidField p K]
    [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L] [IsPerfectoidField p L]
