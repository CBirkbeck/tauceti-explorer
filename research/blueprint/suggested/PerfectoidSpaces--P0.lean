--   [compatibility test]

namespace PerfectoidSpace

open Perfectoid

namespace affinoidPerfectoidEquiv

variable (p : ℕ) [Fact p.Prime]

/-- P2/affinoid-perfectoid-space (structure): a *complete perfectoid Tate pair* `(R, R⁺)`: a
complete Hausdorff perfectoid Tate ring (P1 `PerfectoidRingCat`) with a ring of integral elements
`R⁺ ⊆ R°` (Tau Ceti `Huber.Pair`). These are the objects whose adic spectra are the affinoid
perfectoid spaces (Wedhorn Proposition 8.25). -/
structure PairCat : Type (u + 1) where
  /-- The perfectoid Tate ring `R`. -/
  ring : PerfectoidRingCat.{u} p
  /-- The ring of integral elements `R⁺`. -/
  pair : Pair ring

namespace PairCat

/-- P2/affinoid-perfectoid-space (constructor): the bundled complete perfectoid Tate pair. -/
abbrev of (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R) :
    PairCat.{u} p :=
  ⟨PerfectoidRingCat.of p R, P⟩

/-- P2/affinoid-perfectoid-space (instance): complete perfectoid Tate pairs with morphisms of
Huber pairs (continuous ring maps carrying `R⁺` into `S⁺`, Tau Ceti `Huber.Pair.Hom`). -/
instance instCategory : Category.{u} (PairCat.{u} p) where
  Hom X Y := Pair.Hom X.pair Y.pair
  id X := Pair.Hom.id X.pair
  comp f g := g.comp f
  id_comp := sorry
  comp_id := sorry
  assoc := sorry

/-- P2/affinoid-perfectoid-pairs-tilting-equivalence (functoriality): the tilt
`(R, R⁺) ↦ (R♭, R♭⁺)` of complete perfectoid Tate pairs (P1 `Perfectoid.Pair.tilt`,
`Perfectoid.Pair.tiltHom`); its values have characteristic `p`. -/
def tiltFunctor : PairCat.{u} p ⥤ PairCat.{u} p where
  obj X := of p (tilt p X.ring) (Perfectoid.Pair.tilt p X.pair)
  map f := Perfectoid.Pair.tiltHom p f
  map_id := sorry
  map_comp := sorry

end PairCat

end affinoidPerfectoidEquiv

end PerfectoidSpace

/-! ## PerfectoidSpaces:P2/perfectoid-space (definition) -/

/-! A *perfectoid space* is an adic space covered by affinoid perfectoid open subspaces (ECD
Definition 3.19); `Perfd` is the full subcategory of the anchor's adic spaces on them (Mathlib
`ObjectProperty.FullSubcategory`), and `Perf` the full subcategory with `p = 0` in `O_X(X)`. The
discrete adic space `Spa(𝔽_p, 𝔽_p)` is an adic space but not a perfectoid space. The ring-level
form of the characteristic-`p` criterion is P1 `Perfectoid.IsPerfectoidTateRing.iff_perfectRing`
(ECD Proposition 3.5). -/

-- PerfectoidSpace.IsPerfectoidSpace: not stated here; needs the anchor's category `AdicSpace`
--   with open subspaces (supplier: AdicSpaces Layer 5). The predicate on `X`: every point has an
--   open neighbourhood `U` with `X|_U` affinoid perfectoid.
-- PerfectoidSpace: not stated here; needs `AdicSpace` (supplier: AdicSpaces Layer 5). The
--   category `Perfd`, the full subcategory of `AdicSpace` on `IsPerfectoidSpace`.
-- PerfectoidSpace.toAdicSpace: not stated here; needs `AdicSpace` (supplier: AdicSpaces Layer 5).
--   The inclusion `Perfd ⥤ AdicSpace` (Mathlib `ObjectProperty.ι`), fully faithful.
-- PerfectoidSpace.ofSpa: not stated here; needs `Spa(R, R⁺)` as an adic space (supplier:
--   AdicSpaces Layer 5). `Spa(R, R⁺)` as an object of `Perfd` for a complete perfectoid Tate pair.
-- PerfectoidSpace.IsPerfectoidSpace.of_isAffinoidPerfectoid: not stated here; needs `AdicSpace`
--   (supplier: AdicSpaces Layer 5). An affinoid perfectoid space is a perfectoid space.
-- PerfectoidSpace.IsPerfectoidSpace.of_iso: not stated here; needs isomorphisms of adic spaces
--   (supplier: AdicSpaces Layer 5). Closure under isomorphisms.
-- PerfectoidSpace.IsPerfectoidSpace.of_openCover: not stated here; needs open covers of adic
--   spaces (supplier: AdicSpaces Layer 5). An adic space covered by perfectoid open subspaces is
--   perfectoid.
-- PerfectoidSpace.IsPerfectoidSpace.isAnalyticPoint: not stated here; needs analytic points and
--   adic morphisms of adic spaces (supplier: AdicSpaces Layer 5,
--   AdicSpacesPartII:R0/adic-morphism). Every point is analytic, so every morphism into a
--   perfectoid space is adic.
-- PerfectoidSpace.IsPerfectoidSpace.restrict: not stated here; needs open subspaces (supplier:
--   AdicSpaces Layer 5); see PerfectoidSpaces:P2/open-subspaces-of-perfectoid-spaces.
-- PerfectoidSpace.isTopologicalBasis_affinoidPerfectoid: not stated here; needs open subspaces
--   (supplier: AdicSpaces Layer 5); see PerfectoidSpaces:P2/affinoid-perfectoid-basis.
-- PerfectoidSpace.Perf: not stated here; needs `PerfectoidSpace` and `O_X(X)` (supplier:
--   PerfectoidSpaces:P2/perfectoid-space, AdicSpaces Layer 3). The full subcategory of `Perfd`
--   on the `X` with `p = 0` in `O_X(X)`.
-- PerfectoidSpace.mem_perf_iff: not stated here; needs `PerfectoidSpace.Perf` and the discrete
--   adic space `Spa(𝔽_p, 𝔽_p)` (supplier: AdicSpaces Layer 5,
--   AdicSpacesPartII:R0/discrete-huber-pair-sheafy). `X ∈ Perf` iff `p = 0` in every `O_X(U)`
--   iff `X` maps (uniquely) to `Spa(𝔽_p, 𝔽_p)` iff every affinoid perfectoid open has a ring of
--   characteristic `p`.
-- PerfectoidSpace.isPerfectoidSpace_iff_of_charP: not stated here; needs `AdicSpace` (supplier:
--   AdicSpaces Layer 5); see PerfectoidSpaces:P2/characteristic-p-affinoid-perfectoid-criterion.
--   Ring-level core: P1 `Perfectoid.IsPerfectoidTateRing.iff_perfectRing`.

-- isPerfectoidSpace_empty: not stated here; needs the empty adic space (supplier: AdicSpaces
--   Layer 5). It is a perfectoid space, covered by the empty family. [degenerate test]
-- not_isPerfectoidSpace_spa_Qp: not stated here; needs `Spa(ℚ_p, ℤ_p)` as an adic space
--   (supplier: AdicSpaces Layer 5). Its only nonempty open is the whole space, whose ring `ℚ_p`
--   is not perfectoid (ECD Remark 3.3). [non-example test]
-- not_isPerfectoidSpace_closedUnitDisc_Qp: not stated here; needs `Spa(ℚ_p⟨T⟩, ℤ_p⟨T⟩)` as an
--   adic space and completed residue fields (supplier: AdicSpaces Layer 3, Layer 5). The point
--   `T = 0` has completed residue field `ℚ_p`, which is not perfectoid (AWS Corollary 2.5.7).
--   [non-example test]
-- not_isPerfectoidSpace_spa_Fp: not stated here; needs the discrete adic space `Spa(𝔽_p, 𝔽_p)`
--   (supplier: AdicSpacesPartII:R0/discrete-huber-pair-sheafy). It has characteristic `p` but its
--   point is not analytic, so it is not perfectoid. [non-example test]
-- isPerfectoidSpace_discWithDoubledOrigin: not stated here; needs gluing of adic spaces
--   (supplier: AdicSpaces Layer 5). Two perfectoid closed discs over `ℂ_p` glued along the
--   complement of `T = 0` form a quasi-compact, not quasi-separated perfectoid space.
--   [computation test]
-- isSousperfectoid_of_isPerfectoidSpace: not stated here; needs sousperfectoid adic spaces
--   (supplier: AdicSpacesPartII:R5/sousperfectoid-adic-space). Every perfectoid space is
--   sousperfectoid, a perfectoid ring being its own perfectoid frame. [compatibility test]

/-! ## PerfectoidSpaces:P2/affinoid-perfectoid-basis (lemma) -/

/-! For a perfectoid space `X` and an affinoid perfectoid open `V ≅ Spa(R, R⁺)`, every rational
subset `W = R(T/s)` of `V` is affinoid perfectoid with `(O_X(W), O_X⁺(W)) ≅ (R⟨T/s⟩, R⟨T/s⟩⁺)`,
and affinoid perfectoid opens form a basis of `|X|`. The per-presentation ring-level core is
P2a `Perfectoid.rationalLocalization.isPerfectoidTateRing_affinoid`. -/

-- PerfectoidSpace.IsAffinoidPerfectoid.rationalSubset: not stated here; needs open subspaces of
--   adic spaces (supplier: AdicSpaces Layer 5). Rational subsets of affinoid perfectoid opens are
--   affinoid perfectoid.
-- PerfectoidSpace.isTopologicalBasis_affinoidPerfectoid: not stated here; needs open subspaces
--   (supplier: AdicSpaces Layer 5). The affinoid perfectoid opens form a basis of `|X|`; every
--   quasi-compact open is a finite union of them.
-- PerfectoidSpace.IsAffinoidPerfectoid.sectionsIso: not stated here; needs `O_X` on all opens
--   (supplier: AdicSpaces Layer 3). For `V` affinoid perfectoid, `V ≅ Spa(O_X(V), O_X⁺(V))`
--   canonically.

/-! ## PerfectoidSpaces:P2/open-subspaces-of-perfectoid-spaces (lemma) -/

-- PerfectoidSpace.IsPerfectoidSpace.restrict: not stated here; needs the open adic subspace
--   `X|_U` (supplier: AdicSpaces Layer 5). `X|_U` is perfectoid and `X|_U → X` is an open
--   immersion with the universal property in `Perfd` and in adic spaces.
-- PerfectoidSpace.IsPerfectoidSpace.of_isOpenImmersion: not stated here; needs open immersions of
--   adic spaces (supplier: AdicSpaces Layer 5). The source of an open immersion into a perfectoid
--   space is perfectoid.

/-! ## PerfectoidSpaces:P2/characteristic-p-affinoid-perfectoid-criterion (lemma) -/

/-! For an adic space with `p = 0`: perfectoid iff locally `Spa` of a perfect complete Tate ring;
`O_X(U)` is perfect; and (Mihara; Bhatt Exercise 9.3.12) an affinoid adic space that is a
perfectoid space is affinoid perfectoid. The ring-level input is P1
`Perfectoid.IsPerfectoidTateRing.iff_perfectRing` (ECD Proposition 3.5). -/

-- PerfectoidSpace.perfectRing_sections: not stated here; needs `O_X(U)` for all opens `U`
--   (supplier: AdicSpaces Layer 3). For `X` perfectoid of characteristic `p`, `O_X(U)` is perfect.
-- PerfectoidSpace.isAffinoidPerfectoid_iff_of_charP: not stated here; needs affinoid adic spaces
--   and the sheafiness of their structure presheaf (supplier: AdicSpaces Layer 4, Layer 5). An
--   affinoid `X ≅ Spa(A, A⁺)`, `A` Tate of characteristic `p`, that is a perfectoid space has `A`
--   perfect, hence is affinoid perfectoid.

/-! ## PerfectoidSpaces:P2/perfectoid-spaces-and-glued-tilting (construction) -/

/-! The tilt `X ↦ X♭` is glued from `Spa(R♭, R♭⁺)` over the affinoid perfectoid opens
`Spa(R, R⁺) ⊆ X`, along the tilts of common rational refinements (ECD after Definition 3.19; Sch12
Definition 6.16, Proposition 6.17). Its affinoid ingredients are stated in P1 and P2a: the tilt
pair `Perfectoid.Pair.tilt`, the homeomorphism `PerfectoidSpace.spaTiltHomeomorph` matching
rational subsets (`PerfectoidSpace.isRational_image_spaTilt_iff`), the tilt of rational
localisations `Perfectoid.rationalLocalization.tiltEquiv_affinoid`, and in characteristic `p`
`Perfectoid.tilt.equivOfCharP` with `PerfectoidSpace.spaTilt_eq_id_of_charP`. -/

-- PerfectoidSpace.tilt: not stated here; needs `PerfectoidSpace`, `PerfectoidSpace.Perf` and gluing
--   (supplier: PerfectoidSpaces:P2/perfectoid-space, AdicSpaces Layer 5). The functor
--   `Perfd ⥤ Perf`, `X ↦ X♭`, `f ↦ f♭`.
-- PerfectoidSpace.tiltHomeomorph: not stated here; needs the underlying spaces of adic spaces
--   (supplier: AdicSpaces Layer 5). The natural homeomorphism `|X| ≃ₜ |X♭|`; affinoid core: P2a
--   `PerfectoidSpace.spaTiltHomeomorph`.
-- PerfectoidSpace.tiltSpaIso: not stated here; needs `Spa` as an adic space (supplier: AdicSpaces
--   Layer 5). `(Spa(R, R⁺))♭ ≅ Spa(R♭, R♭⁺)`, natural in the pair.
-- PerfectoidSpace.tiltSectionsIso: not stated here; needs `O_X`, `O_X⁺` on all opens (supplier:
--   AdicSpaces Layer 3). `(O_{X♭}(U♭), O⁺_{X♭}(U♭)) ≅ (O_X(U), O⁺_X(U))♭` for `U` affinoid
--   perfectoid; per-presentation core: P2a `Perfectoid.rationalLocalization.tiltEquiv_affinoid`.
-- PerfectoidSpace.isAffinoidPerfectoid_tilt_iff: not stated here; needs open subspaces (supplier:
--   AdicSpaces Layer 5). `U ⊆ X` is affinoid perfectoid iff `U♭ ⊆ X♭` is.
-- PerfectoidSpace.tiltRestrictIso: not stated here; needs open subspaces (supplier: AdicSpaces
--   Layer 5). `(X|_U)♭ ≅ X♭|_{U♭}`; the tilt preserves open immersions and open covers.
-- PerfectoidSpace.sharpSheaf: not stated here; needs `O_X` as a sheaf of topological monoids
--   (supplier: AdicSpaces Layer 3). The multiplicative map `O_{X♭} → O_X`, `f ↦ f♯`, with
--   `|f♯(x)| = |f(x♭)|`, carrying `O⁺_{X♭}` into `O⁺_X`; affinoid core: P1 `Perfectoid.tilt.sharp`.
-- PerfectoidSpace.tiltIsoOfCharP: not stated here; needs `PerfectoidSpace.Perf` (supplier:
--   PerfectoidSpaces:P2/perfectoid-space). `X♭ ≅ X` naturally for `X ∈ Perf`; ring-level core:
--   P1 `Perfectoid.tilt.equivOfCharP`.
-- PerfectoidSpace.tilt_map_spa: not stated here; needs `Spa` of morphisms of pairs (supplier:
--   AdicSpaces Layer 5). Under `tiltSpaIso`, `Spa(φ)♭ = Spa(φ♭)`; pair-level core: P1
--   `Perfectoid.Pair.tiltHom`.
-- PerfectoidSpace.tiltHomeomorph_image_rationalSubset: not stated here; needs open subspaces
--   (supplier: AdicSpaces Layer 5). The homeomorphism carries `U(f♯/g♯)` to `U(f/g)`; affinoid
--   core: P2a `PerfectoidSpace.spaTilt_preimage_rationalSubset`.
-- PerfectoidSpace.tiltOverEquiv: not stated here; needs slice categories of `Perfd` (supplier:
--   PerfectoidSpaces:P2/perfectoid-space); see PerfectoidSpaces:P2/tilting-slice-equivalence.

-- tilt_spa_cyclotomic: not stated here; needs `Spa` as an adic space (supplier: AdicSpaces Layer
--   5). `Spa(ℚ_p^cycl, ℤ_p^cycl)♭ ≅ Spa(𝔽_p((t^{1/p^∞})), 𝔽_p[[t^{1/p^∞}]])`, on one point.
--   [computation test]
-- tilt_spa_perfectedDisc: not stated here; needs `Spa` as an adic space (supplier: AdicSpaces
--   Layer 5). `Spa(R⟨T^{1/p^∞}⟩, R⁺⟨T^{1/p^∞}⟩)♭ ≅ Spa(R♭⟨T^{1/p^∞}⟩, R♭⁺⟨T^{1/p^∞}⟩)`; ring-level
--   core: P1 `Perfectoid.perfectedTateAlgebra.tiltEquiv`. [computation test]
-- tilt_empty: not stated here; needs the empty adic space (supplier: AdicSpaces Layer 5). The tilt
--   of the empty perfectoid space is empty. [degenerate test]
-- tiltIsoOfCharP_spa: not stated here; needs `PerfectoidSpace.Perf` (supplier:
--   PerfectoidSpaces:P2/perfectoid-space). `Spa(𝔽_p((t^{1/p^∞})))♭ ≅ Spa(𝔽_p((t^{1/p^∞})))` by
--   the zeroth coordinate. [compatibility test]
-- tilt_not_injective_on_iso_classes: not stated here; needs `Spa` as an adic space (supplier:
--   AdicSpaces Layer 5). `Spa(ℚ_p^cycl, ℤ_p^cycl)` and `Spa(𝔽_p((t^{1/p^∞})), 𝔽_p[[t^{1/p^∞}]])`
--   are not isomorphic but have isomorphic tilts, so tilting is not an equivalence on `Perfd`.
--   [non-example test]
-- tiltHomeomorph_rationalSubset: not stated here; needs `Spa` as an adic space (supplier:
--   AdicSpaces Layer 5). For `f_i, g ∈ R♭` generating the unit ideal the tilting homeomorphism
--   maps `U(f♯/g♯)` onto `U(f/g)`; affinoid core: P2a
--   `PerfectoidSpace.spaTilt_preimage_rationalSubset`. [characterisation test]

/-! ## PerfectoidSpaces:P2/affinoid-perfectoid-pairs-tilting-equivalence (lemma) -/

namespace PerfectoidSpace

open Perfectoid affinoidPerfectoidEquiv

variable (p : ℕ) [Fact p.Prime]

/-- P2/affinoid-perfectoid-pairs-tilting-equivalence (equivalence): for a complete perfectoid Tate
pair `(A, A⁺)`, tilting `(B, B⁺) ↦ (B♭, B♭⁺)` is an equivalence from complete perfectoid Tate pairs
under `(A, A⁺)` to those under `(A♭, A♭⁺)`; a quasi-inverse is the untilt along a generator of
`ker(θ : W(A♭⁺) → A⁺)` (ECD Lemma 3.14 and Theorem 3.17; P1 `Perfectoid.untilt`). Its value on
rational localisations is P2a `Perfectoid.rationalLocalization.tiltEquiv_affinoid`. -/
def pairTiltEquiv (X : PairCat.{u} p) : Under X ≌ Under ((PairCat.tiltFunctor p).obj X) := sorry

/-- P2/affinoid-perfectoid-pairs-tilting-equivalence: the functor of the equivalence is the tilt
of pairs. -/
theorem pairTiltEquiv_functor (X : PairCat.{u} p) :
    (pairTiltEquiv p X).functor = Under.post (PairCat.tiltFunctor p) := sorry

end PerfectoidSpace

/-! ## PerfectoidSpaces:P2/tilting-slice-equivalence (theorem) -/

/-! ECD Corollary 3.20: for a perfectoid space `X`, `Perfd/X ≃ Perf/X♭` by `Y ↦ Y♭`; affinoid
perfectoid objects correspond, and over `X = Spa(A, A⁺)` it restricts to
`PerfectoidSpace.pairTiltEquiv`. -/

-- PerfectoidSpace.tiltOverEquiv: not stated here; needs the slice categories `Over X` of `Perfd`
--   (supplier: PerfectoidSpaces:P2/perfectoid-space, AdicSpaces Layer 5). The equivalence
--   `Over X ≌ Over X♭`, `(f : Y ⟶ X) ↦ f♭`, compatible with restriction to open subspaces.
-- PerfectoidSpace.existsUnique_untilt: not stated here; needs `Perfd` and `Perf` (supplier:
--   PerfectoidSpaces:P2/perfectoid-space). For `T ∈ Perf` and `T → X♭` there is an untilt
--   `T♯ → X` with `(T♯)♭ ≅ T` over `X♭`, unique up to unique isomorphism.

/-! ## PerfectoidSpaces:P2/perfect-uniform-completed-tensor (lemma) -/

namespace Perfectoid

section CharPCompletedTensor

variable (p : ℕ) [Fact p.Prime] {A B C : Type*}
  [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A]
  [CompleteSpace A] [T2Space A] [CharP A p] [PerfectRing A p]
  [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B]
  [CompleteSpace B] [T2Space B] [CharP B p] [PerfectRing B p]
  [CommRing C] [UniformSpace C] [IsUniformAddGroup C] [IsTopologicalRing C] [IsTateRing C]
  [CompleteSpace C] [T2Space C] [CharP C p] [PerfectRing C p]
  [Algebra A B] [Algebra A C] [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]
  (S : Pair A) (T : Pair B) (U : Pair C) (hT : ∀ a ∈ S.plus, algebraMap A B a ∈ T.plus)
  (hU : ∀ a ∈ S.plus, algebraMap A C a ∈ U.plus)

/-- P2/perfect-uniform-completed-tensor (i), (ii): for perfect complete Tate rings `A`, `B`, `C` of
characteristic `p` (equivalently perfectoid, ECD Proposition 3.5), `D = B ⊗̂_A C` has
characteristic `p`, is perfect (`x ↦ x ^ p` bijective) and perfectoid, and the uniformisation
`D → B ⊗̂ᵘ_A C` is a homeomorphic isomorphism (KL II Lemma 3.1.8; Bhatt Exercise 9.3.14). -/
theorem perfectRing_completedTensor_of_charP :
    CharP (CompletedTensor A B C) p ∧ Function.Bijective (fun x : CompletedTensor A B C ↦ x ^ p) ∧
      IsPerfectoidTateRing p (CompletedTensor A B C) ∧
      IsHomeomorph (Pair.toUniformization (Pair.completedTensor S T U hT hU)).toRingHom := sorry

/-- P2/perfect-uniform-completed-tensor (i), (iii): let `F̂ ⊆ D` be the closure of the image of the
subring of `B ⊗[A] C` generated by `B° ⊗ 1` and `1 ⊗ C°` (the `ϖ`-adic completion of the ring of
definition `F`). Then `F̂` is perfect and `ϖ^{1/pⁿ} D° ⊆ F̂ ⊆ D°` for all `n`, so `F̂ → D°` is an
almost isomorphism for the almost setup of `A` (Bhatt Exercise 9.3.14; KL II Lemma 3.1.8). -/
theorem completedTensor_almost_of_charP (ϖ : PseudoUniformizerRoots p A) :
    let F : Subring (CompletedTensor A B C) :=
      (((powerBoundedSubring B).map (Algebra.TensorProduct.includeLeftRingHom (R := A) (B := C)) ⊔
        (powerBoundedSubring C).map
          (Algebra.TensorProduct.includeRight (R := A) (A := B)).toRingHom :
            Subring (B ⊗[A] C)).map (Pair.completedTensor.tmul A B C)).topologicalClosure
    (∀ y ∈ F, ∃ x ∈ F, x ^ p = y) ∧ F ≤ powerBoundedSubring (CompletedTensor A B C) ∧
      ∀ (n : ℕ) (x : CompletedTensor A B C), x ∈ powerBoundedSubring (CompletedTensor A B C) →
        algebraMap A (CompletedTensor A B C) (ϖ.root n) * x ∈ F := sorry

/-- P2/perfect-uniform-completed-tensor (iv): the `ϖ`-power torsion of `B° ⊗_{A°} C°` is killed by
every `ϖ^{1/pⁿ}` (Bhatt Exercise 9.3.14). The structure maps `A° → B°`, `A° → C°` exist because
`B`, `C` are uniform (P1 `Perfectoid.isBounded_powerBoundedSubring_of_perfectRing`). -/
theorem tensorPowerBounded_torsion_of_charP (ϖ : PseudoUniformizerRoots p A) :
    letI : Algebra (powerBoundedSubring A) (powerBoundedSubring B) :=
      ((algebraMap A B).restrict _ _ fun _ ha ↦ map_mem_powerBoundedSubring
        (isBounded_powerBoundedSubring_of_perfectRing p) _ (IsAdicHom.continuous _) ha).toAlgebra
    letI : Algebra (powerBoundedSubring A) (powerBoundedSubring C) :=
      ((algebraMap A C).restrict _ _ fun _ ha ↦ map_mem_powerBoundedSubring
        (isBounded_powerBoundedSubring_of_perfectRing p) _ (IsAdicHom.continuous _) ha).toAlgebra
    ∀ (x : powerBoundedSubring B ⊗[powerBoundedSubring A] powerBoundedSubring C) (k : ℕ),
      ϖ.rootPB 0 ^ k • x = 0 → ∀ n : ℕ, ϖ.rootPB n • x = 0 := sorry

end CharPCompletedTensor

end Perfectoid

/-! ## PerfectoidSpaces:P2/perfectoid-dense-image-criterion (lemma) -/

namespace Perfectoid

section DenseImage

variable (p : ℕ) [Fact p.Prime] {A B : Type*}
  [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A]
  [CompleteSpace A] [T2Space A] [IsPerfectoidTateRing p A]
  [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B]
  [CompleteSpace B] [T2Space B]

/-- P2/perfectoid-dense-image-criterion: a complete Hausdorff *uniform* Tate ring `B` receiving a
continuous ring map with dense image from a perfectoid Tate ring is perfectoid (AWS Theorem 2.4.3,
Lemma 2.8.4; KL II Theorem 3.3.18, class (ii); KL I Theorem 3.6.17(b) over `ℚ_p`). Uniformity is
needed: `K⟨T^{1/p^∞}⟩ → K⟨T^{1/p^∞}⟩/(T)` is surjective onto a non-reduced ring (AWS Example
2.4.9). -/
theorem IsPerfectoidTateRing.of_denseRange (hB : IsBounded (powerBoundedSubring B : Set B))
    (f : A →+* B) (hf : Continuous f) (hd : DenseRange f) : IsPerfectoidTateRing p B := sorry

/-- P2/perfectoid-dense-image-criterion: in the situation of `IsPerfectoidTateRing.of_denseRange`,
the tilt `f♭ : A♭ → B♭` also has dense image (AWS Lemma 2.8.4). -/
theorem IsPerfectoidTateRing.denseRange_tiltMap_of_denseRange [IsPerfectoidTateRing p B]
    (f : A →+* B) (hf : Continuous f) (hd : DenseRange f) : DenseRange (tilt.map p f hf) := sorry

end DenseImage

end Perfectoid

/-! ## PerfectoidSpaces:P2/completed-tensor-of-perfectoid-is-perfectoid (theorem) -/

/-! Clause (ii), that `(D, D⁺)` with `inl`, `inr` is a pushout of complete perfectoid Tate pairs,
is the case of perfectoid test pairs of `PerfectoidSpace.spaCompletedTensor_isPullback_core`
(PerfectoidSpaces:P2/perfectoid-fibre-product-universal-property). -/

namespace Perfectoid

section CompletedTensorPerfectoid

variable (p : ℕ) [Fact p.Prime] {A B C : Type*}
  [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A]
  [CompleteSpace A] [T2Space A] [IsPerfectoidTateRing p A]
  [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B]
  [CompleteSpace B] [T2Space B] [IsPerfectoidTateRing p B]
  [CommRing C] [UniformSpace C] [IsUniformAddGroup C] [IsTopologicalRing C] [IsTateRing C]
  [CompleteSpace C] [T2Space C] [IsPerfectoidTateRing p C]
  [Algebra A B] [Algebra A C] [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]

/-- P2/completed-tensor-of-perfectoid-is-perfectoid (i) (instance): for perfectoid Tate rings `A`,
`B`, `C` (any characteristic, no base field) the completed tensor product `B ⊗̂_A C` is a
perfectoid Tate ring (KL II Theorem 3.3.13; AWS Theorem 2.4.1; Sch12 Proposition 6.18 over a
perfectoid field). The base `A` must be perfectoid: `ℂ_p ⊗̂_{ℚ_p} ℂ_p` is not uniform. -/
instance isPerfectoidTateRing_completedTensor : IsPerfectoidTateRing p (CompletedTensor A B C) :=
  sorry

/-- P2/completed-tensor-of-perfectoid-is-perfectoid (iii) (other): a continuous homomorphism of
perfectoid Tate rings has an adic tilt (continuous maps of Tate rings are adic,
AdicSpacesPartII:R0/adic-ring-homomorphism); used to form `B♭ ⊗̂_{A♭} C♭`. -/
theorem completedTensorTiltIso.isAdicHom_tiltMap {R R' : Type*} [CommRing R] [UniformSpace R]
    [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] [CommRing R'] [UniformSpace R'] [IsUniformAddGroup R']
    [IsTopologicalRing R'] [IsTateRing R'] [CompleteSpace R'] [T2Space R']
    [IsPerfectoidTateRing p R'] (f : R →+* R') (hf : Continuous f) :
    IsAdicHom (tilt.map p f hf) := sorry

/-- P2/completed-tensor-of-perfectoid-is-perfectoid (iii) (equivalence): tilting commutes with
completed tensor products, `(B ⊗̂_A C)♭ ≃+* B♭ ⊗̂_{A♭} C♭` (AWS Theorem 2.4.1; KL II Theorem
3.3.13(a)); the algebra structures on the tilts are the tilts `tilt.map` of the structure maps. -/
def completedTensorTiltIso :
    letI : Algebra (tilt p A) (tilt p B) :=
      (tilt.map p (algebraMap A B) (IsAdicHom.continuous _)).toAlgebra
    letI : Algebra (tilt p A) (tilt p C) :=
      (tilt.map p (algebraMap A C) (IsAdicHom.continuous _)).toAlgebra
    tilt p (CompletedTensor A B C) ≃+* CompletedTensor (tilt p A) (tilt p B) (tilt p C) := sorry

variable (S : Pair A) (T : Pair B) (U : Pair C) (hT : ∀ a ∈ S.plus, algebraMap A B a ∈ T.plus)
  (hU : ∀ a ∈ S.plus, algebraMap A C a ∈ U.plus)

/-- P2/completed-tensor-of-perfectoid-is-perfectoid (iii) (characterisation):
`completedTensorTiltIso` is an isomorphism of Huber pairs
`(D♭, D♭⁺) ≅ (B♭, B♭⁺) ⊗̂_{(A♭, A♭⁺)} (C♭, C♭⁺)`: a homeomorphism carrying `D♭⁺` onto the plus
ring of the completed tensor product of the tilted pairs, whose composites with `inl♭`, `inr♭`
are `inl`, `inr` (AWS Theorem 2.4.1). -/
theorem completedTensorTiltIso_spec :
    letI : Algebra (tilt p A) (tilt p B) :=
      (tilt.map p (algebraMap A B) (IsAdicHom.continuous _)).toAlgebra
    letI : Algebra (tilt p A) (tilt p C) :=
      (tilt.map p (algebraMap A C) (IsAdicHom.continuous _)).toAlgebra
    haveI : IsAdicHom (algebraMap (tilt p A) (tilt p B)) :=
      completedTensorTiltIso.isAdicHom_tiltMap p _ _
    haveI : IsAdicHom (algebraMap (tilt p A) (tilt p C)) :=
      completedTensorTiltIso.isAdicHom_tiltMap p _ _
    let hT' : ∀ a ∈ (Pair.tilt p S).plus,
        algebraMap (tilt p A) (tilt p B) a ∈ (Pair.tilt p T).plus :=
      (Pair.tiltHom p (⟨algebraMap A B, IsAdicHom.continuous _, hT⟩ : Pair.Hom S T)).map_mem_plus
    let hU' : ∀ a ∈ (Pair.tilt p S).plus,
        algebraMap (tilt p A) (tilt p C) a ∈ (Pair.tilt p U).plus :=
      (Pair.tiltHom p (⟨algebraMap A C, IsAdicHom.continuous _, hU⟩ : Pair.Hom S U)).map_mem_plus
    IsHomeomorph (completedTensorTiltIso p (A := A) (B := B) (C := C)) ∧
      (Pair.tilt p (Pair.completedTensor S T U hT hU)).plus.map
          (completedTensorTiltIso p (A := A) (B := B) (C := C)).toRingHom =
        (Pair.completedTensor (Pair.tilt p S) (Pair.tilt p T) (Pair.tilt p U) hT' hU').plus ∧
      (completedTensorTiltIso p (A := A) (B := B) (C := C)).toRingHom.comp
          (Pair.tiltHom p (Pair.completedTensor.inl S T U hT hU)).toRingHom =
        (Pair.completedTensor.inl (Pair.tilt p S) (Pair.tilt p T) (Pair.tilt p U) hT'
          hU').toRingHom ∧
      (completedTensorTiltIso p (A := A) (B := B) (C := C)).toRingHom.comp
          (Pair.tiltHom p (Pair.completedTensor.inr S T U hT hU)).toRingHom =
        (Pair.completedTensor.inr (Pair.tilt p S) (Pair.tilt p T) (Pair.tilt p U) hT'
          hU').toRingHom :=
  sorry

/-- P2/completed-tensor-of-perfectoid-is-perfectoid (i) (characterisation): `B ⊗̂_A C` is already
uniform, so the uniformisation `D → B ⊗̂ᵘ_A C` of
AdicSpacesPartII:R0/uniform-completed-tensor-product is a homeomorphic isomorphism carrying `D⁺`
onto `Dᵘ⁺` (the tensor-product norm is the spectral norm, KL II Theorem 3.3.13(b)). -/
theorem isIso_toUniformization_completedTensor :
    IsHomeomorph (Pair.toUniformization (Pair.completedTensor S T U hT hU)).toRingHom ∧
      (Pair.completedTensor S T U hT hU).uniformization.plus =
        (Pair.completedTensor S T U hT hU).plus.map
          (Pair.toUniformization (Pair.completedTensor S T U hT hU)).toRingHom := sorry

/-- P2/completed-tensor-of-perfectoid-is-perfectoid (iv): for `ϖ` with compatible `p`-power roots,
the closure `F̂ ⊆ D` of the image of the subring generated by `B° ⊗ 1` and `1 ⊗ C°` satisfies
`ϖ^{1/pⁿ} D° ⊆ F̂ ⊆ D°` for all `n`, and the `ϖ`-power torsion of `B° ⊗_{A°} C°` is killed by
every `ϖ^{1/pⁿ}`; so `F̂ → D°` is an almost isomorphism for P1 `Perfectoid.almostSetup` (Sch12
Proposition 6.18 over a perfectoid field). -/
theorem completedTensor_powerBounded_almost (ϖ : PseudoUniformizerRoots p A) :
    letI : Algebra (powerBoundedSubring A) (powerBoundedSubring B) :=
      ((algebraMap A B).restrict _ _ fun _ ha ↦ map_mem_powerBoundedSubring
        (IsPerfectoidTateRing.isBounded_powerBoundedSubring (p := p)) _
          (IsAdicHom.continuous _) ha).toAlgebra
    letI : Algebra (powerBoundedSubring A) (powerBoundedSubring C) :=
      ((algebraMap A C).restrict _ _ fun _ ha ↦ map_mem_powerBoundedSubring
        (IsPerfectoidTateRing.isBounded_powerBoundedSubring (p := p)) _
          (IsAdicHom.continuous _) ha).toAlgebra
    let F : Subring (CompletedTensor A B C) :=
      (((powerBoundedSubring B).map (Algebra.TensorProduct.includeLeftRingHom (R := A) (B := C)) ⊔
        (powerBoundedSubring C).map
          (Algebra.TensorProduct.includeRight (R := A) (A := B)).toRingHom :
            Subring (B ⊗[A] C)).map (Pair.completedTensor.tmul A B C)).topologicalClosure
    F ≤ powerBoundedSubring (CompletedTensor A B C) ∧
      (∀ (n : ℕ) (x : CompletedTensor A B C), x ∈ powerBoundedSubring (CompletedTensor A B C) →
        algebraMap A (CompletedTensor A B C) (ϖ.root n) * x ∈ F) ∧
      ∀ (x : powerBoundedSubring B ⊗[powerBoundedSubring A] powerBoundedSubring C) (k : ℕ),
        ϖ.rootPB 0 ^ k • x = 0 → ∀ n : ℕ, ϖ.rootPB n • x = 0 := sorry

end CompletedTensorPerfectoid

end Perfectoid

/-! ## PerfectoidSpaces:P2/completed-tensor-plus-ring-almost-formula (lemma) -/

namespace Perfectoid

section PlusAlmost

variable (p : ℕ) [Fact p.Prime] {A B C : Type*}
  [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A]
  [CompleteSpace A] [T2Space A] [IsPerfectoidTateRing p A]
  [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B]
  [CompleteSpace B] [T2Space B] [IsPerfectoidTateRing p B]
  [CommRing C] [UniformSpace C] [IsUniformAddGroup C] [IsTopologicalRing C] [IsTateRing C]
  [CompleteSpace C] [T2Space C] [IsPerfectoidTateRing p C]
  [Algebra A B] [Algebra A C] [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]
  (S : Pair A) (T : Pair B) (U : Pair C) (hT : ∀ a ∈ S.plus, algebraMap A B a ∈ T.plus)
  (hU : ∀ a ∈ S.plus, algebraMap A C a ∈ U.plus)

/-- P2/completed-tensor-plus-ring-almost-formula: with `r n = ϖ^{1/pⁿ} ∈ A⁺` and `D⁺` the plus ring
of `B ⊗̂_A C`: (i) the `ϖ`-power torsion of `B⁺ ⊗_{A⁺} C⁺` is killed by every `ϖ^{1/pⁿ}`; (ii)
the natural map `(B⁺ ⊗_{A⁺} C⁺)^∧ → D⁺` from the `ϖ`-adic completion, `b ⊗ c ↦ inl b * inr c`, has
kernel and cokernel killed by every `ϖ^{1/pⁿ}`, an almost isomorphism of `A⁺`-modules (Bhatt
Exercise 9.3.14); (iii) `ϖ^{1/pⁿ} D° ⊆ D⁺` for all `n`. The map in (ii) is not an isomorphism in
general (PerfectoidSpaces:P3/completed-tensor-plus-ring-not-integrally-closed). -/
theorem completedTensor_plus_almostIso (ϖ : PseudoUniformizerRoots p A) :
    letI : Algebra S.plus T.plus := ((algebraMap A B).restrict S.plus T.plus hT).toAlgebra
    letI : Algebra S.plus U.plus := ((algebraMap A C).restrict S.plus U.plus hU).toAlgebra
    let r : ℕ → S.plus := fun n ↦ ⟨ϖ.root n,
      S.isRingOfIntegralElements.mem_of_isTopologicallyNilpotent (ϖ.isPseudoUniformizer_root n).1.2⟩
    let J : Ideal (T.plus ⊗[S.plus] U.plus) := Ideal.span {algebraMap S.plus _ (r 0)}
    (∀ (x : T.plus ⊗[S.plus] U.plus) (k : ℕ), r 0 ^ k • x = 0 → ∀ n : ℕ, r n • x = 0) ∧
      (∃ f : AdicCompletion J (T.plus ⊗[S.plus] U.plus) →+* CompletedTensor A B C,
        (∀ (b : T.plus) (c : U.plus),
          f (algebraMap (T.plus ⊗[S.plus] U.plus) (AdicCompletion J _) (b ⊗ₜ[S.plus] c)) =
            (Pair.completedTensor.inl S T U hT hU).toRingHom b *
              (Pair.completedTensor.inr S T U hT hU).toRingHom c) ∧
        (∀ y, f y ∈ (Pair.completedTensor S T U hT hU).plus) ∧
        (∀ y, f y = 0 → ∀ n : ℕ, r n • y = 0) ∧
        ∀ z ∈ (Pair.completedTensor S T U hT hU).plus, ∀ n : ℕ,
          ∃ y, f y = algebraMap A (CompletedTensor A B C) (ϖ.root n) * z) ∧
      ∀ (n : ℕ) (z : CompletedTensor A B C), z ∈ powerBoundedSubring (CompletedTensor A B C) →
        algebraMap A (CompletedTensor A B C) (ϖ.root n) * z ∈
          (Pair.completedTensor S T U hT hU).plus := sorry

end PlusAlmost

end Perfectoid

/-! ## PerfectoidSpaces:P2/uniform-completed-tensor-of-perfectoid-over-any-base (theorem) -/

namespace Perfectoid

section UniformTensor

variable (p : ℕ) [Fact p.Prime] {A B C : Type*}
  [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A]
  [CompleteSpace A] [T2Space A]
  [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B]
  [CompleteSpace B] [T2Space B] [IsPerfectoidTateRing p B]
  [CommRing C] [UniformSpace C] [IsUniformAddGroup C] [IsTopologicalRing C] [IsTateRing C]
  [CompleteSpace C] [T2Space C] [IsPerfectoidTateRing p C]
  [Algebra A B] [Algebra A C] [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]

/-- P2/uniform-completed-tensor-of-perfectoid-over-any-base: over an arbitrary complete Hausdorff
Tate ring `A` (not necessarily perfectoid, uniform or of characteristic `p`), the uniform completed
tensor product `B ⊗̂ᵘ_A C` of perfectoid Tate rings is perfectoid (KL II Corollary 3.3.21; KL I
Corollary 3.6.18 over `ℚ_p`). The uniformisation cannot be omitted: `ℂ_p ⊗̂_{ℚ_p} ℂ_p` is not
uniform. -/
theorem isPerfectoidTateRing_uniformCompletedTensor :
    IsPerfectoidTateRing p (Uniformization (CompletedTensor A B C)) := sorry

end UniformTensor

