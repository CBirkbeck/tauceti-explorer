/-! ## PerfectoidSpaces:P1/strict-inclusions-under-tilting (theorem) -/

section StrictInclusions

variable (p : ℕ) [Fact p.Prime] {A B : Type*} [CommRing A] [UniformSpace A] [IsUniformAddGroup A]
  [IsTopologicalRing A] [IsTateRing A] [CompleteSpace A] [T2Space A] [IsPerfectoidTateRing p A]
  [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B]
  [CompleteSpace B] [T2Space B] [IsPerfectoidTateRing p B]

/-- P1/strict-inclusions-under-tilting (a) (AWS Theorem 2.4.2): a continuous `f : A → B` of
perfectoid Tate rings is a strict inclusion (injective and a homeomorphism onto its image) iff
`f♭` is. -/
theorem tilt.isEmbedding_map_iff (f : A →+* B) (hf : Continuous f) :
    IsEmbedding f ↔ IsEmbedding (tilt.map p f hf) := sorry

/-- P1/strict-inclusions-under-tilting (b): for the spectral gauges of `ϖ` and `f(ϖ)`, `f` is a
strict inclusion iff it is isometric, and likewise for `f♭`. -/
theorem isEmbedding_iff_gauge (f : A →+* B) (hf : Continuous f) (ϖ : PseudoUniformizerRoots p A) :
    (IsEmbedding f ↔ ∀ a, (ϖ.map p f hf).gauge (f a) = ϖ.gauge a) ∧
      (IsEmbedding (tilt.map p f hf) ↔
        ∀ x, (ϖ.map p f hf).tiltRoots.gauge (tilt.map p f hf x) = ϖ.tiltRoots.gauge x) := sorry

end StrictInclusions

/-! ## PerfectoidSpaces:P1/integral-perfectoid-comparison (comparison) -/

section IntegralPerfectoid

variable (p : ℕ) [Fact p.Prime]

/-- P1/integral-perfectoid-comparison (data): `R₀` is *integral perfectoid* (BMS1 Definition
3.5): `π`-adically complete for some `π` with `π ^ p ∣ p`, Frobenius surjective on `R₀ ⧸ p`, and
the kernel of `θ : A_inf(R₀) → R₀` principal (Mathlib `WittVector.fontaineTheta`, whose standing
hypotheses are bound). The notion of PerfectoidQuotients Q0. -/
def IsIntegralPerfectoid (R₀ : Type*) [CommRing R₀] : Prop :=
  (∃ π : R₀, IsAdicComplete (Ideal.span {π}) R₀ ∧ π ^ p ∣ (p : R₀)) ∧
    (Function.Surjective fun x : ModP R₀ p ↦ x ^ p) ∧
    ∀ [Fact (¬ IsUnit (p : R₀))] [IsAdicComplete (Ideal.span {(p : R₀)}) R₀],
      (RingHom.ker (WittVector.fontaineTheta R₀ p)).IsPrincipal

variable {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
  [IsTateRing R] [CompleteSpace R] [T2Space R]

/-- P1/integral-perfectoid-comparison (BMS1 Lemma 3.20, `→`): every ring of integral elements of
a perfectoid Tate ring is integral perfectoid. -/
theorem IsPerfectoidTateRing.isIntegralPerfectoid_plus [IsPerfectoidTateRing p R] (P : Pair R) :
    IsIntegralPerfectoid p P.plus := sorry

/-- P1/integral-perfectoid-comparison (BMS1 Lemma 3.20, `←`): if a ring of integral elements is
integral perfectoid and bounded, `R` is perfectoid. -/
theorem isPerfectoidTateRing_of_isIntegralPerfectoid (P : Pair R)
    (hb : IsBounded (P.plus : Set R)) (h : IsIntegralPerfectoid p P.plus) :
    IsPerfectoidTateRing p R := sorry

end IntegralPerfectoid

/-! ## PerfectoidSpaces:P1/almost-integral-dictionary (lemma) -/

section AlmostDictionary

variable (p : ℕ) [Fact p.Prime]

/-- P1/almost-integral-dictionary (data): a ring homomorphism `f : B → C` of `V`-algebras is an
*almost isomorphism* for a basic setup `T` on `V`, elementwise: `m` kills its kernel and
`m C ⊆ f(B)`; used for the Frobenius, which is only semilinear. -/
def IsAlmostBijective {V B C : Type*} [CommRing V] [CommRing B] [CommRing C] [Algebra V B]
    [Algebra V C] (T : Almost.BasicSetup V) (f : B →+* C) : Prop :=
  (∀ ε ∈ T.ideal, ∀ x, f x = 0 → ε • x = 0) ∧ ∀ ε ∈ T.ideal, ∀ y, ∃ x, f x = ε • y

variable {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
  [IsTateRing R] [CompleteSpace R] [T2Space R]

/-- P1/almost-integral-dictionary (data): Frobenius `B ⧸ ϖ^{1/p} → B ⧸ ϖ` on an `R°`-algebra
`B`. -/
def frobeniusRootQuot (ϖ : PseudoUniformizerRoots p R) (B : Type*) [CommRing B]
    [Algebra (powerBoundedSubring R) B] :
    B ⧸ Ideal.span {algebraMap _ B (ϖ.rootPB 1)} →+* B ⧸ Ideal.span {algebraMap _ B (ϖ.rootPB 0)} :=
  frobeniusQuot p _ _ sorry sorry

variable [IsPerfectoidTateRing p R]

/-- P1/almost-integral-dictionary (data): a *perfectoid `R°ᵃ`-algebra* (Sch12 Definition 5.1(ii)
over a general base): `A_*` is `ϖ`-torsion free and `ϖ`-adically complete, and
`Φ : A_*/ϖ^{1/p} → A_*/ϖ` is an almost isomorphism. Over a general base, `ϖ`-torsion freeness
replaces flatness (perfectoid quotients are not flat). -/
def IsPerfectoidAlmostAlgebra (ϖ : PseudoUniformizerRoots p R)
    (A : Almost.Algebra (almostSetup p R)) : Prop :=
  IsSMulRegular ((Almost.Algebra.elements (almostSetup p R)).obj A) (ϖ.rootPB 0) ∧
    IsAdicComplete (Ideal.span {algebraMap _ ((Almost.Algebra.elements (almostSetup p R)).obj A)
      (ϖ.rootPB 0)}) ((Almost.Algebra.elements (almostSetup p R)).obj A) ∧
    IsAlmostBijective (almostSetup p R)
      (frobeniusRootQuot p ϖ ((Almost.Algebra.elements (almostSetup p R)).obj A))

/-- P1/almost-integral-dictionary (b) (Sch12 Proposition 5.5): for a perfectoid `R`-algebra `S`,
`Φ : S°/ϖ^{1/p} → S°/ϖ` is bijective and `S°ᵃ` is a perfectoid `R°ᵃ`-algebra. -/
theorem isPerfectoidAlmostAlgebra_powerBounded (ϖ : PseudoUniformizerRoots p R)
    (X : PerfectoidAlgebra p R) :
    letI := (powerBoundedMap p X.hom.hom X.hom.continuous_hom).toAlgebra
    Function.Bijective (frobeniusRootQuot p ϖ (powerBoundedSubring X.right)) ∧
      IsPerfectoidAlmostAlgebra p ϖ
        (Almost.Algebra.of (almostSetup p R) (powerBoundedSubring X.right)) := sorry

/-- P1/almost-integral-dictionary (d) (Sch12 Theorem 5.2, first step; Lemmas 5.6–5.7): `S ↦ S°ᵃ`
and `A ↦ A_*[1/ϖ]` are inverse equivalences `R-Perf ≃ R°ᵃ-Perf`. -/
def perfectoidAlmostEquiv (ϖ : PseudoUniformizerRoots p R) :
    PerfectoidAlgebra p R ≌ ObjectProperty.FullSubcategory (IsPerfectoidAlmostAlgebra p ϖ) :=
  sorry

/-- P1/almost-integral-dictionary (a) (Sch12 Lemma 5.3(i)): for a `ϖ`-torsion-free `R°`-module
`N`, the almost elements of `Nᵃ` (P0 `Almost.Module.elements`) are
`{x ∈ N[1/ϖ] : ϖ^{1/pⁿ} x ∈ N for all n}`. -/
theorem nonempty_elements_equiv (ϖ : PseudoUniformizerRoots p R) (N : Type u) [AddCommGroup N]
    [_root_.Module (powerBoundedSubring R) N] (hN : IsSMulRegular N (ϖ.rootPB 0)) :
    Nonempty (((Almost.Module.elements (almostSetup p R)).obj
        ((Almost.toAlmost (almostSetup p R)).obj (ModuleCat.of (powerBoundedSubring R) N))) ≃
      {x : LocalizedModule (Submonoid.powers (ϖ.rootPB 0)) N //
        ∀ n, ∃ y : N, ϖ.rootPB n • x = LocalizedModule.mk y 1}) := sorry

end AlmostDictionary

/-! ## PerfectoidSpaces:P1/cotangent-complex-vanishing-mod-varpi (lemma) -/

-- This node and P1/deformation-lifting-of-perfectoid-mod-varpi-algebras form the optional
--   alternative route retained for RT-AREA-padic-1/5. Only the latter uses the former;
--   neither is a prerequisite of the mandatory P1 equivalences. P0's own finite-étale
--   lifting still uses P0/almost-deformation-theory.

-- Parts (a)–(c) of P1/cotangent-complex-vanishing-mod-varpi are not stated here in full; they
--   need the cotangent complex `L_{B/A₀}` (Mathlib has only the naive one) and its almost form
--   (supplier: DerivedDeRhamCohomology:DD.0, via P0/almost-cotangent-complex). The naive core
--   is stated below under a suffixed name.

/-- P1/cotangent-complex-vanishing-mod-varpi (a), naive core (Bhatt Proposition 6.1.4): for a map
`A₀ → B` of perfect `𝔽_p`-algebras, `Ω_{B/A₀} = 0` and `H₁` of the naive cotangent complex
vanishes (the full statement is `L_{B/A₀} ≃ 0`). -/
theorem kaehlerDifferential_subsingleton_of_perfectRing_core (p : ℕ) [Fact p.Prime]
    {A₀ B : Type*} [CommRing A₀] [CommRing B] [Algebra A₀ B] [CharP A₀ p] [PerfectRing A₀ p]
    [CharP B p] [PerfectRing B p] :
    Subsingleton (KaehlerDifferential A₀ B) ∧ Subsingleton (Algebra.H1Cotangent A₀ B) := sorry

/-! ## PerfectoidSpaces:P1/deformation-lifting-of-perfectoid-mod-varpi-algebras (theorem) -/

-- P1/deformation-lifting-of-perfectoid-mod-varpi-algebras is not stated here as a deformation
--   statement; it needs the almost cotangent complex and almost deformation theory (obstructions in
--   `Ext²`, torsors under `Ext¹`) (supplier: DerivedDeRhamCohomology:DD.0, via
--   P0/almost-deformation-theory). The separate primitive-ideal and Frobenius-limit route
--   supplies P1/perfectoid-mod-varpi-equivalence below without this deformation theorem;
--   the alternative route compares only the flat full subcategories stated here.

section ModVarpiDefs

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P1/deformation-lifting-of-perfectoid-mod-varpi-algebras (data): the flat objects of (i): a
perfectoid `R°ᵃ`-algebra which is almost flat over `R°ᵃ` (Sch12 Theorem 5.10). -/
def IsFlatPerfectoidAlmostAlgebra (ϖ : PseudoUniformizerRoots p R)
    (A : Almost.Algebra (almostSetup p R)) : Prop :=
  IsPerfectoidAlmostAlgebra p ϖ A ∧
    Almost.IsAlmostFlatAlg (almostSetup p R) ((Almost.Algebra.elements (almostSetup p R)).obj A)

/-- P1/perfectoid-mod-varpi-equivalence (data): the almost setup of `R° ⧸ ϖ`, the base change of
`(R°, R°°)` (P0/basic-setup-base-change). -/
abbrev almostSetupModVarpi (ϖ : PseudoUniformizerRoots p R) :
    Almost.BasicSetup (powerBoundedSubring R ⧸ Ideal.span {ϖ.rootPB 0}) :=
  (almostSetup p R).baseChange _

/-- P1/perfectoid-mod-varpi-equivalence (data): a *perfectoid `(R°ᵃ/ϖ)`-algebra*: the intended
condition is almost flatness
over `Λ = 𝔽_p[x^{1/p^∞}]/(x)` in the root-ideal almost category (`x ↦ ϖ`; up to almost zero, the kernel of `ϖ^q` is `ϖ^{1-q} B_*` for
`q ∈ ℤ[1/p] ∩ (0, 1)`), and `Φ : B/ϖ^{1/p} → B`, `x ↦ x^p`, is an almost isomorphism
(elementwise: `m` kills its kernel and `m B_*` consists of `p`-th powers). The body below
uses the annihilator criterion; its flatness comparison is an explicit review gap. -/
def IsPerfectoidModVarpiAlgebra (ϖ : PseudoUniformizerRoots p R)
    (B : Almost.Algebra (almostSetupModVarpi p ϖ)) : Prop :=
  (∀ n m : ℕ, 0 < m → m < p ^ n →
    ∀ x : (Almost.Algebra.elements (almostSetupModVarpi p ϖ)).obj B,
      algebraMap _ ((Almost.Algebra.elements (almostSetupModVarpi p ϖ)).obj B)
        (Ideal.Quotient.mk (Ideal.span {ϖ.rootPB 0}) (ϖ.rootPB n ^ m)) * x = 0 →
      ∀ ε ∈ (almostSetupModVarpi p ϖ).ideal, ∃ y,
        ε • x = algebraMap _ ((Almost.Algebra.elements (almostSetupModVarpi p ϖ)).obj B)
          (Ideal.Quotient.mk (Ideal.span {ϖ.rootPB 0}) (ϖ.rootPB n ^ (p ^ n - m))) * y) ∧
    (∀ x : (Almost.Algebra.elements (almostSetupModVarpi p ϖ)).obj B, x ^ p = 0 →
      ∀ ε ∈ (almostSetupModVarpi p ϖ).ideal, ∃ y,
        ε • x = algebraMap _ ((Almost.Algebra.elements (almostSetupModVarpi p ϖ)).obj B)
          (Ideal.Quotient.mk (Ideal.span {ϖ.rootPB 0}) (ϖ.rootPB 1)) * y) ∧
    ∀ ε ∈ (almostSetupModVarpi p ϖ).ideal,
      ∀ y : (Almost.Algebra.elements (almostSetupModVarpi p ϖ)).obj B, ∃ x, x ^ p = ε • y

/-- P1/deformation-lifting-of-perfectoid-mod-varpi-algebras (data): the flat objects of (ii):
perfectoid `(R°/ϖ)ᵃ`-algebras that are almost flat over `(R°/ϖ)ᵃ`. -/
def IsFlatPerfectoidModVarpiAlgebra (ϖ : PseudoUniformizerRoots p R)
    (B : Almost.Algebra (almostSetupModVarpi p ϖ)) : Prop :=
  IsPerfectoidModVarpiAlgebra p ϖ B ∧
    Almost.IsAlmostFlatAlg (almostSetupModVarpi p ϖ)
      ((Almost.Algebra.elements (almostSetupModVarpi p ϖ)).obj B)

/-- P1/deformation-lifting-of-perfectoid-mod-varpi-algebras (Sch12 Theorem 5.10 over a perfectoid
Tate base): reduction modulo `ϖ` is an equivalence between `ϖ`-adically complete almost flat
`R°ᵃ`-algebras with `Φ : A/ϖ^{1/p} ≅ A/ϖ` and almost flat `(R°/ϖ)ᵃ`-algebras with
`Φ : B/ϖ^{1/p} ≅ B`; `B` lifts uniquely through the square-zero thickenings
`(R°/ϖⁿ)ᵃ → (R°/ϖⁿ⁻¹)ᵃ`. -/
def flatPerfectoidModVarpiEquiv (ϖ : PseudoUniformizerRoots p R) :
    ObjectProperty.FullSubcategory (IsFlatPerfectoidAlmostAlgebra p ϖ) ≌
      ObjectProperty.FullSubcategory (IsFlatPerfectoidModVarpiAlgebra p ϖ) := sorry

end ModVarpiDefs

/-! ## PerfectoidSpaces:P1/frobenius-inverse-limit-lifting-in-characteristic-p (lemma) -/

section FrobeniusLimit

variable (p : ℕ) [Fact p.Prime] {T : Type*} [CommRing T] [UniformSpace T] [IsUniformAddGroup T]
  [IsTopologicalRing T] [IsTateRing T] [CompleteSpace T] [T2Space T] [IsPerfectoidTateRing p T]
  [CharP T p]

/-- P1/frobenius-inverse-limit-lifting-in-characteristic-p (data): the image
`(t^{1/pⁿ})ₙ ∈ lim_Φ B` of `t♭` in the inverse limit along Frobenius of a `T°`-algebra `B` of
characteristic `p`. -/
def PseudoUniformizerRoots.perfectionElem (ϖ : PseudoUniformizerRoots p T) (B : Type*)
    [CommRing B] [CharP B p] [Algebra (powerBoundedSubring T) B] : Perfection B p :=
  ⟨fun n ↦ algebraMap _ B (ϖ.rootPB n), sorry⟩

/-- P1/frobenius-inverse-limit-lifting-in-characteristic-p (a), honest core (Sch12 Remark 5.18):
for a `T°/t`-algebra `B` with `Φ : B/t^{1/p} → B`, `x ↦ x^p`, bijective and `t`-torsion as for a
Λ-flat algebra, `B̃ = lim_Φ B` is perfect (Mathlib), `t`-adically complete, `t`-torsion free with
`B̃/t ≅ B`. The almost form, with `B` an almost algebra, is the same statement for `B_*` up to
almost isomorphism. -/
theorem perfection_isAdicComplete_core (ϖ : PseudoUniformizerRoots p T) (B : Type*) [CommRing B]
    [CharP B p] [Algebra (powerBoundedSubring T) B] (ht : algebraMap _ B (ϖ.rootPB 0) = 0)
    (hΦinj : ∀ x : B, x ^ p = 0 → x ∈ Ideal.span {algebraMap _ B (ϖ.rootPB 1)})
    (hΦsurj : ∀ y : B, ∃ x : B, x ^ p = y)
    (hflat : ∀ n m : ℕ, 0 < m → m < p ^ n → ∀ x : B, ϖ.rootPB n ^ m • x = 0 →
      ∃ y : B, x = ϖ.rootPB n ^ (p ^ n - m) • y) :
    IsAdicComplete (Ideal.span {ϖ.perfectionElem p B}) (Perfection B p) ∧
      IsSMulRegular (Perfection B p) (ϖ.perfectionElem p B) ∧
      Nonempty (Perfection B p ⧸ Ideal.span {ϖ.perfectionElem p B} ≃+* B) := sorry

end FrobeniusLimit

/-! ## PerfectoidSpaces:P1/tilting-equivalence-and-explicit-tilt (theorem) -/

section TiltingEquivalence

variable (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P1/tilting-equivalence-and-explicit-tilt (ECD Theorem 3.13; Berkeley Theorem 6.2.7; AWS
Remark 2.3.17; Sch12 Theorem 5.2 over a perfectoid field): tilting `S ↦ S♭` is an equivalence
from perfectoid `R`-algebras to perfectoid `R♭`-algebras, over an arbitrary perfectoid Tate ring
`R`. -/
def tiltingEquivalence : PerfectoidAlgebra p R ≌ PerfectoidAlgebra p (tilt p R) := sorry

/-- P1/tilting-equivalence-and-explicit-tilt: the functor of the equivalence is the tilt
`tiltAlgebraFunctor` (P1/tilt-functoriality). -/
theorem tiltingEquivalence_functor :
    (tiltingEquivalence p R).functor = tiltAlgebraFunctor p R := sorry

variable {R}

/-- P1/tilting-equivalence-and-explicit-tilt (data): for a perfectoid `R♭`-algebra `T`, the map
`R♭⁺ = (Pair.tilt p R°).plus → T°` induced by the structure map. -/
def PerfectoidAlgebra.tiltPlusHom (X : PerfectoidAlgebra p (tilt p R)) :
    (Pair.tilt p (Pair.powerBounded R)).plus →+* (Pair.powerBounded X.right).plus :=
  X.hom.hom.restrict _ _ sorry

/-- P1/tilting-equivalence-and-explicit-tilt (explicit quasi-inverse): `T♯` is the untilt of
`(T, T°)` along `J_R W(T°)`, `J_R = ker(θ : W(R♭°) → R°)`: `T♯ = W(T°)[1/[ϖ♭]] ⧸ J_R`. -/
theorem tiltingEquivalence_inverse_obj [Nontrivial R] (X : PerfectoidAlgebra p (tilt p R)) :
    Nonempty (((tiltingEquivalence p R).inverse.obj X).right ≃+*
      untilt p (Pair.powerBounded X.right)
        ((RingHom.ker (theta p (Pair.powerBounded R))).map
          (WittVector.map (PerfectoidAlgebra.tiltPlusHom p X)))) := sorry

end TiltingEquivalence

/-! ## PerfectoidSpaces:P1/perfectoid-mod-varpi-equivalence (theorem) -/

section ModVarpi

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P1/perfectoid-mod-varpi-equivalence: `A ↦ A/ϖ` is an equivalence `R°ᵃ-Perf ≃ (R°ᵃ/ϖ)-Perf`
over an arbitrary perfectoid Tate ring (the general-base form of Sch12 Theorem 5.2's chain);
with `perfectoidAlmostEquiv`, `Perf_R ≃ R°ᵃ-Perf ≃ (R°ᵃ/ϖ)-Perf`. -/
def perfectoidModVarpiEquiv (ϖ : PseudoUniformizerRoots p R) :
    ObjectProperty.FullSubcategory (IsPerfectoidAlmostAlgebra p ϖ) ≌
      ObjectProperty.FullSubcategory (IsPerfectoidModVarpiAlgebra p ϖ) := sorry

/-- P1/perfectoid-mod-varpi-equivalence: `(R°ᵃ/ϖ)-Perf = (R♭°ᵃ/ϖ♭)-Perf` via
`R°/ϖ ≅ R♭°/ϖ♭` (`tilt.sharpQuotEquiv`, `almostSetup_tilt_quot`), compatibly with tilting:
`(S♭°/ϖ♭)ᵃ ≅ (S°/ϖ)ᵃ`. -/
def perfectoidModVarpiTiltEquiv (ϖ : PseudoUniformizerRoots p R) :
    ObjectProperty.FullSubcategory (IsPerfectoidModVarpiAlgebra p ϖ) ≌
      ObjectProperty.FullSubcategory (IsPerfectoidModVarpiAlgebra p ϖ.tiltRoots) := sorry

end ModVarpi

/-! ## PerfectoidSpaces:P1/completed-colimit-of-perfectoid-tate-rings (construction) -/

section CompletedColimit

variable (p : ℕ) [Fact p.Prime]

/-- P1/completed-colimit-of-perfectoid-tate-rings (data): `X ↦ X°`, from perfectoid Tate rings to
commutative rings (continuous maps into uniform rings preserve power-bounded elements). -/
def powerBoundedFunctor : PerfectoidRingCat.{u} p ⥤ CommRingCat.{u} where
  obj X := CommRingCat.of (powerBoundedSubring X)
  map f := CommRingCat.ofHom (powerBoundedMap p f.hom f.continuous_hom)
  map_id := sorry
  map_comp := sorry

variable {J : Type u} [SmallCategory J] [IsFiltered J] (F : J ⥤ PerfectoidRingCat.{u} p) (j₀ : J)
  (ϖ : PseudoUniformizerRoots p (F.obj j₀))

namespace completedFilteredColimit

/-- P1/completed-colimit-of-perfectoid-tate-rings (data): `A = colim_j R_j°`, a filtered colimit
of rings (Mathlib `CommRingCat.FilteredColimits`). -/
abbrev colimPB : CommRingCat.{u} := colimit (F ⋙ powerBoundedFunctor p)

/-- P1/completed-colimit-of-perfectoid-tate-rings (data): the image of `ϖ` in `A`. -/
def varpi : colimPB p F :=
  (colimit.ι (F ⋙ powerBoundedFunctor p) j₀).hom (ϖ.rootPB 0)

/-- P1/completed-colimit-of-perfectoid-tate-rings (data): `R₀`, the `ϖ`-adic completion of
`A`. -/
abbrev integral : Type u := AdicCompletion (Ideal.span {varpi p F j₀ ϖ}) (colimPB p F)

end completedFilteredColimit

/-- P1/completed-colimit-of-perfectoid-tate-rings (data): the completed filtered colimit
`R = R₀[1/ϖ]` of a filtered diagram of perfectoid Tate rings, `R₀` the `ϖ`-adic completion of
`colim_j R_j°`, with `R₀` open and `ϖ`-adic (Bhatt Remark 6.2.9; Sch12 Theorem 5.2). It does not
depend on `(j₀, ϖ)` (`equivOfChoice`); no injectivity, flatness or density is assumed. -/
def completedFilteredColimit : Type u :=
  Localization.Away (algebraMap (completedFilteredColimit.colimPB p F)
    (completedFilteredColimit.integral p F j₀ ϖ) (completedFilteredColimit.varpi p F j₀ ϖ))

namespace completedFilteredColimit

/-- P1/completed-colimit-of-perfectoid-tate-rings (instance): the ring structure. -/
instance instCommRing : CommRing (completedFilteredColimit p F j₀ ϖ) :=
  inferInstanceAs (CommRing (Localization.Away _))

/-- P1/completed-colimit-of-perfectoid-tate-rings (instance): `R` is an `R₀`-algebra. -/
instance instAlgebra : Algebra (integral p F j₀ ϖ) (completedFilteredColimit p F j₀ ϖ) :=
  inferInstanceAs (Algebra _ (Localization.Away _))

/-- P1/completed-colimit-of-perfectoid-tate-rings (instance): the topology with `R₀` open and
`ϖ`-adic. -/
instance instUniformSpace : UniformSpace (completedFilteredColimit p F j₀ ϖ) := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (instance). -/
instance instIsUniformAddGroup : IsUniformAddGroup (completedFilteredColimit p F j₀ ϖ) := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (instance). -/
instance instIsTopologicalRing : IsTopologicalRing (completedFilteredColimit p F j₀ ϖ) := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (instance): a Tate ring with pseudo-uniformizer
`ϖ` and ring of definition `R₀`. -/
instance instIsTateRing : IsTateRing (completedFilteredColimit p F j₀ ϖ) := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (instance). -/
instance instCompleteSpace : CompleteSpace (completedFilteredColimit p F j₀ ϖ) := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (instance). -/
instance instT2Space : T2Space (completedFilteredColimit p F j₀ ϖ) := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (instance): the completed colimit is a
perfectoid Tate ring; `R₀` is integral perfectoid. -/
instance isPerfectoidTateRing : IsPerfectoidTateRing p (completedFilteredColimit p F j₀ ϖ) :=
  sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (structure): the ring of definition `R₀`, an
open bounded subring with its `ϖ`-adic topology; `R₀ ⧸ ϖⁿ ≅ colim_j R_j° ⧸ ϖⁿ`. -/
def ringOfDefinition : Subring (completedFilteredColimit p F j₀ ϖ) :=
  (algebraMap (integral p F j₀ ϖ) (completedFilteredColimit p F j₀ ϖ)).range

/-- P1/completed-colimit-of-perfectoid-tate-rings (structure): `R₀` is open and bounded. -/
theorem ringOfDefinition_spec :
    IsOpen (ringOfDefinition p F j₀ ϖ : Set (completedFilteredColimit p F j₀ ϖ)) ∧
      IsBounded (ringOfDefinition p F j₀ ϖ : Set (completedFilteredColimit p F j₀ ϖ)) := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (constructor): the canonical continuous maps
`ι_j : R_j → R`. -/
def ι (j : J) : F.obj j →+* completedFilteredColimit p F j₀ ϖ := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (constructor): `ι_j` is continuous and
compatible: `ι_j ∘ F(a) = ι_i` for `a : i ⟶ j`. -/
theorem ι_spec (j : J) : Continuous (ι p F j₀ ϖ j) ∧
    ∀ {i : J} (a : i ⟶ j), (ι p F j₀ ϖ j).comp (F.map a).hom = ι p F j₀ ϖ i := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (constructor): `ι_j` as a morphism of perfectoid
Tate rings. -/
def ιHom (j : J) : F.obj j ⟶ PerfectoidRingCat.of p (completedFilteredColimit p F j₀ ϖ) :=
  ⟨ι p F j₀ ϖ j, (ι_spec p F j₀ ϖ j).1⟩

/-- P1/completed-colimit-of-perfectoid-tate-rings (universal-property): compatible continuous maps
into a complete Hausdorff uniform Tate ring extend uniquely (`lift_comp_ι`, `hom_ext`). -/
def lift {S : Type*} [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S]
    [IsTateRing S] [CompleteSpace S] [T2Space S] (hS : IsBounded (powerBoundedSubring S : Set S))
    (ψ : ∀ j, F.obj j →+* S) (hψ : ∀ j, Continuous (ψ j))
    (hcompat : ∀ {i j : J} (a : i ⟶ j), (ψ j).comp (F.map a).hom = ψ i) :
    completedFilteredColimit p F j₀ ϖ →+* S := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (universal-property): `lift ψ` is continuous,
`lift ψ ∘ ι_j = ψ_j`, and two continuous maps agreeing on all `ι_j` are equal. -/
theorem lift_comp_ι {S : Type*} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
    [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]
    (hS : IsBounded (powerBoundedSubring S : Set S)) (ψ : ∀ j, F.obj j →+* S)
    (hψ : ∀ j, Continuous (ψ j))
    (hcompat : ∀ {i j : J} (a : i ⟶ j), (ψ j).comp (F.map a).hom = ψ i) :
    Continuous (lift p F j₀ ϖ hS ψ hψ hcompat) ∧
      (∀ j, (lift p F j₀ ϖ hS ψ hψ hcompat).comp (ι p F j₀ ϖ j) = ψ j) ∧
      ∀ g h : completedFilteredColimit p F j₀ ϖ →+* S, Continuous g → Continuous h →
        (∀ j, g.comp (ι p F j₀ ϖ j) = h.comp (ι p F j₀ ϖ j)) → g = h := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (characterisation): `R₀ ⊆ R°` and
`ϖ^{1/pⁿ} R° ⊆ R₀` for all `n`, so `R° ⧸ R₀` is almost zero (P1/perfectoid-almost-setup). -/
theorem ringOfDefinition_almostEq :
    ringOfDefinition p F j₀ ϖ ≤ powerBoundedSubring (completedFilteredColimit p F j₀ ϖ) ∧
      ∀ (n : ℕ) (x : completedFilteredColimit p F j₀ ϖ),
        x ∈ powerBoundedSubring (completedFilteredColimit p F j₀ ϖ) →
          ι p F j₀ ϖ j₀ (ϖ.root n) * x ∈ ringOfDefinition p F j₀ ϖ := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (other): the image of `colim_j R_j` is dense. -/
theorem denseRange : Dense (⋃ j, Set.range (ι p F j₀ ϖ j)) := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (equivalence): tilting commutes with completed
filtered colimits: `R♭ ≅` the completed colimit of the `R_j♭` (for any choice `ϖ'` on the tilted
diagram, e.g. `ϖ♭ = ϖ.tiltRoots`), compatibly with `♯` and the `ι_j`. -/
def tiltEquiv (ϖ' : PseudoUniformizerRoots p ((F ⋙ tiltFunctor p).obj j₀)) :
    tilt p (completedFilteredColimit p F j₀ ϖ) ≃+*
      completedFilteredColimit p (F ⋙ tiltFunctor p) j₀ ϖ' := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (equivalence): `tiltEquiv` is a homeomorphism
sending `tilt.map (ι j)` to `ι j`. -/
theorem tiltEquiv_spec (ϖ' : PseudoUniformizerRoots p ((F ⋙ tiltFunctor p).obj j₀)) (j : J)
    (x : tilt p (F.obj j)) :
    tiltEquiv p F j₀ ϖ ϖ' (tilt.map p (ι p F j₀ ϖ j) (ι_spec p F j₀ ϖ j).1 x) =
      ι p (F ⋙ tiltFunctor p) j₀ ϖ' j x ∧
    Continuous (tiltEquiv p F j₀ ϖ ϖ') ∧ Continuous (tiltEquiv p F j₀ ϖ ϖ').symm := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (compatibility): changing `(j₀, ϖ♭)` (or the
rings of integral elements, or restricting along a final functor) gives canonically isomorphic
rings, compatibly with the `ι_j`. -/
def equivOfChoice (j₁ : J) (ϖ₁ : PseudoUniformizerRoots p (F.obj j₁)) :
    completedFilteredColimit p F j₀ ϖ ≃+* completedFilteredColimit p F j₁ ϖ₁ := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (compatibility): `equivOfChoice` commutes with
the `ι_j`. -/
theorem equivOfChoice_ι (j₁ : J) (ϖ₁ : PseudoUniformizerRoots p (F.obj j₁)) (j : J)
    (x : F.obj j) : equivOfChoice p F j₀ ϖ j₁ ϖ₁ (ι p F j₀ ϖ j x) = ι p F j₁ ϖ₁ j x := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (universal-property): the cocone of the
`ι_j`. -/
def cocone : Cocone F where
  pt := PerfectoidRingCat.of p (completedFilteredColimit p F j₀ ϖ)
  ι :=
    { app := fun j ↦ ιHom p F j₀ ϖ j
      naturality := sorry }

/-- P1/completed-colimit-of-perfectoid-tate-rings (universal-property): the completed filtered
colimit is the colimit in perfectoid Tate rings (with continuous ring homomorphisms). -/
def isColimit : IsColimit (cocone p F j₀ ϖ) := sorry

/-- P1/completed-colimit-of-perfectoid-tate-rings (equivalence): dually, for a perfectoid Tate ring
`R'` and a filtered system `G` of perfectoid `R'♭`-algebras, the untilt over `R'`
(`tiltingEquivalence`) of their completed colimit is the completed colimit of the untilts. -/
def untiltEquiv (R' : Type u) [CommRing R'] [UniformSpace R'] [IsUniformAddGroup R']
    [IsTopologicalRing R'] [IsTateRing R'] [CompleteSpace R'] [T2Space R']
    [IsPerfectoidTateRing p R'] (G : J ⥤ PerfectoidAlgebra p (tilt p R')) (j₀ : J)
    (ϖ : PseudoUniformizerRoots p ((G ⋙ Under.forget _).obj j₀))
    (ϖ' : PseudoUniformizerRoots p
      ((G ⋙ (tiltingEquivalence p R').inverse ⋙ Under.forget _).obj j₀)) :
    ((tiltingEquivalence p R').inverse.obj
        (Under.mk ((G.obj j₀).hom ≫ ιHom p (G ⋙ Under.forget _) j₀ ϖ j₀))).right ≃+*
      completedFilteredColimit p (G ⋙ (tiltingEquivalence p R').inverse ⋙ Under.forget _) j₀ ϖ' :=
  sorry

end completedFilteredColimit

end CompletedColimit

section CompletedColimitTests

variable (p : ℕ) [Fact p.Prime]

/-- P1/perfectoid-examples (2) (data): `K₁`, the completion of `ℚ_p(p^{1/p^∞})`, realised as the
closure in `ℂ_p` of the subfield generated by the `p`-power roots of `p`. -/
def padicPRootTower : Subfield ℂ_[p] :=
  (Subfield.closure {x : ℂ_[p] | ∃ n : ℕ, x ^ p ^ n = p}).topologicalClosure

/-- P1/perfectoid-examples (2) (instance): `K₁` is complete. -/
instance padicPRootTower.instCompleteSpace : CompleteSpace (padicPRootTower p) :=
  (Subfield.isClosed_topologicalClosure _).completeSpace_coe

/-- P1/perfectoid-examples (2) (instance): the absolute value of `K₁` is nontrivial. -/
instance padicPRootTower.instNontriviallyNormedField :
    NontriviallyNormedField (padicPRootTower p) :=
  { (inferInstance : NormedField (padicPRootTower p)) with non_trivial := sorry }

/-- P1/perfectoid-examples (2) (instance): `K₁` is a perfectoid field (AWS Example 2.3.7). -/
instance padicPRootTower.instIsPerfectoidField : IsPerfectoidField p (padicPRootTower p) :=
  sorry

variable {J : Type u} [SmallCategory J] [IsFiltered J]

-- test Perfectoid.completedFilteredColimit_const (degenerate)
--   [P1/completed-colimit-of-perfectoid-tate-rings]
example (F : J ⥤ PerfectoidRingCat.{u} p) (j₀ : J) (ϖ : PseudoUniformizerRoots p (F.obj j₀))
    (j : J) (hj : Limits.IsTerminal j) :
    ∃ e : completedFilteredColimit p F j₀ ϖ ≃+* F.obj j,
      (∀ x, e (completedFilteredColimit.ι p F j₀ ϖ j x) = x) ∧ Continuous e ∧
        Continuous e.symm := sorry

/- `K` a perfectoid field and `S = lim Sᵢ` profinite: the completed colimit of the `C(Sᵢ, K)` is
`C⁰(S, K)`, given compatible embeddings `C(Sᵢ, K) → C(S, K)` whose images exhaust the locally
constant functions; its ring of definition is `C⁰(S, K°)`. -/
-- test Perfectoid.completedFilteredColimit_locallyConstant (computation)
--   [P1/completed-colimit-of-perfectoid-tate-rings]
example (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [IsPerfectoidField p K] (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S]
    [TotallyDisconnectedSpace S] (F : J ⥤ PerfectoidRingCat.{u} p) (j₀ : J)
    (ϖ : PseudoUniformizerRoots p (F.obj j₀)) (c : ∀ j, F.obj j →+* C(S, K))
    (hc : ∀ {i j : J} (a : i ⟶ j), (c j).comp (F.map a).hom = c i) (hcont : ∀ j, Continuous (c j))
    (hinj : ∀ j, Function.Injective (c j))
    (hlc : ⋃ j, Set.range (c j) = {f : C(S, K) | IsLocallyConstant f}) :
    ∃ e : completedFilteredColimit p F j₀ ϖ ≃+* C(S, K),
      ∀ j x, e (completedFilteredColimit.ι p F j₀ ϖ j x) = c j x := sorry

/- For a filtered system of perfectoid fields (e.g. the untilts `L♯` of the finite extensions `L`
of `K♭` inside `(K♭)^alg`), the tilt of the completed colimit is the completed colimit of the
tilts, and the union of the images is dense. -/
-- test Perfectoid.completedFilteredColimit_tilt_algebraicClosure (compatibility)
--   [P1/completed-colimit-of-perfectoid-tate-rings]
example (F : J ⥤ PerfectoidRingCat.{u} p) (j₀ : J) (ϖ : PseudoUniformizerRoots p (F.obj j₀))
    (ϖ' : PseudoUniformizerRoots p ((F ⋙ tiltFunctor p).obj j₀)) (hF : ∀ j, IsField (F.obj j)) :
    Nonempty (tilt p (completedFilteredColimit p F j₀ ϖ) ≃+*
      completedFilteredColimit p (F ⋙ tiltFunctor p) j₀ ϖ') ∧
      Dense (⋃ j, Set.range (completedFilteredColimit.ι p F j₀ ϖ j)) := sorry

/- `ℚ_p(p^{1/pⁿ})` is discretely valued (value group `|p|^{ℤ/pⁿ}`), hence not perfectoid, and its
tilt in the sense of P1/tilt-of-uniform-tate-ring is `𝔽_p`; the completion `K₁` of the union is
perfectoid, with tilt containing `t` with `t♯ = p`. -/
-- test Perfectoid.completedFilteredColimit_nonPerfectoid_tower (non-example)
--   [P1/completed-colimit-of-perfectoid-tate-rings]
example (n : ℕ) :
    (∀ x ∈ Subfield.closure (Set.range (algebraMap ℚ_[p] ℂ_[p]) ∪ {x : ℂ_[p] | x ^ p ^ n = p}),
      x ≠ 0 → ∃ k : ℤ, ‖x‖ = ‖(p : ℂ_[p])‖ ^ ((k : ℝ) / (p : ℝ) ^ n)) ∧
    IsPerfectoidField p (padicPRootTower p) ∧
    ∃ t : tilt p (padicPRootTower p), ((tilt.sharp t : padicPRootTower p) : ℂ_[p]) = p := sorry

end CompletedColimitTests

/-! ## PerfectoidSpaces:P1/perfected-tate-algebra (construction) -/

section PerfectedTateAlgebra

variable (p : ℕ) [Fact p.Prime]

/-- P1/perfected-tate-algebra (data): the exponent monoid `ℤ[1/p]_{≥0}`. -/
def PDyadicExp : AddSubmonoid NNRat :=
  AddSubmonoid.closure (Set.range fun n : ℕ ↦ ((p : NNRat) ^ n)⁻¹)

/-- P1/perfected-tate-algebra (data): the exponent group `ℤ[1/p]` (Laurent variant). -/
def PDyadicInt : AddSubgroup ℚ := AddSubgroup.closure (Set.range fun n : ℕ ↦ ((p : ℚ) ^ n)⁻¹)

/-- P1/perfected-tate-algebra (data): the exponent `1/pᵐ`. -/
def PDyadicExp.invPow (m : ℕ) : PDyadicExp p :=
  ⟨((p : NNRat) ^ m)⁻¹, AddSubmonoid.subset_closure ⟨m, rfl⟩⟩

variable {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
  [IsTateRing R] [CompleteSpace R] [T2Space R]

variable (R) in
/-- P1/perfected-tate-algebra (data): a chosen pseudo-uniformizer `ϖ ∈ R°` with `ϖ ^ p ∣ p`
(ECD Definition 3.1 (b)); the constructions below do not depend on it up to canonical
isomorphism. -/
def IsPerfectoidTateRing.pseudoUniformizer [IsPerfectoidTateRing p R] : powerBoundedSubring R :=
  (IsPerfectoidTateRing.exists_pseudoUniformizer (p := p) (R := R)).choose

variable (R) in
/-- P1/perfected-tate-algebra (data): the `ϖ`-adic completion `A₀` of the monoid algebra
`R°[T^a : a ∈ M]`. -/
abbrev completedMonoidAlgebra.integral [IsPerfectoidTateRing p R] (M : Type*) [AddCommMonoid M] :
    Type _ :=
  AdicCompletion (Ideal.span {(AddMonoidAlgebra.single 0
    (IsPerfectoidTateRing.pseudoUniformizer p R) : AddMonoidAlgebra (powerBoundedSubring R) M)})
    (AddMonoidAlgebra (powerBoundedSubring R) M)

variable (R) in
/-- P1/perfected-tate-algebra (data): `A₀[1/ϖ]`, `A₀` the `ϖ`-adic completion of the monoid
algebra `R°[T^a : a ∈ M]`, topologised with `A₀` open and `ϖ`-adic (the Gauss norm). -/
def completedMonoidAlgebra [IsPerfectoidTateRing p R] (M : Type*) [AddCommMonoid M] : Type _ :=
  Localization.Away (algebraMap (AddMonoidAlgebra (powerBoundedSubring R) M)
    (completedMonoidAlgebra.integral p R M)
    (AddMonoidAlgebra.single 0 (IsPerfectoidTateRing.pseudoUniformizer p R)))

namespace completedMonoidAlgebra

variable [IsPerfectoidTateRing p R] (M : Type*) [AddCommMonoid M]

/-- P1/perfected-tate-algebra (instance): the ring structure. -/
instance instCommRing : CommRing (completedMonoidAlgebra p R M) :=
  inferInstanceAs (CommRing (Localization.Away _))

/-- P1/perfected-tate-algebra (instance): the `A₀`-algebra structure. -/
instance instAlgebraIntegral : Algebra (integral p R M) (completedMonoidAlgebra p R M) :=
  inferInstanceAs (Algebra _ (Localization.Away _))

/-- P1/perfected-tate-algebra (instance): the `R`-algebra structure (`R = R°[1/ϖ]`). -/
instance instAlgebra : Algebra R (completedMonoidAlgebra p R M) := sorry

/-- P1/perfected-tate-algebra (instance): the topology with `A₀` open and `ϖ`-adic. -/
instance instUniformSpace : UniformSpace (completedMonoidAlgebra p R M) := sorry

/-- P1/perfected-tate-algebra (instance). -/
instance instIsUniformAddGroup : IsUniformAddGroup (completedMonoidAlgebra p R M) := sorry

/-- P1/perfected-tate-algebra (instance). -/
instance instIsTopologicalRing : IsTopologicalRing (completedMonoidAlgebra p R M) := sorry

/-- P1/perfected-tate-algebra (instance): a Tate ring with pseudo-uniformizer `ϖ`. -/
instance instIsTateRing : IsTateRing (completedMonoidAlgebra p R M) := sorry

/-- P1/perfected-tate-algebra (instance). -/
instance instCompleteSpace : CompleteSpace (completedMonoidAlgebra p R M) := sorry

/-- P1/perfected-tate-algebra (instance). -/
instance instT2Space : T2Space (completedMonoidAlgebra p R M) := sorry

/-- P1/perfected-tate-algebra (data): the monomial `T^a`. -/
def monomial (a : M) : completedMonoidAlgebra p R M :=
  (algebraMap (integral p R M) (Localization.Away (algebraMap
      (AddMonoidAlgebra (powerBoundedSubring R) M) (integral p R M)
      (AddMonoidAlgebra.single 0 (IsPerfectoidTateRing.pseudoUniformizer p R))))
    (algebraMap (AddMonoidAlgebra (powerBoundedSubring R) M) (integral p R M)
      (AddMonoidAlgebra.single a 1)) :
    Localization.Away (algebraMap (AddMonoidAlgebra (powerBoundedSubring R) M) (integral p R M)
      (AddMonoidAlgebra.single 0 (IsPerfectoidTateRing.pseudoUniformizer p R))))

end completedMonoidAlgebra

variable (R) in
/-- P1/perfected-tate-algebra (data): the perfected Tate algebra `R⟨T_s^{1/p^∞} : s ∈ Σ⟩` in an
arbitrary set of variables over a perfectoid Tate ring: `A₀[1/ϖ]`, `A₀` the `ϖ`-adic completion
of `R°[T^a : a ∈ ℤ[1/p]_{≥0}^{(Σ)}]` (KL II Example 3.3.12, AWS Example 2.1.4). -/
abbrev perfectedTateAlgebra [IsPerfectoidTateRing p R] (σ : Type*) : Type _ :=
  completedMonoidAlgebra p R (σ →₀ PDyadicExp p)

namespace perfectedTateAlgebra

variable [IsPerfectoidTateRing p R] {σ : Type*}

/-- P1/perfected-tate-algebra (instance): the perfected Tate algebra is perfectoid, with
`R⟨T^{1/p^∞}⟩° = A₀ = {Σ c_a T^a : c_a ∈ R°, c_a → 0}`. -/
instance isPerfectoidTateRing : IsPerfectoidTateRing p (perfectedTateAlgebra p R σ) := sorry

/-- P1/perfected-tate-algebra (constructor): `X s a = T_s^a` for `a ∈ ℤ[1/p]_{≥0}`. -/
def X (s : σ) (a : PDyadicExp p) : perfectedTateAlgebra p R σ :=
  completedMonoidAlgebra.monomial p _ (Finsupp.single s a)

/-- P1/perfected-tate-algebra (constructor): `X s (a + b) = X s a * X s b`, and `X s a ∈ A°`. -/
theorem X_add (s : σ) (a b : PDyadicExp p) :
    X p (R := R) s (a + b) = X p s a * X p s b ∧
      X p (R := R) s a ∈ powerBoundedSubring (perfectedTateAlgebra p R σ) := sorry

variable (R σ) in
/-- P1/perfected-tate-algebra (characterisation): `A° = A₀`, the null sequences
`Σ c_a T^a`, `c_a ∈ R°`, `c_a → 0` along the cofinite filter. -/
theorem powerBoundedSubring_eq :
    powerBoundedSubring (perfectedTateAlgebra p R σ) =
      (algebraMap (completedMonoidAlgebra.integral p R (σ →₀ PDyadicExp p))
        (perfectedTateAlgebra p R σ)).range := sorry

variable (R σ) in
/-- P1/perfected-tate-algebra (universal-property): for a complete Hausdorff uniform Tate
`R`-algebra `S` and compatible systems `t s ∈ lim_{x ↦ x^p} S°`, the unique continuous
`R`-algebra map with `T_s^{1/pᵐ} ↦ (t s)⁽ᵐ⁾`. -/
def lift (S : Type*) [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S]
    [IsTateRing S] [CompleteSpace S] [T2Space S] [Algebra R S] (hS : Continuous (algebraMap R S))
    (hb : IsBounded (powerBoundedSubring S : Set S))
    (t : σ → Perfection (powerBoundedSubring S) p) : perfectedTateAlgebra p R σ →ₐ[R] S := sorry

/-- P1/perfected-tate-algebra (universal-property): `lift t (T_s^{1/pᵐ}) = (t s)⁽ᵐ⁾`, `lift t` is
continuous, and continuous `R`-algebra maps agreeing on all `T_s^{1/pᵐ}` are equal. -/
theorem lift_X (S : Type*) [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
    [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S] [Algebra R S]
    (hS : Continuous (algebraMap R S)) (hb : IsBounded (powerBoundedSubring S : Set S))
    (t : σ → Perfection (powerBoundedSubring S) p) (s : σ) (m : ℕ) :
    lift p R σ S hS hb t (X p s (PDyadicExp.invPow p m)) =
        ((Perfection.coeffMonoidHom (powerBoundedSubring S) p m (t s) : powerBoundedSubring S) :
          S) ∧
      Continuous (lift p R σ S hS hb t) ∧
      ∀ f g : perfectedTateAlgebra p R σ →ₐ[R] S, Continuous f → Continuous g →
        (∀ s m, f (X p s (PDyadicExp.invPow p m)) = g (X p s (PDyadicExp.invPow p m))) → f = g :=
  sorry

variable (R σ) in
/-- P1/perfected-tate-algebra (universal-property): for `S` perfectoid, continuous `R`-algebra
maps `R⟨T^{1/p^∞}⟩ → S` correspond to families in `S♭°`, `T_s^{1/pᵐ} ↦ (x_s^{1/pᵐ})♯`. -/
def liftTilt (S : Type*) [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S]
    [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S] [Algebra R S]
    (hS : Continuous (algebraMap R S)) :
    (σ → powerBoundedSubring (tilt p S)) ≃
      {f : perfectedTateAlgebra p R σ →ₐ[R] S // Continuous f} := sorry

variable (R σ) in
/-- P1/perfected-tate-algebra (equivalence): `R⟨T^{1/p^∞}⟩♭ ≅ R♭⟨T^{1/p^∞}⟩`, a homeomorphism
with `T_s♯ = T_s` (ECD Example 3.4(iii), AWS Example 2.3.15). -/
def tiltEquiv : tilt p (perfectedTateAlgebra p R σ) ≃+* perfectedTateAlgebra p (tilt p R) σ :=
  sorry

variable (R) in
/-- P1/perfected-tate-algebra (functoriality): `g : Σ → Σ'` induces `T_s^a ↦ T_{g s}^a`;
`mapIndex id = id` and `mapIndex (g' ∘ g) = mapIndex g' ∘ mapIndex g`. -/
def mapIndex {σ' : Type*} (g : σ → σ') :
    perfectedTateAlgebra p R σ →ₐ[R] perfectedTateAlgebra p R σ' := sorry

/-- P1/perfected-tate-algebra (functoriality): `mapIndex` is continuous, sends `T_s^a` to
`T_{g s}^a` and is functorial. -/
theorem mapIndex_spec {σ' σ'' : Type*} (g : σ → σ') (g' : σ' → σ'') :
    Continuous (mapIndex p R g) ∧ (∀ s a, mapIndex p R g (X p s a) = X p (g s) a) ∧
      mapIndex p R (id : σ → σ) = AlgHom.id R _ ∧
      mapIndex p R (g' ∘ g) = (mapIndex p R g').comp (mapIndex p R g) := sorry

end perfectedTateAlgebra

variable (R) in
/-- P1/perfected-tate-algebra (data): `Σ₀ ↦ R⟨T_s^{1/p^∞} : s ∈ Σ₀⟩` on finite subsets
`Σ₀ ⊆ Σ`, a filtered diagram of perfectoid Tate rings. -/
def perfectedFinsetFunctor [IsPerfectoidTateRing p R] (σ : Type u) :
    Finset σ ⥤ PerfectoidRingCat.{u} p where
  obj s := PerfectoidRingCat.of p (perfectedTateAlgebra p R s)
  map {s t} a := ⟨(perfectedTateAlgebra.mapIndex p R
      (fun x : s ↦ (⟨x.1, leOfHom a x.2⟩ : t))).toRingHom, sorry⟩
  map_id := sorry
  map_comp := sorry

namespace perfectedTateAlgebra

variable [IsPerfectoidTateRing p R]

variable (R) in
/-- P1/perfected-tate-algebra (compatibility): `R⟨T_s^{1/p^∞} : s ∈ Σ⟩` is the completed filtered
colimit of the algebras in finitely many of the variables
(P1/completed-colimit-of-perfectoid-tate-rings). -/
def equivCompletedColimit (σ : Type u)
    (ϖ : PseudoUniformizerRoots p ((perfectedFinsetFunctor p R σ).obj ∅)) :
    perfectedTateAlgebra p R σ ≃+* completedFilteredColimit p (perfectedFinsetFunctor p R σ) ∅ ϖ :=
  sorry

variable (R) in
/-- P1/perfected-tate-algebra (compatibility): for `Σ = Fin n`, the continuous injective
`R`-algebra map `R⟨T₁, …, Tₙ⟩ → R⟨T₁^{1/p^∞}, …, Tₙ^{1/p^∞}⟩` (Tau Ceti
`restrictedMvPowerSeriesCompletion`) with closed image, `Tᵢ ↦ X i 1`. -/
def restrictedIncl (n : ℕ) :
    restrictedMvPowerSeriesCompletion n R →+* perfectedTateAlgebra p R (Fin n) := sorry

variable (R) in
/-- P1/perfected-tate-algebra (other): for `Σ = Fin n`, the continuous `R`-linear projection `σ`
onto integral exponents with `σ ∘ restrictedIncl = id` (the perfectoid frame of
AdicSpacesPartII:R5/sousperfectoid-ring). -/
def retraction (n : ℕ) :
    perfectedTateAlgebra p R (Fin n) →ₗ[R] restrictedMvPowerSeriesCompletion n R := sorry

/-- P1/perfected-tate-algebra (compatibility): `restrictedIncl` is continuous, injective, with
closed image; `retraction` is continuous and `retraction ∘ restrictedIncl = id`. -/
theorem restrictedIncl_spec (n : ℕ) :
    Continuous (restrictedIncl p R n) ∧ Function.Injective (restrictedIncl p R n) ∧
      IsClosed (Set.range (restrictedIncl p R n)) ∧ Continuous (retraction p R n) ∧
      ∀ x, retraction p R n (restrictedIncl p R n x) = x := sorry

variable {σ : Type*}

/-- P1/perfected-tate-algebra (constructor): for a ring of integral elements `R⁺`,
`R⁺⟨T_s^{1/p^∞}⟩`, the closure of `R⁺[T_s^{1/p^∞}]`, is a ring of integral elements; the
resulting perfectoid pair. -/
def plus (P : Pair R) : Pair (perfectedTateAlgebra p R σ) where
  plus := (Subring.closure (Set.range (fun x : P.plus ↦ algebraMap R _ (x : R)) ∪
    Set.range (fun sa : σ × PDyadicExp p ↦ X p sa.1 sa.2))).topologicalClosure
  isRingOfIntegralElements := sorry

variable (R σ) in
/-- P1/perfected-tate-algebra (other): the Laurent variant `R⟨T_s^{±1/p^∞}⟩`, with exponents in
`ℤ[1/p]^{(Σ)}`, is perfectoid (KL II Example 3.3.12). -/
theorem laurent :
    IsPerfectoidTateRing p (completedMonoidAlgebra p R (σ →₀ PDyadicInt p)) := sorry

variable (R) in
/-- P1/perfected-tate-algebra (example): with no variables, `R⟨⟩ = R`. -/
def emptyEquiv : perfectedTateAlgebra p R PEmpty ≃+* R := sorry

end perfectedTateAlgebra

end PerfectedTateAlgebra

section PerfectedTests

variable (p : ℕ) [Fact p.Prime]

-- test Perfectoid.perfectedTateAlgebra_empty_test (degenerate) [P1/perfected-tate-algebra]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] :
    Continuous (perfectedTateAlgebra.emptyEquiv p R) ∧
      Continuous (perfectedTateAlgebra.emptyEquiv p R).symm := sorry

/- `Σ = ℕ`: `Σ_k ϖᵏ X k 1` converges, `Σ_k X k 1` does not. -/
-- test Perfectoid.perfectedTateAlgebra.X_pow (computation) [P1/perfected-tate-algebra]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (s : ℕ) (m : ℕ) :
    perfectedTateAlgebra.X p (R := R) s (PDyadicExp.invPow p (m + 1)) ^ p =
        perfectedTateAlgebra.X p s (PDyadicExp.invPow p m) ∧
      Summable (fun k : ℕ ↦ algebraMap R (perfectedTateAlgebra p R ℕ)
        ((IsPerfectoidTateRing.pseudoUniformizer p R : R) ^ k) *
          perfectedTateAlgebra.X p k (PDyadicExp.invPow p 0)) ∧
      ¬ Summable (fun k : ℕ ↦ perfectedTateAlgebra.X p (R := R) k (PDyadicExp.invPow p 0)) :=
  sorry

/- `ℚ_p^cycl⟨T^{1/p^∞}⟩♭ = 𝔽_p((t^{1/p^∞}))^⟨T^{1/p^∞}⟩` (ECD Example 3.4(iii)). -/
-- test Perfectoid.perfectedTateAlgebra.tilt_cyclotomic (compatibility) [P1/perfected-tate-algebra]
example : Nonempty (tilt p (perfectedTateAlgebra p (padicCyclotomic p) Unit) ≃+*
    perfectedTateAlgebra p (tilt p (padicCyclotomic p)) Unit) := sorry

-- test Perfectoid.perfectedTateAlgebra_fin_test (compatibility) [P1/perfected-tate-algebra]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (n : ℕ) :
    Function.Injective (perfectedTateAlgebra.restrictedIncl p R n) ∧
      (∀ x, perfectedTateAlgebra.retraction p R n (perfectedTateAlgebra.restrictedIncl p R n x) =
        x) ∧
      IsEmbedding (perfectedTateAlgebra.mapIndex p R (Fin.val : Fin n → ℕ)) := sorry

/- `R⟨T⟩` is not perfectoid: `T₁` is not a `p`-th power modulo `ϖ ^ p`
(AdicSpacesPartII:R5/perfectoid-times-polydisc). -/
-- test Perfectoid.not_isPerfectoidTateRing_restricted (non-example) [P1/perfected-tate-algebra]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [Nontrivial R] (n : ℕ)
    (hn : 0 < n) (_ : IsTateRing (restrictedMvPowerSeriesCompletion n R)) :
    ¬ IsPerfectoidTateRing p (restrictedMvPowerSeriesCompletion n R) := sorry

/- `t_s⁽ᵐ⁾ = 1`: evaluation at `T = 1`. -/
-- test Perfectoid.perfectedTateAlgebra.lift_one (characterisation) [P1/perfected-tate-algebra]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (σ : Type*)
    (s : σ) (a : PDyadicExp p) :
    perfectedTateAlgebra.lift p R σ R continuous_id
        (IsPerfectoidTateRing.isBounded_powerBoundedSubring (p := p)) (fun _ ↦ 1)
        (perfectedTateAlgebra.X p s a) = 1 ∧
      ∀ f g : perfectedTateAlgebra p R σ →ₐ[R] R, Continuous f → Continuous g →
        (∀ s m, f (perfectedTateAlgebra.X p s (PDyadicExp.invPow p m)) =
          g (perfectedTateAlgebra.X p s (PDyadicExp.invPow p m))) → f = g := sorry

end PerfectedTests

/-! ## PerfectoidSpaces:P1/cyclotomic-perfectoid-field (theorem) -/

section Cyclotomic

variable (p : ℕ) [Fact p.Prime]

/-- P1/cyclotomic-perfectoid-field: `ℚ_p^cycl` is a perfectoid field (instance
`padicCyclotomic.instIsPerfectoidField`): its value group `|p|^{ℤ[1/p]/(p-1)}` is not discrete and
Frobenius is surjective on `ℤ_p^cycl ⧸ p`. -/
theorem padicCyclotomic.isPerfectoidField_spec :
    IsPerfectoidField p (padicCyclotomic p) ∧
      (∀ x : padicCyclotomic p, x ≠ 0 → ∃ (m : ℤ) (n : ℕ),
        ‖x‖ = ‖(p : ℂ_[p])‖ ^ ((m : ℝ) / ((p : ℝ) ^ n * ((p : ℝ) - 1)))) ∧
      Function.Surjective fun x : ModP (powerBoundedSubring (padicCyclotomic p)) p ↦ x ^ p :=
  sorry

/-- P1/cyclotomic-perfectoid-field: the tilt of `ℚ_p^cycl` is the completed perfection of
`𝔽_p((t))`, `t = ε - 1`, `ε = (1, ζ_p, ζ_{p²}, …)`, with `|t♯| = |p|^{p/(p-1)}` (Berkeley Example
6.2.4). -/
theorem padicCyclotomic.exists_epsilon :
    ∃ ε : tilt p (padicCyclotomic p), (∀ n, IsPrimitiveRoot (tilt.coeff n ε) (p ^ n)) ∧
      ‖ε - 1‖ = ‖(p : ℂ_[p])‖ ^ ((p : ℝ) / ((p : ℝ) - 1)) := sorry

/-- P1/cyclotomic-perfectoid-field: `ℚ_p^cycl` is the untilt of
`(𝔽_p((t^{1/p^∞}))^, 𝔽_p[[t^{1/p^∞}]]^)` along the primitive ideal `(Σ_{i<p} [1 + t]^{i/p})`
(AWS Example 2.3.8; KL I Example 3.3.8). -/
def padicCyclotomic.untiltEquiv (ε : (Pair.powerBounded (tilt p (padicCyclotomic p))).plus)
    (hε : ∀ n, IsPrimitiveRoot (tilt.coeff n (ε : tilt p (padicCyclotomic p))) (p ^ (n + 1)))
    [Fact (IsPrimitiveIdeal (Ideal.span
      {∑ i ∈ Finset.range p, WittVector.teichmuller p ε ^ i}))] :
    untilt p (Pair.powerBounded (tilt p (padicCyclotomic p)))
        (Ideal.span {∑ i ∈ Finset.range p, WittVector.teichmuller p ε ^ i}) ≃+*
      padicCyclotomic p := sorry

end Cyclotomic

/-! ## PerfectoidSpaces:P1/perfectoid-examples (application) -/

section Examples

variable (p : ℕ) [Fact p.Prime]

/-- P1/perfectoid-examples (ECD Example 3.4, Remark 3.3): `ℂ_p`, `K₁ = ℚ_p(p^{1/p^∞})^`, the
completed perfection `𝔽_p((t^{1/p^∞}))^ = ℚ_p^cycl♭`, `ℚ_p^cycl`, `ℚ_p^cycl⟨T^{1/p^∞}⟩` and the
product `ℂ_p × ℂ_p♭` (in which `p` is a nonzero nonunit) are perfectoid Tate rings; `K₁` has a
tilt element `t` with `t♯ = p`. -/
theorem perfectoidExamples :
    IsPerfectoidTateRing p ℂ_[p] ∧ IsPerfectoidField p (padicPRootTower p) ∧
      IsPerfectoidTateRing p (tilt p (padicCyclotomic p)) ∧
      IsPerfectoidField p (padicCyclotomic p) ∧
      IsPerfectoidTateRing p (perfectedTateAlgebra p (padicCyclotomic p) Unit) ∧
      IsPerfectoidTateRing p (ℂ_[p] × tilt p ℂ_[p]) ∧
      ∃ t : tilt p (padicPRootTower p), ((tilt.sharp t : padicPRootTower p) : ℂ_[p]) = p := sorry

/-- P1/perfectoid-examples (non-examples, ECD Remark 3.3): `ℚ_p` (discretely valued) and
`ℂ_p[ε]/(ε²)` (not uniform) are not perfectoid. -/
theorem perfectoidNonExamples :
    ¬ IsPerfectoidTateRing p ℚ_[p] ∧ ¬ IsPerfectoidTateRing p (DualNumber ℂ_[p]) := sorry

-- Example (6) of P1/perfectoid-examples, `ℤ_p^cycl[[T^{1/p^∞}]]⟨(p/T)^{1/p^∞}⟩[1/T]` with
--   `ϖ = T^{1/p}` (ECD Example 3.4(iv), Berkeley Example 6.1.5(4)), a perfectoid Tate ring
--   containing no nonarchimedean field, is not stated here: it needs the rational localisation
--   `⟨(p/T)^{1/p^∞}⟩` of a perfectoid Tate ring as a completed Huber ring (supplier:
--   PerfectoidSpaces:P2/rational-localization-of-perfectoid-affinoids).

end Examples

/-! ## PerfectoidSpaces:P1/anchor-layer-6-compatibility (comparison) -/

section AnchorLayer6

variable (p : ℕ) [Fact p.Prime] (F : Type u) [NontriviallyNormedField F] [IsUltrametricDist F]
  [CompleteSpace F] [CharP F p] [PerfectRing F p]

/-- P1/anchor-layer-6-compatibility: a complete perfect nonarchimedean field of characteristic
`p` is a perfectoid field (`IsPerfectoidField.iff_perfectRing`); a local instance below. -/
theorem isPerfectoidField_of_perfectRing : IsPerfectoidField p F :=
  (IsPerfectoidField.iff_perfectRing p).mpr inferInstance

attribute [local instance] isPerfectoidField_of_perfectRing

/-- P1/anchor-layer-6-compatibility (a): the anchor's complete rank-one perfect field `F` of
characteristic `p` (AdicSpaces Layer 6.1) is a perfectoid field of characteristic `p`, its own
tilt with `♯ = id`, and `(F, 𝒪_F)` is a perfectoid pair. -/
theorem anchor_isPerfectoidField :
    IsPerfectoidField p F ∧ (∀ x : tilt p F, tiltField.equivSelfOfCharP (p := p) x = tilt.sharp x) ∧
      IsPerfectoidPair p (Pair.powerBounded F) := sorry

/-- P1/anchor-layer-6-compatibility (b): the anchor's `A_inf = W(𝒪_F)` with pair of definition
`(A_inf, (p, [ϖ]))` is `W(F♭⁺)` of this layer; it is `(p, [ϖ])`-adically complete and separated
(P1/witt-vectors-of-perfect-plus-ring). -/
theorem anchor_ainf_isAdicComplete (ϖ : (Pair.powerBounded F).plus)
    (hϖ : IsPseudoUniformizer (ϖ : F)) :
    IsAdicComplete (Ideal.span {(p : WittVector p (Pair.powerBounded F).plus),
      WittVector.teichmuller p ϖ}) (WittVector p (Pair.powerBounded F).plus) := sorry

/-- P1/anchor-layer-6-compatibility (c): the untilts of `F` are the pairs
`(W(𝒪_F)[1/[ϖ]] ⧸ ξ, W(𝒪_F) ⧸ ξ)` for primitive `ξ ∈ A_inf`
(P1/untilts-classified-by-primitive-ideals). -/
theorem anchor_untilts (X : MarkedUntilt p (Pair.powerBounded F)) :
    ∃ ξ : WittVector p (Pair.powerBounded F).plus, IsPrimitive ξ ∧
      X.primitiveIdeal = Ideal.span {ξ} := sorry

end AnchorLayer6

end Perfectoid

end TauCeti

