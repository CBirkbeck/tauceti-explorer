/-! ## PerfectoidSpaces:P5/finite-etale-finite-stage-approximation (theorem) -/

-- PerfectoidSpace.isEquivalence_etaleComparison_finiteEtale: not stated here; needs the finite
--   étale site of a perfectoid space and base change along `X → X_i`
--   (supplier: PerfectoidSpaces:P3/etale-site-of-perfectoid-space,
--   PerfectoidSpaces:P2/fibre-products-of-perfectoid-spaces). Ring form below:
--   `isEquivalence_etaleComparison_finiteEtale_ring`, whose algebraic input is
--   PerfectoidSpaces:P3/finite-etale-completed-direct-limit.

namespace Perfectoid

namespace completedColimit

variable {p : ℕ} [Fact p.Prime] {I : Type u} [SmallCategory I] [IsCofiltered I]
  {D : PairDiagram p I} (c : CompatiblePseudouniformizer D)

/-- P5/finite-etale-finite-stage-approximation (data): the category `FÉt(A)` of finite étale
`A`-algebras, a full subcategory of Mathlib's `CommAlgCat A`. -/
abbrev FiniteEtaleAlg (A : Type u) [CommRing A] : Type (u + 1) :=
  ObjectProperty.FullSubcategory fun S : CommAlgCat.{u} A ↦ Algebra.Etale A S ∧ Module.Finite A S

/-- P5/finite-etale-finite-stage-approximation (data): the base-change pseudofunctor
`i ↦ FÉt(R_i)`, `S_i ↦ S_i ⊗_{R_i} R_j` along `φ_a`, on `Iᵒᵖ`. -/
def fetPseudofunctor (D : PairDiagram p I) : Pseudofunctor (LocallyDiscrete Iᵒᵖ) Cat.{u, u + 1} :=
  sorry

/-- P5/finite-etale-finite-stage-approximation (data): the pseudo-cocone `S_i ↦ S_i ⊗_{R_i} R`
(no completion: the tensor product is finite projective over `R`). -/
def fetCocone :
    CategoryTheory.FilteredTwoColimit.PseudoCocone (fetPseudofunctor D)
      (FiniteEtaleAlg (completedColimit c)) := sorry

/-- P5/finite-etale-finite-stage-approximation (data): the base-change functor
`2-colim_i FÉt(R_i) ⥤ FÉt(R)`. -/
def fetComparison :
    CategoryTheory.FilteredTwoColimit (fetPseudofunctor D) ⥤ FiniteEtaleAlg (completedColimit c) :=
  CategoryTheory.FilteredTwoColimit.desc _ (fetCocone c)

end completedColimit

end Perfectoid

namespace PerfectoidSpace

open Perfectoid Perfectoid.completedColimit

section FiniteEtale

variable {p : ℕ} [Fact p.Prime] {I : Type u} [SmallCategory I] [IsCofiltered I]
  {D : PairDiagram p I} (c : CompatiblePseudouniformizer D)

/-- P5/finite-etale-finite-stage-approximation (ring form of ECD Proposition 6.4 (i)): base change
induces an equivalence `2-colim_i FÉt(R_i) ≌ FÉt(R)` (ECD proof of Proposition 6.4 (i); Sch12
proof of Lemma 7.5 (i); Berkeley Theorem 7.4.8; Gabber–Ramero Proposition 5.4.54). -/
theorem isEquivalence_etaleComparison_finiteEtale_ring : (fetComparison c).IsEquivalence := sorry

/-- P5/finite-etale-finite-stage-approximation (lifting, ring form): every finite étale
`R`-algebra is `S_i ⊗_{R_i} R` for some `i` and some finite étale `R_i`-algebra `S_i`. -/
theorem exists_finiteEtale_baseChange_ring (S : Type u) [CommRing S]
    [Algebra (completedColimit c) S] [Algebra.Etale (completedColimit c) S]
    [Module.Finite (completedColimit c) S] :
    ∃ (i : I) (Si : Type u) (_ : CommRing Si) (_ : Algebra (D.ring.obj (op i)) Si),
      Algebra.Etale (D.ring.obj (op i)) Si ∧ Module.Finite (D.ring.obj (op i)) Si ∧
      letI := (ι c i).toRingHom.toAlgebra
      Nonempty (TensorProduct (D.ring.obj (op i)) (completedColimit c) Si ≃ₐ[completedColimit c]
        S) :=
  sorry

end FiniteEtale

