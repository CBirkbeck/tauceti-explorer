/-! ## PerfectoidSpaces:P7/frobenius-tower-tilt (lemma) -/

/-- P7/frobenius-tower-tilt: for a Frobenius-controlled tower `T` and one `S` of characteristic
`p` with isomorphisms `α_m : A_m⁺/ϖ^p ≅ S_m⁺/t^p` (`m ≥ m₁`) compatible with the transition maps,
`S_∞` is perfect and is the tilt of `A_∞`: there is a homeomorphic isomorphism `A_∞♭ ≅ S_∞` (P1
`tilt`) carrying `ϖ♭` to a unit multiple of `t` (Torsion, proof of Corollary III.2.19). -/
theorem completed_tilt (S : FrobeniusTower.{u} p) (hS : (p : S.A 0) = 0) (m₁ : ℕ)
    (α : ∀ m, m₁ ≤ m →
      (T.A m ⧸ Ideal.span {T.varpi m ^ p}) ≃+* (S.A m ⧸ Ideal.span {S.varpi m ^ p}))
    (hα : ∀ m (hm : m₁ ≤ m) (x : T.A m ⧸ Ideal.span {T.varpi m ^ p}),
      α (m + 1) (hm.trans m.le_succ) (powQuotMapOf (T.t m) (y := T.varpi (m + 1)) rfl p x) =
        powQuotMapOf (S.t m) (y := S.varpi (m + 1)) rfl p (α m hm x)) :
    ((p : S.completed) = 0 ∧ Function.Bijective fun x : S.completed ↦ x ^ p) ∧
      ∃ e : tilt p T.completed ≃+* S.completed, Continuous e ∧ Continuous e.symm ∧
        ∀ ϖ' : PseudoUniformizerRoots p T.completed,
          Associated (ϖ'.root 0) (algebraMap T.completedPlus T.completed T.varpiCompleted) →
            ∃ u : S.completedˣ,
              e ϖ'.toTilt = u * algebraMap S.completedPlus S.completed S.varpiCompleted := sorry

-- Perfectoid.FrobeniusTower.completed_tilt_spa: not stated here; that `Spa(S_∞, S_∞⁺⁺)` is the
--   tilt of `Spa(A_∞, A_∞⁺⁺)`, and globally the tilt of `X_∞` is the limit of the
--   characteristic-`p` tower, needs the tilting of perfectoid spaces (supplier:
--   PerfectoidSpaces:P2/perfectoid-space; affinoid form P2a `PerfectoidSpace.spaTilt`).

/-! ## PerfectoidSpaces:P7/perfection-tilde-limit (lemma) -/

section PerfectionTower

variable (k : Type u) [CommRing k] [CharP k p] [PerfectRing k p] (t : k) (S : Type u) [CommRing S]
  [Algebra k S] [Module.Flat k S] [CharP S p] (hreg : IsSMulRegular S (algebraMap k S t))
  (hcomp : IsAdicComplete (Ideal.span {algebraMap k S t}) S)

/-- P7/perfection-tilde-limit (ii): the completion `S^{perf⁺}` of the relative Frobenius tower is
the `t`-adic completion of `colim_Φ S⁺`, and `S^{perf} = S^{perf⁺}[1/t]` is perfect (hence
perfectoid, P1 `IsPerfectoidTateRing.iff_perfectRing`; Torsion, Definition III.2.18 (ii)). -/
theorem perfection_completed_perfect :
    (p : (perfection p k t S hreg hcomp).completed) = 0 ∧
      Function.Bijective fun x : (perfection p k t S hreg hcomp).completed ↦ x ^ p := sorry

/-- P7/perfection-tilde-limit (iii), affinoid core: every projection
`|Spa(S^{perf}, S^{perf⁺⁺})| → |Spa(S_m, S_m⁺⁺)|` is a homeomorphism (Frobenius is a universal
homeomorphism); with `isTildeLimit_genericFibres_affinoid` this gives `Y^{perf} ~ lim_Φ Y`. -/
theorem perfection_isHomeomorph_spaComap (m : ℕ) :
    IsHomeomorph ((perfection p k t S hreg hcomp).toCompletedPair m).spaComap := sorry

end PerfectionTower

-- Perfectoid.FrobeniusTower.perfection_isTildeLimit: not stated here; (iii) uniqueness of
--   `Y^{perf}` over `k`, (iv) gluing for analytic adic spaces over `k`, and the formal-scheme
--   statement need adic spaces, perfectoid spaces and formal schemes (supplier: AdicSpaces
--   Layer 5, PerfectoidSpaces:P7/tilde-limit-gluing).

end Perfectoid.FrobeniusTower

/-! ## PerfectoidSpaces:P7/limit-of-perfectoid-tower (theorem) -/

-- PerfectoidSpace.isTildeLimit_limit_of_affine: not stated here; the limit `X = lim X_i` of a
--   cofiltered system of perfectoid spaces with affinoid transition maps, `X ~ lim X_i` and
--   `|X| ≅ lim |X_i|`, needs perfectoid spaces (supplier: PerfectoidSpaces:P2/perfectoid-space,
--   PerfectoidSpaces:P5/cofiltered-limits-of-affinoid-perfectoid-spaces). Affinoid core (plus
--   rings `R°`): `PerfectoidSpace.isTildeLimit_completedFilteredColimit_affinoid`.

namespace PerfectoidSpace

section PerfectoidTower

variable (p : ℕ) [Fact p.Prime]

/-- P7/limit-of-perfectoid-tower (data): a continuous ring map into a perfectoid (uniform) Tate
ring as a morphism of the Huber pairs `(R, R°) → (S, S°)`. -/
def powerBoundedPairHom_P7 {R S : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
    [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]
    [Perfectoid.IsPerfectoidTateRing p S] (φ : R →+* S) (hφ : Continuous φ) :
    Pair.Hom (Pair.powerBounded R) (Pair.powerBounded S) where
  toRingHom := φ
  continuous_toRingHom := hφ
  map_mem_plus := sorry

/-- P7/limit-of-perfectoid-tower (ii)-(iv), affinoid core: for a filtered diagram of perfectoid
Tate rings `R_j`, P1's completed filtered colimit `R` (the `ϖ`-adic completion of `colim R_j°`,
inverted) satisfies `Spa(R, R°) ~ lim_j Spa(R_j, R_j°)` (ECD Proposition 6.5; BHW proof of
Theorem 5.11). -/
theorem isTildeLimit_completedFilteredColimit_affinoid {J : Type u} [SmallCategory J]
    [IsFiltered J] (F : J ⥤ Perfectoid.PerfectoidRingCat.{u} p) (j₀ : J)
    (ϖ : Perfectoid.PseudoUniformizerRoots p (F.obj j₀)) :
    IsTildeLimit_affinoid (fun j ↦ Pair.powerBounded (F.obj j))
      (fun a ↦ powerBoundedPairHom_P7 p (F.map a).hom (F.map a).continuous_hom)
      (Pair.powerBounded (Perfectoid.completedFilteredColimit p F j₀ ϖ))
      fun j ↦ powerBoundedPairHom_P7 p (Perfectoid.completedFilteredColimit.ι p F j₀ ϖ j)
        (Perfectoid.completedFilteredColimit.ι_spec p F j₀ ϖ j).1 := sorry

end PerfectoidTower

