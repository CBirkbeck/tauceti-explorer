/-! ## PerfectoidSpaces:P5/descent-of-quasicompact-opens (lemma) -/

namespace PerfectoidSpace

open Perfectoid Perfectoid.completedColimit

-- PerfectoidSpace.exists_quasicompactOpen_preimage_eq: not stated here; needs open perfectoid
--   subspaces and the base changes `Y_j` of a qcqs `Y_i → X_i`
--   (supplier: PerfectoidSpaces:P2/fibre-products-of-perfectoid-spaces, AdicSpaces Layer 5).
--   Affinoid core (`Y = X`): `exists_quasicompactOpen_preimage_eq_affinoid`; rational subsets:
--   `Perfectoid.completedColimit.exists_rationalSubset_preimage_eq`.

section Descent

variable {p : ℕ} [Fact p.Prime] {I : Type u} [SmallCategory I] [IsCofiltered I]
  {D : PairDiagram p I} (c : CompatiblePseudouniformizer D)

/-- P5/descent-of-quasicompact-opens (a), (affinoid core): every quasicompact open of
`Spa(R, R⁺)` is `p_i⁻¹(U_i)` for a quasicompact open `U_i` of some `Spa(R_i, R_i⁺)` (ECD proof of
Proposition 6.4 (ii); KL Remark 2.6.7). -/
theorem exists_quasicompactOpen_preimage_eq_affinoid (U : Set (spa (completedColimitPair c).plus))
    (hU : IsOpen U) (hUc : IsCompact U) :
    ∃ (i : I) (Ui : Set (spa (D.pair i).plus)), IsOpen Ui ∧ IsCompact Ui ∧
      (ι c i).spaComap ⁻¹' Ui = U := sorry

/-- P5/descent-of-quasicompact-opens (b), (c), (affinoid core): two quasicompact opens of
`Spa(R_i, R_i⁺)` with the same preimage in `Spa(R, R⁺)` have the same preimage at some finite
stage, and a quasicompact open with open and closed preimage has open and closed preimage at
some finite stage. -/
theorem exists_preimage_eq_affinoid {i : I} (U V : Set (spa (D.pair i).plus))
    (hU : IsOpen U ∧ IsCompact U) (hV : IsOpen V ∧ IsCompact V) :
    ((ι c i).spaComap ⁻¹' U = (ι c i).spaComap ⁻¹' V →
      ∃ (j : I) (a : j ⟶ i), (D.hom a).spaComap ⁻¹' U = (D.hom a).spaComap ⁻¹' V) ∧
    (IsClopen ((ι c i).spaComap ⁻¹' U) →
      ∃ (j : I) (a : j ⟶ i), IsClopen ((D.hom a).spaComap ⁻¹' U)) := sorry

end Descent

