  [CompleteSpace S] [T2Space S] {P : Pair R} {Q : Pair S}

/-- P4/zariski-closed-immersion (structure, affinoid core of `IsZariskiClosedImmersion`; ECD
Definition 5.7 (i)): `Spa(Q) → Spa(P)` is a closed immersion with image `V(I)` ("Zariski closed,
defined by `I`"). -/
structure IsZariskiClosedImmersion_affinoid (φ : Pair.Hom P Q) (I : Ideal R) : Prop where
  /-- `φ` is a closed immersion. -/
  isClosedImmersion : IsClosedImmersion_affinoid p φ
  /-- Its image is `V(I)`. -/
  range_eq : Set.range φ.spaComap = zeroLocus P I

end ZariskiClosedImmersionCore

