namespace PerfectoidSpace

open Perfectoid

section CofilteredLimits

variable (p : ℕ) [Fact p.Prime] {J : Type u} [SmallCategory J] [IsFiltered J]
  (F : J ⥤ PerfectoidRingCat.{u} p) (j₀ : J) (ϖ : PseudoUniformizerRoots p (F.obj j₀))
  {κ : Cardinal.{u}}

/-- P6/kappa-small-cofiltered-limits (a), affinoid core of `isKappaSmall_limit`: for a cofiltered
system `X_i = Spa(R_i, R_i⁺)` (a filtered diagram `F` of perfectoid Tate rings) with
`#Mor(I) ≤ μ` and `#R_i ≤ μ`, `μ < κ`, the limit `Spa(R, R⁺)`, `R` the completed filtered colimit
of stage P1, is uniformly κ-small, whatever `R⁺` (ECD Proposition 6.4; the ring bound
`#R ≤ μ^ℵ₀` is PerfectoidSpaces:P5/limit-cardinal-bounds). -/
theorem IsUniformlyKappaSmall.completedFilteredColimit_affinoid (hκ : κ.IsStrongLimit)
    (hκ₀ : ℵ₀ < κ) {μ : Cardinal.{u}} (hμ : μ < κ) (hJ : #(Σ i j : J, i ⟶ j) ≤ μ)
    (hF : ∀ j, #(F.obj j) ≤ μ) (P : Pair (completedFilteredColimit p F j₀ ϖ)) :
    IsUniformlyKappaSmall_affinoid κ P := sorry

