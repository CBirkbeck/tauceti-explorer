/-! # Stage P5. Cofiltered limits of affinoid perfectoid spaces and finite-stage descent

The ring-level half of layer P5 is stated in full; the geometric half needs perfectoid *spaces*,
which are not in Tau Ceti, and is given as not-stated comments, each with its ring-level or
topological core where one exists.

* **The standing setting.** A cofiltered diagram `X_i = Spa(R_i, R_i⁺)` of affinoid perfectoid
  spaces is given at ring level by `Perfectoid.completedColimit.PairDiagram p I`: a functor
  `Iᵒᵖ ⥤ PerfectoidRingCat p` (stage P1's category of perfectoid Tate rings) with rings of
  integral elements `R_i⁺` preserved by the transition maps. It stands in for a functor
  `Iᵒᵖ ⥤ CAff` into complete Huber pairs (AdicEtaleGeometry:A1/huber-pair-rational-site). A
  compatible pseudouniformiser `(i₀, ϖ)` is `completedColimit.CompatiblePseudouniformizer D`.
* **The completed direct limit.** `Perfectoid.completedColimit c = R⁺[1/ϖ]`, where
  `R⁺ = completedColimitPlus c` is the image of the `ϖ`-adic completion (Mathlib
  `AdicCompletion`) of `A = colim R_i⁺` (Mathlib's colimit in `CommRingCat`). It refines stage
  P1's `completedFilteredColimit` (built on the `R_i°`) by the plus rings; the comparison is
  `completedColimit.equivCompletedFilteredColimit`. The Huber pair is `completedColimitPair c`,
  with maps `completedColimit.ι c i` and universal property `completedColimit.lift`.
* **Adic spectra.** `Spa(R, R⁺) ≃ₜ lim Spa(R_i, R_i⁺)` is
  `PerfectoidSpace.cofilteredLimit.homeomorph_affinoid`, the limit being Mathlib's
  `TopCat.limitCone` of `PairDiagram.spaFunctor`; descent of quasicompact opens is stated for
  cofiltered limits of spectral spaces (`TauCeti.SpectralSpace.*`) and for `Spa(R, R⁺)`.
* **Filtered 2-colimits of categories.** `CategoryTheory.FilteredTwoColimit F` of a pseudofunctor
  `F : LocallyDiscrete J ⥤ᵖ Cat` is the localisation of Mathlib's Grothendieck construction `∫ F`
  at its cocartesian morphisms; its hom-sets are filtered colimits (`homEquiv`), and pseudo-cocones
  `FilteredTwoColimit.PseudoCocone` induce functors out of it (`desc`).
* **Finite-stage descent (ECD 6.4 (i)–(iii)).** The geometric statements are comments naming
  their suppliers; the ring form of (i), `2-colim_i FÉt(R_i) ≃ FÉt(R)`, is
  `PerfectoidSpace.isEquivalence_etaleComparison_finiteEtale_ring`.

Sources: ECD = Scholze, *Étale cohomology of diamonds*; Sch12 = Scholze, *Perfectoid spaces*;
Berkeley = Scholze–Weinstein, *Berkeley lectures*; KL = Kedlaya–Liu, *Relative p-adic Hodge
theory* I; Bhatt = Bhatt, *Lecture notes on perfectoid spaces*; Wedhorn = Wedhorn, *Adic spaces*;
Stacks = The Stacks Project. -/

noncomputable section

namespace TauCeti

universe u

open Topology Filter CategoryTheory CategoryTheory.Limits Opposite
open Huber ValuationSpectrum

/-! ## PerfectoidSpaces:P5/compatible-pseudouniformizer (lemma) -/

namespace Perfectoid

section StandingSetting

variable (p : ℕ) [Fact p.Prime]

/-- P5/compatible-pseudouniformizer (structure): the standing setting of layer P5 at ring level
(ECD Proposition 6.4): a cofiltered diagram `X_i = Spa(R_i, R_i⁺)` of affinoid perfectoid spaces,
given by an `Iᵒᵖ`-indexed diagram `i ↦ R_i` of perfectoid Tate rings (stage P1's
`PerfectoidRingCat`, continuous ring maps) together with rings of integral elements `R_i⁺` that
the transition maps preserve. It stands in for a functor `Iᵒᵖ ⥤ CAff` into complete Huber pairs
(AdicEtaleGeometry:A1/huber-pair-rational-site). No injectivity, flatness or density is
assumed. -/
structure completedColimit.PairDiagram (I : Type u) [SmallCategory I] where
  /-- The perfectoid Tate rings `R_i`, contravariant in `i`. -/
  ring : Iᵒᵖ ⥤ PerfectoidRingCat.{u} p
  /-- The rings of integral elements `R_i⁺`. -/
  pair : ∀ i : I, Pair (ring.obj (op i))
  /-- The transition map `φ_a : R_i → R_j` of `a : j ⟶ i` carries `R_i⁺` into `R_j⁺`. -/
  map_mem_plus : ∀ {i j : I} (a : j ⟶ i), ∀ x ∈ (pair i).plus,
    (ring.map a.op).hom x ∈ (pair j).plus

namespace completedColimit.PairDiagram

variable {p} {I : Type u} [SmallCategory I] (D : PairDiagram p I)

/-- P5/compatible-pseudouniformizer (data): the transition map `φ_a : (R_i, R_i⁺) → (R_j, R_j⁺)`
of `a : j ⟶ i` as a morphism of Huber pairs (Tau Ceti `Huber.Pair.Hom`). -/
def hom {i j : I} (a : j ⟶ i) : Pair.Hom (D.pair i) (D.pair j) where
  toRingHom := (D.ring.map a.op).hom
  continuous_toRingHom := (D.ring.map a.op).continuous_hom
  map_mem_plus := D.map_mem_plus a

/-- P5/compatible-pseudouniformizer (data): the diagram `i ↦ R_i⁺` of plus rings in
`CommRingCat`, whose colimit is the ring `A = colim R_i⁺` of ECD Proposition 6.4. -/
def plusFunctor : Iᵒᵖ ⥤ CommRingCat.{u} where
  obj i := CommRingCat.of (D.pair i.unop).plus
  map a := CommRingCat.ofHom ((D.hom a.unop).toRingHom.restrict _ _ (D.hom a.unop).map_mem_plus)
  map_id := sorry
  map_comp := sorry

/-- P5/compatible-pseudouniformizer (data): the diagram `i ↦ R_i` of rings in `CommRingCat`. -/
def ringFunctor : Iᵒᵖ ⥤ CommRingCat.{u} where
  obj i := CommRingCat.of (D.ring.obj i)
  map a := CommRingCat.ofHom (D.ring.map a).hom
  map_id := sorry
  map_comp := sorry

/-- P5/compatible-pseudouniformizer (data): restriction of the diagram along a functor
`F : I' ⥤ I`, for instance along the tail `Over.forget i₀ : Over i₀ ⥤ I` (initial in a cofiltered
`I`: Mathlib `Over.initial_forget`). -/
def restrict {I' : Type u} [SmallCategory I'] (F : I' ⥤ I) : PairDiagram p I' where
  ring := F.op ⋙ D.ring
  pair i := D.pair (F.obj i)
  map_mem_plus a := D.map_mem_plus (F.map a)

/-- P5/compatible-pseudouniformizer (data): the diagram `i ↦ Spa(R_i, R_i⁺)` of topological
spaces, with transition maps Tau Ceti's `Huber.Pair.Hom.spaComap`. -/
def spaFunctor : I ⥤ TopCat.{u} where
  obj i := TopCat.of (spa (D.pair i).plus)
  map a := TopCat.ofHom ⟨(D.hom a).spaComap, (D.hom a).continuous_spaComap⟩
  map_id := sorry
  map_comp := sorry

end completedColimit.PairDiagram

namespace completedColimit

variable {p} {I : Type u} [SmallCategory I] [IsCofiltered I] (D : PairDiagram p I)

/-- P5/compatible-pseudouniformizer (data): the ring `A = colim_{i ∈ Iᵒᵖ} R_i⁺`, a filtered
colimit of rings (Mathlib's colimit in `CommRingCat`). -/
abbrev plusColimit : CommRingCat.{u} := colimit D.plusFunctor

/-- P5/compatible-pseudouniformizer (structure): a *compatible pseudouniformiser* `(i₀, ϖ)`
(ECD Proposition 6.4: "any compatible choice of pseudouniformizers for large i"; ECD Lemma 3.10):
an object `i₀` of `I` and a pseudo-uniformizer `ϖ ∈ R_{i₀}⁺` with compatible `p`-power roots
`ϖ^{1/pⁿ} ∈ R_{i₀}⁺` (stage P1's `PseudoUniformizerRoots`) and `ϖ ^ p ∣ p` in `R_{i₀}⁺`. -/
structure CompatiblePseudouniformizer where
  /-- The object `i₀`. -/
  base : I
  /-- The pseudo-uniformizer `ϖ` with its compatible system `(ϖ^{1/pⁿ})ₙ` of `p`-power roots. -/
  roots : PseudoUniformizerRoots p (D.ring.obj (op base))
  /-- Every `ϖ^{1/pⁿ}` lies in `R_{i₀}⁺`. -/
  root_mem_plus : ∀ n, roots.root n ∈ (D.pair base).plus
  /-- `ϖ ^ p ∣ p` in `R_{i₀}⁺`. -/
  pow_dvd_p_plus :
    (⟨roots.root 0, root_mem_plus 0⟩ : (D.pair base).plus) ^ p ∣ (p : (D.pair base).plus)

namespace CompatiblePseudouniformizer

variable {D} (c : CompatiblePseudouniformizer D)

/-- P5/compatible-pseudouniformizer (data): the pseudo-uniformizer `ϖ ∈ R_{i₀}`. -/
def varpi : D.ring.obj (op c.base) := c.roots.root 0

/-- P5/compatible-pseudouniformizer (data): `ϖ` as an element of `R_{i₀}⁺`. -/
def varpiPlus : (D.pair c.base).plus := ⟨c.varpi, c.root_mem_plus 0⟩

/-- P5/compatible-pseudouniformizer (data): the image of `ϖ` in `A = colim R_i⁺`. -/
def varpiColim : plusColimit D := (colimit.ι D.plusFunctor (op c.base)).hom c.varpiPlus

/-- P5/compatible-pseudouniformizer (b) (data): for `a : j ⟶ i₀`, `(j, φ_a(ϖ))` with the roots
`φ_a(ϖ^{1/pⁿ})` is again a compatible pseudouniformiser: `φ_a(ϖ)` is a pseudo-uniformizer of
`R_j` (stage P1's `PseudoUniformizerRoots.map`), and `φ_a(ϖ) ^ p ∣ p` in `R_j⁺`. -/
def pullback {j : I} (a : j ⟶ c.base) : CompatiblePseudouniformizer D where
  base := j
  roots := c.roots.map p (D.ring.map a.op).hom (D.ring.map a.op).continuous_hom
  root_mem_plus := sorry
  pow_dvd_p_plus := sorry

/-- P5/compatible-pseudouniformizer (b): the pseudo-uniformizer of `c.pullback a` is `φ_a(ϖ)`. -/
theorem pullback_varpi {j : I} (a : j ⟶ c.base) :
    (c.pullback a).varpi = (D.hom a).toRingHom c.varpi := sorry

/-- P5/compatible-pseudouniformizer: for parallel `a, b : j ⇉ i₀` the elements `φ_a(ϖ)`,
`φ_b(ϖ)` of `R_j` need not agree, but they have the same image in `A = colim R_i⁺`, namely the
image of `ϖ`: the only place where compatibility is used (ECD Proposition 6.4). -/
theorem varpiColim_pullback {j : I} (a : j ⟶ c.base) :
    (c.pullback a).varpiColim = c.varpiColim := sorry

end CompatiblePseudouniformizer

/-- P5/compatible-pseudouniformizer (a): every object `i₀` carries a compatible
pseudouniformiser (ECD Lemma 3.10 for the pseudo-uniformizer and its roots in `R_{i₀}°`; ECD
Example 3.22 (ii) for membership in `R_{i₀}⁺`). -/
theorem exists_compatiblePseudouniformizer (i₀ : I) :
    ∃ c : CompatiblePseudouniformizer D, c.base = i₀ := sorry

end completedColimit

end StandingSetting

end Perfectoid

/-! ## PerfectoidSpaces:P5/completion-preserves-integral-closedness (lemma) -/

namespace AdicCompletion

variable {A : Type u} [CommRing A] (ϖ : A)

/-- P5/completion-preserves-integral-closedness (a): `ϖ` is a nonzerodivisor on the `ϖ`-adic
completion `Â` of a ring on which it is a nonzerodivisor (Bhatt Lemma 5.1.1; Stacks Tag 05GG).
The completeness of `Â` itself is Mathlib's `AdicCompletion.isAdicComplete`. -/
theorem mem_nonZeroDivisors_algebraMap (hϖ : ϖ ∈ nonZeroDivisors A) :
    algebraMap A (AdicCompletion (Ideal.span {ϖ}) A) ϖ ∈
      nonZeroDivisors (AdicCompletion (Ideal.span {ϖ}) A) := sorry

/-- P5/completion-preserves-integral-closedness (a): `A/ϖⁿA ≅ Â/ϖⁿÂ` for every `n`, induced by
`A → Â` (Stacks Tag 05GG). -/
theorem bijective_quotientMap_span_pow (n : ℕ) :
    Function.Bijective (Ideal.quotientMap
      ((Ideal.span {ϖ ^ n}).map (algebraMap A (AdicCompletion (Ideal.span {ϖ}) A)))
      (algebraMap A (AdicCompletion (Ideal.span {ϖ}) A)) Ideal.le_comap_map) := sorry

/-- P5/completion-preserves-integral-closedness (b): the kernel of `A → Â` is
`J = ⋂ₙ ϖⁿA`, and `J = ϖJ` (Bhatt proof of Lemma 5.1.1). -/
theorem ker_algebraMap_eq_iInf_span_pow :
    RingHom.ker (algebraMap A (AdicCompletion (Ideal.span {ϖ}) A)) =
      ⨅ n : ℕ, Ideal.span {ϖ ^ n} ∧
    (⨅ n : ℕ, Ideal.span {ϖ ^ n}) = Ideal.span {ϖ} * ⨅ n : ℕ, Ideal.span {ϖ ^ n} := sorry

/-- P5/completion-preserves-integral-closedness (c): if `ϖ` is a nonzerodivisor and `A` is
integrally closed in `A[1/ϖ]`, then `Â` is integrally closed in `Â[1/ϖ]` (Bhatt Lemma 5.1.2). No
noetherian or separatedness hypothesis on `A`. -/
theorem isIntegrallyClosedIn_away (hϖ : ϖ ∈ nonZeroDivisors A)
    (hA : IsIntegrallyClosedIn A (Localization.Away ϖ)) :
    IsIntegrallyClosedIn (AdicCompletion (Ideal.span {ϖ}) A)
      (Localization.Away (algebraMap A (AdicCompletion (Ideal.span {ϖ}) A) ϖ)) := sorry

/-- P5/completion-preserves-integral-closedness (d): `p`-root closedness of `A` in `A[1/ϖ]`
passes to `Â` in `Â[1/ϖ]` (Bhatt proof of Lemma 5.1.1). -/
theorem pRootClosed_away (p : ℕ) (hϖ : ϖ ∈ nonZeroDivisors A)
    (hA : ∀ g : Localization.Away ϖ, g ^ p ∈ Set.range (algebraMap A (Localization.Away ϖ)) →
      g ∈ Set.range (algebraMap A (Localization.Away ϖ))) :
    ∀ g : Localization.Away (algebraMap A (AdicCompletion (Ideal.span {ϖ}) A) ϖ),
      g ^ p ∈ Set.range (algebraMap (AdicCompletion (Ideal.span {ϖ}) A) _) →
        g ∈ Set.range (algebraMap (AdicCompletion (Ideal.span {ϖ}) A) _) := sorry

/-- P5/completion-preserves-integral-closedness (e): the image of `A` is `ϖ`-adically dense in
`Â` (hence the image of `A[1/ϖ]` is dense in `Â[1/ϖ]` with `Â` open and `ϖ`-adic). -/
theorem exists_sub_algebraMap_mem_span_pow (x : AdicCompletion (Ideal.span {ϖ}) A) (n : ℕ) :
    ∃ a : A, x - algebraMap A _ a ∈
      Ideal.span {algebraMap A (AdicCompletion (Ideal.span {ϖ}) A) ϖ ^ n} := sorry

end AdicCompletion

/-! ## PerfectoidSpaces:P5/completed-colimit-of-perfectoid-pairs (construction) -/

namespace Perfectoid

open completedColimit

section CompletedColimit

variable {p : ℕ} [Fact p.Prime] {I : Type u} [SmallCategory I] [IsCofiltered I]
  {D : PairDiagram p I} (c : CompatiblePseudouniformizer D)

namespace completedColimit

/-- P5/completed-colimit-of-perfectoid-pairs (data): `Â`, the `ϖ`-adic completion of
`A = colim R_i⁺` (Mathlib `AdicCompletion` of the `CommRingCat` colimit). -/
abbrev integral : Type u := AdicCompletion (Ideal.span {c.varpiColim}) (plusColimit D)

end completedColimit

/-- P5/completed-colimit-of-perfectoid-pairs (data): the completed direct limit `R = R⁺[1/ϖ]` of
the system `(R_i, R_i⁺)`, where `R⁺` is the `ϖ`-adic completion of `A = colim R_i⁺`, topologised
so that `R⁺` is an open subring with its `ϖ`-adic topology (ECD Proposition 6.4; Sch12 proof of
Lemma 6.13 (i); KL Definition 2.6.1). It is a completion of the uncompleted colimit of the plus
rings, never of `colim R_i` for another topology. -/
def completedColimit : Type u :=
  Localization.Away (algebraMap (plusColimit D) (integral c) c.varpiColim)

namespace completedColimit

/-- P5/completed-colimit-of-perfectoid-pairs (instance): the ring structure. -/
instance instCommRing : CommRing (completedColimit c) :=
  inferInstanceAs (CommRing (Localization.Away _))

/-- P5/completed-colimit-of-perfectoid-pairs (instance): `R` is an `Â`-algebra. -/
instance instAlgebra : Algebra (integral c) (completedColimit c) :=
  inferInstanceAs (Algebra _ (Localization.Away _))

/-- P5/completed-colimit-of-perfectoid-pairs (instance): the uniformity in which `R⁺` is open
with its `ϖ`-adic uniformity. -/
instance instUniformSpace : UniformSpace (completedColimit c) := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (instance). -/
instance instIsUniformAddGroup : IsUniformAddGroup (completedColimit c) := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (instance). -/
instance instIsTopologicalRing : IsTopologicalRing (completedColimit c) := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (instance): `R` is a Tate ring with pair of
definition `(R⁺, ϖR⁺)` and pseudo-uniformizer `ϖ`. -/
instance instIsTateRing : IsTateRing (completedColimit c) := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (instance): `R` is complete. -/
instance instCompleteSpace : CompleteSpace (completedColimit c) := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (instance): `R` is Hausdorff. -/
instance instT2Space : T2Space (completedColimit c) := sorry

end completedColimit

/-- P5/completed-colimit-of-perfectoid-pairs (data): `R⁺`, the image of `Â` in `R = Â[1/ϖ]` (an
isomorphic copy of `Â`, as `ϖ` is a nonzerodivisor on `Â`), an open subring of `R`. -/
def completedColimitPlus : Subring (completedColimit c) :=
  (algebraMap (integral c) (completedColimit c)).range

namespace completedColimit

/-- P5/completed-colimit-of-perfectoid-pairs (data): `ϖ` as an element of `R⁺`. -/
def varpiPlus : completedColimitPlus c :=
  ⟨algebraMap (integral c) (completedColimit c) (algebraMap _ (integral c) c.varpiColim),
    RingHom.mem_range_self _ _⟩

/-- P5/completed-colimit-of-perfectoid-pairs: `Â → R⁺` is injective, so `R⁺ ≅ Â`
(P5/completion-preserves-integral-closedness (a)). -/
theorem injective_algebraMap_integral :
    Function.Injective (algebraMap (integral c) (completedColimit c)) := sorry

end completedColimit

/-- P5/completed-colimit-of-perfectoid-pairs (structure): `(R, R⁺)` as a Tau Ceti Huber pair:
`R⁺` is open, integrally closed in `R` and power-bounded (P5/completed-colimit-is-perfectoid
(a)). -/
def completedColimitPair : Pair (completedColimit c) where
  plus := completedColimitPlus c
  isRingOfIntegralElements := sorry

namespace completedColimit

/-- P5/completed-colimit-of-perfectoid-pairs (projection): the morphism of Huber pairs
`ι_i : (R_i, R_i⁺) → (R, R⁺)`. For `i` in the tail it is `R_i = R_i⁺[1/φ_a(ϖ)] → R⁺[1/ϖ]`; for
general `i` it factors through any `j ⟶ i, i₀`. -/
def ι (i : I) : Pair.Hom (D.pair i) (completedColimitPair c) := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (functoriality): `ι_j ∘ φ_a = ι_i` for `a : j ⟶ i`. -/
theorem ι_comp {i j : I} (a : j ⟶ i) : (ι c j).comp (D.hom a) = ι c i := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (universal-property): a compatible family of
morphisms of pairs `ψ_i : (R_i, R_i⁺) → (S, S⁺)` into a complete Tate pair with `S⁺` bounded
(for instance `S` uniform) induces `ψ : (R, R⁺) → (S, S⁺)` (ECD proof of Proposition 6.5). -/
def lift {S : Type*} [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S]
    [IsTateRing S] [CompleteSpace S] [T2Space S] (P : Pair S) (hP : IsBounded (P.plus : Set S))
    (ψ : ∀ i, Pair.Hom (D.pair i) P) (hψ : ∀ {i j : I} (a : j ⟶ i), (ψ j).comp (D.hom a) = ψ i) :
    Pair.Hom (completedColimitPair c) P := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (simp): `lift ψ ∘ ι_i = ψ_i`. -/
@[simp] theorem lift_comp_ι {S : Type*} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
    [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S] (P : Pair S)
    (hP : IsBounded (P.plus : Set S)) (ψ : ∀ i, Pair.Hom (D.pair i) P)
    (hψ : ∀ {i j : I} (a : j ⟶ i), (ψ j).comp (D.hom a) = ψ i) (i : I) :
    (lift c P hP ψ hψ).comp (ι c i) = ψ i := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (extensionality): two morphisms `(R, R⁺) → (S, S⁺)`
into a Hausdorff Huber pair that agree after every `ι_i` are equal (the `ι_i(R_i)` are dense). -/
theorem hom_ext {S : Type*} [CommRing S] [TopologicalSpace S] [IsTopologicalRing S]
    [IsHuberRing S] [T2Space S] {P : Pair S} {f g : Pair.Hom (completedColimitPair c) P}
    (h : ∀ i, f.comp (ι c i) = g.comp (ι c i)) : f = g := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (characterisation): `R⁺/ϖⁿR⁺ ≅ A/ϖⁿA`, and
`A/ϖⁿA = colim_i R_i⁺/ϖⁿR_i⁺` (filtered colimits commute with quotients). -/
def plusQuotientEquiv (n : ℕ) :
    (completedColimitPlus c ⧸ Ideal.span {varpiPlus c ^ n}) ≃+*
      (plusColimit D ⧸ Ideal.span {c.varpiColim ^ n}) := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (characterisation): `plusQuotientEquiv` is
compatible with the `ι_i`. -/
theorem plusQuotientEquiv_ι (n : ℕ) (i : I) (x : (D.pair i).plus) :
    plusQuotientEquiv c n (Ideal.Quotient.mk _ ⟨(ι c i).toRingHom x, (ι c i).map_mem_plus _ x.2⟩) =
      Ideal.Quotient.mk _ ((colimit.ι D.plusFunctor (op i)).hom x) := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (other): the union of the `ι_i(R_i)` is dense in
`R`, and the union of the `ι_i(R_i⁺)` is dense in `R⁺`. -/
theorem denseRange_ι :
    Dense (⋃ i, Set.range (ι c i).toRingHom) ∧
      (completedColimitPlus c : Set (completedColimit c)) ⊆
        closure (⋃ i, (ι c i).toRingHom '' (D.pair i).plus) := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (instance): `R` is a perfectoid Tate ring
(P5/completed-colimit-is-perfectoid (d)). -/
instance isPerfectoidTateRing : IsPerfectoidTateRing p (completedColimit c) := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (equivalence): restricting the system along an
initial functor `F : I' ⥤ I` (for instance a tail `Over.forget i₁`), with any compatible
pseudouniformiser of the restriction, gives a canonically isomorphic ring, compatibly with the
`ι` (P5/limit-independence-of-tail-and-choice (b)). -/
def equivOfInitial {I' : Type u} [SmallCategory I'] [IsCofiltered I'] (F : I' ⥤ I) [F.Initial]
    (c' : CompatiblePseudouniformizer (D.restrict F)) :
    completedColimit c' ≃+* completedColimit c := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (equivalence): `equivOfInitial` is a homeomorphism
carrying `R⁺` onto `R⁺` and `ι_{i'}` of the restricted system to `ι_{F i'}`. -/
theorem equivOfInitial_spec {I' : Type u} [SmallCategory I'] [IsCofiltered I'] (F : I' ⥤ I)
    [F.Initial] (c' : CompatiblePseudouniformizer (D.restrict F)) :
    Continuous (equivOfInitial c F c') ∧ Continuous (equivOfInitial c F c').symm ∧
      (completedColimitPlus c').map (equivOfInitial c F c' : _ →+* _) = completedColimitPlus c ∧
      ∀ (i' : I') (x : D.ring.obj (op (F.obj i'))),
        equivOfInitial c F c' ((ι c' i').toRingHom x) = (ι c (F.obj i')).toRingHom x := sorry

/-- P5/completed-colimit-of-perfectoid-pairs (instance): `ℵ₁` is regular (Mathlib
`Cardinal.isRegular_aleph_one`), as a `Fact` for `IsCardinalFiltered`. -/
instance fact_isRegular_aleph_one : Fact (Cardinal.aleph.{u} 1).IsRegular :=
  ⟨Cardinal.isRegular_aleph_one⟩

/-- P5/completed-colimit-of-perfectoid-pairs (characterisation): for `Iᵒᵖ` `ℵ₁`-filtered the
canonical map `colim R_i⁺ → Â ≅ R⁺` is a ring isomorphism: no completion is needed; the
statement for `colim R_i → R` is `bijective_of_isCardinalFiltered`
(P5/omega1-cofiltered-uncompleted-colimit). -/
def colimitEquiv_of_isCardinalFiltered [IsCardinalFiltered Iᵒᵖ (Cardinal.aleph.{u} 1)] :
    plusColimit D ≃+* integral c :=
  RingEquiv.ofBijective (algebraMap (plusColimit D) (integral c)) sorry

/-- P5/completed-colimit-of-perfectoid-pairs (data): the uncompleted colimit `colim R_i` of the
rings (Mathlib's colimit in `CommRingCat`). -/
abbrev ringColimit (D : PairDiagram p I) : CommRingCat.{u} := colimit D.ringFunctor

/-- P5/completed-colimit-of-perfectoid-pairs (data): the canonical map `colim R_i → R` induced by
the `ι_i`. -/
def fromColimit : ringColimit D →+* completedColimit c :=
  (colimit.desc D.ringFunctor ⟨CommRingCat.of (completedColimit c),
    { app := fun i ↦ CommRingCat.ofHom (ι c i.unop).toRingHom
      naturality := sorry }⟩).hom

end completedColimit

end CompletedColimit

section CompletedColimitTests

open completedColimit

variable {p : ℕ} [Fact p.Prime] {I : Type u} [SmallCategory I] [IsCofiltered I]
  {D : PairDiagram p I}

-- test completedColimit_test_initial (degenerate) [P5/completed-colimit-of-perfectoid-pairs]
example (c : CompatiblePseudouniformizer D) (i : I) (hi : IsInitial i) :
    ∃ e : D.ring.obj (op i) ≃ₜ completedColimit c, ⇑e = (ι c i).toRingHom ∧
      (D.pair i).plus.map (ι c i).toRingHom = completedColimitPlus c := sorry

/- The profinite example: `S = ℕ → Bool = lim_n {0,1}ⁿ`, `R_i = K^{S_i}`, `R_i⁺ = 𝒪_K^{S_i}` over
a perfectoid field `K`, given through compatible injective maps `e_i : R_i → C(S, K)` whose images
exhaust the locally constant functions, with `R_i⁺` the functions bounded by `1`. -/
-- test completedColimit_test_profinite (computation) [P5/completed-colimit-of-perfectoid-pairs]
example (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [IsPerfectoidField p K] (c : CompatiblePseudouniformizer D) (ϖ : K)
    (hϖ : IsPseudoUniformizer ϖ) (e : ∀ i, D.ring.obj (op i) →+* C(ℕ → Bool, K))
    (he : ∀ {i j : I} (a : j ⟶ i), (e j).comp (D.hom a).toRingHom = e i)
    (hinj : ∀ i, Function.Injective (e i))
    (hlc : ⋃ i, Set.range (e i) = {f : C(ℕ → Bool, K) | IsLocallyConstant ⇑f})
    (hplus : ∀ i x, x ∈ (D.pair i).plus ↔ ∀ s, ‖e i x s‖ ≤ 1) :
    ∃ E : completedColimit c ≃+* C(ℕ → Bool, K), (∀ i x, E ((ι c i).toRingHom x) = e i x) ∧
      (∀ f, f ∈ completedColimitPlus c ↔ ∀ s, ‖E f s‖ ≤ 1) ∧
      ∃ f : C(ℕ → Bool, K), (∀ s, f s = ∑' k, if s k then ϖ ^ k else 0) ∧
        E.symm f ∈ completedColimitPlus c ∧
        ∀ i, E.symm f ∉ (ι c i).toRingHom '' (D.pair i).plus := sorry

/- In the profinite example, `R⁺/ϖⁿ = C⁰(S, 𝒪_K/ϖⁿ)` is the ring of locally constant functions
`S → 𝒪_K/ϖⁿ`, i.e. `colim_i (𝒪_K/ϖⁿ)^{S_i}`; here `ϖ` corresponds to the constant function. -/
-- test completedColimit_test_plusQuotient (characterisation)
--   [P5/completed-colimit-of-perfectoid-pairs]
example (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [IsPerfectoidField p K] (c : CompatiblePseudouniformizer D) (ϖ : powerBoundedSubring K)
    (hϖ : IsPseudoUniformizer (ϖ : K)) (e : ∀ i, D.ring.obj (op i) →+* C(ℕ → Bool, K))
    (he : ∀ {i j : I} (a : j ⟶ i), (e j).comp (D.hom a).toRingHom = e i)
    (hinj : ∀ i, Function.Injective (e i))
    (hlc : ⋃ i, Set.range (e i) = {f : C(ℕ → Bool, K) | IsLocallyConstant ⇑f})
    (hplus : ∀ i x, x ∈ (D.pair i).plus ↔ ∀ s, ‖e i x s‖ ≤ 1)
    (hc : e c.base c.varpi = ContinuousMap.const _ (ϖ : K)) (n : ℕ) :
    Nonempty ((completedColimitPlus c ⧸ Ideal.span {varpiPlus c ^ n}) ≃+*
      LocallyConstant (ℕ → Bool) (powerBoundedSubring K ⧸ Ideal.span {ϖ ^ n})) := sorry

/- In the profinite example the uncompleted colimit `colim R_i = LC(S, K)` is not all of
`R = C⁰(S, K)`: with the `ϖ`-adic topology on `LC(S, 𝒪_K)` it is not complete. -/
-- test completedColimit_test_uncompleted (non-example) [P5/completed-colimit-of-perfectoid-pairs]
example (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [IsPerfectoidField p K] (c : CompatiblePseudouniformizer D)
    (e : ∀ i, D.ring.obj (op i) →+* C(ℕ → Bool, K))
    (he : ∀ {i j : I} (a : j ⟶ i), (e j).comp (D.hom a).toRingHom = e i)
    (hinj : ∀ i, Function.Injective (e i))
    (hlc : ⋃ i, Set.range (e i) = {f : C(ℕ → Bool, K) | IsLocallyConstant ⇑f}) :
    ¬ Function.Surjective (fromColimit c) := sorry

/- For perfectoid affinoid algebras with `R_i⁺ = R_i°` the completed direct limit is that of
Sch12 Lemma 6.13, which is stage P1's `completedFilteredColimit` (Bhatt Remark 6.2.9); its ring
of definition is `R⁺`. -/
-- test completedColimit_test_compatibility_sch12 (compatibility)
--   [P5/completed-colimit-of-perfectoid-pairs]
example (c : CompatiblePseudouniformizer D)
    (hD : ∀ i, D.pair i = Pair.powerBounded (D.ring.obj (op i))) :
    ∃ e : completedColimit c ≃+* completedFilteredColimit p D.ring (op c.base) c.roots,
      Continuous e ∧ Continuous e.symm ∧
      (completedColimitPlus c).map (e : completedColimit c →+* _) =
        completedFilteredColimit.ringOfDefinition p D.ring (op c.base) c.roots ∧
      ∀ i x, e ((ι c i).toRingHom x) =
        completedFilteredColimit.ι p D.ring (op c.base) c.roots (op i) x := sorry

/- `R_n = K⟨T^{1/p^∞}⟩` with transition maps `T^{1/pᵐ} ↦ ϖ^{1/pᵐ} T^{1/pᵐ}`: `T ∈ R_0⁺` is
divisible by every power of `ϖ` in `colim R_n⁺`, so `ι_0(T) = 0` although `T ≠ 0`: the `ι_i`
need not be injective. Stated for an element with this divisibility. -/
-- test completedColimit_test_not_injective (non-example)
--   [P5/completed-colimit-of-perfectoid-pairs]
example (c : CompatiblePseudouniformizer D) (i : I) (t : D.ring.obj (op i))
    (ht : t ∈ (D.pair i).plus) (ht0 : t ≠ 0)
    (hdiv : ∀ n : ℕ, ∃ (j : I) (a : j ⟶ i) (b : j ⟶ c.base), ∃ y ∈ (D.pair j).plus,
      (D.hom a).toRingHom t = (D.hom b).toRingHom c.varpi ^ n * y) :
    (ι c i).toRingHom t = 0 ∧ ¬ Function.Injective (ι c i).toRingHom := sorry

end CompletedColimitTests

/-! ## PerfectoidSpaces:P5/completed-colimit-is-perfectoid (theorem) -/

section IsPerfectoid

open completedColimit

variable {p : ℕ} [Fact p.Prime] {I : Type u} [SmallCategory I] [IsCofiltered I]
  {D : PairDiagram p I} (c : CompatiblePseudouniformizer D)

/-- P5/completed-colimit-is-perfectoid (a): `R⁺` is a ring of integral elements of `R`, bounded,
with `ϖR° ⊆ R⁺ ⊆ R°` (Sch12 proof of Lemma 6.13 (i); Bhatt Lemma 5.1.2 through
P5/completion-preserves-integral-closedness). -/
theorem completedColimit.isRingOfIntegralElements_plus :
    IsRingOfIntegralElements (completedColimitPlus c) ∧
      IsBounded (completedColimitPlus c : Set (completedColimit c)) ∧
      ∀ x ∈ powerBoundedSubring (completedColimit c),
        (varpiPlus c : completedColimit c) * x ∈ completedColimitPlus c := sorry

/-- P5/completed-colimit-is-perfectoid (b): `R` is uniform. -/
theorem completedColimit.isBounded_powerBoundedSubring :
    IsBounded (powerBoundedSubring (completedColimit c) : Set (completedColimit c)) := sorry

/-- P5/completed-colimit-is-perfectoid (c): `ϖ ^ p ∣ p` in `R⁺`, `ϖ` is a nonzerodivisor on `R⁺`,
and Frobenius `R⁺/ϖ → R⁺/ϖ^p` is bijective: `R⁺` is integral perfectoid (BMS1 Definition 3.5;
ECD Lemma 3.10). -/
theorem completedColimit.frobenius_bijective_plus :
    ∃ h : varpiPlus c ^ p ∣ (p : completedColimitPlus c),
      varpiPlus c ∈ nonZeroDivisors (completedColimitPlus c) ∧
        Function.Bijective (frobeniusModPow p (varpiPlus c) h) := sorry

/-- P5/completed-colimit-is-perfectoid (d) (data): `R` is stage P1's completed filtered colimit
(P1/completed-colimit-of-perfectoid-tate-rings) of `i ↦ R_i` with the pseudo-uniformizer `ϖ`:
the completions of `colim R_i⁺` and of `colim R_i°` agree after inverting `ϖ`. -/
def completedColimit.equivCompletedFilteredColimit :
    completedColimit c ≃+* completedFilteredColimit p D.ring (op c.base) c.roots := sorry

/-- P5/completed-colimit-is-perfectoid (d): the comparison is a homeomorphism compatible with the
`ι_i`; hence `R` is perfectoid (P1), `(R, R⁺)` is a perfectoid pair, and `R♭` is the completed
direct limit of the `R_i♭` (P1 `completedFilteredColimit.tiltEquiv`). -/
theorem completedColimit.equivCompletedFilteredColimit_spec
    (ϖ' : PseudoUniformizerRoots p ((D.ring ⋙ tiltFunctor p).obj (op c.base))) :
    Continuous (equivCompletedFilteredColimit c) ∧
      Continuous (equivCompletedFilteredColimit c).symm ∧
      (∀ i x, equivCompletedFilteredColimit c ((ι c i).toRingHom x) =
        completedFilteredColimit.ι p D.ring (op c.base) c.roots (op i) x) ∧
      IsPerfectoidPair p (completedColimitPair c) ∧
      Nonempty (tilt p (completedColimit c) ≃+*
        completedFilteredColimit p (D.ring ⋙ tiltFunctor p) (op c.base) ϖ') := sorry

/-- P5/completed-colimit-is-perfectoid (e): if all `R_i` have characteristic `p`, then `R` is a
perfect complete Tate ring of characteristic `p` (ECD Proposition 3.5). -/
theorem completedColimit.perfectRing_of_charP (h : ∀ i, CharP (D.ring.obj i) p) :
    CharP (completedColimit c) p ∧ PerfectRing (completedColimit c) p := sorry

end IsPerfectoid

/-! ## PerfectoidSpaces:P5/limit-independence-of-tail-and-choice (lemma) -/

section Independence

open completedColimit

variable {p : ℕ} [Fact p.Prime] {I : Type u} [SmallCategory I] [IsCofiltered I]
  {D : PairDiagram p I}

/-- P5/limit-independence-of-tail-and-choice (a) (data): for two compatible pseudouniformisers the
`ϖ`-adic and `ϖ'`-adic topologies on `A = colim R_i⁺` coincide, and the identity of `A` induces
an isomorphism of the completed direct limits (ECD Proposition 6.5; ECD Remark 3.2). -/
def completedColimit.equivOfChoice (c c' : CompatiblePseudouniformizer D) :
    completedColimit c ≃+* completedColimit c' := sorry

/-- P5/limit-independence-of-tail-and-choice (a): `equivOfChoice` is an isomorphism of Huber pairs
(a homeomorphism carrying `R⁺` onto `R⁺`) compatible with all `ι_i`. -/
theorem completedColimit.equivOfChoice_spec (c c' : CompatiblePseudouniformizer D) :
    Continuous (equivOfChoice c c') ∧ Continuous (equivOfChoice c c').symm ∧
      (completedColimitPlus c).map (equivOfChoice c c' : _ →+* _) = completedColimitPlus c' ∧
      ∀ i x, equivOfChoice c c' ((ι c i).toRingHom x) = (ι c' i).toRingHom x := sorry

/-- P5/limit-independence-of-tail-and-choice (c): the comparison isomorphisms compose. -/
theorem completedColimit.equivOfChoice_trans (c c' c'' : CompatiblePseudouniformizer D) :
    (equivOfChoice c c').trans (equivOfChoice c' c'') = equivOfChoice c c'' := sorry

/-- P5/limit-independence-of-tail-and-choice (c): the comparison isomorphisms commute with the
universal property `lift`. -/
theorem completedColimit.lift_comp_equivOfChoice (c c' : CompatiblePseudouniformizer D)
    {S : Type*} [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S]
    [IsTateRing S] [CompleteSpace S] [T2Space S] (P : Pair S) (hP : IsBounded (P.plus : Set S))
    (ψ : ∀ i, Pair.Hom (D.pair i) P) (hψ : ∀ {i j : I} (a : j ⟶ i), (ψ j).comp (D.hom a) = ψ i) :
    (lift c' P hP ψ hψ).toRingHom.comp (equivOfChoice c c' : _ →+* _) =
      (lift c P hP ψ hψ).toRingHom := sorry

end Independence

end Perfectoid

