--   `IsStronglyZariskiClosed_affinoid.isClosed_ker`.
-- PerfectoidSpace.IsStronglyZariskiClosed.iff_quotient: not stated here; needs `Spa` of the
--   anchor's quotient pair as a perfectoid space (supplier: AdicSpaces Layer 5). Affinoid core:
--   `IsStronglyZariskiClosed_affinoid.iff_quotient`.
-- PerfectoidSpace.IsStronglyZariskiClosed.isZariskiClosedImmersion: not stated here; needs
--   `IsZariskiClosedImmersion` (supplier: AdicSpaces Layer 5). Affinoid core:
--   `IsStronglyZariskiClosed_affinoid.isZariskiClosedImmersion`.
-- PerfectoidSpace.IsStronglyZariskiClosed.almostSurjective_plus: not stated here; needs
--   `IsStronglyZariskiClosed` (supplier: AdicSpaces Layer 5). Affinoid core:
--   `IsStronglyZariskiClosed_affinoid.almostSurjective_plus`.
-- PerfectoidSpace.IsStronglyZariskiClosed.comp: not stated here; needs `IsStronglyZariskiClosed`
--   (supplier: AdicSpaces Layer 5). Affinoid core: `IsStronglyZariskiClosed_affinoid.comp`.
-- PerfectoidSpace.IsStronglyZariskiClosed.baseChange: not stated here; needs fibre products of
--   perfectoid spaces (supplier: PerfectoidSpaces:P2/fibre-products-of-perfectoid-spaces).
--   Affinoid core: `IsStronglyZariskiClosed_affinoid.baseChange`.
-- PerfectoidSpace.IsStronglyZariskiClosed.tilt: not stated here; needs the tilt of a morphism of
--   perfectoid spaces (supplier: PerfectoidSpaces:P2/perfectoid-spaces-and-glued-tilting).
--   Affinoid core: `IsStronglyZariskiClosed_affinoid.tilt`.

section StronglyZariskiClosedDef

variable {A B : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsHuberRing A]
  [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsHuberRing B] {P : Pair A}
  {Q : Pair B}

/-- P4/strongly-zariski-closed-immersion (structure, affinoid core of `IsStronglyZariskiClosed`;
ECD Definition 5.7 (ii)): `Spa(B, B⁺) → Spa(A, A⁺)` induced by `φ` with `A → B` surjective and
`B⁺` the integral closure of the image of `A⁺`. The plus-ring clause is part of the definition
(Tor Definition II.2.6, which omits it, is strictly weaker). For perfectoid `A`, `B` this is the
notion of the packet. -/
structure IsStronglyZariskiClosed_affinoid (φ : Pair.Hom P Q) : Prop where
  /-- `A → B` is surjective. -/
  surjective : Function.Surjective φ.toRingHom
  /-- `B⁺` is the integral closure of the image of `A⁺`. -/
  plus_eq : Q.plus = (integralClosure (P.plus.map φ.toRingHom) B).toSubring

namespace IsStronglyZariskiClosed_affinoid

/-- P4/strongly-zariski-closed-immersion (other, affinoid core of `isClosed_ker`): the kernel of
`A → B` is closed (`B` Hausdorff). -/
theorem isClosed_ker [T2Space B] {φ : Pair.Hom P Q} (h : IsStronglyZariskiClosed_affinoid φ) :
    IsClosed (RingHom.ker φ.toRingHom : Set A) := sorry

/-- P4/strongly-zariski-closed-immersion (structure, affinoid core of `comp`): composites of
strongly Zariski closed maps are strongly Zariski closed (ECD after Definition 5.7). -/
theorem comp {C : Type*} [CommRing C] [TopologicalSpace C] [IsTopologicalRing C] [IsHuberRing C]
    {U : Pair C} {φ : Pair.Hom P Q} {ψ : Pair.Hom Q U} (hψ : IsStronglyZariskiClosed_affinoid ψ)
    (hφ : IsStronglyZariskiClosed_affinoid φ) : IsStronglyZariskiClosed_affinoid (ψ.comp φ) :=
  sorry

end IsStronglyZariskiClosed_affinoid

end StronglyZariskiClosedDef

section StronglyZariskiClosedPerfectoid

variable (p : ℕ) [Fact p.Prime] {R S : Type u} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R] [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
  [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S]
  {P : Pair R} {Q : Pair S}

namespace IsStronglyZariskiClosed_affinoid

/-- P4/strongly-zariski-closed-immersion (compatibility, affinoid core of `iff_quotient`): `φ` is
strongly Zariski closed iff `(S, S⁺)` is Tau Ceti's quotient pair `(R, R⁺)/ker φ`
(`Pair.quotient`, Wedhorn Definition 7.22) over `(R, R⁺)`, as topological rings (open mapping
theorem, Tau Ceti `IsTateRing.isQuotientMap`); here `S` is perfectoid by hypothesis. -/
theorem iff_quotient (φ : Pair.Hom P Q) :
    IsStronglyZariskiClosed_affinoid φ ↔
      ∃ e : Pair.Hom (P.quotient (RingHom.ker φ.toRingHom)) Q,
        e.comp (P.quotientHom (RingHom.ker φ.toRingHom)) = φ ∧ IsHomeomorph e.toRingHom ∧
          (P.quotient (RingHom.ker φ.toRingHom)).plus.map e.toRingHom = Q.plus := sorry

/-- P4/strongly-zariski-closed-immersion (relation, affinoid core of `almostSurjective_plus`): for
strongly Zariski closed `φ`, `R⁺ → S⁺` is almost surjective: every `ϖ^{1/pⁿ}` multiplies `S⁺` into
the image of `R⁺` (Tor Lemma II.2.8; P4/surjective-perfectoid-map-almost-surjective-on-plus-rings).
-/
theorem almostSurjective_plus {φ : Pair.Hom P Q} (h : IsStronglyZariskiClosed_affinoid φ)
    (ϖ : PseudoUniformizerRoots p R) :
    ∀ n, ∀ s ∈ Q.plus, φ.toRingHom (ϖ.root n) * s ∈ P.plus.map φ.toRingHom := sorry

/-- P4/strongly-zariski-closed-immersion (compatibility, affinoid core of `tilt`): `φ` is
strongly Zariski closed iff its tilt `φ♭` (P1 `Pair.tiltHom`) is (Tor Lemma II.2.7;
P4/zariski-closed-tilting). -/
theorem tilt (φ : Pair.Hom P Q) :
    IsStronglyZariskiClosed_affinoid φ ↔ IsStronglyZariskiClosed_affinoid (Pair.tiltHom p φ) :=
  sorry

end IsStronglyZariskiClosed_affinoid

end StronglyZariskiClosedPerfectoid

section StronglyZariskiClosedBaseChange

variable (p : ℕ) [Fact p.Prime] {A B C : Type u}
  [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A]
  [CompleteSpace A] [T2Space A] [IsPerfectoidTateRing p A]
  [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B]
  [CompleteSpace B] [T2Space B] [IsPerfectoidTateRing p B]
  [CommRing C] [UniformSpace C] [IsUniformAddGroup C] [IsTopologicalRing C] [IsTateRing C]
  [CompleteSpace C] [T2Space C] [IsPerfectoidTateRing p C]
  [Algebra A B] [Algebra A C] [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]
  (S : Pair A) (T : Pair B) (U : Pair C) (hT : ∀ a ∈ S.plus, algebraMap A B a ∈ T.plus)
  (hU : ∀ a ∈ S.plus, algebraMap A C a ∈ U.plus)

/-- P4/strongly-zariski-closed-immersion (functoriality, affinoid core of `baseChange`): if
`Spa(B, B⁺) → Spa(A, A⁺)` is strongly Zariski closed, so is its base change along any
`Spa(C, C⁺) → Spa(A, A⁺)`, `(C, C⁺) → (B ⊗̂_A C)` (Tor Lemma II.2.9 (ii); fibre products via the
prelude's completed tensor product). -/
theorem IsStronglyZariskiClosed_affinoid.baseChange
    (h : IsStronglyZariskiClosed_affinoid
      (⟨algebraMap A B, IsAdicHom.continuous _, hT⟩ : Pair.Hom S T)) :
    IsStronglyZariskiClosed_affinoid (Pair.completedTensor.inr S T U hT hU) := sorry

end StronglyZariskiClosedBaseChange

