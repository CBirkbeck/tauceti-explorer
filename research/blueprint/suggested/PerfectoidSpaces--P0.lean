    (h : IsUniformlyKappaSmall_affinoid κ P) {D : PairOfDefinition R} (𝔭 : D.Presentation)
    (hspan : Ideal.span (𝔭.num : Set R) = ⊤) :
    IsUniformlyKappaSmall_affinoid κ (RationalLoc.pair 𝔭 P) := sorry

end Closure

section FibreProduct

variable {A B C : Type u} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsTateRing A]
  [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsHuberRing B]
  [CommRing C] [TopologicalSpace C] [IsTopologicalRing C] [IsHuberRing C]
  [Algebra A B] [Algebra A C] [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]
  (S : Pair A) (T : Pair B) (U : Pair C) (hT : ∀ a ∈ S.plus, algebraMap A B a ∈ T.plus)
  (hU : ∀ a ∈ S.plus, algebraMap A C a ∈ U.plus) {κ : Cardinal.{u}}

/-- P6/kappa-small-closure (c), affinoid core of `IsUniformlyKappaSmall.fibreProduct`: the fibre
product `Spa(B) ×_{Spa(A)} Spa(C) = Spa(B ⊗̂ᵘ_A C)` (prelude stand-in for AdicSpacesPartII:R0/
uniform-completed-tensor-product) of uniformly κ-small affinoids over an arbitrary base is
uniformly κ-small: for `#B, #C ≤ μ`, `#(B ⊗̂ᵘ_A C) ≤ μ^ℵ₀` and `#Spa ≤ 2^{μ^ℵ₀}` (ECD
Proposition 4.4, "in particular"). -/
theorem IsUniformlyKappaSmall.fibreProduct_affinoid (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    (hB : IsUniformlyKappaSmall_affinoid κ T) (hC : IsUniformlyKappaSmall_affinoid κ U) :
    IsUniformlyKappaSmall_affinoid κ (Pair.uniformCompletedTensor S T U hT hU) := sorry

/-- P6/kappa-small-closure (c), affinoid form: κ-small affinoid perfectoid spaces are stable
under fibre products (ECD Proposition 4.4: "the category of κ-small perfectoid spaces is stable
under finite products", for quasicompact factors). -/
theorem IsKappaSmall.uniformCompletedTensor_affinoid (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    (hB : IsKappaSmall_affinoid κ T) (hC : IsKappaSmall_affinoid κ U) :
    IsKappaSmall_affinoid κ (Pair.uniformCompletedTensor S T U hT hU) := sorry

end FibreProduct

