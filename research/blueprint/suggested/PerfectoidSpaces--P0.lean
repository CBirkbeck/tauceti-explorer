/-! ## PerfectoidSpaces:P6/zariski-closed-immersions-are-pro-etale (lemma) -/

namespace PerfectoidSpace

/-- P6/zariski-closed-immersions-are-pro-etale (a): for a Tate Huber pair `(R, R⁺)` and an ideal
`I ⊆ R`, the vanishing locus `V(I) = {x : |f(x)| = 0 ∀ f ∈ I}` is the intersection of the rational
subsets `U_F = X(F/1) = {x : |f(x)| ≤ 1 ∀ f ∈ F}` over the finite subsets `F ⊆ I`: for `f ∈ I`,
`ϖ^{-n} f ∈ I`, which turns "bounded by 1" into "zero" (ECD Remark 7.9; Sch15 proof of Lemma
II.2.2). -/
theorem vanishingLocus_eq_iInter_rational {R : Type u} [CommRing R] [TopologicalSpace R]
    [IsTopologicalRing R] [IsTateRing R] (P : Pair R) (I : Ideal R) :
    {x ∈ spa P.plus | I ≤ x.supp} =
      ⋂ (F : Finset R) (_ : (F : Set R) ⊆ I), rationalSubset P.plus F 1 := sorry

end PerfectoidSpace

-- PerfectoidSpace.zariskiClosedLimit: not stated here; (b) `Z_I := lim_F U_F` needs limits of
--   perfectoid spaces (supplier: PerfectoidSpaces:P5/cofiltered-limits-of-affinoid-perfectoid-
--   spaces) and Zariski closed immersions (supplier: PerfectoidSpaces:P4/zariski-closed-immersion).
-- PerfectoidSpace.IsZariskiClosed.isAffinoidProEtale: not stated here; (c) ECD Remark 7.9 needs
--   Zariski closed immersions (supplier: PerfectoidSpaces:P4/zariski-closed-immersion) and
--   `PerfectoidSpace.IsAffinoidProEtale` (PerfectoidSpaces:P6/affinoid-pro-etale-map).

/-! ## PerfectoidSpaces:P6/zariski-closed-equals-strongly-zariski-closed (comparison) -/

-- PerfectoidSpace.isZariskiClosedImmersion_iff_isStronglyZariskiClosed: not stated here; ECD
--   Theorem 5.8 needs (strongly) Zariski closed immersions of perfectoid spaces (supplier:
--   PerfectoidSpaces:P4/zariski-closed-immersion, PerfectoidSpaces:P4/strongly-zariski-closed-
--   immersion); the hard direction is imported from PerfectoidQuotients:Q4/
--   zariski-closed-subsets-are-strongly-zariski-closed. Ring-level content:
--   `isZariskiClosedImmersion_iff_isStronglyZariskiClosed_ring`.

namespace PerfectoidSpace

open Perfectoid

/-- P6/zariski-closed-equals-strongly-zariski-closed (ring-level content of ECD Theorem 5.8,
which cites Bhatt–Scholze [BS22] Theorem 7.4, Remark 7.5; AWS Theorem 2.9.12, due to Bhatt): for
a perfectoid Tate pair `(R, R⁺)` and an ideal `I ⊆ R` there is a perfectoid Tate ring `S` (the
uniform completion of `R/Ī`) with a *surjective* continuous `R → S` whose kernel is
`I^perf = {h : |h| = 0 on V(I)}`. For
`R = ℂ_p⟨T^{±1/p^∞}⟩`, `I = (T − 1)` this is `R ↠ C⁰(ℤ_p, ℂ_p)` (AWS Example 2.4.10; the example
of Sch15 §II.2, Remark II.2.4, is erroneous, ECD after Definition 5.7). Imported from
PerfectoidQuotients:Q4/zariski-closed-subsets-are-strongly-zariski-closed; not proved here. -/
theorem isZariskiClosedImmersion_iff_isStronglyZariskiClosed_ring (p : ℕ) [Fact p.Prime]
    {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R)
    (I : Ideal R) :
    ∃ (S : PerfectoidRingCat.{u} p) (φ : R →+* S), Continuous φ ∧ Function.Surjective φ ∧
      ∀ h : R, φ h = 0 ↔ ∀ x ∈ spa P.plus, I ≤ x.supp → h ∈ x.supp := sorry

end PerfectoidSpace

