-- test Perfectoid.uniformTilt.isPerfectoidTateRing_of_hom (characterisation)
--   [P1/tilt-of-uniform-tate-ring]
example {A B : Type*} [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A]
