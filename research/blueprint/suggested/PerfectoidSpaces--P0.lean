/-! ## PerfectoidSpaces:P1/tilt-comparison-with-mathlib-pretilt (comparison) -/

section PreTiltComparison

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P1/tilt-comparison-with-mathlib-pretilt: a pseudo-uniformizer with compatible roots lies in
every `R♭⁺` (`ϖ♭` is topologically nilpotent). -/
theorem PseudoUniformizerRoots.toTilt_mem_tilt_plus (ϖ : PseudoUniformizerRoots p R)
    (P : Pair R) : ϖ.toTilt ∈ (Pair.tilt p P).plus := sorry

variable [Nontrivial R]

/-- P1/tilt-comparison-with-mathlib-pretilt (a): for `R ≠ 0` perfectoid, `R♭⁺ = lim_{x ↦ x^p} R⁺`
is Mathlib's `PreTilt R⁺ p = Perfection (ModP R⁺ p) p`, via `x ↦ (x⁽ⁿ⁾ mod p)ₙ`, with inverse
built from `Perfection.teichmuller` / `Perfection.quotientMulEquiv`. -/
def Pair.tiltPlusEquivPreTilt (P : Pair R) : (Pair.tilt p P).plus ≃+* PreTilt P.plus p := sorry

/-- P1/tilt-comparison-with-mathlib-pretilt (b): under `Pair.tiltPlusEquivPreTilt`, `♯` is
Mathlib's `PreTilt.untilt`. -/
theorem Pair.sharp_eq_untilt (P : Pair R) (x : (Pair.tilt p P).plus) :
    tilt.sharp (x : Perfectoid.tilt p R) =
      ((PreTilt.untilt (Pair.tiltPlusEquivPreTilt p P x) : P.plus) : R) := sorry

/-- P1/tilt-comparison-with-mathlib-pretilt (b): `PreTilt.coeff 0` is `♯ mod p` (Mathlib
`PreTilt.mk_untilt_eq_coeff_zero`). -/
theorem Pair.coeff_zero_tiltPlusEquivPreTilt (P : Pair R) (x : (Pair.tilt p P).plus) :
    PreTilt.coeff 0 (Pair.tiltPlusEquivPreTilt p P x) =
      Ideal.Quotient.mk _ (⟨tilt.coeff 0 (x : Perfectoid.tilt p R),
        (Pair.mem_tilt_plus_iff p P _).mp x.2⟩ :
        P.plus) := sorry

/-- P1/tilt-comparison-with-mathlib-pretilt (c): `R♭ ≅ (PreTilt R⁺ p)[1/ϖ♭]`. -/
def tilt.equivLocalizationPreTilt (P : Pair R) (ϖ : PseudoUniformizerRoots p R) :
    tilt p R ≃+* Localization.Away
      (Pair.tiltPlusEquivPreTilt p P ⟨ϖ.toTilt, ϖ.toTilt_mem_tilt_plus p P⟩) := sorry

end PreTiltComparison

/-! ## PerfectoidSpaces:P1/rings-of-integral-elements-under-tilting (lemma) -/

section PlusUnderTilting

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P1/rings-of-integral-elements-under-tilting (a) (ECD Lemma 3.11): `R⁺ ↦ R♭⁺` is a bijection
from rings of integral elements of `R` to those of `R♭`, preserving inclusions. -/
theorem Pair.tilt_bijective :
    Function.Bijective (Pair.tilt p : Pair R → Pair (Perfectoid.tilt p R)) ∧
      ∀ P Q : Pair R, (Pair.tilt p P).plus ≤ (Pair.tilt p Q).plus ↔ P.plus ≤ Q.plus := sorry

/-- P1/rings-of-integral-elements-under-tilting: `R° ↦ R♭°`. -/
theorem Pair.tilt_powerBounded :
    Pair.tilt p (Pair.powerBounded R) = Pair.powerBounded (Perfectoid.tilt p R) :=
  sorry

/-- P1/rings-of-integral-elements-under-tilting: `ϖ = ϖ♭♯` as an element of every `R⁺`. -/
def PseudoUniformizerRoots.rootPlus (ϖ : PseudoUniformizerRoots p R) (P : Pair R) : P.plus :=
  ⟨ϖ.root 0, P.isRingOfIntegralElements.mem_of_isTopologicallyNilpotent
    (ϖ.isPseudoUniformizer_root 0).1.2⟩

/-- P1/rings-of-integral-elements-under-tilting (b): `R♭⁺ ⧸ ϖ♭ ≅ R⁺ ⧸ ϖ`, compatibly with
`R♭° ⧸ ϖ♭ ≅ R° ⧸ ϖ` (ECD Lemma 3.11). -/
def Pair.tiltPlusQuotEquiv (P : Pair R) (ϖ : PseudoUniformizerRoots p R) :
    (Pair.tilt p P).plus ⧸ Ideal.span {(⟨ϖ.toTilt, ϖ.toTilt_mem_tilt_plus p P⟩ :
      (Pair.tilt p P).plus)} ≃+*
      P.plus ⧸ Ideal.span {ϖ.rootPlus p P} := sorry

end PlusUnderTilting

/-! ## PerfectoidSpaces:P1/topologically-nilpotent-elements-as-root-ideal (lemma) -/

section RootIdeal

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]

/-- P1/topologically-nilpotent-elements-as-root-ideal: `(ϖ^{1/p^{n+1}}) ^ p = ϖ^{1/pⁿ}` in
`R°`. -/
theorem PseudoUniformizerRoots.rootPB_pow (ϖ : PseudoUniformizerRoots p R) (n : ℕ) :
    ϖ.rootPB (n + 1) ^ p = ϖ.rootPB n := sorry

/-- P1/topologically-nilpotent-elements-as-root-ideal: for a complete Hausdorff uniform Tate ring
with a pseudo-uniformizer with compatible roots, `R°° = ⋃ₙ ϖ^{1/pⁿ} R°`. -/
theorem topologicallyNilpotentIdeal_eq_iSup (hb : IsBounded (powerBoundedSubring R : Set R))
    (ϖ : PseudoUniformizerRoots p R) :
    topologicallyNilpotentIdeal R = ⨆ n, Ideal.span {ϖ.rootPB n} := sorry

/-- P1/topologically-nilpotent-elements-as-root-ideal: `(R°°)² = R°°` and `R°°` is a flat
`R°`-module (a filtered union of the free modules `ϖ^{1/pⁿ} R°`). -/
theorem isIdempotentElem_topologicallyNilpotentIdeal
    (hb : IsBounded (powerBoundedSubring R : Set R)) (ϖ : PseudoUniformizerRoots p R) :
    IsIdempotentElem (topologicallyNilpotentIdeal R) ∧
      _root_.Module.Flat (powerBoundedSubring R) (topologicallyNilpotentIdeal R) := sorry

/-- P1/topologically-nilpotent-elements-as-root-ideal: `(R°, R°°)` is the root setup of
P0/root-ideal-basic-setup for the roots `ϖ^{1/pⁿ}`. -/
theorem topologicallyNilpotentIdeal_eq_ofCompatibleRoots
    (hb : IsBounded (powerBoundedSubring R : Set R)) (ϖ : PseudoUniformizerRoots p R) :
    topologicallyNilpotentIdeal R =
      (Almost.BasicSetup.ofCompatibleRoots p (Fact.out : p.Prime).two_le
        (fun n ↦ ϖ.rootPB n) (ϖ.rootPB_pow p)).ideal := sorry

/-- P1/topologically-nilpotent-elements-as-root-ideal: `R°° ⊆ R⁺` and `R°° = ⋃ₙ ϖ^{1/pⁿ} R⁺` for
every ring of integral elements. -/
theorem topologicallyNilpotent_mem_plus_iff (hb : IsBounded (powerBoundedSubring R : Set R))
    (ϖ : PseudoUniformizerRoots p R) (P : Pair R) (x : R) :
    IsTopologicallyNilpotent x ↔ ∃ n, ∃ y ∈ P.plus, x = ϖ.root n * y := sorry

end RootIdeal

/-! ## PerfectoidSpaces:P1/perfectoid-almost-setup (construction) -/

section AlmostSetup

variable (p : ℕ) [Fact p.Prime] (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]

/-- P1/perfectoid-almost-setup (constructor): the basic setup `(R°, R°°)` of a perfectoid Tate
ring (ECD 3.21–3.23; P0/almost-basic-setup): `R°°` is idempotent with `R°° ⊗ R°°` flat
(P1/topologically-nilpotent-elements-as-root-ideal). It depends only on `R`. -/
def almostSetup [IsPerfectoidTateRing p R] : Almost.BasicSetup (powerBoundedSubring R) where
  ideal := topologicallyNilpotentIdeal R
  isIdempotentElem := sorry
  flat_tilde := sorry

/-- P1/perfectoid-almost-setup (constructor): the basic setup `(R⁺, R°°)` for a ring of integral
elements `R⁺` (`R°° ⊆ R⁺`). -/
def almostSetupPlus [IsPerfectoidTateRing p R] (P : Pair R) : Almost.BasicSetup P.plus where
  ideal := (topologicallyNilpotentIdeal R).comap
    (Subring.inclusion P.isRingOfIntegralElements.le_powerBoundedSubring)
  isIdempotentElem := sorry
  flat_tilde := sorry

variable {R} [IsPerfectoidTateRing p R]

/-- P1/perfectoid-almost-setup (simp): the ideal of the setup is `R°°`. -/
@[simp] theorem almostSetup_ideal : (almostSetup p R).ideal = topologicallyNilpotentIdeal R := rfl

/-- P1/perfectoid-almost-setup (characterisation): `M` is almost zero iff every
pseudo-uniformizer kills `M` (ECD Definition 3.21). -/
theorem isAlmostZero_iff_forall_pseudoUniformizer (M : Type*) [AddCommGroup M]
    [_root_.Module (powerBoundedSubring R) M] :
    (almostSetup p R).IsAlmostZero M ↔ ∀ ϖ' : powerBoundedSubring R,
      IsPseudoUniformizer (ϖ' : R) → ∀ x : M, ϖ' • x = 0 := sorry

/-- P1/perfectoid-almost-setup (characterisation): `M` is almost zero iff every `ϖ^{1/pⁿ}` kills
`M`, for one (equivalently any) `ϖ♭` with compatible roots (AWS Definition 2.9.4). -/
theorem isAlmostZero_iff_forall_root (ϖ : PseudoUniformizerRoots p R) (M : Type*)
    [AddCommGroup M] [_root_.Module (powerBoundedSubring R) M] :
    (almostSetup p R).IsAlmostZero M ↔ ∀ n, ∀ x : M, ϖ.rootPB n • x = 0 := sorry

/-- P1/perfectoid-almost-setup (other): `R° ⧸ R⁺` is almost zero: `R°° R° ⊆ R⁺` (ECD Example
3.22(ii)). -/
theorem isAlmostZero_powerBounded_quotient_plus (P : Pair R) :
    ∀ ε ∈ (almostSetupPlus p R P).ideal, ∀ x ∈ powerBoundedSubring R,
      ((ε : P.plus) : R) * x ∈ P.plus := sorry

/-- P1/perfectoid-almost-setup (equivalence): restriction of scalars along `R⁺ → R°` induces
`R°ᵃ-Mod ≃ R⁺ᵃ-Mod` (ECD 3.23). -/
def almostModuleEquivPlus (P : Pair R) :
    Almost.Module (almostSetup p R) ≌ Almost.Module (almostSetupPlus p R P) := sorry

/-- P1/perfectoid-almost-setup (functoriality): a topological ring isomorphism carries the
almost setup of `R` to that of `S` (the setup does not depend on `ϖ`). -/
theorem almostSetup_ringEquiv {S : Type*} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
    [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S]
    (e : R ≃+* S) (he : Continuous e) (he' : Continuous e.symm) :
    (almostSetup p S).ideal = (almostSetup p R).ideal.map (powerBoundedSubringEquiv e he he') :=
  sorry

/-- P1/perfectoid-almost-setup (compatibility): for a perfectoid field `K`, the setup is
`(K°, 𝔪_K)` (ECD Example 3.22(i); the field case of P0/almost-modules-over-perfectoid-base). -/
theorem almostSetup_field (K : Type*) [NontriviallyNormedField K] [IsUltrametricDist K]
    [CompleteSpace K] [IsPerfectoidTateRing p K] (x : powerBoundedSubring K) :
    x ∈ (almostSetup p K).ideal ↔ ‖(x : K)‖ < 1 := sorry

/-- P1/perfectoid-almost-setup (compatibility): `R°/ϖ ≅ R♭°/ϖ♭` carries `R°°/ϖ` onto
`R♭°°/ϖ♭`, identifying the almost setups of `R°/ϖ` and `R♭°/ϖ♭` (used in
P1/perfectoid-mod-varpi-equivalence). -/
theorem almostSetup_tilt_quot (ϖ : PseudoUniformizerRoots p R) :
    ((almostSetup p (tilt p R)).ideal.map
        (Ideal.Quotient.mk (Ideal.span {ϖ.toTiltPB p}))).map (tilt.sharpQuotEquiv ϖ) =
      (almostSetup p R).ideal.map (Ideal.Quotient.mk (Ideal.span {ϖ.rootPB 0})) := sorry

end AlmostSetup

section AlmostSetupTests

variable (p : ℕ) [Fact p.Prime]

-- test Perfectoid.isAlmostZero_residueField (computation) [P1/perfectoid-almost-setup]
example (K : Type*) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [IsPerfectoidTateRing p K] (ϖ : PseudoUniformizerRoots p K) :
    (almostSetup p K).IsAlmostZero (powerBoundedSubring K ⧸ (almostSetup p K).ideal) ∧
      ∀ n, ∀ x : powerBoundedSubring K ⧸ (almostSetup p K).ideal, ϖ.rootPB n • x = 0 := sorry

/- For `ℚ_p`, `(pℤ_p)² ≠ pℤ_p`: `(ℤ_p, ℤ_p°°)` is not a basic setup. -/
-- test Perfectoid.not_idempotent_padic (non-example) [P1/perfectoid-almost-setup]
example : ¬ IsIdempotentElem (topologicallyNilpotentIdeal ℚ_[p]) := sorry

-- test Perfectoid.isAlmostZero_of_subsingleton (degenerate) [P1/perfectoid-almost-setup]
example (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [Subsingleton R]
    (M : Type*) [AddCommGroup M] [_root_.Module (powerBoundedSubring R) M] :
    (almostSetup p R).IsAlmostZero M := sorry

/- For `ℂ_p` with `ϖ♭ = (p^{1/pⁿ})ₙ`: `𝒪/𝔪` is almost zero, `𝒪/p^{1/p}𝒪` is not
(`p^{1/p²}` does not kill it). -/
-- test Perfectoid.isAlmostZero_iff_root_test (characterisation) [P1/perfectoid-almost-setup]
example (ϖ : PseudoUniformizerRoots p ℂ_[p]) (hϖ : ϖ.root 0 = p) :
    (almostSetup p ℂ_[p]).IsAlmostZero
        (powerBoundedSubring ℂ_[p] ⧸ (almostSetup p ℂ_[p]).ideal) ∧
      ¬ (almostSetup p ℂ_[p]).IsAlmostZero
        (powerBoundedSubring ℂ_[p] ⧸ Ideal.span {ϖ.rootPB 1}) := sorry

/- `K = ℂ_p`, `K⁺` an open rank-two valuation subring `≠ K°`. -/
-- test Perfectoid.almostModuleEquivPlus_test (compatibility) [P1/perfectoid-almost-setup]
example (P : Pair ℂ_[p]) (hP : P.plus ≠ powerBoundedSubring ℂ_[p]) :
    Nonempty (Almost.Module (almostSetup p ℂ_[p]) ≌ Almost.Module (almostSetupPlus p ℂ_[p] P)) :=
  sorry

end AlmostSetupTests

/-! ## PerfectoidSpaces:P1/perfectoid-field-definition (definition) -/

section Field

variable (p : ℕ) [Fact p.Prime] (K : Type*) [NontriviallyNormedField K] [IsUltrametricDist K]
  [CompleteSpace K]

/-- P1/perfectoid-field-definition (structure): a *perfectoid field* (ECD Definition 3.6) is a
nonarchimedean field — complete for a nontrivial nonarchimedean absolute value defining its
topology — which is a perfectoid Tate ring (for the Tate structure
`Huber.isTateRing_of_nontriviallyNormedField`). Equivalently (ECD Proposition 3.8, Sch12
Definition 3.1): not discretely valued, `‖p‖ < 1`, Frobenius surjective on `K° ⧸ p`
(`IsPerfectoidField.iff`). The parent projection `IsPerfectoidField.toIsPerfectoidTateRing` is the
coercion to perfectoid Tate rings (an instance). -/
class IsPerfectoidField : Prop extends IsPerfectoidTateRing p K

variable {K}

/-- P1/perfectoid-field-definition (characterisation): ECD Proposition 3.8: `K` is perfectoid iff
its value group is not discrete (it accumulates at `1`), `‖p‖ < 1`, and Frobenius is surjective
on `K° ⧸ p` (P1/perfectoid-field-characterisation). -/
theorem IsPerfectoidField.iff :
    IsPerfectoidField p K ↔ (∀ ε : ℝ, 1 < ε → ∃ x : K, 1 < ‖x‖ ∧ ‖x‖ < ε) ∧ ‖(p : K)‖ < 1 ∧
      Function.Surjective fun x : ModP (powerBoundedSubring K) p ↦ x ^ p := sorry

/-- P1/perfectoid-field-definition (projection): `‖p‖ < 1` in a perfectoid field. -/
theorem IsPerfectoidField.norm_p_lt_one [IsPerfectoidField p K] : ‖(p : K)‖ < 1 := sorry

/-- P1/perfectoid-field-definition (projection): some `ϖ` with `0 < ‖ϖ‖ < 1` has
`‖p‖ ≤ ‖ϖ‖ ^ p` (`ϖ ^ p ∣ p` in `K°`). -/
theorem IsPerfectoidField.exists_pow_dvd_p [IsPerfectoidField p K] :
    ∃ ϖ : K, 0 < ‖ϖ‖ ∧ ‖ϖ‖ < 1 ∧ ‖(p : K)‖ ≤ ‖ϖ‖ ^ p := sorry

/-- P1/perfectoid-field-definition (characterisation): the value group `|K^×|` is `p`-divisible
(Sch12 Lemma 3.2, P1/perfectoid-field-value-group-p-divisible). -/
theorem IsPerfectoidField.valueGroup_pDivisible [IsPerfectoidField p K] (x : K) (hx : x ≠ 0) :
    ∃ y : K, ‖y‖ ^ p = ‖x‖ := sorry

/-- P1/perfectoid-field-definition (characterisation): in characteristic `p`, a perfectoid field
is a complete perfect nonarchimedean field (P1/characteristic-p-perfectoid-iff-perfect). -/
theorem IsPerfectoidField.iff_perfectRing [CharP K p] : IsPerfectoidField p K ↔ PerfectRing K p :=
  sorry

/-- P1/perfectoid-field-definition (constructor): a perfectoid Tate ring whose underlying ring is
a field carries a nontrivial nonarchimedean absolute value defining its topology, with
`|p| < 1` and non-discrete value group: it is a perfectoid field (Kedlaya, *On commutative
nonarchimedean Banach fields* Theorem 4.2; P1/perfectoid-ring-field-is-perfectoid-field). -/
theorem IsPerfectoidField.of_isPerfectoidTateRing_of_isField {R : Type*} [CommRing R]
    [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R]
    [T2Space R] [IsPerfectoidTateRing p R] (hR : IsField R) :
    ∃ v : AbsoluteValue R ℝ, IsNonarchimedean v ∧ v p < 1 ∧
      (∀ ε : ℝ, 1 < ε → ∃ x : R, 1 < v x ∧ v x < ε) ∧
      ∀ s : Set R, s ∈ 𝓝 (0 : R) ↔ ∃ ε > (0 : ℝ), {x | v x < ε} ⊆ s := sorry

/-- P1/perfectoid-field-definition (example): `ℂ_p` is a perfectoid field. -/
instance isPerfectoidField_padicComplex : IsPerfectoidField p ℂ_[p] := sorry

/-- P1/cyclotomic-perfectoid-field (instance): `ℚ_p^cycl` is a perfectoid field; stated here for
the examples of the tilt of a perfectoid field. -/
instance padicCyclotomic.instIsPerfectoidField : IsPerfectoidField p (padicCyclotomic p) := sorry

end Field

section FieldTests

variable (p : ℕ) [Fact p.Prime]

/- `ℚ_p` is discretely valued (ECD Remark 3.3), although Frobenius on `ℤ_p ⧸ p = 𝔽_p` is
surjective. -/
-- test Perfectoid.not_isPerfectoidField_padic (non-example) [P1/perfectoid-field-definition]
example : ¬ IsPerfectoidField p ℚ_[p] ∧
    Function.Surjective fun x : ModP (powerBoundedSubring ℚ_[p]) p ↦ x ^ p := sorry

-- test Perfectoid.isPerfectoidField_padicComplex_test (computation)
--   [P1/perfectoid-field-definition]
example : IsPerfectoidField p ℂ_[p] ∧
    (∀ x : ℂ_[p], x ≠ 0 → ∃ q : ℚ, ‖x‖ = (p : ℝ) ^ (-(q : ℝ))) ∧
    ∀ x ∈ powerBoundedSubring ℂ_[p], ∃ y ∈ powerBoundedSubring ℂ_[p], y ^ p = x := sorry

/- A discretely valued field of characteristic `p`, such as `𝔽_p((t))`, is neither perfect nor
perfectoid; the completed perfection `𝔽_p((t^{1/p^∞}))^` is both (it is
`tilt p (padicCyclotomic p)`, P1/cyclotomic-perfectoid-field). -/
-- test Perfectoid.isPerfectoidField_iff_perfect_laurent (characterisation)
--   [P1/perfectoid-field-definition]
example (K : Type*) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K] [CharP K p]
    (t : K) (ht : 0 < ‖t‖ ∧ ‖t‖ < 1) (hdisc : ∀ x : K, x ≠ 0 → ∃ n : ℤ, ‖x‖ = ‖t‖ ^ n) :
    ¬ PerfectRing K p ∧ ¬ IsPerfectoidField p K := sorry

/- Every nonzero element of `𝔽̄_p` is a root of unity, so every absolute value on `𝔽̄_p` is
trivial and `𝔽̄_p` is not a nonarchimedean field in the sense of ECD Definition 3.6. -/
