example (v : AbsoluteValue (AlgebraicClosure (ZMod p)) ℝ) (x : AlgebraicClosure (ZMod p))
    (hx : x ≠ 0) : v x = 1 := sorry

-- test Perfectoid.isPerfectoidTateRing_of_isPerfectoidField (compatibility)
--   [P1/perfectoid-field-definition]
example (K : Type*) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K] :
    IsPerfectoidField p K ↔ IsPerfectoidTateRing p K := sorry

end FieldTests

/-! ## PerfectoidSpaces:P1/perfectoid-field-characterisation (theorem) -/

section FieldCharacterisation

variable (p : ℕ) [Fact p.Prime] {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K]
  [CompleteSpace K]

/-- P1/perfectoid-field-characterisation (ECD Proposition 3.8, Berkeley Proposition 6.1.9): a
nonarchimedean field that is not discretely valued, with `|p| < 1` and Frobenius surjective on
`K° ⧸ p`, is perfectoid. -/
theorem IsPerfectoidField.of_norm (hK : ∀ ε : ℝ, 1 < ε → ∃ x : K, 1 < ‖x‖ ∧ ‖x‖ < ε)
    (hp : ‖(p : K)‖ < 1)
    (hF : Function.Surjective fun x : ModP (powerBoundedSubring K) p ↦ x ^ p) :
    IsPerfectoidField p K := sorry

/-- P1/perfectoid-field-characterisation: condition (i) cannot be dropped: a discretely valued
field is never perfectoid (`ℚ_p` and its unramified extensions satisfy (ii) and (iii)). -/
theorem not_isPerfectoidField_of_discrete (t : K) (ht : 0 < ‖t‖ ∧ ‖t‖ < 1)
    (hdisc : ∀ x : K, x ≠ 0 → ∃ n : ℤ, ‖x‖ = ‖t‖ ^ n) : ¬ IsPerfectoidField p K := sorry

end FieldCharacterisation

/-! ## PerfectoidSpaces:P1/perfectoid-field-value-group-p-divisible (lemma) -/

/-- P1/perfectoid-field-value-group-p-divisible (Sch12 Lemma 3.2): in characteristic `0` the
value group of a perfectoid field is generated by the `|x|` with `|p| < |x| ≤ 1`: every nonzero
value is `|p| ^ n |y|` with `|p| < |y| ≤ 1`. -/
theorem IsPerfectoidField.exists_norm_eq_zpow_mul (p : ℕ) [Fact p.Prime] {K : Type*}
    [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K] [CharZero K]
    [IsPerfectoidField p K] (x : K) (hx : x ≠ 0) :
    ∃ (n : ℤ) (y : K), ‖(p : K)‖ < ‖y‖ ∧ ‖y‖ ≤ 1 ∧ ‖x‖ = ‖(p : K)‖ ^ n * ‖y‖ := sorry

/-! ## PerfectoidSpaces:P1/uniform-banach-field-over-nondiscrete-field (theorem) -/

/-- P1/uniform-banach-field-over-nondiscrete-field (Kedlaya, *On commutative nonarchimedean
Banach fields*, Theorem 3.7): over a nonarchimedean field `F` with dense value group, a uniform
Banach `F`-algebra (power-multiplicative norm) whose underlying ring is a field has multiplicative
norm, i.e. is a nonarchimedean field. The proof uses the Berkovich spectrum (supplier
TropicalAndBerkovichArithmetic:TB.0); the statement does not. -/
theorem norm_mul_of_isField_of_powMul {F A : Type*} [NontriviallyNormedField F]
    [IsUltrametricDist F] [CompleteSpace F]
    (hF : ∀ ε : ℝ, 1 < ε → ∃ x : F, 1 < ‖x‖ ∧ ‖x‖ < ε) [NormedCommRing A] [NormedAlgebra F A]
    [CompleteSpace A] [IsUltrametricDist A] (hA : IsField A)
    (hpm : ∀ (x : A) (n : ℕ), ‖x ^ n‖ = ‖x‖ ^ n) : ∀ x y : A, ‖x * y‖ = ‖x‖ * ‖y‖ := sorry

/-- P1/uniform-banach-field-over-nondiscrete-field (Kedlaya, loc. cit., Remark 3.3): a uniform
Banach field has multiplicative norm iff `|t| |t⁻¹| = 1` for every unit `t`. -/
theorem norm_mul_iff_norm_mul_inv {A : Type*} [NormedCommRing A] [CompleteSpace A]
    [IsUltrametricDist A] (hA : IsField A) (hpm : ∀ (x : A) (n : ℕ), ‖x ^ n‖ = ‖x‖ ^ n) :
    (∀ x y : A, ‖x * y‖ = ‖x‖ * ‖y‖) ↔ ∀ t : Aˣ, ‖(t : A)‖ * ‖((t⁻¹ : Aˣ) : A)‖ = 1 := sorry

/-! ## PerfectoidSpaces:P1/perfectoid-field-iff-tilt-field (lemma) -/

/-- P1/perfectoid-field-iff-tilt-field (Sch12 Lemma 5.21 over a general base; KL I Lemma 3.5.2;
AWS Corollary 2.3.11): a perfectoid Tate ring is a field iff its tilt is; then the spectral gauges
satisfy `|x|_{R♭} = |x♯|_R` (`tilt.gauge_sharp`). -/
theorem isField_tilt_iff (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R]
    [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] : IsField (tilt p R) ↔ IsField R := sorry

/-! ## PerfectoidSpaces:P1/perfectoid-ring-field-is-perfectoid-field (theorem) -/

/-- P1/perfectoid-ring-field-is-perfectoid-field (Kedlaya, *On commutative nonarchimedean Banach
fields*, Theorem 4.2; answers ECD Remark 3.7; Berkeley Remark 6.1.8; AWS Theorem 2.9.1): the
topology of a perfectoid Tate ring whose underlying ring is a field is defined by a
multiplicative (nonarchimedean) absolute value; no perfectoid base field is assumed. -/
theorem IsPerfectoidTateRing.exists_absoluteValue_of_isField (p : ℕ) [Fact p.Prime] {R : Type*}
    [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R]
    [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (hR : IsField R) :
    ∃ v : AbsoluteValue R ℝ, IsNonarchimedean v ∧
      ∀ s : Set R, s ∈ 𝓝 (0 : R) ↔ ∃ ε > (0 : ℝ), {x | v x < ε} ⊆ s := sorry

/-! ## PerfectoidSpaces:P1/tilt-of-perfectoid-field (construction) -/

section TiltField

variable (p : ℕ) [Fact p.Prime] {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K]
  [CompleteSpace K] [IsPerfectoidField p K]

namespace tiltField

/-- P1/tilt-of-perfectoid-field (instance): `K♭` is a field, with the ring structure of
`tilt p K`. -/
instance instField : Field (tilt p K) :=
  { (inferInstance : CommRing (tilt p K)) with
    inv := sorry
    exists_pair_ne := sorry
    mul_inv_cancel := sorry
    inv_zero := sorry
    nnqsmul := sorry
    nnqsmul_def := sorry
    qsmul := sorry
    qsmul_def := sorry }

/-- P1/tilt-of-perfectoid-field (instance): the absolute value `‖x‖_♭ = ‖x♯‖` of `K♭`, with the
inverse-limit uniformity of `tilt p K` (the two agree, Sch12 Lemma 3.4). -/
instance instNormedField : NormedField (tilt p K) where
  __ := (inferInstance : Field (tilt p K))
  norm x := ‖tilt.sharp x‖
  dist x y := ‖tilt.sharp (x - y)‖
  dist_self := sorry
  dist_comm := sorry
  dist_triangle := sorry
  eq_of_dist_eq_zero := sorry
  toUniformSpace := inferInstance
  uniformity_dist := sorry
  dist_eq := sorry
  norm_mul := sorry

/-- P1/tilt-of-perfectoid-field (instance): the absolute value of `K♭` is nontrivial. -/
instance instNontriviallyNormedField : NontriviallyNormedField (tilt p K) :=
  { (inferInstance : NormedField (tilt p K)) with non_trivial := sorry }

/-- P1/tilt-of-perfectoid-field (instance): the absolute value of `K♭` is nonarchimedean. -/
instance instIsUltrametricDist : IsUltrametricDist (tilt p K) := sorry

variable {p}

/-- P1/tilt-of-perfectoid-field (characterisation): `‖x‖_{K♭} = ‖x♯‖_K`. -/
theorem norm_def (x : tilt p K) : ‖x‖ = ‖tilt.sharp x‖ := sorry

variable (p) (K)

/-- P1/tilt-of-perfectoid-field (characterisation): `|K♭^×| = |K^×|`. -/
theorem valueGroup_eq : Set.range (fun x : tilt p K ↦ ‖x‖) = Set.range (fun x : K ↦ ‖x‖) :=
  sorry

variable {K}

/-- P1/tilt-of-perfectoid-field (equivalence): `K♭° ≃+* lim_Φ K°/ϖ` for `ϖ ∣ p`, `0 < ‖ϖ‖ < 1`;
`K♭°` is the valuation ring of `K♭`. -/
def integerEquiv (ϖ : powerBoundedSubring K) [CharP (powerBoundedSubring K ⧸ Ideal.span {ϖ}) p]
    (hϖ : 0 < ‖(ϖ : K)‖ ∧ ‖(ϖ : K)‖ < 1) (hdvd : ϖ ∣ (p : powerBoundedSubring K)) :
    powerBoundedSubring (tilt p K) ≃+* Perfection (powerBoundedSubring K ⧸ Ideal.span {ϖ}) p :=
  sorry

/-- P1/tilt-of-perfectoid-field (equivalence): `K♭° ⧸ ϖ♭ ≃+* K° ⧸ ϖ`. -/
def quotEquiv (ϖ : PseudoUniformizerRoots p K) :
    powerBoundedSubring (tilt p K) ⧸ Ideal.span {ϖ.toTiltPB p} ≃+*
      powerBoundedSubring K ⧸ Ideal.span {ϖ.rootPB 0} :=
  tilt.sharpQuotEquiv ϖ

variable (K)

/-- P1/tilt-of-perfectoid-field (equivalence): the residue fields `K♭°/𝔪♭` and `K°/𝔪` are
identified. -/
def residueFieldEquiv :
    powerBoundedSubring (tilt p K) ⧸ (almostSetup p (tilt p K)).ideal ≃+*
      powerBoundedSubring K ⧸ (almostSetup p K).ideal := sorry

variable {K}

/-- P1/tilt-of-perfectoid-field (compatibility): for a valuation `v` of `K` with `v x = ‖x‖` and
ring of integers `O`, `K♭ ≃+* Tilt K v O hv p`, Mathlib's fraction field of `PreTilt O p`,
restricting to `K♭° ≃+* PreTilt O p`. -/
def equivMathlibTilt (O : Type*) [CommRing O] [Algebra O K] (v : Valuation K NNReal)
    (hv : v.Integers O) (hvn : ∀ x, (v x : ℝ) = ‖x‖) [Fact (v p ≠ 1)] :
    tilt p K ≃+* Tilt K v O hv p := sorry

/-- P1/tilt-of-perfectoid-field (compatibility): Mathlib's valuation on `PreTilt O p` is
`x ↦ v(x♯)`, `♯ = PreTilt.untilt`. -/
theorem preTiltVal_eq (O : Type*) [CommRing O] [Algebra O K] (v : Valuation K NNReal)
    (hv : v.Integers O) (hvn : ∀ x, (v x : ℝ) = ‖x‖) [Fact (¬ IsUnit (p : O))]
    [IsAdicComplete (Ideal.span {(p : O)}) O] (x : PreTilt O p) :
    PreTilt.val K v O hv p x = v (algebraMap O K (PreTilt.untilt x)) := sorry

/-- P1/tilt-of-perfectoid-field (equivalence): in characteristic `p`, `K♭ ≃+* K` isometrically. -/
def equivSelfOfCharP [CharP K p] : tilt p K ≃+* K := tilt.equivOfCharP

/-- P1/tilt-of-perfectoid-field (equivalence): `equivSelfOfCharP` is isometric. -/
theorem norm_equivSelfOfCharP [CharP K p] (x : tilt p K) :
    ‖equivSelfOfCharP (p := p) x‖ = ‖x‖ := sorry

/-- P1/tilt-of-perfectoid-field (functoriality): a continuous embedding `K → L` of perfectoid
fields induces an isometric embedding `K♭ → L♭` (P1/tilt-functoriality). -/
def map {L : Type*} [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
    [IsPerfectoidField p L] (f : K →+* L) (hf : Continuous f) : tilt p K →+* tilt p L :=
  tilt.map p f hf

/-- P1/tilt-of-perfectoid-field (functoriality): `tiltField.map` is isometric. -/
theorem norm_map {L : Type*} [NontriviallyNormedField L] [IsUltrametricDist L] [CompleteSpace L]
    [IsPerfectoidField p L] (f : K →+* L) (hf : Continuous f) (x : tilt p K) :
    ‖map p f hf x‖ = ‖x‖ := sorry

end tiltField

/-- P1/tilt-of-perfectoid-field (instance): the tilt of a perfectoid field is a perfectoid field
(with the absolute value `‖x♯‖`). -/
instance IsPerfectoidField.tilt_isPerfectoidField : IsPerfectoidField p (Perfectoid.tilt p K) :=
  sorry

/-- P1/perfectoid-field-definition (compatibility): the tilt of a perfectoid field is a perfectoid
field of characteristic `p` (P1/tilt-of-perfectoid-field). -/
theorem IsPerfectoidField.tilt :
    IsPerfectoidField p (Perfectoid.tilt p K) ∧ CharP (Perfectoid.tilt p K) p := sorry

end TiltField

section TiltFieldTests

variable (p : ℕ) [Fact p.Prime]

/- `p♭ = (p^{1/pⁿ})ₙ` and `ε = (ζ_{pⁿ})ₙ` in `ℂ_p♭` (the image of `ℚ_p^cycl♭`). -/
-- test Perfectoid.tiltField_padicComplex_pflat (computation) [P1/tilt-of-perfectoid-field]
example (pflat ε : tilt p ℂ_[p]) (hp : tilt.sharp pflat = p)
    (hε : ∀ n, IsPrimitiveRoot (tilt.coeff n ε) (p ^ n)) :
    ‖pflat‖ = ‖(p : ℂ_[p])‖ ∧ ‖ε - 1‖ = ‖(p : ℂ_[p])‖ ^ ((p : ℝ) / ((p : ℝ) - 1)) := sorry

-- test Perfectoid.tiltField_equivMathlibTilt_test (compatibility) [P1/tilt-of-perfectoid-field]
example (hv : (PadicComplex.valued p).v.Integers (powerBoundedSubring ℂ_[p]))
    [Fact ((PadicComplex.valued p).v p ≠ 1)] [Fact (¬ IsUnit (p : powerBoundedSubring ℂ_[p]))]
    (x : PreTilt (powerBoundedSubring ℂ_[p]) p) :
    Nonempty (tilt p ℂ_[p] ≃+* Tilt ℂ_[p] (PadicComplex.valued p).v (powerBoundedSubring ℂ_[p])
      hv p) ∧
    PreTilt.val ℂ_[p] (PadicComplex.valued p).v (powerBoundedSubring ℂ_[p]) hv p x =
      (PadicComplex.valued p).v (PreTilt.untilt x : powerBoundedSubring ℂ_[p]) := sorry

/- `K = tilt p (padicCyclotomic p)`, the completed perfection of `𝔽_p((t))`. -/
-- test Perfectoid.tiltField_equivSelf_laurent (degenerate) [P1/tilt-of-perfectoid-field]
example (x : tilt p (tilt p (padicCyclotomic p))) :
    tiltField.equivSelfOfCharP (p := p) x = tilt.coeff 0 x ∧
      ‖tiltField.equivSelfOfCharP (p := p) x‖ = ‖x‖ := sorry

/- `ℚ_p` is not perfectoid: `PreTilt ℤ_p p = Perfection 𝔽_p p ≅ 𝔽_p`, and Mathlib's valuation
on it is trivial. -/
-- test Perfectoid.preTilt_padicInt_trivial (non-example) [P1/tilt-of-perfectoid-field]
example [Fact (¬ IsUnit (p : ℤ_[p]))] (v : Valuation ℚ_[p] NNReal) (hv : v.Integers ℤ_[p])
    (x : PreTilt ℤ_[p] p) :
    Nonempty (PreTilt ℤ_[p] p ≃+* ZMod p) ∧
      (PreTilt.val ℚ_[p] v ℤ_[p] hv p x = 0 ∨ PreTilt.val ℚ_[p] v ℤ_[p] hv p x = 1) := sorry

end TiltFieldTests

/-! ## PerfectoidSpaces:P1/continuous-valuations-under-tilting (lemma) -/

/-- P1/continuous-valuations-under-tilting (Sch12 Proposition 3.6): `|·| ↦ |·♯|` is a bijection
from the continuous valuations of `K` (up to equivalence, Tau Ceti `ValuationSpectrum.cont`) to
those of `K♭`; the field case of P2/tilting-homeomorphism-and-rational-subsets. -/
theorem tiltField.exists_contEquiv (p : ℕ) [Fact p.Prime] {K : Type*} [NontriviallyNormedField K]
    [IsUltrametricDist K] [CompleteSpace K] [IsPerfectoidField p K] :
    ∃ e : ValuationSpectrum.cont K ≃ ValuationSpectrum.cont (tilt p K),
      ∀ (v : ValuationSpectrum.cont K) (x y : tilt p K),
        (e v).1.toValuativeRel.vle x y ↔
          v.1.toValuativeRel.vle (tilt.sharp x) (tilt.sharp y) := sorry

/-! ## PerfectoidSpaces:P1/witt-vectors-of-perfect-plus-ring (lemma) -/

section Ainf

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  [CharP R p]

/-- P1/witt-vectors-of-perfect-plus-ring (instance): in characteristic `p`, every ring of integral
elements of a perfectoid Tate ring is perfect (P1/characteristic-p-perfectoid-iff-perfect). -/
instance IsPerfectoidTateRing.instPerfectRingPlus (P : Pair R) : PerfectRing P.plus p :=
  IsPerfectoidTateRing.perfectRing_plus p P

/-- P1/witt-vectors-of-perfect-plus-ring (a), (b): `A_inf = W(R⁺)` is a strict `p`-ring:
`p`-torsion free and `p`-adically complete (Mathlib `WittVector.isAdicCompleteIdealSpanP`) with
`W(R⁺) ⧸ p ≅ R⁺` (Mathlib `WittVector.quotientPEquiv`). -/
theorem ainf_isSMulRegular_p (P : Pair R) :
    IsSMulRegular (WittVector p P.plus) (p : WittVector p P.plus) ∧
      IsAdicComplete (Ideal.span {(p : WittVector p P.plus)}) (WittVector p P.plus) := sorry

/-- P1/witt-vectors-of-perfect-plus-ring (c), (e): for a pseudo-uniformizer `ϖ ∈ R⁺`, `[ϖ]` is a
nonzerodivisor and `W(R⁺)` is `[ϖ]`-adically and `(p, [ϖ])`-adically complete and separated, with
`W(R⁺) ⧸ (p, [ϖ]) = R⁺ ⧸ ϖ`. -/
theorem ainf_isAdicComplete_teichmuller (P : Pair R) (ϖ : P.plus)
    (hϖ : IsPseudoUniformizer (ϖ : R)) :
    IsSMulRegular (WittVector p P.plus) (WittVector.teichmuller p ϖ) ∧
      IsAdicComplete (Ideal.span {WittVector.teichmuller p ϖ}) (WittVector p P.plus) ∧
      IsAdicComplete (Ideal.span {(p : WittVector p P.plus), WittVector.teichmuller p ϖ})
        (WittVector p P.plus) := sorry

/-- P1/witt-vectors-of-perfect-plus-ring (c): `W(R⁺) ⧸ (p, [ϖ]) ≃+* R⁺ ⧸ ϖ`. -/
def ainfQuotEquiv (P : Pair R) (ϖ : P.plus) :
    WittVector p P.plus ⧸ Ideal.span {(p : WittVector p P.plus), WittVector.teichmuller p ϖ} ≃+*
      P.plus ⧸ Ideal.span {ϖ} := sorry

/-- P1/witt-vectors-of-perfect-plus-ring (d): `Σ pⁿ [xₙ]` is a unit iff `x₀` is a unit of
`R⁺`. -/
theorem ainf_isUnit_iff (P : Pair R) (x : WittVector p P.plus) :
    IsUnit x ↔ IsUnit (x.coeff 0) := sorry

/-- P1/witt-vectors-of-perfect-plus-ring (g): for a `p`-adically complete ring `S`, every ring
homomorphism `R⁺ → S ⧸ p` lifts uniquely to `W(R⁺) → S`. -/
theorem ainf_existsUnique_lift (P : Pair R) {S : Type*} [CommRing S]
    [IsAdicComplete (Ideal.span {(p : S)}) S] (f : P.plus →+* S ⧸ Ideal.span {(p : S)}) :
    ∃! g : WittVector p P.plus →+* S,
      (Ideal.Quotient.mk (Ideal.span {(p : S)})).comp g = f.comp WittVector.constantCoeff :=
  sorry

end Ainf

/-! ## PerfectoidSpaces:P1/primitive-degree-one-ideals (definition) -/

section Primitive

variable {p : ℕ} [Fact p.Prime]

/-- P1/primitive-degree-one-ideals (structure): `ξ = Σ pⁿ [ξₙ] ∈ W(S)` is *primitive of degree
one* (distinguished) if its zeroth Witt coordinate is topologically nilpotent and its first is a
unit (AWS Definition 2.3.4, KL II Definition 3.2.3, ECD Definition 3.15). For a perfect `S` the
Witt coordinates are the `pⁿ`-th powers of the Teichmüller coordinates. -/
structure IsPrimitive {S : Type*} [CommRing S] [TopologicalSpace S] (ξ : WittVector p S) :
    Prop where
  /-- `ξ₀` is topologically nilpotent. -/
  isTopologicallyNilpotent_coeff_zero : IsTopologicallyNilpotent (ξ.coeff 0)
  /-- `ξ₁` is a unit. -/
  isUnit_coeff_one : IsUnit (ξ.coeff 1)

/-- P1/primitive-degree-one-ideals (structure): an ideal `J ⊆ W(S)` is *primitive of degree one*
if it is principal with a primitive generator (ECD Definition 3.15). -/
def IsPrimitiveIdeal {S : Type*} [CommRing S] [TopologicalSpace S]
    (J : Ideal (WittVector p S)) : Prop :=
  ∃ ξ, IsPrimitive ξ ∧ J = Ideal.span {ξ}

/-- P1/primitive-degree-one-ideals (example): `p` is primitive, with Witt coordinates
`(0, 1, 0, …)` in characteristic `p`. -/
theorem isPrimitive_p {S : Type*} [CommRing S] [TopologicalSpace S] [CharP S p] :
    IsPrimitive (p : WittVector p S) := sorry

variable {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
  [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CharP R p]
  {P : Pair R}

/-- P1/primitive-degree-one-ideals (characterisation): `ξ` is primitive iff `ξ = [ξ₀] + p u` with
`u` a unit and `ξ₀` topologically nilpotent. -/
theorem IsPrimitive.iff_teichmuller_add (ξ : WittVector p P.plus) :
    IsPrimitive ξ ↔ ∃ u : (WittVector p P.plus)ˣ,
      ξ = WittVector.teichmuller p (ξ.coeff 0) + p * u ∧ IsTopologicallyNilpotent (ξ.coeff 0) :=
  sorry

/-- P1/primitive-degree-one-ideals (constructor): `p + [ϖ] α` is primitive for a
pseudo-uniformizer `ϖ ∈ R⁺` and any `α` (ECD Definition 3.15). -/
theorem isPrimitive_p_add (ϖ : P.plus) (hϖ : IsPseudoUniformizer (ϖ : R))
    (α : WittVector p P.plus) : IsPrimitive ((p : WittVector p P.plus) +
      WittVector.teichmuller p ϖ * α) := sorry

/-- P1/primitive-degree-one-ideals (characterisation): every primitive element is a unit multiple
of some `p + [ϖ] α` (KL II Lemma 3.2.2, AWS Exercise 2.3.6). -/
theorem IsPrimitive.exists_associated_p_add {ξ : WittVector p P.plus} (hξ : IsPrimitive ξ) :
    ∃ (u : (WittVector p P.plus)ˣ) (ϖ : P.plus) (α : WittVector p P.plus),
      IsPseudoUniformizer (ϖ : R) ∧ ξ = u * ((p : WittVector p P.plus) +
        WittVector.teichmuller p ϖ * α) := sorry

/-- P1/primitive-degree-one-ideals (other): unit multiples of primitive elements are
primitive. -/
theorem IsPrimitive.mul_unit {ξ : WittVector p P.plus} (hξ : IsPrimitive ξ)
    (u : (WittVector p P.plus)ˣ) : IsPrimitive (ξ * (u : WittVector p P.plus)) := sorry

/-- P1/primitive-degree-one-ideals (relation): if `ξ' = y ξ` with `ξ, ξ'` primitive then `y` is
a unit (AWS Remark 2.3.5, P1/distinguished-element-criterion). -/
theorem IsPrimitive.isUnit_of_eq_mul {ξ ξ' y : WittVector p P.plus} (hξ : IsPrimitive ξ)
    (hξ' : IsPrimitive ξ') (h : ξ' = y * ξ) : IsUnit y := sorry

/-- P1/primitive-degree-one-ideals (other): primitive elements are nonzerodivisors (ECD Lemma
3.16, P1/distinguished-element-criterion). -/
theorem IsPrimitive.isRegular {ξ : WittVector p P.plus} (hξ : IsPrimitive ξ) : IsRegular ξ :=
  sorry

/-- P1/primitive-degree-one-ideals (functoriality): a morphism of perfectoid pairs of
characteristic `p` carries primitive elements to primitive elements, so `J ↦ J W(R'⁺)` preserves
primitive ideals. -/
theorem IsPrimitive.map {S : Type*} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
    [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]
    [IsPerfectoidTateRing p S] [CharP S p] {Q : Pair S} (f : Pair.Hom P Q)
    {ξ : WittVector p P.plus} (hξ : IsPrimitive ξ) :
    IsPrimitive (WittVector.map (f.toRingHom.restrict _ _ f.map_mem_plus) ξ) := sorry

/-- P1/primitive-degree-one-ideals (other): `φ(ξ)` and `φ⁻¹(ξ)` are primitive. -/
theorem IsPrimitive.frobenius {ξ : WittVector p P.plus} (hξ : IsPrimitive ξ) :
    IsPrimitive (WittVector.frobenius ξ) ∧
      IsPrimitive (WittVector.map ((frobeniusEquiv P.plus p).symm : P.plus →+* P.plus) ξ) :=
  sorry

end Primitive

section PrimitiveTests

variable (p : ℕ) [Fact p.Prime]

/- `P = (ℂ_p♭, 𝒪_{ℂ_p♭})`: `p - [p♭]` is primitive, and so is `Σ_{i<p} [ε^{1/p}]^i`
(its image in `W(𝔽̄_p)` is `p`). -/
-- test Perfectoid.isPrimitive_p_sub_pflat (computation) [P1/primitive-degree-one-ideals]
example (pflat ε : (Pair.powerBounded (tilt p ℂ_[p])).plus)
    (hp : tilt.sharp (pflat : tilt p ℂ_[p]) = p)
    (hε : ∀ n, IsPrimitiveRoot (tilt.coeff n (ε : tilt p ℂ_[p])) (p ^ (n + 1))) :
    IsPrimitive ((p : WittVector p (Pair.powerBounded (tilt p ℂ_[p])).plus) -
        WittVector.teichmuller p pflat) ∧
      IsPrimitive (∑ i ∈ Finset.range p, WittVector.teichmuller p ε ^ i) := sorry

/- A definition requiring only `ξ ∈ (p, [ϖ])` would accept `p²` and `[ϖ]`. -/
-- test Perfectoid.not_isPrimitive_p_sq (non-example) [P1/primitive-degree-one-ideals]
example {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CharP R p]
    [Nontrivial R] (P : Pair R) (ϖ : P.plus) :
    ¬ IsPrimitive ((p : WittVector p P.plus) ^ 2) ∧
      ¬ IsPrimitive (WittVector.teichmuller p ϖ) := sorry

/- The untilt along `(p)` is `(R, R⁺)` itself (`untilt.equivSelf`). -/
-- test Perfectoid.isPrimitive_p_test (degenerate) [P1/primitive-degree-one-ideals]
example {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CharP R p]
    (P : Pair R) :
    IsPrimitive (p : WittVector p P.plus) ∧
      IsPrimitiveIdeal (Ideal.span {(p : WittVector p P.plus)}) := sorry

-- test Perfectoid.isPrimitive_iff_associated_test (characterisation)
--   [P1/primitive-degree-one-ideals]
example (ε : (Pair.powerBounded (tilt p ℂ_[p])).plus)
    (hε : ∀ n, IsPrimitiveRoot (tilt.coeff n (ε : tilt p ℂ_[p])) (p ^ (n + 1))) :
    ∃ (u : (WittVector p (Pair.powerBounded (tilt p ℂ_[p])).plus)ˣ)
      (ϖ : (Pair.powerBounded (tilt p ℂ_[p])).plus)
      (α : WittVector p (Pair.powerBounded (tilt p ℂ_[p])).plus),
      IsPseudoUniformizer (ϖ : tilt p ℂ_[p]) ∧
      ∑ i ∈ Finset.range p, WittVector.teichmuller p ε ^ i =
        u * ((p : WittVector p (Pair.powerBounded (tilt p ℂ_[p])).plus) +
          WittVector.teichmuller p ϖ * α) := sorry

end PrimitiveTests

/-! ## PerfectoidSpaces:P1/distinguished-element-criterion (lemma) -/

section Distinguished

variable {p : ℕ} [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  [CharP R p] {P : Pair R}

/-- P1/distinguished-element-criterion (a) (ECD Lemma 3.16, with `α ∈ W(R⁺)`; Berkeley Lemma
6.2.10): `p + [ϖ] α` is a nonzerodivisor of `W(R⁺)` for a pseudo-uniformizer `ϖ ∈ R⁺`. -/
theorem isRegular_p_add_teichmuller_mul (ϖ : P.plus) (hϖ : IsPseudoUniformizer (ϖ : R))
    (α : WittVector p P.plus) :
    IsRegular ((p : WittVector p P.plus) + WittVector.teichmuller p ϖ * α) := sorry

/-- P1/distinguished-element-criterion (b) (AWS Remark 2.3.5): two primitive elements generating
comparable ideals are associate. -/
theorem IsPrimitive.associated_of_span_le {ξ ξ' : WittVector p P.plus} (hξ : IsPrimitive ξ)
    (hξ' : IsPrimitive ξ') (h : Ideal.span {ξ'} ≤ Ideal.span {ξ}) : Associated ξ ξ' := sorry

/- REV-FIX-RT-AREA-padic-2~3 acceptance correction: in W(𝒪_{ℂ_p♭}),
p − [p♭] and ξ_cyc = ∑_{i<p}[ε]^{i/p} generate the same theta kernel, hence
are associates. They are not an example of incomparable primitive ideals.
The product μ = [ε] − 1 = ([ε]^{1/p} − 1) * ξ_cyc lies in the kernel but
does not generate it: the first factor is a nonunit, while ξ_cyc is regular.
This is a proposed mathematical negative control, not an elaborated Lean test. -/

end Distinguished

/-! ## PerfectoidSpaces:P1/quotient-by-primitive-element (lemma) -/

section QuotientPrimitive

variable {p : ℕ} [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  [CharP R p] {P : Pair R}

/-- P1/quotient-by-primitive-element (a), (b), (d) (the facts ECD Lemma 3.14 uses): for `ξ`
primitive and `ϖ ∈ R⁺` a pseudo-uniformizer, `A⁺ = W(R⁺) ⧸ ξ` is `[ϖ]`-torsion free,
`[ϖ]`-adically complete and separated (its `[ϖ]`-adic and `(p, [ϖ])`-adic topologies agree), and
`p`-adically complete. -/
theorem quotient_primitive_isAdicComplete {ξ : WittVector p P.plus} (hξ : IsPrimitive ξ)
    (ϖ : P.plus) (hϖ : IsPseudoUniformizer (ϖ : R)) :
    IsSMulRegular (WittVector p P.plus ⧸ Ideal.span {ξ})
        (Ideal.Quotient.mk (Ideal.span {ξ}) (WittVector.teichmuller p ϖ)) ∧
      IsAdicComplete (Ideal.span {Ideal.Quotient.mk (Ideal.span {ξ}) (WittVector.teichmuller p ϖ)})
        (WittVector p P.plus ⧸ Ideal.span {ξ}) ∧
      IsAdicComplete (Ideal.span {(p : WittVector p P.plus ⧸ Ideal.span {ξ})})
        (WittVector p P.plus ⧸ Ideal.span {ξ}) := sorry

/-- P1/quotient-by-primitive-element (c): `A⁺ ⧸ [ϖ] ≅ W(R⁺) ⧸ (p, [ϖ]) = R⁺ ⧸ ϖ`. -/
def quotientPrimitiveQuotEquiv {ξ : WittVector p P.plus} (hξ : IsPrimitive ξ) (ϖ : P.plus) :
    (WittVector p P.plus ⧸ Ideal.span {ξ}) ⧸
        Ideal.span {Ideal.Quotient.mk (Ideal.span {ξ}) (WittVector.teichmuller p ϖ)} ≃+*
      P.plus ⧸ Ideal.span {ϖ} := sorry

/-- P1/quotient-by-primitive-element (e): `ξ W(R⁺)[1/[ϖ]] ∩ W(R⁺) = ξ W(R⁺)`. -/
theorem mem_span_of_teichmuller_pow_mul_mem {ξ : WittVector p P.plus} (hξ : IsPrimitive ξ)
    (ϖ : P.plus) (hϖ : IsPseudoUniformizer (ϖ : R)) (x : WittVector p P.plus) (n : ℕ)
    (hx : WittVector.teichmuller p ϖ ^ n * x ∈ Ideal.span {ξ}) : x ∈ Ideal.span {ξ} := sorry

end QuotientPrimitive

/-! ## PerfectoidSpaces:P1/fontaine-theta-comparison-with-mathlib (comparison) -/

section Theta

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  [Nontrivial R]

/-- P1/fontaine-theta-comparison-with-mathlib (data): Fontaine's `θ : W(R♭⁺) → R⁺`,
`Σ pⁿ [rₙ] ↦ Σ pⁿ rₙ♯` (ECD before Lemma 3.14): Mathlib's `WittVector.fontaineTheta R⁺ p` on
`W(PreTilt R⁺ p)` transported along `R♭⁺ ≃+* PreTilt R⁺ p` (`Pair.tiltPlusEquivPreTilt`); the
standing hypotheses of Mathlib are supplied by P1/integral-elements-adically-complete. -/
def theta (P : Pair R) : WittVector p (Pair.tilt p P).plus →+* P.plus :=
  (WittVector.fontaineTheta P.plus p).comp
    (WittVector.map (Pair.tiltPlusEquivPreTilt p P).toRingHom)

/-- P1/fontaine-theta-comparison-with-mathlib: `θ [x] = x♯` (Mathlib
`WittVector.fontaineTheta_teichmuller`). -/
theorem theta_teichmuller (P : Pair R) (x : (Pair.tilt p P).plus) :
    ((theta p P (WittVector.teichmuller p x) : P.plus) : R) = tilt.sharp (x : tilt p R) := sorry

/-- P1/fontaine-theta-comparison-with-mathlib: `θ mod p` is `x ↦ x₀♯ mod p` (Mathlib
`WittVector.mk_fontaineTheta`). -/
theorem mk_theta (P : Pair R) (x : WittVector p (Pair.tilt p P).plus) :
    Ideal.Quotient.mk (Ideal.span {(p : P.plus)}) (theta p P x) =
      PreTilt.coeff 0 (Pair.tiltPlusEquivPreTilt p P (x.coeff 0)) := sorry

/-- P1/fontaine-theta-comparison-with-mathlib: `θ` is surjective (Mathlib
`surjective_fontaineTheta`, Frobenius being surjective on `R⁺ ⧸ p` by
P1/frobenius-surjective-on-plus-ring). -/
theorem theta_surjective (P : Pair R) : Function.Surjective (theta p P) := sorry

/-- P1/fontaine-theta-comparison-with-mathlib: `θ` is the unique ring homomorphism
`W(R♭⁺) → R⁺` lifting `x ↦ x₀♯ mod p` (AWS Lemma 2.2.7, Definition 2.7.3). -/
theorem theta_unique (P : Pair R) (g : WittVector p (Pair.tilt p P).plus →+* P.plus)
    (hg : ∀ x, Ideal.Quotient.mk (Ideal.span {(p : P.plus)}) (g x) =
      Ideal.Quotient.mk (Ideal.span {(p : P.plus)}) (theta p P x)) : g = theta p P := sorry

end Theta

/-! ## PerfectoidSpaces:P1/fontaine-theta-and-primitive-kernel (theorem) -/

section ThetaKernel

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  [Nontrivial R]

/-- P1/fontaine-theta-and-primitive-kernel (b) (ECD Lemma 3.14; Berkeley Lemma 6.2.8; AWS Lemma
2.7.5): `ker θ` is generated by a primitive nonzerodivisor `ξ = p + [ϖ♭] α`, `ϖ♭ ∈ R♭⁺` a
pseudo-uniformizer. -/
theorem ker_theta_eq_span (P : Pair R) :
    ∃ ξ : WittVector p (Pair.tilt p P).plus, IsPrimitive ξ ∧ IsRegular ξ ∧
      RingHom.ker (theta p P) = Ideal.span {ξ} ∧
      ∃ (ϖ : (Pair.tilt p P).plus) (α : WittVector p (Pair.tilt p P).plus),
        IsPseudoUniformizer (ϖ : tilt p R) ∧ ξ = p + WittVector.teichmuller p ϖ * α := sorry

/-- P1/fontaine-theta-and-primitive-kernel: `ker θ` is a primitive ideal. -/
theorem isPrimitiveIdeal_ker_theta (P : Pair R) : IsPrimitiveIdeal (RingHom.ker (theta p P)) :=
  sorry

/-- P1/fontaine-theta-and-primitive-kernel (c) (BMS1 Remark 3.11): an element of `ker θ` generates
`ker θ` iff it is primitive. -/
theorem span_eq_ker_theta_iff (P : Pair R) {ξ : WittVector p (Pair.tilt p P).plus}
    (hξ : ξ ∈ RingHom.ker (theta p P)) :
    Ideal.span {ξ} = RingHom.ker (theta p P) ↔ IsPrimitive ξ := sorry

/-- P1/primitive-degree-one-ideals (compatibility): a generator of `ker θ` is primitive iff it is
distinguished in the sense of BMS1 Remark 3.11 (and of PerfectoidQuotients Q0): its first Witt
coordinate is a unit; for elements of `ker θ` the conditions coincide
(P1/fontaine-theta-and-primitive-kernel). -/
theorem IsPrimitiveIdeal.iff_distinguished (P : Pair R) {ξ : WittVector p (Pair.tilt p P).plus}
    (hξ : ξ ∈ RingHom.ker (theta p P)) : IsPrimitive ξ ↔ IsUnit (ξ.coeff 1) := sorry

/-- P1/fontaine-theta-and-primitive-kernel (d): `θ` extends to a surjection
`W(R♭⁺)[1/[ϖ♭]] → R` with kernel `ξ W(R♭⁺)[1/[ϖ♭]]`. -/
def thetaAway (P : Pair R) (ϖ : PseudoUniformizerRoots p R) :
    Localization.Away (WittVector.teichmuller p
      (⟨ϖ.toTilt, ϖ.toTilt_mem_tilt_plus p P⟩ : (Pair.tilt p P).plus)) →+* R := sorry

/-- P1/fontaine-theta-and-primitive-kernel (d): `thetaAway` is surjective, with kernel generated
by (the image of) a generator of `ker θ`. -/
theorem thetaAway_surjective (P : Pair R) (ϖ : PseudoUniformizerRoots p R) :
    Function.Surjective (thetaAway p P ϖ) ∧
      RingHom.ker (thetaAway p P ϖ) = (RingHom.ker (theta p P)).map (algebraMap _ _) := sorry

/-- P1/fontaine-theta-and-primitive-kernel: if `pR = 0` then `ker θ = (p)`. -/
theorem ker_theta_of_charP [CharP R p] (P : Pair R) :
    RingHom.ker (theta p P) = Ideal.span {(p : WittVector p (Pair.tilt p P).plus)} := sorry

end ThetaKernel

/-! ## PerfectoidSpaces:P1/theta-kernel-base-change (lemma) -/

section ThetaBaseChange

variable (p : ℕ) [Fact p.Prime] {R S : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  [Nontrivial R] [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S]
  [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S] [Nontrivial S]

/-- P1/theta-kernel-base-change (data): the tilt `R♭⁺ → S♭⁺` of a morphism of perfectoid
pairs. -/
def Pair.tiltPlusHom {P : Pair R} {Q : Pair S} (f : Pair.Hom P Q) :
    (Pair.tilt p P).plus →+* (Pair.tilt p Q).plus :=
  (Pair.tiltHom p f).toRingHom.restrict _ _ (Pair.tiltHom p f).map_mem_plus

/-- P1/theta-kernel-base-change: `θ_S ∘ W(f♭) = f ∘ θ_R`, and
`ker θ_S = W(f♭)(ker θ_R) W(S♭⁺)`: every generator of `ker θ_R` maps to one of `ker θ_S`
(PadicHodgeTheory R06.1 for a perfectoid base field). -/
theorem theta_comp_map {P : Pair R} {Q : Pair S} (f : Pair.Hom P Q) :
    (theta p Q).comp (WittVector.map (Pair.tiltPlusHom p f)) =
        (f.toRingHom.restrict _ _ f.map_mem_plus).comp (theta p P) ∧
      RingHom.ker (theta p Q) =
        (RingHom.ker (theta p P)).map (WittVector.map (Pair.tiltPlusHom p f)) := sorry

end ThetaBaseChange

/-! ## PerfectoidSpaces:P1/sharp-approximation-lemma (lemma) -/

section SharpApproximation

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]

/-- P1/sharp-approximation-lemma (c) (AWS Lemma 2.6.9, KL II Lemma 3.2.7): every `a ∈ R` is
approximated by a sharp: `|a - y♯| ≤ |p| |a|` for some `y ∈ R♭`, so `|y| = |a|`; for `a ∈ R°`,
`y ∈ R♭°`. -/
theorem tilt.exists_sharp_approx (ϖ : PseudoUniformizerRoots p R) (a : R) :
    ∃ y : tilt p R, ϖ.gauge (a - tilt.sharp y) ≤ ϖ.gauge (p : R) * ϖ.gauge a ∧
      ϖ.tiltRoots.gauge y = ϖ.gauge a ∧
      (a ∈ powerBoundedSubring R → y ∈ powerBoundedSubring (tilt p R)) := sorry

/-- P1/sharp-approximation-lemma (e): quasi-additivity of `♯`:
`|(x + y)♯ - x♯ - y♯| ≤ |p| max(|x|, |y|)`. -/
theorem tilt.gauge_sharp_add_sub_le (ϖ : PseudoUniformizerRoots p R) (x y : tilt p R) :
    ϖ.gauge (tilt.sharp (x + y) - tilt.sharp x - tilt.sharp y) ≤
      ϖ.gauge (p : R) * max (ϖ.tiltRoots.gauge x) (ϖ.tiltRoots.gauge y) := sorry

/-- P1/sharp-approximation-lemma (b): `|θ(x)| ≤ |x|` for the Gauss norm
`|Σ pⁿ [xₙ]| = sup |xₙ|` (with equality for prepared `x`, so the quotient norm of the Gauss norm
on `W^b(R♭) ⧸ (z) ≅ R` is the spectral gauge; AWS Lemma 2.6.7); here for finite Teichmüller
sums. -/
theorem theta_gauge_le [Nontrivial R] (ϖ : PseudoUniformizerRoots p R)
    (x : ℕ → (Pair.tilt p (Pair.powerBounded R)).plus) (N : ℕ) :
    ϖ.gauge ((theta p (Pair.powerBounded R) (∑ n ∈ Finset.range N,
        (p : WittVector p (Pair.tilt p (Pair.powerBounded R)).plus) ^ n *
          WittVector.teichmuller p (x n)) : powerBoundedSubring R) : R) ≤
      (Finset.range N).sup fun n ↦ ϖ.tiltRoots.gauge (x n : tilt p R) := sorry

-- Part (d) of P1/sharp-approximation-lemma (the pointwise form on the Gel'fand spectrum `M(A)`)
--   is not stated here; it needs the Berkovich spectrum of bounded multiplicative seminorms and
--   the maximum formula for the spectral seminorm (supplier: TropicalAndBerkovichArithmetic:TB.0).

end SharpApproximation

/-! ## PerfectoidSpaces:P1/untilt-construction (construction) -/

section Untilt

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]

/-- P1/untilt-construction (data): the multiplicative set of `W(R⁺)` generated by the Teichmüller
lifts `[ϖ]` of all pseudo-uniformizers `ϖ ∈ R⁺`; inverting it is inverting one `[ϖ]`, since any
two pseudo-uniformizers divide powers of each other in `R⁺`. -/
def teichmullerPseudoUniformizers (P : Pair R) : Submonoid (WittVector p P.plus) :=
  Submonoid.closure
    {w | ∃ ϖ : P.plus, IsPseudoUniformizer (ϖ : R) ∧ w = WittVector.teichmuller p ϖ}

/-- P1/untilt-construction (data): `W^b(R) = W(R⁺)[1/[ϖ]]`, independent of `ϖ` (and of `R⁺`
up to the evident inclusions, P1/witt-vectors-of-perfect-plus-ring (f)). -/
abbrev boundedWitt (P : Pair R) : Type _ := Localization (teichmullerPseudoUniformizers p P)

/-- P1/untilt-construction (data): the untilt `A = W(R⁺)[1/[ϖ]] ⧸ J` of a perfectoid pair
`(R, R⁺)` of characteristic `p` along a primitive ideal `J ⊆ W(R⁺)`: the localisation of
`A⁺ = W(R⁺) ⧸ J` at the images of all `[ϖ]`, so that no choice of `ϖ` enters (ECD proof of
Theorem 3.17; KL II Lemma 3.3.7; AWS Definition 2.3.14). -/
def untilt (P : Pair R) (J : Ideal (WittVector p P.plus)) : Type _ :=
  Localization ((teichmullerPseudoUniformizers p P).map (Ideal.Quotient.mk J))

namespace untilt

variable (P : Pair R) (J : Ideal (WittVector p P.plus))

/-- P1/untilt-construction (instance): the ring structure of the untilt (a localisation). -/
instance instCommRing : CommRing (untilt p P J) := inferInstanceAs (CommRing (Localization _))

/-- P1/untilt-construction (instance): the untilt is a `W(R⁺) ⧸ J`-algebra. -/
instance instAlgebra : Algebra (WittVector p P.plus ⧸ J) (untilt p P J) :=
  inferInstanceAs (Algebra _ (Localization _))

/-- P1/untilt-construction (instance): the untilt is the localisation of `W(R⁺) ⧸ J` at the
Teichmüller lifts of the pseudo-uniformizers. -/
instance instIsLocalization :
    IsLocalization ((teichmullerPseudoUniformizers p P).map (Ideal.Quotient.mk J))
      (untilt p P J) :=
  inferInstanceAs (IsLocalization ((teichmullerPseudoUniformizers p P).map (Ideal.Quotient.mk J))
    (Localization ((teichmullerPseudoUniformizers p P).map (Ideal.Quotient.mk J))))

/-- P1/untilt-construction (instance): the topology of the untilt, in which `A⁺` is open with its
`π`-adic (equivalently `(p, [ϖ])`-adic) topology, `π` the image of `[ϖ]`. -/
instance instUniformSpace [IsPerfectoidTateRing p R] [CharP R p] [Fact (IsPrimitiveIdeal J)] :
    UniformSpace (untilt p P J) := sorry

variable [IsPerfectoidTateRing p R] [CharP R p] [Fact (IsPrimitiveIdeal J)]

/-- P1/untilt-construction (instance): the uniformity is that of the additive group. -/
instance instIsUniformAddGroup : IsUniformAddGroup (untilt p P J) := sorry

/-- P1/untilt-construction (instance): the untilt is a topological ring. -/
instance instIsTopologicalRing : IsTopologicalRing (untilt p P J) := sorry

/-- P1/untilt-construction (instance): the untilt is a Tate ring with pair of definition
`(A⁺, π A⁺)` and pseudo-uniformizer `π`, independent of `ϖ`. -/
instance instIsTateRing : IsTateRing (untilt p P J) := sorry

/-- P1/untilt-construction (instance): the untilt is complete. -/
instance instCompleteSpace : CompleteSpace (untilt p P J) := sorry

/-- P1/untilt-construction (instance): the untilt is Hausdorff. -/
instance instT2Space : T2Space (untilt p P J) := sorry

/-- P1/untilt-construction (instance): the untilt is a perfectoid Tate ring
(P1/untilt-is-perfectoid-pair; KL II Theorem 3.3.8, AWS Lemmas 2.6.14 and 2.7.9). -/
instance isPerfectoidTateRing : IsPerfectoidTateRing p (untilt p P J) := sorry

end untilt

/-- P1/untilt-construction (data): the plus ring `A⁺ ⊆ A`, the image of `W(R⁺) ⧸ J`. -/
def untiltPlus (P : Pair R) (J : Ideal (WittVector p P.plus)) : Subring (untilt p P J) :=
  (algebraMap (WittVector p P.plus ⧸ J) (untilt p P J)).range

namespace untilt

variable (P : Pair R) (J : Ideal (WittVector p P.plus))

/-- P1/untilt-construction (projection): `θ_J : W^b(R) = W(R⁺)[1/[ϖ]] →+* A`, surjective with
kernel `J · W^b(R)`. -/
def mk : boundedWitt p P →+* untilt p P J :=
  IsLocalization.map (M := teichmullerPseudoUniformizers p P) (untilt p P J) (Ideal.Quotient.mk J)
    (Submonoid.le_comap_map _)

/-- P1/untilt-construction (projection): `θ_J` is surjective with kernel `J · W^b(R)`. -/
theorem mk_surjective : Function.Surjective (mk p P J) ∧
    RingHom.ker (mk p P J) = J.map (algebraMap (WittVector p P.plus) (boundedWitt p P)) := sorry

variable [IsPerfectoidTateRing p R] [CharP R p]

/-- P1/untilt-construction (data): `♯_J : R →* A`, `x ↦ θ_J([x])` (extended from `R⁺` by
`♯_J(ϖ⁻¹ x) = ♯_J(ϖ)⁻¹ ♯_J(x)`); continuous and multiplicative, with `♯_J(ϖ)` a
pseudo-uniformizer. -/
def sharp [Fact (IsPrimitiveIdeal J)] : R →* untilt p P J := sorry

/-- P1/untilt-construction (data): on `R⁺`, `♯_J x = θ_J([x])`; `♯_J` is continuous and `♯_J ϖ` is
a pseudo-uniformizer. -/
theorem sharp_spec [Fact (IsPrimitiveIdeal J)] (x : P.plus) :
    sharp p P J (x : R) = algebraMap _ _ (Ideal.Quotient.mk J (WittVector.teichmuller p x)) ∧
      Continuous (sharp p P J) ∧
      (IsPseudoUniformizer (x : R) → IsPseudoUniformizer (sharp p P J (x : R))) := sorry

/-- P1/untilt-construction (characterisation): `A⁺ ⧸ ♯_J(ϖ) ≃+* R⁺ ⧸ ϖ`, with `A⁺ = W(R⁺) ⧸ J`
(P1/quotient-by-primitive-element (c)). -/
def quotEquiv [Fact (IsPrimitiveIdeal J)] (ϖ : P.plus) (hϖ : IsPseudoUniformizer (ϖ : R)) :
    (WittVector p P.plus ⧸ J) ⧸ Ideal.span {Ideal.Quotient.mk J (WittVector.teichmuller p ϖ)} ≃+*
      P.plus ⧸ Ideal.span {ϖ} := sorry

/-- P1/untilt-construction (functoriality): a morphism of triples, a morphism `f` of perfectoid
pairs of characteristic `p` with `W(f)(J) ⊆ J'` (then `J' = W(f)(J) W(R'⁺)`), induces a continuous
ring homomorphism of untilts; `map_id`, `map_comp` hold. -/
def map {R' : Type*} [CommRing R'] [UniformSpace R'] [IsUniformAddGroup R'] [IsTopologicalRing R']
    [IsTateRing R'] [CompleteSpace R'] [T2Space R'] [IsPerfectoidTateRing p R'] [CharP R' p]
    {P' : Pair R'} (f : Pair.Hom P P') (J' : Ideal (WittVector p P'.plus))
    (hJ : J.map (WittVector.map (f.toRingHom.restrict _ _ f.map_mem_plus)) ≤ J') :
    untilt p P J →+* untilt p P' J' := sorry

/-- P1/untilt-construction (other): for any pseudo-uniformizer `ϖ ∈ R⁺`, the untilt is
canonically `(W(R⁺) ⧸ J)[1/[ϖ]]`; composing two of these compares two choices of `ϖ`. -/
def congr_pseudoUniformizer (ϖ : P.plus) (hϖ : IsPseudoUniformizer (ϖ : R)) :
    untilt p P J ≃+* Localization.Away (Ideal.Quotient.mk J (WittVector.teichmuller p ϖ)) :=
  sorry

/-- P1/untilt-construction (equivalence): the tilt of the untilt is `R`, identifying the plus
rings (P1/untilt-is-perfectoid-pair). -/
def tiltEquiv [Fact (IsPrimitiveIdeal J)] : tilt p (untilt p P J) ≃+* R := sorry

/-- P1/untilt-construction (instance): `(p)` is a primitive ideal. -/
instance fact_isPrimitiveIdeal_span_p :
    Fact (IsPrimitiveIdeal (Ideal.span {(p : WittVector p P.plus)})) := ⟨⟨_, isPrimitive_p, rfl⟩⟩

/-- P1/untilt-construction (example): the untilt along `(p)` is `R` itself. -/
def equivSelf : untilt p P (Ideal.span {(p : WittVector p P.plus)}) ≃+* R := sorry

end untilt

end Untilt

section UntiltTests

variable (p : ℕ) [Fact p.Prime]

-- test Perfectoid.untilt_p (degenerate) [P1/untilt-construction]
example {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CharP R p]
    (P : Pair R) :
    ∃ e : untilt p P (Ideal.span {(p : WittVector p P.plus)}) ≃+* R,
      Continuous e ∧ Continuous e.symm ∧
      (untiltPlus p P (Ideal.span {(p : WittVector p P.plus)})).map e.toRingHom = P.plus :=
  sorry

/- For `R = 𝔽_p((t^{1/p^∞}))^` and `J = (p - [t])` the untilt is the completion of
`ℚ_p(p^{1/p^∞})` (AWS Example 2.3.7); in general `♯_J t = p`. -/
-- test Perfectoid.untilt_pflat (computation) [P1/untilt-construction]
example {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CharP R p]
    (P : Pair R) (t : P.plus) (ht : IsPseudoUniformizer (t : R))
    [Fact (IsPrimitiveIdeal (Ideal.span
      {(p : WittVector p P.plus) - WittVector.teichmuller p t}))] :
    untilt.sharp p P (Ideal.span {(p : WittVector p P.plus) - WittVector.teichmuller p t})
      (t : R) = p := sorry

/- `J = (Σ_{i<p} [ε^{1/p}]^i)` in `W(𝒪_{ℚ_p^cycl♭})`: the untilt is `ℚ_p^cycl` (AWS Example
2.3.8). -/
-- test Perfectoid.untilt_cyclotomic (computation) [P1/untilt-construction]
example (ε : (Pair.powerBounded (tilt p (padicCyclotomic p))).plus)
    (hε : ∀ n, IsPrimitiveRoot (tilt.coeff n (ε : tilt p (padicCyclotomic p))) (p ^ (n + 1)))
    [Fact (IsPrimitiveIdeal (Ideal.span
      {∑ i ∈ Finset.range p, WittVector.teichmuller p ε ^ i}))] :
    Nonempty (untilt p (Pair.powerBounded (tilt p (padicCyclotomic p)))
      (Ideal.span {∑ i ∈ Finset.range p, WittVector.teichmuller p ε ^ i}) ≃+*
        padicCyclotomic p) := sorry

/- `J = (p²)` is not primitive: the same construction is not reduced (`p ≠ 0 = p²`). -/
-- test Perfectoid.untilt_not_primitive (non-example) [P1/untilt-construction]
example {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CharP R p]
    [Nontrivial R] (P : Pair R) :
    ¬ IsReduced (untilt p P (Ideal.span {(p : WittVector p P.plus) ^ 2})) ∧
      ¬ IsPrimitiveIdeal (Ideal.span {(p : WittVector p P.plus) ^ 2}) := sorry

/- `J = (p - [p♭]) ⊆ W(𝒪_{ℂ_p♭})`: `A⁺ ⧸ [p♭] ≅ 𝒪_{ℂ_p♭} ⧸ p♭ ≅ 𝒪_{ℂ_p} ⧸ p`. -/
-- test Perfectoid.untilt_quotEquiv_test (characterisation) [P1/untilt-construction]
example (pflat : (Pair.powerBounded (tilt p ℂ_[p])).plus)
    (hp : tilt.sharp (pflat : tilt p ℂ_[p]) = p)
    [Fact (IsPrimitiveIdeal (Ideal.span
      {(p : WittVector p (Pair.powerBounded (tilt p ℂ_[p])).plus) -
        WittVector.teichmuller p pflat}))] :
    Nonempty ((WittVector p (Pair.powerBounded (tilt p ℂ_[p])).plus ⧸
        Ideal.span {(p : WittVector p (Pair.powerBounded (tilt p ℂ_[p])).plus) -
          WittVector.teichmuller p pflat}) ⧸
        Ideal.span {Ideal.Quotient.mk (Ideal.span
          {(p : WittVector p (Pair.powerBounded (tilt p ℂ_[p])).plus) -
            WittVector.teichmuller p pflat}) (WittVector.teichmuller p pflat)} ≃+*
      powerBoundedSubring ℂ_[p] ⧸ Ideal.span {(p : powerBoundedSubring ℂ_[p])}) := sorry

end UntiltTests

/-! ## PerfectoidSpaces:P1/untilt-tilt-identification (lemma) -/

section UntiltTilt

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  [CharP R p] (P : Pair R) (J : Ideal (WittVector p P.plus)) [Fact (IsPrimitiveIdeal J)]

/-- P1/untilt-tilt-identification (a): `x ↦ (θ_J([x^{1/pⁿ}]))ₙ` followed by reduction is a ring
isomorphism `R⁺ ≅ lim_Φ A⁺/p = PreTilt A⁺ p` (KL II Lemma 3.3.7). -/
def untilt.plusPreTiltEquiv [Fact (¬ IsUnit (p : WittVector p P.plus ⧸ J))] :
    P.plus ≃+* PreTilt (WittVector p P.plus ⧸ J) p := sorry

/-- P1/untilt-tilt-identification (b): under `untilt.plusPreTiltEquiv`, Mathlib's
`WittVector.fontaineTheta` for `A⁺ = W(R⁺) ⧸ J` is the quotient map, so `ker θ_{A⁺} = J`. -/
theorem untilt.fontaineTheta_comp [Fact (¬ IsUnit (p : WittVector p P.plus ⧸ J))]
    [IsAdicComplete (Ideal.span {(p : WittVector p P.plus ⧸ J)}) (WittVector p P.plus ⧸ J)] :
    (WittVector.fontaineTheta (WittVector p P.plus ⧸ J) p).comp
        (WittVector.map (untilt.plusPreTiltEquiv p P J).toRingHom) = Ideal.Quotient.mk J :=
  sorry

/-- P1/untilt-tilt-identification (a): `A⁺ ⧸ p ≅ R⁺ ⧸ ξ₀` for a generator `ξ` of `J`, and
Frobenius is surjective on `A⁺ ⧸ p`. -/
def untilt.quotPEquiv (ξ : WittVector p P.plus) (hJ : J = Ideal.span {ξ}) :
    ModP (WittVector p P.plus ⧸ J) p ≃+* P.plus ⧸ Ideal.span {ξ.coeff 0} := sorry

/-- P1/untilt-tilt-identification (c): `R ≅ lim_{x ↦ x^p} A` as monoids (KL II Lemma 3.3.7, AWS
Definition 2.3.14: `♯ = θ ∘ [·]`). -/
def untilt.perfectionMulEquiv : R ≃* Perfection (untilt p P J) p := sorry

end UntiltTilt

/-! ## PerfectoidSpaces:P1/perfectoid-tate-ring-from-integral-perfectoid (lemma) -/

/-- P1/perfectoid-tate-ring-from-integral-perfectoid (BMS1 Lemmas 3.9, 3.10, 3.21): let `R` be a
complete Hausdorff Tate ring with an open subring `R₀` carrying the `π`-adic topology,
`π ∈ R₀` a pseudo-uniformizer with `R = R₀[1/π]`, `π ^ p ∣ p` in `R₀`, `R₀` `π`-adically complete
with Frobenius surjective on `R₀/p` and `Φ : R₀/π → R₀/π^p` bijective. Then `R` is perfectoid,
`R₀ ⊆ R°` and `π R° ⊆ R₀` (`R°` is the ring of almost elements of `R₀`). -/
theorem isPerfectoidTateRing_of_integral (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R]
    [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R]
    [T2Space R] (R₀ : Subring R) (π : R₀) (hopen : IsOpen (R₀ : Set R))
    (hadic : IsAdic (Ideal.span {π})) (hπ : IsPseudoUniformizer (π : R))
    (hloc : @IsLocalization.Away R₀ _ π R _ R₀.subtype.toAlgebra)
    (hdvd : π ^ p ∣ (p : R₀)) (hcompl : IsAdicComplete (Ideal.span {π}) R₀)
    (hF : Function.Surjective fun x : ModP R₀ p ↦ x ^ p)
    (hΦ : Function.Bijective (frobeniusModPow p π hdvd)) :
    IsPerfectoidTateRing p R ∧ R₀ ≤ powerBoundedSubring R ∧
      ∀ x ∈ powerBoundedSubring R, (π : R) * x ∈ R₀ := sorry

/-! ## PerfectoidSpaces:P1/untilt-is-perfectoid-pair (theorem) -/

section UntiltPair

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  [CharP R p] (P : Pair R) (J : Ideal (WittVector p P.plus)) [Fact (IsPrimitiveIdeal J)]

/-- P1/untilt-is-perfectoid-pair: the perfectoid Huber pair `(A, A⁺)` of the untilt: `A⁺ =
W(R⁺) ⧸ J` is a ring of integral elements (open, integrally closed, in `A°`) (KL II Theorem
3.3.8, AWS Lemmas 2.6.14 and 2.7.9). -/
def untilt.pair : Pair (untilt p P J) where
  plus := untiltPlus p P J
  isRingOfIntegralElements := sorry

/-- P1/untilt-is-perfectoid-pair: `A° ⧸ A⁺` is almost zero: `♯_J(ϖ^{1/pⁿ}) A° ⊆ A⁺`. -/
theorem untilt.sharp_root_mul_mem (ϖ : PseudoUniformizerRoots p R) (n : ℕ) {x : untilt p P J}
    (hx : x ∈ powerBoundedSubring (untilt p P J)) :
    untilt.sharp p P J (ϖ.root n) * x ∈ untiltPlus p P J := sorry

/-- P1/untilt-is-perfectoid-pair: `(R, R⁺) ≅ (A♭, A♭⁺)` as perfectoid pairs, and under this
identification `ker θ_A = J` (the converse functor of ECD Theorem 3.17, Berkeley Theorem 6.2.11
"with its topology and plus ring"). -/
theorem untilt.tiltPair_spec [Nontrivial (untilt p P J)] :
    (∃ e : tilt p (untilt p P J) ≃+* R, Continuous e ∧ Continuous e.symm ∧
      ∀ x, x ∈ (Pair.tilt p (untilt.pair p P J)).plus ↔ e x ∈ P.plus) ∧
    ∃ e' : (Pair.tilt p (untilt.pair p P J)).plus ≃+* P.plus,
      (RingHom.ker (theta p (untilt.pair p P J))).map (WittVector.map e'.toRingHom) = J := sorry

end UntiltPair

/-! ## PerfectoidSpaces:P1/untilts-classified-by-primitive-ideals (theorem) -/

section Classification

variable (p : ℕ) [Fact p.Prime] {S : Type*} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
  [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S]
  [Nontrivial S]

/-- P1/untilts-classified-by-primitive-ideals (instance): `ker θ` is primitive
(P1/fontaine-theta-and-primitive-kernel). -/
instance fact_isPrimitiveIdeal_ker_theta (Q : Pair S) :
    Fact (IsPrimitiveIdeal (RingHom.ker (theta p Q))) :=
  ⟨isPrimitiveIdeal_ker_theta p Q⟩

/-- P1/untilts-classified-by-primitive-ideals (ECD Theorem 3.17; KL II Theorem 3.3.8; AWS Theorem
2.3.9; Berkeley Theorem 6.2.11): the unit `W(S♭⁺)[1/[ϖ♭]] ⧸ ker θ ≅ S` of the equivalence between
perfectoid pairs `(S, S⁺)` and triples `(R, R⁺, J)`, induced by `θ_S`; the counit is
`untilt.tiltEquiv` (P1/untilt-is-perfectoid-pair). Both are natural; characteristic-`p` pairs
correspond to `J = (p)`. -/
def untiltTiltEquiv (Q : Pair S) : untilt p (Pair.tilt p Q) (RingHom.ker (theta p Q)) ≃+* S :=
  sorry

/-- P1/untilts-classified-by-primitive-ideals: the unit is a topological isomorphism of perfectoid
pairs, carrying `A⁺ = W(S♭⁺) ⧸ ker θ` onto `S⁺`. -/
theorem untiltTiltEquiv_spec (Q : Pair S) :
    Continuous (untiltTiltEquiv p Q) ∧ Continuous (untiltTiltEquiv p Q).symm ∧
      (untiltPlus p (Pair.tilt p Q) (RingHom.ker (theta p Q))).map
        (untiltTiltEquiv p Q).toRingHom = Q.plus := sorry

end Classification

/-! ## PerfectoidSpaces:P1/marked-untilt (definition) -/

section Marked

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  [CharP R p]

/-- P1/marked-untilt (structure): a *marked untilt* of a perfectoid pair `(R, R⁺)` of
characteristic `p`: a perfectoid pair `(S, S⁺)` with an isomorphism of Huber pairs
`ι : (S♭, S♭⁺) ≅ (R, R⁺)` (a topological ring isomorphism matching the plus rings). -/
structure MarkedUntilt (P : Pair R) : Type (u + 1) where
  /-- The untilt `S`. -/
  S : Type u
  /-- The ring structure. -/
  [commRing : CommRing S]
  /-- The uniformity. -/
  [uniformSpace : UniformSpace S]
  /-- The uniformity is that of the additive group. -/
  [isUniformAddGroup : IsUniformAddGroup S]
  /-- A topological ring. -/
  [isTopologicalRing : IsTopologicalRing S]
  /-- A Tate ring. -/
  [isTateRing : IsTateRing S]
  /-- Complete. -/
  [completeSpace : CompleteSpace S]
  /-- Hausdorff. -/
  [t2Space : T2Space S]
  /-- Perfectoid. -/
  [isPerfectoidTateRing : IsPerfectoidTateRing p S]
  /-- The ring of integral elements `S⁺`. -/
  plus : Pair S
  /-- The marking `ι : S♭ ≃+* R`. -/
  marking : tilt p S ≃+* R
  /-- `ι` is continuous. -/
  continuous_marking : Continuous marking
  /-- `ι⁻¹` is continuous. -/
  continuous_marking_symm : Continuous marking.symm
  /-- `ι` carries `S♭⁺` onto `R⁺`. -/
  marking_plus : ∀ x, x ∈ (Pair.tilt p plus).plus ↔ marking x ∈ P.plus

attribute [instance] MarkedUntilt.commRing MarkedUntilt.uniformSpace MarkedUntilt.isUniformAddGroup
  MarkedUntilt.isTopologicalRing MarkedUntilt.isTateRing MarkedUntilt.completeSpace
  MarkedUntilt.t2Space MarkedUntilt.isPerfectoidTateRing

namespace MarkedUntilt

variable {p} {P : Pair R}

/-- P1/marked-untilt (structure): a morphism of marked untilts `(S, S⁺, ι) → (S', S'⁺, ι')`: a
morphism `f` of Huber pairs with `ι' ∘ f♭ = ι`. -/
structure Hom (X Y : MarkedUntilt p P) where
  /-- The morphism of Huber pairs. -/
  hom : Pair.Hom X.plus Y.plus
  /-- Compatibility with the markings. -/
  comm : ∀ x, Y.marking (tilt.map p hom.toRingHom hom.continuous_toRingHom x) = X.marking x

/-- P1/marked-untilt (instance): the category of marked untilts. -/
instance instCategory : Category.{u} (MarkedUntilt p P) where
  Hom X Y := Hom X Y
  id X := ⟨Pair.Hom.id X.plus, sorry⟩
  comp f g := ⟨g.hom.comp f.hom, sorry⟩
  id_comp := sorry
  comp_id := sorry
  assoc := sorry

/-- P1/marked-untilt (data): the marking restricted to the plus rings, `S♭⁺ ≃+* R⁺`. -/
def markingPlus (X : MarkedUntilt p P) : (Pair.tilt p X.plus).plus ≃+* P.plus :=
  X.marking.restrict _ _ X.marking_plus

/-- P1/marked-untilt: a marked untilt of a nonzero ring is nonzero. -/
theorem nontrivial [Nontrivial R] (X : MarkedUntilt p P) : Nontrivial X.S := sorry

/-- P1/marked-untilt (data): the primitive ideal `W(ι)(ker θ_S) ⊆ W(R⁺)` of a marked untilt
(P1/fontaine-theta-and-primitive-kernel). -/
def primitiveIdeal [Nontrivial R] (X : MarkedUntilt p P) : Ideal (WittVector p P.plus) :=
  haveI := X.nontrivial
  (RingHom.ker (theta p X.plus)).map (WittVector.map X.markingPlus.toRingHom)

/-- P1/marked-untilt: `primitiveIdeal X` is a primitive ideal. -/
theorem isPrimitiveIdeal_primitiveIdeal [Nontrivial R] (X : MarkedUntilt p P) :
    IsPrimitiveIdeal X.primitiveIdeal := sorry

variable (p) (P)

/-- P1/marked-untilt (constructor): `J ↦ (untilt P J, A⁺, tiltEquiv)`
(P1/untilt-is-perfectoid-pair). -/
def ofPrimitive (J : Ideal (WittVector p P.plus)) [Fact (IsPrimitiveIdeal J)] :
    MarkedUntilt p P where
  S := untilt p P J
  plus := untilt.pair p P J
  marking := untilt.tiltEquiv p P J
  continuous_marking := sorry
  continuous_marking_symm := sorry
  marking_plus := sorry

variable {p} {P}

/-- P1/marked-untilt (simp): the primitive ideal of `ofPrimitive J` is `J`. -/
@[simp] theorem primitiveIdeal_ofPrimitive [Nontrivial R] (J : Ideal (WittVector p P.plus))
    [Fact (IsPrimitiveIdeal J)] : (ofPrimitive p P J).primitiveIdeal = J := sorry

variable (p) (P)

/-- P1/marked-untilt (equivalence): isomorphism classes of marked untilts correspond to primitive
ideals of `W(R⁺)` (P1/untilts-classified-by-primitive-ideals). -/
def equivPrimitive [Nontrivial R] :
    Quotient (isIsomorphicSetoid (MarkedUntilt p P)) ≃
      {J : Ideal (WittVector p P.plus) // IsPrimitiveIdeal J} := sorry

variable {p} {P}

/-- P1/marked-untilt (characterisation): there is at most one morphism between marked untilts; in
particular a marked untilt has no nontrivial automorphisms. -/
instance subsingleton_hom (X Y : MarkedUntilt p P) : Subsingleton (X ⟶ Y) := sorry

variable (p)

/-- P1/marked-untilt (functoriality): marked untilts pull back along a morphism of perfectoid
pairs of characteristic `p`, `J ↦ J W(R'⁺)`, compatibly with identities and composition up to
unique isomorphism. -/
def pullback {R' : Type u} [CommRing R'] [UniformSpace R'] [IsUniformAddGroup R']
    [IsTopologicalRing R'] [IsTateRing R'] [CompleteSpace R'] [T2Space R']
    [IsPerfectoidTateRing p R'] [CharP R' p] {P' : Pair R'} (f : Pair.Hom P P') :
    MarkedUntilt p P → MarkedUntilt p P' := sorry

variable (P)

/-- P1/marked-untilt (example): the characteristic-`p` untilt `(R, R⁺, id)`. -/
def self : MarkedUntilt p P where
  S := R
  plus := P
  marking := tilt.equivOfCharP
  continuous_marking := sorry
  continuous_marking_symm := sorry
  marking_plus := sorry

/-- P1/marked-untilt (compatibility): marked untilts of `(R, R⁺)` and of `(R, R°)` correspond,
changing plus rings along P1/rings-of-integral-elements-under-tilting. -/
def plusEquiv : MarkedUntilt p P ≃ MarkedUntilt p (Pair.powerBounded R) := sorry

variable {p} {P}

/-- P1/marked-untilt (characterisation): `pS = 0` iff the primitive ideal is `(p)`. -/
theorem charP_iff [Nontrivial R] (X : MarkedUntilt p P) :
    CharP X.S p ↔ X.primitiveIdeal = Ideal.span {(p : WittVector p P.plus)} := sorry

/-- P1/marked-untilt (data): the Frobenius twist `(S, S⁺, φ ∘ ι)` of a marked untilt. -/
def frobeniusTwist (X : MarkedUntilt p P) : MarkedUntilt p P where
  S := X.S
  plus := X.plus
  marking := X.marking.trans (frobeniusEquiv R p)
  continuous_marking := sorry
  continuous_marking_symm := sorry
  marking_plus := sorry

end MarkedUntilt

/-- P1/marked-untilt (example): the canonical marked untilt `(S, S°, id)` of `(S♭, S♭°)` for a
perfectoid Tate ring `S`. -/
def MarkedUntilt.canonical (S : Type u) [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
    [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]
    [IsPerfectoidTateRing p S] : MarkedUntilt p (Pair.powerBounded (tilt p S)) where
  S := S
  plus := Pair.powerBounded S
  marking := RingEquiv.refl _
  continuous_marking := continuous_id
  continuous_marking_symm := continuous_id
  marking_plus := sorry

end Marked

section MarkedTests

variable (p : ℕ) [Fact p.Prime]

-- test Perfectoid.MarkedUntilt.self_primitiveIdeal (degenerate) [P1/marked-untilt]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
