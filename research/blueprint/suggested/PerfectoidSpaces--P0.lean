/-! ## PerfectoidSpaces:P6/adic-spectrum-cardinality (lemma) -/

namespace Perfectoid

section SpaCardinality

variable {A : Type u} [CommRing A] [TopologicalSpace A]

/-- P6/adic-spectrum-cardinality: `#Spa(A, A⁺) ≤ 2 ^ (#A · #A)`: a point of `Spv A` is determined
by its relation `|a(x)| ≤ |b(x)|` (Tau Ceti `ValuationSpectrum.ext'`), so `Spa(A, A⁺)` embeds into
the power set of `A × A` (ECD proof of Proposition 4.4). No hypothesis on `A⁺` or the topology. -/
theorem mk_spa_le (Aplus : Subring A) : #(spa Aplus) ≤ 2 ^ (#A * #A) := sorry

/-- P6/adic-spectrum-cardinality: for infinite `A`, `#Spa(A, A⁺) ≤ 2 ^ #A` (ECD proof of
Proposition 4.4). -/
theorem mk_spa_le_two_power [Infinite A] (Aplus : Subring A) : #(spa Aplus) ≤ 2 ^ #A := sorry

/-- P6/adic-spectrum-cardinality: for an uncountable strong limit κ and `#A < κ`,
`#Spa(A, A⁺) < κ` (ECD proof of Proposition 4.4). -/
theorem mk_spa_lt (Aplus : Subring A) {κ : Cardinal.{u}} (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    (hA : #A < κ) : #(spa Aplus) < κ := sorry

end SpaCardinality

end Perfectoid

