/-! ## PerfectoidSpaces:P2/p-finite-acyclicity-from-tate (lemma) -/

namespace Perfectoid

section PFinite

variable (p : ℕ) [Fact p.Prime]

/-- P2/p-finite-acyclicity-from-tate (supporting definition): a morphism of Huber pairs
`φ : (S, S⁺) → (R, R⁺)` exhibits `(R, R⁺)` as the *completed perfection* of `(S, S⁺)`: `φ` is
injective and `R⁺` is the closure of the perfect closure `{x : x^{pⁿ} ∈ φ(S⁺)}` of `φ(S⁺)`
(so `R⁺` is the `ϖ`-adic completion of `colim_Φ S⁺` and `R = R⁺[1/ϖ]`; Sch12 Definition 6.9). -/
def IsCompletedPerfection {S R : Type*} [CommRing S] [TopologicalSpace S] [IsTopologicalRing S]
    [IsHuberRing S] [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [IsHuberRing R]
    {Q : Pair S} {P : Pair R} (φ : Pair.Hom Q P) : Prop :=
  Function.Injective φ.toRingHom ∧
    (Subring.closure {x : R | ∃ n : ℕ, x ^ p ^ n ∈ Q.plus.map φ.toRingHom}).topologicalClosure =
      P.plus

/-- P2/p-finite-acyclicity-from-tate (definition, Sch12 Definition 6.9): a perfectoid affinoid
`K`-algebra `(R, R⁺)` (`K` perfectoid of characteristic `p`) is *p-finite* if it is the completed
perfection of a reduced affinoid `K`-algebra `(S, S⁺)` topologically of finite type,
including `S⁺ = S°` as required by Sch12 Definition 2.6(iii). -/
def IsPFinite (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] {R : Type u}
    [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [IsHuberRing R] [Algebra K R]
    (P : Pair R) : Prop :=
  ∃ (S : Type u) (_ : CommRing S) (_ : TopologicalSpace S) (_ : IsTopologicalRing S)
    (_ : IsTateRing S) (_ : Algebra K S) (Q : Pair S) (φ : Pair.Hom Q P),
    IsTopologicallyFiniteType (algebraMap K S) ∧ IsReduced S ∧
      Q.plus = powerBoundedSubring S ∧
      (∀ k : K, φ.toRingHom (algebraMap K S k) = algebraMap K R k) ∧ IsCompletedPerfection p φ

variable (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  [CharP K p] [IsPerfectoidField p K]
  {S : Type u} [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S]
  [IsTateRing S] [CompleteSpace S] [T2Space S] [Algebra K S] [IsReduced S]
  {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
  [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  {Q : Pair S} {P : Pair R} (φ : Pair.Hom Q P)

/-- P2/p-finite-acyclicity-from-tate (i): a reduced affinoid `K`-algebra topologically of finite
type is uniform, `S°` bounded (Sch12 proof of Proposition 6.10; AdicSpacesPartII:R0 for BGR 6.2.4
Theorem 1). -/
theorem pFinite_isBounded_powerBoundedSubring_model
    (hS : IsTopologicallyFiniteType (algebraMap K S)) :
    IsBounded (powerBoundedSubring S : Set S) := sorry

/-- P2/p-finite-acyclicity-from-tate (ii): every rational localisation `S⟨T/s⟩` of a reduced
affinoid `K`-algebra is again reduced and topologically of finite type over `K` (Sch12 proof of
Proposition 6.10(ii); BGR 7.3.2 Corollary 10 through Huber Proposition 4.3). -/
theorem pFinite_rationalLoc_model (hS : IsTopologicallyFiniteType (algebraMap K S))
    {D : PairOfDefinition S} (𝔭 : D.Presentation) (hT : Ideal.span (𝔭.num : Set S) = ⊤) :
    IsReduced (RationalLoc 𝔭) ∧
      IsTopologicallyFiniteType ((RationalLoc.toLoc 𝔭).comp (algebraMap K S)) := sorry

/-- P2/p-finite-acyclicity-from-tate (iv): for `(R, R⁺)` the completed perfection of `(S, S⁺)`, the
projection `Spa(R, R⁺) → Spa(S, S⁺)` is a homeomorphism identifying rational subsets (Sch12 proof
of Proposition 6.11(i); Huber Proposition 2.11 through anchor Layer 2). -/
theorem pFinite_spaComap_homeomorph (hφ : IsCompletedPerfection p φ) :
    ∃ e : spa P.plus ≃ₜ spa Q.plus, ⇑e = φ.spaComap ∧
      ∀ U : Set (spa P.plus), U ∈ spaRationalFamily P.plus ↔ e '' U ∈ spaRationalFamily Q.plus :=
  sorry

open scoped Classical in
/-- P2/p-finite-acyclicity-from-tate (v): rational localisation commutes with completed perfection:
for a presentation `(T, s)` of `S` and its image `(φ T, φ s)`, `R⟨φT/φs⟩` is the completed
perfection of `S⟨T/s⟩` (Sch12 proof of Proposition 6.11(i)). -/
theorem pFinite_rationalLoc_completedPerfection (hφ : IsCompletedPerfection p φ)
    {D : PairOfDefinition S} (𝔭 : D.Presentation) {D' : PairOfDefinition R}
    (𝔭' : D'.Presentation) (hnum : 𝔭'.num = 𝔭.num.image φ.toRingHom)
    (hden : 𝔭'.den = φ.toRingHom 𝔭.den) (hT : Ideal.span (𝔭.num : Set S) = ⊤) :
    ∃ ψ : Pair.Hom (RationalLoc.pair 𝔭 Q) (RationalLoc.pair 𝔭' P),
      ψ.toRingHom.comp (RationalLoc.toLoc 𝔭) = (RationalLoc.toLoc 𝔭').comp φ.toRingHom ∧
        IsCompletedPerfection p ψ := sorry

-- Perfectoid.IsPFinite.isAlmostZero_cech: not stated here; clauses (iii) and (vi), the Čech
--   complexes of `O_Y(·)°` and `O_X(·)°ᵃ` on finite rational coverings and `H^i(X, O_X°ᵃ) = 0`,
--   need the restriction maps of the structure presheaf and its cohomology (supplier: AdicSpaces
--   Layer 3, Layer 4.1 for Tate acyclicity).

end PFinite

end Perfectoid

/-! ## PerfectoidSpaces:P2/completed-direct-limits-of-p-finite-affinoids (lemma) -/

namespace Perfectoid

/-- P2/completed-direct-limits-of-p-finite-affinoids (i), (ii), (iv): a perfectoid affinoid
`K`-algebra `(R, R⁺)` of characteristic `p` with `K° → R⁺` is the completion of the filtered
colimit, over the finite subsets `I ⊆ R⁺`, of p-finite perfectoid affinoid `K`-algebras
`(R_I, R_I⁺)` mapping to it (the images are dense); `Spa(R, R⁺) → lim_I Spa(R_I, R_I⁺)` is
injective, every rational `U ⊆ X` is the preimage of a rational `U_I ⊆ X_I`, and a quasi-compact
open of `X_I` containing the image of `X` contains the image of some `X_J`, `J ⊇ I` (Sch12 Lemma
6.13(i), (iv) with proof; proof of Proposition 6.14). Clause (iii), `O_X(U)` as the completed
colimit of the `O_{X_J}(U_J)`, needs presentation-independent rational localisations (supplier:
AdicSpaces Layer 3). -/
theorem exists_pFinite_approximation (p : ℕ) [Fact p.Prime] (K : Type u)
    [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K] [CharP K p]
    [IsPerfectoidField p K] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
    [CharP R p] [Algebra K R] (P : Pair R) (hK : Continuous (algebraMap K R))
    (hKplus : ∀ k : K, ‖k‖ ≤ 1 → algebraMap K R k ∈ P.plus) :
    ∃ (F : Finset P.plus ⥤ PerfectoidRingCat.{u} p) (Q : ∀ I, Pair (F.obj I))
      (ι : ∀ I, Pair.Hom (Q I) P)
      (t : ∀ {I J : Finset P.plus}, (I ⟶ J) → Pair.Hom (Q I) (Q J)),
      (∀ I, ∃ _ : Algebra K (F.obj I), IsPFinite p K (Q I) ∧
        ∀ k : K, (ι I).toRingHom (algebraMap K (F.obj I) k) = algebraMap K R k) ∧
      (∀ {I J : Finset P.plus} (h : I ⟶ J), (t h).toRingHom = (F.map h).hom ∧
        (ι J).toRingHom.comp (t h).toRingHom = (ι I).toRingHom) ∧
      Dense (⋃ I, Set.range (ι I).toRingHom) ∧
      (∀ x y : spa P.plus, (∀ I, (ι I).spaComap x = (ι I).spaComap y) → x = y) ∧
      (∀ U ∈ spaRationalFamily P.plus, ∃ I, ∃ W ∈ spaRationalFamily (Q I).plus,
        U = (ι I).spaComap ⁻¹' W) ∧
      ∀ I (W : Set (spa (Q I).plus)), IsOpen W → IsCompact W →
        Set.range (ι I).spaComap ⊆ W → ∃ (J : Finset P.plus) (h : I ⟶ J),
          Set.range (t h).spaComap ⊆ W := sorry

end Perfectoid

end TauCeti

end

/-! # Stage P2b. Perfectoid spaces, glued tilting, the slice equivalence, completed tensor products,
fibre products and products in Perf

The global half of layer P2, for perfectoid Tate rings in any characteristic and without a
perfectoid base field. A perfectoid space is an object of the anchor's category of adic spaces
(AdicSpaces Layer 5: adic spaces, open subspaces, gluing, Wedhorn Proposition 8.25) locally
isomorphic to `Spa(R, R⁺)` with `R` perfectoid; `Perfd` is the full subcategory on these objects
and `Perf ⊆ Perfd` the characteristic-`p` part. Neither pinned library has adic spaces, so every
geometric packet item (`PerfectoidSpace.IsAffinoidPerfectoid`, `PerfectoidSpace.IsPerfectoidSpace`,
the categories `PerfectoidSpace` and `PerfectoidSpace.Perf`, the glued tilt, the slice
equivalence, fibre products and absolute products) is a comment
`-- <name>: not stated here; needs … (supplier: …)`. The ring-level and pair-level cores are
stated:

* **Complete perfectoid Tate pairs.** `PerfectoidSpace.affinoidPerfectoidEquiv.PairCat p`, the
  category of complete perfectoid Tate pairs with morphisms of Huber pairs (the source of `Spa` in
  Wedhorn Proposition 8.25), its tilt functor, and the tilting equivalence
  `PerfectoidSpace.pairTiltEquiv` of pairs under `(A, A⁺)` and under `(A♭, A♭⁺)`.
* **Completed tensor products** of perfectoid Tate pairs, with the AdicSpacesPartII R0 stand-ins
  `Huber.CompletedTensor A B C`, `Huber.Pair.completedTensor` and
  `Huber.Pair.uniformCompletedTensor` of the prelude: perfectness in characteristic `p`
  (`Perfectoid.perfectRing_completedTensor_of_charP`), the dense-image criterion
  (`Perfectoid.IsPerfectoidTateRing.of_denseRange`), perfectoidness
  (`Perfectoid.isPerfectoidTateRing_completedTensor`, an instance), compatibility with tilting
  (`Perfectoid.completedTensorTiltIso`), the plus-ring almost formula
  (`Perfectoid.completedTensor_plus_almostIso`) and the uniform completed tensor product over a
  Tate base (`Perfectoid.isPerfectoidTateRing_uniformCompletedTensor`).
* **Affinoid fibre products at pair level.** The universal property of `B ⊗̂_A C` among complete
  Huber pairs (`PerfectoidSpace.spaCompletedTensor_isPullback_core`) and of `B ⊗̂ᵘ_A C` among
  complete perfectoid pairs (`PerfectoidSpace.pullbackOverAnalyticSpaIso_affinoid`), and
  surjectivity on adic spectra (`PerfectoidSpace.pullback.surjective_points_affinoid`,
  `PerfectoidSpace.pullbackOverAnalytic.surjective_points_affinoid`).
* **Absolute products.** The affinoid chart `(C_{m,n}, C⁺_{m,n})` of a product of two
  characteristic-`p` affinoid perfectoid spaces, characterised by its universal property
  (`PerfectoidSpace.Perf.prodChart_ring`).

The structure maps `A → B`, `A → C` of a completed tensor product are `algebraMap`s carrying a
`Huber.IsAdicHom` instance; for the Tate rings of this stage every continuous ring map is adic
(AdicSpacesPartII:R0/adic-ring-homomorphism).

Sources: ECD = Scholze, *Étale cohomology of diamonds*; Sch12 = Scholze, *Perfectoid spaces*;
Berkeley = Scholze–Weinstein, *Berkeley lectures on p-adic geometry*; KL = Kedlaya–Liu, *Relative
p-adic Hodge theory* I, II; AWS = Kedlaya, *Sheaves, stacks and shtukas*; Bhatt = Bhatt, *Lecture
notes on perfectoid spaces*; Wedhorn = Wedhorn, *Adic spaces*. -/

noncomputable section

namespace TauCeti

universe u

open Topology Filter CategoryTheory CategoryTheory.Limits TensorProduct
open Huber ValuationSpectrum

/-! ## PerfectoidSpaces:P2/affinoid-perfectoid-space (definition) -/

/-! An adic space `X` is *affinoid perfectoid* if `X ≅ Spa(R, R⁺)` for a complete Hausdorff Huber
pair `(R, R⁺)` with `R` a perfectoid Tate ring (ECD Definition 3.1; Berkeley Remark 7.1.3); the
zero ring is allowed, and no base field is fixed. `Spa(R, R⁺)` as an adic space and isomorphisms of
adic spaces are the anchor's (AdicSpaces Layer 5), so the predicate and its API are comments. The
pair side of Wedhorn Proposition 8.25, the category of complete perfectoid Tate pairs, is stated
as `PerfectoidSpace.affinoidPerfectoidEquiv.PairCat`. -/

-- PerfectoidSpace.IsAffinoidPerfectoid: not stated here; needs the anchor's category `AdicSpace`
--   of adic spaces and its isomorphisms (supplier: AdicSpaces Layer 5). The predicate on `X`:
--   there are a complete Hausdorff Huber pair `(R, R⁺)` with `Perfectoid.IsPerfectoidTateRing p R`
--   and an isomorphism of adic spaces `X ≅ Spa(R, R⁺)`.
-- PerfectoidSpace.spa: not stated here; needs `Spa(R, R⁺)` of a sheafy complete Huber pair as an
--   object of `AdicSpace` (supplier: AdicSpaces Layer 5); perfectoid pairs are sheafy
--   (PerfectoidSpaces:P2/perfectoid-stably-uniform-and-sheafy).
-- PerfectoidSpace.IsAffinoidPerfectoid.spa: not stated here; needs `PerfectoidSpace.spa`
--   (supplier: AdicSpaces Layer 5). `Spa(R, R⁺)` is affinoid perfectoid.
-- PerfectoidSpace.spaGlobalSectionsIso: not stated here; needs the structure sheaves `O_X`, `O_X⁺`
--   of `Spa(R, R⁺)` (supplier: AdicSpaces Layer 3). `(O(X), O⁺(X)) ≅ (R, R⁺)` as topological rings
--   with plus rings (ECD Theorem 3.24 for `O⁺`).
-- PerfectoidSpace.IsAffinoidPerfectoid.isPerfectoidTateRing_sections: not stated here; needs
--   `O_X(X)` of an adic space (supplier: AdicSpaces Layer 3, Layer 5). For `X` affinoid perfectoid,
--   `O_X(X)` is a perfectoid Tate ring and `X → Spa(O_X(X), O_X⁺(X))` is an isomorphism.
-- PerfectoidSpace.isAffinoidPerfectoid_iff: not stated here; needs the anchor's affinoid adic
--   spaces and `O_X(X)` (supplier: AdicSpaces Layer 5). `X` is affinoid perfectoid iff `X` is
--   affinoid and `O_X(X)` is a perfectoid Tate ring.
-- PerfectoidSpace.spaHomEquiv: not stated here; needs morphisms of adic spaces and Wedhorn
--   Proposition 8.25 (supplier: AdicSpaces Layer 5). `(Y ⟶ Spa(R, R⁺)) ≃ Huber.Pair.Hom (R, R⁺)
--   (O_Y(Y), O_Y⁺(Y))`, natural in `Y` and in the pair.
-- PerfectoidSpace.affinoidPerfectoidEquiv: not stated here; needs `AdicSpace` (supplier:
--   AdicSpaces Layer 5). `Spa` is an equivalence from `(affinoidPerfectoidEquiv.PairCat p)ᵒᵖ`
--   (stated below) to the full subcategory of affinoid perfectoid adic spaces.
-- PerfectoidSpace.IsAffinoidPerfectoid.of_iso: not stated here; needs isomorphisms of adic spaces
--   (supplier: AdicSpaces Layer 5). The predicate is closed under isomorphisms (Mathlib
--   `ObjectProperty.IsClosedUnderIsomorphisms`).
-- PerfectoidSpace.IsAffinoidPerfectoid.spectralSpace: not stated here; needs the underlying space
--   of an adic space (supplier: AdicSpaces Layer 5). Affinoid core: Tau Ceti
--   `ValuationSpectrum.spectralSpace_spa_of_pairOfDefinition`.
-- PerfectoidSpace.IsAffinoidPerfectoid.isAnalyticPoint: not stated here; needs the analytic points
--   of an adic space (supplier: AdicSpaces Layer 5). Affinoid core: Tau Ceti
--   `ValuationSpectrum.spaAnalytic_eq_spa_of_isTateRing`, as `R` is Tate.
-- PerfectoidSpace.IsAffinoidPerfectoid.rationalSubset: not stated here; needs open subspaces of
--   adic spaces (supplier: AdicSpaces Layer 5); see PerfectoidSpaces:P2/affinoid-perfectoid-basis.

-- IsAffinoidPerfectoid.spa_Cp: not stated here; needs `Spa(ℂ_p, O_{ℂ_p})` as an adic space
--   (supplier: AdicSpaces Layer 5). It is affinoid perfectoid and has exactly one point, the
--   rank-one valuation. [computation test]
-- not_isAffinoidPerfectoid_spa_Qp: not stated here; needs `Spa(ℚ_p, ℤ_p)` as an adic space
--   (supplier: AdicSpaces Layer 5). It is affinoid but not affinoid perfectoid, since
--   `O(Spa(ℚ_p, ℤ_p)) = ℚ_p` is not perfectoid (ECD Remark 3.3). [non-example test]
