/- `K` the completion of `ℚ_p(p^{1/p^∞})`, `π = p`; `hnot` is Sch12 Remark 4.8. -/
-- test Almost.Module.elements_test_not_identity (non-example) [P0/almost-hom-and-adjoints]
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) (π : O)
    (hnot : ¬ Function.Surjective (fun x : O ⧸ Ideal.span {π} ↦
      (LinearMap.toSpanSingleton O (O ⧸ Ideal.span {π}) x).domRestrict
        (IsLocalRing.maximalIdeal O))) :
    Function.Injective ((Module.adjElements (BasicSetup.ofValuationRing O h)).unit.app
      (ModuleCat.of O (O ⧸ Ideal.span {π}))).hom ∧
    ¬ Function.Surjective ((Module.adjElements (BasicSetup.ofValuationRing O h)).unit.app
      (ModuleCat.of O (O ⧸ Ideal.span {π}))).hom := sorry

