local notation "𝔻₊" =>
  (perfectedTateAlgebra.plus p (σ := Unit) (Pair.powerBounded (padicCyclotomic p)))

-- The coordinate `T`.
local notation "𝕋" => perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0)

/- The affinoid core: a map of affinoid perfectoid spaces is spectral with quasicompact source. -/
-- test quasiCompact_affinoid (computation) [P4/quasicompact-and-quasiseparated-maps]
example {R S : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CommRing S]
    [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S]
    [T2Space S] [IsPerfectoidTateRing p S] {P : Pair R} {Q : Pair S} (φ : Pair.Hom P Q) :
    IsSpectralMap φ.spaComap ∧ CompactSpace (spa Q.plus) ∧ QuasiSeparatedSpace (spa Q.plus) :=
  sorry

/- The open unit disc `⋃ₙ {|T|ⁿ⁺¹ ≤ |ϖ|}` of the perfectoid disc is not quasicompact: its
inclusion is not a quasicompact map (the preimage of the whole disc is itself). -/
-- test not_quasiCompact_openDisc (non-example) [P4/quasicompact-and-quasiseparated-maps]
example (ϖ : PseudoUniformizerRoots p (padicCyclotomic p)) :
    ¬ IsCompact (⋃ n : ℕ, {x : spa 𝔻₊.plus |
      x.1.toValuativeRel.vle (𝕋 ^ (n + 1)) (algebraMap (padicCyclotomic p) 𝔻 (ϖ.root 0))}) :=
  sorry

