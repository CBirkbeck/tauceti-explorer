/-! ## PerfectoidSpaces:P7/frobenius-controlled-integral-tower (definition) -/

namespace Perfectoid

namespace FrobeniusTower

/-- P7/frobenius-controlled-integral-tower (data): the image `ϖ_m ∈ A_m⁺` of `ϖ ∈ A_0⁺` under the
transition maps (Torsion, proof of Corollary III.2.19: "its images again written `ϖ`"). -/
def varpiOf {A : ℕ → Type*} [∀ m, CommRing (A m)] (t : ∀ m, A m →+* A (m + 1)) (ϖ : A 0) :
    ∀ m, A m
  | 0 => ϖ
  | m + 1 => t m (varpiOf t ϖ m)

/-- P7/frobenius-controlled-integral-tower (other): a ring map sending `x` to `y` maps `(xⁿ)`
into `(yⁿ)`. -/
theorem span_pow_le_comap_of_eq {R S : Type*} [CommRing R] [CommRing S] (g : R →+* S) {x : R}
    {y : S} (hx : g x = y) (n : ℕ) : Ideal.span {x ^ n} ≤ (Ideal.span {y ^ n}).comap g := sorry

/-- P7/frobenius-controlled-integral-tower (other): a ring map sending `x` to `y` maps `(x)` into
`(y)`. -/
theorem span_le_comap_of_eq {R S : Type*} [CommRing R] [CommRing S] (g : R →+* S) {x : R}
    {y : S} (hx : g x = y) : Ideal.span {x} ≤ (Ideal.span {y}).comap g := sorry

/-- P7/frobenius-controlled-integral-tower (data): the reduction `R/x → S/y` of a ring map with
`g x = y`. -/
def quotMapOf {R S : Type*} [CommRing R] [CommRing S] (g : R →+* S) {x : R} {y : S}
    (hx : g x = y) : R ⧸ Ideal.span {x} →+* S ⧸ Ideal.span {y} :=
  Ideal.quotientMap _ g (span_le_comap_of_eq g hx)

/-- P7/frobenius-controlled-integral-tower (data): the reduction `R/xⁿ → S/yⁿ` of a ring map with
`g x = y`. -/
def powQuotMapOf {R S : Type*} [CommRing R] [CommRing S] (g : R →+* S) {x : R} {y : S}
    (hx : g x = y) (n : ℕ) : R ⧸ Ideal.span {x ^ n} →+* S ⧸ Ideal.span {y ^ n} :=
  Ideal.quotientMap _ g (span_pow_le_comap_of_eq g hx n)

variable (p : ℕ) [Fact p.Prime]

/-- P7/frobenius-controlled-integral-tower (other): `ϖ^p ∣ p` is preserved by ring maps. -/
theorem pow_dvd_natCast_map {R S : Type*} [CommRing R] [CommRing S] (g : R →+* S) {x : R}
    (h : x ^ p ∣ (p : R)) : g x ^ p ∣ (p : S) := sorry

/-- P7/frobenius-controlled-integral-tower (other): if `ϖ^p ∣ p` in `A_0⁺`, then `ϖ^p ∣ p` in every
`A_m⁺`. -/
theorem pow_dvd_varpiOf {A : ℕ → Type*} [∀ m, CommRing (A m)] (t : ∀ m, A m →+* A (m + 1))
    {ϖ : A 0} (h : ϖ ^ p ∣ (p : A 0)) (m : ℕ) : varpiOf t ϖ m ^ p ∣ (p : A m) := sorry

end FrobeniusTower

open FrobeniusTower in
/-- P7/frobenius-controlled-integral-tower (structure): a *Frobenius-controlled integral tower*
`(A_•⁺, ϖ, m₀, w)` (Torsion, proof of Corollary III.2.19; BHW proof of Theorem 5.11): rings
`A_0⁺ → A_1⁺ → ⋯` with transition maps `t_m`, an element `ϖ ∈ A_0⁺` with `ϖ^p ∣ p` such that every
`A_m⁺` is `ϖ`-torsion-free and `ϖ`-adically complete, and for `m ≥ m₀` ring isomorphisms
`w_m : A_{m+1}⁺/ϖ ≅ A_m⁺/ϖ^p` with (i) `t_m ∘ w_m = Φ_{m+1}` (`x ↦ x^p`, P1 `frobeniusModPow`) and
(ii) `w_{m+1} ∘ t_{m+1} = t_m ∘ w_m`. The finite levels need not be perfectoid; characteristic
`p` is allowed. -/
structure FrobeniusTower (p : ℕ) [Fact p.Prime] : Type (u + 1) where
  /-- The rings `A_m⁺`. -/
  A : ℕ → Type u
  /-- Their ring structures. -/
  [instCommRing : ∀ m, CommRing (A m)]
  /-- The transition maps `t_m : A_m⁺ → A_{m+1}⁺`. -/
  t : ∀ m, A m →+* A (m + 1)
  /-- The compatible pseudouniformiser `ϖ ∈ A_0⁺`. -/
  ϖ : A 0
  /-- `p ∈ ϖ^p A_0⁺`. -/
  pow_dvd_p : ϖ ^ p ∣ (p : A 0)
  /-- Every `A_m⁺` is `ϖ`-torsion-free. -/
  isSMulRegular : ∀ m, IsSMulRegular (A m) (varpiOf t ϖ m)
  /-- Every `A_m⁺` is `ϖ`-adically complete. -/
  isAdicComplete : ∀ m, IsAdicComplete (Ideal.span {varpiOf t ϖ m}) (A m)
  /-- The level from which the Frobenius lifts exist. -/
  m₀ : ℕ
  /-- The Frobenius lifts `w_m : A_{m+1}⁺/ϖ ≅ A_m⁺/ϖ^p` for `m ≥ m₀`. -/
  lift : ∀ m, m₀ ≤ m →
    (A (m + 1) ⧸ Ideal.span {varpiOf t ϖ (m + 1)}) ≃+* (A m ⧸ Ideal.span {varpiOf t ϖ m ^ p})
  /-- (i) `t_m ∘ w_m = Φ_{m+1}` on `A_{m+1}⁺/ϖ`. -/
  transition_comp_lift : ∀ m (hm : m₀ ≤ m),
    (powQuotMapOf (t m) (y := varpiOf t ϖ (m + 1)) rfl p).comp (lift m hm).toRingHom =
      frobeniusModPow p (varpiOf t ϖ (m + 1)) (pow_dvd_varpiOf p t pow_dvd_p (m + 1))
  /-- (ii) `w_{m+1} ∘ t_{m+1} = t_m ∘ w_m` as maps `A_{m+1}⁺/ϖ → A_{m+1}⁺/ϖ^p`. -/
  lift_comp_transition : ∀ m (hm : m₀ ≤ m),
    (lift (m + 1) (hm.trans m.le_succ)).toRingHom.comp
        (quotMapOf (t (m + 1)) (y := varpiOf t ϖ (m + 1 + 1)) rfl) =
      (powQuotMapOf (t m) (y := varpiOf t ϖ (m + 1)) rfl p).comp (lift m hm).toRingHom

attribute [instance] FrobeniusTower.instCommRing

namespace FrobeniusTower

variable {p : ℕ} [Fact p.Prime] (T : FrobeniusTower.{u} p)

/-- P7/frobenius-controlled-integral-tower (data): `ϖ ∈ A_m⁺`. -/
abbrev varpi (m : ℕ) : T.A m := varpiOf T.t T.ϖ m

/-- P7/frobenius-controlled-integral-tower (data): `Φ_m : A_m⁺/ϖ → A_m⁺/ϖ^p`, `x ↦ x^p`, well
defined since `p ∈ ϖ^p A_m⁺` (P1 `frobeniusModPow`, built on `frobeniusQuot`). -/
def frobMod (m : ℕ) : T.A m ⧸ Ideal.span {T.varpi m} →+* T.A m ⧸ Ideal.span {T.varpi m ^ p} :=
  frobeniusModPow p (T.varpi m) (pow_dvd_varpiOf p T.t T.pow_dvd_p m)

/-- P7/frobenius-controlled-integral-tower (data): the iterated transition maps
`A_i → A_j` for `i ≤ j` of a sequence of ring maps, via Mathlib `Functor.ofSequence`. -/
def seqMap {B : ℕ → Type u} [∀ m, CommRing (B m)] (s : ∀ m, B m →+* B (m + 1)) (i j : ℕ)
    (h : i ≤ j) : B i →+* B j :=
  ((Functor.ofSequence fun m ↦ CommRingCat.ofHom (s m)).map (homOfLE h)).hom

/-- P7/frobenius-controlled-integral-tower (data): the iterated transition maps `A_i⁺ → A_j⁺`. -/
def transition (i j : ℕ) (h : i ≤ j) : T.A i →+* T.A j := seqMap T.t i j h

/-- P7/frobenius-controlled-integral-tower (functoriality): *morphisms* of Frobenius-controlled
towers: ring maps `f_m : A_m⁺ → B_m⁺` commuting with the transition maps, sending `ϖ` to `ϖ` and
intertwining the Frobenius lifts where both exist. -/
structure Hom (T' : FrobeniusTower.{u} p) where
  /-- The ring maps `f_m`. -/
  f : ∀ m, T.A m →+* T'.A m
  /-- `t'_m ∘ f_m = f_{m+1} ∘ t_m`. -/
  comm : ∀ m, (T'.t m).comp (f m) = (f (m + 1)).comp (T.t m)
  /-- `f_m(ϖ) = ϖ`. -/
  map_varpi : ∀ m, f m (T.varpi m) = T'.varpi m
  /-- `f_m ∘ w_m = w'_m ∘ f_{m+1}` modulo `ϖ` and `ϖ^p`, for `m ≥ m₀, m₀'`. -/
  comm_lift : ∀ m (h : T.m₀ ≤ m) (h' : T'.m₀ ≤ m),
    (powQuotMapOf (f m) (map_varpi m) p).comp (T.lift m h).toRingHom =
      (T'.lift m h').toRingHom.comp (quotMapOf (f (m + 1)) (map_varpi (m + 1)))

/-- P7/frobenius-controlled-integral-tower (functoriality): the identity morphism. -/
def Hom.id : T.Hom T where
  f _ := RingHom.id _
  comm _ := sorry
  map_varpi _ := rfl
  comm_lift _ _ _ := sorry

/-- P7/frobenius-controlled-integral-tower (functoriality): composition of morphisms. -/
def Hom.comp {T' T'' : FrobeniusTower.{u} p} (g : T'.Hom T'') (f : T.Hom T') : T.Hom T'' where
  f m := (g.f m).comp (f.f m)
  comm _ := sorry
  map_varpi _ := sorry
  comm_lift _ _ _ := sorry

/-- P7/frobenius-controlled-integral-tower (functoriality): dropping the first `k` terms (and
lowering `m₀`) gives a Frobenius-controlled tower `m ↦ A_{k+m}⁺` with the same completion
(`completed_shift`). -/
def shift (k : ℕ) : FrobeniusTower.{u} p where
  A m := T.A (k + m)
  t m := T.t (k + m)
  ϖ := T.varpi k
  pow_dvd_p := sorry
  isSMulRegular := sorry
  isAdicComplete := sorry
  m₀ := T.m₀ - k
  lift := sorry
  transition_comp_lift := sorry
  lift_comp_transition := sorry

/-- P7/frobenius-controlled-integral-tower (data): the colimit `colim_m A_m⁺` (Mathlib
`Ring.DirectLimit`). -/
abbrev colim : Type u := _root_.Ring.DirectLimit T.A fun i j h ↦ T.transition i j h

/-- P7/frobenius-controlled-integral-tower (data): the image of `ϖ` in `colim_m A_m⁺`. -/
def varpiColim : T.colim := _root_.Ring.DirectLimit.of T.A (fun i j h ↦ T.transition i j h) 0 T.ϖ

/-- P7/frobenius-controlled-integral-tower (data): for ideals `I_m ⊆ A_m⁺` with `t_m(I_m) ⊆
I_{m+1}`, the colimit `colim_m A_m⁺/I_m`. -/
abbrev quotColim (I : ∀ m, Ideal (T.A m)) (hI : ∀ m, I m ≤ (I (m + 1)).comap (T.t m)) : Type u :=
  _root_.Ring.DirectLimit (fun m ↦ T.A m ⧸ I m)
    fun i j h ↦ seqMap (fun m ↦ Ideal.quotientMap (I (m + 1)) (T.t m) (hI m)) i j h

/-- P7/frobenius-controlled-integral-tower (data): `colim_m A_m⁺/ϖ`. -/
abbrev modVarpiColim : Type u :=
  T.quotColim (fun m ↦ Ideal.span {T.varpi m}) fun m ↦ span_le_comap_of_eq (T.t m) rfl

/-- P7/frobenius-controlled-integral-tower (data): `colim_m A_m⁺/ϖ^k`. -/
abbrev modVarpiPowColim (k : ℕ) : Type u :=
  T.quotColim (fun m ↦ Ideal.span {T.varpi m ^ k}) fun m ↦ span_pow_le_comap_of_eq (T.t m) rfl k

/-- P7/frobenius-controlled-integral-tower (data): `Φ : colim_m A_m⁺/ϖ → colim_m A_m⁺/ϖ^p`, the
colimit of the `Φ_m`. -/
def frobColim : T.modVarpiColim →+* T.modVarpiPowColim p :=
  _root_.Ring.DirectLimit.lift _ _ _
    (fun m ↦ (_root_.Ring.DirectLimit.of _ _ m).comp (T.frobMod m)) sorry

/-- P7/frobenius-controlled-integral-tower (characterisation): `Φ : colim_m A_m⁺/ϖ →
colim_m A_m⁺/ϖ^p` is bijective (the `w_m` give the inverse on the tail; Torsion, proof of
Corollary III.2.19; PerfectoidSpaces:P7/frobenius-tower-uniformity-bound). -/
theorem frobenius_colimit_bijective : Function.Bijective T.frobColim := sorry

/-- P7/frobenius-controlled-integral-tower (data): the generic fibre `A_m = A_m⁺[1/ϖ]` as a ring
(Mathlib `Localization.Away`). -/
abbrev genericFibreRing (m : ℕ) : Type u := Localization.Away (T.varpi m)

/-- P7/frobenius-controlled-integral-tower (instance): the topology on `A_m` in which `A_m⁺` is
an open ring of definition with the `ϖ`-adic topology. -/
instance (m : ℕ) : UniformSpace (T.genericFibreRing m) := sorry

/-- P7/frobenius-controlled-integral-tower (instance). -/
instance (m : ℕ) : IsUniformAddGroup (T.genericFibreRing m) := sorry

/-- P7/frobenius-controlled-integral-tower (instance). -/
instance (m : ℕ) : IsTopologicalRing (T.genericFibreRing m) := sorry

/-- P7/frobenius-controlled-integral-tower (instance): `A_m` is a Tate ring with pseudouniformiser
`ϖ`. -/
instance (m : ℕ) : IsTateRing (T.genericFibreRing m) := sorry

/-- P7/frobenius-controlled-integral-tower (instance): `A_m` is complete (`A_m⁺` is
`ϖ`-adically complete). -/
instance (m : ℕ) : CompleteSpace (T.genericFibreRing m) := sorry

/-- P7/frobenius-controlled-integral-tower (instance). -/
instance (m : ℕ) : T2Space (T.genericFibreRing m) := sorry

/-- P7/frobenius-controlled-integral-tower (characterisation): `A_m⁺` is an open ring of
definition of `A_m` with ideal of definition `(ϖ)`. -/
theorem genericFibreRing_pairOfDefinition (m : ℕ) :
    ∃ (D : PairOfDefinition (T.genericFibreRing m))
      (h : algebraMap (T.A m) (T.genericFibreRing m) (T.varpi m) ∈ D.ringOfDefinition),
      D.ringOfDefinition = (algebraMap (T.A m) (T.genericFibreRing m)).range ∧
        D.idealOfDefinition = Ideal.span {⟨_, h⟩} := sorry

/-- P7/frobenius-controlled-integral-tower (data): the generic fibre `(A_m, A_m⁺⁺)`, `A_m⁺⁺` the
integral closure of `A_m⁺` in `A_m = A_m⁺[1/ϖ]`; `X_m = Spa(A_m, A_m⁺⁺)` (Torsion, proof of
Corollary III.2.19). -/
def genericFibre (m : ℕ) : Pair (T.genericFibreRing m) where
  plus := (integralClosure (T.A m) (T.genericFibreRing m)).toSubring
  isRingOfIntegralElements := sorry

/-- P7/frobenius-controlled-integral-tower (data): the transition maps
`(A_i, A_i⁺⁺) → (A_j, A_j⁺⁺)` of the generic fibres, `i ≤ j`. -/
def genericFibreHom (i j : ℕ) (h : i ≤ j) : Pair.Hom (T.genericFibre i) (T.genericFibre j) where
  toRingHom := Localization.awayLift
    ((algebraMap (T.A j) (T.genericFibreRing j)).comp (T.transition i j h)) _ sorry
  continuous_toRingHom := sorry
  map_mem_plus := sorry

end FrobeniusTower

section FrobeniusTowerExamples

variable (p : ℕ) [Fact p.Prime]

namespace FrobeniusTower

/-- P7/frobenius-controlled-integral-tower (other): the Frobenius `x ↦ x^p` of `R/x^p` for
`x^p ∣ p` (an `𝔽_p`-algebra), P1 `frobeniusQuot`. -/
def frobPowQuot {R : Type*} [CommRing R] (x : R) (h : x ^ p ∣ (p : R)) :
    R ⧸ Ideal.span {x ^ p} →+* R ⧸ Ideal.span {x ^ p} :=
  frobeniusQuot p _ _ (Ideal.mem_span_singleton.mpr h) fun _ hy ↦
    Ideal.pow_mem_of_mem _ hy _ (Fact.out : p.Prime).pos

/-- P7/frobenius-controlled-integral-tower (other): `τ : C → B` is the *relative Frobenius* of the
`k`-algebra `B` (`ι_B : k → B`) over `φ_k : k → k`: `C` with `u : B → C` and `ι_C : k → C` is the
pushout `B ⊗_{k, φ_k} k` (Mathlib `IsPushout` in `CommRingCat`), and `τ(b ⊗ c) = b^p c`, i.e.
`τ ∘ u = F_B` and `τ ∘ ι_C = ι_B`. -/
def IsRelativeFrobenius {k B C : Type u} [CommRing k] [CommRing B] [CommRing C] (φk : k →+* k)
    (ιB : k →+* B) (ιC : k →+* C) (FB : B →+* B) (τ : C →+* B) : Prop :=
  ∃ u : B →+* C, IsPushout (CommRingCat.ofHom ιB) (CommRingCat.ofHom φk) (CommRingCat.ofHom u)
    (CommRingCat.ofHom ιC) ∧ τ.comp u = FB ∧ τ.comp ιC = ιB

/-- P7/frobenius-controlled-integral-tower (constructor): the Frobenius-controlled tower of flat
`ϖ`-adically complete, `ϖ`-torsion-free algebras `A_m⁺` over an integral perfectoid ring `O ∋ ϖ`
(P1 `IsIntegralPerfectoid`, BMS1 Definition 3.5) whose transition maps reduce modulo `ϖ^p` to the
relative Frobenius of `A_{m+1}⁺/ϖ^p` over `O/ϖ^p` for `m ≥ m₀`; `w_m` is the composite of the
canonical isomorphisms `A_{m+1}⁺/ϖ ≅ A_{m+1}⁺/ϖ ⊗_{O/ϖ, Φ_O} O/ϖ^p ≅ (A_{m+1}⁺/ϖ^p)^{(p)} ≅
A_m⁺/ϖ^p` (Torsion, proof of Corollary III.2.19). -/
def ofRelativeFrobenius {O : Type u} [CommRing O] (hO : IsIntegralPerfectoid p O) (ϖ : O)
    (hϖ : ϖ ^ p ∣ (p : O)) (A : ℕ → Type u) [∀ m, CommRing (A m)] [∀ m, Algebra O (A m)]
    [∀ m, Module.Flat O (A m)] (t : ∀ m, A m →ₐ[O] A (m + 1))
    (hreg : ∀ m, IsSMulRegular (A m) (algebraMap O (A m) ϖ))
    (hcomp : ∀ m, IsAdicComplete (Ideal.span {algebraMap O (A m) ϖ}) (A m)) (m₀ : ℕ)
    (hrel : ∀ m, m₀ ≤ m → IsRelativeFrobenius (frobPowQuot p ϖ hϖ)
      (powQuotMapOf (algebraMap O (A (m + 1))) rfl p) (powQuotMapOf (algebraMap O (A m)) rfl p)
      (frobPowQuot p _ (pow_dvd_natCast_map p (algebraMap O (A (m + 1))) hϖ))
      (powQuotMapOf (t m).toRingHom ((t m).commutes ϖ) p)) :
    FrobeniusTower.{u} p where
  A := A
  t m := (t m).toRingHom
  ϖ := algebraMap O (A 0) ϖ
  pow_dvd_p := pow_dvd_natCast_map p _ hϖ
  isSMulRegular := sorry
  isAdicComplete := sorry
  m₀ := m₀
  lift := sorry
  transition_comp_lift := sorry
  lift_comp_transition := sorry

/-- P7/frobenius-controlled-integral-tower (example): the constant tower `A_m⁺ = S`, `t_m = id`,
of a `ϖ`-torsion-free `ϖ`-adically complete integral perfectoid ring with `ϖ^p ∣ p`, with
`w_m = Φ : S/ϖ ≅ S/ϖ^p` (bijective by BMS1 Lemma 3.10). -/
def constPerfectoid (S : Type u) [CommRing S] (hS : IsIntegralPerfectoid p S) (ϖ : S)
    (hϖ : ϖ ^ p ∣ (p : S)) (hreg : IsSMulRegular S ϖ)
    (hcomp : IsAdicComplete (Ideal.span {ϖ}) S) : FrobeniusTower.{u} p where
  A _ := S
  t _ := RingHom.id S
  ϖ := ϖ
  pow_dvd_p := hϖ
  isSMulRegular := sorry
  isAdicComplete := sorry
  m₀ := 0
  lift := sorry
  transition_comp_lift := sorry
  lift_comp_transition := sorry

/-- P7/frobenius-controlled-integral-tower (example): the relative Frobenius tower
`S⁺ →Φ S⁺ →Φ ⋯` of a flat `t`-adically complete, `t`-torsion-free algebra `S⁺` over a perfect
ring `k` of characteristic `p` with `t ∈ k`; the image of `t` at level `m` is `t^{p^m}`, and `w_m`
is the identity `S⁺/t^{p^{m+1}} = S⁺/(t^{p^m})^p` (Torsion, Definition III.2.18 (ii);
PerfectoidSpaces:P7/perfection-tilde-limit). -/
def perfection (k : Type u) [CommRing k] [CharP k p] [PerfectRing k p] (t : k) (S : Type u)
    [CommRing S] [Algebra k S] [Module.Flat k S] [CharP S p]
    (hreg : IsSMulRegular S (algebraMap k S t))
    (hcomp : IsAdicComplete (Ideal.span {algebraMap k S t}) S) : FrobeniusTower.{u} p where
  A _ := S
  t _ := frobenius S p
  ϖ := algebraMap k S t
  pow_dvd_p := sorry
  isSMulRegular := sorry
  isAdicComplete := sorry
  m₀ := 0
  lift := sorry
  transition_comp_lift := sorry
  lift_comp_transition := sorry

/-- P7/frobenius-controlled-integral-tower (simp): the image of `ϖ` at level `m` of
`ofRelativeFrobenius` is the image of `ϖ ∈ O`. -/
theorem ofRelativeFrobenius_varpi {O : Type u} [CommRing O] (hO : IsIntegralPerfectoid p O)
    (ϖ : O) (hϖ : ϖ ^ p ∣ (p : O)) (A : ℕ → Type u) [∀ m, CommRing (A m)] [∀ m, Algebra O (A m)]
    [∀ m, Module.Flat O (A m)] (t : ∀ m, A m →ₐ[O] A (m + 1))
    (hreg : ∀ m, IsSMulRegular (A m) (algebraMap O (A m) ϖ))
    (hcomp : ∀ m, IsAdicComplete (Ideal.span {algebraMap O (A m) ϖ}) (A m)) (m₀ : ℕ)
    (hrel : ∀ m, m₀ ≤ m → IsRelativeFrobenius (frobPowQuot p ϖ hϖ)
      (powQuotMapOf (algebraMap O (A (m + 1))) rfl p) (powQuotMapOf (algebraMap O (A m)) rfl p)
      (frobPowQuot p _ (pow_dvd_natCast_map p (algebraMap O (A (m + 1))) hϖ))
      (powQuotMapOf (t m).toRingHom ((t m).commutes ϖ) p)) (m : ℕ) :
    (ofRelativeFrobenius p hO ϖ hϖ A t hreg hcomp m₀ hrel).varpi m = algebraMap O (A m) ϖ :=
  sorry

/-- P7/frobenius-controlled-integral-tower (simp): the image of `ϖ` at every level of the constant
tower is `ϖ`. -/
theorem constPerfectoid_varpi (S : Type u) [CommRing S] (hS : IsIntegralPerfectoid p S) (ϖ : S)
    (hϖ : ϖ ^ p ∣ (p : S)) (hreg : IsSMulRegular S ϖ) (hcomp : IsAdicComplete (Ideal.span {ϖ}) S)
    (m : ℕ) : (constPerfectoid p S hS ϖ hϖ hreg hcomp).varpi m = ϖ := sorry

/-- P7/frobenius-controlled-integral-tower (data): the level `R⁺⟨T^{1/p^m}⟩` of the compatible-root
disc tower, the closure of `R⁺[T^{1/p^m}]` in the perfected Tate algebra `R⟨T^{1/p^∞}⟩` (P1
`perfectedTateAlgebra`); used by the disc tests. -/
def discLevel {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
    (P : Pair R) (m : ℕ) : Subring (perfectedTateAlgebra p R Unit) :=
  (Subring.closure (Set.range (fun x : P.plus ↦ algebraMap R (perfectedTateAlgebra p R Unit) x) ∪
    {perfectedTateAlgebra.X p () (PDyadicExp.invPow p m)})).topologicalClosure

end FrobeniusTower

end FrobeniusTowerExamples

section FrobeniusTowerTests

variable (p : ℕ) [Fact p.Prime]

open FrobeniusTower

/- The compatible-root disc tower: `A_m⁺ = R⁺⟨T^{1/p^m}⟩ ⊆ R⟨T^{1/p^∞}⟩` with the inclusions as
transition maps and `ϖ = ϖ^{1/p⁰}` carries a Frobenius-controlled structure with `m₀ = 0`
(`w_m(r T^{a/p^{m+1}}) = Φ(r) T^{a/p^m}`). -/
-- test frobeniusTower_test_disc (computation) [P7/frobenius-controlled-integral-tower]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R)
    (ϖ : PseudoUniformizerRoots p R) (hϖ : ϖ.rootPlus p P ^ p ∣ (p : P.plus)) :
    ∃ (T : FrobeniusTower.{u} p) (e : ∀ m, T.A m ≃+* discLevel p P m), T.m₀ = 0 ∧
      ((e 0 T.ϖ : perfectedTateAlgebra p R Unit) = algebraMap R _ (ϖ.root 0)) ∧
      ∀ m (x : T.A m), (e (m + 1) (T.t m x) : perfectedTateAlgebra p R Unit) = e m x := sorry

/- The constant tower of an integral perfectoid ring: `m₀ = 0` and `w_m = Φ`, `x ↦ x^p`. -/
-- test frobeniusTower_test_constPerfectoid (degenerate) [P7/frobenius-controlled-integral-tower]
example (S : Type u) [CommRing S] (hS : IsIntegralPerfectoid p S) (ϖ : S)
    (hϖ : ϖ ^ p ∣ (p : S)) (hreg : IsSMulRegular S ϖ) (hcomp : IsAdicComplete (Ideal.span {ϖ}) S) :
    (constPerfectoid p S hS ϖ hϖ hreg hcomp).m₀ = 0 ∧
      ∀ m hm, ((constPerfectoid p S hS ϖ hϖ hreg hcomp).lift m hm).toRingHom.comp
          (quotMapOf (RingHom.id S) (constPerfectoid_varpi p S hS ϖ hϖ hreg hcomp (m + 1)).symm) =
        (powQuotMapOf (RingHom.id S) (constPerfectoid_varpi p S hS ϖ hϖ hreg hcomp m).symm p).comp
          (frobeniusModPow p ϖ hϖ) := sorry

/- The constant tower `K°⟨T⟩` (identity transition maps) over a perfectoid field is not
Frobenius-controlled for any `m₀`: no Frobenius-controlled tower is isomorphic to it as a direct
system with `ϖ ↦ ϖ`, since `T` is not a `p`-th power modulo `ϖ^p` in `K°⟨T⟩`. -/
-- test frobeniusTower_test_constDisc_not (non-example) [P7/frobenius-controlled-integral-tower]
example (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [IsPerfectoidField p K] (ϖ : powerBoundedSubring K) (hϖ : IsPseudoUniformizer (ϖ : K))
    (T : FrobeniusTower.{u} p) (e : ∀ m, T.A m ≃+*
      AdicCompletion (Ideal.span {Polynomial.C ϖ}) (Polynomial (powerBoundedSubring K)))
    (he : ∀ m x, e (m + 1) (T.t m x) = e m x) (h0 : e 0 T.ϖ = algebraMap _ _ (Polynomial.C ϖ)) :
    False := sorry

/- The tower `A_m⁺ = K°⟨T⟩` with transition maps `T ↦ T^p` (Mathlib `Polynomial.expand`) is
isomorphic, as a direct system, to the compatible-root disc tower (via `T ↦ T^{1/p^m}` at level
`m`), hence carries a Frobenius-controlled structure with `m₀ = 0`. -/
-- test frobeniusTower_test_powerMap (compatibility) [P7/frobenius-controlled-integral-tower]
example (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [IsPerfectoidField p K] (ϖ : PseudoUniformizerRoots p K) :
    ∃ (T : FrobeniusTower.{u} p) (e : ∀ m, T.A m ≃+* AdicCompletion
        (Ideal.span {Polynomial.C (ϖ.rootPB 0)}) (Polynomial (powerBoundedSubring K))),
      T.m₀ = 0 ∧ e 0 T.ϖ = algebraMap _ _ (Polynomial.C (ϖ.rootPB 0)) ∧
        ∀ m (q : Polynomial (powerBoundedSubring K)), e (m + 1) (T.t m ((e m).symm
          (algebraMap _ _ q))) = algebraMap _ _ (Polynomial.expand _ p q) := sorry

/- For the relative Frobenius tower over an integral perfectoid `O ∋ ϖ`, the lifts `w_m` are the
canonical base-change isomorphisms: they are `Φ_O`-semilinear, `w_m ∘ ι_{m+1} = ι_m ∘ Φ_O` on
`O/ϖ`. -/
-- test frobeniusTower_test_relativeFrobenius (characterisation)
--   [P7/frobenius-controlled-integral-tower]
example {O : Type u} [CommRing O] (hO : IsIntegralPerfectoid p O) (ϖ : O) (hϖ : ϖ ^ p ∣ (p : O))
    (A : ℕ → Type u) [∀ m, CommRing (A m)] [∀ m, Algebra O (A m)] [∀ m, Module.Flat O (A m)]
    (t : ∀ m, A m →ₐ[O] A (m + 1)) (hreg : ∀ m, IsSMulRegular (A m) (algebraMap O (A m) ϖ))
    (hcomp : ∀ m, IsAdicComplete (Ideal.span {algebraMap O (A m) ϖ}) (A m)) (m₀ : ℕ)
    (hrel : ∀ m, m₀ ≤ m → IsRelativeFrobenius (frobPowQuot p ϖ hϖ)
      (powQuotMapOf (algebraMap O (A (m + 1))) rfl p) (powQuotMapOf (algebraMap O (A m)) rfl p)
      (frobPowQuot p _ (pow_dvd_natCast_map p (algebraMap O (A (m + 1))) hϖ))
      (powQuotMapOf (t m).toRingHom ((t m).commutes ϖ) p)) (m : ℕ)
    (hm : (ofRelativeFrobenius p hO ϖ hϖ A t hreg hcomp m₀ hrel).m₀ ≤ m) :
    ((ofRelativeFrobenius p hO ϖ hϖ A t hreg hcomp m₀ hrel).lift m hm).toRingHom.comp
        (quotMapOf (algebraMap O (A (m + 1)))
          (ofRelativeFrobenius_varpi p hO ϖ hϖ A t hreg hcomp m₀ hrel (m + 1)).symm) =
      (powQuotMapOf (algebraMap O (A m))
        (ofRelativeFrobenius_varpi p hO ϖ hϖ A t hreg hcomp m₀ hrel m).symm p).comp
        (frobeniusModPow p ϖ hϖ) := sorry

end FrobeniusTowerTests

end Perfectoid

/-! ## PerfectoidSpaces:P7/frobenius-tower-completion (construction) -/

namespace Perfectoid.FrobeniusTower

variable {p : ℕ} [Fact p.Prime] (T : FrobeniusTower.{u} p)

/-- P7/frobenius-tower-completion (data): `A_∞⁺`, the `ϖ`-adic completion of `colim_m A_m⁺`
(Mathlib `AdicCompletion` of `Ring.DirectLimit`; Torsion, proof of Corollary III.2.19). -/
abbrev completedPlus : Type u := AdicCompletion (Ideal.span {T.varpiColim}) T.colim

/-- P7/frobenius-tower-completion (data): `ϖ ∈ A_∞⁺`. -/
def varpiCompleted : T.completedPlus := algebraMap T.colim T.completedPlus T.varpiColim

/-- P7/frobenius-tower-completion (projection): the compatible maps `A_m⁺ → A_∞⁺`. -/
def toCompleted (m : ℕ) : T.A m →+* T.completedPlus :=
  (algebraMap T.colim T.completedPlus).comp
    (_root_.Ring.DirectLimit.of T.A (fun i j h ↦ T.transition i j h) m)

/-- P7/frobenius-tower-completion (simp): `A_m⁺ → A_∞⁺` sends `ϖ` to `ϖ`. -/
theorem toCompleted_varpi (m : ℕ) : T.toCompleted m (T.varpi m) = T.varpiCompleted := sorry

/-- P7/frobenius-tower-completion (data): the canonical map `colim_m A_m⁺/ϖ^k → A_∞⁺/ϖ^k`. -/
def modVarpiPowColimToCompleted (k : ℕ) :
    T.modVarpiPowColim k →+* T.completedPlus ⧸ Ideal.span {T.varpiCompleted ^ k} :=
  _root_.Ring.DirectLimit.lift _ _ _
    (fun m ↦ Ideal.quotientMap _ (T.toCompleted m)
      (span_pow_le_comap_of_eq _ (T.toCompleted_varpi m) k)) sorry

/-- P7/frobenius-tower-completion (simp): `A_∞⁺/ϖ^k ≅ colim_m A_m⁺/ϖ^k` for every `k`: the
canonical map is bijective (Torsion, proof of Corollary III.2.19). -/
theorem completedPlus_quotient (k : ℕ) : Function.Bijective (T.modVarpiPowColimToCompleted k) :=
  sorry

/-- P7/frobenius-tower-completion (other): `A_∞⁺` is `ϖ`-torsion-free. -/
theorem completedPlus_torsionFree : IsSMulRegular T.completedPlus T.varpiCompleted := sorry

/-- P7/frobenius-tower-completion (other): `A_∞⁺` is `ϖ`-adically complete. -/
theorem completedPlus_isAdicComplete :
    IsAdicComplete (Ideal.span {T.varpiCompleted}) T.completedPlus := sorry

/-- P7/frobenius-tower-completion (universal-property): compatible maps `g_m : A_m⁺ → B` into a
`π`-adically complete ring with `g_0(ϖ) = π` extend uniquely to `A_∞⁺ → B` (uniqueness from the
density of `colim_m A_m⁺`). -/
theorem completedPlus_lift {B : Type*} [CommRing B] (π : B)
    [IsAdicComplete (Ideal.span {π}) B] (g : ∀ m, T.A m →+* B)
    (hg : ∀ m, (g (m + 1)).comp (T.t m) = g m) (hπ : g 0 T.ϖ = π) :
    ∃! G : T.completedPlus →+* B, ∀ m, G.comp (T.toCompleted m) = g m := sorry

/-- P7/frobenius-tower-completion (data): `A_∞ = A_∞⁺[1/ϖ]` (Mathlib `Localization.Away`). -/
abbrev completed : Type u := Localization.Away T.varpiCompleted

/-- P7/frobenius-tower-completion (instance): the topology on `A_∞` making `A_∞⁺` an open ring of
definition with the `ϖ`-adic topology. -/
instance : UniformSpace T.completed := sorry

/-- P7/frobenius-tower-completion (instance). -/
instance : IsUniformAddGroup T.completed := sorry

/-- P7/frobenius-tower-completion (instance). -/
instance : IsTopologicalRing T.completed := sorry

/-- P7/frobenius-tower-completion (instance): `A_∞` is a Tate ring with pseudouniformiser `ϖ`
(Tau Ceti `Huber.IsTateRing`). -/
instance completed_isTateRing : IsTateRing T.completed := sorry

/-- P7/frobenius-tower-completion (instance): `A_∞` is complete. -/
instance : CompleteSpace T.completed := sorry

/-- P7/frobenius-tower-completion (instance). -/
instance : T2Space T.completed := sorry

/-- P7/frobenius-tower-completion (characterisation): `ϖ` is a pseudouniformiser of `A_∞`, and
`A_∞⁺` is an open ring of definition of `A_∞` with ideal of definition `(ϖ)`. -/
theorem completed_pairOfDefinition :
    IsPseudoUniformizer (algebraMap T.completedPlus T.completed T.varpiCompleted) ∧
      ∃ (D : PairOfDefinition T.completed)
        (h : algebraMap T.completedPlus T.completed T.varpiCompleted ∈ D.ringOfDefinition),
        D.ringOfDefinition = (algebraMap T.completedPlus T.completed).range ∧
          D.idealOfDefinition = Ideal.span {⟨_, h⟩} := sorry

/-- P7/frobenius-tower-completion (data): the Huber pair `(A_∞, A_∞⁺⁺)`, `A_∞⁺⁺` the integral
closure of `A_∞⁺` in `A_∞` (Tau Ceti `Huber.Pair`). -/
def completedPair : Pair T.completed where
  plus := (integralClosure T.completedPlus T.completed).toSubring
  isRingOfIntegralElements := sorry

/-- P7/frobenius-tower-completion (projection): the compatible maps
`(A_m, A_m⁺⁺) → (A_∞, A_∞⁺⁺)`. -/
def toCompletedPair (m : ℕ) : Pair.Hom (T.genericFibre m) T.completedPair where
  toRingHom := Localization.awayLift
    ((algebraMap T.completedPlus T.completed).comp (T.toCompleted m)) _ sorry
  continuous_toRingHom := sorry
  map_mem_plus := sorry

/-- P7/frobenius-tower-completion (functoriality): the completion of a shifted tower is canonically
the same: `(T.shift k).completed ≅ T.completed`. -/
def completed_shift (k : ℕ) : (T.shift k).completed ≃+* T.completed := sorry

/-- P7/frobenius-tower-completion (functoriality): `completed_shift` is a homeomorphism. -/
theorem continuous_completed_shift (k : ℕ) :
    Continuous (T.completed_shift k) ∧ Continuous (T.completed_shift k).symm := sorry

/-- P7/frobenius-tower-completion (functoriality): a morphism of towers induces a continuous map
`A_∞ → A'_∞` of completions, extending the `f_m`. -/
def completed_map {T' : FrobeniusTower.{u} p} (φ : T.Hom T') : T.completed →+* T'.completed :=
  sorry

/-- P7/frobenius-tower-completion (functoriality): `completed_map` is continuous, sends `A_∞⁺⁺`
into `A'_∞⁺⁺`, and preserves identities and composition. -/
theorem completed_map_spec {T' T'' : FrobeniusTower.{u} p} (φ : T.Hom T') (ψ : T'.Hom T'') :
    Continuous (T.completed_map φ) ∧
      (∀ x ∈ T.completedPair.plus, T.completed_map φ x ∈ T'.completedPair.plus) ∧
      T.completed_map (Hom.id T) = RingHom.id _ ∧
      T.completed_map (ψ.comp T φ) = (T'.completed_map ψ).comp (T.completed_map φ) := sorry

/-- P7/frobenius-tower-completion (compatibility): `(A_∞, A_∞⁺⁺)` with the maps `toCompletedPair`
is the completed direct limit of the generic fibres `(A_m, A_m⁺⁺)` in the sense of
PerfectoidSpaces:P7/tilde-limit-from-completed-colimit (SW Proposition 2.4.2), with rings of
definition `A_m⁺` and pseudouniformiser `ϖ`. -/
theorem isCompletedDirectLimit :
    PerfectoidSpace.IsCompletedColimit_P7 T.genericFibre
      (fun a ↦ T.genericFibreHom _ _ (leOfHom a)) T.completedPair T.toCompletedPair
      (fun m ↦ (algebraMap (T.A m) (T.genericFibreRing m)).range)
      (algebraMap T.completedPlus T.completed T.varpiCompleted) := sorry

end Perfectoid.FrobeniusTower

section FrobeniusTowerCompletionTests

namespace Perfectoid

open FrobeniusTower

variable (p : ℕ) [Fact p.Prime]

/- For the compatible-root disc tower over `(R, R⁺)`, `A_∞ ≅ R⟨T^{1/p^∞}⟩` (P1
`perfectedTateAlgebra`), carrying `A_∞⁺` onto `R⁺⟨T^{1/p^∞}⟩` (P1 `perfectedTateAlgebra.plus`). -/
-- test frobeniusTower_completion_test_disc (computation) [P7/frobenius-tower-completion]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R)
    (ϖ : PseudoUniformizerRoots p R) (T : FrobeniusTower.{u} p)
    (e : ∀ m, T.A m ≃+* discLevel p P m)
    (h0 : (e 0 T.ϖ : perfectedTateAlgebra p R Unit) = algebraMap R _ (ϖ.root 0))
    (he : ∀ m (x : T.A m), (e (m + 1) (T.t m x) : perfectedTateAlgebra p R Unit) = e m x) :
    ∃ E : T.completed ≃+* perfectedTateAlgebra p R Unit, Continuous E ∧ Continuous E.symm ∧
      (algebraMap T.completedPlus T.completed).range.map E.toRingHom =
        (perfectedTateAlgebra.plus p (σ := Unit) P).plus := sorry

/- For the constant tower of an integral perfectoid ring `S`, the completion is `S`. -/
-- test frobeniusTower_completion_test_const (degenerate) [P7/frobenius-tower-completion]
example (S : Type u) [CommRing S] (hS : IsIntegralPerfectoid p S) (ϖ : S)
    (hϖ : ϖ ^ p ∣ (p : S)) (hreg : IsSMulRegular S ϖ) (hcomp : IsAdicComplete (Ideal.span {ϖ}) S) :
    Function.Bijective ((constPerfectoid p S hS ϖ hϖ hreg hcomp).toCompleted 0) := sorry

/- For the disc tower, `Σ_{n ≥ 1} ϖ^n T^{1/p^n}` lies in `A_∞⁺` but in no `A_m⁺`: the direct limit
itself is not complete. -/
-- test frobeniusTower_completion_test_needsCompletion (non-example)
--   [P7/frobenius-tower-completion]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [Nontrivial R]
    (P : Pair R) (ϖ : PseudoUniformizerRoots p R) (T : FrobeniusTower.{u} p)
    (e : ∀ m, T.A m ≃+* discLevel p P m)
    (h0 : (e 0 T.ϖ : perfectedTateAlgebra p R Unit) = algebraMap R _ (ϖ.root 0))
    (he : ∀ m (x : T.A m), (e (m + 1) (T.t m x) : perfectedTateAlgebra p R Unit) = e m x) :
    ∃ x : T.completedPlus, ∀ m, x ∉ Set.range (T.toCompleted m) := sorry

/- `A_∞⁺/ϖ^p ≅ colim_m A_m⁺/ϖ^p`, compatibly with the maps from the `A_m⁺`. -/
-- test frobeniusTower_completion_test_quotient (characterisation) [P7/frobenius-tower-completion]
example (T : FrobeniusTower.{u} p) :
    Function.Bijective (T.modVarpiPowColimToCompleted p) ∧
      ∀ m (x : T.A m), T.modVarpiPowColimToCompleted p
        (_root_.Ring.DirectLimit.of _ _ m (Ideal.Quotient.mk _ x)) =
          Ideal.Quotient.mk _ (T.toCompleted m x) := sorry

/- If the `A_m⁺` are the power-bounded subrings of a sequence of perfectoid Tate rings, the
completion is P1's completed filtered colimit (ECD Proposition 6.5). -/
-- test frobeniusTower_completion_test_ecd (compatibility) [P7/frobenius-tower-completion]
example (T : FrobeniusTower.{0} p) (F : ℕ ⥤ PerfectoidRingCat.{0} p)
    (ϖ : PseudoUniformizerRoots p (F.obj 0)) (e : ∀ m, T.A m ≃+* powerBoundedSubring (F.obj m))
    (he : ∀ m x, e (m + 1) (T.t m x) = powerBoundedMap p (F.map (homOfLE m.le_succ)).hom
      (F.map (homOfLE m.le_succ)).continuous_hom (e m x)) (h0 : e 0 T.ϖ = ϖ.rootPB 0) :
    Nonempty (T.completed ≃+* completedFilteredColimit p F 0 ϖ) := sorry

end Perfectoid

end FrobeniusTowerCompletionTests

/-! ## PerfectoidSpaces:P7/preperfectoid-space (definition) -/

/-! Preperfectoid spaces are analytic adic spaces in the generality of Scholze–Weinstein §2.1
(Yoneda-adic spaces, AdicEtaleGeometry:A1/generalized-adic-presentation) covered by affinoids
whose strong completion is perfectoid. The strong completion of a Tate pair is stated here; the
space-level predicate is a comment with the affinoid core `IsPreperfectoid_affinoid`. -/

namespace PerfectoidSpace

section StrongCompletionPair

variable {A : Type u} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsTateRing A]
  (P : Pair A) (ϖ : P.plus)

/-- P7/preperfectoid-space (data): `Â⁺`, the `ϖ`-adic completion of `A⁺` (Mathlib
`AdicCompletion`; SW Definition 2.3.4). -/
abbrev strongCompletionPair.integral : Type u := AdicCompletion (Ideal.span {ϖ}) P.plus

/-- P7/preperfectoid-space (data): `Â = Â⁺[1/ϖ]` (SW Definition 2.3.4). -/
abbrev strongCompletionPair.Carrier : Type u :=
  Localization.Away (algebraMap P.plus (strongCompletionPair.integral P ϖ) ϖ)

/-- P7/preperfectoid-space (instance): the topology on `Â` making `Â⁺` an open ring of definition
with the `ϖ`-adic topology. -/
instance : UniformSpace (strongCompletionPair.Carrier P ϖ) := sorry

/-- P7/preperfectoid-space (instance). -/
instance : IsUniformAddGroup (strongCompletionPair.Carrier P ϖ) := sorry

/-- P7/preperfectoid-space (instance). -/
instance : IsTopologicalRing (strongCompletionPair.Carrier P ϖ) := sorry

/-- P7/preperfectoid-space (instance): `Â` is a Tate ring with pseudouniformiser `ϖ`. -/
instance : IsTateRing (strongCompletionPair.Carrier P ϖ) := sorry

/-- P7/preperfectoid-space (instance): `Â` is complete. -/
instance : CompleteSpace (strongCompletionPair.Carrier P ϖ) := sorry

/-- P7/preperfectoid-space (instance). -/
instance : T2Space (strongCompletionPair.Carrier P ϖ) := sorry

/-- P7/preperfectoid-space (data): the *strong completion* `(Â, Â⁺)` of a Tate pair `(A, A⁺)` with
pseudouniformiser `ϖ ∈ A⁺`: `Â⁺` the `ϖ`-adic completion of `A⁺` and `Â = Â⁺[1/ϖ]`, the completion
of `A` for the topology giving `A⁺` its `ϖ`-adic topology (SW Definition 2.3.4, completing
`ϖ`-adically instead of `p`-adically). -/
def strongCompletionPair : Pair (strongCompletionPair.Carrier P ϖ) where
  plus := (algebraMap (strongCompletionPair.integral P ϖ) (strongCompletionPair.Carrier P ϖ)).range
  isRingOfIntegralElements := sorry

/-- P7/preperfectoid-space (data): the canonical map `(A, A⁺) → (Â, Â⁺)`, `A = A⁺[1/ϖ]`. -/
def strongCompletionPair.toPair : Pair.Hom P (strongCompletionPair P ϖ) := sorry

/-- P7/preperfectoid-space (characterisation): the strong completion does not depend on the
pseudouniformiser: for two pseudouniformisers `ϖ, ϖ' ∈ A⁺` there is a homeomorphic ring
isomorphism `Â_ϖ ≅ Â_ϖ'` of Huber pairs under `(A, A⁺)` (the `ϖ`- and `ϖ'`-adic topologies on
`A⁺` agree). -/
theorem strongCompletionPair_indep (ϖ ϖ' : P.plus) (hϖ : IsPseudoUniformizer (ϖ : A))
    (hϖ' : IsPseudoUniformizer (ϖ' : A)) :
    ∃ e : strongCompletionPair.Carrier P ϖ ≃+* strongCompletionPair.Carrier P ϖ',
      Continuous e ∧ Continuous e.symm ∧
        (strongCompletionPair P ϖ).plus.map e.toRingHom = (strongCompletionPair P ϖ').plus ∧
        ∀ a, e ((strongCompletionPair.toPair P ϖ).toRingHom a) =
          (strongCompletionPair.toPair P ϖ').toRingHom a := sorry

end StrongCompletionPair

/-- P7/preperfectoid-space (structure, affinoid core of `IsPreperfectoid`): the strong completion
of `(A, A⁺)` is a perfectoid Tate ring (ECD Definition 3.1, P1 `IsPerfectoidTateRing`); `X` is
preperfectoid if it is covered by affinoids `Spa(A, A⁺)` with this property. -/
def IsPreperfectoid_affinoid (p : ℕ) [Fact p.Prime] {A : Type u} [CommRing A] [TopologicalSpace A]
    [IsTopologicalRing A] [IsTateRing A] (P : Pair A) (ϖ : P.plus) : Prop :=
  Perfectoid.IsPerfectoidTateRing p (strongCompletionPair.Carrier P ϖ)

/-- P7/preperfectoid-space (instance, affinoid core of `IsPreperfectoid.of_isPerfectoid`): a
perfectoid Tate pair is its own strong completion, hence preperfectoid. -/
theorem IsPreperfectoid.of_isPerfectoid_affinoid (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R]
    [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R]
    [T2Space R] [Perfectoid.IsPerfectoidTateRing p R] (P : Pair R) (ϖ : P.plus)
    (hϖ : IsPseudoUniformizer (ϖ : R)) : IsPreperfectoid_affinoid p P ϖ := sorry

-- PerfectoidSpace.IsPreperfectoid: not stated here; needs analytic (Yoneda-)adic spaces and their
--   open affinoids (supplier: AdicEtaleGeometry:A1/generalized-adic-presentation, AdicSpaces
--   Layer 5). Affinoid core: `PerfectoidSpace.IsPreperfectoid_affinoid`.
-- PerfectoidSpace.IsPreperfectoid.of_isPerfectoid: not stated here; needs perfectoid spaces
--   (supplier: PerfectoidSpaces:P2/perfectoid-space). Affinoid core:
--   `PerfectoidSpace.IsPreperfectoid.of_isPerfectoid_affinoid`.
-- PerfectoidSpace.IsPreperfectoid.openSubspace: not stated here; needs open subspaces of adic
--   spaces (supplier: AdicSpaces Layer 5).
-- PerfectoidSpace.IsPreperfectoid.closedSubspace: not stated here; needs closed (Zariski-closed)
--   subspaces of adic spaces (supplier: AdicSpaces Layer 5; SW Proposition 2.3.7 uses
--   PerfectoidSpaces:P6/zariski-closed-equals-strongly-zariski-closed).
-- PerfectoidSpace.IsPreperfectoid.baseChange: not stated here; needs base change of adic spaces
--   to perfectoid fields (supplier: AdicSpaces Layer 5, AdicEtaleGeometry:A1/generalized-adic-
--   presentation).
-- PerfectoidSpace.IsPreperfectoid.strongCompletion: not stated here; needs the perfectoid space
--   `X̂` (supplier: PerfectoidSpaces:P7/strong-completion, PerfectoidSpaces:P2/perfectoid-space).

section PreperfectoidTests

open Perfectoid

variable (p : ℕ) [Fact p.Prime]

/- The nonreduced point `(ℂ_p[ε], O_{ℂ_p} + ℂ_p ε)`: `ε` is infinitely `ϖ`-divisible in the plus
ring, so the strong completion is `ℂ_p` and the pair is preperfectoid. -/
-- test isPreperfectoid_test_nonreducedPoint (computation) [P7/preperfectoid-space]
example : ∃ Q : Pair (DualNumber ℂ_[p]),
    (∀ x, x ∈ Q.plus ↔ TrivSqZeroExt.fst x ∈ powerBoundedSubring ℂ_[p]) ∧
      ∀ ϖ : Q.plus, IsPseudoUniformizer (ϖ : DualNumber ℂ_[p]) →
        IsPreperfectoid_affinoid p Q ϖ ∧ Nonempty (strongCompletionPair.Carrier Q ϖ ≃+* ℂ_[p]) :=
  sorry

/- A perfectoid pair is its own strong completion. -/
-- test isPreperfectoid_test_perfectoid (degenerate) [P7/preperfectoid-space]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R)
    (ϖ : P.plus) (hϖ : IsPseudoUniformizer (ϖ : R)) :
    IsPreperfectoid_affinoid p P ϖ ∧
      Function.Bijective (strongCompletionPair.toPair P ϖ).toRingHom := sorry

/- The closed unit disc `Spa(K⟨T⟩, K°⟨T⟩)` over a perfectoid field: `K°⟨T⟩` is already
`ϖ`-adically complete, and `K⟨T⟩` is not perfectoid (`T` is not a `p`-th power modulo `ϖ^p`). -/
-- test isPreperfectoid_test_disc_not (non-example) [P7/preperfectoid-space]
example (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [IsPerfectoidField p K] [IsTateRing (restrictedMvPowerSeriesCompletion 1 K)]
    (ϖ : (Pair.powerBounded (restrictedMvPowerSeriesCompletion 1 K)).plus)
    (hϖ : IsPseudoUniformizer (ϖ : restrictedMvPowerSeriesCompletion 1 K)) :
    ¬ IsPreperfectoid_affinoid p (Pair.powerBounded (restrictedMvPowerSeriesCompletion 1 K)) ϖ :=
  sorry

/- Over a perfectoid field of characteristic `0`, `p` is a pseudouniformiser of `A⁺`, and the
`ϖ`-adic strong completion is the `p`-adic one of SW Definition 2.3.4. -/
-- test isPreperfectoid_test_overField (compatibility) [P7/preperfectoid-space]
example (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [IsPerfectoidField p K] [CharZero K] {A : Type u} [CommRing A] [TopologicalSpace A]
    [IsTopologicalRing A] [IsTateRing A] [Algebra K A] (hK : Continuous (algebraMap K A))
    (P : Pair A) (ϖ : P.plus) (hϖ : IsPseudoUniformizer (ϖ : A)) :
    IsPseudoUniformizer (p : A) ∧
      Nonempty (strongCompletionPair.Carrier P ϖ ≃+*
        strongCompletionPair.Carrier P ⟨(p : A), natCast_mem P.plus p⟩) := sorry

end PreperfectoidTests

end PerfectoidSpace

/-! ## PerfectoidSpaces:P7/strong-completion (construction) -/

/-! The strong completion `X̂ → X` of a preperfectoid space is glued from the `Spa(Â, Â⁺)`; it
needs perfectoid spaces and Yoneda-adic spaces. Its affinoid content is stated for
`strongCompletionPair`. -/

-- PerfectoidSpace.strongCompletion: not stated here; needs perfectoid spaces and morphisms of
--   Yoneda-adic spaces (supplier: PerfectoidSpaces:P2/perfectoid-space,
--   AdicEtaleGeometry:A1/generalized-adic-presentation). Affinoid core:
--   `PerfectoidSpace.strongCompletionPair`.
-- PerfectoidSpace.strongCompletion.homeomorph: not stated here; needs `strongCompletion`
--   (supplier: PerfectoidSpaces:P2/perfectoid-space). Affinoid core: the fields `isEmbedding`,
--   `range_eq` of `PerfectoidSpace.strongCompletion.isTildeLimit_affinoid`.
-- PerfectoidSpace.strongCompletion.affinoid: not stated here; needs open subspaces of `X̂`
--   (supplier: PerfectoidSpaces:P2/open-subspaces-of-perfectoid-spaces).
-- PerfectoidSpace.strongCompletion.lift: not stated here; needs morphisms of perfectoid spaces
--   into Yoneda-adic spaces (supplier: AdicEtaleGeometry:A1/generalized-adic-presentation).
--   Affinoid core: `PerfectoidSpace.strongCompletion.lift_affinoid`.
-- PerfectoidSpace.strongCompletion.isTildeLimit: not stated here; needs `IsTildeLimit` (supplier:
--   AdicSpaces Layer 5). Affinoid core: `PerfectoidSpace.strongCompletion.isTildeLimit_affinoid`.
-- PerfectoidSpace.strongCompletion.map: not stated here; needs morphisms of preperfectoid spaces
--   (supplier: AdicEtaleGeometry:A1/generalized-adic-presentation). Affinoid core:
--   `PerfectoidSpace.strongCompletion.map_affinoid`.
-- PerfectoidSpace.strongCompletion.of_perfectoid: not stated here; needs perfectoid spaces
--   (supplier: PerfectoidSpaces:P2/perfectoid-space). Affinoid core:
--   `PerfectoidSpace.strongCompletion.of_perfectoid_affinoid`.

namespace PerfectoidSpace

section StrongCompletionAffinoid

variable {A : Type u} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsTateRing A]

/-- P7/strong-completion (compatibility, affinoid core of `strongCompletion.isTildeLimit` and
`strongCompletion.homeomorph`): `Spa(Â, Â⁺) ~ Spa(A, A⁺)`: the map of adic spectra is a
homeomorphism and `A → Â` has dense image (SW Propositions 2.3.6 (i), 2.4.4). -/
theorem strongCompletion.isTildeLimit_affinoid (P : Pair A) (ϖ : P.plus)
    (hϖ : IsPseudoUniformizer (ϖ : A)) :
    IsTildeLimit_affinoid (J := Discrete PUnit) (fun _ ↦ P) (fun _ ↦ Pair.Hom.id P)
      (strongCompletionPair P ϖ) fun _ ↦ strongCompletionPair.toPair P ϖ := sorry

/-- P7/strong-completion (universal-property, affinoid core of `strongCompletion.lift`): every
morphism from `(A, A⁺)` to a perfectoid pair `(B, B⁺)` factors uniquely through the strong
completion (`B⁺` is `ϖ`-adically complete; SW Proposition 2.3.6 (ii)). -/
theorem strongCompletion.lift_affinoid (p : ℕ) [Fact p.Prime] (P : Pair A) (ϖ : P.plus)
    (hϖ : IsPseudoUniformizer (ϖ : A)) {B : Type*} [CommRing B] [UniformSpace B]
    [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B] [CompleteSpace B] [T2Space B]
    [Perfectoid.IsPerfectoidTateRing p B] (S : Pair B) (φ : Pair.Hom P S) :
    ∃! ψ : Pair.Hom (strongCompletionPair P ϖ) S,
      ψ.toRingHom.comp (strongCompletionPair.toPair P ϖ).toRingHom = φ.toRingHom := sorry

/-- P7/strong-completion (functoriality, affinoid core of `strongCompletion.map`): a morphism
`φ : (A, A⁺) → (A', A'⁺)` of Tate pairs induces `(Â, Â⁺) → (Â', Â'⁺)` for `ϖ ↦ φ(ϖ)`. -/
def strongCompletion.map_affinoid {A' : Type u} [CommRing A'] [TopologicalSpace A']
    [IsTopologicalRing A'] [IsTateRing A'] {P : Pair A} {P' : Pair A'} (φ : Pair.Hom P P')
    (ϖ : P.plus) :
    Pair.Hom (strongCompletionPair P ϖ)
      (strongCompletionPair P' ⟨φ.toRingHom ϖ, φ.map_mem_plus _ ϖ.2⟩) := sorry

/-- P7/strong-completion (functoriality): `map_affinoid` commutes with the canonical maps. -/
theorem strongCompletion.map_affinoid_comp {A' : Type u} [CommRing A'] [TopologicalSpace A']
    [IsTopologicalRing A'] [IsTateRing A'] {P : Pair A} {P' : Pair A'} (φ : Pair.Hom P P')
    (ϖ : P.plus) :
    (strongCompletion.map_affinoid φ ϖ).toRingHom.comp (strongCompletionPair.toPair P ϖ).toRingHom =
      (strongCompletionPair.toPair P' _).toRingHom.comp φ.toRingHom := sorry

/-- P7/strong-completion (example, affinoid core of `strongCompletion.of_perfectoid`): for a
perfectoid pair the canonical map `(R, R⁺) → (R̂, R̂⁺)` is an isomorphism. -/
theorem strongCompletion.of_perfectoid_affinoid (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R]
    [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R]
    [T2Space R] [Perfectoid.IsPerfectoidTateRing p R] (P : Pair R) (ϖ : P.plus)
    (hϖ : IsPseudoUniformizer (ϖ : R)) :
    Function.Bijective (strongCompletionPair.toPair P ϖ).toRingHom ∧
      (strongCompletionPair P ϖ).plus = (P.plus.map (strongCompletionPair.toPair P ϖ).toRingHom) :=
  sorry

end StrongCompletionAffinoid

section StrongCompletionTests

open Perfectoid

variable (p : ℕ) [Fact p.Prime]

/- The strong completion of the nonreduced point `(ℂ_p[ε], O_{ℂ_p} + ℂ_p ε)` is `(ℂ_p, O_{ℂ_p})`,
with `ε ↦ 0`. -/
-- test strongCompletion_test_nonreducedPoint (computation) [P7/strong-completion]
example (Q : Pair (DualNumber ℂ_[p]))
    (hQ : ∀ x, x ∈ Q.plus ↔ TrivSqZeroExt.fst x ∈ powerBoundedSubring ℂ_[p]) (ϖ : Q.plus)
    (hϖ : IsPseudoUniformizer (ϖ : DualNumber ℂ_[p])) :
    ∃ e : strongCompletionPair.Carrier Q ϖ ≃+* ℂ_[p], Continuous e ∧
      ∀ x, e ((strongCompletionPair.toPair Q ϖ).toRingHom x) = TrivSqZeroExt.fst x := sorry

/- For a perfectoid pair, `(R, R⁺) → (R̂, R̂⁺)` is an isomorphism. -/
-- test strongCompletion_test_perfectoid (degenerate) [P7/strong-completion]
example (ϖ : (Pair.powerBounded ℂ_[p]).plus) (hϖ : IsPseudoUniformizer (ϖ : ℂ_[p])) :
    Function.Bijective (strongCompletionPair.toPair (Pair.powerBounded ℂ_[p]) ϖ).toRingHom :=
  sorry

/- `Spa(ℂ_p) → Spa(ℂ_p[ε], O + ℂ_p ε)` is a homeomorphism with dense image on functions, but
`ℂ_p[ε] → ℂ_p` is not injective: `X̂ ~ X` does not mean `X̂ ≅ X`. -/
-- test strongCompletion_test_not_iso (non-example) [P7/strong-completion]
example (Q : Pair (DualNumber ℂ_[p]))
    (hQ : ∀ x, x ∈ Q.plus ↔ TrivSqZeroExt.fst x ∈ powerBoundedSubring ℂ_[p]) (ϖ : Q.plus)
    (hϖ : IsPseudoUniformizer (ϖ : DualNumber ℂ_[p])) :
    IsTildeLimit_affinoid (J := Discrete PUnit) (fun _ ↦ Q) (fun _ ↦ Pair.Hom.id Q)
        (strongCompletionPair Q ϖ) (fun _ ↦ strongCompletionPair.toPair Q ϖ) ∧
      ¬ Function.Injective (strongCompletionPair.toPair Q ϖ).toRingHom := sorry

/- Every morphism from the nonreduced point to a perfectoid pair kills `ε`: it factors through
the strong completion `(ℂ_p, O_{ℂ_p})`. -/
-- test strongCompletion_test_universal (characterisation) [P7/strong-completion]
example (Q : Pair (DualNumber ℂ_[p]))
    (hQ : ∀ x, x ∈ Q.plus ↔ TrivSqZeroExt.fst x ∈ powerBoundedSubring ℂ_[p]) {B : Type}
    [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B]
    [CompleteSpace B] [T2Space B] [IsPerfectoidTateRing p B] (S : Pair B) (φ : Pair.Hom Q S) :
    φ.toRingHom DualNumber.eps = 0 := sorry

end StrongCompletionTests

end PerfectoidSpace

/-! ## PerfectoidSpaces:P7/level-cofinality-witness (definition) -/

namespace PerfectoidSpace

section Cofinality

variable (G : Type u) [Group G] [TopologicalSpace G]

/-- P7/level-cofinality-witness (data): the compact open subgroups `CO(G)` of a topological group,
ordered by inclusion (a preorder category; cofiltered for a locally profinite `G`). -/
abbrev LevelFamily.CompactOpen : Type u := {U : OpenSubgroup G // IsCompact (U : Set G)}

/-- P7/level-cofinality-witness (structure): a *level family*: a cofiltered category `J` with a
functor `j ↦ K_j` to the compact open subgroups of `G` (BHW proof of Theorem 5.11; CHJ Theorem
2.8). -/
structure LevelFamily (J : Type*) [Category J] [IsCofiltered J] where
  /-- The functor `j ↦ K_j`. -/
  K : J ⥤ LevelFamily.CompactOpen G

variable {G} {J : Type*} [Category J] [IsCofiltered J]

/-- P7/level-cofinality-witness (structure): a *cofinality witness* for a level family: a choice
`j(U)` with `K_{j(U)} ⊆ U` for every open subgroup `U` of `G` (Scholze, erratum to *p-adic Hodge
theory for rigid-analytic varieties*, item (1)). -/
structure CofinalityWitness (L : LevelFamily G J) where
  /-- The level `j(U)`. -/
  index : OpenSubgroup G → J
  /-- `K_{j(U)} ⊆ U`. -/
  le : ∀ U, ((L.K.obj (index U)).1 : Set G) ⊆ U

namespace CofinalityWitness

variable {L : LevelFamily G J}

/-- P7/level-cofinality-witness (equivalence): a witnessed level family `J → CO(G)` is initial
(Mathlib `Functor.initial_of_exists_of_isCofiltered`: morphisms of `CO(G)` are unique). -/
theorem initial (w : CofinalityWitness L) : L.K.Initial := sorry

-- PerfectoidSpace.CofinalityWitness.isTildeLimit_iff: not stated here; needs `IsTildeLimit` for
--   towers `(X_K)_{K ∈ CO(G)}` of adic spaces (supplier: AdicSpaces Layer 5,
--   PerfectoidSpaces:P7/perfectoid-tilde-limit). Affinoid core:
--   `PerfectoidSpace.CofinalityWitness.isTildeLimit_iff_affinoid`.

/-- P7/level-cofinality-witness (compatibility, affinoid core of `isTildeLimit_iff`): for a tower
of affinoids indexed by `CO(G)` (coordinate rings indexed by `CO(G)ᵒᵖ`) and a witnessed level
family, `X ~ lim_{CO(G)} X_K` iff `X ~ lim_J X_{K_j}` (PerfectoidSpaces:P7/tilde-limit-cofinal-
change). -/
theorem isTildeLimit_iff_affinoid (w : CofinalityWitness L)
    [IsCofiltered (LevelFamily.CompactOpen G)] {A : (LevelFamily.CompactOpen G)ᵒᵖ → Type*}
    [∀ K, CommRing (A K)] [∀ K, TopologicalSpace (A K)] [∀ K, IsTopologicalRing (A K)]
    [∀ K, IsHuberRing (A K)] (P : ∀ K, Pair (A K)) (f : ∀ {K K'}, (K ⟶ K') → Pair.Hom (P K) (P K'))
    {R : Type*} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [IsHuberRing R]
    (Q : Pair R) (g : ∀ K, Pair.Hom (P K) Q) :
    IsTildeLimit_affinoid P f Q g ↔
      IsTildeLimit_affinoid (fun j : Jᵒᵖ ↦ P (L.K.op.obj j)) (fun a ↦ f (L.K.op.map a)) Q
        fun j ↦ g (L.K.op.obj j) := sorry

/-- P7/level-cofinality-witness (constructor): a decreasing sequence `K_0 ⊇ K_1 ⊇ ⋯` of compact
open subgroups of a Hausdorff group with trivial intersection has a witness
(PerfectoidSpaces:P7/compact-open-subgroup-cofinality). -/
def ofDecreasing [IsTopologicalGroup G] [T2Space G] (L : LevelFamily G ℕᵒᵈ)
    (h : ⨅ n : ℕ, (L.K.obj (OrderDual.toDual n)).1.toSubgroup = ⊥) : CofinalityWitness L :=
  sorry

/-- P7/level-cofinality-witness (data): the principal congruence subgroup
`K(p^n) = ker(GL_N(ℤ_p) → GL_N(ℤ/p^n)) = 1 + p^n M_N(ℤ_p)`. -/
def congruenceSubgroup (p : ℕ) [Fact p.Prime] (N n : ℕ) :
    Subgroup (Matrix.GeneralLinearGroup (Fin N) ℤ_[p]) :=
  (Matrix.GeneralLinearGroup.map (PadicInt.toZModPow n)).ker

/-- P7/level-cofinality-witness (example): the principal congruence subgroups `H ∩ K(p^n)`,
`n ≥ 1`, of a closed subgroup `H ⊆ GL_N(ℤ_p)` are cofinal among the open subgroups of `H`, so they
are witnessed in `H` (PerfectoidSpaces:P7/compact-open-subgroup-cofinality (i)). -/
theorem principalCongruence (p : ℕ) [Fact p.Prime] (N : ℕ)
    (H : Subgroup (Matrix.GeneralLinearGroup (Fin N) ℤ_[p]))
    (hH : IsClosed (H : Set (Matrix.GeneralLinearGroup (Fin N) ℤ_[p]))) (U : OpenSubgroup H) :
    ∃ n, 1 ≤ n ∧ (congruenceSubgroup p N n).subgroupOf H ≤ U.toSubgroup := sorry

/-- P7/level-cofinality-witness (functoriality): if `(K_j)` is witnessed, so is `(g K_j g⁻¹)`. -/
def conj [IsTopologicalGroup G] (w : CofinalityWitness L) (g : G) (L' : LevelFamily G J)
    (hL' : ∀ j, ((L'.K.obj j).1 : Set G) = (fun x ↦ g * x * g⁻¹) '' (L.K.obj j).1) :
    CofinalityWitness L' := sorry

/-- P7/level-cofinality-witness (functoriality): if `K'_j ⊆ K_j` and `(K_j)` is witnessed, so is
`(K'_j)`, with the same levels. -/
def mono (w : CofinalityWitness L) (L' : LevelFamily G J) (h : ∀ j, L'.K.obj j ≤ L.K.obj j) :
    CofinalityWitness L' where
  index := w.index
  le _ := sorry

/-- P7/level-cofinality-witness (example): in a profinite group, a level family through every open
normal subgroup is witnessed (Mathlib `ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one`).
-/
theorem openNormal [IsTopologicalGroup G] [CompactSpace G] [TotallyDisconnectedSpace G]
    (L : LevelFamily G J) (hL : ∀ N : OpenNormalSubgroup G, ∃ j, ((L.K.obj j).1 : Set G) = N) :
    Nonempty (CofinalityWitness L) := sorry

end CofinalityWitness

end Cofinality

section CofinalityTests

variable (p : ℕ) [Fact p.Prime]

/- In `GL_N(ℚ_p)`, every open subgroup contains some `K(p^n) = 1 + p^n M_N(ℤ_p)`, `n ≥ 1`: the
witness is `U ↦` the least such `n`. -/
-- test cofinalityWitness_test_principalCongruence (computation) [P7/level-cofinality-witness]
example (N : ℕ) (U : OpenSubgroup (Matrix.GeneralLinearGroup (Fin N) ℚ_[p])) :
    ∃ n, 1 ≤ n ∧ (CofinalityWitness.congruenceSubgroup p N n).map
      (Matrix.GeneralLinearGroup.map (PadicInt.Coe.ringHom (p := p))) ≤ U.toSubgroup := sorry

/- For a finite discrete group, the one-member family `{1}` is witnessed. -/
-- test cofinalityWitness_test_discrete (degenerate) [P7/level-cofinality-witness]
example (G : Type u) [Group G] [TopologicalSpace G] [DiscreteTopology G] [Finite G]
    (L : LevelFamily G (Discrete PUnit)) (hL : (L.K.obj ⟨⟨⟩⟩).1.toSubgroup = ⊥) :
    Nonempty (CofinalityWitness L) := sorry

/- `Γ₀(p^n)` is not cofinal in `GL₂(ℤ_p)`: every `Γ₀(p^n)` contains `(1 1; 0 1)`, which lies
outside the open subgroup `K(p)`. -/
-- test cofinalityWitness_test_gamma0_not (non-example) [P7/level-cofinality-witness]
example : ∃ U : OpenSubgroup (Matrix.GeneralLinearGroup (Fin 2) ℤ_[p]), ∀ n : ℕ,
    ∃ g : Matrix.GeneralLinearGroup (Fin 2) ℤ_[p],
      PadicInt.toZModPow n ((g : Matrix (Fin 2) (Fin 2) ℤ_[p]) 1 0) = 0 ∧ g ∉ U := sorry

/- A constant family `K_j = K ≠ {1}` in a profinite group has no witness. -/
-- test cofinalityWitness_test_const_not (non-example) [P7/level-cofinality-witness]
example (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
    [T2Space G] [TotallyDisconnectedSpace G] {J : Type*} [Category J] [IsCofiltered J]
    (L : LevelFamily G J) (K : LevelFamily.CompactOpen G) (hL : ∀ j, L.K.obj j = K)
    (hK : K.1.toSubgroup ≠ ⊥) : IsEmpty (CofinalityWitness L) := sorry

/- A witness makes `j ↦ K_j` initial, so `Functor.Initial.limitIso` identifies
`lim_J |X_{K_j}|` with `lim_{CO(G)} |X_K|`. -/
-- test cofinalityWitness_test_initial (compatibility) [P7/level-cofinality-witness]
example (G : Type u) [Group G] [TopologicalSpace G] {J : Type u} [SmallCategory J]
    [IsCofiltered J] (L : LevelFamily G J) (w : CofinalityWitness L)
    (X : LevelFamily.CompactOpen G ⥤ TopCat.{u}) : Nonempty (limit (L.K ⋙ X) ≅ limit X) := sorry

end CofinalityTests

end PerfectoidSpace

/-! ## PerfectoidSpaces:P7/good-affinoid-perfectoid-basis (lemma) -/

-- PerfectoidSpace.IsTildeLimit.exists_goodAffinoid_basis: not stated here; needs good affinoid
--   perfectoids and the topology of perfectoid spaces (supplier:
--   PerfectoidSpaces:P2/affinoid-perfectoid-space, AdicSpaces Layer 5). Statement (Survey
--   Proposition 2.22): given `|X| ≅ lim |X_i|`, `X ~ lim X_i` iff `X` is covered by good affinoid
--   perfectoids (with `V` affinoid at their level); rational subsets of good affinoid perfectoids
--   are good at a larger level, so they form a basis. Affinoid core of (ii):
--   `PerfectoidSpace.IsTildeLimit.exists_rationalSubset_finiteLevel_affinoid`.

/-! ## PerfectoidSpaces:P7/tilde-limit-implies-residue-field-tilde-limit (lemma) -/

-- PerfectoidSpace.IsResidueFieldTildeLimit.of_isTildeLimit: not stated here; needs `IsTildeLimit`,
--   `IsResidueFieldTildeLimit` and the completed residue fields `k(x)^` (supplier: AdicSpaces
--   Layer 5, PerfectoidSpaces:P2/completed-residue-fields). Statement (SW after Theorem 2.4.7): a
--   perfectoid tilde-limit over qcqs locally noetherian `X_i` is a residue-field tilde-limit.

/-! ## PerfectoidSpaces:P7/tilde-limit-from-completed-colimit (lemma) -/

-- PerfectoidSpace.isTildeLimit_spa_completedColimit: not stated here; needs the adic spaces
--   `X_i = Spa(A_i, A_i⁺)` (sheafy `A_i`) and `Spa(Â, Â⁺)` as a perfectoid space (supplier:
--   AdicSpaces Layer 5, PerfectoidSpaces:P2/perfectoid-space). Affinoid core:
--   `PerfectoidSpace.IsCompletedColimit_P7.isTildeLimit_affinoid`.

namespace PerfectoidSpace

section CompletedColimit

variable {J : Type*} [Category J] [IsFiltered J] {A : J → Type*} [∀ j, CommRing (A j)]
  [∀ j, TopologicalSpace (A j)] [∀ j, IsTopologicalRing (A j)] [∀ j, IsHuberRing (A j)]
  {P : ∀ j, Pair (A j)} {f : ∀ {i j : J}, (i ⟶ j) → Pair.Hom (P i) (P j)}
  {R : Type*} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [IsHuberRing R]
  {Q : Pair R} {g : ∀ j, Pair.Hom (P j) Q} {A₀ : ∀ j, Subring (A j)} {ϖ : R}

/-- P7/tilde-limit-from-completed-colimit (ii), (iv): for a completed direct limit of Tate pairs
with rings of definition `A_{j,0}` (open and bounded), `Spa(R, R⁺) → lim_j Spa(A_j, A_j⁺)` is a
homeomorphism and `⋃_j im(A_j)` is dense in `R`, i.e. an affinoid tilde-limit (SW Proposition
2.4.2; a valuation of `colim A_j` is continuous with `|A⁺| ≤ 1` iff its restrictions are). -/
theorem IsCompletedColimit_P7.isTildeLimit_affinoid
    (hA₀ : ∀ j, IsOpen (A₀ j : Set (A j)) ∧ IsBounded (A₀ j : Set (A j)))
    (h : IsCompletedColimit_P7 P f Q g A₀ ϖ) : IsTildeLimit_affinoid P f Q g := sorry

/-- P7/tilde-limit-from-completed-colimit (iii): every rational subset of `Spa(R, R⁺)` is the
preimage of a rational subset of some `Spa(A_j, A_j⁺)` (SW proof of Proposition 2.4.2). -/
theorem IsCompletedColimit_P7.exists_rationalSubset
    (hA₀ : ∀ j, IsOpen (A₀ j : Set (A j)) ∧ IsBounded (A₀ j : Set (A j)))
    (h : IsCompletedColimit_P7 P f Q g A₀ ϖ) {U : Set (spa Q.plus)}
    (hU : U ∈ spaRationalFamily Q.plus) :
    ∃ (j : J) (T : Finset (A j)) (s : A j),
      U = (g j).spaComap ⁻¹' (Subtype.val ⁻¹' rationalSubset (P j).plus T s) := sorry

end CompletedColimit

/-! ## PerfectoidSpaces:P7/good-affinoid-uniform-completion (lemma) -/

-- Clause (ii), the equivalence `2-colim_a FÉt(A_a) → FÉt(R)`, is the packet item
-- `PerfectoidSpace.GoodAffinoid.finiteEtaleEquiv`, not stated under
-- PerfectoidSpaces:P7/good-affinoid-perfectoid (it needs 2-colimits of categories of finite étale
-- algebras: PerfectoidSpaces:P3/finite-etale-completed-direct-limit,
-- PerfectoidSpaces:P3/henselian-finite-etale-approximation, AdicEtaleGeometry:A1/finite-etale-
-- approximation).

/-- P7/good-affinoid-uniform-completion (i), affinoid core of `GoodAffinoid.isUniformCompletion`:
if `Spa(R, R⁺) ~ lim_j Spa(A_j, A_j⁺)` with `R` perfectoid and `(C, C⁺)` is the completed direct
limit of the `(A_j, A_j⁺)` with its map `φ` to `(R, R⁺)`, then `R` is the uniformisation `Cᵘ` of
`C` (KL Definition 2.8.13; AdicSpacesPartII:R0/uniformization) and `R⁺` is the integral closure of
`Cᵘ⁺` (KL Proposition 2.8.16 (a); SW proof of Proposition 2.4.5). -/
theorem GoodAffinoid.isUniformCompletion_affinoid (p : ℕ) [Fact p.Prime] {J : Type*} [Category J]
    [IsFiltered J] {A : J → Type*} [∀ j, CommRing (A j)] [∀ j, TopologicalSpace (A j)]
    [∀ j, IsTopologicalRing (A j)] [∀ j, IsHuberRing (A j)] {P : ∀ j, Pair (A j)}
    {f : ∀ {i j : J}, (i ⟶ j) → Pair.Hom (P i) (P j)} {R : Type*} [CommRing R] [UniformSpace R]
    [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [Perfectoid.IsPerfectoidTateRing p R] {Q : Pair R} {g : ∀ j, Pair.Hom (P j) Q}
    (hQ : IsTildeLimit_affinoid P f Q g) {C : Type*} [CommRing C] [TopologicalSpace C]
    [IsTopologicalRing C] [IsTateRing C] {Qc : Pair C} {h : ∀ j, Pair.Hom (P j) Qc}
    {A₀ : ∀ j, Subring (A j)} {ϖ : C} (hC : IsCompletedColimit_P7 P f Qc h A₀ ϖ)
    (φ : Pair.Hom Qc Q) (hφ : ∀ j, φ.toRingHom.comp (h j).toRingHom = (g j).toRingHom) :
    ∃ e : Uniformization C ≃+* R, Continuous e ∧ Continuous e.symm ∧
      e.toRingHom.comp (Pair.toUniformization Qc).toRingHom = φ.toRingHom ∧
      Q.plus = (integralClosure (Qc.uniformization.plus.map e.toRingHom) R).toSubring := sorry

/-! ## PerfectoidSpaces:P7/rational-subsets-from-finite-level (lemma) -/

-- PerfectoidSpace.IsTildeLimit.exists_rationalSubset_finiteLevel: not stated here; needs
--   quasicompact opens of perfectoid spaces and good affinoid perfectoids (supplier: AdicSpaces
--   Layer 5, PerfectoidSpaces:P2/affinoid-perfectoid-space). Affinoid cores below.

section FiniteLevel

variable {J : Type*} [Category J] [IsFiltered J] {A : J → Type*} [∀ j, CommRing (A j)]
  [∀ j, TopologicalSpace (A j)] [∀ j, IsTopologicalRing (A j)] [∀ j, IsHuberRing (A j)]
  {P : ∀ j, Pair (A j)} {f : ∀ {i j : J}, (i ⟶ j) → Pair.Hom (P i) (P j)}
  {R : Type*} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [IsHuberRing R]
  {Q : Pair R} {g : ∀ j, Pair.Hom (P j) Q}

/-- P7/rational-subsets-from-finite-level (iii), affinoid core: every rational subset of
`Spa(R, R⁺)` is the preimage of a rational subset of some `Spa(A_j, A_j⁺)` (Survey proof of
Proposition 2.22 (ii): approximate the parameters by elements from finite level, Tau Ceti
`exists_mem_nhds_forall_rationalSubset_eq_of_sub_mem`). -/
theorem IsTildeLimit.exists_rationalSubset_finiteLevel_affinoid
    (h : IsTildeLimit_affinoid P f Q g) {U : Set (spa Q.plus)}
    (hU : U ∈ spaRationalFamily Q.plus) :
    ∃ (j : J) (T : Finset (A j)) (s : A j),
      U = (g j).spaComap ⁻¹' (Subtype.val ⁻¹' rationalSubset (P j).plus T s) := sorry

/-- P7/rational-subsets-from-finite-level (i), affinoid core: every quasicompact open of
`Spa(R, R⁺)` is the preimage of a quasicompact open at a finite level (Stacks Tag 0A30). -/
theorem IsTildeLimit.exists_isCompact_finiteLevel_affinoid (h : IsTildeLimit_affinoid P f Q g)
    {U : Set (spa Q.plus)} (hU : IsOpen U) (hc : IsCompact U) :
    ∃ (j : J) (V : Set (spa (P j).plus)), IsOpen V ∧ IsCompact V ∧ U = (g j).spaComap ⁻¹' V :=
  sorry

/-- P7/rational-subsets-from-finite-level (i), affinoid core: an inclusion of preimages of
quasicompact opens `V ⊆ Spa(A_i, A_i⁺)` holds already at some finite level `a : i ⟶ j`. -/
theorem IsTildeLimit.preimage_subset_finiteLevel_affinoid (h : IsTildeLimit_affinoid P f Q g)
    {i : J} {V V' : Set (spa (P i).plus)} (hV : IsOpen V ∧ IsCompact V)
    (hV' : IsOpen V' ∧ IsCompact V') (hsub : (g i).spaComap ⁻¹' V ⊆ (g i).spaComap ⁻¹' V') :
    ∃ (j : J) (a : i ⟶ j), (f a).spaComap ⁻¹' V ⊆ (f a).spaComap ⁻¹' V' := sorry

end FiniteLevel

/-! ## PerfectoidSpaces:P7/tilde-limit-perfectoid-uniqueness (theorem) -/

-- The space-level statement (`Hom(Y, X) ≅ lim_i Hom(Y, X_i)` for `Y` perfectoid, or covered by
-- `Spa(B, B⁺)` with `B` uniform; uniqueness of `X`; functoriality in the system) is the packet
-- item `PerfectoidSpace.IsTildeLimit.lift`, not stated under PerfectoidSpaces:P7/perfectoid-tilde-
-- limit (it needs morphisms of adic spaces, AdicSpaces Layer 5). Affinoid cores below.

section Uniqueness

variable (p : ℕ) [Fact p.Prime] {J : Type*} [Category J] [IsFiltered J] {A : J → Type*}
  [∀ j, CommRing (A j)] [∀ j, TopologicalSpace (A j)] [∀ j, IsTopologicalRing (A j)]
  [∀ j, IsHuberRing (A j)] {P : ∀ j, Pair (A j)} {f : ∀ {i j : J}, (i ⟶ j) → Pair.Hom (P i) (P j)}
  {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
  [IsTateRing R] [CompleteSpace R] [T2Space R] [Perfectoid.IsPerfectoidTateRing p R]
  {Q : Pair R} {g : ∀ j, Pair.Hom (P j) Q}

/-- P7/tilde-limit-perfectoid-uniqueness (affinoid core of `IsTildeLimit.lift`): if
`Spa(R, R⁺) ~ lim_j Spa(A_j, A_j⁺)` with `R` perfectoid, compatible morphisms `(A_j, A_j⁺) →
(B, B⁺)` into a complete uniform Tate pair factor uniquely through `(R, R⁺)` (SW Proposition 2.4.5;
Survey Proposition 2.23; only the uniformity of `B` is used). -/
theorem IsTildeLimit.lift_affinoid (h : IsTildeLimit_affinoid P f Q g) {B : Type*} [CommRing B]
    [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B] [CompleteSpace B]
    [T2Space B] (hB : IsBounded (powerBoundedSubring B : Set B)) (S : Pair B)
    (ψ : ∀ j, Pair.Hom (P j) S)
    (hψ : ∀ {i j : J} (a : i ⟶ j), (ψ j).toRingHom.comp (f a).toRingHom = (ψ i).toRingHom) :
    ∃! G : Pair.Hom Q S, ∀ j, G.toRingHom.comp (g j).toRingHom = (ψ j).toRingHom := sorry

/-- P7/tilde-limit-perfectoid-uniqueness (ii), affinoid core of `IsTildeLimit.uniqueIso`: two
perfectoid affinoid tilde-limits of the same system are isomorphic, compatibly with the cones. -/
theorem IsTildeLimit.uniqueIso_affinoid (h : IsTildeLimit_affinoid P f Q g) {R' : Type*}
    [CommRing R'] [UniformSpace R'] [IsUniformAddGroup R'] [IsTopologicalRing R'] [IsTateRing R']
    [CompleteSpace R'] [T2Space R'] [Perfectoid.IsPerfectoidTateRing p R'] {Q' : Pair R'}
    {g' : ∀ j, Pair.Hom (P j) Q'} (h' : IsTildeLimit_affinoid P f Q' g') :
    ∃ (e : Pair.Hom Q Q') (e' : Pair.Hom Q' Q), (e'.comp e).toRingHom = RingHom.id R ∧
      (e.comp e').toRingHom = RingHom.id R' ∧
      ∀ j, e.toRingHom.comp (g j).toRingHom = (g' j).toRingHom := sorry

end Uniqueness

/-! ## PerfectoidSpaces:P7/represented-functor-comparison (comparison) -/

-- PerfectoidSpace.IsTildeLimit.diamondIso: not stated here; needs the presheaves `h_X` on
--   perfectoid spaces, the diamond functor `X ↦ X^◇` and limits of diamonds (supplier:
--   DiamondsAndVStacks:D6/spd-of-a-tate-pair, DiamondsAndVStacks:D6/gluing-and-the-diamond-
--   functor, DiamondsAndVStacks:D5/limits-and-finite-stage-comparisons). Statement (Survey
--   Proposition 2.23, ECD Proposition 15.4, Lemma 15.3): `X ~ lim X_i` gives `h_X ≅ lim h_{X_i}`
--   and `X^◇ ≅ lim X_i^◇`; for affinoid `X_i`, `lim Spd(A_i, A_i⁺) ≅ Spd(Aᵘ, Aᵘ⁺)` for the
--   uniformised completed colimit; conversely `lim X_i^◇ ≅ X^◇` gives the topological clause.

/-! ## PerfectoidSpaces:P7/tilde-limit-cofinal-change (lemma) -/

section CofinalChange

variable {J : Type*} [Category J] [IsFiltered J] {A : J → Type*} [∀ j, CommRing (A j)]
  [∀ j, TopologicalSpace (A j)] [∀ j, IsTopologicalRing (A j)] [∀ j, IsHuberRing (A j)]
  (P : ∀ j, Pair (A j)) (f : ∀ {i j : J}, (i ⟶ j) → Pair.Hom (P i) (P j))
  {R : Type*} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [IsHuberRing R]
  (Q : Pair R) (g : ∀ j, Pair.Hom (P j) Q)

/-- P7/tilde-limit-cofinal-change (affinoid core of `IsTildeLimit.reindex`): affinoid tilde-limits
are invariant under a final change `u : K ⥤ J` of the filtered index category of the coordinate
rings (an initial change of the cofiltered index category of the spaces; Mathlib
`Functor.Final`, `Functor.Initial.limitIso`; Scholze, erratum to *p-adic Hodge theory for
rigid-analytic varieties*, item (1)). -/
theorem IsTildeLimit.reindex_affinoid {K : Type*} [Category K] [IsFiltered K] (u : K ⥤ J)
    [u.Final] :
    IsTildeLimit_affinoid P f Q g ↔
      IsTildeLimit_affinoid (fun k ↦ P (u.obj k)) (fun a ↦ f (u.map a)) Q fun k ↦ g (u.obj k) :=
  sorry

/-- P7/tilde-limit-cofinal-change (a): a tilde-limit depends only on the tail of the system: the
restriction to `j₀/J` (Mathlib `Under j₀`, final in `J`). -/
theorem IsTildeLimit.tail_affinoid (j₀ : J) [IsFiltered (Under j₀)] :
    IsTildeLimit_affinoid P f Q g ↔
      IsTildeLimit_affinoid (fun k : Under j₀ ↦ P ((Under.forget j₀).obj k))
        (fun a ↦ f ((Under.forget j₀).map a)) Q fun k ↦ g ((Under.forget j₀).obj k) := sorry

end CofinalChange

