/-! ## PerfectoidSpaces:P5/filtered-two-colimit-of-categories (construction) -/

namespace CategoryTheory

open _root_.CategoryTheory

universe v₁ u₁ v₂ u₂ v₃ u₃

section TwoColimit

variable {J : Type u₁} [Category.{v₁} J] (F : Pseudofunctor (LocallyDiscrete J) Cat.{v₂, u₂})

/-- P5/filtered-two-colimit-of-categories (data): the cocartesian morphisms `(a, φ)` of Mathlib's
Grothendieck construction `∫ F`, those whose fibre component `φ : F_a x → y` is an isomorphism. -/
def FilteredTwoColimit.cocartesian : MorphismProperty (Pseudofunctor.Grothendieck F) :=
  fun _ _ f ↦ IsIso f.fiber

/-- P5/filtered-two-colimit-of-categories (data): the 2-colimit `2-colim_j F(j)` of a pseudofunctor
`F` from `J` to categories: the localisation of the Grothendieck construction `∫ F` (objects the
pairs `(j, x)`, `x ∈ F(j)`) at its cocartesian morphisms, the pseudo-colimit of `F` (SGA 4
Exposé VI, 6.3). For filtered `J` its hom-sets are the filtered colimits of Berkeley Remark 7.4.7
(`homEquiv`). -/
def FilteredTwoColimit : Type (max u₁ u₂) := (FilteredTwoColimit.cocartesian F).Localization

namespace FilteredTwoColimit

/-- P5/filtered-two-colimit-of-categories (instance): the category structure. -/
instance instCategory : Category (FilteredTwoColimit F) :=
  inferInstanceAs (Category (cocartesian F).Localization)

/-- P5/filtered-two-colimit-of-categories (data): the localisation functor
`∫ F ⥤ 2-colim F`. -/
def toTwoColimit : Pseudofunctor.Grothendieck F ⥤ FilteredTwoColimit F := (cocartesian F).Q

/-- P5/filtered-two-colimit-of-categories (data): the inclusion `F(j) ⥤ ∫ F` of the fibre over
`j`. -/
def fiberι (j : J) : F.obj ⟨j⟩ ⥤ Pseudofunctor.Grothendieck F where
  obj x := ⟨j, x⟩
  map φ := Pseudofunctor.Grothendieck.Hom.mk (𝟙 j) ((F.mapId ⟨j⟩).hom.toNatTrans.app _ ≫ φ)
  map_id := sorry
  map_comp := sorry

/-- P5/filtered-two-colimit-of-categories (constructor): the canonical functor
`ι_j : F(j) ⥤ 2-colim F`. -/
def ι (j : J) : F.obj ⟨j⟩ ⥤ FilteredTwoColimit F := fiberι F j ⋙ toTwoColimit F

/-- P5/filtered-two-colimit-of-categories (structure): for `a : i ⟶ j`, the isomorphism
`F_a ⋙ ι_j ≅ ι_i`, compatible with the coherence isomorphisms of `F`. -/
def ιCompIso {i j : J} (a : i ⟶ j) : (F.map a.toLoc).toFunctor ⋙ ι F j ≅ ι F i := sorry

/-- P5/filtered-two-colimit-of-categories (data): for `x ∈ F(i)`, `y ∈ F(j)`, the diagram
`(k, a : i → k, b : j → k) ↦ Hom_{F(k)}(F_a x, F_b y)` on the category of cospans under `i` and
`j` (Mathlib `StructuredArrow (i, j) (Functor.diag J)`). -/
def homFunctor {i j : J} (x : F.obj ⟨i⟩) (y : F.obj ⟨j⟩) :
    StructuredArrow (i, j) (Functor.diag J) ⥤ Type v₂ where
  obj c := (F.map c.hom.1.toLoc).toFunctor.obj x ⟶ (F.map c.hom.2.toLoc).toFunctor.obj y
  map := sorry
  map_id := sorry
  map_comp := sorry

/-- P5/filtered-two-colimit-of-categories (characterisation): for filtered `J`,
`Hom((i, x), (j, y)) ≃ colim_{(k, a, b)} Hom_{F(k)}(F_a x, F_b y)` (Mathlib's colimit type
`Functor.ColimitType`; Berkeley Remark 7.4.7). -/
def homEquiv [IsFiltered J] {i j : J} (x : F.obj ⟨i⟩) (y : F.obj ⟨j⟩) :
    ((ι F i).obj x ⟶ (ι F j).obj y) ≃ (homFunctor F x y).ColimitType := sorry

/-- P5/filtered-two-colimit-of-categories (structure): a *pseudo-cocone* of `F` with vertex `D`:
functors `G_j : F(j) ⥤ D` and isomorphisms `G_j ∘ F_a ≅ G_i`, coherent with the unit and
composition isomorphisms of `F`. -/
structure PseudoCocone (D : Type u₃) [Category.{v₃} D] where
  /-- The functors `G_j : F(j) ⥤ D`. -/
  G : ∀ j : J, F.obj ⟨j⟩ ⥤ D
  /-- The isomorphisms `G_j ∘ F_a ≅ G_i`. -/
  iso : ∀ {i j : J} (a : i ⟶ j), (F.map a.toLoc).toFunctor ⋙ G j ≅ G i
  /-- Coherence with `F_{id} ≅ id`. -/
  iso_id : ∀ (j : J) (x : F.obj ⟨j⟩),
    (iso (𝟙 j)).hom.app x = (G j).map ((F.mapId ⟨j⟩).hom.toNatTrans.app x)
  /-- Coherence with `F_{ba} ≅ F_b ∘ F_a`. -/
  iso_comp : ∀ {i j k : J} (a : i ⟶ j) (b : j ⟶ k) (x : F.obj ⟨i⟩),
    (iso (a ≫ b)).hom.app x =
      (G k).map ((F.mapComp a.toLoc b.toLoc).hom.toNatTrans.app x) ≫
        (iso b).hom.app ((F.map a.toLoc).toFunctor.obj x) ≫ (iso a).hom.app x

variable {F}

/-- P5/filtered-two-colimit-of-categories (data): the functor `∫ F ⥤ D` of a pseudo-cocone,
`(j, x) ↦ G_j x`, `(a, φ) ↦ G_j(φ) ∘ (G_j F_a ≅ G_i)`. -/
def PseudoCocone.toGrothendieck {D : Type u₃} [Category.{v₃} D] (s : PseudoCocone F D) :
    Pseudofunctor.Grothendieck F ⥤ D where
  obj X := (s.G X.base).obj X.fiber
  map {X Y} f := (s.iso f.base).inv.app X.fiber ≫ (s.G Y.base).map f.fiber
  map_id := sorry
  map_comp := sorry

variable (F)

/-- P5/filtered-two-colimit-of-categories (universal-property): the functor `2-colim F ⥤ D`
induced by a pseudo-cocone (it inverts the cocartesian morphisms). -/
def desc {D : Type u₃} [Category.{v₃} D] (s : PseudoCocone F D) : FilteredTwoColimit F ⥤ D :=
  Localization.Construction.lift (W := cocartesian F) s.toGrothendieck sorry

/-- P5/filtered-two-colimit-of-categories (simp): `ι_j ⋙ desc s ≅ G_j`. -/
def ιCompDescIso {D : Type u₃} [Category.{v₃} D] (s : PseudoCocone F D) (j : J) :
    ι F j ⋙ desc F s ≅ s.G j := sorry

/-- P5/filtered-two-colimit-of-categories (extensionality): a functor `H` with isomorphisms
`ι_j ⋙ H ≅ G_j` compatible with the cocone is isomorphic to `desc s`. -/
def descUniqueIso {D : Type u₃} [Category.{v₃} D] (s : PseudoCocone F D)
    (H : FilteredTwoColimit F ⥤ D) (e : ∀ j, ι F j ⋙ H ≅ s.G j)
    (he : ∀ {i j : J} (a : i ⟶ j) (x : F.obj ⟨i⟩),
      (e i).hom.app x = H.map ((ιCompIso F a).inv.app x) ≫
        (e j).hom.app ((F.map a.toLoc).toFunctor.obj x) ≫ (s.iso a).hom.app x) :
    H ≅ desc F s := sorry

/-- P5/filtered-two-colimit-of-categories (characterisation): for filtered `J`, `desc s` is an
equivalence iff (a) every map `colim_k Hom(F_a x, F_b y) → Hom_D(G_i x, G_j y)` is bijective and
(b) every object of `D` is isomorphic to some `G_i x`. -/
theorem isEquivalence_desc_iff [IsFiltered J] {D : Type u₃} [Category.{v₃} D]
    (s : PseudoCocone F D) :
    (desc F s).IsEquivalence ↔
      (∀ {i j : J} (x : F.obj ⟨i⟩) (y : F.obj ⟨j⟩),
        Function.Bijective fun f : (homFunctor F x y).ColimitType ↦
          (ιCompDescIso F s i).inv.app x ≫ (desc F s).map ((homEquiv F x y).symm f) ≫
            (ιCompDescIso F s j).hom.app y) ∧
      ∀ d : D, ∃ (j : J) (x : F.obj ⟨j⟩), Nonempty ((s.G j).obj x ≅ d) := sorry

/-- P5/filtered-two-colimit-of-categories (data): restriction of `F` along a functor
`u : J' ⥤ J` (Mathlib `Functor.toPseudofunctor` and `Pseudofunctor.comp`). -/
def restrict {J' : Type*} [Category J'] (u : J' ⥤ J) :
    Pseudofunctor (LocallyDiscrete J') Cat.{v₂, u₂} :=
  u.toPseudofunctor.comp F

/-- P5/filtered-two-colimit-of-categories (functoriality): for a final functor `u : J' ⥤ J`
between filtered categories, `2-colim (F ∘ u) ≌ 2-colim F` (restriction to a tail). -/
def equivOfFinal [IsFiltered J] {J' : Type*} [Category J'] [IsFiltered J'] (u : J' ⥤ J)
    [u.Final] : FilteredTwoColimit (restrict F u) ≌ FilteredTwoColimit F := sorry

/-- P5/filtered-two-colimit-of-categories (data): the pseudofunctor `j ↦ C'_j` of full
subcategories `C'_j ⊆ F(j)` stable under the transition functors. -/
def restrictFull (P : ∀ j : J, ObjectProperty (F.obj ⟨j⟩))
    (hP : ∀ {i j : J} (a : i ⟶ j) (x : F.obj ⟨i⟩), P i x → P j ((F.map a.toLoc).toFunctor.obj x)) :
    Pseudofunctor (LocallyDiscrete J) Cat.{v₂, u₂} := sorry

/-- P5/filtered-two-colimit-of-categories (compatibility): `2-colim C'_j` is equivalent to the full
subcategory of `2-colim F` on the objects isomorphic to some `ι_i x` with `x ∈ C'_i`. -/
def fullSubcategory (P : ∀ j : J, ObjectProperty (F.obj ⟨j⟩))
    (hP : ∀ {i j : J} (a : i ⟶ j) (x : F.obj ⟨i⟩), P i x → P j ((F.map a.toLoc).toFunctor.obj x)) :
    FilteredTwoColimit (restrictFull F P hP) ≌
      ObjectProperty.FullSubcategory fun X : FilteredTwoColimit F ↦
        ∃ (i : J) (x : F.obj ⟨i⟩), P i x ∧ Nonempty (X ≅ (ι F i).obj x) := sorry

variable (J) in
/-- P5/filtered-two-colimit-of-categories (data): the constant pseudofunctor at a category `C`
(identity transition functors; Mathlib `Functor.toPseudofunctor'`). -/
def const (C : Type u₂) [Category.{v₂} C] : Pseudofunctor (LocallyDiscrete J) Cat.{v₂, u₂} :=
  ((Functor.const J).obj (Cat.of C)).toPseudofunctor'

/-- P5/filtered-two-colimit-of-categories (example): for filtered (hence connected) `J`, the
2-colimit of the constant pseudofunctor at `C` is `C`. -/
def equivConst [IsFiltered J] (C : Type u₂) [Category.{v₂} C] :
    FilteredTwoColimit (const J C) ≌ C := sorry

end FilteredTwoColimit

end TwoColimit

section TwoColimitTests

open FilteredTwoColimit

-- test filteredTwoColimit_test_const (degenerate) [P5/filtered-two-colimit-of-categories]
example (C : Type u) [Category.{u} C] :
    Nonempty (FilteredTwoColimit (const (Discrete PUnit.{u + 1}) C) ≌ C) := sorry

/- `J = ℕ`, `C_n` the discrete category on a set `E_n` (Mathlib `typeToCat`): the 2-colimit is
the discrete category on `colim_n E_n`. -/
-- test filteredTwoColimit_test_discrete (computation) [P5/filtered-two-colimit-of-categories]
example (E : ℕ ⥤ Type u) :
    Nonempty (FilteredTwoColimit (E ⋙ typeToCat).toPseudofunctor' ≌ Discrete E.ColimitType) :=
  sorry

/- For a filtered diagram of rings `B_j` with colimit `B`, base change induces an equivalence from
the part of `2-colim_j Mod(B_j)` on finitely presented modules onto `Mod^{fp}(B)` (EGA IV 8.5.2),
compatibly with `ι_j` and extension of scalars. -/
-- test filteredTwoColimit_test_finitelyPresentedModules (compatibility)
--   [P5/filtered-two-colimit-of-categories]
example {J : Type u} [SmallCategory J] [IsFiltered J] (B : J ⥤ CommRingCat.{u}) :
    let F := B.toPseudofunctor.comp CommRingCat.moduleCatExtendScalarsPseudofunctor
    let P : ObjectProperty (FilteredTwoColimit F) := fun X ↦
      ∃ (j : J) (M : ModuleCat.{u} (B.obj j)), Module.FinitePresentation (B.obj j) M ∧
        Nonempty (X ≅ (ι F j).obj M)
    ∃ Φ : P.FullSubcategory ⥤ ObjectProperty.FullSubcategory
        fun M : ModuleCat.{u} (colimit B : CommRingCat.{u}) ↦
          Module.FinitePresentation (colimit B : CommRingCat.{u}) M,
      Φ.IsEquivalence ∧ ∀ (j : J) (M : ModuleCat.{u} (B.obj j))
        (hM : Module.FinitePresentation (B.obj j) M),
        Nonempty ((ObjectProperty.ι _).obj (Φ.obj ⟨(ι F j).obj M, j, M, hM, ⟨Iso.refl _⟩⟩) ≅
          (ModuleCat.extendScalars (colimit.ι B j).hom).obj M) := sorry

