/-! # Stage P2a. Tilting of adic spectra, rational localisation and almost acyclicity

The affinoid half of layer P2, for an arbitrary perfectoid Tate pair `(R, R⁺)` (no perfectoid base
field). Names live in `TauCeti.Perfectoid` (ring level), `TauCeti.PerfectoidSpace` (statements
about `Spa`) and `TauCeti.Almost` (almost mathematics).

* **The tilting map.** `PerfectoidSpace.spaTilt p P : spa P.plus → spa (Pair.tilt p P).plus`,
  `x ↦ x♭ = [v_x ∘ ♯]`, and the homeomorphism `PerfectoidSpace.spaTiltHomeomorph` identifying
  rational subsets (ECD Theorem 3.12).
* **Rational localisations, one presentation at a time.** Tau Ceti builds the completed rational
  localisation `R⟨T/s⟩` for each presentation `𝔭 : D.Presentation` of a rational subset (`D` a
  pair of definition), not the presentation-independent `O_X(U)` of the anchor (AdicSpaces Layer
  3.1). The type `Perfectoid.RationalLoc 𝔭` is that ring (the object of Tau Ceti's
  `PairOfDefinition.completionLocObj` at `Localization.Away s`) with its uniform ring structure,
  structure map `RationalLoc.toLoc 𝔭`, plus ring `RationalLoc.plus 𝔭 R⁺` (Tau Ceti's
  `completedPlusSubring`) and Huber pair `RationalLoc.pair 𝔭 P`. Packet items about `O_X(U)`
  are stated for `RationalLoc 𝔭` under the suffix `_affinoid`; items about `O_X` as a presheaf
  or sheaf (restriction maps, Čech complexes of coverings, sheaf cohomology) are comments naming
  AdicSpaces Layer 3 or Layer 4.
* **Almost mathematics** uses stage P0's `Almost.BasicSetup` and stage P1's
  `Perfectoid.almostSetup`, `Perfectoid.almostSetupPlus`; "almost zero" for `R⁺`-modules is
  "killed by every `ϖ^{1/pⁿ}`" (P1 `isAlmostZero_iff_forall_root`).

Sources: ECD = Scholze, *Étale cohomology of diamonds*; Sch12 = Scholze, *Perfectoid spaces*;
Berkeley = Scholze–Weinstein, *Berkeley lectures*; KL = Kedlaya–Liu, *Relative p-adic Hodge
theory* I, II; AWS = Kedlaya, *Sheaves, stacks and shtukas*; HK = Hansen–Kedlaya, *Sheafiness
criteria for Huber rings*; Bhatt = Bhatt, *Lecture notes on perfectoid spaces*. -/

noncomputable section

namespace TauCeti

universe u

open Topology Filter CategoryTheory CategoryTheory.Limits
open Huber ValuationSpectrum

/-! ## PerfectoidSpaces:P2/tilting-map-of-spectra (construction) -/

namespace PerfectoidSpace

open Perfectoid

section TiltingMap

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  (P : Pair R)

/-- P2/tilting-map-of-spectra (data): the tilting map `τ_R : Spa(R, R⁺) → Spa(R♭, R♭⁺)`,
`x ↦ x♭`, the class of the valuation `v_x ∘ ♯` of `R♭` (ECD Theorem 3.12; AWS Lemma 2.6.12;
Sch12 proof of Theorem 6.3). It is not `Spa` of a ring map: `♯` is only multiplicative. -/
def spaTilt (x : spa P.plus) : spa (Perfectoid.Pair.tilt p P).plus :=
  ⟨⟨{ vle := fun f g ↦ x.1.toValuativeRel.vle (tilt.sharp f) (tilt.sharp g)
      vle_total := fun f g ↦ x.1.toValuativeRel.vle_total (tilt.sharp f) (tilt.sharp g)
      vle_trans := fun hxy hyz ↦ x.1.toValuativeRel.vle_trans hxy hyz
      vle_add := sorry
      mul_vle_mul_left := sorry
      vle_mul_cancel := sorry
      not_vle_one_zero := sorry
      vle_mul_comm := sorry }⟩, sorry⟩

/-- P2/tilting-map-of-spectra (characterisation): `|f(x♭)| ≤ |g(x♭)| ↔ |f♯(x)| ≤ |g♯(x)|`
(ECD Theorem 3.12). -/
theorem spaTilt_vle_iff (x : spa P.plus) (f g : tilt p R) :
    (spaTilt p P x).1.toValuativeRel.vle f g ↔
      x.1.toValuativeRel.vle (tilt.sharp f) (tilt.sharp g) := sorry

/-- P2/tilting-map-of-spectra (projection): `supp(x♭) = {f ∈ R♭ : f♯ ∈ supp(x)}`
(Sch12 proof of Theorem 6.3). -/
theorem supp_spaTilt (x : spa P.plus) :
    ((spaTilt p P x).1.supp : Set (tilt p R)) = (tilt.sharp : tilt p R → R) ⁻¹' x.1.supp := sorry

/-- P2/tilting-map-of-spectra (other): `τ_R` is continuous (Sch12 proof of Theorem 6.3; Tau Ceti
`isTopologicalBasis_spaRationalFamily`). -/
theorem continuous_spaTilt : Continuous (spaTilt p P) := sorry

open scoped Classical in
/-- P2/tilting-map-of-spectra (compatibility): if some numerator is a unit of `R♭` (for instance
`(ϖ♭)^N`), then `τ_R⁻¹(U(T/s)) = U(T♯/s♯)` (Sch12 proof of Theorem 6.3). -/
theorem spaTilt_preimage_rationalSubset (T : Finset (tilt p R)) (s : tilt p R)
    (hT : ∃ t ∈ T, IsUnit t) :
    spaTilt p P ⁻¹' (Subtype.val ⁻¹' rationalSubset (Perfectoid.Pair.tilt p P).plus T s) =
      Subtype.val ⁻¹' rationalSubset P.plus (T.image (tilt.sharp : tilt p R → R))
        (tilt.sharp s) := sorry

open scoped Classical in
/-- P2/tilting-map-of-spectra (other): every rational subset of a Tate Huber pair `(A, A⁺)` has a
presentation `U(T ∪ {ϖ^N} / s)` with `T ⊆ A⁺`, `s ∈ A⁺`, for any pseudo-uniformizer `ϖ` (Sch12
Remark 2.8, used in the proof of Theorem 6.3; Tau Ceti `rationalSubset_insert_of_forall_vle`,
`rationalSubset_image_mul_right`). Applied to `A = R♭` it normalises rational subsets of `X♭`. -/
theorem exists_rationalSubset_eq_insert_pseudoUniformizer_pow {A : Type*} [CommRing A]
    [TopologicalSpace A] [IsTopologicalRing A] [IsTateRing A] (Q : Pair A) {ϖ : A}
    (hϖ : IsPseudoUniformizer ϖ) {U : Set (spa Q.plus)} (hU : U ∈ spaRationalFamily Q.plus) :
    ∃ (N : ℕ) (T : Finset A) (s : A), (∀ t ∈ T, t ∈ Q.plus) ∧ s ∈ Q.plus ∧
      U = Subtype.val ⁻¹' rationalSubset Q.plus (insert (ϖ ^ N) T) s := sorry

/-- P2/tilting-map-of-spectra (functoriality): for a morphism `φ` of perfectoid Tate pairs with
tilt `φ♭` (P1 `Pair.tiltHom`), `τ_R ∘ Spa(φ) = Spa(φ♭) ∘ τ_S` (ECD Theorem 3.12). -/
theorem spaTilt_comp_spaComap {S : Type u} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
    [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S]
    {Q : Pair S} (φ : Pair.Hom P Q) :
    spaTilt p P ∘ φ.spaComap = (Perfectoid.Pair.tiltHom p φ).spaComap ∘ spaTilt p Q := sorry

/-- P2/tilting-map-of-spectra (simp): if `pR = 0`, then `x♭` is `x` transported along
`R♭ ≃+* R` (P1 `tilt.equivOfCharP`), i.e. `τ_R = id` (ECD Proposition 3.5). -/
@[simp] theorem spaTilt_eq_id_of_charP [CharP R p] (x : spa P.plus) :
    (spaTilt p P x).1 =
      ValuationSpectrum.comap (tilt.equivOfCharP : tilt p R ≃+* R).toRingHom x.1 := sorry

end TiltingMap

section TiltingMapTests

variable (p : ℕ) [Fact p.Prime]

-- The perfectoid disc `ℚ_p^cycl⟨T^{1/p^∞}⟩` (P1 `perfectedTateAlgebra`, one variable).
local notation "𝔻" => perfectedTateAlgebra p (padicCyclotomic p) Unit

-- Its Huber pair with plus ring `ℚ_p^cycl°⟨T^{1/p^∞}⟩` (P1 `perfectedTateAlgebra.plus`).
local notation "𝔻₊" =>
  (perfectedTateAlgebra.plus p (σ := Unit) (Pair.powerBounded (padicCyclotomic p)))

/- On the perfectoid disc, `T♭ ∈ R♭ = ℚ_p^cycl♭⟨T^{1/p^∞}⟩` (P1 `perfectedTateAlgebra.tiltEquiv`)
has `T♭♯ = T`, and a point with `|T(x)| = |ϖ(x)|` tilts to a point with `|T(x♭)| = |ϖ♭(x♭)|`. -/
-- test spaTilt_test_perfectoidDisc_point (computation) [P2/tilting-map-of-spectra]
example (ϖ : PseudoUniformizerRoots p (padicCyclotomic p))
    (hc : Continuous (algebraMap (padicCyclotomic p) 𝔻)) (x : spa 𝔻₊.plus)
    (hx : x.1.toValuativeRel.vle (perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0))
        (algebraMap (padicCyclotomic p) 𝔻 (ϖ.root 0)) ∧
      x.1.toValuativeRel.vle (algebraMap (padicCyclotomic p) 𝔻 (ϖ.root 0))
        (perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0))) :
    tilt.sharp ((perfectedTateAlgebra.tiltEquiv p (padicCyclotomic p) Unit).symm
        (perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0))) =
      perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0) ∧
    (spaTilt p 𝔻₊ x).1.toValuativeRel.vle
        ((perfectedTateAlgebra.tiltEquiv p (padicCyclotomic p) Unit).symm
          (perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0)))
        (tilt.map p (algebraMap (padicCyclotomic p) 𝔻) hc ϖ.toTilt) ∧
    (spaTilt p 𝔻₊ x).1.toValuativeRel.vle
        (tilt.map p (algebraMap (padicCyclotomic p) 𝔻) hc ϖ.toTilt)
        ((perfectedTateAlgebra.tiltEquiv p (padicCyclotomic p) Unit).symm
          (perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0))) := sorry

/- In characteristic `p` (the disc over `ℚ_p^cycl♭ = 𝔽_p((t^{1/p^∞}))^∧`) the tilting map is the
identity under `R♭ ≃+* R`. -/
-- test spaTilt_test_charP_eq_id (degenerate) [P2/tilting-map-of-spectra]
example [CharP (perfectedTateAlgebra p (tilt p (padicCyclotomic p)) Unit) p]
    (x : spa (perfectedTateAlgebra.plus p (σ := Unit)
      (Pair.powerBounded (tilt p (padicCyclotomic p)))).plus) :
    (spaTilt p _ x).1 = ValuationSpectrum.comap
      (tilt.equivOfCharP : tilt p (perfectedTateAlgebra p (tilt p (padicCyclotomic p)) Unit) ≃+*
        perfectedTateAlgebra p (tilt p (padicCyclotomic p)) Unit).toRingHom x.1 := sorry

open scoped Classical in
/- On the perfectoid disc, `τ⁻¹ U({T♭, ϖ♭}/ϖ♭) = U({T, ϖ}/ϖ)`. -/
-- test spaTilt_test_preimage_disc (compatibility) [P2/tilting-map-of-spectra]
example (ϖ : PseudoUniformizerRoots p (padicCyclotomic p))
    (hc : Continuous (algebraMap (padicCyclotomic p) 𝔻)) :
    spaTilt p 𝔻₊ ⁻¹' (Subtype.val ⁻¹' rationalSubset (Perfectoid.Pair.tilt p 𝔻₊).plus
      {(perfectedTateAlgebra.tiltEquiv p (padicCyclotomic p) Unit).symm
          (perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0)),
        tilt.map p (algebraMap (padicCyclotomic p) 𝔻) hc ϖ.toTilt}
      (tilt.map p (algebraMap (padicCyclotomic p) 𝔻) hc ϖ.toTilt)) =
    Subtype.val ⁻¹' rationalSubset 𝔻₊.plus
      {perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0),
        algebraMap (padicCyclotomic p) 𝔻 (ϖ.root 0)}
      (algebraMap (padicCyclotomic p) 𝔻 (ϖ.root 0)) := sorry

/- There is no ring homomorphism `ℚ_p^cycl♭ → ℚ_p^cycl` (characteristics `p` and `0`), so `τ` is
not `Pair.Hom.spaComap` of a morphism of Huber pairs. -/
-- test spaTilt_test_no_ringHom (non-example) [P2/tilting-map-of-spectra]
example : IsEmpty (tilt p (padicCyclotomic p) →+* padicCyclotomic p) := sorry

/- `x♭` is the unique point `y` of `Spa(R♭, R♭⁺)` with `y.vle f g ↔ x.vle f♯ g♯`. -/
-- test spaTilt_test_vle_characterisation (characterisation) [P2/tilting-map-of-spectra]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R)
    (x : spa P.plus) (y : spa (Perfectoid.Pair.tilt p P).plus)
    (hy : ∀ f g : tilt p R, y.1.toValuativeRel.vle f g ↔
      x.1.toValuativeRel.vle (tilt.sharp f) (tilt.sharp g)) :
    y = spaTilt p P x := sorry

end TiltingMapTests

end PerfectoidSpace

/-! ## PerfectoidSpaces:P2/rational-localization-in-characteristic-p (lemma) -/

namespace Perfectoid

section RationalLocCarrier

variable {R : Type u} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
  {D : PairOfDefinition R}

/-- P2/rational-localization-in-characteristic-p (supporting data, shared by every node of this
stage that speaks of `O_X(U)`): the completed rational localisation `R⟨T/s⟩` of one presentation
`𝔭 = (T, s)` (Tau Ceti `PairOfDefinition.Presentation`, with `Rₛ = Localization.Away s`): the
separated completion of `Rₛ` for Tau Ceti's `locUniformSpace`, i.e. the object of
`PairOfDefinition.completionLocObj` (Wedhorn Proposition and Definition 5.51). For `T` generating
the unit ideal it is the anchor's `O_X(U(T/s))` (AdicSpaces Layer 3.1), up to the
presentation-independence isomorphisms that Tau Ceti does not yet construct. -/
def RationalLoc (𝔭 : D.Presentation) : Type u :=
  @UniformSpace.Completion (Localization.Away 𝔭.den)
    (D.locUniformSpace 𝔭.num 𝔭.den (Localization.Away 𝔭.den) 𝔭.hasDenominatorPower)

namespace RationalLoc

variable (𝔭 : D.Presentation)

/-- P2/rational-localization-in-characteristic-p (supporting instance): the uniformity of
`R⟨T/s⟩`. -/
instance instUniformSpace : UniformSpace (RationalLoc 𝔭) :=
  @UniformSpace.Completion.uniformSpace (Localization.Away 𝔭.den)
    (D.locUniformSpace 𝔭.num 𝔭.den (Localization.Away 𝔭.den) 𝔭.hasDenominatorPower)

/-- P2/rational-localization-in-characteristic-p (supporting instance): the ring structure of
`R⟨T/s⟩`. -/
instance instCommRing : CommRing (RationalLoc 𝔭) :=
  @UniformSpace.Completion.commRing (Localization.Away 𝔭.den) _
    (D.locUniformSpace 𝔭.num 𝔭.den (Localization.Away 𝔭.den) 𝔭.hasDenominatorPower)
    (D.isUniformAddGroup_locUniformSpace 𝔭.num 𝔭.den (Localization.Away 𝔭.den)
      𝔭.hasDenominatorPower)
    (D.isTopologicalRing_locUniformSpace 𝔭.num 𝔭.den (Localization.Away 𝔭.den)
      𝔭.hasDenominatorPower)

/-- P2/rational-localization-in-characteristic-p (supporting instance). -/
instance instIsUniformAddGroup : IsUniformAddGroup (RationalLoc 𝔭) := sorry

/-- P2/rational-localization-in-characteristic-p (supporting instance). -/
instance instIsTopologicalRing : IsTopologicalRing (RationalLoc 𝔭) := sorry

/-- P2/rational-localization-in-characteristic-p (supporting instance): `R⟨T/s⟩` is complete. -/
instance instCompleteSpace : CompleteSpace (RationalLoc 𝔭) :=
  @UniformSpace.Completion.completeSpace (Localization.Away 𝔭.den)
    (D.locUniformSpace 𝔭.num 𝔭.den (Localization.Away 𝔭.den) 𝔭.hasDenominatorPower)

/-- P2/rational-localization-in-characteristic-p (supporting instance): `R⟨T/s⟩` is Hausdorff. -/
instance instT2Space : T2Space (RationalLoc 𝔭) := sorry

/-- P2/rational-localization-in-characteristic-p (supporting instance): over a Tate ring,
`R⟨T/s⟩` is a Tate ring (the image of a pseudo-uniformizer of `R` is one; Tau Ceti
`isHuberRing_completion_locTopology`). -/
instance instIsTateRing [IsTateRing R] : IsTateRing (RationalLoc 𝔭) := sorry

/-- P2/rational-localization-in-characteristic-p (supporting data): the structure map
`R → R⟨T/s⟩` (Tau Ceti `PairOfDefinition.toCompletionLoc`). -/
def toLoc : R →+* RationalLoc 𝔭 :=
  D.toCompletionLoc 𝔭.num 𝔭.den (Localization.Away 𝔭.den) 𝔭.hasDenominatorPower

/-- P2/rational-localization-in-characteristic-p (supporting): the structure map is continuous
(Tau Ceti `continuous_toCompletionLoc`). -/
theorem continuous_toLoc : Continuous (toLoc 𝔭) := sorry

/-- P2/rational-localization-in-characteristic-p (supporting data): the plus ring `R⟨T/s⟩⁺`, the
integral closure of the image of `R⁺[T/s]` (Tau Ceti `PairOfDefinition.completedPlusSubring`). -/
def plus (Aplus : Subring R) : Subring (RationalLoc 𝔭) :=
  D.completedPlusSubring Aplus 𝔭.num 𝔭.den (Localization.Away 𝔭.den) 𝔭.hasDenominatorPower

/-- P2/rational-localization-in-characteristic-p (supporting data): the Huber pair
`(R⟨T/s⟩, R⟨T/s⟩⁺)` of a presentation over a Tate Huber pair `(R, R⁺)`. -/
def pair [IsTateRing R] (P : Pair R) : Pair (RationalLoc 𝔭) where
  plus := plus 𝔭 P.plus
  isRingOfIntegralElements := sorry

/-- P2/rational-localization-in-characteristic-p (supporting data): the structure morphism of Huber
pairs `(R, R⁺) → (R⟨T/s⟩, R⟨T/s⟩⁺)`. -/
def structureMap [IsTateRing R] (P : Pair R) : Pair.Hom P (pair 𝔭 P) where
  toRingHom := toLoc 𝔭
  continuous_toRingHom := continuous_toLoc 𝔭
  map_mem_plus := sorry

/-- P2/rational-localization-in-characteristic-p (supporting data): the structure map on plus
rings `R⁺ → R⟨T/s⟩⁺`. -/
def toPlus [IsTateRing R] (P : Pair R) : P.plus →+* (pair 𝔭 P).plus :=
  (toLoc 𝔭).restrict _ _ (structureMap 𝔭 P).map_mem_plus

/-- P2/rational-localization-in-characteristic-p (supporting data): the integral model
`A = R⁺[(f/g)^{1/p^∞} : f ∈ T]^∧` inside `R⟨T'/s⟩`: the closure of the subring generated by the
image of `R⁺` and the fractions `root m f · (root m g)⁻¹` (`f ∈ T`, `m ∈ ℕ`), for a compatible
system `root m` of `p^m`-th roots. For `R` perfect, `root m = φ⁻ᵐ`; for the untilt of a
presentation `(T, g)` of `R♭`, `root m f = (f^{1/p^m})♯ = f⁽ᵐ⁾` (Sch12 Lemma 6.4; Bhatt Lemmas
9.2.3, 9.2.5). With `root m = id` it is the naive model `R⁺⟨T/g⟩`. -/
def rootModel (Aplus : Subring R) {X : Type*} (T : Finset X) (g : X) (root : ℕ → X → R) :
    Subring (RationalLoc 𝔭) :=
  (Subring.closure ((toLoc 𝔭 '' (Aplus : Set R)) ∪
    ⋃ m : ℕ, ⋃ f ∈ T, {toLoc 𝔭 (root m f) * Ring.inverse (toLoc 𝔭 (root m g))})).topologicalClosure

end RationalLoc

variable (R) in
/-- P2/rational-localization-in-characteristic-p (supporting definition): the per-presentation core
of the anchor's stable uniformity (HK Definition 3.13; AdicSpaces Layer 4.2): every completed
rational localisation `R⟨T/s⟩` with `T` generating the unit ideal is uniform (`R⟨T/s⟩°`
bounded). It does not involve `R⁺`. -/
def IsStablyUniformPres [IsTateRing R] : Prop :=
  ∀ (D : PairOfDefinition R) (𝔭 : D.Presentation), Ideal.span (𝔭.num : Set R) = ⊤ →
    IsBounded (powerBoundedSubring (RationalLoc 𝔭) : Set (RationalLoc 𝔭))

end RationalLocCarrier

section CharPLocalization

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  (P : Pair R) {D : PairOfDefinition R} (𝔭 : D.Presentation)

/-- P2/rational-localization-in-characteristic-p (i): if `pR = 0`, every rational localisation
`R⟨T/s⟩` (`T` generating the unit ideal) is a perfectoid Tate ring of characteristic `p`, and
Frobenius is bijective on `R⟨T/s⟩` and on its plus ring (KL I Proposition 3.1.7; AWS proof of
Theorem 2.5.3; Sch12 proof of Lemma 6.4(i) in characteristic `p`; ECD Proposition 3.5). -/
theorem isPerfectoidTateRing_rationalLoc_of_charP [CharP R p]
    (hT : Ideal.span (𝔭.num : Set R) = ⊤) :
    IsPerfectoidTateRing p (RationalLoc 𝔭) ∧ PerfectRing (RationalLoc 𝔭) p ∧
      PerfectRing (RationalLoc.pair 𝔭 P).plus p := sorry

/-- P2/rational-localization-in-characteristic-p (ii): for `pR = 0`, `f_i, g ∈ R⁺` with
`ϖ^N ∈ T`, the model `A_U = R⁺[(f_i/g)^{1/p^∞}]^∧` (`root m = φ⁻ᵐ`) is perfect, lies between
`R⁺` and `O_X⁺(U) ⊆ O_X(U)°`, and `O_X(U)°/A_U` is killed by every `ϖ^{1/pⁿ}` (almost zero)
(Bhatt Lemma 9.2.3; Sch12 proof of Lemma 6.4(i)). Clause (iii), the presentation of `A_U` by
`R⁺[T^{1/p^∞}]` with almost zero excess kernel, is the input of the proof and is not stated
separately. -/
theorem rootModel_spec_of_charP [CharP R p] (ϖ : PseudoUniformizerRoots p R)
    (hnum : ∀ t ∈ 𝔭.num, t ∈ P.plus) (hs : 𝔭.den ∈ P.plus) (N : ℕ) (hN : ϖ.root 0 ^ N ∈ 𝔭.num) :
    (∀ x ∈ RationalLoc.rootModel 𝔭 P.plus 𝔭.num 𝔭.den
        (fun m f ↦ ((frobeniusEquiv R p).symm)^[m] f),
      ∃ y ∈ RationalLoc.rootModel 𝔭 P.plus 𝔭.num 𝔭.den
        (fun m f ↦ ((frobeniusEquiv R p).symm)^[m] f), y ^ p = x) ∧
    RationalLoc.rootModel 𝔭 P.plus 𝔭.num 𝔭.den (fun m f ↦ ((frobeniusEquiv R p).symm)^[m] f) ≤
      (RationalLoc.pair 𝔭 P).plus ∧
    (RationalLoc.pair 𝔭 P).plus ≤ powerBoundedSubring (RationalLoc 𝔭) ∧
    ∀ n, ∀ x ∈ powerBoundedSubring (RationalLoc 𝔭),
      RationalLoc.toLoc 𝔭 (ϖ.root n) * x ∈ RationalLoc.rootModel 𝔭 P.plus 𝔭.num 𝔭.den
        (fun m f ↦ ((frobeniusEquiv R p).symm)^[m] f) := sorry

variable (R) in
/-- P2/rational-localization-in-characteristic-p (iv): a perfectoid Tate ring of characteristic `p`
is stably uniform (KL I Proposition 3.1.7), in the per-presentation form
`IsStablyUniformPres`. -/
theorem isStablyUniformPres_of_charP [CharP R p] : IsStablyUniformPres R := sorry

end CharPLocalization

end Perfectoid

/-! ## PerfectoidSpaces:P2/almost-exactness-from-reduction-mod-pseudouniformizer (lemma) -/

namespace Almost

section ModPseudoUniformizer

variable {V : Type u} [CommRing V] (S : BasicSetup V)

/-- P2/almost-exactness-from-reduction-mod-pseudouniformizer (a): a bounded complex of `ϖ`-torsion
free, `ϖ`-adically complete and separated `V`-modules whose reduction `C/ϖC` has almost zero
cohomology has almost zero cohomology (Sch12 proof of Proposition 6.14; P0's
`isAlmostZero_homology_of_complete` is the `ℕ`-indexed form). -/
theorem isAlmostZero_homology_of_mod (ϖ : V) (C : CochainComplex (ModuleCat.{u} V) ℤ)
    (hbdd : ∃ a b : ℤ, ∀ i, (i < a ∨ b < i) → IsZero (C.X i))
    (htf : ∀ i, IsSMulRegular (C.X i) ϖ) (hc : ∀ i, IsAdicComplete (Ideal.span {ϖ}) (C.X i))
    (hmod : ∀ i, (S.baseChange (V ⧸ Ideal.span {ϖ})).IsAlmostZero
      ((((ModuleCat.extendScalars (Ideal.Quotient.mk (Ideal.span {ϖ}))).mapHomologicalComplex
        _).obj C).homology i)) :
    ∀ i, S.IsAlmostZero (C.homology i) := sorry

/-- P2/almost-exactness-from-reduction-mod-pseudouniformizer (b): conversely, for `ϖ`-torsion free
terms, almost zero cohomology of `C` gives almost zero cohomology of `C/ϖC` (the long exact
sequence of `0 → C → C → C/ϖC → 0`; ECD after Example 3.22). -/
theorem isAlmostZero_homology_mod (ϖ : V) (C : CochainComplex (ModuleCat.{u} V) ℤ)
    (htf : ∀ i, IsSMulRegular (C.X i) ϖ) (h : ∀ i, S.IsAlmostZero (C.homology i)) :
    ∀ i, (S.baseChange (V ⧸ Ideal.span {ϖ})).IsAlmostZero
      ((((ModuleCat.extendScalars (Ideal.Quotient.mk (Ideal.span {ϖ}))).mapHomologicalComplex
        _).obj C).homology i) := sorry

/-- P2/almost-exactness-from-reduction-mod-pseudouniformizer (c): if `M` is `ϖ`-adically
separated, `N` is `ϖ`-torsion free, `coker α` is almost zero and `α ⊗ V/ϖ` is an almost
isomorphism, then `α` is an almost isomorphism (Bhatt footnote 1 in the proof of Lemma 9.2.5). -/
theorem isAlmostIso_of_mod (ϖ : V) {M N : Type u} [AddCommGroup M] [_root_.Module V M]
    [AddCommGroup N] [_root_.Module V N] (α : M →ₗ[V] N) (hM : IsHausdorff (Ideal.span {ϖ}) M)
    (hN : IsSMulRegular N ϖ) (hcoker : S.IsAlmostZero (N ⧸ LinearMap.range α))
    (hmod : (S.baseChange (V ⧸ Ideal.span {ϖ})).IsAlmostIso
      (α.baseChange (V ⧸ Ideal.span {ϖ}))) :
    S.IsAlmostIso α := sorry

end ModPseudoUniformizer

end Almost

/-! ## PerfectoidSpaces:P2/almost-integral-model-of-untilted-rational-localization (lemma) -/

namespace Perfectoid

section UntiltedModel

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  (P : Pair R) (ϖ : PseudoUniformizerRoots p R) {D : PairOfDefinition R}
  {E : PairOfDefinition (tilt p R)}

open scoped Classical in
/-- P2/almost-integral-model-of-untilted-rational-localization (supporting definition): `𝔭` is the
untilt `U(T♯/g♯)` of a normalised presentation `𝔮 = U(T/g)` of a rational subset of `X♭`:
`T ⊆ R♭⁺`, `g ∈ R♭⁺`, `(ϖ♭)^N ∈ T` (Sch12 Lemma 6.4, statement). -/
structure IsSharpPresentation (𝔮 : E.Presentation) (𝔭 : D.Presentation) : Prop where
  /-- The numerators of `𝔭` are the sharps of those of `𝔮`. -/
  num_eq : 𝔭.num = 𝔮.num.image (tilt.sharp : tilt p R → R)
  /-- The denominator of `𝔭` is the sharp of that of `𝔮`. -/
  den_eq : 𝔭.den = tilt.sharp 𝔮.den
  /-- The numerators of `𝔮` lie in `R♭⁺`. -/
  num_mem : ∀ t ∈ 𝔮.num, t ∈ (Pair.tilt p P).plus
  /-- The denominator of `𝔮` lies in `R♭⁺`. -/
  den_mem : 𝔮.den ∈ (Pair.tilt p P).plus
  /-- Some `(ϖ♭)^N` is a numerator of `𝔮`. -/
  exists_pow_mem : ∃ N : ℕ, ϖ.toTilt ^ N ∈ 𝔮.num

variable (𝔮 : E.Presentation) (𝔭 : D.Presentation)

/-- P2/almost-integral-model-of-untilted-rational-localization (ii): for the untilt `U♯ = U(T♯/g♯)`
of a normalised presentation `U(T/g)` of `X♭`, `O_X(U♯)` is a perfectoid Tate ring
(Sch12 Lemma 6.4(ii) over a perfectoid Tate base; ECD proof of Theorems 3.12–3.13). -/
theorem isPerfectoidTateRing_rationalLoc_sharp (h : IsSharpPresentation p P ϖ 𝔮 𝔭) :
    IsPerfectoidTateRing p (RationalLoc 𝔭) := sorry

/-- P2/almost-integral-model-of-untilted-rational-localization (i)–(ii): the model
`A = R⁺[(f_i^{1/p^m})♯/(g^{1/p^m})♯]^∧` (`root m f = f⁽ᵐ⁾`) satisfies `A ⊆ O_X⁺(U♯) ⊆ O_X(U♯)°`,
`O_X(U♯)°/A` is killed by every `ϖ^{1/pⁿ}` (almost zero), and Frobenius `A/ϖ^{1/p} → A/ϖ` is
almost surjective: `ϖ^{1/p^n} x ≡ y^p mod ϖ` (Sch12 Lemma 6.4(i); Bhatt Lemma 9.2.5; AWS Lemma
2.8.8). Clause (iii), the presentation of `A/ϖ`, is the input of the proof. -/
theorem rootModel_sharp_spec (h : IsSharpPresentation p P ϖ 𝔮 𝔭) :
    RationalLoc.rootModel 𝔭 P.plus 𝔮.num 𝔮.den (fun m f ↦ tilt.coeff m f) ≤
      (RationalLoc.pair 𝔭 P).plus ∧
    (RationalLoc.pair 𝔭 P).plus ≤ powerBoundedSubring (RationalLoc 𝔭) ∧
    (∀ n, ∀ x ∈ powerBoundedSubring (RationalLoc 𝔭),
      RationalLoc.toLoc 𝔭 (ϖ.root n) * x ∈
        RationalLoc.rootModel 𝔭 P.plus 𝔮.num 𝔮.den (fun m f ↦ tilt.coeff m f)) ∧
    ∀ n, ∀ x ∈ RationalLoc.rootModel 𝔭 P.plus 𝔮.num 𝔮.den (fun m f ↦ tilt.coeff m f),
      ∃ y ∈ RationalLoc.rootModel 𝔭 P.plus 𝔮.num 𝔮.den (fun m f ↦ tilt.coeff m f),
        ∃ z ∈ RationalLoc.rootModel 𝔭 P.plus 𝔮.num 𝔮.den (fun m f ↦ tilt.coeff m f),
          RationalLoc.toLoc 𝔭 (ϖ.root n) * x = y ^ p + RationalLoc.toLoc 𝔭 (ϖ.root 0) * z :=
  sorry

/-- P2/almost-integral-model-of-untilted-rational-localization (iv): `(O_X(U♯), O_X⁺(U♯))` is the
untilt of `(O_{X♭}(U), O_{X♭}⁺(U))`: there is a unique continuous ring isomorphism
`O_X(U♯)♭ ≃+* O_{X♭}(U)` compatible with the structure maps from `R♭`, and it carries
`O_X⁺(U♯)♭` onto `O_{X♭}⁺(U)` (Sch12 proof of Lemma 6.4(iii); ECD Theorem 3.13). -/
theorem existsUnique_tiltEquiv_sharp [IsPerfectoidTateRing p (RationalLoc 𝔭)]
    (h : IsSharpPresentation p P ϖ 𝔮 𝔭) :
    ∃! e : tilt p (RationalLoc 𝔭) ≃+* RationalLoc 𝔮, Continuous e ∧
      (∀ a : tilt p R, e (tilt.map p (RationalLoc.toLoc 𝔭) (RationalLoc.continuous_toLoc 𝔭) a) =
        RationalLoc.toLoc 𝔮 a) ∧
      (Pair.tilt p (RationalLoc.pair 𝔭 P)).plus.map e.toRingHom =
        (RationalLoc.pair 𝔮 (Pair.tilt p P)).plus := sorry

end UntiltedModel

end Perfectoid

/-! ## PerfectoidSpaces:P2/approximation-on-perfectoid-polydisc (lemma) -/

namespace Perfectoid

section Polydisc

variable (p : ℕ) [Fact p.Prime] {R₀ : Type u} [CommRing R₀] [UniformSpace R₀]
  [IsUniformAddGroup R₀] [IsTopologicalRing R₀] [IsTateRing R₀] [CompleteSpace R₀] [T2Space R₀]
  [IsPerfectoidTateRing p R₀]

/-- P2/approximation-on-perfectoid-polydisc (supporting data): the total degree
`Σ_s a_s ∈ ℤ[1/p]_{≥0}` of an exponent of `R₀⟨T_s^{1/p^∞}⟩`. -/
def perfectedTateAlgebra.totalDegree {σ : Type*} (a : σ →₀ PDyadicExp p) : NNRat :=
  a.sum fun _ e ↦ (e : NNRat)

variable (R₀) in
/-- P2/approximation-on-perfectoid-polydisc (supporting definition): `f ∈ R₀⟨T^{1/p^∞}⟩` is
*homogeneous of degree `d`* if it is a convergent sum of monomials of total degree `d`: it lies in
the closure of the `R₀`-span of the `T^a` with `Σ a_s = d` (Sch12 Lemma 6.5, grading of
`R₀°⟨T^{1/p^∞}⟩` by total degree). -/
def perfectedTateAlgebra.IsHomogeneous {σ : Type*} (f : perfectedTateAlgebra p R₀ σ)
    (d : NNRat) : Prop :=
  f ∈ closure ((Submodule.span R₀
    ((fun a ↦ completedMonoidAlgebra.monomial p (R := R₀) (σ →₀ PDyadicExp p) a) ''
      {a | perfectedTateAlgebra.totalDegree p a = d}) : Set (perfectedTateAlgebra p R₀ σ)))

/-- P2/approximation-on-perfectoid-polydisc: on `P = R₀⟨T₀^{1/p^∞}, …, T_n^{1/p^∞}⟩` with tilt
`R₀♭⟨T^{1/p^∞}⟩` (P1 `perfectedTateAlgebra.tiltEquiv`, `T_i♯ = T_i`), every homogeneous
`f ∈ P°` of degree `d` is approximated by a sharp: for `c = m/pᵉ ≥ 0` and `ε = k/pᵉ ∈ (0, 1)`
there is a homogeneous `g ∈ P♭°` of degree `d` with
`|f(x) − g♯(x)| ≤ |ϖ^{1−ε}(x)| · max(|f(x)|, |ϖ^c(x)|)` on `Spa(P, P°)` (Sch12 Lemma 6.5; Bhatt
Lemma 9.2.6; KL II Example 3.3.12). The inequality with a maximum is written as a disjunction. -/
theorem exists_homogeneous_approx_polydisc (ϖ : PseudoUniformizerRoots p R₀) (n : ℕ)
    (f : perfectedTateAlgebra p R₀ (Fin (n + 1))) (d : NNRat)
    (hf : perfectedTateAlgebra.IsHomogeneous p R₀ f d)
    (hf' : f ∈ powerBoundedSubring (perfectedTateAlgebra p R₀ (Fin (n + 1))))
    (m e k : ℕ) (hk : 0 < k) (hke : k < p ^ e) :
    ∃ g : tilt p (perfectedTateAlgebra p R₀ (Fin (n + 1))),
      perfectedTateAlgebra.IsHomogeneous p (tilt p R₀)
        (perfectedTateAlgebra.tiltEquiv p R₀ (Fin (n + 1)) g) d ∧
      g ∈ powerBoundedSubring (tilt p (perfectedTateAlgebra p R₀ (Fin (n + 1)))) ∧
      ∀ x : spa (powerBoundedSubring (perfectedTateAlgebra p R₀ (Fin (n + 1)))),
        x.1.toValuativeRel.vle (f - tilt.sharp g)
            (algebraMap R₀ _ (ϖ.zpow ((p ^ e - k : ℕ) : ℤ) e : R₀) * f) ∨
          x.1.toValuativeRel.vle (f - tilt.sharp g)
            (algebraMap R₀ _ (ϖ.zpow ((p ^ e - k : ℕ) : ℤ) e : R₀) *
              algebraMap R₀ _ (ϖ.zpow (m : ℤ) e : R₀)) := sorry

end Polydisc

end Perfectoid

/-! ## PerfectoidSpaces:P2/approximation-lemma (lemma) -/

namespace Perfectoid

section Approximation

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  (P : Pair R) (ϖ : PseudoUniformizerRoots p R)

/-- P2/approximation-lemma (i): every `f ∈ R` is approximated by a sharp: for `c = m/pᵉ ≥ 0` and
`ε = k/pᵉ ∈ (0, 1)` there is `g ∈ R♭` with `|f(x) − g♯(x)| ≤ |ϖ^{1−ε}(x)| · max(|f(x)|,
|ϖ^c(x)|)` for all `x ∈ Spa(R, R⁺)`; in particular `max(|f|, |ϖ^c|) = max(|g♯|, |ϖ^c|)` (Sch12
Corollary 6.7(i); KL II Lemma 3.2.7; AWS Lemma 2.6.17; Bhatt Proposition 9.2.7). -/
theorem exists_sharp_approx (f : R) (m e k : ℕ) (hk : 0 < k) (hke : k < p ^ e) :
    ∃ g : tilt p R, ∀ x : spa P.plus,
      x.1.toValuativeRel.vle (f - tilt.sharp g) ((ϖ.zpow ((p ^ e - k : ℕ) : ℤ) e : R) * f) ∨
        x.1.toValuativeRel.vle (f - tilt.sharp g)
          ((ϖ.zpow ((p ^ e - k : ℕ) : ℤ) e : R) * (ϖ.zpow (m : ℤ) e : R)) := sorry

open scoped Classical in
/-- P2/approximation-lemma (ii): for `f, h ∈ R` and `c ∈ ℕ` there are `a, b ∈ R♭` with
`U({f, ϖ^c}/h) = U({a♯, ϖ^c}/b♯)` (Sch12 Corollary 6.7(i); Bhatt Proposition 9.2.7(2)). -/
theorem exists_sharp_rationalSubset_eq (f h : R) (c : ℕ) :
    ∃ a b : tilt p R,
      (Subtype.val ⁻¹' rationalSubset P.plus {f, ϖ.root 0 ^ c} h : Set (spa P.plus)) =
        Subtype.val ⁻¹' rationalSubset P.plus {tilt.sharp a, ϖ.root 0 ^ c} (tilt.sharp b) :=
  sorry

end Approximation

end Perfectoid

/-! ## PerfectoidSpaces:P2/tilting-homeomorphism-and-rational-subsets (theorem) -/

namespace PerfectoidSpace

open Perfectoid

section Homeomorph

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  (P : Pair R)

/-- P2/tilting-homeomorphism-and-rational-subsets (data): the tilting map is a homeomorphism
`Spa(R, R⁺) ≃ₜ Spa(R♭, R♭⁺)` (ECD Theorem 3.12; Sch12 Corollary 6.7(iii); KL II Theorem 3.3.16;
AWS Theorem 2.5.1). Its naturality is `spaTilt_comp_spaComap`. -/
def spaTiltHomeomorph : spa P.plus ≃ₜ spa (Perfectoid.Pair.tilt p P).plus := sorry

/-- P2/tilting-homeomorphism-and-rational-subsets: the forward map is `spaTilt`. -/
@[simp] theorem coe_spaTiltHomeomorph : ⇑(spaTiltHomeomorph p P) = spaTilt p P := sorry

/-- P2/tilting-homeomorphism-and-rational-subsets: `U ⊆ X` is rational iff `τ_R(U) ⊆ X♭` is
rational (ECD Theorem 3.12). The explicit image formula is
`Perfectoid.rationalLocalization.image_spaTilt`. -/
theorem isRational_image_spaTilt_iff (U : Set (spa P.plus)) :
    U ∈ spaRationalFamily P.plus ↔
      spaTilt p P '' U ∈ spaRationalFamily (Perfectoid.Pair.tilt p P).plus := sorry

open scoped Classical in
/-- P2/tilting-homeomorphism-and-rational-subsets: every rational `U ⊆ X` is `U(T♯/s♯)` for some
`T ⊆ R♭⁺` containing `(ϖ♭)^N` and `s ∈ R♭⁺` (Sch12 Corollary 6.7(iii)). -/
theorem exists_sharp_presentation (ϖ : PseudoUniformizerRoots p R) {U : Set (spa P.plus)}
    (hU : U ∈ spaRationalFamily P.plus) :
    ∃ (T : Finset (tilt p R)) (s : tilt p R) (N : ℕ),
      (∀ t ∈ T, t ∈ (Perfectoid.Pair.tilt p P).plus) ∧ s ∈ (Perfectoid.Pair.tilt p P).plus ∧
      ϖ.toTilt ^ N ∈ T ∧
      U = Subtype.val ⁻¹' rationalSubset P.plus (T.image (tilt.sharp : tilt p R → R))
        (tilt.sharp s) := sorry

/-- P2/tilting-homeomorphism-and-rational-subsets: `τ_R` preserves and reflects specialisation
(ECD Theorem 3.12). -/
theorem specializes_spaTilt_iff (x y : spa P.plus) :
    spaTilt p P x ⤳ spaTilt p P y ↔ x ⤳ y := sorry

/-- P2/tilting-homeomorphism-and-rational-subsets: `τ_R` restricts, for every `U ⊆ X` (in
particular every rational `U`), to a homeomorphism `U ≃ₜ τ_R(U)`; with
`isRational_image_spaTilt_iff` it identifies the rational subsets of `U` and of `τ_R(U)`
(Sch12 Corollary 6.7(iii)). -/
theorem exists_homeomorph_image_spaTilt (U : Set (spa P.plus)) :
    ∃ e : U ≃ₜ (spaTilt p P '' U), ∀ x : U,
      (e x : spa (Perfectoid.Pair.tilt p P).plus) = spaTilt p P x := sorry

end Homeomorph

end PerfectoidSpace

/-! ## PerfectoidSpaces:P2/rational-localization-of-perfectoid-affinoids (construction) -/

namespace Perfectoid

section RationalLocalization

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  (P : Pair R) {D : PairOfDefinition R} (𝔭 : D.Presentation) {E : PairOfDefinition (tilt p R)}

/-- P2/rational-localization-of-perfectoid-affinoids (supporting definition): the presentation `𝔮`
of a rational subset of `X♭` presents the image `τ_R(U)` of the rational subset `U` presented by
`𝔭`, both numerator sets generating the unit ideal (ECD Theorem 3.12). -/
structure IsTiltPresentation (𝔮 : E.Presentation) : Prop where
  /-- The numerators of `𝔭` generate the unit ideal of `R`. -/
  span_num : Ideal.span (𝔭.num : Set R) = ⊤
  /-- The numerators of `𝔮` generate the unit ideal of `R♭`. -/
  span_num_tilt : Ideal.span (𝔮.num : Set (tilt p R)) = ⊤
  /-- `τ_R(U(𝔭)) = U(𝔮)`. -/
  image_eq : PerfectoidSpace.spaTilt p P '' (Subtype.val ⁻¹' rationalSubset P.plus 𝔭.num 𝔭.den) =
    Subtype.val ⁻¹' rationalSubset (Pair.tilt p P).plus 𝔮.num 𝔮.den

-- Perfectoid.rationalLocalization: not stated here; needs the presentation-independent rational
--   localisation `O_X(U)`, `O_X⁺(U)` of a rational subset `U` with its structure morphism
--   (supplier: AdicSpaces Layer 3). Per-presentation core: `rationalLocalization_affinoid`.

/-- P2/rational-localization-of-perfectoid-affinoids (data, per-presentation core of
`Perfectoid.rationalLocalization`): the Huber pair `(O_X(U), O_X⁺(U)) = (R⟨T/s⟩, R⟨T/s⟩⁺)` of a
presentation `U = U(T/s)`, bundled with its structure morphism from `(R, R⁺)` (ECD Theorem 3.18;
HK Proposition 3.8). -/
def rationalLocalization_affinoid : Pair.Hom P (RationalLoc.pair 𝔭 P) :=
  RationalLoc.structureMap 𝔭 P

-- Perfectoid.rationalLocalization.isPerfectoidTateRing: not stated here; an instance on
--   `O_X(U)` needs the presentation-independent rational localisation (supplier: AdicSpaces
--   Layer 3). Per-presentation core: `rationalLocalization.isPerfectoidTateRing_affinoid`.

/-- P2/rational-localization-of-perfectoid-affinoids (instance core): `R⟨T/s⟩` is a perfectoid Tate
ring for every presentation with `T` generating the unit ideal; no base field (ECD Theorem 3.18;
Berkeley Theorem 6.2.6; KL II Theorem 3.3.18). -/
theorem rationalLocalization.isPerfectoidTateRing_affinoid
    (hT : Ideal.span (𝔭.num : Set R) = ⊤) : IsPerfectoidTateRing p (RationalLoc 𝔭) := sorry

-- Perfectoid.rationalLocalization.tiltEquiv: not stated here; needs `O_X(U)` and `O_{X♭}(τU)`
--   independent of presentations (supplier: AdicSpaces Layer 3). Per-presentation core:
--   `rationalLocalization.tiltEquiv_affinoid`.

/-- P2/rational-localization-of-perfectoid-affinoids (equivalence core): for a presentation `𝔭` of
`U ⊆ X` and a presentation `𝔮` of `τ_R(U) ⊆ X♭`, the isomorphism `O_X(U)♭ ≃+* O_{X♭}(τU)` (ECD
Theorem 3.18; AWS Theorem 2.5.3(b)); `rationalLocalization.tiltEquiv_affinoid_spec` states that it
is a homeomorphism matching the plus rings. -/
def rationalLocalization.tiltEquiv_affinoid (𝔮 : E.Presentation)
    [IsPerfectoidTateRing p (RationalLoc 𝔭)]
    (h : IsTiltPresentation p P 𝔭 𝔮) :
    tilt p (RationalLoc 𝔭) ≃+* RationalLoc 𝔮 := sorry

/-- P2/rational-localization-of-perfectoid-affinoids: `tiltEquiv_affinoid` is a homeomorphism
carrying `O_X⁺(U)♭` onto `O_{X♭}⁺(τU)`: an isomorphism of perfectoid Tate pairs. -/
theorem rationalLocalization.tiltEquiv_affinoid_spec (𝔮 : E.Presentation)
    [IsPerfectoidTateRing p (RationalLoc 𝔭)]
    (h : IsTiltPresentation p P 𝔭 𝔮) :
    Continuous (rationalLocalization.tiltEquiv_affinoid p P 𝔭 𝔮 h) ∧
      Continuous (rationalLocalization.tiltEquiv_affinoid p P 𝔭 𝔮 h).symm ∧
      (Pair.tilt p (RationalLoc.pair 𝔭 P)).plus.map
          (rationalLocalization.tiltEquiv_affinoid p P 𝔭 𝔮 h).toRingHom =
        (RationalLoc.pair 𝔮 (Pair.tilt p P)).plus := sorry

-- Perfectoid.rationalLocalization.tiltEquiv_comp_structureMap: not stated here; needs `O_X(U)`
--   independent of presentations (supplier: AdicSpaces Layer 3). Per-presentation core:
--   `rationalLocalization.tiltEquiv_comp_structureMap_affinoid`.

/-- P2/rational-localization-of-perfectoid-affinoids (compatibility core): `tiltEquiv_affinoid`
composed with the tilt of the structure map `R → O_X(U)` is the structure map
`R♭ → O_{X♭}(τU)`; equivalently `♯` commutes with the structure maps (ECD Theorem 3.18). -/
theorem rationalLocalization.tiltEquiv_comp_structureMap_affinoid (𝔮 : E.Presentation)
    [IsPerfectoidTateRing p (RationalLoc 𝔭)]
    (h : IsTiltPresentation p P 𝔭 𝔮) :
    (rationalLocalization.tiltEquiv_affinoid p P 𝔭 𝔮 h).toRingHom.comp
        (tilt.map p (RationalLoc.toLoc 𝔭) (RationalLoc.continuous_toLoc 𝔭)) =
      RationalLoc.toLoc 𝔮 := sorry

-- Perfectoid.rationalLocalization.lift: not stated here; needs `O_X(U)` independent of
--   presentations (supplier: AdicSpaces Layer 3). Per-presentation core:
--   `rationalLocalization.lift_affinoid`.

/-- P2/rational-localization-of-perfectoid-affinoids (universal-property core): a morphism
`φ : (R, R⁺) → (B, B⁺)` to a complete Huber pair with `Spa(φ)` landing in `U(T/s)` factors
through `(R⟨T/s⟩, R⟨T/s⟩⁺)` (Wedhorn Proposition 8.2; HK Proposition 3.8; the universal property
among perfectoid pairs is its restriction). -/
def rationalLocalization.lift_affinoid {B : Type u} [CommRing B] [UniformSpace B]
    [IsUniformAddGroup B] [IsTopologicalRing B] [IsHuberRing B] [CompleteSpace B] [T2Space B]
    {Q : Pair B} (φ : Pair.Hom P Q)
    (hφ : ∀ y, (φ.spaComap y).1 ∈ rationalSubset P.plus 𝔭.num 𝔭.den) :
    Pair.Hom (RationalLoc.pair 𝔭 P) Q := sorry

/-- P2/rational-localization-of-perfectoid-affinoids (universal-property core): `lift_affinoid`
factors `φ` through the structure map, uniquely (`lift_comp_structureMap` and `hom_ext`). -/
theorem rationalLocalization.lift_affinoid_spec {B : Type u} [CommRing B] [UniformSpace B]
    [IsUniformAddGroup B] [IsTopologicalRing B] [IsHuberRing B] [CompleteSpace B] [T2Space B]
    {Q : Pair B} (φ : Pair.Hom P Q)
    (hφ : ∀ y, (φ.spaComap y).1 ∈ rationalSubset P.plus 𝔭.num 𝔭.den) :
    (rationalLocalization.lift_affinoid P 𝔭 φ hφ).comp (RationalLoc.structureMap 𝔭 P) = φ ∧
      ∀ ψ : Pair.Hom (RationalLoc.pair 𝔭 P) Q, ψ.comp (RationalLoc.structureMap 𝔭 P) = φ →
        ψ = rationalLocalization.lift_affinoid P 𝔭 φ hφ := sorry

open scoped Classical in
/-- P2/rational-localization-of-perfectoid-affinoids (compatibility): `τ_R(U(T♯/s♯)) = U(T/s)`
for `T ⊆ R♭⁺` containing `(ϖ♭)^N` and `s ∈ R♭⁺`; every rational `U` has such a presentation
(`PerfectoidSpace.exists_sharp_presentation`) (Sch12 Corollary 6.7(iii); ECD Theorem 3.12). -/
theorem rationalLocalization.image_spaTilt (ϖ : PseudoUniformizerRoots p R)
    (T : Finset (tilt p R)) (s : tilt p R) (N : ℕ) (hT : ∀ t ∈ T, t ∈ (Pair.tilt p P).plus)
    (hs : s ∈ (Pair.tilt p P).plus) (hN : ϖ.toTilt ^ N ∈ T) :
    PerfectoidSpace.spaTilt p P ''
        (Subtype.val ⁻¹' rationalSubset P.plus (T.image (tilt.sharp : tilt p R → R))
          (tilt.sharp s)) =
      Subtype.val ⁻¹' rationalSubset (Pair.tilt p P).plus T s := sorry

/-- P2/rational-localization-of-perfectoid-affinoids: the untilt `U(T♯/g♯)` of a normalised
presentation `U(T/g)` of `X♭` (`IsSharpPresentation`) presents `τ_R⁻¹(U(T/g))`, so the pair is a
tilt presentation (`rationalLocalization.image_spaTilt`). -/
theorem IsSharpPresentation.isTiltPresentation (ϖ : PseudoUniformizerRoots p R)
    {𝔮 : E.Presentation} (h : IsSharpPresentation p P ϖ 𝔮 𝔭) : IsTiltPresentation p P 𝔭 𝔮 :=
  sorry

-- Perfectoid.rationalLocalization.almostEquivIntegralModel: not stated here; needs `O_X⁺(U)`
--   independent of presentations (supplier: AdicSpaces Layer 3). Per-presentation core:
--   `rationalLocalization.almostEquivIntegralModel_affinoid`.

/-- P2/rational-localization-of-perfectoid-affinoids (characterisation core): for a sharp
presentation `U = U(f♯/g♯)` (`f_i, g ∈ R♭⁺`, `(ϖ♭)^N ∈ f`), `O_X⁺(U)ᵃ ≅ (R⁺⟨(f♯/g♯)^{1/p^∞}⟩)ᵃ`:
the model lies in `O_X⁺(U)` and `O_X⁺(U)/model` is killed by every `ϖ^{1/pⁿ}` (Sch12 Lemma 6.4;
Bhatt Lemma 9.2.5). -/
theorem rationalLocalization.almostEquivIntegralModel_affinoid (ϖ : PseudoUniformizerRoots p R)
    (𝔮 : E.Presentation) (h : IsSharpPresentation p P ϖ 𝔮 𝔭) :
    RationalLoc.rootModel 𝔭 P.plus 𝔮.num 𝔮.den (fun m f ↦ tilt.coeff m f) ≤
      (RationalLoc.pair 𝔭 P).plus ∧
    ∀ n, ∀ x ∈ (RationalLoc.pair 𝔭 P).plus, RationalLoc.toLoc 𝔭 (ϖ.root n) * x ∈
      RationalLoc.rootModel 𝔭 P.plus 𝔮.num 𝔮.den (fun m f ↦ tilt.coeff m f) := sorry

-- Perfectoid.rationalLocalization.tiltEquivalence: not stated here; the equivalence of
--   categories of rational localisations needs `O_X` on rational subsets with its restriction
--   maps (supplier: AdicSpaces Layer 3). Topological core:
--   `rationalLocalization.tiltEquivalence_core`.

/-- P2/rational-localization-of-perfectoid-affinoids (equivalence core): `U ↦ τ_R(U)` is an order
isomorphism from the rational subsets of `X` to those of `X♭` (AWS Theorem 2.5.3(b); ECD Theorem
3.12); `rationalLocalization.tiltEquivalence_core_apply` computes it. -/
def rationalLocalization.tiltEquivalence_core :
    spaRationalFamily P.plus ≃o spaRationalFamily (Pair.tilt p P).plus := sorry

/-- P2/rational-localization-of-perfectoid-affinoids: `tiltEquivalence_core U = τ_R(U)`. -/
theorem rationalLocalization.tiltEquivalence_core_apply (U : spaRationalFamily P.plus) :
    ((rationalLocalization.tiltEquivalence_core p P U : spaRationalFamily (Pair.tilt p P).plus) :
      Set (spa (Pair.tilt p P).plus)) = PerfectoidSpace.spaTilt p P '' U := sorry

-- Perfectoid.rationalLocalization.isUniform: not stated here; an instance on `O_X(U)` needs the
--   presentation-independent rational localisation and the anchor's uniformity predicate
--   (supplier: AdicSpaces Layer 3, Layer 4). Core: `rationalLocalization.isUniform_affinoid`.

/-- P2/rational-localization-of-perfectoid-affinoids (instance core): `R⟨T/s⟩°` is bounded
(`R⟨T/s⟩` is uniform), consumed by stable uniformity (ECD Theorem 3.18; HK Corollary 3.15). -/
theorem rationalLocalization.isUniform_affinoid (hT : Ideal.span (𝔭.num : Set R) = ⊤) :
    IsBounded (powerBoundedSubring (RationalLoc 𝔭) : Set (RationalLoc 𝔭)) := sorry

-- Perfectoid.rationalLocalization.tiltEquiv_of_charP: not stated here; needs `O_X(U)`
--   independent of presentations (supplier: AdicSpaces Layer 3). Per-presentation core:
--   `rationalLocalization.tiltEquiv_of_charP_affinoid`.

/-- P2/rational-localization-of-perfectoid-affinoids (simp core): if `pR = 0`, `tiltEquiv_affinoid`
is the identity under `R♭ ≃+* R` and `O_X(U)♭ ≃+* O_X(U)` (P1 `tilt.equivOfCharP`): it sends
the image of `a ∈ R♭` to the image of `a` (ECD Proposition 3.5). -/
@[simp] theorem rationalLocalization.tiltEquiv_of_charP_affinoid [CharP R p]
    [CharP (RationalLoc 𝔭) p] [IsPerfectoidTateRing p (RationalLoc 𝔭)] (𝔮 : E.Presentation)
    (h : IsTiltPresentation p P 𝔭 𝔮) (a : tilt p R) :
    rationalLocalization.tiltEquiv_affinoid p P 𝔭 𝔮 h
        ((tilt.equivOfCharP : tilt p (RationalLoc 𝔭) ≃+* RationalLoc 𝔭).symm
          (RationalLoc.toLoc 𝔭 (tilt.equivOfCharP a))) =
      RationalLoc.toLoc 𝔮 a := sorry

end RationalLocalization

section RationalLocalizationTests

variable (p : ℕ) [Fact p.Prime]

-- The perfectoid disc `ℚ_p^cycl⟨T^{1/p^∞}⟩`.
local notation "𝔻" => perfectedTateAlgebra p (padicCyclotomic p) Unit

-- Its Huber pair with plus ring `ℚ_p^cycl°⟨T^{1/p^∞}⟩`.
local notation "𝔻₊" =>
  (perfectedTateAlgebra.plus p (σ := Unit) (Pair.powerBounded (padicCyclotomic p)))

open scoped Classical in
/- For `U = {|T| ≤ |ϖ|} = U({T, ϖ}/ϖ)` on the disc, `O_X(U) ≅ ℚ_p^cycl⟨(T/ϖ)^{1/p^∞}⟩`,
`T ↦ ϖ · T'`. -/
-- test rationalLocalization_test_perfectoidDisc (computation)
--   [P2/rational-localization-of-perfectoid-affinoids]
example (ϖ : PseudoUniformizerRoots p (padicCyclotomic p)) {D : PairOfDefinition 𝔻}
    (𝔭 : D.Presentation)
    (hnum : 𝔭.num = {perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0),
      algebraMap (padicCyclotomic p) 𝔻 (ϖ.root 0)})
    (hden : 𝔭.den = algebraMap (padicCyclotomic p) 𝔻 (ϖ.root 0)) :
    ∃ e : RationalLoc 𝔭 ≃+* 𝔻, Continuous e ∧ Continuous e.symm ∧
      e (RationalLoc.toLoc 𝔭 (perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0))) =
        algebraMap (padicCyclotomic p) 𝔻 (ϖ.root 0) *
          perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0) := sorry

open scoped Classical in
/- ECD Example 3.4(iv) is not stated in P1; the product `ℂ_p × ℂ_p♭` (P1 `perfectoidExamples`),
in which `p` is a nonzero nonunit, likewise contains no nonarchimedean field. For
`U = U({ϖ, p}/p)`, `O_X(U)` is perfectoid and `p` is a unit there; no base field is used. -/
-- test rationalLocalization_test_noBaseField (compatibility)
--   [P2/rational-localization-of-perfectoid-affinoids]
example {D : PairOfDefinition (ℂ_[p] × tilt p ℂ_[p])} (𝔭 : D.Presentation)
    (ϖ : ℂ_[p] × tilt p ℂ_[p]) (hϖ : IsPseudoUniformizer ϖ)
    (hnum : 𝔭.num = {ϖ, (p : ℂ_[p] × tilt p ℂ_[p])}) (hden : 𝔭.den = p) :
    IsPerfectoidTateRing p (RationalLoc 𝔭) ∧
      IsUnit (RationalLoc.toLoc 𝔭 (p : ℂ_[p] × tilt p ℂ_[p])) := sorry

/- In characteristic `p` (`R = ℚ_p^cycl♭`, P1 `tilt.charP`) the tilt identification is the
identity. -/
-- test rationalLocalization_test_charP (degenerate)
--   [P2/rational-localization-of-perfectoid-affinoids]
example (P : Pair (tilt p (padicCyclotomic p))) {D : PairOfDefinition (tilt p (padicCyclotomic p))}
    (𝔭 : D.Presentation) {E : PairOfDefinition (tilt p (tilt p (padicCyclotomic p)))}
    (𝔮 : E.Presentation) [CharP (RationalLoc 𝔭) p] [IsPerfectoidTateRing p (RationalLoc 𝔭)]
    (h : IsTiltPresentation p P 𝔭 𝔮)
    (a : tilt p (tilt p (padicCyclotomic p))) :
    rationalLocalization.tiltEquiv_affinoid p P 𝔭 𝔮 h
        ((tilt.equivOfCharP : tilt p (RationalLoc 𝔭) ≃+* RationalLoc 𝔭).symm
          (RationalLoc.toLoc 𝔭 (tilt.equivOfCharP a))) =
      RationalLoc.toLoc 𝔮 a := sorry

open scoped Classical in
/- The naive model `R°⟨T/ϖ⟩` (no `p`-power roots, `root m = id`) is not almost equal to
`O_X(U)°` for `U = {|T| ≤ |ϖ|}`: some `x ∈ O_X(U)°` (namely `(T/ϖ)^{1/p}`) has
`ϖ^{1/p} x ∉ R°⟨T/ϖ⟩`. -/
-- test rationalLocalization_test_naiveModel (non-example)
--   [P2/rational-localization-of-perfectoid-affinoids]
example (ϖ : PseudoUniformizerRoots p (padicCyclotomic p)) {D : PairOfDefinition 𝔻}
    (𝔭 : D.Presentation)
    (hnum : 𝔭.num = {perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0),
      algebraMap (padicCyclotomic p) 𝔻 (ϖ.root 0)})
    (hden : 𝔭.den = algebraMap (padicCyclotomic p) 𝔻 (ϖ.root 0)) :
    ∃ x ∈ powerBoundedSubring (RationalLoc 𝔭),
      RationalLoc.toLoc 𝔭 (algebraMap (padicCyclotomic p) 𝔻 (ϖ.root 1)) * x ∉
        RationalLoc.rootModel 𝔭 (powerBoundedSubring 𝔻)
          ({perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0)} : Finset 𝔻)
          (algebraMap (padicCyclotomic p) 𝔻 (ϖ.root 0)) (fun _ f ↦ f) := sorry

/- For `U = X = U({1}/1)`, the rational localisation is `(R, R⁺)` itself. -/
-- test rationalLocalization_test_whole_space (characterisation)
--   [P2/rational-localization-of-perfectoid-affinoids]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R)
    {D : PairOfDefinition R} (𝔭 : D.Presentation) (hnum : 𝔭.num = {1}) (hden : 𝔭.den = 1) :
    Function.Bijective (RationalLoc.toLoc 𝔭) ∧
      (RationalLoc.pair 𝔭 P).plus = P.plus.map (RationalLoc.toLoc 𝔭) := sorry

end RationalLocalizationTests

end Perfectoid

/-! ## PerfectoidSpaces:P2/perfectoid-pair-rational-restriction (construction) -/

namespace PerfectoidSpace

open Perfectoid

section RationalRestriction

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  (P : Pair R) {D : PairOfDefinition R} (𝔭 : D.Presentation) {E : PairOfDefinition (tilt p R)}

-- PerfectoidSpace.rationalPairFunctor: not stated here; needs the anchor's structure presheaf
--   on the rational subsets of `Spa(R, R⁺)` with its restriction maps (supplier: AdicSpaces
--   Layer 3). Per-presentation core: `rationalPairFunctor_affinoid`, on Tau Ceti's refinement
--   preorder of presentations.

variable (D) in
/-- P2/perfectoid-pair-rational-restriction (data, per-presentation core of
`PerfectoidSpace.rationalPairFunctor`): on the refinement preorder of presentations `(T, s)`
with `T` generating the unit ideal (Tau Ceti `Presentation`, `p ≤ q` when `q` refines `p`),
`𝔭 ↦ R⟨T/s⟩` as a functor to perfectoid Tate rings; its maps are the refinement restriction
maps (Tau Ceti `PairOfDefinition.Presentation.restrictionHom`, whose module is not built at the
pin, so the action on arrows is left as `sorry`). -/
def rationalPairFunctor_affinoid :
    {𝔭 : D.Presentation // Ideal.span (𝔭.num : Set R) = ⊤} ⥤ PerfectoidRingCat.{u} p where
  obj 𝔭 :=
    haveI := rationalLocalization.isPerfectoidTateRing_affinoid p 𝔭.1 𝔭.2
    PerfectoidRingCat.of p (RationalLoc 𝔭.1)
  map := sorry
  map_id := sorry
  map_comp := sorry

-- PerfectoidSpace.rationalPairFunctor.map_comp: not stated here; the composition law of the
--   anchor's restriction maps (supplier: AdicSpaces Layer 3); for the core it is
--   `Functor.map_comp` of `rationalPairFunctor_affinoid`.
-- PerfectoidSpace.rationalPairFunctor.isRationalLocalization_map: not stated here; needs the
--   restriction maps of `O_X` and the identification `Spa(O_X(U), O_X⁺(U)) ≅ U` with rational
--   subsets (supplier: AdicSpaces Layer 3).
-- PerfectoidSpace.rationalPairFunctor.mem_plus_iff: not stated here; needs `O_X⁺(U)` independent
--   of presentations (supplier: AdicSpaces Layer 3). Core:
--   `rationalPairFunctor.mem_plus_iff_affinoid`.

/-- P2/perfectoid-pair-rational-restriction (characterisation core): `f ∈ O_X⁺(U)` iff
`|f(y)| ≤ 1` at every point `y` of `Spa(O_X(U), O_X⁺(U)) ≅ U` (Sch12 remark after Definition
6.1; Tau Ceti `spaLocalizationHomeomorph`). -/
theorem rationalPairFunctor.mem_plus_iff_affinoid (f : RationalLoc 𝔭) :
    f ∈ (RationalLoc.pair 𝔭 P).plus ↔
      ∀ y : spa (RationalLoc.pair 𝔭 P).plus, y.1.toValuativeRel.vle f 1 := sorry

-- PerfectoidSpace.rationalPairFunctor.isAlmostZero_powerBounded_quot_plus: not stated here;
--   needs `O_X(U)` independent of presentations (supplier: AdicSpaces Layer 3). Core:
--   `rationalPairFunctor.isAlmostZero_powerBounded_quot_plus_affinoid`.

/-- P2/perfectoid-pair-rational-restriction (relation core): `O_X(U)°/O_X⁺(U)` is almost zero:
every `ϖ^{1/pⁿ}` multiplies `O_X(U)°` into `O_X⁺(U)`, so `O_X⁺(U)ᵃ = O_X(U)°ᵃ` (ECD Example
3.22(ii); Bhatt proof of Lemma 9.2.5(4)). -/
theorem rationalPairFunctor.isAlmostZero_powerBounded_quot_plus_affinoid
    (ϖ : PseudoUniformizerRoots p R) (hT : Ideal.span (𝔭.num : Set R) = ⊤) :
    ∀ n, ∀ x ∈ powerBoundedSubring (RationalLoc 𝔭),
      RationalLoc.toLoc 𝔭 (ϖ.root n) * x ∈ (RationalLoc.pair 𝔭 P).plus := sorry

-- PerfectoidSpace.rationalPairFunctor.tiltIso: not stated here; a natural isomorphism of
--   functors on rational subsets needs `rationalPairFunctor` (supplier: AdicSpaces Layer 3).
--   Objectwise core: `Perfectoid.rationalLocalization.tiltEquiv_affinoid`.
-- PerfectoidSpace.rationalPairFunctor.plusModEquiv: not stated here; naturality in `U` needs the
--   restriction maps of `O_X⁺` (supplier: AdicSpaces Layer 3). Objectwise core:
--   `rationalPairFunctor.plusModEquiv_affinoid`.

/-- P2/perfectoid-pair-rational-restriction (compatibility core): the ring isomorphism
`O_{X♭}⁺(τU)/ϖ♭ ≃+* O_X⁺(U)/ϖ` induced by `♯` (ECD Lemma 3.11 applied to `O_X(U)`);
`rationalPairFunctor.plusModEquiv_affinoid_mk` states that it is induced by `♯`. -/
def rationalPairFunctor.plusModEquiv_affinoid (ϖ : PseudoUniformizerRoots p R)
    (𝔮 : E.Presentation)
    (h : IsTiltPresentation p P 𝔭 𝔮) :
    (RationalLoc.pair 𝔮 (Perfectoid.Pair.tilt p P)).plus ⧸
        Ideal.span {RationalLoc.toPlus 𝔮 (Perfectoid.Pair.tilt p P)
          ⟨ϖ.toTilt, ϖ.toTilt_mem_tilt_plus p P⟩} ≃+*
      (RationalLoc.pair 𝔭 P).plus ⧸ Ideal.span {RationalLoc.toPlus 𝔭 P (ϖ.rootPlus p P)} :=
  sorry

/-- P2/perfectoid-pair-rational-restriction (compatibility core): `plusModEquiv_affinoid` sends the
class of (the image of) `a ∈ R♭⁺` to the class of (the image of) `a♯ ∈ R⁺`. -/
theorem rationalPairFunctor.plusModEquiv_affinoid_mk (ϖ : PseudoUniformizerRoots p R)
    (𝔮 : E.Presentation)
    (h : IsTiltPresentation p P 𝔭 𝔮)
    (a : (Perfectoid.Pair.tilt p P).plus) :
    rationalPairFunctor.plusModEquiv_affinoid p P 𝔭 ϖ 𝔮 h
        (Ideal.Quotient.mk _ (RationalLoc.toPlus 𝔮 (Perfectoid.Pair.tilt p P) a)) =
      Ideal.Quotient.mk _ (RationalLoc.toPlus 𝔭 P
        ⟨tilt.sharp (a : tilt p R), (Perfectoid.Pair.mem_tilt_plus_iff p P a).mp a.2⟩) := sorry

-- PerfectoidSpace.rationalPairFunctor.spaTilt_comm: not stated here; needs the anchor's
--   homeomorphism `Spa(O_X(U), O_X⁺(U)) ≅ U` for the completed localisation (supplier:
--   AdicSpaces Layer 3). Core: `rationalPairFunctor.spaTilt_comm_affinoid`.

/-- P2/perfectoid-pair-rational-restriction (supporting data): `tiltEquiv_affinoid⁻¹` as a morphism
of Huber pairs `(O_{X♭}(τU), O_{X♭}⁺(τU)) → (O_X(U), O_X⁺(U))♭`. -/
def rationalPairFunctor.tiltEquivHom_affinoid (𝔮 : E.Presentation)
    [IsPerfectoidTateRing p (RationalLoc 𝔭)]
    (h : IsTiltPresentation p P 𝔭 𝔮) :
    Pair.Hom (RationalLoc.pair 𝔮 (Perfectoid.Pair.tilt p P))
      (Perfectoid.Pair.tilt p (RationalLoc.pair 𝔭 P)) where
  toRingHom := (rationalLocalization.tiltEquiv_affinoid p P 𝔭 𝔮 h).symm.toRingHom
  continuous_toRingHom := sorry
  map_mem_plus := sorry

/-- P2/perfectoid-pair-rational-restriction (compatibility core): through the structure maps
`Spa(O_X(U)) → X` and `Spa(O_{X♭}(τU)) → X♭` and `tiltEquiv_affinoid`, the tilting map of
`O_X(U)` is the restriction of `τ_R` (ECD Theorem 3.12 applied to `O_X(U)`). -/
theorem rationalPairFunctor.spaTilt_comm_affinoid (𝔮 : E.Presentation)
    [IsPerfectoidTateRing p (RationalLoc 𝔭)]
    (h : IsTiltPresentation p P 𝔭 𝔮) :
    spaTilt p P ∘ (RationalLoc.structureMap 𝔭 P).spaComap =
      (RationalLoc.structureMap 𝔮 (Perfectoid.Pair.tilt p P)).spaComap ∘
        (rationalPairFunctor.tiltEquivHom_affinoid p P 𝔭 𝔮 h).spaComap ∘
          spaTilt p (RationalLoc.pair 𝔭 P) := sorry

end RationalRestriction

section RationalRestrictionTests

variable (p : ℕ) [Fact p.Prime]

-- rationalPairFunctor_test_restriction_disc: not stated here; needs the restriction map
--   `O_X({|T| ≤ |ϖ|}) → O_X({|T| ≤ |ϖ|²})` between rational localisations of the disc
--   (supplier: AdicSpaces Layer 3) [computation test]

/- For `U = X` (presentations `({1}, 1)`), `plusModEquiv_affinoid` is P1's
`Pair.tiltPlusQuotEquiv : R♭⁺/ϖ♭ ≃+* R⁺/ϖ` (ECD Lemma 3.11) on the images of `R♭⁺` and `R⁺`. -/
-- test rationalPairFunctor_test_plusModEquiv_whole (compatibility)
--   [P2/perfectoid-pair-rational-restriction]
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R)
    (ϖ : PseudoUniformizerRoots p R) {D : PairOfDefinition R} (𝔭 : D.Presentation)
    {E : PairOfDefinition (tilt p R)} (𝔮 : E.Presentation) (h𝔭 : 𝔭.num = {1} ∧ 𝔭.den = 1)
    (h𝔮 : 𝔮.num = {1} ∧ 𝔮.den = 1)
    (h : IsTiltPresentation p P 𝔭 𝔮)
    (a : (Perfectoid.Pair.tilt p P).plus) :
    ∃ b : P.plus, Perfectoid.Pair.tiltPlusQuotEquiv p P ϖ (Ideal.Quotient.mk _ a) =
        Ideal.Quotient.mk _ b ∧
      rationalPairFunctor.plusModEquiv_affinoid p P 𝔭 ϖ 𝔮 h
          (Ideal.Quotient.mk _ (RationalLoc.toPlus 𝔮 (Perfectoid.Pair.tilt p P) a)) =
        Ideal.Quotient.mk _ (RationalLoc.toPlus 𝔭 P b) := sorry

/- The plus ring need not be `R°`: on the disc there is a ring of integral elements
`R⁺ = K° + K°°⟨T^{1/p^∞}⟩` with `T ∈ R° \ R⁺` and `ϖ^{1/pⁿ} T ∈ R⁺` for all `n`. -/
-- test rationalPairFunctor_test_plus_ne_powerBounded (non-example)
--   [P2/perfectoid-pair-rational-restriction]
example (ϖ : PseudoUniformizerRoots p (padicCyclotomic p)) :
    ∃ Q : Pair (perfectedTateAlgebra p (padicCyclotomic p) Unit),
      perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0) ∈
          powerBoundedSubring (perfectedTateAlgebra p (padicCyclotomic p) Unit) ∧
        perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0) ∉ Q.plus ∧
        ∀ n, algebraMap (padicCyclotomic p) (perfectedTateAlgebra p (padicCyclotomic p) Unit)
            (ϖ.root n) * perfectedTateAlgebra.X p () (PDyadicExp.invPow p 0) ∈ Q.plus := sorry

-- rationalPairFunctor_test_charP: not stated here; needs `rationalPairFunctor.tiltIso`, the
--   natural isomorphism on rational subsets (supplier: AdicSpaces Layer 3) [degenerate test]

end RationalRestrictionTests

end PerfectoidSpace

/-! ## PerfectoidSpaces:P2/completed-residue-fields (theorem) -/

/-! The completed residue field `k(x)^` (the completion of the residue field of the stalk `O_{X,x}`)
and its plus ring are anchor Layer 3.3; Tau Ceti has the residue field `κ(supp x)` with its
valuation (`ValuationSpectrum.residueFieldValuation`), not the completion as a nonarchimedean
field. -/

-- PerfectoidSpace.isPerfectoidField_completedResidueField: not stated here; needs the completed
--   residue field `k(x)^` of a point of `Spa(R, R⁺)` as a complete nonarchimedean field (supplier:
--   AdicSpaces Layer 3). The statement is that `k(x)^` is a perfectoid field (Sch12 Corollary
--   6.7(ii); AWS Corollary 2.5.7).
-- PerfectoidSpace.completedResidueField_tiltEquiv: not stated here; the isomorphism
--   `k(x)^♭ ≃+* k(x♭)^` compatible with `♯` needs the same carrier (supplier: AdicSpaces
--   Layer 3; KL II Theorem 3.3.18(ii)). Value-group core: `completedResidueField_valueGroup_core`.

namespace PerfectoidSpace

open Perfectoid

/-- P2/completed-residue-fields (value-group core): every value `|a(x)|` of a point `x` of
`Spa(R, R⁺)` is a value `|f♯(x)| = |f(x♭)|` of `x♭`, so `Γ_x = Γ_{x♭}` (Sch12 proof of Corollary
6.7(ii), from the approximation lemma; AWS proof of Corollary 2.5.7). -/
theorem completedResidueField_valueGroup_core (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R]
    [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R]
    [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R) (x : spa P.plus) (a : R) :
    ∃ f : tilt p R, x.1.toValuativeRel.vle a (tilt.sharp f) ∧
      x.1.toValuativeRel.vle (tilt.sharp f) a := sorry

end PerfectoidSpace

/-! ## PerfectoidSpaces:P2/perfectoid-stably-uniform-and-sheafy (theorem) -/

namespace Perfectoid

-- Perfectoid.isStablyUniform: not stated here; needs the anchor's stable-uniformity predicate
--   `Huber.IsStablyUniform` on the presentation-independent `O_X(U)` (supplier: AdicSpaces
--   Layer 4). Per-presentation core: `Perfectoid.isStablyUniform_core`.
-- Perfectoid.isSheafyPair: not stated here; needs the structure presheaf `O_X` on `Spa(R, R⁺)`
--   and the sheafiness predicate `Huber.IsSheafyPair` (supplier: AdicSpaces Layer 3, Layer 4).
--   The statement: `O_X` and `O_X⁺` are sheaves, also on every rational `U` (KL I Theorem
--   3.6.15; HK Corollary 3.15; Berkeley Theorem 6.1.10).
-- Perfectoid.cech_exact: not stated here; the augmented Čech complex of `O_X` on a finite
--   rational covering of a rational `U` needs the restriction maps of `O_X` (supplier: AdicSpaces
--   Layer 3); exactness in all degrees and `H^i(U, O_X) = 0` for `i > 0` need sheaf cohomology of
--   `O_X` (supplier: AdicSpaces Layer 4).

/-- P2/perfectoid-stably-uniform-and-sheafy (a), per-presentation core: a perfectoid Tate ring is
stably uniform, every `R⟨T/s⟩` being uniform; by construction this does not involve `R⁺`, as
clause (d) asserts (KL I Theorem 3.6.15; KL II Corollary 3.3.19; Berkeley Theorem 6.1.10; HK
Corollary 3.15). -/
theorem isStablyUniform_core (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R]
    [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] : IsStablyUniformPres R := sorry

end Perfectoid

/-! ## PerfectoidSpaces:P2/integral-cech-cohomology-bounded-torsion (lemma) -/

/-! For a complete stably uniform sheafy Tate pair `(A, A⁺)` and a finite rational covering of a
rational `U`, the augmented alternating Čech complex `C⁺` of `O⁺` has `C⁺[1/ϖ]` exact, is exact at
its first two terms, and has cohomology killed by a fixed `ϖ^N`; likewise for `V ↦ O_X(V)°` (Sch12
proof of Proposition 6.10(iii); Berkeley proof of Theorem 7.4.4). -/

-- ValuationSpectrum.exists_pow_smul_cechPlus_homology_eq_zero: not stated here; the Čech complex
--   of `O⁺` on a finite rational covering needs the restriction maps of `O_X⁺` between rational
--   subsets, and the hypotheses need the anchor's `Huber.IsSheafyPair` (supplier: AdicSpaces
--   Layer 3, Layer 4; AdicSpacesPartII:R3/sheafy-cech-acyclicity for exactness of `C⁺[1/ϖ]`).

/-! ## PerfectoidSpaces:P2/cech-to-sheaf-cohomology-on-rational-basis (lemma) -/

namespace Almost

section CechToSheaf

variable {X : Type u} [TopologicalSpace X] {V : Type u} [CommRing V] (S : BasicSetup V)

/-- P2/cech-to-sheaf-cohomology-on-rational-basis: on a space with a basis `ℬ` of quasi-compact
opens closed under finite intersections, if every finite covering of every `U ∈ ℬ` by members of
`ℬ` has almost zero Čech cohomology in positive degrees, then `H^q(U, F)` is almost zero for
`U ∈ ℬ`, `q > 0` (almost Cartan criterion: KL I proof of Proposition 2.4.21; Stacks Tag 01EW for
`m = V`; Sch12 proof of Proposition 6.14). For `X = Spa(A, A⁺)` take `ℬ` the rational opens (Tau
Ceti `isBasis_spaRationalOpens`, `isCompact_of_mem_spaRationalFamily`). -/
theorem isAlmostAcyclic_of_cech_basis [HasSheafify (Opens.grothendieckTopology X) AddCommGrpCat.{u}]
    [HasExt.{u} (CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})]
    [(Opens.grothendieckTopology X).HasSheafCompose (forget₂ (ModuleCat.{u} V) AddCommGrpCat.{u})]
    (ℬ : Set (TopologicalSpace.Opens X)) (hℬ : TopologicalSpace.Opens.IsBasis ℬ)
    (hcpt : ∀ U ∈ ℬ, IsCompact (U : Set X)) (hinf : ∀ U ∈ ℬ, ∀ W ∈ ℬ, U ⊓ W ∈ ℬ)
    (F : CategoryTheory.Sheaf (Opens.grothendieckTopology X) (ModuleCat.{u} V))
    (hcech : ∀ U ∈ ℬ, ∀ (ι : Type u) [Finite ι] (𝔘 : ι → TopologicalSpace.Opens X),
      (∀ i, 𝔘 i ∈ ℬ) → ⨆ i, 𝔘 i = U →
        ∀ n, 0 < n → IsZero ((Sheaf.almostCech S _ 𝔘 F).homology n)) :
    ∀ U ∈ ℬ, Sheaf.IsAlmostAcyclic S _ F U := sorry

end CechToSheaf

end Almost

