/-! NE.0/uniform-pro-p-group: the closed power subgroup and powerfulness. -/
section Groups
variable (p : ℕ) (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- The closed subgroup generated by n-th powers; this is not a lower-p series. -/
def closedPowerSubgroup (n : ℕ) : Subgroup G :=
  (Subgroup.closure {g : G | ∃ x : G, x ^ n = g}).topologicalClosure

/-- Use fourth powers at 2. The commutator need not already be closed. -/
def IsPowerful : Prop :=
  commutator G ≤ closedPowerSubgroup G (if p = 2 then 4 else p)

/-- The powerful, topologically finitely generated, torsion-free convention.
The constant-index characterization is a README theorem, using upstream's series. -/
def IsUniform [CompactSpace G] [T2Space G] [TotallyDisconnectedSpace G] : Prop :=
  TauCeti.IsProP p G ∧ IsPowerful p G ∧
  (∃ s : Finset G, (Subgroup.closure (s : Set G)).topologicalClosure = ⊤) ∧
  ∀ (g : G) (n : ℕ), 0 < n → g ^ n = 1 → g = 1

example [Fact p.Prime] : IsUniform p (PUnit : Type) := by
  sorry

example [Fact p.Prime] [CompactSpace G] [T2Space G] [TotallyDisconnectedSpace G] (h : IsUniform p G) (g : G) (hg : g ^ p = 1) : g = 1 := by
  sorry

end Groups

/-! NE.1/canonical-ore-set: a light definition over arbitrary ring/module carriers.
The group hypotheses required for regularity and the Ore theorem are in the
README. No assertion that this set is Ore for arbitrary A and B is made. -/
section Canonical
universe u v
variable (A : Type u) (B : Type v) [Ring A] [Ring B]
variable [Module B A] [IsScalarTower B A A]

/-- Finite generation over B of the quotient by the left ideal A f. -/
def canonicalSet : Set A :=
  {f | Module.Finite B (A ⧸ Submodule.span A ({f} : Set A))}

/-- The elementary multiplicativity input to the canonical Ore theorem.
This general statement uses noetherianity of B, not commutativity of A. -/
theorem canonicalSet_one_mul [IsNoetherianRing B] :
    (1 : A) ∈ canonicalSet A B ∧
      ∀ s ∈ canonicalSet A B, ∀ t ∈ canonicalSet A B, s * t ∈ canonicalSet A B := by
  sorry

example : (0 : A) ∈ canonicalSet A A := by
  sorry

example : (0 : Polynomial ℚ) ∉ canonicalSet (Polynomial ℚ) ℚ := by
  sorry

example : Polynomial.X ∈ canonicalSet (Polynomial ℚ) ℚ := by
  sorry

end Canonical

/-! NE.3/artin-evaluation and artin-evaluation-functoriality: the determinant
on a scalar times a representation matrix has exactly the representation degree. -/
section Evaluation
variable {R : Type*} [CommRing R] {n : Type*} [Fintype n] [DecidableEq n]

theorem det_scalar_twist (a : R) (M : Matrix n n R) :
    (a • M).det = a ^ Fintype.card n * M.det := by
  sorry

example : (Matrix.det !![(2 : ℚ), 0; 0, 3]) = 6 := by
  norm_num [Matrix.det_fin_two]

/- The additional transpose in a right row action reverses multiplication. -/
example :
    (!![(1 : ℚ), 1; 0, 1] * !![(1 : ℚ), 0; 1, 1]).transpose ≠
      !![(1 : ℚ), 1; 0, 1].transpose * !![(1 : ℚ), 0; 1, 1].transpose := by
  intro h
  have h00 := congrArg (fun A : Matrix (Fin 2) (Fin 2) ℚ => A 0 0) h
  norm_num [Matrix.mul_apply, Fin.sum_univ_two] at h00

/- For ξ=[γ] and a=2, Φ sends γ to 2(1+T), not (1+T)/2. -/
example :
    ((Polynomial.C (2 : ℚ) * (1 + Polynomial.X) : Polynomial ℚ).coeff 0) = 2 := by
  norm_num [Polynomial.mul_coeff_zero]

end Evaluation

/-! NE.6: concrete checks on the corrected coefficient and congruence conventions. -/
example : ((1, 0) : ℤ × ℤ) * (0, 1) = 0 := by rfl
example : ((1, 0) : ℤ × ℤ) ≠ 0 ∧ ((0, 1) : ℤ × ℤ) ≠ 0 := by decide
example : (2 ^ 10 : ℕ) % 15 = 4 := by norm_num

/-! NE.7/local-epsilon-isomorphism: the integer Gamma factor, including residues
at nonpositive integers. This is a rational formula, not a fake p-adic epsilon carrier. -/
def gammaStar (j : ℤ) : ℚ :=
  if 0 < j then ((j - 1).toNat.factorial : ℚ)
  else (-1 : ℚ) ^ (-j).toNat / ((-j).toNat.factorial : ℚ)

example : gammaStar 3 = 2 := by norm_num [gammaStar, Int.toNat, Nat.factorial]
example : gammaStar 0 = 1 := by norm_num [gammaStar, Int.toNat, Nat.factorial]
example : gammaStar (-1) = -1 := by norm_num [gammaStar, Int.toNat, Nat.factorial]
example : gammaStar (-2) = 1 / 2 := by norm_num [gammaStar, Int.toNat, Nat.factorial]

/-! NE.7/exceptional-euler-leading-term: the local factor contributes its sign.
The arithmetic Bockstein/regulator comparison retains the README hypotheses. -/
example (a : ℚ) :
    ((1 - (1 + Polynomial.X)) * Polynomial.C a : Polynomial ℚ).coeff 1 = -a := by
  sorry

