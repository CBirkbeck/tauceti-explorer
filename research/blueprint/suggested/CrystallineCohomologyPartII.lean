/-
Suggested Lean declarations for `CrystallineCohomologyPartII`
(Crystalline cohomology, de Rham–Witt and logarithmic foundations, Part II: Witt vector
cohomology of singular varieties).

This file is not the roadmap and it is not exhaustive. The roadmap document
`research/blueprint/readmes/CrystallineCohomologyPartII.md` is definitive. The statements below
suggest Lean forms so that contributors and reviewers converge on names and signatures.

Neither Mathlib (082e2d3) nor Tau Ceti (f790474) has sheaves of Witt vectors on schemes, Witt
schemes of non-perfect schemes, h-sheaves of spectra, rigid cohomology, Hodge–Witt cohomology
with supports or Chow groups with supports. The sheaf-level declarations of the roadmap
(`wittSheaf`, `wittScheme`, `frobeniusInvertedCohomology`, `compactSupport`, `rigidToWitt`,
`hodgeWittCorr`, `IsQuasiResolution`, `HasWORationalSingularities`, `wittZeta`, …) and its
named theorems (h-descent, the Berthelot–Bloch–Esnault comparison, quasi-resolution invariance,
Esnault's theorem, the theta-divisor congruence) are README targets. This file states their
affine incarnations over carriers that exist at the pins — Witt vectors of a ring, Witt ideals,
bounded torsion — and the point-count milestone of Layer WV.6 that Mathlib's multivariate
polynomials can already express. Definitions have real bodies; theorems and tests are proved by
`sorry`.
-/
import Mathlib.RingTheory.WittVector.Basic
import Mathlib.RingTheory.WittVector.Frobenius
import Mathlib.RingTheory.WittVector.Verschiebung
import Mathlib.RingTheory.WittVector.Identities
import Mathlib.RingTheory.WittVector.Teichmuller
import Mathlib.FieldTheory.ChevalleyWarning
import Mathlib.FieldTheory.Perfect
import Mathlib.Algebra.Exact.Basic
import Mathlib.Algebra.Polynomial.Basic
import Mathlib.Data.DFinsupp.Module
import Mathlib.Data.ZMod.Basic

namespace TauCeti.WittCohomology

open WittVector

/-! ### WV.0 — Witt ideals: the sections of `WI` over `Spec A`

`WV.0/witt-sheaf`: for a quasi-coherent ideal `I ⊆ O_X`, `WI = ker (WO_X → W(O_X ⧸ I))` is the
sheaf of Witt vectors all of whose components are sections of `I`. On `Spec A` its sections are
the ideal `wittIdeal p I` of `W(A)`. The sheaf `wittSheaf`, the Witt scheme `W_n X` of an
arbitrary scheme in characteristic `p` and the derived functors of `WI` are README targets. -/

section WittIdeal

variable (p : ℕ) [hp : Fact p.Prime] {A : Type*} [CommRing A]

/-- The Witt ideal of `I`: the kernel of `W(A) → W(A ⧸ I)`, i.e. the Witt vectors whose
components all lie in `I` (sections of `WI` over `Spec A`). -/
noncomputable def wittIdeal (I : Ideal A) : Ideal (WittVector p A) :=
  RingHom.ker (WittVector.map (Ideal.Quotient.mk I))

/-- API `wittSheaf_sections` (characterisation), affine form: membership is componentwise. -/
theorem mem_wittIdeal_iff (I : Ideal A) (x : WittVector p A) :
    x ∈ wittIdeal p I ↔ ∀ n, x.coeff n ∈ I := by
  sorry

/-- `wittSheaf_one` (degenerate), affine form: the Witt ideal of `0` is `0`. -/
example : wittIdeal p (⊥ : Ideal A) = ⊥ := by
  sorry

/-- Degenerate: the Witt ideal of the unit ideal is everything (`W(O_X)` itself). -/
example : wittIdeal p (⊤ : Ideal A) = ⊤ := by
  sorry

/-- API `verschiebung_exact` (relation), affine form: Verschiebung preserves Witt ideals. -/
theorem verschiebung_mem_wittIdeal (I : Ideal A) {x : WittVector p A}
    (hx : x ∈ wittIdeal p I) : verschiebung x ∈ wittIdeal p I := by
  sorry

/-- `wittIdeal_ne_teichmuller_ideal` (non-example): `V[t] = (0, t, 0, …)` lies in the Witt ideal
of `(t) ⊆ F_p[t]`, but not in the ideal generated by the Teichmüller lift `[t]`, whose elements
have second component divisible by `t ^ p`. -/
example :
    verschiebung (teichmuller p (Polynomial.X : Polynomial (ZMod p))) ∈
        wittIdeal p (Ideal.span {(Polynomial.X : Polynomial (ZMod p))}) ∧
      verschiebung (teichmuller p (Polynomial.X : Polynomial (ZMod p))) ∉
        Ideal.span {teichmuller p (Polynomial.X : Polynomial (ZMod p))} := by
  sorry

/-- `WV.0/witt-nil-invariance`, affine form of the key step: if every element of `N` has
vanishing `p ^ c`-th power, then `p ^ c` kills `W(N)` (because `p = V ∘ F` in characteristic `p`
and `F ^ c` kills `W(N)`). Hence `W(N)` is bounded torsion and `W(A) → W(A ⧸ N)` is an
isomorphism in the isogeny convention. -/
theorem pow_mul_eq_zero_of_mem_wittIdeal [CharP A p] (N : Ideal A) (c : ℕ)
    (hN : ∀ a ∈ N, a ^ (p ^ c) = 0) {x : WittVector p A} (hx : x ∈ wittIdeal p N) :
    (p : WittVector p A) ^ c * x = 0 := by
  sorry

/-- `WV.0/witt-universal-homeomorphism-invariance`, affine form of the key step
(Gongyo–Nakamura–Tanaka, proof of Lemma 2.22): if every `p ^ e`-th power of `B` comes from `A`
(as for a finite universal homeomorphism `Spec B → Spec A`), then `p ^ e · W(B) ⊆ W(A)`, so
`W(A) → W(B)` is an isomorphism after inverting `p`. -/
theorem pow_mul_mem_range_map {B : Type*} [CommRing B] [CharP A p] [CharP B p] (f : A →+* B)
    (e : ℕ) (hf : ∀ b : B, ∃ a : A, f a = b ^ (p ^ e)) (y : WittVector p B) :
    (p : WittVector p B) ^ e * y ∈ (WittVector.map f).range := by
  sorry

/-- `frobeniusInverted_perfect_ring` (computation): for a perfect ring the Witt Frobenius is
already bijective, so inverting it changes nothing (Mathlib's `WittVector.frobenius_bijective`). -/
example [CharP A p] [PerfectRing A p] :
    Function.Bijective (WittVector.frobenius : WittVector p A → WittVector p A) :=
  WittVector.frobenius_bijective p A

end WittIdeal

/-! ### WV.0 — bounded torsion: the Serre class of the isogeny convention

`WV.0/rational-witt-sheaves`: `F_ℚ` is the image of a sheaf `F` in the Serre localization of
sheaves of abelian groups at the bounded-torsion sheaves (Mathlib's
`ObjectProperty.SerreClassLocalization`); `R^i f_* (WI_ℚ) = 0` means that one integer kills
`R^i f_* (WI)`. The predicate on abelian groups and its Serre-class closure properties are
stated here; the sheaf-level category is a README target. -/

section BoundedTorsion

/-- An abelian group is bounded torsion if a single positive integer kills it. -/
def IsBoundedTorsion (M : Type*) [AddCommGroup M] : Prop :=
  ∃ n : ℕ, 0 < n ∧ ∀ m : M, n • m = 0

/-- API `boundedTorsion_isSerreClass` (instance), subobjects. -/
theorem IsBoundedTorsion.of_injective {M N : Type*} [AddCommGroup M] [AddCommGroup N]
    (f : M →+ N) (hf : Function.Injective f) (hN : IsBoundedTorsion N) : IsBoundedTorsion M := by
  sorry

/-- API `boundedTorsion_isSerreClass` (instance), quotients. -/
theorem IsBoundedTorsion.of_surjective {M N : Type*} [AddCommGroup M] [AddCommGroup N]
    (f : M →+ N) (hf : Function.Surjective f) (hM : IsBoundedTorsion M) : IsBoundedTorsion N := by
  sorry

/-- API `boundedTorsion_isSerreClass` (instance), extensions: if `M₁ → M₂ → M₃` is exact and
the outer groups are killed by `a` and `b`, the middle one is killed by `a * b`. -/
theorem IsBoundedTorsion.of_exact {M₁ M₂ M₃ : Type*} [AddCommGroup M₁] [AddCommGroup M₂]
    [AddCommGroup M₃] (f : M₁ →+ M₂) (g : M₂ →+ M₃) (hfg : Function.Exact f g)
    (h₁ : IsBoundedTorsion M₁) (h₃ : IsBoundedTorsion M₃) : IsBoundedTorsion M₂ := by
  sorry

/-- Computation: `ℤ ⧸ p ^ n` is bounded torsion. -/
example (p n : ℕ) [NeZero (p ^ n)] : IsBoundedTorsion (ZMod (p ^ n)) := by
  sorry

/-- `isogeny_unbounded_torsion` (non-example): `⊕ₙ ℤ ⧸ p ^ n` is torsion (zero after `⊗ ℚ`)
but not bounded torsion, so it is not zero in the isogeny convention. -/
example (p : ℕ) [Fact p.Prime] : ¬ IsBoundedTorsion (Π₀ n : ℕ, ZMod (p ^ n)) := by
  sorry

/-- Degenerate: the zero group is bounded torsion; `ℤ` is not. -/
example : IsBoundedTorsion PUnit ∧ ¬ IsBoundedTorsion ℤ := by
  sorry

end BoundedTorsion

/-! ### WV.6 — the point-count milestone statable at the pins

`WV.6/low-degree-complete-intersections`: for hypersurfaces of total degree at most `n` in
`P^n_{F_q}`, Witt vector cohomology of the intersection is that of a point, so the number of
projective points is `≡ 1 mod q`. In affine form, for the cone of solutions in `K^σ`
(`(q - 1) · #Z(F_q) + 1` points), and by homogenization for arbitrary polynomials, this is Ax's
divisibility by `q`, which refines Mathlib's Chevalley–Warning theorem (divisibility by `p`). The
projective and singular statements (Esnault's theorem, the theta-divisor congruence, the
congruences for WO-rational singularities) need point counts of schemes and are README targets. -/

section Ax

open MvPolynomial

variable {K σ ι : Type*} [Fintype K] [Field K] [Fintype σ] [DecidableEq σ] [DecidableEq K]

/-- Ax's congruence modulo `q`: if the total degrees of the `f i` sum to less than the number of
variables, the number of common zeros in `K^σ` is divisible by `q = #K`. -/
theorem card_dvd_card_solutions_of_sum_lt {s : Finset ι} {f : ι → MvPolynomial σ K}
    (h : (∑ i ∈ s, (f i).totalDegree) < Fintype.card σ) :
    Fintype.card K ∣ Fintype.card { x : σ → K // ∀ i ∈ s, eval x (f i) = 0 } := by
  sorry

/-- Compatibility with Mathlib's Chevalley–Warning theorem: divisibility by `q` implies
divisibility by the characteristic `p`. -/
example (p : ℕ) [CharP K p] {s : Finset ι} {f : ι → MvPolynomial σ K}
    (h : (∑ i ∈ s, (f i).totalDegree) < Fintype.card σ) :
    p ∣ Fintype.card { x : σ → K // ∀ i ∈ s, eval x (f i) = 0 } :=
  char_dvd_card_solutions_of_sum_lt p h

/-- Computation: a plane conic `x₀² - x₁ x₂` (degree `2 < 3` variables) has `q²` points in `K³`
(the cone over the `q + 1` points of a smooth conic), which `q` divides. -/
example :
    Fintype.card K ∣ Fintype.card
      { x : Fin 3 → K // ∀ i ∈ ({0} : Finset (Fin 1)),
          eval x ((fun _ => X 0 ^ 2 - X 1 * X 2 : Fin 1 → MvPolynomial (Fin 3) K) i) = 0 } := by
  sorry

end Ax

end TauCeti.WittCohomology
