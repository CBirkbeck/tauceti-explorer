/-! ## The elementary layer: q-integers -/

variable {A : Type*} [CommRing A]

/-- HQ.1/what-this-layer-imports-and-what-it-owns. The q-integer `[n]_q`, as the
geometric sum of the first `n` powers of `q`. There is no separate name for this
in Mathlib; the identities below are the interface, and each is already there. -/
def qInt (n : ℕ) (q : A) : A := ∑ i ∈ Finset.range n, q ^ i

@[simp] theorem qInt_zero (q : A) : qInt 0 q = 0 := by simp [qInt]

@[simp] theorem qInt_one (q : A) : qInt 1 q = 1 := by simp [qInt]

/-- `[n]_q * (q - 1) = q ^ n - 1`. This is `geom_sum_mul`. -/
theorem qInt_mul_sub_one (n : ℕ) (q : A) : qInt n q * (q - 1) = q ^ n - 1 :=
  geom_sum_mul q n

/-- `[n]_1 = n`: the specialisation at `q = 1`. -/
@[simp] theorem qInt_at_one (n : ℕ) : qInt n (1 : A) = (n : A) := by
  simp [qInt]

/-- `[p]_q` is the `p`-th cyclotomic polynomial, for `p` prime. This is the
generator of the q-de Rham prism ideal; the prism ideal is NOT `(q - 1)`. -/
theorem qInt_prime_eq_cyclotomic (p : ℕ) (hp : p.Prime) :
    (Polynomial.cyclotomic p A) = ∑ i ∈ Finset.range p, (Polynomial.X : Polynomial A) ^ i :=
  Polynomial.cyclotomic_prime A p (hp := hp)

/-- The prism ideal generator specialises to `p` at `q = 1`, while `q - 1`
specialises to `0`. A unit test separating the two candidate ideals. -/
example (p : ℕ) [Fact p.Prime] : qInt p (1 : ℤ) = (p : ℤ) := by simp

example : ((1 : ℤ) - 1) = 0 := by ring

/-! ## The elementary layer: the Jackson q-difference operator -/

variable (q : A)

/-- HQ.1, imported from PrismaticCohomology PR.6 as a local computation; stated
here as the interface check the stage text asks for. The numerator of the
Jackson operator, `f (q * x) - f x`. The operator itself is this divided by
`(q - 1) * x`, which requires the division to be carried out in the polynomial
ring; the division is exact on monomials and that is the content of
`qDiffNum_X_pow` below. -/
def qDiffNum (f : Polynomial A) : Polynomial A :=
  f.comp (Polynomial.C q * Polynomial.X) - f

@[simp] theorem qDiffNum_C (a : A) : qDiffNum q (Polynomial.C a) = 0 := by
  simp [qDiffNum]

/-- `f (q x) - f (x)` on the `n`-th power of the variable is
`(q ^ n - 1) * x ^ n`, hence `[n]_q * (q - 1) * x ^ n`. -/
theorem qDiffNum_X_pow (n : ℕ) :
    qDiffNum q ((Polynomial.X : Polynomial A) ^ n)
      = Polynomial.C (qInt n q * (q - 1)) * Polynomial.X ^ n := by
  sorry

/-- HQ.1/what-this-layer-imports-and-what-it-owns, the differential-on-powers
formula: after dividing by `(q - 1) * x`, the operator sends `x ^ n` to
`[n]_q * x ^ (n - 1)`. Stated as the divided form, which is what the roadmap
uses. -/
def qDiff (f : Polynomial A) : Polynomial A := by sorry

@[simp] theorem qDiff_X_pow (n : ℕ) :
    qDiff q ((Polynomial.X : Polynomial A) ^ n)
      = Polynomial.C (qInt n q) * Polynomial.X ^ (n - 1) := by sorry

/-- The twisted Leibniz rule: `D_q (f g) = D_q f * g (q x) + f * D_q g`. This is
not the ordinary Leibniz rule, and a definition satisfying the ordinary one
would be wrong. -/
theorem qDiff_mul (f g : Polynomial A) :
    qDiff q (f * g)
      = qDiff q f * g.comp (Polynomial.C q * Polynomial.X) + f * qDiff q g := by sorry

/-- At `q = 1` the operator is the ordinary derivative. -/
theorem qDiff_at_one (f : Polynomial A) : qDiff (1 : A) f = Polynomial.derivative f := by
  sorry

/-- In one variable the induced differential squares to zero for degree reasons;
the general statement is PR.6's and is not re-proved here. -/
example (f : Polynomial A) : True := by trivial

/-- Unit test: a small computed value. -/
example : qDiff (q := (2 : ℤ)) ((Polynomial.X : Polynomial ℤ) ^ 3)
    = Polynomial.C 7 * Polynomial.X ^ 2 := by sorry

/-- Unit test: the degenerate case. -/
example (a : A) : qDiff q (Polynomial.C a) = 0 := by sorry

/-- Unit test: agreement with the nearest Mathlib notion, at `q = 1`. -/
example (n : ℕ) :
    qDiff (1 : A) ((Polynomial.X : Polynomial A) ^ n) = Polynomial.derivative (Polynomial.X ^ n) := by
  sorry

/-- Unit test, a non-example: the operator does NOT satisfy the ordinary Leibniz
rule for `q ≠ 1`, already on `x * x`. -/
example : qDiff (q := (2 : ℤ)) ((Polynomial.X : Polynomial ℤ) * Polynomial.X)
    ≠ qDiff (q := (2 : ℤ)) Polynomial.X * Polynomial.X
      + Polynomial.X * qDiff (q := (2 : ℤ)) Polynomial.X := by sorry

