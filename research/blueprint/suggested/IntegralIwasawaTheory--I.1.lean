import Mathlib

/-!
# IntegralIwasawaTheory, part I.1: representative target signatures

This file is not the roadmap and is not exhaustive. The roadmap document
`research/blueprint/readmes/IntegralIwasawaTheory--I.1.md` is definitive; the statements below
suggest Lean forms so that contributors and reviewers converge on names and signatures.

Only objects whose carriers exist in the pinned Mathlib are given real definitions here:
the cyclotomic Z_p-extension and its layers as fixed fields of explicit subgroups of the
absolute Galois group, the cyclotomic polynomials ω_n, Stickelberger elements of Q(μ_m) at
negative integers, the involution # and the minus quotient of a group ring, and the smoothing
condition on a set of primes. The completed group algebra, Leopoldt's map, the Iwasawa
modules, Stickelberger elements over a general totally real field, Selmer and Ritter–Weiss
modules and the main theorems are README targets: their carriers are not at the pins.

Design choices made explicit:
* the cyclotomic character is Mathlib's `cyclotomicCharacter`, applied to the ring
  automorphisms of `AlgebraicClosure K`;
* the Z_p-extension is the fixed field of the elements whose cyclotomic character is torsion,
  so its layers are indexed by the Z_p-layer n and not by a cyclotomic exponent;
* Stickelberger elements use the inverse-character convention χ(Θ) = L(χ⁻¹, s), i.e. the
  partial zeta value of σ_a is the coefficient of σ_a⁻¹.
-/

open scoped NumberField

namespace IntegralIwasawaTheory

/-! ## Layer I.1: cyclotomic towers and coefficient rings -/

section Tower

variable (K : Type*) [Field K] [NumberField K] (p : ℕ) [Fact p.Prime]

/-- Restriction of `K`-automorphisms of the algebraic closure to ring automorphisms, so that
Mathlib's cyclotomic character can be applied. -/
noncomputable def toRingAut : Field.absoluteGaloisGroup K →* (AlgebraicClosure K ≃+* AlgebraicClosure K) :=
  MonoidHom.mk' (fun σ => σ.toRingEquiv) (fun _ _ => rfl)

/-- The p-adic cyclotomic character of `Gal(K̄/K)`, with values in `ℤ_[p]ˣ`. -/
noncomputable def cyclotomicChar : Field.absoluteGaloisGroup K →* ℤ_[p]ˣ :=
  (cyclotomicCharacter (AlgebraicClosure K) p).comp (toRingAut K)

/-- The elements of `Gal(K̄/K)` whose cyclotomic character is a torsion unit of `ℤ_[p]`. -/
noncomputable def torsionCharSubgroup : Subgroup (Field.absoluteGaloisGroup K) :=
  (CommGroup.torsion ℤ_[p]ˣ).comap (cyclotomicChar K p)

/-- The cyclotomic `ℤ_p`-extension `K_∞`: the fixed field of the elements acting on `μ_{p^∞}`
through a root of unity of `ℤ_p`. -/
noncomputable def cyclotomicZpExtension : IntermediateField K (AlgebraicClosure K) :=
  IntermediateField.fixedField (torsionCharSubgroup K p)

/-- The subgroup cutting out the `n`-th layer: elements whose cyclotomic character is a torsion
unit times a `p^n`-th power of a value of the cyclotomic character. -/
noncomputable def layerSubgroup (n : ℕ) : Subgroup (Field.absoluteGaloisGroup K) :=
  (CommGroup.torsion ℤ_[p]ˣ ⊔ (cyclotomicChar K p).range.map (powMonoidHom (p ^ n))).comap
    (cyclotomicChar K p)

/-- The `n`-th layer `K_n` of the cyclotomic `ℤ_p`-extension, of degree `p^n` over `K`. -/
noncomputable def layer (n : ℕ) : IntermediateField K (AlgebraicClosure K) :=
  IntermediateField.fixedField (layerSubgroup K p n)

/-- `K_∞` is contained in the field generated by the `p`-power roots of unity. -/
theorem cyclotomicZpExtension_le_adjoin :
    cyclotomicZpExtension K p ≤
      IntermediateField.adjoin K {x : AlgebraicClosure K | ∃ n : ℕ, x ^ (p ^ n) = 1} := by
  sorry

/-- Each layer lies in `K_∞`. -/
theorem layer_le_cyclotomicZpExtension (n : ℕ) : layer K p n ≤ cyclotomicZpExtension K p := by
  sorry

/-- The layers increase. -/
theorem layer_mono {m n : ℕ} (h : m ≤ n) : layer K p m ≤ layer K p n := by
  sorry

/-- The `n`-th layer has degree `p^n` over `K`. -/
theorem finrank_layer (n : ℕ) : Module.finrank K (layer K p n) = p ^ n := by
  sorry

/-- The zeroth layer is `K` itself. -/
example : layer K p 0 = ⊥ := by
  sorry

/-- Totally real fields have totally real cyclotomic `ℤ_p`-extensions: complex conjugation has
cyclotomic character `-1`, a torsion unit. -/
theorem layer_isTotallyReal [NumberField.IsTotallyReal K] (n : ℕ) :
    NumberField.IsTotallyReal (layer K p n) := by
  sorry

end Tower

/-- The cyclotomic polynomial `ω_n = (1 + X)^{p^n} - 1`, the image of `γ^{p^n} - 1` in the
coordinate `T = γ - 1`; its ideal is the kernel of the passage to the `n`-th layer. -/
noncomputable def omega (p n : ℕ) [Fact p.Prime] : Polynomial ℤ_[p] :=
  (1 + Polynomial.X) ^ (p ^ n) - 1

/-- `ω_0 = X`, the augmentation element. -/
example (p : ℕ) [Fact p.Prime] : omega p 0 = Polynomial.X := by
  sorry

/-- `ω_n` is distinguished of degree `p^n` at `(p)`. -/
theorem omega_isDistinguishedAt (p n : ℕ) [Fact p.Prime] :
    (omega p n).IsDistinguishedAt (Ideal.span {(p : ℤ_[p])}) := by
  sorry

/-- `ω_1` is not a multiple of `X^p`: the kernel of the passage to the first layer is not `(T^p)`. -/
example (p : ℕ) [Fact p.Prime] : ¬ (Polynomial.X ^ p ∣ omega p 1) := by
  sorry

/-! ## Layer I.3: Stickelberger elements over Q -/

section Stickelberger

/-- The Stickelberger element of `Q(μ_m)/Q` at `s = 1 - k` (`k ≥ 1`), with all primes dividing `m`
removed: the coefficient of `σ_a⁻¹` is the partial zeta value `-m^{k-1} B_k(a/m)/k`, where
`a ∈ {1, …, m-1}` represents the unit class (the convention assumes `m ≥ 2`). -/
noncomputable def stickelbergerRat (m : ℕ) [NeZero m] (k : ℕ) : MonoidAlgebra ℚ (ZMod m)ˣ :=
  ∑ a : (ZMod m)ˣ, MonoidAlgebra.single a⁻¹
    (-(m : ℚ) ^ (k - 1) * (Polynomial.bernoulli k).eval (((a : ZMod m).val : ℚ) / m) / k)

/-- For `m = 3`, `k = 1`: `Θ = (1 - c)/6` with `c = σ_{-1}` complex conjugation. -/
example : stickelbergerRat 3 1 =
    MonoidAlgebra.single 1 (1 / 6 : ℚ) - MonoidAlgebra.single (-1) (1 / 6 : ℚ) := by
  sorry

end Stickelberger

/-! ## Layer I.6: involution, minus parts and the smoothing condition -/

section GroupRing

variable (R : Type*) [CommRing R] (G : Type*) [CommGroup G]

/-- The involution `#` of `R[G]` induced by `g ↦ g⁻¹`. -/
noncomputable def sharp : MonoidAlgebra R G ≃+* MonoidAlgebra R G :=
  MonoidAlgebra.mapDomainRingEquiv R (MulEquiv.inv G)

/-- `#` is an involution. -/
theorem sharp_sharp (x : MonoidAlgebra R G) : sharp R G (sharp R G x) = x := by
  sorry

/-- The integral minus quotient `R[G]⁻ = R[G]/(1 + c)` for a distinguished element `c`
(complex conjugation in the applications). -/
noncomputable abbrev minusRing (c : G) : Type _ :=
  MonoidAlgebra R G ⧸ Ideal.span {MonoidAlgebra.single c (1 : R) + 1}

/-- For `G = (ℤ/3)ˣ` and `c = -1`, the integral minus ring is `ℤ`, with `c ↦ -1`. -/
example : Nonempty (minusRing ℤ (ZMod 3)ˣ (-1) ≃+* ℤ) := by
  sorry

end GroupRing

/-- The smoothing condition of Deligne–Ribet, Cassou-Noguès and Dasgupta–Kakde: no nontrivial
root of unity of `H` is congruent to `1` modulo every prime in `T`. -/
def SmoothingCondition (H : Type*) [Field H] [NumberField H] (T : Finset (Ideal (𝓞 H))) : Prop :=
  ∀ ζ : (𝓞 H)ˣ, IsOfFinOrder ζ → (∀ 𝔭 ∈ T, ((ζ : 𝓞 H) - 1) ∈ 𝔭) → ζ = 1

/-- Over `ℚ`, the set `{(7)}` satisfies the smoothing condition (`-1 ≢ 1 mod 7`). -/
example : SmoothingCondition ℚ {Ideal.span {(7 : 𝓞 ℚ)}} := by
  sorry

/-- Over `ℚ`, the set `{(2)}` does not satisfy it, since `-1 ≡ 1 mod 2`. -/
example : ¬ SmoothingCondition ℚ {Ideal.span {(2 : 𝓞 ℚ)}} := by
  sorry

