import Mathlib.RingTheory.Finiteness.Basic
import Mathlib.LinearAlgebra.Charpoly.Basic
import Mathlib.LinearAlgebra.Prod
import Mathlib.NumberTheory.Padics.PadicIntegers

/-!
# Global shtukas and function-field Langlands: suggested signatures

This file is not the roadmap and is not exhaustive. The definitive document is
`research/blueprint/readmes/GlobalShtukasAndFunctionFieldLanglands.md`.
These statements suggest Lean forms so that contributors and reviewers converge
on names and signatures. They claim no implementation of the roadmap.

The 2026-10-12 shape rule keeps this file to light definitions over existing
carriers, milestones statable at the pins, and a few examples. Algebraic stacks,
Satake coefficients, shtuka cohomology and parameter reconstruction remain exact
README targets: their carriers are not supplied by the pinned libraries.

GS.3: the definition below is the integral stable-module condition of VL 8.20,
abstracted from cohomology to an existing module. `R` is the integral coefficient
ring, not its fraction field. The finite-witness and equivariant-image statements
are the usable interfaces; the actual shtuka application is a README target.
GS.3--GS.4: the monic-recurrence milestone models the finite Frobenius box.
GS.5: the final example distinguishes an ordinary eigenvector from its
simultaneous generalized block without assuming a reduced excursion algebra.
-/

namespace TauCetiRoadmap.GlobalShtukasAndFunctionFieldLanglands

universe u v w z

section IntegralFiniteness

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]
variable {ι : Type w}

/-- Membership in a finitely generated integral submodule stable under every
operator. In the roadmap `R = O_E`; an `E`-finite orbit span is insufficient. -/
def HeckeFinite (T : ι → Module.End R M) (m : M) : Prop :=
  ∃ L : Submodule R M, L.FG ∧ m ∈ L ∧ ∀ i, ∀ x ∈ L, T i x ∈ L

/-- A finite family of Hecke-finite vectors has a common finite stable witness. -/
theorem HeckeFinite.finiteLattice (T : ι → Module.End R M)
    (s : Finset M) (hs : ∀ m ∈ s, HeckeFinite T m) :
    ∃ L : Submodule R M, L.FG ∧ (∀ m ∈ s, m ∈ L) ∧
      ∀ i, ∀ x ∈ L, T i x ∈ L := by
  sorry

/-- The integral witness is transported by a genuinely equivariant linear map. -/
theorem HeckeFinite.map {M' : Type z} [AddCommGroup M'] [Module R M']
    (T : ι → Module.End R M) (T' : ι → Module.End R M')
    (f : M →ₗ[R] M') (hf : ∀ i, f.comp (T i) = (T' i).comp f)
    {m : M} (hm : HeckeFinite T m) : HeckeFinite T' (f m) := by
  sorry

/-- A monic polynomial relation controls all nonnegative iterates by a finite
integral module. This is the one-operator version of the Frobenius-box input. -/
theorem finiteLattice_of_monic_recurrence (T : Module.End R M)
    (P : Polynomial R) (hP : P.Monic) (hPT : Polynomial.aeval T P = 0)
    (m : M) : HeckeFinite (fun _ : Unit => T) m := by
  sorry

-- Degenerate witness: the zero submodule.
example (T : ι → Module.End R M) : HeckeFinite T 0 := by
  sorry

-- Integral scalar operators preserve the cyclic module generated by m.
example (a : ι → R) (m : M) :
    HeckeFinite (fun i => a i • (LinearMap.id : Module.End R M)) m := by
  sorry

-- The familiar characteristic polynomial is already a pinned Mathlib object.
-- The geometric Eichler--Shimura identity itself is a separate README theorem.
example [Module.Free R M] [Module.Finite R M] (T : Module.End R M) :
    Polynomial.aeval T T.charpoly = 0 :=
  LinearMap.aeval_self_charpoly T

end IntegralFiniteness

-- A one-dimensional fraction-field representation can fail integral finiteness.
example (ℓ : ℕ) [Fact ℓ.Prime] :
    ¬ HeckeFinite (R := ℤ_[ℓ])
      (fun _ : Unit => (ℓ : ℚ_[ℓ])⁻¹ • (LinearMap.id : Module.End ℤ_[ℓ] ℚ_[ℓ]))
      (1 : ℚ_[ℓ]) := by
  sorry

section FractionField

variable {R E M : Type*} [CommRing R] [Field E] [Algebra R E]
variable [AddCommGroup M] [Module E M] [Module R M] [IsScalarTower R E M]
variable {ι : Type*}

/-- Commuting fraction-field scalar multiplication rescales a finite witness.
Together with the common-witness theorem this makes the union an E-subspace. -/
theorem HeckeFinite.smul (T : ι → Module.End E M) (a : E) {m : M}
    (hm : HeckeFinite (R := R) (fun i => (T i).restrictScalars R) m) :
    HeckeFinite (R := R) (fun i => (T i).restrictScalars R) (a • m) := by
  sorry

end FractionField

/-- A real endomorphism over an existing carrier, used only for the GS.5
non-example. Its nilpotent part sends (x,y) to (y,0). -/
def jordan : Module.End ℚ (ℚ × ℚ) :=
  LinearMap.id + (LinearMap.inl ℚ ℚ ℚ).comp (LinearMap.snd ℚ ℚ ℚ)

-- (0,1) is generalized for eigenvalue 1, but is not an eigenvector.
example :
    ((jordan - 1) ^ 2 : Module.End ℚ (ℚ × ℚ)) (0, 1) = 0 ∧ (jordan - 1 : Module.End ℚ (ℚ × ℚ)) (0, 1) ≠ 0 := by
  sorry

end TauCetiRoadmap.GlobalShtukasAndFunctionFieldLanglands
