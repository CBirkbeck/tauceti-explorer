/-- Unit test `TauCeti.QHodge.SmoothDimInv.fibre_one_full`: over `⟨1⟩` condition (b) is vacuous, so
the fibre is the full subcategory `Sm_{A[dim!^{-1}]}`. -/
example (S : CommAlgCat.{u} A) : SmoothDimInv.admissible [S] [S] some ↔ SmoothDimInv S :=
  SmoothDimInv.fibre_one S

/-- Unit test `TauCeti.QHodge.SmoothDimInv.not_full`: the full sub-operad spanned by
