/-! ## HQ.1 — The global q-de Rham complex (Appendix A of the source)

Appendix A works over a Λ-ring `A` that is `p`-torsion free for every prime `p`. Nothing in
this section assumes that `A` is perfectly covered; that hypothesis enters in HQ.3. -/

section HQ1

/-! ### Imported algebraic interfaces: Λ-rings and δ-structures -/

/-- **Owner: HabiroRings HR.1** (`LambdaRing`, node HR.1/lambda-rings-with-commuting-adams-operations).
A Λ-structure in Wilkerson's form: Adams operations `ψ^n` for `n ≥ 1` with `ψ^1 = id`,
`ψ^{mn} = ψ^m ∘ ψ^n` (so the operations commute) and the Frobenius congruence
`ψ^p(a) ≡ a^p mod p`. On a ring that is `p`-torsion free for every `p` (the hypothesis of
Theorem A.1, recorded separately by `PTorsionFreeAll`) this is equivalent to a Λ-structure. -/
structure LambdaRing (A : Type u) [CommRing A] where
  /-- The Adams operation `ψ^n`. -/
  adams : ℕ+ → A →+* A
  adams_one : adams 1 = RingHom.id A
  /-- The composition law, which also gives the commutation of the operations. -/
  adams_mul : ∀ m n : ℕ+, adams (m * n) = (adams m).comp (adams n)
  /-- The Frobenius congruence at each prime. -/
  frobCongruence : ∀ (p : ℕ) (hp : p.Prime) (a : A), (p : A) ∣ adams ⟨p, hp.pos⟩ a - a ^ p

/-- The hypothesis of Theorem A.1: `A` is `p`-torsion free for every prime `p`. -/
def PTorsionFreeAll (A : Type u) [CommRing A] : Prop :=
  ∀ p : ℕ, p.Prime → IsSMulRegular A (p : A)

/-- `ψ^p` for a prime `p`. -/
def LambdaRing.psi {A : Type u} [CommRing A] (Λ : LambdaRing A) (p : Nat.Primes) : A →+* A :=
  Λ.adams ⟨p, p.2.pos⟩

/-- A map of Λ-rings: a ring map commuting with every Adams operation. -/
def LambdaRing.IsHom {A A' : Type u} [CommRing A] [CommRing A'] (Λ : LambdaRing A)
    (Λ' : LambdaRing A') (f : A →+* A') : Prop :=
  ∀ n : ℕ+, f.comp (Λ.adams n) = (Λ'.adams n).comp f

/-- **Owner: HabiroRings HR.1** (`IsPerfectlyCovered`, in its description
`IsPerfectlyCovered.flat_adams`): every Adams operation is faithfully flat. Used from HQ.3 on. -/
def LambdaRing.IsPerfectlyCovered {A : Type u} [CommRing A] (Λ : LambdaRing A) : Prop :=
  ∀ n : ℕ+, (Λ.adams n).FaithfullyFlat

/-- **Owner: PrismaticCohomology PR.0.** A δ-structure at the prime `p` on a commutative ring,
with the two defining identities written out. -/
structure DeltaStructure (p : ℕ) (R : Type*) [CommRing R] where
  /-- The map `δ`. -/
  δ : R → R
  δ_zero : δ 0 = 0
  δ_one : δ 1 = 0
  δ_add : ∀ x y, δ (x + y) =
    δ x + δ y - ∑ i ∈ Finset.Ioo 0 p, ((p.choose i / p : ℕ) : R) * x ^ i * y ^ (p - i)
  δ_mul : ∀ x y, δ (x * y) = x ^ p * δ y + y ^ p * δ x + p * δ x * δ y

/-- The Frobenius lift `φ(x) = x^p + p δ(x)` of a δ-structure. -/
def DeltaStructure.frob {p : ℕ} {R : Type*} [CommRing R] (Δ : DeltaStructure p R) (x : R) : R :=
  x ^ p + p * Δ.δ x

/-! ### The executable layer: q-integers

Node HQ.1/what-this-layer-imports-and-what-it-owns. The identities below are the pinned
Mathlib's (`geom_sum_mul`, `Polynomial.cyclotomic_prime`, `Polynomial.eval_one_cyclotomic_prime`,
`Polynomial.cyclotomic_prime_pow_eq_geom_sum`, `Polynomial.prod_cyclotomic_eq_geom_sum`), restated
for `qInt`. -/

variable {A : Type u} [CommRing A]

/-- The q-integer `[n]_q = 1 + q + ⋯ + q^{n-1}`. -/
def qInt (n : ℕ) (q : A) : A := ∑ i ∈ Finset.range n, q ^ i

@[simp] theorem qInt_zero (q : A) : qInt 0 q = 0 := by simp [qInt]

@[simp] theorem qInt_one (q : A) : qInt 1 q = 1 := by simp [qInt]

/-- `[n]_q (q - 1) = q^n - 1` (`geom_sum_mul`). -/
theorem qInt_mul_sub_one (n : ℕ) (q : A) : qInt n q * (q - 1) = q ^ n - 1 :=
  geom_sum_mul q n

/-- `[n]_1 = n`. -/
@[simp] theorem qInt_at_one (n : ℕ) : qInt n (1 : A) = n := by simp [qInt]

/-- `[p]_q = Φ_p(q)` for `p` prime: the generator of the q-de Rham prism ideal. -/
theorem qInt_prime_eq_cyclotomic (p : ℕ) (hp : p.Prime) :
    qInt p (X : A[X]) = cyclotomic p A := by
  have := Fact.mk hp
  exact (cyclotomic_prime A p).symm

/-- `[p^k]_q = Φ_p(q) Φ_{p^2}(q) ⋯ Φ_{p^k}(q)` (`Polynomial.prod_cyclotomic_eq_geom_sum`). -/
theorem qInt_prime_pow (p k : ℕ) (hp : p.Prime) :
    qInt (p ^ k) (X : A[X]) = ∏ j ∈ Finset.Icc 1 k, cyclotomic (p ^ j) A := by
  sorry

/-- `Φ_{p^{k+1}}(q) = [p]_{q^{p^k}}`, which is not `[p^{k+1}]_q`
(`Polynomial.cyclotomic_prime_pow_eq_geom_sum`). -/
theorem cyclotomic_prime_pow_eq_qInt (p k : ℕ) (hp : p.Prime) :
    cyclotomic (p ^ (k + 1)) A = qInt p ((X : A[X]) ^ p ^ k) := by
  rw [cyclotomic_prime_pow_eq_geom_sum hp]
  rfl

/-- The prism ideal `([p]_q)` and the q-PD ideal `(q - 1)` are different: at `q = 1` the first
generator specialises to `p`, the second to `0` (`Polynomial.eval_one_cyclotomic_prime`). -/
theorem qInt_prime_eval_one (p : ℕ) (hp : p.Prime) :
    (qInt p (X : A[X])).eval 1 = p ∧ ((X : A[X]) - 1).eval 1 = 0 := by
  have := Fact.mk hp
  rw [qInt_prime_eq_cyclotomic p hp, eval_one_cyclotomic_prime]
  simp

/-! ### The executable layer: the Jackson q-derivative and the q-Hodge differential -/

/-- The Jackson q-derivative on `A[X]`, defined by its values `x^n ↦ [n]_q x^{n-1}`. -/
def qDiff (q : A) (f : A[X]) : A[X] :=
  f.sum fun n a => C (a * qInt n q) * X ^ (n - 1)

@[simp] theorem qDiff_X_pow (q : A) (n : ℕ) :
    qDiff q ((X : A[X]) ^ n) = C (qInt n q) * X ^ (n - 1) := by
  rw [qDiff, X_pow_eq_monomial, sum_monomial_index] <;> simp

@[simp] theorem qDiff_C (q a : A) : qDiff q (C a) = 0 := by
  rw [qDiff, ← monomial_zero_left, sum_monomial_index] <;> simp

/-- The Jackson operator is the divided difference: `f(qx) - f(x) = (q - 1) x D_q f`. -/
theorem qDiff_comp_sub (q : A) (f : A[X]) :
    f.comp (C q * X) - f = C (q - 1) * X * qDiff q f := by
  sorry

/-- The twisted Leibniz rule `D_q(fg) = D_q(f) g(qx) + f D_q(g)`. -/
theorem qDiff_mul (q : A) (f g : A[X]) :
    qDiff q (f * g) = qDiff q f * g.comp (C q * X) + f * qDiff q g := by
  sorry

/-- At `q = 1` the Jackson operator is `Polynomial.derivative`. -/
theorem qDiff_at_one (f : A[X]) : qDiff (1 : A) f = derivative f := by
  rw [qDiff, derivative_apply]
  simp [qInt_at_one]

/-- The q-Hodge differential `(q - 1) D_q` of the coordinate q-Hodge complex in one variable. -/
def qHodgeDiff (q : A) (f : A[X]) : A[X] := C (q - 1) * qDiff q f

/-- `x^n ↦ (q^n - 1) x^{n-1}`. -/
theorem qHodgeDiff_X_pow (q : A) (n : ℕ) :
    qHodgeDiff q ((X : A[X]) ^ n) = C (q ^ n - 1) * X ^ (n - 1) := by
  rw [qHodgeDiff, qDiff_X_pow, ← mul_assoc, ← C_mul, mul_comm (q - 1), qInt_mul_sub_one]

/-- The q-Hodge differential vanishes at `q = 1`. -/
theorem qHodgeDiff_at_one (f : A[X]) : qHodgeDiff (1 : A) f = 0 := by
  simp [qHodgeDiff]

example : qHodgeDiff (2 : ℤ) (X : ℤ[X]) = C 1 := by
  simpa using qHodgeDiff_X_pow (2 : ℤ) 1

/-! ### Koszul complexes of commuting endomorphisms (node HQ.1/the-koszul-twist-isomorphism)

The Koszul complex of commuting endomorphisms is imported from AInfCohomology AI.1; it is
written out here because its twist lemma is a concrete statement about abelian groups. -/

section Koszul

variable {M : Type*} [AddCommGroup M] {d : ℕ}

/-- The Koszul complex `Kos*(M; g₁, …, g_d)`, as the graded group `Finset (Fin d) → M` (the summand
indexed by `I` sits in degree `|I|`) with its differential
`(dx)_J = ∑_{j ∈ J} (-1)^{#{i ∈ J | i < j}} g_j (x_{J \ {j}})`. -/
def koszulDiff (g : Fin d → AddMonoid.End M) : AddMonoid.End (Finset (Fin d) → M) where
  toFun x J := ∑ j ∈ J, ((-1 : ℤ) ^ (J.filter (· < j)).card) • g j (x (J.erase j))
  map_zero' := by ext; simp
  map_add' x y := by ext; simp [Finset.sum_add_distrib, smul_add]

/-- `d ∘ d = 0` for commuting endomorphisms. -/
theorem koszulDiff_sq (g : Fin d → AddMonoid.End M) (hg : ∀ i j, Commute (g i) (g j)) :
    koszulDiff g * koszulDiff g = 0 := by
  sorry

/-- The twist `h_I = ∏_{i ∈ I} h_i` on the summand indexed by `I`. -/
def koszulTwist (h : Fin d → AddMonoid.End M) : AddMonoid.End (Finset (Fin d) → M) where
  toFun x J := (((J.sort).map h).prod) (x J)
  map_zero' := by ext; simp
  map_add' x y := by ext; simp

/-- **Lemma (HQ.1/the-koszul-twist-isomorphism, paragraph A.8).** Let `g_i` be commuting
endomorphisms and `h_i` commuting automorphisms of an abelian group, with `h_i` commuting with
`g_j` for `i ≠ j` (and NOT necessarily with `g_i`). Then the `h_i g_i` commute, and `h_I` on the
summand indexed by `I` is an isomorphism of Koszul complexes
`Kos*(M; g) ≅ Kos*(M; h g)`. -/
theorem koszul_twist (g h : Fin d → AddMonoid.End M) (hg : ∀ i j, Commute (g i) (g j))
    (hh : ∀ i j, Commute (h i) (h j)) (hbij : ∀ i, Function.Bijective (h i))
    (hgh : ∀ i j, i ≠ j → Commute (h i) (g j)) :
    (∀ i j, Commute (h i * g i) (h j * g j)) ∧
      koszulDiff (fun i => h i * g i) * koszulTwist h = koszulTwist h * koszulDiff g ∧
      Function.Bijective (koszulTwist h) := by
  sorry

end Koszul

/-! ### The coordinate-dependent q-de Rham complex
(node HQ.1/the-coordinate-dependent-q-de-rham-complex)

`S⟦q-1⟧` is `PowerSeries S`, whose variable is `q - 1`; so `q = 1 + X`. -/

/-- An étale framing `□ : A[x_1, …, x_d] → S`. -/
structure EtaleFraming (A : Type u) [CommRing A] (S : Type u) [CommRing S] [Algebra A S]
    (d : ℕ) where
  /-- The framing map. -/
  toAlgHom : MvPolynomial (Fin d) A →ₐ[A] S
  /-- It is étale. -/
  etale : @Algebra.Etale (MvPolynomial (Fin d) A) S _ _ toAlgHom.toRingHom.toAlgebra

namespace EtaleFraming

variable {S : Type u} [CommRing S] [Algebra A S] {d : ℕ}

/-- The coordinate `x_i ∈ S`. -/
def coord (F : EtaleFraming A S d) (i : Fin d) : S := F.toAlgHom (MvPolynomial.X i)

/-- The identity framing of `A[x_1, …, x_d]`. -/
def polyId (A : Type u) [CommRing A] (d : ℕ) : EtaleFraming A (MvPolynomial (Fin d) A) d :=
  ⟨AlgHom.id A _, sorry⟩

/-- The partial derivative `∂_i` on `S`: the unique `A`-derivation extending `∂/∂x_i` along the
étale framing. -/
def partialDeriv (F : EtaleFraming A S d) (i : Fin d) : Derivation A S S := sorry

theorem partialDeriv_toAlgHom (F : EtaleFraming A S d) (i : Fin d) (f : MvPolynomial (Fin d) A) :
    F.partialDeriv i (F.toAlgHom f) = F.toAlgHom (MvPolynomial.pderiv i f) := by
  sorry

end EtaleFraming

namespace qOmegaFramed

variable {S : Type u} [CommRing S] [Algebra A S] {d : ℕ}

/-- API `qOmegaFramed.gamma`: the automorphism `γ_i` of `S⟦q-1⟧` over `A⟦q-1⟧` with
`γ_i(x_i) = q x_i`, `γ_i(x_j) = x_j` for `j ≠ i`, the identity modulo `q - 1`. It exists and is
unique because `S` is étale over `A[x_1, …, x_d]` and `S⟦q-1⟧` is `(q-1)`-complete. -/
def gamma (F : EtaleFraming A S d) (i : Fin d) : PowerSeries S ≃+* PowerSeries S := sorry

theorem gamma_coord (F : EtaleFraming A S d) (i : Fin d) :
    gamma F i (PowerSeries.C (F.coord i)) = (1 + PowerSeries.X) * PowerSeries.C (F.coord i) := by
  sorry

theorem gamma_coord_ne (F : EtaleFraming A S d) {i j : Fin d} (h : j ≠ i) :
    gamma F i (PowerSeries.C (F.coord j)) = PowerSeries.C (F.coord j) := by
  sorry

/-- `γ_i` is `A⟦q-1⟧`-linear. -/
theorem gamma_map (F : EtaleFraming A S d) (i : Fin d) (a : PowerSeries A) :
    gamma F i (PowerSeries.map (algebraMap A S) a) = PowerSeries.map (algebraMap A S) a := by
  sorry

/-- `γ_i` is the identity modulo `q - 1`. -/
theorem gamma_constantCoeff (F : EtaleFraming A S d) (i : Fin d) (f : PowerSeries S) :
    PowerSeries.constantCoeff (gamma F i f) = PowerSeries.constantCoeff f := by
  sorry

/-- `γ_i ≡ id` modulo `x_i`. -/
theorem gamma_sub_mem (F : EtaleFraming A S d) (i : Fin d) (f : PowerSeries S) :
    ∃ g, gamma F i f - f = PowerSeries.C (F.coord i) * g := by
  sorry

theorem gamma_comm (F : EtaleFraming A S d) (i j : Fin d) (f : PowerSeries S) :
    gamma F i (gamma F j f) = gamma F j (gamma F i f) := by
  sorry

/-- API `qOmegaFramed.qPartial`: `q∂_i = (γ_i - 1)/((q - 1) x_i)`, an `A⟦q-1⟧`-linear
endomorphism of `S⟦q-1⟧` (characterised by `qPartial_spec`). -/
def qPartial (F : EtaleFraming A S d) (i : Fin d) : AddMonoid.End (PowerSeries S) := sorry

theorem qPartial_spec (F : EtaleFraming A S d) (i : Fin d) (f : PowerSeries S) :
    PowerSeries.X * PowerSeries.C (F.coord i) * qPartial F i f = gamma F i f - f := by
  sorry

theorem qPartial_map (F : EtaleFraming A S d) (i : Fin d) (a : PowerSeries A) (f : PowerSeries S) :
    qPartial F i (PowerSeries.map (algebraMap A S) a * f) =
      PowerSeries.map (algebraMap A S) a * qPartial F i f := by
  sorry

/-- API `qOmegaFramed.qPartial_X_pow`: `q∂_i(x_i^n) = [n]_q x_i^{n-1}` and `q∂_i(x_j) = 0`
for `j ≠ i`. -/
theorem qPartial_X_pow (F : EtaleFraming A S d) (i : Fin d) (n : ℕ) :
    qPartial F i (PowerSeries.C (F.coord i ^ n)) =
        qInt n (1 + PowerSeries.X) * PowerSeries.C (F.coord i ^ (n - 1)) ∧
      ∀ j, j ≠ i → qPartial F i (PowerSeries.C (F.coord j)) = 0 := by
  sorry

/-- API `qOmegaFramed.qPartial_mul`: the twisted Leibniz rule. -/
theorem qPartial_mul (F : EtaleFraming A S d) (i : Fin d) (f g : PowerSeries S) :
    qPartial F i (f * g) = qPartial F i f * gamma F i g + f * qPartial F i g := by
  sorry

/-- API `qOmegaFramed.qPartial_comm`. -/
theorem qPartial_comm (F : EtaleFraming A S d) (i j : Fin d) : Commute (qPartial F i) (qPartial F j) := by
  sorry

/-- API `qOmegaFramed.modQSubOne`: modulo `q - 1`, `q∂_i` reduces to `∂_i`, so the complex
reduces to the de Rham complex `Ω*_{S/A}` (a free `S`-module on the `dx_I`). -/
theorem modQSubOne (F : EtaleFraming A S d) (i : Fin d) (f : PowerSeries S) :
    PowerSeries.constantCoeff (qPartial F i f) =
      F.partialDeriv i (PowerSeries.constantCoeff f) := by
  sorry

end qOmegaFramed

/-- **Construction (HQ.1/the-coordinate-dependent-q-de-rham-complex).** The coordinate-dependent
q-de Rham complex `qΩ*_{S/A,□}`: the Koszul complex of the commuting operators `q∂_i` on
`S⟦q-1⟧`, i.e. `S⟦q-1⟧ → Ω¹⟦q-1⟧ → ⋯ → Ω^d⟦q-1⟧` with `q∇ = ∑ q∂_i dx_i` (the summand
`dx_I` sits in degree `|I|`). It depends on the framing. -/
def qOmegaFramed {S : Type u} [CommRing S] [Algebra A S] {d : ℕ} (F : EtaleFraming A S d) :
    AddMonoid.End (Finset (Fin d) → PowerSeries S) :=
  koszulDiff (qOmegaFramed.qPartial F)

theorem qOmegaFramed_sq {S : Type u} [CommRing S] [Algebra A S] {d : ℕ}
    (F : EtaleFraming A S d) : qOmegaFramed F * qOmegaFramed F = 0 :=
  koszulDiff_sq _ (qOmegaFramed.qPartial_comm F)

/-- **Owner: PrismaticCohomology PR.6.** The p-complete framed complex of `Ŝ_p` over `Â_p`
(Bhatt–Scholze Construction 16.20; it computes q-crystalline cohomology, Theorem 16.22): the
p-completion `S → Ŝ_p` and the operators `q∂_i` on `Ŝ_p⟦q-1⟧`. -/
structure PCompleteFramedComplex (p : ℕ) {S : Type u} [CommRing S] [Algebra A S] {d : ℕ}
    (F : EtaleFraming A S d) where
  /-- `Ŝ_p`. -/
  Sp : Type u
  [ring : CommRing Sp]
  /-- The completion map. -/
  toSp : S →+* Sp
  complete : IsAdicComplete (Ideal.span {(p : Sp)}) Sp
  /-- The p-complete operators `q∂_i`. -/
  qPartialP : Fin d → AddMonoid.End (PowerSeries Sp)

attribute [instance] PCompleteFramedComplex.ring

/-- API `qOmegaFramed.pCompletion`: the p-completion of `qΩ*_{S/A,□}` is the p-complete framed
complex of PR.6: the completion map intertwines the operators `q∂_i`. -/
theorem qOmegaFramed.pCompletion {p : ℕ} {S : Type u} [CommRing S] [Algebra A S] {d : ℕ}
    {F : EtaleFraming A S d} (P : PCompleteFramedComplex p F) (i : Fin d) (f : PowerSeries S) :
    P.qPartialP i (PowerSeries.map P.toSp f) =
      PowerSeries.map P.toSp (qOmegaFramed.qPartial F i f) := by
  sorry

/-- Unit test `qOmegaFramed_polynomial`: for `A = ℤ`, `S = ℤ[x]` and the identity framing,
`x^n ↦ [n]_q x^{n-1} dx`; for instance `x^3 ↦ (1 + q + q^2) x^2 dx`, which is `7 x^2 dx` at
`q = 2` (the Jackson operator is the specialisation of `q∂` at a value of `q`). -/
example (n : ℕ) :
    qOmegaFramed.qPartial (EtaleFraming.polyId ℤ 1) 0
        (PowerSeries.C (MvPolynomial.X 0 ^ n)) =
      qInt n (1 + PowerSeries.X) * PowerSeries.C (MvPolynomial.X 0 ^ (n - 1)) ∧
    qDiff (2 : ℤ) ((X : ℤ[X]) ^ 3) = C 7 * X ^ 2 := by
  sorry

/-- Unit test `qOmegaFramed_etale`: for `d = 0` (`S` étale over `A`, empty framing) the complex
is `S⟦q-1⟧` in degree zero: the differential vanishes. -/
example {S : Type u} [CommRing S] [Algebra A S] (F : EtaleFraming A S 0) :
    qOmegaFramed F = 0 := by
  sorry

/-- Unit test `qOmegaFramed_modQSubOne`: modulo `q - 1` the differential is the de Rham
differential; for `S = A[x]`, `x^n ↦ n x^{n-1} dx`. -/
example (n : ℕ) :
    PowerSeries.constantCoeff
        (qOmegaFramed.qPartial (EtaleFraming.polyId A 1) 0
          (PowerSeries.C (MvPolynomial.X 0 ^ n))) =
      (n : MvPolynomial (Fin 1) A) * MvPolynomial.X 0 ^ (n - 1) ∧
    qDiff (1 : A) ((X : A[X]) ^ n) = C (n : A) * X ^ (n - 1) := by
  sorry

/-- Unit test `qOmegaFramed_not_leibniz`: the ordinary Leibniz rule fails:
`q∂(x·x) = (1 + q) x` while `x q∂(x) + q∂(x) x = 2x`; the twisted rule
`q∂(x·x) = q∂(x) γ(x) + x q∂(x)` holds. Checked at `q = 2` with the Jackson operator. -/
example :
    qDiff (2 : ℤ) ((X : ℤ[X]) * X) ≠ qDiff 2 X * X + X * qDiff 2 X ∧
    qDiff (2 : ℤ) ((X : ℤ[X]) * X) = qDiff 2 X * (X : ℤ[X]).comp (C 2 * X) + X * qDiff 2 X := by
  sorry

/-! ### The uniform denominator (node HQ.1/a-denominator-bound-uniform-in-the-prime) -/

/-- The exponent `2 (p^{i-1} + ⋯ + p + 1)` of the denominators in Lemma A.6. -/
def divExp (p i : ℕ) : ℕ := 2 * ∑ k ∈ Finset.range i, p ^ k

/-- `N_n = ∏_{ℓ ≤ n prime} ℓ^{2(ℓ^{n-1} + ⋯ + ℓ + 1)}`; `N_0 = N_1 = 1`. It does not depend on `p`. -/
def uniformDenominator (n : ℕ) : ℕ :=
  ∏ ℓ ∈ (Finset.range (n + 1)).filter Nat.Prime, ℓ ^ divExp ℓ n

/-- Superadditivity of the p-exponent, used to pass from single iterated divided powers to
products. -/
theorem divExp_add_le {p : ℕ} (hp : 1 ≤ p) (a b : ℕ) :
    divExp p a + divExp p b ≤ divExp p (a + b) := by
  sorry

/-- Every denominator `p^{divExp p i}` with `p ≤ n` and `i ≤ n` divides `N_n`; primes `p > n`
contribute nothing. -/
theorem pow_divExp_dvd_uniformDenominator {p n i : ℕ} (hp : p.Prime) (hpn : p ≤ n) (hi : i ≤ n) :
    p ^ divExp p i ∣ uniformDenominator n := by
  sorry

example : uniformDenominator 1 = 1 := by decide

example : uniformDenominator 2 = 64 := by decide

example : uniformDenominator 3 = 2 ^ 14 * 3 ^ 26 := by decide

/-! ### Envelopes: the ring-level content of Lemmas A.4 to A.6, Remark A.7 and paragraph A.9 -/

/-- **Owners: CrystallineCohomology CR.0** (PD envelopes, their p-completions and functoriality),
**PrismaticCohomology PR.6** (q-PD envelopes, q-divided powers, Bhatt–Scholze §16) **and PR.0**
(the unique extension of δ-structures along localisations and completions, Bhatt–Scholze
Lemmas 2.15 and 2.17). The data of the proof of Lemma A.4 at one prime `p`: a surjection `P ↠ S`
from a p-completely ind-smooth δ-`Â_p`-algebra with kernel `J`; the p-completed PD envelope `D`
with its divided powers; the q-PD envelope `qD`, flat over `ℤ_p⟦q-1⟧`; and the rationalised
`(q-1)`-completion `qDQ = (qD ⊗ ℚ)^∧_{(q-1)}` with the extended δ-structure, in which `p` and
`[p]_q` are units. -/
structure QPDEnvelope (p : ℕ) where
  /-- The ind-smooth δ-algebra `P`. -/
  P : Type u
  [instP : CommRing P]
  /-- The kernel of `P ↠ S`. -/
  J : Ideal P
  /-- The p-completed PD envelope. -/
  D : Type u
  [instD : CommRing D]
  toD : P →+* D
  /-- The PD ideal of `D`. -/
  pdIdeal : Ideal D
  dividedPowers : DividedPowers pdIdeal
  map_J_le : J.map toD ≤ pdIdeal
  /-- The q-PD envelope. -/
  qD : Type u
  [instqD : CommRing qD]
  toqD : P →+* qD
  /-- The parameter `q`. -/
  q : qD
  /-- `qD` is flat over `ℤ_p⟦q-1⟧`, in particular p-torsion free. -/
  pTorsionFree : IsSMulRegular qD (p : qD)
  /-- `(qD ⊗ ℚ)^∧_{(q-1)}`. -/
  qDQ : Type u
  [instqDQ : CommRing qDQ]
  ofqD : qD →+* qDQ
  ofqD_injective : Function.Injective ofqD
  /-- The unique extension of the δ-structure of `qD` (with `δ(q) = 0`). -/
  delta : DeltaStructure p qDQ
  delta_ofqD : ∀ x : qD, ∃ y : qD, delta.δ (ofqD x) = ofqD y
  p_isUnit : IsUnit (p : qDQ)
  qInt_isUnit : IsUnit (qInt p (ofqD q))

attribute [instance] QPDEnvelope.instP QPDEnvelope.instD QPDEnvelope.instqD QPDEnvelope.instqDQ

namespace QPDEnvelope

variable {p : ℕ} (E : QPDEnvelope.{u} p)

/-- `γ_q(x) = φ(x)/[p]_q - δ(x)`, defined on all of `qDQ`. -/
def gammaQ (x : E.qDQ) : E.qDQ :=
  E.delta.frob x * ↑E.qInt_isUnit.unit⁻¹ - E.delta.δ x

/-- `p⁻¹ ∈ qDQ`. -/
def pInv : E.qDQ := ↑E.p_isUnit.unit⁻¹

/-- `y` admits (iterated) q-divided powers in `qD`. -/
def AdmitsQDividedPowers (y : E.qD) : Prop :=
  ∀ n : ℕ, ∃ z : E.qD, E.gammaQ^[n] (E.ofqD y) = E.ofqD z

/-- **Lemma (HQ.1/delta-and-q-divided-power-denominator-estimates, Lemma A.5).** For `n, α ≥ 1`:
(a) `δ` maps `(q-1)^n qD` into itself and `p^{-α}(q-1)^n qD` into `p^{-(pα+1)}(q-1)^n qD`;
(b) `γ_q` maps `(q-1)^n qD` into `(q-1)^{n+1} qD` and `p^{-α}(q-1)^n qD` into
`p^{-(pα+1)}(q-1)^{n+1} qD`. -/
theorem delta_gammaQ_estimates (n α : ℕ) (hn : 1 ≤ n) (hα : 1 ≤ α) :
    (∀ x : E.qD, ∃ y : E.qD,
      E.delta.δ ((E.ofqD E.q - 1) ^ n * E.ofqD x) = (E.ofqD E.q - 1) ^ n * E.ofqD y) ∧
    (∀ x : E.qD, ∃ y : E.qD,
      E.delta.δ (E.pInv ^ α * (E.ofqD E.q - 1) ^ n * E.ofqD x) =
        E.pInv ^ (p * α + 1) * (E.ofqD E.q - 1) ^ n * E.ofqD y) ∧
    (∀ x : E.qD, ∃ y : E.qD,
      E.gammaQ ((E.ofqD E.q - 1) ^ n * E.ofqD x) = (E.ofqD E.q - 1) ^ (n + 1) * E.ofqD y) ∧
    (∀ x : E.qD, ∃ y : E.qD,
      E.gammaQ (E.pInv ^ α * (E.ofqD E.q - 1) ^ n * E.ofqD x) =
        E.pInv ^ (p * α + 1) * (E.ofqD E.q - 1) ^ (n + 1) * E.ofqD y) := by
  sorry

/-- **Lemma (HQ.1/divided-power-denominators-in-the-q-pd-envelope, Lemma A.6).** For `x ∈ J`
and `n ≥ 1` there are `y_0, …, y_n ∈ qD`, with `y_0` admitting q-divided powers, such that in
`qD ⊗ ℚ = qD[1/p]`,
`γ^{(n)}(x) = y_0 + ∑_{i=1}^n p^{-2(p^{i-1}+⋯+1)} (q-1)^{(p-2)+i} y_i`, where `γ(z) = z^p/p`. -/
theorem iterate_dividedPower_expansion (x : E.P) (hx : x ∈ E.J) (n : ℕ) (hn : 1 ≤ n) :
    ∃ y : ℕ → E.qD, E.AdmitsQDividedPowers (y 0) ∧
      (fun z : Localization.Away (p : E.qD) => IsLocalization.Away.invSelf (p : E.qD) * z ^ p)^[n]
          (algebraMap E.qD _ (E.toqD x)) =
        algebraMap E.qD _ (y 0) +
          ∑ i ∈ Finset.Icc 1 n, IsLocalization.Away.invSelf (p : E.qD) ^ divExp p i *
            algebraMap E.qD _ ((E.q - 1) ^ (p - 2 + i) * y i) := by
  sorry

/-- The ring-level form of Lemma A.4: `(qD ⊗ ℚ)^∧_{(q-1)} ≅ (D ⊗ ℚ)⟦q-1⟧`, the identity on `P`
and sending `q` to `1 + (q - 1)`. -/
def envelopeComparison : E.qDQ ≃+* PowerSeries (Localization.Away (p : E.D)) := sorry

theorem envelopeComparison_toqD (x : E.P) :
    E.envelopeComparison (E.ofqD (E.toqD x)) = PowerSeries.C (algebraMap E.D _ (E.toD x)) := by
  sorry

theorem envelopeComparison_q : E.envelopeComparison (E.ofqD E.q) = 1 + PowerSeries.X := by
  sorry

/-- `∑_{i ≥ 1} u^{2(p^{i-1}+⋯+1)} (q-1)^{(p-2)+i} y_i`, a `(q-1)`-adically convergent series. -/
def denominatorSeries (p : ℕ) {R : Type*} [CommRing R] (u : R) (y : ℕ → R) : PowerSeries R :=
  PowerSeries.mk fun k => if p - 2 < k then u ^ divExp p (k - (p - 2)) * y (k - (p - 2)) else 0

/-- **Lemma (HQ.1/the-reverse-divided-power-expansion, Remark A.7).** (a) For `x ∈ J` and
`n ≥ 1` there are `y_0, y_1, … ∈ D` with `y_0` in the PD ideal such that, computing `γ_q` in
`(D ⊗ ℚ)⟦q-1⟧` through Lemma A.4, `γ_q^{(n)}(x) = y_0 + ∑_{i ≥ 1} p^{-2(p^{i-1}+⋯+1)}
(q-1)^{(p-2)+i} y_i`. (b) Consequently, for every `n` there is `N` (depending on `n` and `p`)
such that `qD → D[1/p]⟦q-1⟧/(q-1)^n` factors through `p^{-N} D⟦q-1⟧/(q-1)^n`. Part (b) is
stated for the envelope; its form for an animated `R` follows by animation. -/
theorem reverse_expansion (x : E.P) (hx : x ∈ E.J) (n : ℕ) (hn : 1 ≤ n) :
    (∃ y : ℕ → E.D, y 0 ∈ E.pdIdeal ∧
      (fun z => E.envelopeComparison (E.gammaQ (E.envelopeComparison.symm z)))^[n]
          (PowerSeries.C (algebraMap E.D _ (E.toD x))) =
        PowerSeries.C (algebraMap E.D _ (y 0)) +
          denominatorSeries p (IsLocalization.Away.invSelf (p : E.D)) (fun i => algebraMap E.D _ (y i))) ∧
    ∃ N : ℕ, ∀ z : E.qD, ∃ w : PowerSeries E.D, ∀ k < n,
      PowerSeries.coeff k ((p : PowerSeries (Localization.Away (p : E.D))) ^ N *
          E.envelopeComparison (E.ofqD z)) = algebraMap E.D _ (PowerSeries.coeff k w) := by
  sorry

/-- The unique continuous extension `D → qD/(q-1)^n ⊗ ℚ` of `P → qD/(q-1)^n ⊗ ℚ`. -/
def uniformExtension (n : ℕ) :
    E.D →+* Localization.Away (Ideal.Quotient.mk (Ideal.span {(E.q - 1) ^ n}) (p : E.qD)) :=
  sorry

theorem uniformExtension_toD (n : ℕ) (x : E.P) :
    E.uniformExtension n (E.toD x) =
      algebraMap (E.qD ⧸ Ideal.span {(E.q - 1) ^ n}) _
        (Ideal.Quotient.mk (Ideal.span {(E.q - 1) ^ n}) (E.toqD x)) := by
  sorry

/-- **Theorem (HQ.1/a-denominator-bound-uniform-in-the-prime, paragraph A.9), ring-level part.**
The extension `D → qD/(q-1)^n ⊗ ℚ` factors through `N_n^{-1} qD/(q-1)^n`, whatever `p` is: the
bound `N_n` does not depend on `p`. The consequences for animated algebras and for the product
over all primes are `uniformBoundEquiv` below. -/
theorem uniformExtension_factors (n : ℕ) (x : E.D) :
    ∃ z : E.qD, (uniformDenominator n : Localization.Away
        (Ideal.Quotient.mk (Ideal.span {(E.q - 1) ^ n}) (p : E.qD))) * E.uniformExtension n x =
      algebraMap (E.qD ⧸ Ideal.span {(E.q - 1) ^ n}) _
        (Ideal.Quotient.mk (Ideal.span {(E.q - 1) ^ n}) z) := by
  sorry

end QPDEnvelope

/-! ### The explicit framed comparison (node HQ.1/the-coordinate-comparison-and-its-compatibility) -/

/-- `log(q) = log(1 + (q-1))`, a power series in `q - 1`. -/
def logQ : PowerSeries ℚ :=
  PowerSeries.mk fun k => if k = 0 then 0 else (-1) ^ (k + 1) / k

/-- The coefficient `log(q)^n / (n! (q-1))` of the formula for `q∂_i`. -/
def logCoeff (n : ℕ) : PowerSeries ℚ :=
  PowerSeries.mk fun k => PowerSeries.coeff (k + 1) (logQ ^ n) / n.factorial

section CoordinateComparison

variable {S : Type u} [CommRing S] [Algebra A S] [Algebra ℚ S] {d : ℕ}

/-- `(∂_i T_i)^{(n-1)}`: the `(n-1)`-fold ITERATE of "multiply by `T_i`, then apply `∂_i`". It is
not a divided power. -/
def iterPartialCoord (F : EtaleFraming A S d) (i : Fin d) (n : ℕ) : S → S :=
  (fun s => F.partialDeriv i (F.coord i * s))^[n - 1]

/-- The automorphism `log(q)/(q-1) + ∑_{n ≥ 2} log(q)^n/(n!(q-1)) (∂_i T_i)^{(n-1)}` of `S⟦q-1⟧`
(for a `ℚ`-algebra `S`), acting coefficientwise; it is congruent to the identity modulo `q - 1`. -/
def logTwist (F : EtaleFraming A S d) (i : Fin d) : AddMonoid.End (PowerSeries S) where
  toFun f := PowerSeries.mk fun k => ∑ n ∈ Finset.Icc 1 (k + 1), ∑ ab ∈ Finset.antidiagonal k,
    (PowerSeries.coeff ab.1 (logCoeff n)) • iterPartialCoord F i n (PowerSeries.coeff ab.2 f)
  map_zero' := sorry
  map_add' := sorry

/-- `∂_i` extended coefficientwise to `S⟦q-1⟧`. -/
def partialPS (F : EtaleFraming A S d) (i : Fin d) : AddMonoid.End (PowerSeries S) where
  toFun f := PowerSeries.mk fun k => F.partialDeriv i (PowerSeries.coeff k f)
  map_zero' := by ext; simp
  map_add' f g := by ext; simp

/-- **Comparison (HQ.1/the-coordinate-comparison-and-its-compatibility, paragraph A.8), chart
version.** After rationalisation, `q∂_i = (log(q)/(q-1) + ∑_{n≥2} log(q)^n/(n!(q-1))
(∂_iT_i)^{(n-1)}) ∂_i`; the operator in parentheses is an automorphism, congruent to the identity
modulo `q - 1`, commuting with `∂_j` for `j ≠ i`; the Koszul twist lemma then gives the explicit
isomorphism of complexes `(qΩ*_{S/B,□} ⊗ ℚ)^∧_{(q-1)} ≅ (Ω*_{S/B} ⊗ ℚ)⟦q-1⟧`. Stated for a
`ℚ`-algebra `S` (the rationalisation of the framed algebra). -/
theorem qPartial_log_formula (F : EtaleFraming A S d) (i : Fin d) :
    qOmegaFramed.qPartial F i = logTwist F i * partialPS F i ∧
    Function.Bijective (logTwist F i) ∧
    (∀ f, PowerSeries.constantCoeff (logTwist F i f) = PowerSeries.constantCoeff f) ∧
    (∀ j, j ≠ i → Commute (logTwist F i) (partialPS F j)) ∧
    koszulDiff (qOmegaFramed.qPartial F) * koszulTwist (logTwist F) =
      koszulTwist (logTwist F) * koszulDiff (partialPS F) := by
  sorry

end CoordinateComparison

/-! ### Categories of algebras -/

/-- Smooth `A`-algebras (Mathlib `Algebra.Smooth`), a full subcategory of `CommAlgCat A`. -/
abbrev SmoothAlg (A : Type u) [CommRing A] : Type (u + 1) :=
  ObjectProperty.FullSubcategory fun S : CommAlgCat.{u} A => Algebra.Smooth A S

/-- Polynomial `A`-algebras in finitely many variables. -/
abbrev PolyAlg (A : Type u) [CommRing A] : Type (u + 1) :=
  ObjectProperty.FullSubcategory fun S : CommAlgCat.{u} A =>
    ∃ n : ℕ, Nonempty (MvPolynomial (Fin n) A ≃ₐ[A] S)

/-- The inclusion of smooth algebras. -/
abbrev SmoothAlg.incl (A : Type u) [CommRing A] : SmoothAlg A ⥤ CommAlgCat.{u} A :=
  ObjectProperty.ι _

/-- The inclusion of polynomial algebras. -/
abbrev PolyAlg.incl (A : Type u) [CommRing A] : PolyAlg A ⥤ CommAlgCat.{u} A :=
  ObjectProperty.ι _

instance smooth_mvPolynomial (n : ℕ) : Algebra.Smooth A (MvPolynomial (Fin n) A) := {}

/-- Polynomial algebras are smooth. -/
def PolyAlg.toSmooth (A : Type u) [CommRing A] : PolyAlg A ⥤ SmoothAlg A :=
  ObjectProperty.lift _ (PolyAlg.incl A) fun S => by
    obtain ⟨n, ⟨e⟩⟩ := S.property
    exact Algebra.Smooth.of_equiv e

/-- A smooth algebra as an object of `SmoothAlg A`. -/
abbrev SmoothAlg.of (S : Type u) [CommRing S] [Algebra A S] [Algebra.Smooth A S] : SmoothAlg A :=
  ⟨CommAlgCat.of A S, inferInstance⟩

/-- `A[x_1, …, x_n]` as an object of `PolyAlg A`. -/
abbrev PolyAlg.of (A : Type u) [CommRing A] (n : ℕ) : PolyAlg A :=
  ⟨CommAlgCat.of A (MvPolynomial (Fin n) A), n, ⟨AlgEquiv.refl⟩⟩

/-! ### The imported ∞-categorical ambient of HQ.1 and HQ.2 -/

/-- The imported ambient of the global q-de Rham theory over `(A, Λ)`. `Ani` is the ∞-category of
animated `A`-algebras, `𝒟` that of `(q-1)`-complete `E∞`-algebras over `A⟦q-1⟧` (the
p-complete and rationalised objects are among them by restriction of scalars), `ℰ` that of
`E∞`-`A`-algebras, and `Mod` the derived ∞-category `D(A⟦q-1⟧)`. Each field names its owner:

* **EnhancedDerivedSheaves E5** (animation): `ofStatic`, `animate` and its universal property;
* **EnhancedDerivedSheaves E1/E4, DerivedDeRhamCohomology DD.1** (derived completion,
  rationalisation, `(q-1)`-power series, reduction modulo `q - 1`): `one`, `oneE`, `staticE`,
  `pComplete`, `rat`, `pRat`, `modQ`, `powerSeries`, `ratE`, `pCompleteE`, `pRatE`,
  `underlying`, `pCompleteMod` and the listed compatibilities;
* **AInfCohomology AI.1** (Koszul complexes of commuting endomorphisms as objects of
  `D(A⟦q-1⟧)`): `koszul`;
* **DerivedDeRhamCohomology DD.2, DD.3, DD.4** (derived de Rham cohomology, its Hodge
  completion, and its p-adic agreement with the de Rham complex on smooth algebras): `dR`,
  `deRham`, `dR_poly`, `toDeRham`, `pDeRham_smooth`;
* **PrismaticCohomology PR.6** (the local q-crystalline theory of Bhatt–Scholze §16 and its
  prismatic comparison, Theorem 16.18): `localQOmega`, `prismaticTwist`,
  `prismaticComparison`, `localQOmega_modQ`. -/
structure QDeRhamContext (A : Type u) [CommRing A] (Λ : LambdaRing A)
    (Ani : Type*) [Category Ani] (𝒟 : Type*) [Category 𝒟] (ℰ : Type*) [Category ℰ]
    (Mod : Type*) [Category Mod] where
  /-- E5: a static `A`-algebra as an animated one. -/
  ofStatic : CommAlgCat.{u} A ⥤ Ani
  /-- E5: animation into `𝒟` (left Kan extension from polynomial algebras). -/
  animate : (PolyAlg A ⥤ 𝒟) → (Ani ⥤ 𝒟)
  animate_restrict : ∀ F, PolyAlg.incl A ⋙ ofStatic ⋙ animate F ≅ F
  animate_sifted : ∀ (F : PolyAlg A ⥤ 𝒟) (J : Type) [SmallCategory J] [IsSifted J],
    PreservesColimitsOfShape J (animate F)
  animate_unique : ∀ (F : PolyAlg A ⥤ 𝒟) (G : Ani ⥤ 𝒟),
    (∀ (J : Type) [SmallCategory J] [IsSifted J], PreservesColimitsOfShape J G) →
      (PolyAlg.incl A ⋙ ofStatic ⋙ G ≅ F) → Nonempty (G ≅ animate F)
  /-- `A⟦q-1⟧` and `A`. -/
  one : 𝒟
  oneE : ℰ
  /-- A static `A`-algebra as an `E∞`-`A`-algebra. -/
  staticE : CommAlgCat.{u} A ⥤ ℰ
  /-- p-completion, with its unit. -/
  pComplete : Nat.Primes → 𝒟 ⥤ 𝒟
  pCompleteUnit : ∀ p, 𝟭 𝒟 ⟶ pComplete p
  /-- `(- ⊗^L ℚ)^∧_{(q-1)}`, with its unit. -/
  rat : 𝒟 ⥤ 𝒟
  ratUnit : 𝟭 𝒟 ⟶ rat
  /-- `((-)^∧_p[1/p])^∧_{(q-1)}`: p-complete, invert `p`, complete at `q - 1`, in that order. -/
  pRat : Nat.Primes → 𝒟 ⥤ 𝒟
  ratToPRat : ∀ p, rat ⟶ pRat p
  /-- Reduction modulo `q - 1`. -/
  modQ : 𝒟 ⥤ ℰ
  /-- `-⟦q-1⟧`. -/
  powerSeries : ℰ ⥤ 𝒟
  powerSeries_modQ : powerSeries ⋙ modQ ≅ 𝟭 ℰ
  /-- `- ⊗^L ℚ` on `E∞`-`A`-algebras, with its unit. -/
  ratE : ℰ ⥤ ℰ
  ratEUnit : 𝟭 ℰ ⟶ ratE
  rat_modQ : rat ⋙ modQ ≅ modQ ⋙ ratE
  pCompleteE : Nat.Primes → ℰ ⥤ ℰ
  pCompleteEUnit : ∀ p, 𝟭 ℰ ⟶ pCompleteE p
  /-- `(-)^∧_p[1/p]`. -/
  pRatE : Nat.Primes → ℰ ⥤ ℰ
  ratEToPRatE : ∀ p, ratE ⟶ pRatE p
  pRat_modQ : ∀ p, pRat p ⋙ modQ ≅ modQ ⋙ pRatE p
  /-- The underlying object in `D(A⟦q-1⟧)`. -/
  underlying : 𝒟 ⥤ Mod
  pCompleteMod : Nat.Primes → Mod ⥤ Mod
  /-- AI.1: the Koszul complex of (`A⟦q-1⟧`-linear) commuting endomorphisms of `S⟦q-1⟧`, as an
  object of `D(A⟦q-1⟧)`. -/
  koszul : ∀ {S : Type u} [CommRing S] [Algebra A S] {d : ℕ},
    (Fin d → AddMonoid.End (PowerSeries S)) → Mod
  /-- DD.2: the derived de Rham complex `dR_{−/A}`. -/
  dR : Ani ⥤ ℰ
  /-- The de Rham complex `Ω*_{S/A}` of a smooth algebra, as an `E∞`-algebra. -/
  deRham : SmoothAlg A ⥤ ℰ
  dR_poly : PolyAlg.incl A ⋙ ofStatic ⋙ dR ≅ PolyAlg.toSmooth A ⋙ deRham
  /-- The map `dR_{S/A} → Ω*_{S/A}`, the Hodge completion. -/
  toDeRham : SmoothAlg.incl A ⋙ ofStatic ⋙ dR ⟶ deRham
  /-- DD.3/DD.4: after p-completion, derived de Rham = de Rham on smooth algebras. -/
  pDeRham_smooth : ∀ p, SmoothAlg.incl A ⋙ ofStatic ⋙ dR ⋙ pCompleteE p ≅ deRham ⋙ pCompleteE p
  /-- PR.6: `S ↦ qΩ_{Ŝ_p/Â_p}`, q-crystalline cohomology relative to `(Â_p⟦q-1⟧, (q-1))`. -/
  localQOmega : Nat.Primes → SmoothAlg A ⥤ 𝒟
  /-- PR.6: `S ↦ Δ_{S^{(p)}[ζ_p]/Â_p⟦q-1⟧}`, prismatic cohomology of the Frobenius twist
  `S^{(p)} = (S ⊗_{A,ψ^p} A)^∧_p` with `ζ_p` adjoined, relative to `(Â_p⟦q-1⟧, [p]_q)`. -/
  prismaticTwist : Nat.Primes → SmoothAlg A ⥤ 𝒟
  prismaticComparison : ∀ p, localQOmega p ≅ prismaticTwist p
  localQOmega_modQ : ∀ p, localQOmega p ⋙ modQ ≅ deRham ⋙ pCompleteE p

variable {Λ : LambdaRing A} {Ani 𝒟 ℰ Mod : Type*} [Category Ani] [Category 𝒟] [Category ℰ]
  [Category Mod]

namespace QDeRhamContext

/-- Smooth algebras as animated algebras. -/
abbrev ofSmooth (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) : SmoothAlg A ⥤ Ani :=
  SmoothAlg.incl A ⋙ K.ofStatic

/-- Polynomial algebras as animated algebras. -/
abbrev ofPoly (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) : PolyAlg A ⥤ Ani :=
  PolyAlg.incl A ⋙ K.ofStatic

end QDeRhamContext

/-! ### The local derived q-de Rham complex (node HQ.1/the-local-derived-q-de-rham-complex) -/

/-- **Construction (HQ.1/the-local-derived-q-de-rham-complex).** API `qdRLocal`: the local derived
q-de Rham complex `qdR_{−/Â_p}`, the animation of the imported `qΩ_{−/Â_p}` followed by
p-completion, with values in `(p, q-1)`-complete `E∞`-algebras over `Â_p⟦q-1⟧`. -/
def qdRLocal (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes) : Ani ⥤ 𝒟 :=
  K.animate (PolyAlg.toSmooth A ⋙ K.localQOmega p) ⋙ K.pComplete p

/-- The p-completed derived de Rham complex `dR_{−/Â_p}`. -/
def dRLocal (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes) : Ani ⥤ ℰ :=
  K.dR ⋙ K.pCompleteE p

/-- API `qdRLocal.equivQOmega`: for (p-completely) smooth `S`, `qdR_{S/Â_p} ≃ qΩ_{S/Â_p}`
(checked modulo `(p, q-1)`, where it is `dR ≃ Ω*` for smooth algebras in characteristic `p`). -/
def qdRLocal.equivQOmega (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes) :
    K.ofSmooth ⋙ qdRLocal K p ≅ K.localQOmega p :=
  sorry

/-- API `qdRLocal.modQSubOne`: `qdR_{R/Â_p}/(q-1) ≃ dR_{R/Â_p}`, p-completed. -/
def qdRLocal.modQSubOne (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes) :
    qdRLocal K p ⋙ K.modQ ≅ dRLocal K p :=
  sorry

/-- API `qdRLocal.leftKanExtension`: the animation preserves sifted colimits and is the unique
such extension of its restriction to polynomial algebras. -/
theorem qdRLocal.leftKanExtension (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes) :
    (∀ (J : Type) [SmallCategory J] [IsSifted J],
      PreservesColimitsOfShape J (K.animate (PolyAlg.toSmooth A ⋙ K.localQOmega p))) ∧
    ∀ G : Ani ⥤ 𝒟, (∀ (J : Type) [SmallCategory J] [IsSifted J], PreservesColimitsOfShape J G) →
      (K.ofPoly ⋙ G ≅ PolyAlg.toSmooth A ⋙ K.localQOmega p) →
        Nonempty (G ⋙ K.pComplete p ≅ qdRLocal K p) :=
  ⟨fun J _ _ => K.animate_sifted _ J,
    fun G hG e => ⟨Functor.isoWhiskerRight (Classical.choice (K.animate_unique _ G hG e)) _⟩⟩

/-- API `qdRLocal.map`: functoriality in `R`. (Functoriality in the base `A` along maps of
p-torsion free Λ-rings is the base change of `BaseChange` below.) -/
def qdRLocal.map (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes) {R R' : Ani}
    (f : R ⟶ R') : (qdRLocal K p).obj R ⟶ (qdRLocal K p).obj R' :=
  (qdRLocal K p).map f

/-- Unit test `qdRLocal_base`: for `R = Â_p` the value is `Â_p⟦q-1⟧`. -/
example (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes) :
    Nonempty ((qdRLocal K p).obj (K.ofStatic.obj (CommAlgCat.of A A)) ≅ (K.pComplete p).obj K.one) := by
  sorry

/-- Unit test `qdRLocal_polynomial`: for `R = Â_p⟨x⟩` the value is the p-completion of the
two-term Koszul complex `A[x]⟦q-1⟧ → A[x]⟦q-1⟧ dx`, `x^n ↦ [n]_q x^{n-1} dx`. -/
example (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes) :
    Nonempty (K.underlying.obj ((qdRLocal K p).obj (K.ofPoly.obj (PolyAlg.of A 1))) ≅
      (K.pCompleteMod p).obj (K.koszul (qOmegaFramed.qPartial (EtaleFraming.polyId A 1)))) ∧
    ∀ n : ℕ, qOmegaFramed.qPartial (EtaleFraming.polyId A 1) 0
        (PowerSeries.C (MvPolynomial.X 0 ^ n)) =
      qInt n (1 + PowerSeries.X) * PowerSeries.C (MvPolynomial.X 0 ^ (n - 1)) := by
  sorry

/-- Unit test `qdRLocal_modQSubOne`: modulo `q - 1` the value is `dR_{R/Â_p}`; for `R` smooth
the p-completed de Rham complex. -/
example (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes) (S : SmoothAlg A) :
    Nonempty (K.modQ.obj ((qdRLocal K p).obj (K.ofSmooth.obj S)) ≅
      (K.pCompleteE p).obj (K.deRham.obj S)) := by
  sorry

/-- Unit test `qdRLocal_Fp`: for `A = ℤ` and `R = 𝔽_p`, the value modulo `q - 1` is
`dR_{𝔽_p/ℤ_p} ≃ ℤ_p` (crystalline cohomology of `𝔽_p`), not `𝔽_p`. -/
example {Λℤ : LambdaRing ℤ} (K : QDeRhamContext ℤ Λℤ Ani 𝒟 ℰ Mod) (p : Nat.Primes) :
    Nonempty (K.modQ.obj ((qdRLocal K p).obj (K.ofStatic.obj (CommAlgCat.of ℤ (ZMod p)))) ≅
      (K.pCompleteE p).obj K.oneE) ∧
    ¬ Nonempty (K.modQ.obj ((qdRLocal K p).obj (K.ofStatic.obj (CommAlgCat.of ℤ (ZMod p)))) ≅
      K.staticE.obj (CommAlgCat.of ℤ (ZMod p))) := by
  sorry

/-! ### The rationalised comparison and the uniform bound -/

/-- **Theorem (HQ.1/rationalised-q-crystalline-comparison, Lemma A.4).** For every p-complete
animated `R` there is an equivalence, functorial in `R` and built without a framing,
`(qdR_{R/Â_p} ⊗^L ℚ)^∧_{(q-1)} ≃ (dR_{R/Â_p} ⊗^L ℚ)⟦q-1⟧`. -/
def rationalisedComparison (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes) :
    qdRLocal K p ⋙ K.rat ≅ dRLocal K p ⋙ K.ratE ⋙ K.powerSeries :=
  sorry

/-- Lemma A.4, continued: modulo `q - 1` the equivalence is the identity of `dR_{R/Â_p} ⊗ ℚ`. -/
theorem rationalisedComparison_modQSubOne (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod)
    (p : Nat.Primes) (R : Ani) :
    K.modQ.map ((rationalisedComparison K p).hom.app R) =
      K.rat_modQ.hom.app ((qdRLocal K p).obj R) ≫
        K.ratE.map ((qdRLocal.modQSubOne K p).hom.app R) ≫
          K.powerSeries_modQ.inv.app (K.ratE.obj ((dRLocal K p).obj R)) := by
  sorry

variable [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ]

/-- **Theorem (HQ.1/a-denominator-bound-uniform-in-the-prime, paragraph A.9).** Taking the
product over all primes and the limit over `n` of the maps
`dR_{R̂_p/Â_p} → N_n^{-1} qdR_{R̂_p/Â_p}/(q-1)^n` (see `QPDEnvelope.uniformExtension_factors`,
where `N_n` does not depend on `p`) gives an equivalence
`(∏_p dR_{R̂_p/Â_p} ⊗^L ℚ)⟦q-1⟧ ≃ (∏_p qdR_{R̂_p/Â_p} ⊗^L ℚ)^∧_{(q-1)}`. -/
def uniformBoundEquiv (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (R : Ani) :
    K.powerSeries.obj (K.ratE.obj (∏ᶜ fun p => (dRLocal K p).obj R)) ≅
      K.rat.obj (∏ᶜ fun p => (qdRLocal K p).obj R) :=
  sorry

/-- The uniform-bound equivalence is compatible with Lemma A.4 prime by prime. -/
theorem uniformBoundEquiv_compat (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (R : Ani)
    (p : Nat.Primes) :
    (uniformBoundEquiv K R).hom ≫ K.rat.map (Limits.Pi.π _ p) ≫ (rationalisedComparison K p).hom.app R =
      K.powerSeries.map (K.ratE.map (Limits.Pi.π _ p)) := by
  sorry

/-! ### The global q-de Rham complex (node HQ.1/the-global-q-de-rham-complex) -/

/-- The right vertical map of the defining square: rationalisation
`∏_p qΩ_{Ŝ_p/Â_p} → (∏_p qΩ_{Ŝ_p/Â_p} ⊗^L ℚ)^∧_{(q-1)}` followed by the inverse of the
uniform-bound equivalence (through `qΩ ≃ qdR` and `Ω* ≃ dR` on smooth algebras, p-adically). -/
def qOmega.rightMap (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (S : SmoothAlg A) :
    (∏ᶜ fun p => (K.localQOmega p).obj S) ⟶
      K.powerSeries.obj (K.ratE.obj (∏ᶜ fun p => (K.pCompleteE p).obj (K.deRham.obj S))) :=
  K.ratUnit.app _ ≫ K.rat.map (Limits.Pi.map fun p => (qdRLocal.equivQOmega K p).inv.app S) ≫
    (uniformBoundEquiv K (K.ofSmooth.obj S)).inv ≫
      K.powerSeries.map (K.ratE.map (Limits.Pi.map fun p => (K.pDeRham_smooth p).hom.app S))

/-- The lower map of the defining square, induced by `Ω*_{S/A} → Ω*_{Ŝ_p/Â_p}`. -/
def qOmega.lowerMap (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (S : SmoothAlg A) :
    K.powerSeries.obj (K.ratE.obj (K.deRham.obj S)) ⟶
      K.powerSeries.obj (K.ratE.obj (∏ᶜ fun p => (K.pCompleteE p).obj (K.deRham.obj S))) :=
  K.powerSeries.map (K.ratE.map (Limits.Pi.lift fun p => (K.pCompleteEUnit p).app (K.deRham.obj S)))

variable [HasPullbacks 𝒟]

/-- **Construction (HQ.1/the-global-q-de-rham-complex, Construction A.12).** API `qOmega`: the
global q-de Rham complex `qΩ_{S/A}` of a smooth `A`-algebra, the pullback of
`∏_p qΩ_{Ŝ_p/Â_p} → (∏_p Ω*_{Ŝ_p/Â_p} ⊗^L ℚ)⟦q-1⟧ ← (Ω*_{S/A} ⊗^L ℚ)⟦q-1⟧` in `(q-1)`-complete
`E∞`-algebras over `A⟦q-1⟧`. The right map uses the uniform bound; no framing is chosen. -/
def qOmega (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) : SmoothAlg A ⥤ 𝒟 where
  obj S := pullback (qOmega.rightMap K S) (qOmega.lowerMap K S)
  map {S S'} f := pullback.map _ _ _ _
    (Limits.Pi.map fun p => (K.localQOmega p).map f) (K.powerSeries.map (K.ratE.map (K.deRham.map f)))
    (K.powerSeries.map (K.ratE.map (Limits.Pi.map fun p => (K.pCompleteE p).map (K.deRham.map f))))
    sorry sorry
  map_id := sorry
  map_comp := sorry

/-- API `qOmega.isPullback`: the defining square is a pullback square. -/
theorem qOmega.isPullback (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (S : SmoothAlg A) :
    IsPullback (pullback.fst (qOmega.rightMap K S) (qOmega.lowerMap K S)) (pullback.snd _ _)
      (qOmega.rightMap K S) (qOmega.lowerMap K S) :=
  IsPullback.of_hasPullback _ _

/-- API `qOmega.toPCompletion`: the map `qΩ_{S/A} → qΩ_{Ŝ_p/Â_p}`. -/
def qOmega.toPCompletion (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes) (S : SmoothAlg A) :
    (qOmega K).obj S ⟶ (K.localQOmega p).obj S :=
  pullback.fst _ _ ≫ Limits.Pi.π _ p

/-- It identifies the p-completion of `qΩ_{S/A}` with `qΩ_{Ŝ_p/Â_p}`. -/
theorem qOmega.toPCompletion_spec (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes)
    (S : SmoothAlg A) :
    ∃ e : (K.pComplete p).obj ((qOmega K).obj S) ≅ (K.localQOmega p).obj S,
      (K.pCompleteUnit p).app _ ≫ e.hom = qOmega.toPCompletion K p S := by
  sorry

/-- API `qOmega.toRational`: the map `qΩ_{S/A} → (Ω*_{S/A} ⊗ ℚ)⟦q-1⟧`. -/
def qOmega.toRational (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (S : SmoothAlg A) :
    (qOmega K).obj S ⟶ K.powerSeries.obj (K.ratE.obj (K.deRham.obj S)) :=
  pullback.snd _ _

/-- It identifies the `(q-1)`-completed rationalisation of `qΩ_{S/A}` with its target. -/
theorem qOmega.toRational_spec (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (S : SmoothAlg A) :
    ∃ e : K.rat.obj ((qOmega K).obj S) ≅ K.powerSeries.obj (K.ratE.obj (K.deRham.obj S)),
      K.ratUnit.app _ ≫ e.hom = qOmega.toRational K S := by
  sorry

/-- API `qOmega.map`: functoriality in `S`. -/
def qOmega.map (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) {S S' : SmoothAlg A} (f : S ⟶ S') :
    (qOmega K).obj S ⟶ (qOmega K).obj S' :=
  (qOmega K).map f

theorem qOmega.map_id (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (S : SmoothAlg A) :
    qOmega.map K (𝟙 S) = 𝟙 _ :=
  (qOmega K).map_id S

theorem qOmega.map_comp (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) {S S' S'' : SmoothAlg A}
    (f : S ⟶ S') (g : S' ⟶ S'') : qOmega.map K (f ≫ g) = qOmega.map K f ≫ qOmega.map K g :=
  (qOmega K).map_comp f g

/-- API `qOmega.modQSubOne`: `qΩ_{S/A}/(q-1) ≃ Ω*_{S/A}`, naturally in `S` (Theorem A.1(a)). -/
def qOmega.modQSubOne (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) : qOmega K ⋙ K.modQ ≅ K.deRham :=
  sorry

/-- API `qOmega.equivFramed`: for an étale framing, `qΩ_{S/A} ≃ qΩ*_{S/A,□}` as objects of
`D(A⟦q-1⟧)` (Theorem A.1(d)); underlying objects only. -/
def qOmega.equivFramed (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) {S : Type u} [CommRing S]
    [Algebra A S] [Algebra.Smooth A S] {d : ℕ} (F : EtaleFraming A S d) :
    K.underlying.obj ((qOmega K).obj (SmoothAlg.of S)) ≅ K.koszul (qOmegaFramed.qPartial F) :=
  sorry

/-- API `qOmegaFramed.equivQOmega`: the identification of the coordinate complex with `qΩ_{S/A}`
(Theorem A.1(d), framed-description node), the inverse of `qOmega.equivFramed`. -/
def qOmegaFramed.equivQOmega (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) {S : Type u} [CommRing S]
    [Algebra A S] [Algebra.Smooth A S] {d : ℕ} (F : EtaleFraming A S d) :
    K.koszul (qOmegaFramed.qPartial F) ≅ K.underlying.obj ((qOmega K).obj (SmoothAlg.of S)) :=
  (qOmega.equivFramed K F).symm

/-- Unit test `qOmega_modQSubOne_polynomial`: for `A = ℤ` and `S = ℤ[x]`, `qΩ_{S/A}/(q-1)` is the
two-term de Rham complex `ℤ[x] → ℤ[x] dx`, whose differential is `x^n ↦ n x^{n-1} dx`. -/
example {Λℤ : LambdaRing ℤ} (K : QDeRhamContext ℤ Λℤ Ani 𝒟 ℰ Mod) :
    Nonempty (K.modQ.obj ((qOmega K).obj (SmoothAlg.of (MvPolynomial (Fin 1) ℤ))) ≅
      K.deRham.obj (SmoothAlg.of (MvPolynomial (Fin 1) ℤ))) ∧
    ∀ n : ℕ, qDiff (1 : ℤ) ((X : ℤ[X]) ^ n) = C (n : ℤ) * X ^ (n - 1) := by
  sorry

/-- Unit test `qOmega_of_rational_base`: if `A` is a `ℚ`-algebra, every `Â_p` vanishes and
`qΩ_{S/A} ≃ Ω*_{S/A}⟦q-1⟧`, the trivial q-deformation. -/
example [Algebra ℚ A] (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (S : SmoothAlg A) :
    Nonempty ((qOmega K).obj S ≅ K.powerSeries.obj (K.deRham.obj S)) := by
  sorry

/-- Unit test `qOmega_framed_polynomial`: for `A = ℤ`, `S = ℤ[x]` and the identity framing,
`qΩ_{S/A}` is the q-difference complex `ℤ[x]⟦q-1⟧ → ℤ[x]⟦q-1⟧ dx`, `x^n ↦ [n]_q x^{n-1} dx`. -/
example {Λℤ : LambdaRing ℤ} (K : QDeRhamContext ℤ Λℤ Ani 𝒟 ℰ Mod) :
    Nonempty (K.underlying.obj ((qOmega K).obj (SmoothAlg.of (MvPolynomial (Fin 1) ℤ))) ≅
      K.koszul (qOmegaFramed.qPartial (EtaleFraming.polyId ℤ 1))) ∧
    ∀ n : ℕ, qOmegaFramed.qPartial (EtaleFraming.polyId ℤ 1) 0
        (PowerSeries.C (MvPolynomial.X 0 ^ n)) =
      qInt n (1 + PowerSeries.X) * PowerSeries.C (MvPolynomial.X 0 ^ (n - 1)) := by
  sorry

/-- Unit test `qOmega_ne_prod_pCompletions`: for `A = S = ℤ`, `qΩ_{S/A} = ℤ⟦q-1⟧`, which is not
the product `∏_p ℤ_p⟦q-1⟧` of the p-complete complexes: dropping the rational corner is wrong. -/
example {Λℤ : LambdaRing ℤ} (K : QDeRhamContext ℤ Λℤ Ani 𝒟 ℰ Mod) :
    Nonempty ((qOmega K).obj (SmoothAlg.of ℤ) ≅ K.one) ∧
    ¬ Nonempty (K.one ≅ ∏ᶜ fun p => (K.localQOmega p).obj (SmoothAlg.of ℤ)) := by
  sorry

/-- **Theorem (HQ.1/what-the-global-complex-satisfies, Theorem A.1(a)–(c)).** (a)
`qΩ_{S/A}/(q-1) ≃ Ω*_{S/A}` naturally; (b) for every prime `p`,
`(qΩ_{S/A})^∧_p ≃ qΩ_{Ŝ_p/Â_p} ≃ Δ_{S^{(p)}[ζ_p]/Â_p⟦q-1⟧}` (prism ideal `([p]_q)`, Frobenius
twist along `ψ^p`); (c) `(qΩ_{S/A} ⊗^L ℚ)^∧_{(q-1)} ≃ (Ω*_{S/A} ⊗^L ℚ)⟦q-1⟧`. -/
theorem qOmega_properties (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) :
    Nonempty (qOmega K ⋙ K.modQ ≅ K.deRham) ∧
    (∀ p : Nat.Primes, Nonempty (qOmega K ⋙ K.pComplete p ≅ K.localQOmega p) ∧
      Nonempty (K.localQOmega p ≅ K.prismaticTwist p)) ∧
    Nonempty (qOmega K ⋙ K.rat ≅ K.deRham ⋙ K.ratE ⋙ K.powerSeries) := by
  sorry

/-! ### The framed description and framing independence -/

/-- **Theorem (HQ.1/the-framed-description-of-the-global-complex, Theorem A.1(d)).** For an
étale framing, the underlying object of `qΩ_{S/A}` in `D(A⟦q-1⟧)` is the coordinate-dependent
complex. (The source moreover identifies the defining square with the `(q-1)`-completed
arithmetic fracture square of `qΩ*_{S/A,□}`; that refinement is not stated here.) -/
theorem qOmega_underlying_framed (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) {S : Type u} [CommRing S]
    [Algebra A S] [Algebra.Smooth A S] {d : ℕ} (F : EtaleFraming A S d) :
    Nonempty (K.underlying.obj ((qOmega K).obj (SmoothAlg.of S)) ≅
      K.koszul (qOmegaFramed.qPartial F)) :=
  ⟨qOmega.equivFramed K F⟩

/-- The comparison `c_{□′,□} : qΩ*_{S/A,□} ≃ qΩ_{S/A} ≃ qΩ*_{S/A,□′}` between framed models. -/
def framingComparison (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) {S : Type u} [CommRing S]
    [Algebra A S] [Algebra.Smooth A S] {d d' : ℕ} (F : EtaleFraming A S d)
    (F' : EtaleFraming A S d') :
    K.koszul (qOmegaFramed.qPartial F) ≅ K.koszul (qOmegaFramed.qPartial F') :=
  (qOmega.equivFramed K F).symm ≪≫ qOmega.equivFramed K F'

/-- **Lemma (HQ.1/framing-independence-and-the-cocycle-identity).** `c_{□,□} = id` and
`c_{□″,□′} ∘ c_{□′,□} = c_{□″,□}`. -/
theorem framingComparison_cocycle (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) {S : Type u} [CommRing S]
    [Algebra A S] [Algebra.Smooth A S] {d d' d'' : ℕ} (F : EtaleFraming A S d)
    (F' : EtaleFraming A S d') (F'' : EtaleFraming A S d'') :
    framingComparison K F F = Iso.refl _ ∧
      framingComparison K F F' ≪≫ framingComparison K F' F'' = framingComparison K F F'' := by
  constructor
  · simp [framingComparison]
  · simp [framingComparison]

/-- **Owners: PrismaticCohomology PR.6** (Bhatt–Scholze Theorem 16.22) **and CrystallineCohomology
CR.0, CR.2.** For a surjection `P ↠ S` from a p-completely ind-smooth algebra with an ind-étale
framing: the rationalised q-PD de Rham complex `(qΩ̆*_{qD/Â_p,□} ⊗ ℚ)^∧_{(q-1)}` and PD de Rham
complex `(Ω̆*_{D/Â_p} ⊗ ℚ)⟦q-1⟧` as objects of `D(A⟦q-1⟧)`, with the quasi-isomorphisms from the
rationalised q-crystalline and crystalline cohomology of `S`. -/
structure PDFramedData (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes) (S : SmoothAlg A) where
  /-- `(qΩ̆*_{qD/Â_p,□} ⊗ ℚ)^∧_{(q-1)}`. -/
  qPDdR : Mod
  /-- `(Ω̆*_{D/Â_p} ⊗ ℚ)⟦q-1⟧`. -/
  pdR : Mod
  /-- The left map: BS Theorem 16.22, rationalised. -/
  left : K.underlying.obj (K.rat.obj ((K.localQOmega p).obj S)) ≅ qPDdR
  /-- The right map: crystalline cohomology is computed by the PD de Rham complex. -/
  right : K.underlying.obj (K.powerSeries.obj (K.ratE.obj ((K.pCompleteE p).obj (K.deRham.obj S))))
    ≅ pdR

/-- The explicit isomorphism `(qΩ̆*_{qD/Â_p,□} ⊗ ℚ)^∧_{(q-1)} ≅ (Ω̆*_{D/Â_p} ⊗ ℚ)⟦q-1⟧` of the PD
version of paragraph A.8 (the formula for `q∂_i` and the Koszul twist on the envelopes). -/
def PDFramedData.explicitIso {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} {p : Nat.Primes}
    {S : SmoothAlg A} (P : PDFramedData K p S) : P.qPDdR ≅ P.pdR :=
  sorry

/-- **Lemma (HQ.1/the-compatibility-square).** The square formed by the coordinate-free
equivalence of Lemma A.4 (top), the explicit isomorphism (bottom) and the two quasi-isomorphisms
with the (q-)PD de Rham complexes (sides) commutes. -/
theorem compatibility_square (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes)
    (S : SmoothAlg A) (P : PDFramedData K p S) :
    K.underlying.map (K.rat.map ((qdRLocal.equivQOmega K p).inv.app S) ≫
        (rationalisedComparison K p).hom.app (K.ofSmooth.obj S) ≫
          K.powerSeries.map (K.ratE.map ((K.pDeRham_smooth p).hom.app S))) ≫ P.right.hom =
      P.left.hom ≫ P.explicitIso.hom := by
  sorry

/-! ### Base change (node HQ.1/base-change-for-the-global-complex) -/

/-- **Owners: DerivedDeRhamCohomology DD.1 and EnhancedDerivedSheaves E1, E5.** Base change
along a map of Λ-rings `A → A′`, both p-torsion free for every `p` (`A′` not assumed flat):
`(- ⊗^L_A A′)^∧_{(q-1)}` on `𝒟`, `- ⊗^L_A A′` on `ℰ`, `S ↦ S ⊗_A A′` on smooth algebras and the
animated base change on `Ani`, with the base change of de Rham complexes. -/
structure BaseChange {A' : Type u} [CommRing A'] {Λ' : LambdaRing A'}
    {Ani' 𝒟' ℰ' Mod' : Type*} [Category Ani'] [Category 𝒟'] [Category ℰ'] [Category Mod']
    (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (K' : QDeRhamContext A' Λ' Ani' 𝒟' ℰ' Mod') where
  /-- The map of Λ-rings. -/
  f : A →+* A'
  isHom : Λ.IsHom Λ' f
  bc : 𝒟 ⥤ 𝒟'
  bcE : ℰ ⥤ ℰ'
  bcSmooth : SmoothAlg A ⥤ SmoothAlg A'
  bcAni : Ani ⥤ Ani'
  bc_modQ : bc ⋙ K'.modQ ≅ K.modQ ⋙ bcE
  /-- The base change equivalence of de Rham complexes (flatness of `S` over `A`). -/
  bcDeRham : K.deRham ⋙ bcE ≅ bcSmooth ⋙ K'.deRham
  /-- The base change equivalence of derived de Rham complexes (DD.2). -/
  bcDR : K.dR ⋙ bcE ≅ bcAni ⋙ K'.dR

/-- API `qOmega.baseChange`: `(qΩ_{S/A} ⊗^L_A A′)^∧_{(q-1)} ≃ qΩ_{(S ⊗_A A′)/A′}`. -/
def qOmega.baseChange {A' : Type u} [CommRing A'] {Λ' : LambdaRing A'}
    {Ani' 𝒟' ℰ' Mod' : Type*} [Category Ani'] [Category 𝒟'] [Category ℰ'] [Category Mod']
    [HasProducts.{0} 𝒟'] [HasProducts.{0} ℰ'] [HasPullbacks 𝒟']
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} {K' : QDeRhamContext A' Λ' Ani' 𝒟' ℰ' Mod'}
    (B : BaseChange K K') : qOmega K ⋙ B.bc ≅ B.bcSmooth ⋙ qOmega K' :=
  sorry

/-- The `(q-1)`-completion cannot be dropped from base change: `ℤ⟦q-1⟧ ⊗ ℚ` is not `ℚ⟦q-1⟧`,
since `∑ (q-1)^n/2^n` is not of the form `g/N` with `g ∈ ℤ⟦q-1⟧`. -/
theorem powerSeries_int_tensor_rat_ne (N : ℕ) (hN : 0 < N) (g : PowerSeries ℤ) :
    PowerSeries.map (Int.castRingHom ℚ) g ≠
      (N : PowerSeries ℚ) * PowerSeries.mk fun n => ((1 : ℚ) / 2) ^ n := by
  sorry

/-- **Theorem (HQ.1/base-change-for-the-global-complex, Theorem A.1, base change).** The base
change equivalence exists, natural in `S`, and modulo `q - 1` it is the base change equivalence
of de Rham complexes; the completion is part of the statement
(`powerSeries_int_tensor_rat_ne`). -/
theorem qOmega_baseChange_modQ {A' : Type u} [CommRing A'] {Λ' : LambdaRing A'}
    {Ani' 𝒟' ℰ' Mod' : Type*} [Category Ani'] [Category 𝒟'] [Category ℰ'] [Category Mod']
    [HasProducts.{0} 𝒟'] [HasProducts.{0} ℰ'] [HasPullbacks 𝒟']
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} {K' : QDeRhamContext A' Λ' Ani' 𝒟' ℰ' Mod'}
    (B : BaseChange K K') (S : SmoothAlg A) :
    K'.modQ.map ((qOmega.baseChange B).hom.app S) =
      B.bc_modQ.hom.app ((qOmega K).obj S) ≫ B.bcE.map ((qOmega.modQSubOne K).hom.app S) ≫
        B.bcDeRham.hom.app S ≫ (qOmega.modQSubOne K').inv.app (B.bcSmooth.obj S) := by
  sorry

/-! ### The derived commutative lift (node HQ.1/the-derived-commutative-lift) -/

/-- **Owner: EnhancedDerivedSheaves E5** (Raksit's derived commutative algebras, Definition
4.2.22; limits and colimits are computed on underlying `E∞`-algebras, Proposition 4.2.27),
**with CrystallineCohomology CR.0, CR.2 and PrismaticCohomology PR.6** (the cosimplicial PD and
q-PD realisations of the corners, whose derived commutative structures are those of
totalisations of static rings). -/
structure DAlgContext (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (𝒟dc ℰdc : Type*) [Category 𝒟dc]
    [Category ℰdc] where
  /-- The forgetful functors to `E∞`-algebras. -/
  forget : 𝒟dc ⥤ 𝒟
  forgetE : ℰdc ⥤ ℰ
  preservesLimits : PreservesLimitsOfShape WalkingCospan forget
  reflectsLimits : ReflectsLimitsOfShape WalkingCospan forget
  /-- Reduction modulo `q - 1`. -/
  modQD : 𝒟dc ⥤ ℰdc
  modQD_forget : modQD ⋙ forgetE ≅ forget ⋙ K.modQ
  /-- Static rings as derived commutative `A`-algebras, and the unit `A⟦q-1⟧`. -/
  staticD : CommAlgCat.{u} A ⥤ ℰdc
  staticD_forget : staticD ⋙ forgetE ≅ K.staticE
  oneD : 𝒟dc
  oneD_forget : forget.obj oneD ≅ K.one
  /-- CR.0: `S ↦ D^•`, the PD envelopes of the Čech nerve of `A → P`, `P = A[T_s : s ∈ S]`. -/
  pdNerve : SmoothAlg A ⥤ CosimplicialObject (CommAlgCat.{u} A)
  /-- `Ω*_{S/A}` with the derived commutative structure of its cdga structure
  (Raksit, Definition 5.1.10). -/
  deRhamD : SmoothAlg A ⥤ ℰdc
  deRhamD_forget : deRhamD ⋙ forgetE ≅ K.deRham
  /-- The three corners of the defining square, as derived commutative algebras
  (Čech–Alexander realisations), and the two maps between them. -/
  cornerP : SmoothAlg A ⥤ 𝒟dc
  cornerR : SmoothAlg A ⥤ 𝒟dc
  cornerRP : SmoothAlg A ⥤ 𝒟dc
  rightD : cornerP ⟶ cornerRP
  lowerD : cornerR ⟶ cornerRP

/-- **Construction (HQ.1/the-derived-commutative-lift).** API `qOmegaDAlg`: the lift of
`qΩ_{−/A}` to `(q-1)`-complete derived commutative `A⟦q-1⟧`-algebras, the pullback of the lifted
corners. -/
def qOmegaDAlg {𝒟dc ℰdc : Type*} [Category 𝒟dc] [Category ℰdc] [HasPullbacks 𝒟dc]
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (D : DAlgContext K 𝒟dc ℰdc) : SmoothAlg A ⥤ 𝒟dc :=
  sorry

/-- API `qOmegaDAlg.forget`: its composite with the forgetful functor is `qΩ_{−/A}`. -/
def qOmegaDAlg.forget {𝒟dc ℰdc : Type*} [Category 𝒟dc] [Category ℰdc] [HasPullbacks 𝒟dc]
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (D : DAlgContext K 𝒟dc ℰdc) :
    qOmegaDAlg D ⋙ D.forget ≅ qOmega K :=
  sorry

/-- API `qOmegaDAlg.isPullback`: it is the pullback, in derived commutative algebras, of the
lifted corners. -/
theorem qOmegaDAlg.isPullback {𝒟dc ℰdc : Type*} [Category 𝒟dc] [Category ℰdc] [HasPullbacks 𝒟dc]
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (D : DAlgContext K 𝒟dc ℰdc) (S : SmoothAlg A) :
    ∃ (fst : (qOmegaDAlg D).obj S ⟶ D.cornerP.obj S) (snd : (qOmegaDAlg D).obj S ⟶ D.cornerR.obj S),
      IsPullback fst snd (D.rightD.app S) (D.lowerD.app S) := by
  sorry

/-- API `qOmegaDAlg.corners`: on the corners the structure is that of the cosimplicial
realisations; for the de Rham corner, `Ω*_{S/A} ≃ Tot D^•` as derived commutative algebras. -/
theorem qOmegaDAlg.corners {𝒟dc ℰdc : Type*} [Category 𝒟dc] [Category ℰdc]
    [HasLimitsOfShape SimplexCategory ℰdc] {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod}
    (D : DAlgContext K 𝒟dc ℰdc) (S : SmoothAlg A) :
    Nonempty (D.deRhamD.obj S ≅ limit (D.pdNerve.obj S ⋙ D.staticD)) ∧
    Nonempty (D.forget.obj (D.cornerP.obj S) ≅ ∏ᶜ fun p => (K.localQOmega p).obj S) ∧
    Nonempty (D.forget.obj (D.cornerR.obj S) ≅ K.powerSeries.obj (K.ratE.obj (K.deRham.obj S))) := by
  sorry

/-- API `qOmegaDAlg.map`: functoriality in `S`. -/
def qOmegaDAlg.map {𝒟dc ℰdc : Type*} [Category 𝒟dc] [Category ℰdc] [HasPullbacks 𝒟dc]
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (D : DAlgContext K 𝒟dc ℰdc) {S S' : SmoothAlg A}
    (f : S ⟶ S') : (qOmegaDAlg D).obj S ⟶ (qOmegaDAlg D).obj S' :=
  (qOmegaDAlg D).map f

/-- **Lemma (HQ.1/the-de-rham-complex-as-a-totalisation-of-pd-envelopes).** `Ω*_{S/A} ≃ Tot D^•`
for the PD envelopes `D^•` of the Čech nerve of `A → P`, as derived commutative `A`-algebras
(hence as `E∞`-algebras). -/
theorem deRham_eq_tot_pdEnvelope {𝒟dc ℰdc : Type*} [Category 𝒟dc] [Category ℰdc]
    [HasLimitsOfShape SimplexCategory ℰdc] [HasLimitsOfShape SimplexCategory ℰ]
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (D : DAlgContext K 𝒟dc ℰdc) (S : SmoothAlg A) :
    Nonempty (D.deRhamD.obj S ≅ limit (D.pdNerve.obj S ⋙ D.staticD)) ∧
    Nonempty (K.deRham.obj S ≅ limit (D.pdNerve.obj S ⋙ K.staticE)) := by
  sorry

/-- Unit test `qOmegaDAlg_forget`: the forgetful functor recovers the `E∞` q-de Rham complex, with
its properties (a) to (c). -/
example {𝒟dc ℰdc : Type*} [Category 𝒟dc] [Category ℰdc] [HasPullbacks 𝒟dc]
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (D : DAlgContext K 𝒟dc ℰdc) :
    Nonempty (qOmegaDAlg D ⋙ D.forget ≅ qOmega K) ∧
    Nonempty (qOmegaDAlg D ⋙ D.forget ⋙ K.modQ ≅ K.deRham) ∧
    (∀ p, Nonempty (qOmegaDAlg D ⋙ D.forget ⋙ K.pComplete p ≅ K.localQOmega p)) ∧
    Nonempty (qOmegaDAlg D ⋙ D.forget ⋙ K.rat ≅ K.deRham ⋙ K.ratE ⋙ K.powerSeries) := by
  sorry

/-- Unit test `qOmegaDAlg_modQSubOne`: modulo `q - 1` the lift is `Ω*_{S/A}` with the derived
commutative structure of its cdga structure. -/
example {𝒟dc ℰdc : Type*} [Category 𝒟dc] [Category ℰdc] [HasPullbacks 𝒟dc]
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (D : DAlgContext K 𝒟dc ℰdc) :
    Nonempty (qOmegaDAlg D ⋙ D.modQD ≅ D.deRhamD) := by
  sorry

/-- Unit test `deRham_ne_zerothEnvelope`: for `A = S = ℤ` the zeroth PD envelope is a divided power
polynomial algebra, not `ℤ = Tot D^• = Ω*_{ℤ/ℤ}`: the zeroth term is not the totalisation. -/
example {Λℤ : LambdaRing ℤ} {K : QDeRhamContext ℤ Λℤ Ani 𝒟 ℰ Mod} {𝒟dc ℰdc : Type*}
    [Category 𝒟dc] [Category ℰdc] [HasLimitsOfShape SimplexCategory ℰ]
    (D : DAlgContext K 𝒟dc ℰdc) :
    ¬ Nonempty ((D.pdNerve.obj (SmoothAlg.of ℤ)).obj (SimplexCategory.mk 0) ≅ CommAlgCat.of ℤ ℤ) ∧
    Nonempty (K.deRham.obj (SmoothAlg.of ℤ) ≅ limit (D.pdNerve.obj (SmoothAlg.of ℤ) ⋙ K.staticE)) := by
  sorry

/-- Unit test `qOmegaDAlg_base`: for `S = A` the lift is the unit `A⟦q-1⟧`. -/
example {𝒟dc ℰdc : Type*} [Category 𝒟dc] [Category ℰdc] [HasPullbacks 𝒟dc]
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (D : DAlgContext K 𝒟dc ℰdc) :
    Nonempty ((qOmegaDAlg D).obj (SmoothAlg.of A) ≅ D.oneD) := by
  sorry

end HQ1

/-! ## HQ.2 — Filtered conventions, the coefficient ring, and the derived q-de Rham complex -/

section HQ2

variable {A : Type u} [CommRing A]

/-! ### Conventions (node HQ.2/filtered-graded-and-completion-conventions)

Imported from DerivedDeRhamCohomology DD.1 and EnhancedDerivedSheaves E1, E4; this roadmap only
fixes the conventions of the source's paragraph 1.22. A descending `ℤ`-indexed filtered object
of `𝒞` is a functor `ℤᵒᵖ ⥤ 𝒞` (so `fil^{n+1} → fil^n`), and one constant in degrees `≤ 0` a
functor `ℕᵒᵖ ⥤ 𝒞`. -/

section Conventions

variable {𝒞 : Type*} [Category 𝒞]

/-- Descending `ℤ`-indexed filtered objects. -/
abbrev FilZ (𝒞 : Type*) [Category 𝒞] := ℤᵒᵖ ⥤ 𝒞

/-- The transition map `fil^{n+1} → fil^n`. -/
def FilZ.trans (F : FilZ 𝒞) (n : ℤ) : F.obj (op (n + 1)) ⟶ F.obj (op n) :=
  F.map (homOfLE (by omega : n ≤ n + 1)).op

/-- `gr^n = cofib(fil^{n+1} → fil^n)`. -/
def FilZ.gr [Preadditive 𝒞] [HasFiniteColimits 𝒞] (F : FilZ 𝒞) (n : ℤ) : 𝒞 :=
  cokernel (F.trans n)

/-- Complete: `lim_{n → ∞} fil^n ≃ 0` (the limit of a functor out of `ℤᵒᵖ`). -/
def FilZ.IsComplete [HasLimitsOfShape ℤᵒᵖ 𝒞] (F : FilZ 𝒞) : Prop := IsZero (limit F)

/-- Exhaustive with underlying object `X`: `colim_{n → -∞} fil^n ≃ X`. -/
def FilZ.IsExhaustive [HasColimitsOfShape ℤᵒᵖ 𝒞] (F : FilZ 𝒞) (X : 𝒞) : Prop :=
  Nonempty (colimit F ≅ X)

/-- The transition map `fil^{n+1} → fil^n` of an `ℕ`-indexed filtered object. -/
def FilN.trans (F : ℕᵒᵖ ⥤ 𝒞) (n : ℕ) : F.obj (op (n + 1)) ⟶ F.obj (op n) :=
  F.map (homOfLE (Nat.le_succ n)).op

/-- `gr^n` of an `ℕ`-indexed filtered object. -/
def FilN.gr [Preadditive 𝒞] [HasFiniteColimits 𝒞] (F : ℕᵒᵖ ⥤ 𝒞) (n : ℕ) : 𝒞 :=
  cokernel (FilN.trans F n)

/-- The tower `n ↦ cofib(fil^n → fil^0)`, whose limit is the completion. -/
def FilN.cofibTower [Preadditive 𝒞] [HasFiniteColimits 𝒞] (F : ℕᵒᵖ ⥤ 𝒞) : ℕᵒᵖ ⥤ 𝒞 := sorry

theorem FilN.cofibTower_obj [Preadditive 𝒞] [HasFiniteColimits 𝒞] (F : ℕᵒᵖ ⥤ 𝒞) (n : ℕ) :
    Nonempty ((FilN.cofibTower F).obj (op n) ≅ cokernel (F.map (homOfLE (Nat.zero_le n)).op)) := by
  sorry

/-- The completion `lim_n cofib(fil^n → fil^0)` of the underlying object. -/
def FilN.completion [Preadditive 𝒞] [HasFiniteColimits 𝒞] [HasLimitsOfShape ℕᵒᵖ 𝒞]
    (F : ℕᵒᵖ ⥤ 𝒞) : 𝒞 :=
  limit (FilN.cofibTower F)

/-- The derived quotient `M/f = cofib(f : M → M)`. -/
def quotBy [Preadditive 𝒞] [HasFiniteColimits 𝒞] {R : Type*} [Semiring R] [Linear R 𝒞]
    (f : R) (M : 𝒞) : 𝒞 :=
  cokernel (f • 𝟙 M)

/-- Derived against ordinary quotient: for `M = ℤ/p` and `f = p`, multiplication by `p` is zero,
so the derived quotient has homology `ℤ/p` in two degrees, the ordinary quotient in one. -/
theorem derivedQuotient_zmod (p : ℕ) [Fact p.Prime] :
    ((p : ℤ) • LinearMap.id : ZMod p →ₗ[ℤ] ZMod p) = 0 ∧ Nontrivial (ZMod p) := by
  refine ⟨?_, inferInstance⟩
  ext x
  simp

/-- The detection principle needs completeness: `ℚ/p = 0` although `ℚ ≠ 0`. -/
theorem detection_needs_completeness (p : ℕ) [Fact p.Prime] :
    Ideal.span {(p : ℚ)} = ⊤ ∧ Nontrivial ℚ := by
  refine ⟨?_, inferInstance⟩
  rw [Ideal.span_singleton_eq_top]
  exact isUnit_iff_ne_zero.mpr (by exact_mod_cast (Fact.out : p.Prime).ne_zero)

/-- The `(q-1)`-adic filtration on `A⟦q-1⟧`: `gr^n` is free of rank one on the class of
`(q-1)^n` for `n ≥ 0`. -/
theorem gr_qAdic_powerSeries (n : ℕ) (f : PowerSeries A)
    (hf : f ∈ (Ideal.span {(PowerSeries.X : PowerSeries A)}) ^ n) :
    ∃! a : A, f - PowerSeries.C a * PowerSeries.X ^ n ∈
      (Ideal.span {(PowerSeries.X : PowerSeries A)}) ^ (n + 1) := by
  sorry

end Conventions

/-! ### Filtered modules over `f^⋆A[q]`, in the graded presentation -/

section FilModule

variable {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear A[X] 𝒞]

/-- A filtered module over the filtered ring `f^⋆A[q]` (with `f ∈ A[q]` in filtration degree
one, for instance `f = q^m - 1` or `f = Φ_{p^a}(q)`), constant in degrees `≤ 0`, in its graded
presentation: `t` is the transition `fil^{n+1} → fil^n`, `β` the multiplication by `f` into the
next step, and `βt = tβ = f`. -/
structure FilModule (f : A[X]) (𝒞 : Type*) [Category 𝒞] [Preadditive 𝒞] [Linear A[X] 𝒞] where
  /-- The filtration. -/
  fil : ℕᵒᵖ ⥤ 𝒞
  /-- `β`: multiplication by `f` from `fil^n` to `fil^{n+1}`. -/
  mul : ∀ n : ℕ, fil.obj (op n) ⟶ fil.obj (op (n + 1))
  mul_trans : ∀ n : ℕ, mul n ≫ FilN.trans fil n = f • 𝟙 _
  trans_mul : ∀ n : ℕ, FilN.trans fil n ≫ mul n = f • 𝟙 _

namespace FilModule

variable {f : A[X]}

instance : Category (FilModule f 𝒞) where
  Hom M N := { α : M.fil ⟶ N.fil // ∀ n, M.mul n ≫ α.app (op (n + 1)) = α.app (op n) ≫ N.mul n }
  id M := ⟨𝟙 _, fun n => by simp⟩
  comp α β := ⟨α.1 ≫ β.1, fun n => by
    simp only [NatTrans.comp_app]
    rw [← Category.assoc, α.2 n, Category.assoc, β.2 n, Category.assoc]⟩
  id_comp _ := Subtype.ext (Category.id_comp _)
  comp_id _ := Subtype.ext (Category.comp_id _)
  assoc _ _ _ := Subtype.ext (Category.assoc _ _ _)

/-- Transport along an `A[q]`-linear functor (for instance rationalisation or completion,
applied degreewise). -/
def map {𝒞' : Type*} [Category 𝒞'] [Preadditive 𝒞'] [Linear A[X] 𝒞'] (G : 𝒞 ⥤ 𝒞')
    [G.Linear A[X]] (M : FilModule f 𝒞) : FilModule f 𝒞' where
  fil := M.fil ⋙ G
  mul n := G.map (M.mul n)
  mul_trans n := by
    simp only [FilN.trans, Functor.comp_map, ← G.map_comp]
    rw [← FilN.trans, M.mul_trans, Functor.map_smul, G.map_id]
    rfl
  trans_mul n := by
    simp only [FilN.trans, Functor.comp_map, ← G.map_comp]
    rw [← FilN.trans, M.trans_mul, Functor.map_smul, G.map_id]
    rfl

/-- The `f`-adic filtration `f^⋆ M` of an object on which `f` acts injectively: every step is `M`,
the transitions are multiplication by `f` and `β` is the identity. -/
def adic (f : A[X]) (M : 𝒞) : FilModule f 𝒞 where
  fil := sorry
  mul _ := sorry
  mul_trans := sorry
  trans_mul := sorry

theorem adic_fil_obj (f : A[X]) (M : 𝒞) (n : ℕ) : (adic f M).fil.obj (op n) = M := by
  sorry

variable [HasFiniteColimits 𝒞]

/-- `M(1)`: the shifted filtration `n ↦ fil^{n-1}` (with `fil^{-1} = fil^0`). -/
def shift (M : FilModule f 𝒞) : ℕᵒᵖ ⥤ 𝒞 := sorry

/-- `β : M(1) → M`, which is multiplication by `f` on `fil^0` in degree zero. -/
def beta (M : FilModule f 𝒞) : M.shift ⟶ M.fil := sorry

end FilModule

end FilModule

/-! ### The graded presentation of the coefficient ring
(node HQ.2/the-graded-presentation-of-the-coefficient-ring) -/

/-- The relation `βt - (q^m - 1)` in `A[q, β, t]`, with `q = X 0`, `β = X 1`, `t = X 2`. -/
def coefficientRelation (A : Type u) [CommRing A] (m : ℕ) : MvPolynomial (Fin 3) A :=
  MvPolynomial.X 1 * MvPolynomial.X 2 - (MvPolynomial.X 0 ^ m - 1)

/-- **Definition (HQ.2/the-graded-presentation-of-the-coefficient-ring).** API `coefficientRing`:
the graded ring `A[q, β, t]/(βt - (q^m - 1))` with `|q| = 0`, `|β| = 1`, `|t| = -1`. For `m = 1`
it is the polynomial ring `A[β, t]` with `q = 1 + βt`. It corresponds to the filtered ring
`(q^m - 1)^⋆ A[q]`: `t` is the filtration parameter, `β` is `q^m - 1` in filtration degree one. -/
abbrev coefficientRing (A : Type u) [CommRing A] (m : ℕ) : Type u :=
  MvPolynomial (Fin 3) A ⧸ Ideal.span {coefficientRelation A m}

namespace coefficientRing

/-- The grading `|q| = 0`, `|β| = 1`, `|t| = -1`. -/
def weights : Fin 3 → ℤ := ![0, 1, -1]

variable (A) in
/-- `q`. -/
def q (m : ℕ) : coefficientRing A m := Ideal.Quotient.mk _ (MvPolynomial.X 0)

variable (A) in
/-- `β`, in degree `1`. -/
def β (m : ℕ) : coefficientRing A m := Ideal.Quotient.mk _ (MvPolynomial.X 1)

variable (A) in
/-- `t`, in degree `-1`. -/
def t (m : ℕ) : coefficientRing A m := Ideal.Quotient.mk _ (MvPolynomial.X 2)

/-- The relation is homogeneous of degree `0`, so the grading descends. -/
theorem relation_isWeightedHomogeneous (m : ℕ) :
    (coefficientRelation A m).IsWeightedHomogeneous weights 0 := by
  sorry

/-- API `coefficientRing.q_eq`: `βt = q^m - 1`; for `m = 1`, `q = 1 + βt`. -/
theorem q_eq (m : ℕ) : β A m * t A m = q A m ^ m - 1 ∧ (m = 1 → q A m = 1 + β A m * t A m) := by
  sorry

/-- The Rees evaluation `q ↦ q`, `β ↦ q^m - 1`, `t ↦ 1`. -/
def reesEval (m : ℕ) : coefficientRing A m →ₐ[A] A[X] :=
  Ideal.Quotient.liftₐ _ (MvPolynomial.aeval ![(X : A[X]), X ^ m - 1, 1]) sorry

/-- API `coefficientRing.equivFiltered`, ring-level content: the Rees evaluation identifies the
degree-`n` part with `(q^m - 1)^n A[q]` for `n ≥ 0` and with `A[q]` for `n ≤ 0`, injectively;
so graded `coefficientRing`-modules are filtered `(q^m - 1)^⋆ A[q]`-modules (for modules in a
stable category this is the definition `FilModule (X ^ m - 1)`). -/
theorem equivFiltered (m : ℕ) (hm : 1 ≤ m) :
    (∀ n : ℕ, (fun g => reesEval m (Ideal.Quotient.mk _ g)) ''
        (MvPolynomial.weightedHomogeneousSubmodule A weights (n : ℤ) : Set (MvPolynomial (Fin 3) A)) =
      ((Ideal.span {(X : A[X]) ^ m - 1} ^ n : Ideal A[X]) : Set A[X])) ∧
    (∀ n : ℕ, (fun g => reesEval m (Ideal.Quotient.mk _ g)) ''
        (MvPolynomial.weightedHomogeneousSubmodule A weights (-(n : ℤ)) :
          Set (MvPolynomial (Fin 3) A)) = Set.univ) ∧
    ∀ (k : ℤ) (g : MvPolynomial (Fin 3) A),
      g ∈ MvPolynomial.weightedHomogeneousSubmodule A weights k →
        reesEval m (Ideal.Quotient.mk _ g) = 0 → Ideal.Quotient.mk (Ideal.span {coefficientRelation A m}) g = 0 := by
  sorry

/-- API `coefficientRing.mod_t`: modding out `t` is passage to the associated graded
`⊕_n (q^m-1)^n A[q]/(q^m-1)^{n+1} = (A[q]/(q^m-1))[β]`. -/
def mod_t (m : ℕ) :
    (coefficientRing A m ⧸ Ideal.span {t A m}) ≃ₐ[A]
      (MvPolynomial (Fin 2) A ⧸ Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) A) ^ m - 1}) :=
  sorry

/-- API `coefficientRing.mod_beta`: modding out `β` is the quotient by `q^m - 1` in filtration
degree one: `A[q]/(q^m - 1)` with its trivial filtration, i.e. `(A[q]/(q^m - 1))[t]` with `t` in
degree `-1`. -/
def mod_beta (m : ℕ) :
    (coefficientRing A m ⧸ Ideal.span {β A m}) ≃ₐ[A]
      (MvPolynomial (Fin 2) A ⧸ Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) A) ^ m - 1}) :=
  sorry

/-- API `coefficientRing.mod_beta_t`: modding out both is `A[q]/(q^m - 1)`, the associated graded
of the quotient by `β`. -/
def mod_beta_t (m : ℕ) :
    (coefficientRing A m ⧸ Ideal.span {β A m, t A m}) ≃ₐ[A] (A[X] ⧸ Ideal.span {(X : A[X]) ^ m - 1}) :=
  sorry

/-- API `coefficientRing.equivFiltered` in its module form: filtered `(q^m-1)^⋆A[q]`-modules in a
stable `A[q]`-linear category are, by definition, `FilModule (X ^ m - 1)`: graded modules over
`coefficientRing A m` with `β = mul` and `t` the transition. -/
abbrev FilModuleOver (A : Type u) [CommRing A] (m : ℕ) (𝒞 : Type*) [Category 𝒞] [Preadditive 𝒞]
    [Linear A[X] 𝒞] : Type _ :=
  FilModule ((X : A[X]) ^ m - 1) 𝒞

end coefficientRing

/-- Unit test `coefficientRing_relation`: in `A[β, t]`, `βt = q - 1` and `q = 1 + βt`; the relation
is homogeneous of degree `0` for `|β| = 1`, `|t| = -1`; and `βt ≠ q` (the q-adic presentation). -/
example [Nontrivial A] :
    coefficientRing.β A 1 * coefficientRing.t A 1 = coefficientRing.q A 1 - 1 ∧
    coefficientRing.q A 1 = 1 + coefficientRing.β A 1 * coefficientRing.t A 1 ∧
    (coefficientRelation A 1).IsWeightedHomogeneous coefficientRing.weights 0 ∧
    coefficientRing.β A 1 * coefficientRing.t A 1 ≠ coefficientRing.q A 1 := by
  sorry

/-- Unit test `coefficientRing_mod_t`: `A[β, t]/t` is `A[β]` (the associated graded of the
`(q-1)`-adic filtration), and `q ↦ 1` in it. -/
example :
    Ideal.Quotient.mk (Ideal.span {coefficientRing.t A 1}) (coefficientRing.q A 1) = 1 ∧
    Nonempty ((coefficientRing A 1 ⧸ Ideal.span {coefficientRing.t A 1}) ≃ₐ[A] A[X]) := by
  sorry

/-- Unit test `coefficientRing_mod_beta`: `A[β, t]/β` is `A[t]`, the filtered ring `A` with its
trivial filtration, and `q ↦ 1`. -/
example :
    Ideal.Quotient.mk (Ideal.span {coefficientRing.β A 1}) (coefficientRing.q A 1) = 1 ∧
    Nonempty ((coefficientRing A 1 ⧸ Ideal.span {coefficientRing.β A 1}) ≃ₐ[A] A[X]) := by
  sorry

/-- Unit test `coefficientRing_q_ne_zero`: modulo `β` the image of `q` is `1`, not `0`. -/
example [Nontrivial A] :
    Ideal.Quotient.mk (Ideal.span {coefficientRing.β A 1}) (coefficientRing.q A 1) ≠ 0 := by
  sorry

/-! ### The quotient convention (node HQ.2/the-quotient-convention-for-filtered-modules) -/

section Quotient

variable {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear A[X] 𝒞] [HasFiniteColimits 𝒞]
  {f : A[X]}

/-- The quotient functor `fil^⋆M ↦ fil^⋆M/f`, the base change along `f^⋆A[q] → A[q]/f` (trivially
filtered target), i.e. with `f` in filtration degree ONE. -/
def filQuotientFunctor (f : A[X]) (𝒞 : Type*) [Category 𝒞] [Preadditive 𝒞] [Linear A[X] 𝒞]
    [HasFiniteColimits 𝒞] : FilModule f 𝒞 ⥤ (ℕᵒᵖ ⥤ 𝒞) :=
  sorry

/-- **Definition (HQ.2/the-quotient-convention-for-filtered-modules).** API `filQuotient`:
`fil^⋆M/(q^m - 1)`, always with `q^m - 1` in filtration degree one. -/
def filQuotient (M : FilModule f 𝒞) : ℕᵒᵖ ⥤ 𝒞 := (filQuotientFunctor f 𝒞).obj M

/-- API `filQuotient.piece`: the `(n+1)`-st piece is `cofib(f : fil^n → fil^{n+1})`. -/
def filQuotient.piece (M : FilModule f 𝒞) (n : ℕ) :
    (filQuotient M).obj (op (n + 1)) ≅ cokernel (M.mul n) :=
  sorry

/-- API `filQuotient.piece_of_nonpos`: in degrees `≤ 0` (the filtration being constant there) the
piece is the ordinary derived quotient `M/f` of the underlying object. -/
def filQuotient.piece_of_nonpos (M : FilModule f 𝒞) :
    (filQuotient M).obj (op 0) ≅ quotBy f (M.fil.obj (op 0)) :=
  sorry

/-- API `filQuotient.eq_mod_beta`: in the graded presentation the quotient is `cofib(β : M(1) → M)`,
as filtered objects. -/
def filQuotient.eq_mod_beta (M : FilModule f 𝒞) : filQuotient M ≅ cokernel M.beta :=
  sorry

/-- API `filQuotient.map`: functoriality. (Its symmetric monoidality for Day convolution, as a base
change, needs the monoidal structure on filtered modules of DD.1 and is not stated.) -/
def filQuotient.map {M N : FilModule f 𝒞} (φ : M ⟶ N) : filQuotient M ⟶ filQuotient N :=
  (filQuotientFunctor f 𝒞).map φ

/-- Unit test `filQuotient_coefficientRing`: for `(q-1)^⋆A[q]` and `m = 1`, multiplication by
`q - 1` from `(q-1)^{n-1}A[q]` onto `(q-1)^n A[q]` is bijective for `n ≥ 1` and the degree-zero
piece is `A[q]/(q-1) = A`: the quotient is the unit filtered ring `A`. -/
example (n : ℕ) (hn : 1 ≤ n) :
    (∀ y ∈ Ideal.span {(X : A[X]) - 1} ^ n,
      ∃! x, x ∈ Ideal.span {(X : A[X]) - 1} ^ (n - 1) ∧ (X - 1) * x = y) ∧
    Nonempty ((A[X] ⧸ Ideal.span {(X : A[X]) - C 1}) ≃ₐ[A] A) := by
  sorry

/-- Unit test `filQuotient_piece_of_nonpos`: in filtration degrees `≤ 0`, for a filtration constant
there, the quotient is the ordinary derived quotient of the underlying object. -/
example (M : FilModule f 𝒞) : Nonempty ((filQuotient M).obj (op 0) ≅ cokernel (f • 𝟙 (M.fil.obj (op 0)))) :=
  ⟨filQuotient.piece_of_nonpos M⟩

/-- Unit test `filQuotient_ne_degreewise`: the degreewise quotient of `(q-1)^⋆A[q]` by `q - 1`
has first piece `(q-1)A[q]/(q-1)^2 A[q] ≅ A ≠ 0`, while the convention gives `0` there. -/
example [Nontrivial A] :
    ¬ (Ideal.span {(X : A[X]) - 1} ≤ Ideal.span {(X : A[X]) - 1} ^ 2) := by
  sorry

/-- Unit test `filQuotient_eq_mod_beta`: under the graded presentation, the quotient is
`cofib(β : M(1) → M)`. -/
example (M : FilModule f 𝒞) (n : ℕ) :
    Nonempty ((filQuotient M).obj (op (n + 1)) ≅ cokernel (M.mul n)) ∧
    Nonempty (filQuotient M ≅ cokernel M.beta) :=
  ⟨⟨filQuotient.piece M n⟩, ⟨filQuotient.eq_mod_beta M⟩⟩

end Quotient

/-! ### The derived q-de Rham complex (node HQ.2/the-derived-q-de-rham-complex) -/

section Derived

variable {Λ : LambdaRing A} {Ani 𝒟 ℰ Mod : Type*} [Category Ani] [Category 𝒟] [Category ℰ]
  [Category Mod] [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ] [HasPullbacks 𝒟]

/-- **Construction (HQ.2/the-derived-q-de-rham-complex).** API `qdR`: the derived q-de Rham
complex, the animation of the global q-de Rham complex, a sifted-colimit-preserving functor from
animated `A`-algebras to `(q-1)`-complete `E∞`-algebras over `A⟦q-1⟧`. -/
def qdR (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) : Ani ⥤ 𝒟 :=
  K.animate (PolyAlg.toSmooth A ⋙ qOmega K)

/-- API `qdR.onPolynomial`: on polynomial algebras in finitely many variables it is `qΩ_{−/A}`
(and not on all smooth algebras). -/
def qdR.onPolynomial (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) :
    K.ofPoly ⋙ qdR K ≅ PolyAlg.toSmooth A ⋙ qOmega K :=
  K.animate_restrict _

/-- API `qdR.ofResolution`: for a simplicial resolution `P_• → R` by polynomial algebras, `qdR_{R/A}`
is the `(q-1)`-completed geometric realisation of `qΩ_{P_•/A}` (colimits in `𝒟` are completed
colimits), independently of the resolution. -/
def qdR.ofResolution (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod)
    [HasColimitsOfShape SimplexCategoryᵒᵖ 𝒟] (P : SimplexCategoryᵒᵖ ⥤ PolyAlg A)
    (c : Cocone (P ⋙ K.ofPoly)) (hc : IsColimit c) :
    (qdR K).obj c.pt ≅ colimit (P ⋙ PolyAlg.toSmooth A ⋙ qOmega K) :=
  sorry

/-- API `qdR.modQSubOne`: `qdR_{R/A}/(q-1) ≃ dR_{R/A}`. -/
def qdR.modQSubOne (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) : qdR K ⋙ K.modQ ≅ K.dR :=
  sorry

/-- API `qdR.pCompletion`: `(qdR_{R/A})^∧_p ≃ qdR_{R̂_p/Â_p}`. -/
def qdR.pCompletion (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes) :
    qdR K ⋙ K.pComplete p ≅ qdRLocal K p :=
  sorry

/-- The right map of the derived fracture square (from the uniform bound). -/
def qdR.rightMap (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (R : Ani) :
    (∏ᶜ fun p => (qdRLocal K p).obj R) ⟶
      K.powerSeries.obj (K.ratE.obj (∏ᶜ fun p => (dRLocal K p).obj R)) :=
  K.ratUnit.app _ ≫ (uniformBoundEquiv K R).inv

/-- The lower map of the derived fracture square. -/
def qdR.lowerMap (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (R : Ani) :
    K.powerSeries.obj (K.ratE.obj (K.dR.obj R)) ⟶
      K.powerSeries.obj (K.ratE.obj (∏ᶜ fun p => (dRLocal K p).obj R)) :=
  K.powerSeries.map (K.ratE.map (Limits.Pi.lift fun p => (K.pCompleteEUnit p).app (K.dR.obj R)))

/-- API `qdR.isPullback`: for every animated `A`-algebra, `qdR_{R/A}` is the pullback of
`∏_p qdR_{R̂_p/Â_p} → (∏_p dR_{R̂_p/Â_p} ⊗^L ℚ)⟦q-1⟧ ← (dR_{R/A} ⊗^L ℚ)⟦q-1⟧`. -/
theorem qdR.isPullback (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (R : Ani) :
    ∃ (fst : (qdR K).obj R ⟶ ∏ᶜ fun p => (qdRLocal K p).obj R)
      (snd : (qdR K).obj R ⟶ K.powerSeries.obj (K.ratE.obj (K.dR.obj R))),
      IsPullback fst snd (qdR.rightMap K R) (qdR.lowerMap K R) := by
  sorry

/-- API `qdR.leftKanExtension`: it preserves sifted colimits and is the unique such extension of
its restriction to polynomial algebras. -/
theorem qdR.leftKanExtension (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) :
    (∀ (J : Type) [SmallCategory J] [IsSifted J], PreservesColimitsOfShape J (qdR K)) ∧
    ∀ G : Ani ⥤ 𝒟, (∀ (J : Type) [SmallCategory J] [IsSifted J], PreservesColimitsOfShape J G) →
      (K.ofPoly ⋙ G ≅ PolyAlg.toSmooth A ⋙ qOmega K) → Nonempty (G ≅ qdR K) :=
  ⟨fun J _ _ => K.animate_sifted _ J, fun G hG e => K.animate_unique _ G hG e⟩

/-- API `qdR.toDAlg`: the lift to `(q-1)`-complete derived commutative `A⟦q-1⟧`-algebras. -/
def qdR.toDAlg {𝒟dc ℰdc : Type*} [Category 𝒟dc] [Category ℰdc]
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (D : DAlgContext K 𝒟dc ℰdc) : Ani ⥤ 𝒟dc :=
  sorry

theorem qdR.toDAlg_forget {𝒟dc ℰdc : Type*} [Category 𝒟dc] [Category ℰdc]
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (D : DAlgContext K 𝒟dc ℰdc) :
    Nonempty (qdR.toDAlg D ⋙ D.forget ≅ qdR K) := by
  sorry

/-- API `qdR.map`: functoriality in `R`. -/
def qdR.map (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) {R R' : Ani} (f : R ⟶ R') :
    (qdR K).obj R ⟶ (qdR K).obj R' :=
  (qdR K).map f

/-- Unit test `qdR_polynomial`: for `A = ℤ` and `R = ℤ[x]`, `qdR_{R/A} = qΩ_{ℤ[x]/ℤ}`, the two-term
complex `ℤ[x]⟦q-1⟧ → ℤ[x]⟦q-1⟧ dx` with `x^n ↦ [n]_q x^{n-1} dx`. -/
example {Λℤ : LambdaRing ℤ} (K : QDeRhamContext ℤ Λℤ Ani 𝒟 ℰ Mod) :
    Nonempty (K.underlying.obj ((qdR K).obj (K.ofPoly.obj (PolyAlg.of ℤ 1))) ≅
      K.koszul (qOmegaFramed.qPartial (EtaleFraming.polyId ℤ 1))) ∧
    ∀ n : ℕ, qOmegaFramed.qPartial (EtaleFraming.polyId ℤ 1) 0
        (PowerSeries.C (MvPolynomial.X 0 ^ n)) =
      qInt n (1 + PowerSeries.X) * PowerSeries.C (MvPolynomial.X 0 ^ (n - 1)) := by
  sorry

/-- Unit test `qdR_modQSubOne`: `qdR_{R/A}/(q-1) ≃ dR_{R/A}`; for `R` polynomial this is
`Ω*_{R/A}`. -/
example (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (n : ℕ) :
    Nonempty (qdR K ⋙ K.modQ ≅ K.dR) ∧
    Nonempty (K.modQ.obj ((qdR K).obj (K.ofPoly.obj (PolyAlg.of A n))) ≅
      K.deRham.obj ((PolyAlg.toSmooth A).obj (PolyAlg.of A n))) := by
  sorry

/-- Unit test `qdR_filteredColimit`: on a filtered colimit of polynomial algebras the value is the
`(q-1)`-completed colimit of the values (a construction through limits would fail this). -/
example (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (J : Type) [SmallCategory J] [IsFiltered J]
    [HasColimitsOfShape J 𝒟] (F : J ⥤ PolyAlg A) (c : Cocone (F ⋙ K.ofPoly)) (hc : IsColimit c) :
    Nonempty ((qdR K).obj c.pt ≅ colimit (F ⋙ PolyAlg.toSmooth A ⋙ qOmega K)) := by
  sorry

/-- `ℚ[x, x⁻¹]` is smooth over `ℚ`. -/
instance smooth_laurentPolynomial : Algebra.Smooth ℚ (LaurentPolynomial ℚ) := sorry

/-- Unit test `qdR_ne_qOmega_laurent`: for `A = ℚ` and `S = ℚ[x, x⁻¹]`, `qdR_{S/ℚ} ≃ ℚ⟦q-1⟧`
(derived de Rham cohomology of a `ℚ`-algebra over `ℚ` is `ℚ`), while `qΩ_{S/ℚ} = Ω*_{S/ℚ}⟦q-1⟧`
has `H^1 ≅ ℚ⟦q-1⟧` spanned by `dx/x`. -/
example {Λℚ : LambdaRing ℚ} (K : QDeRhamContext ℚ Λℚ Ani 𝒟 ℰ Mod) :
    Nonempty ((qdR K).obj (K.ofSmooth.obj (SmoothAlg.of (LaurentPolynomial ℚ))) ≅ K.one) ∧
    ¬ Nonempty ((qdR K).obj (K.ofSmooth.obj (SmoothAlg.of (LaurentPolynomial ℚ))) ≅
      (qOmega K).obj (SmoothAlg.of (LaurentPolynomial ℚ))) := by
  sorry

/-- **Comparison (HQ.2/animation-does-not-preserve-the-values-on-smooth-algebras).** p-adically,
animation leaves the values on smooth algebras unchanged; globally it agrees with `qΩ` on
polynomial algebras only (the Laurent example above shows the failure, already at `q = 1` over
`ℚ`). The repair, `qΩ_{S/A}` as the completion of `qdR_{S/A}` at a q-Hodge filtration, is
`qdR_completion_smooth` in HQ.3. -/
theorem qdR_smooth_values (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) :
    (∀ p : Nat.Primes, Nonempty (K.ofSmooth ⋙ qdR K ⋙ K.pComplete p ≅ qOmega K ⋙ K.pComplete p)) ∧
    Nonempty (K.ofPoly ⋙ qdR K ≅ PolyAlg.toSmooth A ⋙ qOmega K) := by
  sorry

/-- **Theorem (HQ.2/derived-base-change-and-its-completion-hypotheses).** For a map of Λ-rings
`A → A′`, both p-torsion free for every `p` (not assumed flat), the canonical map
`(qdR_{R/A} ⊗^L_A A′)^∧_{(q-1)} → qdR_{(R ⊗^L_A A′)/A′}` is an equivalence; modulo `q - 1` it is
the base change for derived de Rham complexes. The completion cannot be dropped
(`powerSeries_int_tensor_rat_ne`). The source states only the smooth case. -/
def qdR.baseChange {A' : Type u} [CommRing A'] {Λ' : LambdaRing A'}
    {Ani' 𝒟' ℰ' Mod' : Type*} [Category Ani'] [Category 𝒟'] [Category ℰ'] [Category Mod']
    [HasProducts.{0} 𝒟'] [HasProducts.{0} ℰ'] [HasPullbacks 𝒟']
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} {K' : QDeRhamContext A' Λ' Ani' 𝒟' ℰ' Mod'}
    (B : BaseChange K K') : qdR K ⋙ B.bc ≅ B.bcAni ⋙ qdR K' :=
  sorry

theorem qdR_baseChange_modQ {A' : Type u} [CommRing A'] {Λ' : LambdaRing A'}
    {Ani' 𝒟' ℰ' Mod' : Type*} [Category Ani'] [Category 𝒟'] [Category ℰ'] [Category Mod']
    [HasProducts.{0} 𝒟'] [HasProducts.{0} ℰ'] [HasPullbacks 𝒟']
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} {K' : QDeRhamContext A' Λ' Ani' 𝒟' ℰ' Mod'}
    (B : BaseChange K K') (R : Ani) :
    K'.modQ.map ((qdR.baseChange B).hom.app R) =
      B.bc_modQ.hom.app ((qdR K).obj R) ≫ B.bcE.map ((qdR.modQSubOne K).hom.app R) ≫
        B.bcDR.hom.app R ≫ (qdR.modQSubOne K').inv.app (B.bcAni.obj R) := by
  sorry

/-- **Theorem (HQ.2/the-rational-comparison-for-the-derived-complex).** A functorial equivalence
`(qdR_{R/A} ⊗^L ℚ)^∧_{(q-1)} ≃ (dR_{R/A} ⊗^L ℚ)⟦q-1⟧` (rationalise, then complete). -/
def qdR.rationalComparison (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) :
    qdR K ⋙ K.rat ≅ K.dR ⋙ K.ratE ⋙ K.powerSeries :=
  sorry

/-- It is the identity of `dR_{R/A} ⊗ ℚ` modulo `q - 1`. -/
theorem qdR.rationalComparison_modQ (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (R : Ani) :
    K.modQ.map ((qdR.rationalComparison K).hom.app R) =
      K.rat_modQ.hom.app ((qdR K).obj R) ≫ K.ratE.map ((qdR.modQSubOne K).hom.app R) ≫
        K.powerSeries_modQ.inv.app (K.ratE.obj (K.dR.obj R)) := by
  sorry

/-- **Theorem (HQ.2/the-p-completed-rational-comparison).** A functorial equivalence
`((qdR_{R/A})^∧_p[1/p])^∧_{(q-1)} ≃ ((dR_{R/A})^∧_p[1/p])⟦q-1⟧` (p-complete, invert `p`, complete
at `q - 1`): Lemma A.4 applied to `R̂_p` (the source's "Lemma A.5" in Remark 1.8 is a misprint for
Lemma A.4, source issue E101). -/
def qdR.pRationalComparison (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes) :
    qdR K ⋙ K.pRat p ≅ K.dR ⋙ K.pRatE p ⋙ K.powerSeries :=
  sorry

theorem qdR.pRationalComparison_modQ (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes)
    (R : Ani) :
    K.modQ.map ((qdR.pRationalComparison K p).hom.app R) =
      (K.pRat_modQ p).hom.app ((qdR K).obj R) ≫ (K.pRatE p).map ((qdR.modQSubOne K).hom.app R) ≫
        K.powerSeries_modQ.inv.app ((K.pRatE p).obj (K.dR.obj R)) := by
  sorry

/-- The `(q-1)`-completion after inverting `p` is not redundant: `∑_n p^{-n}(q-1)^n` does not lie in
`ℤ_p⟦q-1⟧[1/p]`. -/
theorem padicPowerSeries_invP_not_complete (p : ℕ) [Fact p.Prime] (k : ℕ)
    (g : PowerSeries ℤ_[p]) :
    PowerSeries.map (PadicInt.Coe.ringHom (p := p)) g ≠
      ((p : ℚ_[p]) ^ k) • PowerSeries.mk fun n => ((p : ℚ_[p]) ^ n)⁻¹ := by
  sorry

/-- **Theorem (HQ.2/the-two-rational-comparisons-and-why-the-second-is-an-axiom).** The rational
and the p-completed rational comparisons form a commutative square with the maps from the
rationalisation to the rationalised p-completion. Whether clause (c_p) of a q-Hodge filtration
follows from (a) to (c) is an open question recorded in the source (it "does not seem to"); it is
not stated, and (c_p) is carried as a separate datum in `QHodgeFiltration`. -/
theorem qdR.rationalComparisons_square (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : Nat.Primes)
    (R : Ani) :
    (qdR.rationalComparison K).hom.app R ≫
        K.powerSeries.map ((K.ratEToPRatE p).app (K.dR.obj R)) =
      (K.ratToPRat p).app ((qdR K).obj R) ≫ (qdR.pRationalComparison K p).hom.app R := by
  sorry

/-! ### The décalage import (node HQ.2/what-the-decalage-import-supplies) -/

/-- **Owners: AInfCohomology AI.1** (the Berthelot–Ogus décalage `Lη_f` at a nonzerodivisor, its
commutation with `f`-completion, BMS I Lemma 6.20) **and PrismaticCohomology PR.3** (the relative
Frobenius equivalence `Δ_{T/B} ⊗̂_{B,φ_B} B ≃ Lη_J Δ_{T/B}`, Bhatt–Scholze Theorem 15.3, for
`(B, J) = (Â_p⟦q-1⟧, [p]_q)` and `T` the Frobenius-twisted algebra of Theorem A.1(b)). -/
structure DecalageData (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) where
  /-- `Lη_f` on `D(A⟦q-1⟧)`. -/
  Leta : A[X] → Mod ⥤ Mod
  /-- `f`-adic completion. -/
  complete : A[X] → Mod ⥤ Mod
  Leta_complete : ∀ f, Leta f ⋙ complete f ≅ complete f ⋙ Leta f
  /-- `- ⊗̂_{B,φ_B} B`, with `φ_B` given by `ψ^p` on `Â_p` and `q ↦ q^p`. -/
  frobBC : Nat.Primes → Mod ⥤ Mod
  relFrob : ∀ p : Nat.Primes, K.prismaticTwist p ⋙ K.underlying ⋙ frobBC p ≅
    K.prismaticTwist p ⋙ K.underlying ⋙ Leta (qInt p X)

/-- **Comparison (HQ.2/what-the-decalage-import-supplies), (i).** For `α ≥ 1`,
`(Lη_{[p^α]_q} qΩ_{S/A})^∧_p ≃ Lη_{[p^α]_q}(qΩ_{S/A})^∧_p`, because `qΩ_{S/A}` is `(q-1)`-complete
(so p-completion is `[p^α]_q`-completion) and `Lη_f` commutes with `f`-completion. -/
theorem decalage_pCompletion (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (Dc : DecalageData K)
    (p : Nat.Primes) (α : ℕ) (hα : 1 ≤ α) (S : SmoothAlg A) :
    Nonempty ((K.pCompleteMod p).obj ((Dc.Leta (qInt ((p : ℕ) ^ α) X)).obj
        (K.underlying.obj ((qOmega K).obj S))) ≅
      (Dc.Leta (qInt ((p : ℕ) ^ α) X)).obj ((K.pCompleteMod p).obj
        (K.underlying.obj ((qOmega K).obj S)))) := by
  sorry

/-- **Comparison (HQ.2/what-the-decalage-import-supplies), (ii).** Through
`(qΩ_{S/A})^∧_p ≃ Δ_{T/B}` (Theorem A.1(b), with its Frobenius twist), the relative Frobenius gives
`(qΩ_{S/A})^∧_p ⊗̂_{B,φ_B} B ≃ Lη_{[p]_q}(qΩ_{S/A})^∧_p`. Part (iii) is `qdR_completion_smooth`
(b) in HQ.3. -/
theorem decalage_relativeFrobenius (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (Dc : DecalageData K)
    (p : Nat.Primes) (S : SmoothAlg A) :
    Nonempty ((Dc.frobBC p).obj (K.underlying.obj ((K.pComplete p).obj ((qOmega K).obj S))) ≅
      (Dc.Leta (qInt p X)).obj (K.underlying.obj ((K.pComplete p).obj ((qOmega K).obj S)))) := by
  sorry

/-! ### The combined Hodge and `(q-1)`-adic filtration
(node HQ.2/the-combined-hodge-and-q-minus-one-adic-filtration) -/

/-- **Owners: DerivedDeRhamCohomology DD.1** (filtered objects of `D(A[q])`, completion and the
completed filtered tensor product), **DD.2** (the Hodge filtration on derived de Rham cohomology,
before completion), **EnhancedDerivedSheaves E1** (`D(A[q])` with its `A[q]`-linear structure).
The stable `A[q]`-linear category `𝒞 = D(A[q])` and its relation to `𝒟` and `ℰ`. -/
structure HodgeContext (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (𝒞 : Type*) [Category 𝒞]
    [Preadditive 𝒞] [Linear A[X] 𝒞] [HasFiniteColimits 𝒞] where
  /-- Underlying `A[q]`-module. -/
  forget : 𝒟 ⥤ 𝒞
  /-- Underlying `A`-module, with `q` acting as `1`. -/
  forgetE : ℰ ⥤ 𝒞
  /-- `D(A⟦q-1⟧) → D(A[q])`, restriction of scalars. -/
  ofMod : Mod ⥤ 𝒞
  /-- The derived quotient by `q - 1` of an underlying module is that of the algebra. -/
  forget_modQ : ∀ Y : 𝒟, quotBy ((X : A[X]) - 1) (forget.obj Y) ≅ forgetE.obj (K.modQ.obj Y)
  /-- DD.2: the Hodge filtration `fil^⋆_Hdg dR_{R/A}`. -/
  hodgeFil : Ani ⥤ (ℕᵒᵖ ⥤ 𝒞)
  hodgeFil_zero : hodgeFil ⋙ (evaluation ℕᵒᵖ 𝒞).obj (op 0) ≅ K.dR ⋙ forgetE
  /-- DD.2: the Hodge (stupid) filtration of the de Rham complex `Ω*_{S/A}` of a smooth algebra. -/
  hodgeFilSmooth : SmoothAlg A ⥤ (ℕᵒᵖ ⥤ 𝒞)
  /-- `(- ⊗ ℚ)^∧_{(q-1)}` and `((-)^∧_p[1/p])^∧_{(q-1)}` on `𝒞` (exact functors). -/
  ratC : 𝒞 ⥤ 𝒞
  [ratC_linear : ratC.Linear A[X]]
  [ratC_exact : PreservesFiniteColimits ratC]
  pRatC : Nat.Primes → 𝒞 ⥤ 𝒞
  [pRatC_linear : ∀ p, (pRatC p).Linear A[X]]
  [pRatC_exact : ∀ p, PreservesFiniteColimits (pRatC p)]
  ratToPRatC : ∀ p, ratC ⟶ pRatC p
  forget_rat : K.rat ⋙ forget ≅ forget ⋙ ratC
  forget_pRat : ∀ p, K.pRat p ⋙ forget ≅ forget ⋙ pRatC p
  /-- `(q-1)`-completion on `𝒞`. -/
  qComplete : 𝒞 ⥤ 𝒞
  qCompleteUnit : 𝟭 𝒞 ⟶ qComplete
  /-- E1: the object of `D(A[q])` given by the subcomplex `N₀ → N₁` of a two-term complex
  `d : M₀ → M₁` of `A[q]`-modules. -/
  realiseSub : ∀ {M₀ M₁ : Type u} [AddCommGroup M₀] [AddCommGroup M₁],
    (M₀ →+ M₁) → AddSubgroup M₀ → AddSubgroup M₁ → 𝒞
  /-- E1 with AI.1: the object of `D(A[q])` given by a subcomplex `N` (stable under the
  differential) of the Koszul complex of commuting endomorphisms of `S⟦q-1⟧`. -/
  koszulSub : ∀ {S : Type u} [CommRing S] [Algebra A S] {d : ℕ},
    (Fin d → AddMonoid.End (PowerSeries S)) → AddSubgroup (Finset (Fin d) → PowerSeries S) → 𝒞

attribute [instance] HodgeContext.ratC_linear HodgeContext.pRatC_linear HodgeContext.ratC_exact
  HodgeContext.pRatC_exact

variable {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear A[X] 𝒞] [HasFiniteColimits 𝒞]

/-- **Definition (HQ.2/the-combined-hodge-and-q-minus-one-adic-filtration).** API
`combinedFiltration`: `fil^⋆_{(Hdg,q-1)}(dR_{R/A} ⊗ ℚ)⟦q-1⟧`, the `(q-1)`-completed Day
convolution of the Hodge filtration with the `(q-1)`-adic filtration of `ℚ⟦q-1⟧`: a filtered
`(q-1)^⋆(A ⊗ ℚ)[q]`-module, functorial in `R`, with `n`-th step the completion of
`colim_{i+j ≥ n} fil^i_Hdg ⊗ (q-1)^j ℚ[q]`. -/
def combinedFiltration {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (H : HodgeContext K 𝒞) :
    Ani ⥤ FilModule ((X : A[X]) - 1) 𝒞 :=
  sorry

/-- API `combinedFiltration.pComplete`: the variant on `((dR_{R/A})^∧_p[1/p])⟦q-1⟧`. -/
def combinedFiltration.pComplete {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (H : HodgeContext K 𝒞)
    (p : Nat.Primes) : Ani ⥤ FilModule ((X : A[X]) - 1) 𝒞 :=
  sorry

/-- In degrees `≤ 0` the p-completed variant is `((dR_{R/A})^∧_p[1/p])⟦q-1⟧`. -/
def combinedFiltration.pComplete_of_nonpos {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod}
    (H : HodgeContext K 𝒞) (p : Nat.Primes) (R : Ani) :
    ((combinedFiltration.pComplete H p).obj R).fil.obj (op 0) ≅
      H.forget.obj (K.powerSeries.obj ((K.pRatE p).obj (K.dR.obj R))) :=
  sorry

/-- The quotient of the p-completed variant by `q - 1` (in filtration degree one) is the
p-completed rationalised Hodge filtration. -/
def combinedFiltration.pComplete_quotient {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod}
    (H : HodgeContext K 𝒞) (p : Nat.Primes) (R : Ani) :
    filQuotient ((combinedFiltration.pComplete H p).obj R) ≅ H.hodgeFil.obj R ⋙ H.pRatC p :=
  sorry

/-- API `combinedFiltration.gr`: `gr^n ≃ ⊕_{i+j=n} gr^i_Hdg(dR_{R/A} ⊗ ℚ)·(q-1)^j`. -/
def combinedFiltration.gr {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (H : HodgeContext K 𝒞)
    (R : Ani) (n : ℕ) :
    FilN.gr ((combinedFiltration H).obj R).fil n ≅
      ∐ fun i : Fin (n + 1) => H.ratC.obj (FilN.gr (H.hodgeFil.obj R) i) :=
  sorry

/-- API `combinedFiltration.quotient`: its quotient by `q - 1` in filtration degree one is the
rationalised Hodge filtration. -/
def combinedFiltration.quotient {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (H : HodgeContext K 𝒞)
    (R : Ani) : filQuotient ((combinedFiltration H).obj R) ≅ H.hodgeFil.obj R ⋙ H.ratC :=
  sorry

/-- API `combinedFiltration.of_nonpos`: in degrees `≤ 0` it is `(dR_{R/A} ⊗ ℚ)⟦q-1⟧`. -/
def combinedFiltration.of_nonpos {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (H : HodgeContext K 𝒞)
    (R : Ani) :
    ((combinedFiltration H).obj R).fil.obj (op 0) ≅
      H.forget.obj (K.powerSeries.obj (K.ratE.obj (K.dR.obj R))) :=
  sorry

/-- API `combinedFiltration.toPComplete`: the map from the rational to the p-completed rational
variant, natural in `R`. -/
def combinedFiltration.toPComplete {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (H : HodgeContext K 𝒞)
    (p : Nat.Primes) : combinedFiltration H ⟶ combinedFiltration.pComplete H p :=
  sorry

/-- API `combinedFiltration.completion_smooth`: for `S` smooth, the completion of
`(dR_{S/A} ⊗ ℚ)⟦q-1⟧` at this filtration is `(Ω*_{S/A} ⊗ ℚ)⟦q-1⟧`. -/
def combinedFiltration.completion_smooth [HasLimitsOfShape ℕᵒᵖ 𝒞]
    {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (H : HodgeContext K 𝒞) (S : SmoothAlg A) :
    FilN.completion ((combinedFiltration H).obj (K.ofSmooth.obj S)).fil ≅
      H.forget.obj (K.powerSeries.obj (K.ratE.obj (K.deRham.obj S))) :=
  sorry

/-- Unit test `combinedFiltration_base`: for `R = A` the Hodge filtration is `A` in degree `0`, and
the combined filtration is the `(q-1)`-adic filtration of `(A ⊗ ℚ)⟦q-1⟧`. -/
example {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (H : HodgeContext K 𝒞) :
    Nonempty ((combinedFiltration H).obj (K.ofStatic.obj (CommAlgCat.of A A)) ≅
      FilModule.adic ((X : A[X]) - 1) (H.forget.obj (K.powerSeries.obj (K.ratE.obj K.oneE)))) := by
  sorry

/-- The `(q-1)`-adic step `(q-1)^n S⟦q-1⟧` of `S⟦q-1⟧`. -/
def qAdicStep (S : Type u) [CommRing S] (n : ℕ) : AddSubgroup (PowerSeries S) :=
  (((Ideal.span {(PowerSeries.X : PowerSeries S)}) ^ n : Ideal (PowerSeries S)) :
    Submodule (PowerSeries S) (PowerSeries S)).toAddSubgroup

/-- Unit test `combinedFiltration_polynomial`: for `R = A[x]` (here `A` a `ℚ`-algebra, so that
`A ⊗ ℚ = A`), the `n`-th step is the subcomplex `(q-1)^n A[x]⟦q-1⟧ → (q-1)^{max(n-1,0)} A[x]⟦q-1⟧ dx`
of `(Ω*_{A[x]/A} ⊗ ℚ)⟦q-1⟧`; in particular `fil^1` contains `dx` and `q - 1` but not `1`. -/
example [Algebra ℚ A] {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (H : HodgeContext K 𝒞) (n : ℕ) :
    Nonempty (((combinedFiltration H).obj (K.ofPoly.obj (PolyAlg.of A 1))).fil.obj (op n) ≅
      H.realiseSub (partialPS (EtaleFraming.polyId A 1) 0)
        (qAdicStep (MvPolynomial (Fin 1) A) n) (qAdicStep (MvPolynomial (Fin 1) A) (n - 1))) ∧
    (PowerSeries.X : PowerSeries (MvPolynomial (Fin 1) A)) ∈ qAdicStep (MvPolynomial (Fin 1) A) 1 ∧
    (1 : PowerSeries (MvPolynomial (Fin 1) A)) ∈ qAdicStep (MvPolynomial (Fin 1) A) (1 - 1) ∧
    (1 : PowerSeries (MvPolynomial (Fin 1) A)) ∉ qAdicStep (MvPolynomial (Fin 1) A) 1 := by
  sorry

/-- Unit test `combinedFiltration_ne_hodge`: it is not the Hodge filtration tensored with the
trivial filtration of `ℚ⟦q-1⟧`: for `R = A[x]` that would give `fil^1 = Ω^{≥1}⟦q-1⟧`, which does not
contain `q - 1`. -/
example [Algebra ℚ A] {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (H : HodgeContext K 𝒞) :
    ¬ Nonempty (((combinedFiltration H).obj (K.ofPoly.obj (PolyAlg.of A 1))).fil.obj (op 1) ≅
      H.realiseSub (partialPS (EtaleFraming.polyId A 1) 0) ⊥ ⊤) := by
  sorry

/-- Unit test `combinedFiltration_quotient`: its quotient by `q - 1` in filtration degree one is
`fil^⋆_Hdg(dR_{R/A} ⊗ ℚ)`, as the diagram of Definition 3.2(c) requires. -/
example {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} (H : HodgeContext K 𝒞) (R : Ani) :
    Nonempty (filQuotient ((combinedFiltration H).obj R) ≅ H.hodgeFil.obj R ⋙ H.ratC) :=
  ⟨combinedFiltration.quotient H R⟩

end Derived

end HQ2

/-! ## HQ.4 — Positive-degree q-de Rham–Witt theory and the Nygaard filtration

The atlas has HQ.4 → HQ.3: the twisted q-Hodge filtrations and the descent of HQ.3 are built
from the twisted q-de Rham complexes, the Nygaard filtrations and the derived q-de Rham–Witt
complexes of this stage. This section is therefore placed BEFORE the HQ.3 section. -/

section HQ4

variable {A : Type u} [CommRing A]

/-! ### Differential graded algebras (the carriers of q-V-systems) -/

/-- A commutative differential graded algebra over `R`, non-negatively and cohomologically graded:
a ring with an internal grading, a differential of degree `+1` with `d² = 0`, the graded Leibniz
rule and graded commutativity. -/
structure CDGA (R : Type u) [CommRing R] where
  /-- The underlying ring `⊕_i P^i`. -/
  carrier : Type u
  [ring : Ring carrier]
  [algebra : Algebra R carrier]
  /-- The graded pieces `P^i`. -/
  deg : ℕ → Submodule R carrier
  one_mem : (1 : carrier) ∈ deg 0
  mul_mem : ∀ {i j : ℕ} {a b : carrier}, a ∈ deg i → b ∈ deg j → a * b ∈ deg (i + j)
  isInternal : DirectSum.IsInternal deg
  /-- The differential. -/
  d : carrier →ₗ[R] carrier
  d_mem : ∀ {i : ℕ} {a : carrier}, a ∈ deg i → d a ∈ deg (i + 1)
  d_d : ∀ a, d (d a) = 0
  leibniz : ∀ {i : ℕ} {a : carrier}, a ∈ deg i → ∀ b, d (a * b) = d a * b + (-1 : R) ^ i • (a * d b)
  graded_comm : ∀ {i j : ℕ} {a b : carrier}, a ∈ deg i → b ∈ deg j →
    a * b = (-1 : R) ^ (i * j) • (b * a)

attribute [instance] CDGA.ring CDGA.algebra

instance {R : Type u} [CommRing R] : CoeSort (CDGA R) (Type u) := ⟨CDGA.carrier⟩

/-- A map of differential graded algebras. -/
structure CDGA.Hom {R : Type u} [CommRing R] (P Q : CDGA R) where
  /-- The underlying algebra map. -/
  toAlgHom : P →ₐ[R] Q
  map_deg : ∀ {i : ℕ} {a : P}, a ∈ P.deg i → toAlgHom a ∈ Q.deg i
  map_d : ∀ a, toAlgHom (P.d a) = Q.d (toAlgHom a)

/-- An isomorphism of differential graded algebras. -/
structure CDGA.Iso {R : Type u} [CommRing R] (P Q : CDGA R) where
  /-- The underlying algebra isomorphism. -/
  toAlgEquiv : P ≃ₐ[R] Q
  map_deg : ∀ {i : ℕ} {a : P}, a ∈ P.deg i ↔ toAlgEquiv a ∈ Q.deg i
  map_d : ∀ a, toAlgEquiv (P.d a) = Q.d (toAlgEquiv a)

/-- **Owner: DerivedDeRhamCohomology DD.2** (the de Rham complex as a cdga). The de Rham complex
`Ω*_{S/B}` of a `B`-algebra `S` over a ring `C` through which `B` acts: generated by
`Ω^0 = S` and `Ω^1 = Ω[S⁄B]` with `d` extending the universal derivation. -/
structure DeRhamCDGA (C : Type u) [CommRing C] (B S : Type u) [CommRing B] [CommRing S]
    [Algebra B S] where
  /-- The cdga. -/
  cdga : CDGA C
  /-- `S = Ω^0`. -/
  ofS : S →+* cdga
  ofS_mem : ∀ s, ofS s ∈ cdga.deg 0
  ofS_bijective : Function.Bijective fun s => (⟨ofS s, ofS_mem s⟩ : cdga.deg 0)
  /-- `Ω[S⁄B] = Ω^1`. -/
  ofKaehler : Ω[S⁄B] →+ cdga
  ofKaehler_mem : ∀ ω, ofKaehler ω ∈ cdga.deg 1
  ofKaehler_bijective : Function.Bijective fun ω => (⟨ofKaehler ω, ofKaehler_mem ω⟩ : cdga.deg 1)
  d_ofS : ∀ s, cdga.d (ofS s) = ofKaehler (KaehlerDifferential.D B S s)

/-! ### Relative q-Witt rings (imported) -/

/-- **Owner: HabiroRings HR.4** (`qWitt`, `qWitt.frobenius`, `qWitt.verschiebung`, `qWitt.ghost`).
The degree-zero relative q-Witt rings `qW_m(R/A)` of an `A`-algebra `R`, `A[q]/(q^m - 1)`-algebras,
with their Frobenius `F_{m/d}` (a map of algebras), Verschiebung `V_{m/d}` (a map of modules),
Teichmüller lifts `τ_m` and ghost maps `gh_{m/d} : qW_m(R/A) → R ⊗_{A,ψ^d} A[ζ_d]`; there are NO
restriction maps. -/
structure QWittRings (A : Type u) [CommRing A] (Λ : LambdaRing A) (R : Type u) [CommRing R]
    [Algebra A R] where
  /-- `qW_m(R/A)`. -/
  W : ℕ+ → Type u
  [ring : ∀ m, CommRing (W m)]
  [algebra : ∀ m, Algebra A[X] (W m)]
  qPow_sub_one : ∀ m : ℕ+, algebraMap A[X] (W m) ((X : A[X]) ^ (m : ℕ) - 1) = 0
  /-- `F_{m/d}`. -/
  frobenius : ∀ {d m : ℕ+}, d ∣ m → W m →ₐ[A[X]] W d
  /-- `V_{m/d}`. -/
  verschiebung : ∀ {d m : ℕ+}, d ∣ m → W d →ₗ[A[X]] W m
  /-- `τ_m`. -/
  teichmuller : ∀ m : ℕ+, R →* W m
  frobenius_verschiebung : ∀ {d m : ℕ+} (h : d ∣ m) (x : W d),
    frobenius h (verschiebung h x) = (((m : ℕ) / d : ℕ) : W d) * x
  verschiebung_frobenius : ∀ {d m : ℕ+} (h : d ∣ m) (x : W m),
    verschiebung h (frobenius h x) = algebraMap A[X] (W m) (qInt ((m : ℕ) / d) (X ^ (d : ℕ))) * x
  verschiebung_mul_frobenius : ∀ {d m : ℕ+} (h : d ∣ m) (x : W d) (y : W m),
    verschiebung h (x * frobenius h y) = verschiebung h x * y
  frobenius_teichmuller : ∀ {d m : ℕ+} (h : d ∣ m) (r : R),
    frobenius h (teichmuller m r) = teichmuller d r ^ ((m : ℕ) / d)
  /-- The ghost targets `R ⊗_{A,ψ^d} A[ζ_d]`. -/
  ghostTarget : ℕ+ → Type u
  [ghostRing : ∀ d, CommRing (ghostTarget d)]
  [ghostAlgebra : ∀ d, Algebra A[X] (ghostTarget d)]
  ghost : ∀ {d m : ℕ+}, d ∣ m → W m →ₐ[A[X]] ghostTarget d
  /-- Joint injectivity of the ghost maps when `R` is p-torsion free for every `p ∣ m`
  (q-Witt v5 Lemma 2.23). -/
  ghost_injective : ∀ m : ℕ+, (∀ p : ℕ, p.Prime → p ∣ (m : ℕ) → IsSMulRegular R (p : R)) →
    ∀ x y : W m, (∀ (d : ℕ+) (h : d ∣ m), ghost h x = ghost h y) → x = y

attribute [instance] QWittRings.ring QWittRings.algebra QWittRings.ghostRing
  QWittRings.ghostAlgebra

/-! ### q-V-systems (node HQ.4/q-v-systems-of-differential-graded-algebras) -/

variable {Λ : LambdaRing A} {R : Type u} [CommRing R] [Algebra A R]

/-- **Definition (HQ.4/q-v-systems-of-differential-graded-algebras).** API `QVSystem`: a q-V-system
of differential graded `A`-algebras over `R`: cdgas `P_m` over `A[q]` with (a) algebra maps
`qW_m(R/A) → P_m^0` and (b) Verschiebungen `V_{m/d} : P_d → P_m` (maps of graded modules),
compatible with those of the q-Witt rings, transitive, with the product rule and the
V-Teichmüller condition (τ_V). There are NO restriction maps. -/
structure QVSystem (QW : QWittRings A Λ R) where
  /-- The members `P_m`. -/
  P : ℕ+ → CDGA A[X]
  /-- (a): the maps `qW_m(R/A) → P_m^0` (API `QVSystem.fromQWitt`). -/
  toQWitt : ∀ m, QW.W m →ₐ[A[X]] P m
  toQWitt_mem : ∀ m x, toQWitt m x ∈ (P m).deg 0
  /-- (b): the Verschiebungen `V_{m/d}`, maps of graded `A[q]`-modules (API `QVSystem.verschiebung`). -/
  V : ∀ {d m : ℕ+}, d ∣ m → P d →ₗ[A[X]] P m
  V_mem : ∀ {d m : ℕ+} (h : d ∣ m) {i : ℕ} {x : P d}, x ∈ (P d).deg i → V h x ∈ (P m).deg i
  V_toQWitt : ∀ {d m : ℕ+} (h : d ∣ m) (x : QW.W d),
    V h (toQWitt d x) = toQWitt m (QW.verschiebung h x)
  V_trans : ∀ {e d m : ℕ+} (h₁ : e ∣ d) (h₂ : d ∣ m), V (h₁.trans h₂) = (V h₂).comp (V h₁)
  V_mul_d : ∀ {d m : ℕ+} (h : d ∣ m) (w y : P d), V h (w * (P d).d y) = V h w * (P m).d (V h y)
  teichmuller_V_ax : ∀ {d m : ℕ+} (h : d ∣ m) (w : P d) (r : R),
    V h w * (P m).d (toQWitt m (QW.teichmuller m r)) =
      V h (w * toQWitt d (QW.teichmuller d r) ^ ((m : ℕ) / d - 1)) *
        (P m).d (V h (toQWitt d (QW.teichmuller d r)))

namespace QVSystem

variable {QW : QWittRings A Λ R}

/-- API `QVSystem.fromQWitt`: for each `m`, the `A[q]`-algebra map `qW_m(R/A) → P_m^0`. -/
def fromQWitt (P : QVSystem QW) (m : ℕ+) : QW.W m →ₐ[A[X]] P.P m := P.toQWitt m

theorem fromQWitt_mem (P : QVSystem QW) (m : ℕ+) (x : QW.W m) : P.fromQWitt m x ∈ (P.P m).deg 0 :=
  P.toQWitt_mem m x

/-- API `QVSystem.verschiebung`: for `d ∣ m`, `V_{m/d} : P_d → P_m`, a map of graded
`A[q]`-modules. -/
def verschiebung (P : QVSystem QW) {d m : ℕ+} (h : d ∣ m) : P.P d →ₗ[A[X]] P.P m := P.V h

theorem verschiebung_mem (P : QVSystem QW) {d m : ℕ+} (h : d ∣ m) {i : ℕ} {x : P.P d}
    (hx : x ∈ (P.P d).deg i) : P.verschiebung h x ∈ (P.P m).deg i :=
  P.V_mem h hx

/-- API `QVSystem.verschiebung_trans`: `V_{m/e} = V_{m/d} ∘ V_{d/e}`. -/
theorem verschiebung_trans (P : QVSystem QW) {e d m : ℕ+} (h₁ : e ∣ d) (h₂ : d ∣ m) :
    P.verschiebung (h₁.trans h₂) = (P.verschiebung h₂).comp (P.verschiebung h₁) :=
  P.V_trans h₁ h₂

/-- API `QVSystem.verschiebung_mul_d`: the product rule `V(w dh) = V(w) dV(h)`. -/
theorem verschiebung_mul_d (P : QVSystem QW) {d m : ℕ+} (h : d ∣ m) (w y : P.P d) :
    P.verschiebung h (w * (P.P d).d y) = P.verschiebung h w * (P.P m).d (P.verschiebung h y) :=
  P.V_mul_d h w y

/-- API `QVSystem.teichmuller_V`: the V-Teichmüller condition
`V(w) dτ_m(r) = V(w τ_d(r)^{m/d-1}) dV(τ_d(r))`. -/
theorem teichmuller_V (P : QVSystem QW) {d m : ℕ+} (h : d ∣ m) (w : P.P d) (r : R) :
    P.verschiebung h w * (P.P m).d (P.fromQWitt m (QW.teichmuller m r)) =
      P.verschiebung h (w * P.fromQWitt d (QW.teichmuller d r) ^ ((m : ℕ) / d - 1)) *
        (P.P m).d (P.verschiebung h (P.fromQWitt d (QW.teichmuller d r))) :=
  P.teichmuller_V_ax h w r

end QVSystem

namespace QVSystem

variable {QW : QWittRings A Λ R}

/-- API `QVSystem.verschiebung_comp_d`: `V_n ∘ d = n (d ∘ V_n)`. -/
theorem verschiebung_comp_d (P : QVSystem QW) {d m : ℕ+} (h : d ∣ m) (x : P.P d) :
    P.verschiebung h ((P.P d).d x) = (((m : ℕ) / d : ℕ) : A[X]) • (P.P m).d (P.verschiebung h x) := by
  sorry

/-- API `QVSystem.d_verschiebung_pow`: `dV_p(x^p) = V_p(x^{p-1}) dV_p(x)` for a prime `p` with
`m = p d` and `x ∈ qW_d(R/A)`: the composite `qW_m(R) → P_m^1` is a V-divided-power derivation. -/
theorem d_verschiebung_pow (P : QVSystem QW) (p : ℕ) (hp : p.Prime) {d m : ℕ+} (h : d ∣ m)
    (hm : (m : ℕ) = p * d) (x : QW.W d) :
    (P.P m).d (P.verschiebung h (P.fromQWitt d (x ^ p))) =
      P.verschiebung h (P.fromQWitt d (x ^ (p - 1))) * (P.P m).d (P.verschiebung h (P.fromQWitt d x)) := by
  sorry

/-- Morphisms of q-V-systems: families of maps of differential graded `A[q]`-algebras compatible
with the maps from the q-Witt rings and with the Verschiebungen. -/
structure Hom (P P' : QVSystem QW) where
  /-- The components. -/
  app : ∀ m, CDGA.Hom (P.P m) (P'.P m)
  app_fromQWitt : ∀ m x, (app m).toAlgHom (P.fromQWitt m x) = P'.fromQWitt m x
  app_verschiebung : ∀ {d m : ℕ+} (h : d ∣ m) (x : P.P d),
    (app m).toAlgHom (P.verschiebung h x) = P'.verschiebung h ((app d).toAlgHom x)

/-- `P` is initial among q-V-systems over `R`. -/
def IsInitial (P : QVSystem QW) : Prop := ∀ P' : QVSystem QW, Nonempty (Unique (Hom P P'))

end QVSystem

/-- A torsion-free q-V-system: the data (a) and (b) only, with degreewise `ℤ`-torsion-free
members; the V-Teichmüller condition is then automatic. -/
structure TorsionFreeQVSystem (QW : QWittRings A Λ R) where
  /-- The members. -/
  P : ℕ+ → CDGA A[X]
  torsionFree : ∀ m (n : ℕ) (x : P m), n ≠ 0 → (n : A[X]) • x = 0 → x = 0
  fromQWitt : ∀ m, QW.W m →ₐ[A[X]] P m
  fromQWitt_mem : ∀ m x, fromQWitt m x ∈ (P m).deg 0
  verschiebung : ∀ {d m : ℕ+}, d ∣ m → P d →ₗ[A[X]] P m
  verschiebung_mem : ∀ {d m : ℕ+} (h : d ∣ m) {i : ℕ} {x : P d}, x ∈ (P d).deg i →
    verschiebung h x ∈ (P m).deg i
  verschiebung_fromQWitt : ∀ {d m : ℕ+} (h : d ∣ m) (x : QW.W d),
    verschiebung h (fromQWitt d x) = fromQWitt m (QW.verschiebung h x)
  verschiebung_trans : ∀ {e d m : ℕ+} (h₁ : e ∣ d) (h₂ : d ∣ m),
    verschiebung (h₁.trans h₂) = (verschiebung h₂).comp (verschiebung h₁)
  verschiebung_mul_d : ∀ {d m : ℕ+} (h : d ∣ m) (w y : P d),
    verschiebung h (w * (P d).d y) = verschiebung h w * (P m).d (verschiebung h y)

/-- API `TorsionFreeQVSystem.toQVSystem`: a torsion-free system satisfies (τ_V), because (τ_V)
holds up to `(m/d)^{m/d-1}`-torsion. The inclusion is fully faithful: morphisms are the same
families of maps (`TorsionFreeQVSystem.toQVSystem_hom`). -/
def TorsionFreeQVSystem.toQVSystem {QW : QWittRings A Λ R} (T : TorsionFreeQVSystem QW) :
    QVSystem QW where
  P := T.P
  toQWitt := T.fromQWitt
  toQWitt_mem := T.fromQWitt_mem
  V := T.verschiebung
  V_mem := T.verschiebung_mem
  V_toQWitt := T.verschiebung_fromQWitt
  V_trans := T.verschiebung_trans
  V_mul_d := T.verschiebung_mul_d
  teichmuller_V_ax := sorry

/-- The morphisms of torsion-free q-V-systems are those of the underlying q-V-systems: the
forgetful functor is fully faithful. -/
abbrev TorsionFreeQVSystem.toQVSystem_hom {QW : QWittRings A Λ R} (T T' : TorsionFreeQVSystem QW) :
    Type u :=
  QVSystem.Hom T.toQVSystem T'.toQVSystem

/-- **Owners: HabiroRings HR.4 and DerivedDeRhamCohomology DD.2.** The ghost targets as cdgas:
`Ω*_{R/A} ⊗_{A,ψ^d} A[ζ_d]`, with the ghost maps of the q-Witt rings in degree zero. -/
structure GhostCDGAs (QW : QWittRings A Λ R) where
  /-- `Ω*_{R/A} ⊗_{A,ψ^d} A[ζ_d]`. -/
  target : ℕ+ → CDGA A[X]
  /-- Degree zero is the ghost target of `HR.4`. -/
  ofGhost : ∀ d, QW.ghostTarget d →ₐ[A[X]] target d

/-- The ghost system `m ↦ ∏_{d ∣ m} Ω*_{R/A} ⊗_{A,ψ^d} A[ζ_d]`, with the product of the ghost maps
in degree zero and `V_{m/n}(w)_d = (m/n)^{i+1} w_d` for `d ∣ n` (and `0` otherwise) on a form of
degree `i`. -/
def QVSystem.ghostSystem {QW : QWittRings A Λ R} (G : GhostCDGAs QW) : QVSystem QW := sorry

/-- The projection of the ghost system onto its `d`-th factor. -/
def QVSystem.ghostSystem.proj {QW : QWittRings A Λ R} (G : GhostCDGAs QW) {d m : ℕ+}
    (h : d ∣ m) : ((QVSystem.ghostSystem G).P m) →ₐ[A[X]] G.target d :=
  sorry

/-- Unit test `QVSystem.ghostSystem`: the family `m ↦ ∏_{d ∣ m} Ω_{R/A} ⊗_{A,ψ^d} A[ζ_d]`, with the
product of the ghost maps in degree zero and `V_{m/n}(w)_d = (m/n)^{i+1} w_d` for `d ∣ n` and `0`
otherwise on a form of degree `i`, is a q-V-system over `R`. -/
example {QW : QWittRings A Λ R} (G : GhostCDGAs QW) {n m d : ℕ+} (hnm : n ∣ m) (hdm : d ∣ m)
    {i : ℕ} (w : (QVSystem.ghostSystem G).P n) (hw : w ∈ ((QVSystem.ghostSystem G).P n).deg i) :
    QVSystem.ghostSystem.proj G hdm ((QVSystem.ghostSystem G).verschiebung hnm w) =
      if hdn : (d : ℕ) ∣ (n : ℕ) then
        ((((m : ℕ) / n) ^ (i + 1) : ℕ) : A[X]) • QVSystem.ghostSystem.proj G (PNat.dvd_iff.mpr hdn) w
      else 0 := by
  sorry

/-- Unit test `QVSystem.ghostSystem_exponent`: with the naive factor `(m/n)^i` the product rule
breaks: for forms of degrees `a` and `b`, `V(w dh)` and `V(w) dV(h)` carry `(m/n)^{a+b+1}` and
`(m/n)^{a+b}`; with `(m/n)^{i+1}` both carry `(m/n)^{a+b+2}`. -/
example (k a b : ℕ) (hk : 2 ≤ k) :
    k ^ ((a + b + 1) + 1) = k ^ (a + 1) * k ^ (b + 1) ∧ k ^ (a + b + 1) ≠ k ^ a * k ^ b := by
  sorry

/-- The zero q-V-system (every member the zero cdga). -/
def QVSystem.zero (QW : QWittRings A Λ R) : QVSystem QW := sorry

/-- Unit test `QVSystem.zero`: the zero family is a q-V-system and is terminal; nothing in the
definition forces `P_1` to be the de Rham complex. -/
example (QW : QWittRings A Λ R) :
    (∀ m, Subsingleton ((QVSystem.zero QW).P m)) ∧
      ∀ P : QVSystem QW, Nonempty (Unique (QVSystem.Hom P (QVSystem.zero QW))) := by
  sorry

/-- Unit test `QVSystem.no_restriction`: restriction maps `P_p → P_1` commuting with the
Verschiebungen would exclude the initial object: for `A = R = ℤ` they give in degree zero a
`ℤ[q]`-algebra map `ℤ[q]/Φ_p(q) → ℤ[q]/(q - 1) = ℤ`, which does not exist since `Φ_p(1) = p ≠ 0`. -/
example (p : ℕ) (hp : p.Prime) :
    ¬ ∃ φ : AdjoinRoot (cyclotomic p ℤ) →ₐ[ℤ] ℤ, φ (AdjoinRoot.root _) = 1 := by
  sorry

/-- Unit test `TorsionFreeQVSystem.teichmuller_V`: a family with (a) and (b) whose members are
degreewise `ℤ`-torsion free satisfies (τ_V). -/
example {QW : QWittRings A Λ R} (T : TorsionFreeQVSystem QW) {d m : ℕ+} (h : d ∣ m)
    (w : T.P d) (r : R) :
    T.verschiebung h w * (T.P m).d (T.fromQWitt m (QW.teichmuller m r)) =
      T.verschiebung h (w * T.fromQWitt d (QW.teichmuller d r) ^ ((m : ℕ) / d - 1)) *
        (T.P m).d (T.verschiebung h (T.fromQWitt d (QW.teichmuller d r))) :=
  T.toQVSystem.teichmuller_V h w r

/-! ### q-FV-systems (node HQ.4/q-fv-systems) -/

/-- **Definition (HQ.4/q-fv-systems).** API `QFVSystem` (with the forgetful map
`QFVSystem.toQVSystem`): a q-V-system with Frobenii
`F_{m/d} : P_m → P_d`, maps of graded ALGEBRAS, compatible with the q-Witt Frobenii and transitive,
satisfying `F d V = d`, the projection formula, `F_n V_k = V_k F_n` for coprime `n, k`,
`F V = m/d` (an integer) and `V F = [m/d]_{q^d}` (a q-integer), and (τ_F). The forgetful map is
`QFVSystem.toQVSystem`. -/
structure QFVSystem (QW : QWittRings A Λ R) extends QVSystem QW where
  /-- The Frobenii `F_{m/d}`, maps of graded algebras (API `QFVSystem.frobenius`). -/
  F : ∀ {d m : ℕ+}, d ∣ m → P m →ₐ[A[X]] P d
  F_mem : ∀ {d m : ℕ+} (h : d ∣ m) {i : ℕ} {x : P m}, x ∈ (P m).deg i → F h x ∈ (P d).deg i
  F_toQWitt : ∀ {d m : ℕ+} (h : d ∣ m) (x : QW.W m), F h (toQWitt m x) = toQWitt d (QW.frobenius h x)
  F_trans : ∀ {e d m : ℕ+} (h₁ : e ∣ d) (h₂ : d ∣ m), F (h₁.trans h₂) = (F h₁).comp (F h₂)
  F_d_V : ∀ {d m : ℕ+} (h : d ∣ m) (x : P d), F h ((P m).d (V h x)) = (P d).d x
  V_mul_F : ∀ {d m : ℕ+} (h : d ∣ m) (w : P d) (y : P m), V h (w * F h y) = V h w * y
  F_V_comm : ∀ (e n k : ℕ+), Nat.Coprime n k → ∀ x : P (e * n),
    F (m := e * n * k) (d := e * k) ⟨n, by rw [mul_right_comm]⟩ (V (m := e * n * k) (d := e * n) ⟨k, rfl⟩ x) =
      V (m := e * k) (d := e) ⟨k, rfl⟩ (F (m := e * n) (d := e) ⟨n, rfl⟩ x)
  F_V : ∀ {d m : ℕ+} (h : d ∣ m) (x : P d), F h (V h x) = (((m : ℕ) / d : ℕ) : A[X]) • x
  V_F : ∀ {d m : ℕ+} (h : d ∣ m) (x : P m),
    V h (F h x) = qInt ((m : ℕ) / d) ((X : A[X]) ^ (d : ℕ)) • x
  teichmuller_F_ax : ∀ {d m : ℕ+} (h : d ∣ m) (r : R),
    F h ((P m).d (toQWitt m (QW.teichmuller m r))) =
      toQWitt d (QW.teichmuller d r) ^ ((m : ℕ) / d - 1) * (P d).d (toQWitt d (QW.teichmuller d r))

namespace QFVSystem

variable {QW : QWittRings A Λ R}

/-- API `QFVSystem.frobenius`: for `d ∣ m`, the Frobenius `F_{m/d} : P_m → P_d`, a map of graded
`A[q]`-ALGEBRAS, transitive along chains of divisors. -/
def frobenius (P : QFVSystem QW) {d m : ℕ+} (h : d ∣ m) : P.P m →ₐ[A[X]] P.P d := P.F h

/-- API `QFVSystem.frobenius_d_verschiebung`: `F ∘ d ∘ V = d`. -/
theorem frobenius_d_verschiebung (P : QFVSystem QW) {d m : ℕ+} (h : d ∣ m) (x : P.P d) :
    P.frobenius h ((P.P m).d (P.verschiebung h x)) = (P.P d).d x :=
  P.F_d_V h x

/-- API `QFVSystem.verschiebung_mul_frobenius`: the projection formula `V(w F(h)) = V(w) h`. -/
theorem verschiebung_mul_frobenius (P : QFVSystem QW) {d m : ℕ+} (h : d ∣ m) (w : P.P d)
    (y : P.P m) : P.verschiebung h (w * P.frobenius h y) = P.verschiebung h w * y :=
  P.V_mul_F h w y

/-- API `QFVSystem.frobenius_verschiebung_comm`: `F_n V_k = V_k F_n` for coprime `n, k`. -/
theorem frobenius_verschiebung_comm (P : QFVSystem QW) (e n k : ℕ+) (hnk : Nat.Coprime n k)
    (x : P.P (e * n)) :
    P.frobenius (m := e * n * k) (d := e * k) ⟨n, by rw [mul_right_comm]⟩
        (P.verschiebung (m := e * n * k) (d := e * n) ⟨k, rfl⟩ x) =
      P.verschiebung (m := e * k) (d := e) ⟨k, rfl⟩ (P.frobenius (m := e * n) (d := e) ⟨n, rfl⟩ x) :=
  P.F_V_comm e n k hnk x

/-- API `QFVSystem.frobenius_verschiebung`: `F_{m/d} ∘ V_{m/d}` is multiplication by the INTEGER
`m/d`. -/
theorem frobenius_verschiebung (P : QFVSystem QW) {d m : ℕ+} (h : d ∣ m) (x : P.P d) :
    P.frobenius h (P.verschiebung h x) = (((m : ℕ) / d : ℕ) : A[X]) • x :=
  P.F_V h x

/-- API `QFVSystem.verschiebung_frobenius`: `V_{m/d} ∘ F_{m/d}` is multiplication by the
q-INTEGER `[m/d]_{q^d}`. -/
theorem verschiebung_frobenius (P : QFVSystem QW) {d m : ℕ+} (h : d ∣ m) (x : P.P m) :
    P.verschiebung h (P.frobenius h x) = qInt ((m : ℕ) / d) ((X : A[X]) ^ (d : ℕ)) • x :=
  P.V_F h x

/-- API `QFVSystem.teichmuller_F`: `F(dτ_m(r)) = τ_d(r)^{m/d-1} dτ_d(r)`. -/
theorem teichmuller_F (P : QFVSystem QW) {d m : ℕ+} (h : d ∣ m) (r : R) :
    P.frobenius h ((P.P m).d (P.fromQWitt m (QW.teichmuller m r))) =
      P.fromQWitt d (QW.teichmuller d r) ^ ((m : ℕ) / d - 1) *
        (P.P d).d (P.fromQWitt d (QW.teichmuller d r)) :=
  P.teichmuller_F_ax h r

end QFVSystem

/-- API `QFVSystem.d_frobenius`: `d ∘ F_n = n (F_n ∘ d)` (the source prints `n (d ∘ V_n)`, a
misprint, source issue E201). -/
theorem QFVSystem.d_frobenius {QW : QWittRings A Λ R} (P : QFVSystem QW) {d m : ℕ+} (h : d ∣ m)
    (x : P.P m) :
    (P.P d).d (P.frobenius h x) = (((m : ℕ) / d : ℕ) : A[X]) • P.frobenius h ((P.P m).d x) := by
  sorry

/-- Unit test `QFVSystem.frobenius_verschiebung_self`: for `d = m` both composites are the
identity: `F_{m/m} V_{m/m} = 1` and `V_{m/m} F_{m/m} = [1]_{q^m} = 1`. -/
example {QW : QWittRings A Λ R} (P : QFVSystem QW) (m : ℕ+) (x : P.P m) :
    P.frobenius (dvd_refl m) (P.verschiebung (dvd_refl m) x) = x ∧
      P.verschiebung (dvd_refl m) (P.frobenius (dvd_refl m) x) = x := by
  sorry

/-- Unit test `QFVSystem.verschiebung_frobenius_ne_nat`: in degree zero of the initial q-FV-system
for `A = R = ℤ`, `V_2(F_2(1)) = V_2(1) = 1 + q` in `qW_2(ℤ/ℤ) = ℤ[q]/(q^2 - 1)`; its ghost
component at `q = -1` is `0` while that of `2` is `2`, so `V_2 ∘ F_2` is not multiplication by `2`. -/
example :
    Ideal.Quotient.mk (Ideal.span {(X : ℤ[X]) ^ 2 - 1}) (1 + X) ≠ 2 ∧
      (1 + X : ℤ[X]).eval (-1) = 0 ∧ (2 : ℤ[X]).eval (-1) = 2 := by
  sorry

/-- Unit test `QFVSystem.verschiebung_not_multiplicative`: in `qW_2(ℤ/ℤ) = ℤ[q]/(q^2 - 1)`,
`V_2(1)^2 = (1 + q)^2 = 2(1 + q)`, which differs from `V_2(1 · 1) = 1 + q` (ghost components
`(4, 0)` against `(2, 0)`): the Verschiebung is not multiplicative. -/
example :
    Ideal.Quotient.mk (Ideal.span {(X : ℤ[X]) ^ 2 - 1}) ((1 + X) ^ 2) =
        Ideal.Quotient.mk (Ideal.span {(X : ℤ[X]) ^ 2 - 1}) (2 * (1 + X)) ∧
      Ideal.Quotient.mk (Ideal.span {(X : ℤ[X]) ^ 2 - 1}) ((1 + X) ^ 2) ≠
        Ideal.Quotient.mk (Ideal.span {(X : ℤ[X]) ^ 2 - 1}) (1 + X) := by
  sorry

/-- Unit test `QFVSystem.frobenius_verschiebung_pTypical`: in degree zero and for `m/d = p`, the
relation `F_p V_p = p` is the analogue of `WittVector.frobenius_verschiebung`, the projection
formula that of `WittVector.verschiebung_mul_frobenius`; `V_p F_p = [p]_{q^d}` replaces
`WittVector.verschiebung_frobenius`, which holds only in characteristic `p`. -/
example (p : ℕ) [Fact p.Prime] (S : Type u) [CommRing S] (x y : WittVector p S) :
    WittVector.frobenius (WittVector.verschiebung x) = x * p ∧
      WittVector.verschiebung (x * WittVector.frobenius y) = WittVector.verschiebung x * y ∧
      ([CharP S p] → WittVector.verschiebung (WittVector.frobenius x) = x * p) :=
  ⟨WittVector.frobenius_verschiebung x, WittVector.verschiebung_mul_frobenius x y,
    WittVector.verschiebung_frobenius x⟩

/-! ### No restrictions (node HQ.4/there-are-no-restriction-operators-and-what-replaces-them) -/

/-- **Theorem (HQ.4/there-are-no-restriction-operators-and-what-replaces-them).** The degree-zero
obstruction (owned by HabiroRings HR.4, q-Witt v5 paragraph 2.14): for `m = p^a`, `d = p^b` with
`b < a` and `p ≠ 0` in `R`, there is no `R[q]`-algebra map `R[ζ_m] = R[q]/Φ_m(q) → R[q]/Φ_d(q)`,
since `Φ_{p^a}(q) ≡ p` modulo `Φ_{p^b}(q)`. Hence no restriction maps `qW_m → qW_d` compatible with
the Verschiebungen, and none on q-de Rham–Witt complexes. What replaces them, Langer–Zink's
restriction-free universal property of the de Rham–Witt pro-complex, is requested from
CrystallineCohomology CR.4 and used in `deRhamWitt_to_qDeRhamWitt`. -/
theorem no_restriction (S : Type u) [CommRing S] (p a b : ℕ) (hp : p.Prime) (hb : b < a)
    (hS : (p : S) ≠ 0) :
    ¬ ∃ φ : AdjoinRoot (cyclotomic (p ^ a) S) →ₐ[S] AdjoinRoot (cyclotomic (p ^ b) S),
      φ (AdjoinRoot.root _) = AdjoinRoot.root _ := by
  sorry

/-! ### Truncated q-V-systems -/

/-- A truncation set: closed under divisors. -/
def IsTruncationSet (S : Set ℕ+) : Prop := ∀ m ∈ S, ∀ d : ℕ+, d ∣ m → d ∈ S

/-- An `S`-truncated q-V-system: the data and axioms of `QVSystem` for the indices in `S`. -/
structure TruncatedQVSystem (QW : QWittRings A Λ R) (S : Set ℕ+) where
  /-- The members. -/
  P : S → CDGA A[X]
  fromQWitt : ∀ m : S, QW.W m →ₐ[A[X]] P m
  fromQWitt_mem : ∀ m x, fromQWitt m x ∈ (P m).deg 0
  verschiebung : ∀ {d m : S}, (d : ℕ+) ∣ m → P d →ₗ[A[X]] P m
  verschiebung_mem : ∀ {d m : S} (h : (d : ℕ+) ∣ m) {i : ℕ} {x : P d}, x ∈ (P d).deg i →
    verschiebung h x ∈ (P m).deg i
  verschiebung_fromQWitt : ∀ {d m : S} (h : (d : ℕ+) ∣ m) (x : QW.W d),
    verschiebung h (fromQWitt d x) = fromQWitt m (QW.verschiebung h x)
  verschiebung_trans : ∀ {e d m : S} (h₁ : (e : ℕ+) ∣ d) (h₂ : (d : ℕ+) ∣ m),
    verschiebung (h₁.trans h₂) = (verschiebung h₂).comp (verschiebung h₁)
  verschiebung_mul_d : ∀ {d m : S} (h : (d : ℕ+) ∣ m) (w y : P d),
    verschiebung h (w * (P d).d y) = verschiebung h w * (P m).d (verschiebung h y)
  teichmuller_V : ∀ {d m : S} (h : (d : ℕ+) ∣ m) (w : P d) (r : R),
    verschiebung h w * (P m).d (fromQWitt m (QW.teichmuller m r)) =
      verschiebung h (w * fromQWitt d (QW.teichmuller d r) ^ ((m : ℕ) / (d : ℕ+) - 1)) *
        (P m).d (verschiebung h (fromQWitt d (QW.teichmuller d r)))

/-- Morphisms of truncated q-V-systems. -/
structure TruncatedQVSystem.Hom {QW : QWittRings A Λ R} {S : Set ℕ+}
    (P P' : TruncatedQVSystem QW S) where
  /-- The components. -/
  app : ∀ m, CDGA.Hom (P.P m) (P'.P m)
  app_fromQWitt : ∀ m x, (app m).toAlgHom (P.fromQWitt m x) = P'.fromQWitt m x
  app_verschiebung : ∀ {d m : S} (h : (d : ℕ+) ∣ m) (x : P.P d),
    (app m).toAlgHom (P.verschiebung h x) = P'.verschiebung h ((app d).toAlgHom x)

/-- The restriction of a q-V-system to a truncation set. -/
def QVSystem.restrict {QW : QWittRings A Λ R} (P : QVSystem QW) (S : Set ℕ+) :
    TruncatedQVSystem QW S where
  P m := P.P m
  fromQWitt m := P.fromQWitt m
  fromQWitt_mem m := P.fromQWitt_mem m
  verschiebung h := P.verschiebung h
  verschiebung_mem h := P.verschiebung_mem h
  verschiebung_fromQWitt h := P.V_toQWitt h
  verschiebung_trans h₁ h₂ := P.verschiebung_trans h₁ h₂
  verschiebung_mul_d h := P.verschiebung_mul_d h
  teichmuller_V h := P.teichmuller_V h

/-! ### The q-de Rham–Witt complex (node HQ.4/the-q-de-rham-witt-complex) -/

/-- **Construction (HQ.4/the-q-de-rham-witt-complex).** API `qWittOmega`: the m-truncated
q-de Rham–Witt complexes `qW_m Ω_{R/A}`, the initial q-V-system over `R` (built inductively in `m`
as quotients of the de Rham complexes of the `qW_m(R/A)` over `A[q]`; not `(q-1)`-completed). -/
def qWittOmega (QW : QWittRings A Λ R) : QVSystem QW := sorry

namespace qWittOmega

variable (QW : QWittRings A Λ R)

/-- API `qWittOmega.isInitial`: the family is initial among q-V-systems over `R`. -/
theorem isInitial : (qWittOmega QW).IsInitial := by
  sorry

/-- API `qWittOmega.isInitial_truncated`: for every truncation set `S` the family indexed by `S` is
initial among `S`-truncated q-V-systems. (The refinement that for `S` the divisors of `m` a
`Λ_m`-structure on `A` suffices is not stated.) -/
theorem isInitial_truncated (S : Set ℕ+) (hS : IsTruncationSet S) (T : TruncatedQVSystem QW S) :
    Nonempty (Unique (TruncatedQVSystem.Hom ((qWittOmega QW).restrict S) T)) := by
  sorry

/-- API `qWittOmega.degreeZeroEquiv`: the structure map is an isomorphism from `qW_m(R/A)` onto the
degree-zero part. -/
theorem degreeZeroEquiv (m : ℕ+) :
    Function.Bijective fun x : QW.W m =>
      (⟨(qWittOmega QW).fromQWitt m x, (qWittOmega QW).fromQWitt_mem m x⟩ :
        ((qWittOmega QW).P m).deg 0) := by
  sorry

/-- API `qWittOmega.oneEquiv`: for `m = 1` it is the de Rham complex of `R` over `A` (with `q`
acting as `1`). -/
theorem oneEquiv (Ω : DeRhamCDGA A[X] A R) (hq : algebraMap A[X] Ω.cdga X = 1) :
    Nonempty (CDGA.Iso ((qWittOmega QW).P 1) Ω.cdga) := by
  sorry

/-- API `qWittOmega.surjective_ofKaehler`: the canonical map from the de Rham complex of
`qW_m(R/A)` over `A[q]` is surjective in every degree. -/
theorem surjective_ofKaehler (m : ℕ+) (Ωw : DeRhamCDGA A[X] A[X] (QW.W m)) :
    ∃ φ : CDGA.Hom Ωw.cdga ((qWittOmega QW).P m),
      (∀ x, φ.toAlgHom (Ωw.ofS x) = (qWittOmega QW).fromQWitt m x) ∧
        Function.Surjective φ.toAlgHom := by
  sorry

/-- API `qWittOmega.map`: functoriality in `R` (from initiality), for a map of `A`-algebras with
the induced maps of q-Witt rings. -/
def map {R' : Type u} [CommRing R'] [Algebra A R'] (QW' : QWittRings A Λ R')
    (Wf : ∀ m, QW.W m →ₐ[A[X]] QW'.W m) (m : ℕ+) :
    CDGA.Hom ((qWittOmega QW).P m) ((qWittOmega QW').P m) :=
  sorry

theorem map_fromQWitt {R' : Type u} [CommRing R'] [Algebra A R'] (QW' : QWittRings A Λ R')
    (Wf : ∀ m, QW.W m →ₐ[A[X]] QW'.W m) (m : ℕ+) (x : QW.W m) :
    (map QW QW' Wf m).toAlgHom ((qWittOmega QW).fromQWitt m x) =
      (qWittOmega QW').fromQWitt m (Wf m x) := by
  sorry

/-- API `qWittOmega.torsionFree_of_smooth`: for smooth `R` over a perfectly covered `A` the
members are degreewise `ℤ`-torsion free (proved in the smooth-case node). -/
theorem torsionFree_of_smooth [Algebra.Smooth A R] (hA : Λ.IsPerfectlyCovered) (m : ℕ+) (n : ℕ)
    (x : (qWittOmega QW).P m) (hn : n ≠ 0) (hx : (n : A[X]) • x = 0) : x = 0 := by
  sorry

end qWittOmega

/-- Base change of a cdga along `A → A′` (`- ⊗_A A′`). -/
def CDGA.baseChange {A' : Type u} [CommRing A'] [Algebra A A'] (P : CDGA A[X]) : CDGA A'[X] :=
  sorry

/-- API `qWittOmega.baseChangeEquiv`: for a map of Λ-rings `A → A′`,
`qW_m Ω_{R/A} ⊗_A A′ ≅ qW_m Ω_{(R ⊗_A A′)/A′}`. -/
theorem qWittOmega.baseChangeEquiv {A' : Type u} [CommRing A'] [Algebra A A'] {Λ' : LambdaRing A'}
    (hf : Λ.IsHom Λ' (algebraMap A A')) (QW : QWittRings A Λ R)
    (QW' : QWittRings A' Λ' (TensorProduct A A' R)) (m : ℕ+) :
    Nonempty (CDGA.Iso (CDGA.baseChange (A' := A') ((qWittOmega QW).P m)) ((qWittOmega QW').P m)) := by
  sorry

/-- The localisation `P[1/n]` of a cdga. -/
def CDGA.localize (n : ℕ) (P : CDGA A[X]) : CDGA A[X] := sorry

/-- **Lemma (HQ.4/etale-extension-of-a-differential-graded-algebra), construction.** For a cdga `P`
(in non-negative degrees) with `P^0 = S₀` and an étale map `S₀ → S`, the cdga `S ⊗_{S₀} P`. -/
def CDGA.etaleExtension (P : CDGA A[X]) {S₀ S : Type u} [CommRing S₀] [Algebra A[X] S₀]
    [CommRing S] [Algebra S₀ S] (ι₀ : S₀ →ₐ[A[X]] P) : CDGA A[X] :=
  sorry

/-- The map `P → S ⊗_{S₀} P`. -/
def CDGA.etaleExtension.incl (P : CDGA A[X]) {S₀ S : Type u} [CommRing S₀] [Algebra A[X] S₀]
    [CommRing S] [Algebra S₀ S] (ι₀ : S₀ →ₐ[A[X]] P) :
    CDGA.Hom P (CDGA.etaleExtension (S := S) P ι₀) :=
  sorry

/-- The map `S → (S ⊗_{S₀} P)^0`. -/
def CDGA.etaleExtension.ofS (P : CDGA A[X]) {S₀ S : Type u} [CommRing S₀] [Algebra A[X] S₀]
    [CommRing S] [Algebra S₀ S] (ι₀ : S₀ →ₐ[A[X]] P) : S →+* CDGA.etaleExtension (S := S) P ι₀ :=
  sorry

/-- **Lemma (HQ.4/etale-extension-of-a-differential-graded-algebra).** If `S₀ = P^0 → S` is étale,
the graded algebra `S ⊗_{S₀} P` carries a (unique) cdga structure compatible with `P`, and it is
initial among cdgas `Q` over `P` with a ring map `S → Q^0` compatible with `P^0 → Q^0`. -/
theorem CDGA.etaleExtension_spec (P : CDGA A[X]) {S₀ S : Type u} [CommRing S₀] [Algebra A[X] S₀]
    [CommRing S] [Algebra S₀ S] [Algebra.Etale S₀ S] (ι₀ : S₀ →ₐ[A[X]] P)
    (hι : ∀ x, ι₀ x ∈ P.deg 0) (hbij : Function.Bijective fun x => (⟨ι₀ x, hι x⟩ : P.deg 0)) :
    (∀ s, CDGA.etaleExtension.ofS P ι₀ s ∈ (CDGA.etaleExtension (S := S) P ι₀).deg 0) ∧
    (∀ x, CDGA.etaleExtension.ofS P ι₀ (algebraMap S₀ S x) =
      (CDGA.etaleExtension.incl (S := S) P ι₀).toAlgHom (ι₀ x)) ∧
    ∀ (Q : CDGA A[X]) (f : CDGA.Hom P Q) (g : S →+* Q), (∀ s, g s ∈ Q.deg 0) →
      (∀ x, g (algebraMap S₀ S x) = f.toAlgHom (ι₀ x)) →
        ∃! h : CDGA.Hom (CDGA.etaleExtension (S := S) P ι₀) Q,
          h.toAlgHom.comp (CDGA.etaleExtension.incl (S := S) P ι₀).toAlgHom = f.toAlgHom ∧
            ∀ s, h.toAlgHom (CDGA.etaleExtension.ofS P ι₀ s) = g s := by
  sorry

/-! ### Ghost maps (node HQ.4/ghost-maps-and-what-they-do-not-define) -/

/-- The ghost map `gh_{m/d} : qW_m Ω_{R/A} → Ω_{R/A} ⊗_{A,ψ^d} A[ζ_d]`, from initiality and the
ghost system. -/
def qWittOmega.ghost {QW : QWittRings A Λ R} (G : GhostCDGAs QW) {d m : ℕ+} (h : d ∣ m) :
    CDGA.Hom ((qWittOmega QW).P m) (G.target d) :=
  sorry

/-- The p-power index `p^a` as a positive integer. -/
def pPow (p : Nat.Primes) (a : ℕ) : ℕ+ := ⟨(p : ℕ) ^ a, pow_pos p.2.pos a⟩

theorem pPow_dvd (p : Nat.Primes) (a : ℕ) : pPow p (a - 1) ∣ pPow p a :=
  PNat.dvd_iff.mpr (Nat.pow_dvd_pow _ (Nat.sub_le a 1))

/-- **Theorem (HQ.4/ghost-maps-and-what-they-do-not-define).** (o) The ghost maps extend those of
the q-Witt rings. (i) After inverting `m` they induce an isomorphism
`qW_m Ω_{R/A}[1/m] ≅ ∏_{d ∣ m} Ω_{R/A} ⊗_{A,ψ^d} A[1/m, ζ_d]` (the ghost system inverted at `m`).
(ii) For `m = p^a`, the kernel of `gh_{m/m}` is `im V_p + im dV_p` (a dg ideal), and `gh_{m/m}` is
surjective. Integrally the ghost description is not a definition: joint injectivity holds in degree
zero under the torsion hypothesis of HR.4 (`QWittRings.ghost_injective`) and in positive degrees
for smooth `R` (`qWittOmega_smooth`). -/
theorem qWittOmega_ghost {QW : QWittRings A Λ R} (G : GhostCDGAs QW) :
    (∀ {d m : ℕ+} (h : d ∣ m) (x : QW.W m),
      (qWittOmega.ghost G h).toAlgHom ((qWittOmega QW).fromQWitt m x) = G.ofGhost d (QW.ghost h x)) ∧
    (∀ m : ℕ+, Nonempty (CDGA.Iso (CDGA.localize m ((qWittOmega QW).P m))
      (CDGA.localize m ((QVSystem.ghostSystem G).P m)))) ∧
    ∀ (p : Nat.Primes) (a : ℕ), 1 ≤ a →
      (∀ x, (qWittOmega.ghost G (dvd_refl (pPow p a))).toAlgHom x = 0 ↔
        x ∈ LinearMap.range ((qWittOmega QW).verschiebung (pPow_dvd p a)) ⊔
          LinearMap.range (((qWittOmega QW).P (pPow p a)).d ∘ₗ
            (qWittOmega QW).verschiebung (pPow_dvd p a))) ∧
      Function.Surjective (qWittOmega.ghost G (dvd_refl (pPow p a))).toAlgHom := by
  sorry

/-- Unit test `qWittOmega.degreeZero_one`: for `m = 1` the complex is the de Rham complex of `R`
over `A`, and in degree zero the `m`-th member is `qW_m(R/A)`. -/
example (QW : QWittRings A Λ R) (Ω : DeRhamCDGA A[X] A R) (hq : algebraMap A[X] Ω.cdga X = 1)
    (m : ℕ+) :
    Nonempty (CDGA.Iso ((qWittOmega QW).P 1) Ω.cdga) ∧
      Function.Bijective fun x : QW.W m =>
        (⟨(qWittOmega QW).fromQWitt m x, (qWittOmega QW).fromQWitt_mem m x⟩ :
          ((qWittOmega QW).P m).deg 0) :=
  ⟨qWittOmega.oneEquiv QW Ω hq, qWittOmega.degreeZeroEquiv QW m⟩

/-- Unit test `qWittOmega.afterInvertingM`: after inverting `m` the ghost maps identify
`qW_m Ω_{R/A}` with `∏_{d ∣ m} Ω_{R/A} ⊗_{A,ψ^d} A[1/m, ζ_d]`. -/
example {QW : QWittRings A Λ R} (G : GhostCDGAs QW) (m : ℕ+) :
    Nonempty (CDGA.Iso (CDGA.localize m ((qWittOmega QW).P m))
      (CDGA.localize m ((QVSystem.ghostSystem G).P m))) := by
  sorry

/-- Unit test `qWittOmega.etaleBaseChange`: for an étale map `R → R'`, `qW_m Ω_{R'/A}` is the
extension of scalars of `qW_m Ω_{R/A}` along `qW_m(R/A) → qW_m(R'/A)`. -/
example {R' : Type u} [CommRing R'] [Algebra A R'] [Algebra R R'] [Algebra.Etale R R']
    (QW : QWittRings A Λ R) (QW' : QWittRings A Λ R') (m : ℕ+) [Algebra (QW.W m) (QW'.W m)] :
    Nonempty (CDGA.Iso (CDGA.etaleExtension (S := QW'.W m) ((qWittOmega QW).P m)
      ((qWittOmega QW).fromQWitt m)) ((qWittOmega QW').P m)) := by
  sorry

/-- Unit test `qWittOmega.ofBase`: for `A = R = ℤ`, `qW_m Ω_{ℤ/ℤ}` is concentrated in degree zero,
where it is `qW_m(ℤ/ℤ) ≅ ℤ[q]/(q^m - 1)`. -/
example {Λℤ : LambdaRing ℤ} (QW : QWittRings ℤ Λℤ ℤ) (m : ℕ+) :
    (∀ i, 1 ≤ i → ((qWittOmega QW).P m).deg i = ⊥) ∧
      Nonempty (QW.W m ≃ₐ[ℤ[X]] (ℤ[X] ⧸ Ideal.span {(X : ℤ[X]) ^ (m : ℕ) - 1})) := by
  sorry

/-! ### Étale base change (node HQ.4/etale-base-change-and-the-sheaf-property) -/

/-- **Theorem (HQ.4/etale-base-change-and-the-sheaf-property).** For `R → R'` étale, the canonical
map `qW_m(R'/A) ⊗_{qW_m(R/A)} qW_m Ω_{R/A} → qW_m Ω_{R'/A}` is an isomorphism of cdgas over
`qW_m(R'/A)`. Consequently each `qW_m Ω^i_{−/A}` is an étale sheaf: for `R → R'` étale and faithfully
flat, with `R'' = R' ⊗_R R'`, the sequence `qW_m Ω_{R/A} → qW_m Ω_{R'/A} ⇉ qW_m Ω_{R''/A}` is an
equaliser (degreewise; for the underlying `E∞`-algebra this is Čech descent). -/
theorem qWittOmega_etale {R' : Type u} [CommRing R'] [Algebra A R'] [Algebra R R'] [Algebra.Etale R R']
    (QW : QWittRings A Λ R) (QW' : QWittRings A Λ R') (m : ℕ+) [Algebra (QW.W m) (QW'.W m)]
    {R'' : Type u} [CommRing R''] [Algebra A R''] (QW'' : QWittRings A Λ R'')
    (Wf : ∀ m, QW.W m →ₐ[A[X]] QW'.W m) (Wg₁ Wg₂ : ∀ m, QW'.W m →ₐ[A[X]] QW''.W m)
    (hff : Module.FaithfullyFlat R R') :
    Nonempty (CDGA.Iso (CDGA.etaleExtension (S := QW'.W m) ((qWittOmega QW).P m)
      ((qWittOmega QW).fromQWitt m)) ((qWittOmega QW').P m)) ∧
    Function.Injective (qWittOmega.map QW QW' Wf m).toAlgHom ∧
    ∀ y : (qWittOmega QW').P m,
      (qWittOmega.map QW' QW'' Wg₁ m).toAlgHom y = (qWittOmega.map QW' QW'' Wg₂ m).toAlgHom y →
        ∃ x, (qWittOmega.map QW QW' Wf m).toAlgHom x = y := by
  sorry

/-! ### The Frobenius operators (node HQ.4/the-frobenius-operators-on-q-de-rham-witt-complexes) -/

/-- **Theorem (HQ.4/the-frobenius-operators-on-q-de-rham-witt-complexes).** There is a unique choice
of Frobenii making the q-de Rham–Witt complexes a q-FV-system; with them the family is initial among
q-FV-systems. -/
theorem qWittOmega_frobenius (QW : QWittRings A Λ R) :
    ∃! F : QFVSystem QW, F.toQVSystem = qWittOmega QW ∧
      ∀ F' : QFVSystem QW, Nonempty (Unique (QVSystem.Hom F.toQVSystem F'.toQVSystem)) := by
  sorry

/-- The q-FV-structure of `qWittOmega` (its underlying q-V-system is `qWittOmega` itself). -/
def qWittOmegaFV (QW : QWittRings A Λ R) : QFVSystem QW where
  toQVSystem := qWittOmega QW
  F := sorry
  F_mem := sorry
  F_toQWitt := sorry
  F_trans := sorry
  F_d_V := sorry
  V_mul_F := sorry
  F_V_comm := sorry
  F_V := sorry
  V_F := sorry
  teichmuller_F_ax := sorry

/-- The rescaled Frobenius `F̃_{m/d} = (m/d)^i F_{m/d}` in degree `i`. -/
def QFVSystem.rescaledFrobenius {QW : QWittRings A Λ R} (P : QFVSystem QW) {d m : ℕ+}
    (h : d ∣ m) : P.P m →ₗ[A[X]] P.P d :=
  sorry

/-- The rescaled Frobenius is `(m/d)^i F_{m/d}` in degree `i`, and it is a map of differential
graded algebras, since `d ∘ F_{m/d} = (m/d)(F_{m/d} ∘ d)`. -/
theorem QFVSystem.rescaledFrobenius_spec {QW : QWittRings A Λ R} (P : QFVSystem QW) {d m : ℕ+}
    (h : d ∣ m) :
    (∀ (i : ℕ) (x : P.P m), x ∈ (P.P m).deg i →
      P.rescaledFrobenius h x = ((((m : ℕ) / d) ^ i : ℕ) : A[X]) • P.frobenius h x) ∧
    ∀ x, P.rescaledFrobenius h ((P.P m).d x) = (P.P d).d (P.rescaledFrobenius h x) := by
  sorry

/-! ### The comparison with ordinary de Rham–Witt complexes
(node HQ.4/the-comparison-map-from-ordinary-de-rham-witt) -/

/-- **Owner: CrystallineCohomology CR.4.** Langer–Zink's relative de Rham–Witt complexes
`W_{a+1} Ω_{R/A}` over a `ℤ_(p)`-algebra `A`, with their Frobenius and Verschiebung, and the
restriction-free universal property: from every FV-pro-complex WITHOUT restriction maps, for instance
`(P_{p^{n-1}})_{n ≥ 1}` of a q-FV-system, there is a unique compatible map. -/
structure LangerZink (p : Nat.Primes) (QW : QWittRings A Λ R) where
  /-- `W_{a+1} Ω_{R/A}`. -/
  W : ℕ → CDGA A[X]
  F : ∀ a, W (a + 1) →ₐ[A[X]] W a
  V : ∀ a, W a →ₗ[A[X]] W (a + 1)
  /-- The restriction-free universal property, applied to q-FV-systems. -/
  lift : ∀ (P : QFVSystem QW) (a : ℕ), CDGA.Hom (W a) (P.P (pPow p a))
  lift_F : ∀ (P : QFVSystem QW) (a : ℕ) (x : W (a + 1)),
    (lift P a).toAlgHom (F a x) =
      P.frobenius (pPow_dvd p (a + 1)) ((lift P (a + 1)).toAlgHom x)
  lift_V : ∀ (P : QFVSystem QW) (a : ℕ) (x : W a),
    (lift P (a + 1)).toAlgHom (V a x) =
      P.verschiebung (pPow_dvd p (a + 1)) ((lift P a).toAlgHom x)

/-- **Comparison (HQ.4/the-comparison-map-from-ordinary-de-rham-witt).** For a `ℤ_(p)`-algebra `A`,
the maps `W_{a+1} Ω_{R/A} → qW_{p^a} Ω_{R/A}` (note the index shift), compatible with Frobenii and
Verschiebungen. No compatibility with restrictions and no isomorphism is claimed. -/
def deRhamWitt_to_qDeRhamWitt (p : Nat.Primes) (_hA : ∀ n : ℕ, ¬ (p : ℕ) ∣ n → IsUnit (n : A))
    (QW : QWittRings A Λ R) (L : LangerZink p QW) (a : ℕ) :
    CDGA.Hom (L.W a) ((qWittOmegaFV QW).P (pPow p a)) :=
  L.lift (qWittOmegaFV QW) a

/-! ### The p-local decomposition (node HQ.4/the-p-local-decomposition) -/

/-- The cdga `P ⊗_{A[q], ψ^d, q ↦ q^d} A_(p)[q]/Φ_d(q^{p^a})`. -/
def CDGA.adamsCyclotomic (P : CDGA A[X]) (p : Nat.Primes) (a : ℕ) (d : ℕ+) : CDGA A[X] := sorry

/-- The localisation at `p` of a cdga. -/
def CDGA.localizeAt (p : Nat.Primes) (P : CDGA A[X]) : CDGA A[X] := sorry

/-- A finite product of cdgas. -/
def CDGA.pi {ι : Type} [Fintype ι] (P : ι → CDGA A[X]) : CDGA A[X] := sorry

/-- **Lemma (HQ.4/the-p-local-decomposition).** For any `A`-algebra `R` and `m = p^a n` with
`p ∤ n`, `qW_m Ω_{R/A,(p)} ≅ ∏_{d ∣ n} qW_{p^a} Ω_{R/A} ⊗_{A[q],ψ^d,q↦q^d} A_(p)[q]/Φ_d(q^{p^a})`,
as differential graded `A_(p)[q]`-algebras. -/
theorem qWittOmega_pLocal (QW : QWittRings A Λ R) (p : Nat.Primes) (a : ℕ) (n : ℕ+)
    (hn : ¬ (p : ℕ) ∣ n) :
    Nonempty (CDGA.Iso (CDGA.localizeAt p ((qWittOmega QW).P (pPow p a * n)))
      (CDGA.pi fun d : {d : Fin ((n : ℕ) + 1) // 0 < (d : ℕ) ∧ (d : ℕ) ∣ n} =>
        CDGA.adamsCyclotomic ((qWittOmega QW).P (pPow p a)) p a ⟨d.1, d.2.1⟩)) := by
  sorry

/-! ### The smooth case (node HQ.4/the-p-completion-of-the-q-de-rham-witt-complex) -/

/-- The framed q-Hodge complex modulo `q^m - 1`: the Koszul complex of the operators `(q - 1) q∂_i`
on `S⟦q-1⟧/(q^m - 1)`. -/
def framedQHodgeMod {S : Type u} [CommRing S] [Algebra A S] {d : ℕ} (F : EtaleFraming A S d)
    (m : ℕ+) :
    AddMonoid.End (Finset (Fin d) → PowerSeries S ⧸ Ideal.span {(1 + PowerSeries.X : PowerSeries S) ^ (m : ℕ) - 1}) :=
  sorry

/-- Its cohomology `H^*(qHdg_{S/A,□}/(q^m - 1))`, as a graded group. -/
abbrev framedQHodgeCohomology {S : Type u} [CommRing S] [Algebra A S] {d : ℕ}
    (F : EtaleFraming A S d) (m : ℕ+) : Type u :=
  (framedQHodgeMod F m).ker ⧸ (framedQHodgeMod F m).range.addSubgroupOf (framedQHodgeMod F m).ker

/-- **Theorem (HQ.4/the-p-completion-of-the-q-de-rham-witt-complex; q-Witt v5 Proposition 4.1,
Theorem 4.27, Proposition 4.2), smooth case, proved jointly.** For `R` smooth over a perfectly
covered `A`: (i) `qW_m Ω_{R/A}` is degreewise torsion free, so its ghost maps are injective in every
degree; (ii) for every étale framing, the degreewise `(q-1)`-completion of `qW_m Ω_{R/A}` is
isomorphic to `H^*(qHdg_{R/A,□}/(q^m - 1))`, the cohomology of the coordinate q-Hodge complex
modulo `q^m - 1`; (iii) is `qWittOmega_pCompletion`. -/
theorem qWittOmega_smooth [Algebra.Smooth A R] (hA : Λ.IsPerfectlyCovered) (QW : QWittRings A Λ R)
    (G : GhostCDGAs QW) (m : ℕ+) :
    (∀ (n : ℕ) (x : (qWittOmega QW).P m), n ≠ 0 → (n : A[X]) • x = 0 → x = 0) ∧
    (∀ x y : (qWittOmega QW).P m, (∀ (d : ℕ+) (h : d ∣ m),
      (qWittOmega.ghost G h).toAlgHom x = (qWittOmega.ghost G h).toAlgHom y) → x = y) ∧
    ∀ {d : ℕ} (F : EtaleFraming A R d),
      Nonempty (AdicCompletion (Ideal.span {(X : A[X]) - 1}) ((qWittOmega QW).P m) ≃+
        framedQHodgeCohomology F m) := by
  sorry

/-- **Theorem (HQ.4/no-functorial-q-hodge-complex-with-q-witt-cohomology).** For `A` perfectly
covered and not a `ℚ`-algebra, there is no functor `qHdg` from smooth `A`-algebras to derived
`(q-1)`-complete `A⟦q-1⟧`-modules with functorial isomorphisms
`qW_m Ω_{−/A}^∧_{(q-1)} ≅ H^*(qHdg/^L(q^m - 1))` under which the projections induce the Frobenii.
Stated for a family of candidate cohomology groups `H m S` with the Frobenius transition maps: no
such family, functorial in `S`, can be given by isomorphisms. The descent of HQ.3 is therefore a
descended complex, not a family of cohomology groups. -/
theorem no_functorial_qHodge_with_qWitt (hA : Λ.IsPerfectlyCovered) (hQ : ¬ Nonempty (Algebra ℚ A))
    (QWf : ∀ (S : SmoothAlg A), QWittRings A Λ S.obj) :
    ¬ ∃ (H : ℕ+ → SmoothAlg A ⥤ ModuleCat.{u} A[X])
        (e : ∀ m S, (AdicCompletion (Ideal.span {(X : A[X]) - 1})
          ((qWittOmega (QWf S)).P m)) ≃+ (H m).obj S)
        (tr : ∀ {d m : ℕ+}, d ∣ m → (H m ⟶ H d)),
        ∀ {d m : ℕ+} (h : d ∣ m) (S : SmoothAlg A) (x : (qWittOmega (QWf S)).P m),
          ((tr h).app S).hom (e m S (AdicCompletion.of _ _ x)) =
            e d S (AdicCompletion.of _ _ ((qWittOmegaFV (QWf S)).frobenius h x)) := by
  sorry

/-! ### The Nygaard filtration on q-de Rham–Witt complexes
(node HQ.4/the-nygaard-filtration-on-q-de-rham-witt-complexes) -/

/-- The stupid filtration `P^{≥ n}` of a cdga. -/
def CDGA.stupidFil (P : CDGA A[X]) (n : ℕ) : Submodule A[X] P := ⨆ (i : ℕ) (_ : n ≤ i), P.deg i

/-- **Definition (HQ.4/the-nygaard-filtration-on-q-de-rham-witt-complexes).** API
`qWittOmega.nygaardFil`: for a prime `p` and `a ≥ 1`, the descending filtration of
`qW_{p^a} Ω_{S/A}` whose `n`-th term is, in degree `i < n`, `p^{n-1-i} V_p(qW_{p^{a-1}} Ω^i)`, and
in degrees `i ≥ n` everything. -/
def qWittOmega.nygaardFil (QW : QWittRings A Λ R) (p : Nat.Primes) (a : ℕ) (_ha : 1 ≤ a) (n : ℕ) :
    Submodule A[X] ((qWittOmega QW).P (pPow p a)) :=
  ⨆ i : ℕ, if i < n then
    Submodule.map (((p : A[X]) ^ (n - 1 - i)) • (qWittOmega QW).verschiebung (pPow_dvd p a))
      (((qWittOmega QW).P (pPow p (a - 1))).deg i)
  else ((qWittOmega QW).P (pPow p a)).deg i

namespace qWittOmega

variable (QW : QWittRings A Λ R) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a)

/-- API `qWittOmega.nygaardFil_apply`: in degree `i` the `n`-th term is `p^{n-1-i} V_p(...)` for
`i < n` and `qW_{p^a} Ω^i` for `i ≥ n`. -/
theorem nygaardFil_apply (n i : ℕ) :
    nygaardFil QW p a ha n ⊓ ((qWittOmega QW).P (pPow p a)).deg i =
      if i < n then
        Submodule.map (((p : A[X]) ^ (n - 1 - i)) • (qWittOmega QW).verschiebung (pPow_dvd p a))
          (((qWittOmega QW).P (pPow p (a - 1))).deg i)
      else ((qWittOmega QW).P (pPow p a)).deg i := by
  sorry

/-- API `qWittOmega.nygaardFil_zero`: the zeroth term is the whole complex. -/
theorem nygaardFil_zero : nygaardFil QW p a ha 0 = ⊤ := by
  sorry

/-- The Nygaard terms are subcomplexes. -/
theorem nygaardFil_d (n : ℕ) (x : (qWittOmega QW).P (pPow p a)) (hx : x ∈ nygaardFil QW p a ha n) :
    ((qWittOmega QW).P (pPow p a)).d x ∈ nygaardFil QW p a ha n := by
  sorry

/-- API `qWittOmega.stupidFil_le_nygaardFil`. -/
theorem stupidFil_le_nygaardFil (n : ℕ) :
    ((qWittOmega QW).P (pPow p a)).stupidFil n ≤ nygaardFil QW p a ha n := by
  sorry

end qWittOmega

/-- Unit test `qWittOmega.nygaardFil_zero`: the zeroth term is the whole complex. -/
example (QW : QWittRings A Λ R) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a) :
    qWittOmega.nygaardFil QW p a ha 0 = ⊤ :=
  qWittOmega.nygaardFil_zero QW p a ha

/-- Unit test `qWittOmega.nygaardFil_two_deg_zero`: in degree zero the second term is
`p V_p(qW_{p^{a-1}}(S/A))` and the first is `V_p(qW_{p^{a-1}}(S/A))`. -/
example (QW : QWittRings A Λ R) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a) :
    qWittOmega.nygaardFil QW p a ha 2 ⊓ ((qWittOmega QW).P (pPow p a)).deg 0 =
        Submodule.map ((p : A[X]) • (qWittOmega QW).verschiebung (pPow_dvd p a))
          (((qWittOmega QW).P (pPow p (a - 1))).deg 0) ∧
      qWittOmega.nygaardFil QW p a ha 1 ⊓ ((qWittOmega QW).P (pPow p a)).deg 0 =
        Submodule.map ((qWittOmega QW).verschiebung (pPow_dvd p a))
          (((qWittOmega QW).P (pPow p (a - 1))).deg 0) := by
  sorry

/-- Unit test `qWittOmega.nygaardFil_ne_stupid`: for `S = A` and `a = 1` the first stupid term
vanishes in degree zero, while the first Nygaard term contains `V_p(1) = [p]_q ≠ 0` in `qW_p(A/A)`. -/
example (QW : QWittRings A Λ A) (p : Nat.Primes) [Nontrivial A] :
    ((qWittOmega QW).P (pPow p 1)).stupidFil 1 ⊓ ((qWittOmega QW).P (pPow p 1)).deg 0 = ⊥ ∧
      (qWittOmega QW).verschiebung (pPow_dvd p 1) 1 ∈
        qWittOmega.nygaardFil QW p 1 le_rfl 1 ∧
      (qWittOmega QW).verschiebung (pPow_dvd p 1) 1 ≠ 0 := by
  sorry

/-- Unit test `qWittOmega.nygaardFil_rational`: for `a = 1`, `gh_1` kills the images of `V_p` (they
are `(q-1)`-torsion), so it maps the Nygaard filtration into the Hodge (stupid) filtration of
`Ω_{S/A} ⊗_{A,φ} A[ζ_p]`, onto it after inverting `p`: after p-completion, inverting `p` and
completing at `Φ_p(q)` the two filtrations agree. -/
example {QW : QWittRings A Λ R} (G : GhostCDGAs QW) (p : Nat.Primes) (n : ℕ) :
    (∀ x : (qWittOmega QW).P (pPow p 0),
      ((X : A[X]) - 1) • (qWittOmega QW).verschiebung (pPow_dvd p 1) x = 0) ∧
    Submodule.map (qWittOmega.ghost G (dvd_refl (pPow p 1))).toAlgHom.toLinearMap
        (qWittOmega.nygaardFil QW p 1 le_rfl n) ≤ (G.target (pPow p 1)).stupidFil n ∧
    ∀ y ∈ (G.target (pPow p 1)).stupidFil n, ∃ (k : ℕ) (x : (qWittOmega QW).P (pPow p 1)),
      x ∈ qWittOmega.nygaardFil QW p 1 le_rfl n ∧
        (qWittOmega.ghost G (dvd_refl (pPow p 1))).toAlgHom x = ((p : A[X]) ^ k) • y := by
  sorry

/-- **Lemma (HQ.4/the-divided-frobenius-on-nygaard-graded-pieces), divisibility.** For `S` smooth
and `a ≥ 1`, `F̃_p` is divisible by `p^n` on the `n`-th Nygaard term; the divided Frobenius
`p^{-n} F̃_p` is well defined there (torsion freeness). -/
theorem qWittOmega.rescaledFrobenius_divisible [Algebra.Smooth A R] (hA : Λ.IsPerfectlyCovered)
    (QW : QWittRings A Λ R) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a) (n : ℕ)
    (x : (qWittOmega QW).P (pPow p a)) (hx : x ∈ qWittOmega.nygaardFil QW p a ha n) :
    ∃! y : (qWittOmega QW).P (pPow p (a - 1)),
      (qWittOmegaFV QW).rescaledFrobenius (pPow_dvd p a) x = ((p : A[X]) ^ n) • y := by
  sorry

/-- **Theorem (HQ.4/hodge-against-nygaard).** For `S` smooth, `p` prime and `a ≥ 1`, the square
with corners `fil^n_{stupid} qW_{p^a} Ω`, `fil^n_N qW_{p^a} Ω`, `fil^n_{stupid} qW_{p^{a-1}} Ω`,
`qW_{p^{a-1}} Ω` and right map the divided Frobenius `p^{-n} F̃_p` is a pullback; at the level of
these torsion-free complexes of subcomplexes, the stupid term is the preimage of the stupid term. -/
theorem hodge_vs_nygaard [Algebra.Smooth A R] (hA : Λ.IsPerfectlyCovered) (QW : QWittRings A Λ R)
    (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a) (n : ℕ) (x : (qWittOmega QW).P (pPow p a)) :
    x ∈ ((qWittOmega QW).P (pPow p a)).stupidFil n ↔
      x ∈ qWittOmega.nygaardFil QW p a ha n ∧
        ∃ y ∈ ((qWittOmega QW).P (pPow p (a - 1))).stupidFil n,
          (qWittOmegaFV QW).rescaledFrobenius (pPow_dvd p a) x = ((p : A[X]) ^ n) • y := by
  sorry

/-! ### The derived theory: imported ambient -/

section DerivedQWitt

variable {Ani 𝒟 ℰ Mod : Type*} [Category Ani] [Category 𝒟] [Category ℰ] [Category Mod]
  [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ] [HasPullbacks 𝒟]
  {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear A[X] 𝒞] [HasFiniteColimits 𝒞]

/-- The imported ambient of the derived q-de Rham–Witt theory, the twisted q-de Rham complexes and
their Nygaard filtrations, on `𝒞 = D(A[q])` (underlying objects). Owners, by field:

* **HabiroRings HR.4**: `qWitt` (the relative q-Witt rings of smooth and of polynomial algebras) and
  `qWittOmegaFun` (functoriality of `qWittOmega` in the algebra);
* **EnhancedDerivedSheaves E1**: `ofCDGA`, `ofSubFil` (a cdga, and a filtration by subcomplexes, as
  objects of `D(A[q])`);
* **EnhancedDerivedSheaves E5**: `animate`, `animateFil` (animation into `D(A[q])` and into its
  filtered objects);
* **AInfCohomology AI.1**: `Leta` (décalage at an element of `A[q]`);
* **DerivedDeRhamCohomology DD.1**: `completeAt` (completion at an element of `A[q]`), `pComplete`,
  `invert` (inverting an integer), `quot` (derived quotient by an element);
* **HabiroRings HR.1**: `adamsBC` (base change along `ψ^d`, `q ↦ q^d`);
* **HabiroRings HR.3**: the complete-descent gluing that constructs `twistedQOmega` (not a field;
  the construction below is left to that owner's corollary);
* **HabiroRings HR.5**: `relHabiro` (the relative Habiro ring of an étale algebra);
* **PrismaticCohomology PR.3**: `prismNygaard` (the Nygaard filtration of the Frobenius-twisted
  prismatic cohomology, as the preimage of the décalage filtration under the relative Frobenius),
  `decalageFil` (the filtered décalage), `relFrob`;
* **PrismaticCohomology PR.2, DerivedDeRhamCohomology DD.2, DD.3**: `conjFilModP` (the conjugate
  filtration on `dR_{R/A}/p`), `derivedForms` (`dR^n = L∧^n L_{R/A}[-n]`). -/
structure QWittContext (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (H : HodgeContext K 𝒞) where
  qWitt : ∀ S : SmoothAlg A, QWittRings A Λ S.obj
  qWittPoly : ∀ P : PolyAlg A, QWittRings A Λ P.obj
  ofCDGA : CDGA A[X] → 𝒞
  /-- A chain map as a morphism (E1). -/
  ofLinear : ∀ {P Q : CDGA A[X]}, (P →ₗ[A[X]] Q) → (ofCDGA P ⟶ ofCDGA Q)
  /-- A graded piece `P^n`, placed in degree `0`, as an object (E1). -/
  ofSubmodule : ∀ P : CDGA A[X], Submodule A[X] P → 𝒞
  /-- A static ring with a filtration by ideals, as a filtered object (E1). -/
  ofIdealFil : ∀ (T₁ : Type u) [CommRing T₁] [Algebra A[X] T₁], (ℕ → Ideal T₁) → (ℕᵒᵖ ⥤ 𝒞)
  qWittOmegaFun : ℕ+ → SmoothAlg A ⥤ 𝒞
  qWittOmegaFun_obj : ∀ m S, (qWittOmegaFun m).obj S = ofCDGA ((qWittOmega (qWitt S)).P m)
  ofSubFil : ∀ P : CDGA A[X], (ℕ → Submodule A[X] P) → (ℕᵒᵖ ⥤ 𝒞)
  animate : (PolyAlg A ⥤ 𝒞) → (Ani ⥤ 𝒞)
  animate_restrict : ∀ F, K.ofPoly ⋙ animate F ≅ F
  animateFil : (PolyAlg A ⥤ (ℕᵒᵖ ⥤ 𝒞)) → (Ani ⥤ (ℕᵒᵖ ⥤ 𝒞))
  animateFil_restrict : ∀ F, K.ofPoly ⋙ animateFil F ≅ F
  Leta : A[X] → 𝒞 ⥤ 𝒞
  completeAt : A[X] → 𝒞 ⥤ 𝒞
  completeUnit : ∀ f, 𝟭 𝒞 ⟶ completeAt f
  pComplete : Nat.Primes → 𝒞 ⥤ 𝒞
  invert : ℕ → 𝒞 ⥤ 𝒞
  quot : A[X] → 𝒞 ⥤ 𝒞
  adamsBC : ℕ+ → 𝒞 ⥤ 𝒞
  relHabiro : SmoothAlg A ⥤ 𝒞
  relFrob : ∀ p : Nat.Primes, qOmega K ⋙ H.forget ⋙ adamsBC ⟨p, p.2.pos⟩ ⋙ pComplete p ⟶
    qOmega K ⋙ H.forget ⋙ pComplete p
  decalageFil : A[X] → 𝒞 → (ℕᵒᵖ ⥤ 𝒞)
  prismNygaard : Nat.Primes → ℕ → SmoothAlg A ⥤ (ℕᵒᵖ ⥤ 𝒞)
  conjFilModP : Nat.Primes → Ani ⥤ (ℕ ⥤ 𝒞)
  derivedForms : ℕ → Ani ⥤ 𝒞
  /-- HR.1 with DD.1: `M ↦ M ⊗^L_{A,ψ^d} A[q]` from `E∞`-`A`-algebras. -/
  adamsBase : ℕ+ → ℰ ⥤ 𝒞
  /-- DD.4: the crystalline Frobenius `φ_{p/A}` of the p-completed de Rham complex, from its
  identification with crystalline cohomology of `S/p` over `Â_p`. -/
  crysFrob : ∀ (p : Nat.Primes) (a : ℕ), K.deRham ⋙ adamsBase (pPow p (a + 1)) ⋙ pComplete p ⟶
    K.deRham ⋙ adamsBase (pPow p a) ⋙ pComplete p

variable {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} {H : HodgeContext K 𝒞}

/-! ### Twisted q-de Rham complexes (node HQ.4/twisted-q-de-rham-complexes) -/

/-- **Construction (HQ.4/twisted-q-de-rham-complexes).** API `twistedQOmega`: the `m`-th twisted
q-de Rham complex, glued (HR.3's complete descent) from the pieces
`E_d = (ψ^{d*} Lη_{[m/d]_q} qΩ_{S/A})^∧_{Φ_d(q)}`, `d ∣ m`, along the p-adic relative Frobenius
equivalences: a `(q^m - 1)`-complete `E∞`-`A[q]`-algebra, functorial in smooth `S` (underlying
object in `D(A[q])` here). No global Adams operation is used. -/
def twistedQOmega (T : QWittContext K H) (m : ℕ+) : SmoothAlg A ⥤ 𝒞 := sorry

/-- API `twistedQOmega.cyclotomicCompletion`: its `Φ_d(q)`-completion, `d ∣ m`, is `E_d`. -/
def twistedQOmega.cyclotomicCompletion (T : QWittContext K H) {d m : ℕ+} (h : d ∣ m) :
    twistedQOmega T m ⋙ T.completeAt (cyclotomic d A) ≅
      qOmega K ⋙ H.forget ⋙ T.Leta (qInt ((m : ℕ) / d) X) ⋙ T.adamsBC d ⋙
        T.completeAt (cyclotomic d A) :=
  sorry

/-- API `twistedQOmega.transition`: for `n ∣ m`, the map from the `(q^n - 1)`-completion of the
`m`-th complex to the `n`-th, functorial in `S` (the individual maps, not a coherent functor on
the divisibility poset). -/
def twistedQOmega.transition (T : QWittContext K H) {n m : ℕ+} (h : n ∣ m) :
    twistedQOmega T m ⋙ T.completeAt ((X : A[X]) ^ (n : ℕ) - 1) ⟶ twistedQOmega T n :=
  sorry

/-- API `twistedQOmega.one`: for `m = 1` it is the q-de Rham complex. -/
def twistedQOmega.one (T : QWittContext K H) : twistedQOmega T 1 ≅ qOmega K ⋙ H.forget :=
  sorry

/-- API `twistedQOmega.pCompletion_primePower`: for `m = p^a` its p-completion is the a-fold
Frobenius twist of the p-completed q-de Rham complex, `(q - 1, p)`-completed. -/
def twistedQOmega.pCompletion_primePower (T : QWittContext K H) (p : Nat.Primes) (a : ℕ) :
    twistedQOmega T (pPow p a) ⋙ T.pComplete p ≅
      qOmega K ⋙ H.forget ⋙ T.adamsBC (pPow p a) ⋙ T.completeAt ((X : A[X]) - 1) ⋙
        T.pComplete p :=
  sorry

/-- API `twistedQOmega.fractureSquare`; **Theorem (HQ.4/the-arithmetic-fracture-squares-and-
cyclotomic-descent).** For `N ≠ 0` divisible by `m`, `twistedQOmega m S` is the pullback of
`∏_{p ∣ N, d_p ∣ m_p} (ψ^{p^{v_p(m)} d_p *} qΩ)^∧_{(p, Φ_{d_p}(q))}` and
`∏_{d ∣ m} (ψ^{d*} qΩ ⊗ A[1/N, q])^∧_{Φ_d(q)}` over `∏_{p ∣ N, d ∣ m} ((ψ^{d*} qΩ)^∧_p[1/p])^∧_{Φ_d(q)}`,
the right map having components the iterated relative Frobenii `φ^{v_p(m/d)}_{p/A[q]}` (the décalage
functors disappear because `[m/d]_q` is a unit in each corner). Stated with the corners; the maps
are existentially quantified. -/
theorem twistedQOmega.fractureSquare [HasFiniteProducts 𝒞] (T : QWittContext K H) (m : ℕ+) (N : ℕ)
    (hN : N ≠ 0) (hmN : (m : ℕ) ∣ N) (S : SmoothAlg A) :
    ∃ (UR LL LR : 𝒞) (f : (twistedQOmega T m).obj S ⟶ UR) (g : (twistedQOmega T m).obj S ⟶ LL)
      (h : UR ⟶ LR) (k : LL ⟶ LR), IsPullback f g h k ∧
      Nonempty (LL ≅ ∏ᶜ fun d : {d : Fin ((m : ℕ) + 1) // 0 < (d : ℕ) ∧ (d : ℕ) ∣ m} =>
        (T.completeAt (cyclotomic d.1 A)).obj ((T.adamsBC ⟨d.1, d.2.1⟩).obj
          ((T.invert N).obj (H.forget.obj ((qOmega K).obj S))))) ∧
      Nonempty (UR ≅ ∏ᶜ fun pd : {pd : Fin (N + 1) × Fin ((m : ℕ) + 1) //
          (pd.1 : ℕ).Prime ∧ (pd.1 : ℕ) ∣ N ∧ 0 < (pd.2 : ℕ) ∧ (pd.2 : ℕ) ∣ m ∧
            Nat.Coprime pd.2 pd.1} =>
        (T.completeAt (cyclotomic pd.1.2 A)).obj ((T.pComplete ⟨pd.1.1, pd.2.1⟩).obj
          ((T.adamsBC ⟨(pd.1.1 : ℕ) ^ (m : ℕ).factorization pd.1.1 * pd.1.2,
            Nat.mul_pos (pow_pos pd.2.1.pos _) pd.2.2.2.1⟩).obj (H.forget.obj ((qOmega K).obj S))))) := by
  sorry

/-- API `twistedQdR`: the animation, agreeing with `twistedQOmega` on polynomial algebras (not on
all smooth algebras). -/
def twistedQdR (T : QWittContext K H) (m : ℕ+) : Ani ⥤ 𝒞 :=
  T.animate (PolyAlg.toSmooth A ⋙ twistedQOmega T m)

theorem twistedQdR_poly (T : QWittContext K H) (m : ℕ+) :
    Nonempty (K.ofPoly ⋙ twistedQdR T m ≅ PolyAlg.toSmooth A ⋙ twistedQOmega T m) :=
  ⟨T.animate_restrict _⟩

/-- Unit test `twistedQOmega.one`: for `m = 1` the construction returns the q-de Rham complex. -/
example (T : QWittContext K H) : Nonempty (twistedQOmega T 1 ≅ qOmega K ⋙ H.forget) :=
  ⟨twistedQOmega.one T⟩

/-- **Theorem (HQ.4/the-twisted-complex-deforms-the-q-de-rham-witt-complex).** The quotient of the
`m`-th twisted complex by `q^m - 1` is the m-truncated q-de Rham–Witt complex, functorially in smooth
`S`, independently of the auxiliary `N`; under it, the transition for `d ∣ m` induces the rescaled
Frobenius `F̃_{m/d} = (m/d)^n F_{m/d}` in degree `n` (the source's `d ∘ F = (m/d) ∘ F` is a misprint,
E202). The induced-map clause is stated as the existence of the identification compatible with
`QFVSystem.rescaledFrobenius`. -/
theorem twistedQOmega_mod (T : QWittContext K H) (hA : Λ.IsPerfectlyCovered) (m : ℕ+) :
    Nonempty (twistedQOmega T m ⋙ T.quot ((X : A[X]) ^ (m : ℕ) - 1) ≅ T.qWittOmegaFun m) := by
  sorry

/-- Unit test `twistedQOmega.mod`: the quotient of the `m`-th twisted complex by `q^m - 1` is the
m-truncated q-de Rham–Witt complex (and the transitions induce the rescaled Frobenii). -/
example (T : QWittContext K H) (hA : Λ.IsPerfectlyCovered) (m : ℕ+) (S : SmoothAlg A) :
    Nonempty ((T.quot ((X : A[X]) ^ (m : ℕ) - 1)).obj ((twistedQOmega T m).obj S) ≅
      T.ofCDGA ((qWittOmega (T.qWitt S)).P m)) := by
  sorry

/-- The factorial tower `n ↦ twistedQOmega (n+1)!` with its transition maps. -/
def twistedQOmega.tower (T : QWittContext K H) (S : SmoothAlg A) : ℕᵒᵖ ⥤ 𝒞 := sorry

/-- Unit test `twistedQOmega.etale_limit`: for `S` étale over `A` the limit over `m` of the twisted
complexes is the relative Habiro ring of `S` over `A` (Remark 3.17). -/
example [HasLimitsOfShape ℕᵒᵖ 𝒞] (T : QWittContext K H) (S : Type u) [CommRing S] [Algebra A S]
    [Algebra.Etale A S] :
    Nonempty (limit (twistedQOmega.tower T (SmoothAlg.of S)) ≅ T.relHabiro.obj (SmoothAlg.of S)) := by
  sorry

/-- Unit test `twistedQOmega.transition_ne_equiv`: for `A = ℤ` and `S = ℤ[x]` the transition from
the `(q-1)`-completion of the `p`-th twisted complex to the first is not an equivalence: its image in
`H^1` lies in `[p]_q H^1`, missing the class of `x^{p-1} dx`, since `d(x^p) = [p]_q x^{p-1} dx`. -/
example {Λℤ : LambdaRing ℤ} {Ani 𝒟 ℰ Mod : Type*} [Category Ani] [Category 𝒟] [Category ℰ]
    [Category Mod] [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ] [HasPullbacks 𝒟]
    {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear ℤ[X] 𝒞] [HasFiniteColimits 𝒞]
    {K : QDeRhamContext ℤ Λℤ Ani 𝒟 ℰ Mod} {H : HodgeContext K 𝒞} (T : QWittContext K H)
    (p : Nat.Primes) :
    ¬ IsIso ((twistedQOmega.transition T (one_dvd (pPow p 1))).app
        (SmoothAlg.of (MvPolynomial (Fin 1) ℤ))) ∧
      qDiff (X : ℤ[X]) ((X : ℤ[X][X]) ^ (p : ℕ)) = C (qInt p X) * X ^ ((p : ℕ) - 1) := by
  sorry

/-- The underlying filtered object of a filtered module. -/
def FilModule.forget (f : A[X]) (𝒞 : Type*) [Category 𝒞] [Preadditive 𝒞] [Linear A[X] 𝒞] :
    FilModule f 𝒞 ⥤ (ℕᵒᵖ ⥤ 𝒞) where
  obj M := M.fil
  map φ := φ.1

/-- A filtered module over `f^⋆A[q]` is one over `(f h)^⋆A[q]`, with `β` multiplied by `h`. -/
def FilModule.restrictScalars {f : A[X]} (h : A[X]) (M : FilModule f 𝒞) : FilModule (f * h) 𝒞 where
  fil := M.fil
  mul n := h • M.mul n
  mul_trans n := by rw [Linear.smul_comp, M.mul_trans, smul_smul, mul_comm]
  trans_mul n := by rw [Linear.comp_smul, M.trans_mul, smul_smul, mul_comm]

/-! ### The p-completion of the q-de Rham–Witt complex (smooth case, part (iii)) -/

/-- **Theorem (HQ.4/the-p-completion-of-the-q-de-rham-witt-complex), part (iii)** (q-Witt v5
Proposition 4.2). For `R` smooth over a perfectly covered `A`, `p` prime and `a ≥ 0`,
`(Ω_{R/A} ⊗^L_{A,ψ^{p^a}} A[q]/(q^{p^a} - 1))^∧_p ≃ (qW_{p^a} Ω_{R/A})^∧_p`, functorially in `R`
(as p-complete `E∞`-algebras; underlying objects here); these are in general incompatible with the
rational ghost isomorphism. The general `m = p^a n` form is `qWittOmega_pCompletion_general`. -/
theorem qWittOmega_pCompletion (T : QWittContext K H) (hA : Λ.IsPerfectlyCovered) (p : Nat.Primes)
    (a : ℕ) :
    Nonempty (K.deRham ⋙ T.adamsBase (pPow p a) ⋙ T.quot ((X : A[X]) ^ ((p : ℕ) ^ a) - 1) ⋙
        T.pComplete p ≅ T.qWittOmegaFun (pPow p a) ⋙ T.pComplete p) := by
  sorry

/-- Part (iii), general form: for `m = p^a n` with `p ∤ n`, `(qW_m Ω_{R/A})^∧_p` is the product over
`d ∣ n` of `(Ω_{R/A} ⊗^L_{A,ψ^{p^a d}} A[q]/Φ_d(q^{p^a}))^∧_p`. -/
theorem qWittOmega_pCompletion_general [HasFiniteProducts 𝒞] (T : QWittContext K H)
    (hA : Λ.IsPerfectlyCovered) (p : Nat.Primes) (a : ℕ) (n : ℕ+) (hn : ¬ (p : ℕ) ∣ n)
    (S : SmoothAlg A) :
    Nonempty ((T.pComplete p).obj ((T.qWittOmegaFun (pPow p a * n)).obj S) ≅
      ∏ᶜ fun d : {d : Fin ((n : ℕ) + 1) // 0 < (d : ℕ) ∧ (d : ℕ) ∣ n} =>
        (T.pComplete p).obj ((T.quot ((cyclotomic d.1 A).comp ((X : A[X]) ^ ((p : ℕ) ^ a)))).obj
          ((T.adamsBase (pPow p a * ⟨d.1, d.2.1⟩)).obj (K.deRham.obj S)))) := by
  sorry

/-- **Lemma (HQ.4/the-rescaled-frobenius-is-the-crystalline-frobenius).** Under the p-complete
equivalences of part (iii) for `a` and `a - 1`, the crystalline Frobenius `φ_{p/A}` corresponds to
the rescaled Frobenius `F̃_p` (`p^i F_p` in degree `i`). -/
theorem rescaledFrobenius_crystalline (T : QWittContext K H) (hA : Λ.IsPerfectlyCovered)
    (p : Nat.Primes) (a : ℕ) (S : SmoothAlg A) :
    ∃ (e₁ : (T.pComplete p).obj ((T.adamsBase (pPow p (a + 1))).obj (K.deRham.obj S)) ≅
        (T.pComplete p).obj ((T.qWittOmegaFun (pPow p (a + 1))).obj S))
      (e₀ : (T.pComplete p).obj ((T.adamsBase (pPow p a)).obj (K.deRham.obj S)) ≅
        (T.pComplete p).obj ((T.qWittOmegaFun (pPow p a)).obj S)),
      (T.crysFrob p a).app S ≫ e₀.hom =
        e₁.hom ≫ (T.pComplete p).map (eqToHom (T.qWittOmegaFun_obj _ S) ≫
          T.ofLinear ((qWittOmegaFV (T.qWitt S)).rescaledFrobenius
            (by simpa [pPow] using pPow_dvd p (a + 1))) ≫
          eqToHom (T.qWittOmegaFun_obj _ S).symm) := by
  sorry

/-- **Theorem (HQ.4/the-arithmetic-fracture-square-for-q-de-rham-witt-complexes).** For `R` smooth
over a perfectly covered `A` and `N ≠ 0` divisible by `m`, `qW_m Ω_{R/A}` is the pullback of
`∏_{p ∣ N, d_p ∣ m_p} (Ω_{R/A} ⊗^L_{ψ^{p^{v_p(m)} d_p}} A[q]/Φ_{d_p}(q^{p^{v_p(m)}}))^∧_p` and
`∏_{d ∣ m} Ω_{R/A} ⊗^L_{ψ^d} A[1/N, q]/Φ_d(q)` over
`∏_{p ∣ N, d ∣ m} ((Ω_{R/A} ⊗^L_{ψ^d} A[q])^∧_p[1/p])/Φ_d(q)`, with left map the product of the ghost
maps and right map with components `φ_{p/A}^{v_p(m/d)}`. Stated with the lower-left corner; the maps
are existentially quantified. -/
theorem qWittOmega_fractureSquare [HasFiniteProducts 𝒞] (T : QWittContext K H)
    (hA : Λ.IsPerfectlyCovered) (m : ℕ+) (N : ℕ) (hN : N ≠ 0) (hmN : (m : ℕ) ∣ N) (S : SmoothAlg A) :
    ∃ (UR LL LR : 𝒞) (f : (T.qWittOmegaFun m).obj S ⟶ UR) (g : (T.qWittOmegaFun m).obj S ⟶ LL)
      (h : UR ⟶ LR) (k : LL ⟶ LR), IsPullback f g h k ∧
      Nonempty (LL ≅ ∏ᶜ fun d : {d : Fin ((m : ℕ) + 1) // 0 < (d : ℕ) ∧ (d : ℕ) ∣ m} =>
        (T.quot (cyclotomic d.1 A)).obj ((T.invert N).obj
          ((T.adamsBase ⟨d.1, d.2.1⟩).obj (K.deRham.obj S)))) := by
  sorry

/-! ### The derived q-de Rham–Witt complex
(node HQ.4/the-derived-q-de-rham-witt-complex-and-its-stupid-filtration) -/

/-- The functor `S ↦ qW_m Ω^n_{S/A}` (a graded piece, in degree `0`). -/
def qWittOmega.formFun (T : QWittContext K H) (m : ℕ+) (n : ℕ) : SmoothAlg A ⥤ 𝒞 := sorry

theorem qWittOmega.formFun_obj (T : QWittContext K H) (m : ℕ+) (n : ℕ) (S : SmoothAlg A) :
    (qWittOmega.formFun T m n).obj S =
      T.ofSubmodule ((qWittOmega (T.qWitt S)).P m) (((qWittOmega (T.qWitt S)).P m).deg n) := by
  sorry

/-- The functor `S ↦ fil^⋆_{stupid} qW_m Ω_{S/A}`. -/
def qWittOmega.stupidFilFun (T : QWittContext K H) (m : ℕ+) : SmoothAlg A ⥤ (ℕᵒᵖ ⥤ 𝒞) := sorry

theorem qWittOmega.stupidFilFun_obj (T : QWittContext K H) (m : ℕ+) (S : SmoothAlg A) :
    (qWittOmega.stupidFilFun T m).obj S =
      T.ofSubFil ((qWittOmega (T.qWitt S)).P m) ((qWittOmega (T.qWitt S)).P m).stupidFil := by
  sorry

/-- **Construction (HQ.4/the-derived-q-de-rham-witt-complex-and-its-stupid-filtration).** API
`qWittDR`: the derived m-truncated q-de Rham–Witt complex, the animation of `qWittOmega`. -/
def qWittDR (T : QWittContext K H) (m : ℕ+) : Ani ⥤ 𝒞 :=
  T.animate (PolyAlg.toSmooth A ⋙ T.qWittOmegaFun m)

/-- API `qWittDR.form`: the derived forms `qW_m dR^n`, the animations of `qW_m Ω^n`. -/
def qWittDR.form (T : QWittContext K H) (m : ℕ+) (n : ℕ) : Ani ⥤ 𝒞 :=
  T.animate (PolyAlg.toSmooth A ⋙ qWittOmega.formFun T m n)

/-- API `qWittDR.hodgeWittFil`: the animated stupid filtration `fil_{Hdg_m} qW_m dR`. -/
def qWittDR.hodgeWittFil (T : QWittContext K H) (m : ℕ+) : Ani ⥤ (ℕᵒᵖ ⥤ 𝒞) :=
  T.animateFil (PolyAlg.toSmooth A ⋙ qWittOmega.stupidFilFun T m)

/-- API `qWittDR.gr_hodgeWittFil`: its `n`-th graded piece is `qW_m dR^n` shifted by `-n`. -/
theorem qWittDR.gr_hodgeWittFil [HasShift 𝒞 ℤ] (T : QWittContext K H)
    (m : ℕ+) (n : ℕ) (R : Ani) :
    Nonempty (FilN.gr ((qWittDR.hodgeWittFil T m).obj R) n ≅
      (shiftFunctor 𝒞 (-(n : ℤ))).obj ((qWittDR.form T m n).obj R)) := by
  sorry

/-- API `qWittDR.one`: for `m = 1` the filtration is the Hodge filtration of derived de Rham
cohomology. -/
theorem qWittDR.one (T : QWittContext K H) : Nonempty (qWittDR.hodgeWittFil T 1 ≅ H.hodgeFil) := by
  sorry

/-- API `qWittDR.ofPolynomial`: on polynomial algebras the derived objects are the underived ones. -/
theorem qWittDR.ofPolynomial (T : QWittContext K H) (m : ℕ+) :
    Nonempty (K.ofPoly ⋙ qWittDR T m ≅ PolyAlg.toSmooth A ⋙ T.qWittOmegaFun m) ∧
      Nonempty (K.ofPoly ⋙ qWittDR.hodgeWittFil T m ≅
        PolyAlg.toSmooth A ⋙ qWittOmega.stupidFilFun T m) :=
  ⟨⟨T.animate_restrict _⟩, ⟨T.animateFil_restrict _⟩⟩

/-- **Owner: EnhancedDerivedSheaves E5** (filtered derived commutative algebras). The ∞-category of
filtered derived commutative `A[q]`-algebras, with its forgetful functor. -/
structure FilDAlg (𝒞 : Type*) [Category 𝒞] (𝒜 : Type*) [Category 𝒜] where
  /-- The forgetful functor to filtered objects. -/
  forget : 𝒜 ⥤ (ℕᵒᵖ ⥤ 𝒞)

/-- API `qWittDR.fil_derivedCommutative`: the canonical filtered derived commutative
`A[q]/(q^m - 1)`-algebra structure, built on polynomial algebras and animated. -/
theorem qWittDR.fil_derivedCommutative {𝒜 : Type*} [Category 𝒜] (T : QWittContext K H)
    (D : FilDAlg 𝒞 𝒜) (m : ℕ+) :
    ∃ L : Ani ⥤ 𝒜, Nonempty (L ⋙ D.forget ≅ qWittDR.hodgeWittFil T m) := by
  sorry

/-- Unit test `qWittDR.one`: for `m = 1` the filtration is the Hodge filtration and its `n`-th graded
piece is the `n`-th derived exterior power of the cotangent complex, shifted by `-n`. -/
example [HasShift 𝒞 ℤ] (T : QWittContext K H) (n : ℕ) (R : Ani) :
    Nonempty (qWittDR.hodgeWittFil T 1 ≅ H.hodgeFil) ∧
      Nonempty (FilN.gr (H.hodgeFil.obj R) n ≅
        (shiftFunctor 𝒞 (-(n : ℤ))).obj ((T.derivedForms n).obj R)) := by
  sorry

/-- Unit test `qWittDR.ofPolynomial`: for a polynomial `A`-algebra `P`, `qW_m dR_{P/A}` is
`qW_m Ω_{P/A}` and the filtration is the stupid filtration. -/
example (T : QWittContext K H) (m : ℕ+) (n : ℕ) :
    Nonempty ((qWittDR T m).obj (K.ofPoly.obj (PolyAlg.of A n)) ≅
        (T.qWittOmegaFun m).obj ((PolyAlg.toSmooth A).obj (PolyAlg.of A n))) ∧
      Nonempty ((qWittDR.hodgeWittFil T m).obj (K.ofPoly.obj (PolyAlg.of A n)) ≅
        (qWittOmega.stupidFilFun T m).obj ((PolyAlg.toSmooth A).obj (PolyAlg.of A n))) :=
  ⟨⟨(T.animate_restrict _).app _⟩, ⟨(T.animateFil_restrict _).app _⟩⟩

/-- Unit test `qWittDR.gr_zero`: the zeroth graded piece is `qW_m dR^0`, which on a polynomial
algebra is the relative q-Witt ring `qW_m(P/A)` in degree zero. -/
example [HasShift 𝒞 ℤ] (T : QWittContext K H) (m : ℕ+) (n : ℕ) :
    Nonempty (FilN.gr ((qWittDR.hodgeWittFil T m).obj (K.ofPoly.obj (PolyAlg.of A n))) 0 ≅
        (shiftFunctor 𝒞 (-(0 : ℤ))).obj ((qWittDR.form T m 0).obj (K.ofPoly.obj (PolyAlg.of A n)))) ∧
      Function.Bijective fun x : (T.qWitt ((PolyAlg.toSmooth A).obj (PolyAlg.of A n))).W m =>
        (⟨(qWittOmega _).fromQWitt m x, (qWittOmega _).fromQWitt_mem m x⟩ :
          ((qWittOmega (T.qWitt ((PolyAlg.toSmooth A).obj (PolyAlg.of A n)))).P m).deg 0) := by
  sorry

/-- **Theorem (HQ.4/derived-q-de-rham-witt-forms-of-smooth-algebras).** For `S` smooth, the
animated stupid filtration on `qW_m dR_{S/A}` is the stupid filtration of `qW_m Ω_{S/A}`, and the
derived forms are the underived ones: `qW_m dR^n_{S/A} ≃ qW_m Ω^n_{S/A}` (the shift by `-n`
belongs to the graded piece, `qWittDR.gr_hodgeWittFil`). False for general animated inputs. -/
theorem qWittDR_smooth (T : QWittContext K H) (hA : Λ.IsPerfectlyCovered) (m : ℕ+) (n : ℕ) :
    Nonempty (K.ofSmooth ⋙ qWittDR.hodgeWittFil T m ≅ qWittOmega.stupidFilFun T m) ∧
      Nonempty (K.ofSmooth ⋙ qWittDR.form T m n ≅ qWittOmega.formFun T m n) := by
  sorry

/-! ### The animated Nygaard filtration on q-de Rham–Witt complexes -/

/-- The functor `S ↦ fil^⋆_N qW_{p^a} Ω_{S/A}` (for `a ≥ 1`). -/
def qWittOmega.nygaardFilFun (T : QWittContext K H) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a) :
    SmoothAlg A ⥤ (ℕᵒᵖ ⥤ 𝒞) := sorry

theorem qWittOmega.nygaardFilFun_obj (T : QWittContext K H) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a)
    (S : SmoothAlg A) :
    (qWittOmega.nygaardFilFun T p a ha).obj S =
      T.ofSubFil ((qWittOmega (T.qWitt S)).P (pPow p a)) (qWittOmega.nygaardFil (T.qWitt S) p a ha) := by
  sorry

/-- API `qWittDR.nygaardFil`: the animated Nygaard filtration `fil_N qW_{p^a} dR`, agreeing with the
underived one on smooth algebras after p-completion (`qWittDR_nygaard_smooth`). -/
def qWittDR.nygaardFil (T : QWittContext K H) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a) :
    Ani ⥤ (ℕᵒᵖ ⥤ 𝒞) :=
  T.animateFil (PolyAlg.toSmooth A ⋙ qWittOmega.nygaardFilFun T p a ha)

/-- Unit test `qWittDR.ne_nygaard`: the animated stupid filtration is not the Nygaard filtration:
for `S = A` and `m = p`, the first stupid term vanishes in degree zero while the first Nygaard term
contains `V_p(1) = [p]_q ≠ 0`. -/
example (T : QWittContext K H) (p : Nat.Primes) [Nontrivial A] :
    ¬ Nonempty ((qWittDR.hodgeWittFil T (pPow p 1)).obj (K.ofSmooth.obj (SmoothAlg.of A)) ≅
      (qWittDR.nygaardFil T p 1 le_rfl).obj (K.ofSmooth.obj (SmoothAlg.of A))) := by
  sorry

/-! ### The Nygaard filtration on twisted q-de Rham complexes
(node HQ.4/the-nygaard-filtration-on-twisted-q-de-rham-complexes) -/

/-- **Construction (HQ.4/the-nygaard-filtration-on-twisted-q-de-rham-complexes).** API
`twistedQOmega.nygaardFil`: for `a ≥ 1`, the prismatic Nygaard filtration on the p-completed
`p^a`-th twisted complex (the a-fold Frobenius twist of `(qΩ_{S/A})^∧_p`): for `a = 1` the preimage
of the décalage filtration on `Lη_{Φ_p(q)}(qΩ_{S/A})^∧_p` under the relative Frobenius, for `a ≥ 2`
its pullback along `φ^{a-1}`; a filtered module over `Φ_{p^a}(q)^⋆A[q]`. -/
def twistedQOmega.nygaardFil (T : QWittContext K H) (p : Nat.Primes) (a : ℕ) :
    SmoothAlg A ⥤ FilModule (cyclotomic ((p : ℕ) ^ a) A) 𝒞 :=
  sorry

/-- API `twistedQOmega.nygaardFil_eq_preimage`: for `a = 1` it is the preimage of the décalage
filtration under the relative Frobenius (PR.3's Nygaard filtration). -/
theorem twistedQOmega.nygaardFil_eq_preimage (T : QWittContext K H) (p : Nat.Primes)
    (S : SmoothAlg A) :
    Nonempty (((twistedQOmega.nygaardFil T p 1).obj S).fil ≅ (T.prismNygaard p 1).obj S) := by
  sorry

/-- API `twistedQOmega.nygaardFil_pullback`: for `a ≥ 2` it is the pullback along `φ^{a-1}` of the
`a = 1` filtration. -/
theorem twistedQOmega.nygaardFil_pullback (T : QWittContext K H) (p : Nat.Primes) (a : ℕ)
    (ha : 2 ≤ a) (S : SmoothAlg A) :
    Nonempty (((twistedQOmega.nygaardFil T p a).obj S).fil ≅
      ((twistedQOmega.nygaardFil T p 1).obj S).fil ⋙ T.adamsBC (pPow p (a - 1))) := by
  sorry

/-- API `twistedQOmega.nygaardFil_module`: a filtered module over `Φ_{p^a}(q)^⋆A[q]`, hence over
`(q^{p^a} - 1)^⋆A[q]` (as `q^{p^a} - 1 = Φ_{p^a}(q)(q^{p^{a-1}} - 1)`). -/
theorem twistedQOmega.nygaardFil_module (T : QWittContext K H) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a)
    (S : SmoothAlg A) :
    ∃ M : FilModule ((X : A[X]) ^ ((p : ℕ) ^ a) - 1) 𝒞,
      M.fil = ((twistedQOmega.nygaardFil T p a).obj S).fil := by
  sorry

/-- API `twistedQdR.nygaardFil`: its animation to animated `A`-algebras. -/
def twistedQdR.nygaardFil (T : QWittContext K H) (p : Nat.Primes) (a : ℕ) : Ani ⥤ (ℕᵒᵖ ⥤ 𝒞) :=
  T.animateFil (PolyAlg.toSmooth A ⋙ twistedQOmega.nygaardFil T p a ⋙ FilModule.forget _ 𝒞)

/-- Unit test `twistedQOmega.nygaardFil_zero`: the zeroth term is the whole p-completed twisted
complex. -/
example (T : QWittContext K H) (p : Nat.Primes) (a : ℕ) (S : SmoothAlg A) :
    Nonempty (((twistedQOmega.nygaardFil T p a).obj S).fil.obj (op 0) ≅
      (T.pComplete p).obj ((twistedQOmega T (pPow p a)).obj S)) := by
  sorry

/-- A static model of the p-completed `p`-th twisted complex of an animated `R` (for instance a
large quasi-syntomic one), supplied by **PrismaticCohomology PR.3**: a ring `T₁` over `A[q]`
realising it, the static p-completed q-de Rham complex `T₀`, the relative Frobenius `φ : T₁ → T₀`,
and the Nygaard filtration by ideals of `T₁`. -/
structure StaticTwistedModel (T : QWittContext K H) (p : Nat.Primes) (R : Ani) where
  /-- The static ring. -/
  T₁ : Type u
  [ring₁ : CommRing T₁]
  [alg₁ : Algebra A[X] T₁]
  T₀ : Type u
  [ring₀ : CommRing T₀]
  [alg₀ : Algebra A[X] T₀]
  /-- The relative Frobenius. -/
  φ : T₁ →ₐ[A[X]] T₀
  /-- The Nygaard filtration by ideals. -/
  fil : ℕ → Ideal T₁
  /-- It realises the animated prismatic Nygaard filtration. -/
  realise : Nonempty (T.ofIdealFil T₁ fil ≅ (twistedQdR.nygaardFil T p 1).obj R)

attribute [instance] StaticTwistedModel.ring₁ StaticTwistedModel.alg₁ StaticTwistedModel.ring₀
  StaticTwistedModel.alg₀

/-- Unit test `twistedQOmega.nygaardFil_frobenius_div`: when the p-completed twisted complex is
static (as for large quasi-syntomic `R`), an element lies in the `n`-th term exactly when its
relative Frobenius is divisible by `Φ_p(q)^n` (`a = 1`). -/
example (T : QWittContext K H) (p : Nat.Primes) (R : Ani) (M : StaticTwistedModel T p R) (n : ℕ)
    (x : M.T₁) :
    x ∈ M.fil n ↔ ∃ y : M.T₀, M.φ x = algebraMap A[X] M.T₀ (cyclotomic p A) ^ n * y := by
  sorry

/-- Unit test `twistedQOmega.nygaardFil_perfectoidQuotient`: for `A = ℤ` and
`R = ℤ_p⟨x^{1/p^∞}⟩/x`, with `e k j = x^{k/p^j}/[⌊k/p^j⌋]_{q^p}!` in the static model, the `n`-th term
is the completed span of `Φ_p(q)^{max(n - ⌊i⌋, 0)} x^i/[⌊i⌋]_{q^p}!` over `i ∈ ℕ[1/p]` (equality
modulo every power of `J = (p, q - 1)`). -/
example {Λℤ : LambdaRing ℤ} {Ani 𝒟 ℰ Mod : Type*} [Category Ani] [Category 𝒟] [Category ℰ]
    [Category Mod] [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ] [HasPullbacks 𝒟]
    {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear ℤ[X] 𝒞] [HasFiniteColimits 𝒞]
    {K : QDeRhamContext ℤ Λℤ Ani 𝒟 ℰ Mod} {H : HodgeContext K 𝒞} (T : QWittContext K H)
    (p : Nat.Primes) (R : Ani) (M : StaticTwistedModel T p R) (e : ℕ → ℕ → M.T₁) (n k : ℕ) :
    M.fil n ⊔ Ideal.span {(p : M.T₁), algebraMap ℤ[X] M.T₁ (X - 1)} ^ k =
      Ideal.span {y | ∃ i j : ℕ, y = algebraMap ℤ[X] M.T₁ (cyclotomic p ℤ) ^ (n - i / (p : ℕ) ^ j) *
        e i j} ⊔ Ideal.span {(p : M.T₁), algebraMap ℤ[X] M.T₁ (X - 1)} ^ k := by
  sorry

/-- Unit test `twistedQOmega.nygaardFil_ne_adic`: it is not the `Φ_p(q)`-adic filtration: in the
example above `x^1/[1]_{q^p}! = x` lies in the first term without being divisible by `Φ_p(q)`. -/
example {Λℤ : LambdaRing ℤ} {Ani 𝒟 ℰ Mod : Type*} [Category Ani] [Category 𝒟] [Category ℰ]
    [Category Mod] [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ] [HasPullbacks 𝒟]
    {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear ℤ[X] 𝒞] [HasFiniteColimits 𝒞]
    {K : QDeRhamContext ℤ Λℤ Ani 𝒟 ℰ Mod} {H : HodgeContext K 𝒞} (T : QWittContext K H)
    (p : Nat.Primes) (R : Ani) (M : StaticTwistedModel T p R) (e : ℕ → ℕ → M.T₁) :
    e 1 0 ∈ M.fil 1 ∧ ¬ ∃ y : M.T₁, e 1 0 = algebraMap ℤ[X] M.T₁ (cyclotomic p ℤ) * y := by
  sorry

/-! ### Divided Frobenius, kernel of Frobenius, and the Nygaard fibre sequences -/

/-- The divided Frobenius `p^{-n} F̃_p` on the `n`-th Nygaard term (smooth case). -/
def qWittOmega.dividedFrobenius (QW : QWittRings A Λ R) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a)
    (n : ℕ) : qWittOmega.nygaardFil QW p a ha n →ₗ[A[X]] (qWittOmega QW).P (pPow p (a - 1)) :=
  sorry

/-- **Lemma (HQ.4/the-divided-frobenius-on-nygaard-graded-pieces).** For `S` smooth and `a ≥ 1`:
`p^n · (p^{-n} F̃_p) = F̃_p` on `fil^n_N`, and `p^{-n} F̃_p` induces from `gr^n_N` to
`τ^{≤ n}(qW_{p^{a-1}} Ω/p)` a map that is bijective in degrees `i < n` and surjective in degree `n`
(onto the cocycles modulo `p`). -/
theorem qWittOmega.dividedFrobenius_gr [Algebra.Smooth A R] (hA : Λ.IsPerfectlyCovered)
    (QW : QWittRings A Λ R) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a) (n : ℕ) :
    (∀ x : qWittOmega.nygaardFil QW p a ha n, ((p : A[X]) ^ n) • qWittOmega.dividedFrobenius QW p a ha n x =
      (qWittOmegaFV QW).rescaledFrobenius (pPow_dvd p a) (x : (qWittOmega QW).P (pPow p a))) ∧
    (∀ i < n, ∀ y ∈ ((qWittOmega QW).P (pPow p (a - 1))).deg i,
      ∃ x : qWittOmega.nygaardFil QW p a ha n, (x : (qWittOmega QW).P (pPow p a)) ∈
          ((qWittOmega QW).P (pPow p a)).deg i ∧
        ∃ z ∈ ((qWittOmega QW).P (pPow p (a - 1))).deg i,
          qWittOmega.dividedFrobenius QW p a ha n x - y = (p : A[X]) • z) ∧
    (∀ i < n, ∀ x : qWittOmega.nygaardFil QW p a ha n,
      (x : (qWittOmega QW).P (pPow p a)) ∈ ((qWittOmega QW).P (pPow p a)).deg i →
        (∃ z, qWittOmega.dividedFrobenius QW p a ha n x = (p : A[X]) • z) →
          (x : (qWittOmega QW).P (pPow p a)) ∈ qWittOmega.nygaardFil QW p a ha (n + 1)) ∧
    ∀ y ∈ ((qWittOmega QW).P (pPow p (a - 1))).deg n,
      (∃ z, ((qWittOmega QW).P (pPow p (a - 1))).d y = (p : A[X]) • z) →
        ∃ x : qWittOmega.nygaardFil QW p a ha n, ∃ z,
          qWittOmega.dividedFrobenius QW p a ha n x - y = (p : A[X]) • z := by
  sorry

/-- **Lemma (HQ.4/the-kernel-of-the-frobenius).** For `S` smooth and `a ≥ 1`, `gh_1` identifies
`Ω^n_{S/A} ⊗_{A,φ^a} A[ζ_{p^a}]` with the kernel of `F_p : qW_{p^a} Ω^n → qW_{p^{a-1}} Ω^n`, and with
the kernel of `F_p : qW_{p^a} Ω^n/V_p → qW_{p^{a-1}} Ω^n/p`. -/
theorem qWittOmega.ker_frobenius [Algebra.Smooth A R] (hA : Λ.IsPerfectlyCovered)
    {QW : QWittRings A Λ R} (G : GhostCDGAs QW) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a) (n : ℕ) :
    Nonempty ((G.target (pPow p a)).deg n ≃ₗ[A[X]]
      ↥(LinearMap.ker ((qWittOmegaFV QW).frobenius (pPow_dvd p a)).toLinearMap ⊓
        ((qWittOmega QW).P (pPow p a)).deg n)) ∧
    Nonempty ((G.target (pPow p a)).deg n ≃ₗ[A[X]]
      (↥(((qWittOmega QW).P (pPow p a)).deg n ⊓
          (LinearMap.range ((p : A[X]) • LinearMap.id)).comap
            ((qWittOmegaFV QW).frobenius (pPow_dvd p a)).toLinearMap) ⧸
        (LinearMap.range ((qWittOmega QW).verschiebung (pPow_dvd p a))).comap
          (((qWittOmega QW).P (pPow p a)).deg n ⊓
            (LinearMap.range ((p : A[X]) • LinearMap.id)).comap
              ((qWittOmegaFV QW).frobenius (pPow_dvd p a)).toLinearMap).subtype)) := by
  sorry

variable [HasFiniteLimits 𝒞] [HasShift 𝒞 ℤ]

/-- **Lemma (HQ.4/the-nygaard-cofibre-sequence).** For an animated `R`, `a ≥ 1` (the source's
`a ≥ 0` is a misprint, E203) and every `n`, there is a divided Frobenius from the `n`-th graded
piece of the p-completed animated Nygaard filtration to
`fil_n^conj(dR_{R/A}/p) ⊗^L_{A,φ^{a-1}} A[q]/(q^{p^{a-1}} - 1)`, with fibre
`dR^n_{R/A} ⊗^L_{A,φ^a} A[ζ_{p^a}]` shifted by `-n`. -/
theorem qWittDR_nygaard_cofibre (T : QWittContext K H) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a)
    (n : ℕ) (R : Ani) :
    ∃ φ : (T.pComplete p).obj (FilN.gr ((qWittDR.nygaardFil T p a ha).obj R) n) ⟶
        (T.quot ((X : A[X]) ^ ((p : ℕ) ^ (a - 1)) - 1)).obj
          ((T.adamsBC (pPow p (a - 1))).obj (((T.conjFilModP p).obj R).obj n)),
      Nonempty (kernel φ ≅ (shiftFunctor 𝒞 (-(n : ℤ))).obj
        ((T.pComplete p).obj ((T.quot (cyclotomic ((p : ℕ) ^ a) A)).obj
          ((T.adamsBC (pPow p a)).obj ((T.derivedForms n).obj R))))) := by
  sorry

/-- **Theorem (HQ.4/nygaard-descent-and-smooth-agreement), part (b).** For `R` smooth, the
p-completed animated Nygaard filtration agrees with the p-completed underived one (`a ≥ 1`; the
source's `a ≥ 0` is a misprint, E203). Part (a), quasi-syntomic descent of each term, is not
stated: quasi-syntomic covers are not available in either library (PR.2 owns the descent). -/
theorem qWittDR_nygaard_smooth (T : QWittContext K H) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a)
    (S : SmoothAlg A) :
    Nonempty ((qWittDR.nygaardFil T p a ha).obj (K.ofSmooth.obj S) ⋙ T.pComplete p ≅
      (qWittOmega.nygaardFilFun T p a ha).obj S ⋙ T.pComplete p) := by
  sorry

/-- The prismatic Nygaard filtration of the p-completed `p^a`-th twisted complex as a filtered
module over `(q^{p^a} - 1)^⋆A[q] = (Φ_{p^a}(q) (q^{p^{a-1}} - 1))^⋆A[q]`. -/
def twistedQOmega.nygaardFilReduced (T : QWittContext K H) (p : Nat.Primes) (a : ℕ)
    (S : SmoothAlg A) :
    FilModule (cyclotomic ((p : ℕ) ^ a) A * ((X : A[X]) ^ ((p : ℕ) ^ (a - 1)) - 1)) 𝒞 :=
  FilModule.restrictScalars _ ((twistedQOmega.nygaardFil T p a).obj S)

/-- **Lemma (HQ.4/the-prismatic-nygaard-fibre-sequence).** For `a ≥ 1`, the prismatic Nygaard
filtration reduced modulo `q^{p^a} - 1` with the quotient convention has, in each degree `n`, a map
`p^{-n} φ_{/A}` to `fil_n^conj(dR/p) ⊗^L_{φ^{a-1}} A[q]/(q^{p^{a-1}} - 1)` with fibre the
p-completion of `dR^n ⊗^L_{φ^a} A[ζ_{p^a}]` shifted by `-n`. Stated for smooth inputs (the source
states it for animated ones). -/
theorem twistedQOmega_nygaard_fibre (T : QWittContext K H) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a)
    (n : ℕ) (S : SmoothAlg A) :
    ∃ φ : FilN.gr (filQuotient (twistedQOmega.nygaardFilReduced T p a S)) n ⟶
        (T.quot ((X : A[X]) ^ ((p : ℕ) ^ (a - 1)) - 1)).obj
          ((T.adamsBC (pPow p (a - 1))).obj (((T.conjFilModP p).obj (K.ofSmooth.obj S)).obj n)),
      Nonempty (kernel φ ≅ (shiftFunctor 𝒞 (-(n : ℤ))).obj
        ((T.pComplete p).obj ((T.quot (cyclotomic ((p : ℕ) ^ a) A)).obj
          ((T.adamsBC (pPow p a)).obj ((T.derivedForms n).obj (K.ofSmooth.obj S)))))) := by
  sorry

/-- API `qWittOmega.nygaardFil_comparison`; **Theorem (HQ.4/the-nygaard-comparison).** For smooth
`S`, `p` prime and `a ≥ 1`, the functorial equivalence from the prismatic Nygaard filtration of the
p-completed `p^a`-th twisted complex, reduced modulo `q^{p^a} - 1` with the quotient convention, onto
the p-completed Nygaard filtration of `qW_{p^a} Ω_{S/A}` (of filtered `E∞`-, indeed filtered derived
commutative, algebras; underlying filtered objects here). Its uniqueness, and that it recovers the
deformation equivalence in degree zero, are not stated. -/
def qWittOmega.nygaardFil_comparison (T : QWittContext K H) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a)
    (S : SmoothAlg A) :
    filQuotient (twistedQOmega.nygaardFilReduced T p a S) ⋙ T.pComplete p ≅
      (qWittOmega.nygaardFilFun T p a ha).obj S ⋙ T.pComplete p :=
  sorry

/-- The combined Hodge and `Φ_{p^a}(q)`-adic filtration on
`((dR_{R/A})^∧_p ⊗^L_{A,ψ^{p^a}} A[q])[1/p]^∧_{Φ_{p^a}(q)}` (DD.1's completed Day convolution of the
Hodge filtration with the `Φ_{p^a}(q)`-adic filtration). -/
def combinedFiltrationCyc (T : QWittContext K H) (p : Nat.Primes) (a : ℕ) :
    Ani ⥤ FilModule (cyclotomic ((p : ℕ) ^ a) A) 𝒞 :=
  sorry

/-- **Lemma (HQ.4/the-nygaard-filtration-after-inverting-p).** After inverting `p` and completing at
`Φ_p(q)`, the prismatic Nygaard filtration on the p-completed `p`-th twisted derived q-de Rham
complex is (uniquely) the combined Hodge and `Φ_p(q)`-adic filtration on
`((dR_{R/A})^∧_p ⊗_φ)[1/p]^∧_{Φ_p(q)}`. -/
theorem twistedQdR_nygaard_rational (T : QWittContext K H) (p : Nat.Primes) (R : Ani) :
    Nonempty ((twistedQdR.nygaardFil T p 1).obj R ⋙ T.invert p ⋙ T.completeAt (cyclotomic p A) ≅
      ((combinedFiltrationCyc T p 1).obj R).fil) := by
  sorry

/-- **Comparison (HQ.4/no-automatic-multiplicative-upgrade).** The HQ.4 constructions carry exactly
the multiplicative structure of their inputs: the twisted q-de Rham complexes are `E∞`-algebras
(commutative monoids in `D(A[q])`, owner E1's symmetric monoidal structure), since each local piece
is and the complete-descent gluing is one of `E∞`-algebras; the animated stupid filtrations carry
filtered derived commutative structures (`qWittDR.fil_derivedCommutative`). Transport to the
Habiro–Hodge complex is HQ.3's `multiplicative_upgrades`; the source's expectation that the
Habiro–Hodge complex of a smooth scheme carries no `E∞`-structure is not a theorem and is not
stated. -/
theorem twistedQOmega_commMonObj [MonoidalCategory 𝒞] [BraidedCategory 𝒞] (T : QWittContext K H)
    (m : ℕ+) (S : SmoothAlg A) :
    ∃ _ : MonObj ((twistedQOmega T m).obj S), IsCommMonObj ((twistedQOmega T m).obj S) := by
  sorry

end DerivedQWitt

end HQ4

/-! ## HQ.3 — q-Hodge filtrations, the q-Hodge complex and Habiro descent

(Placed after HQ.4, whose twisted q-de Rham complexes, Nygaard filtrations and derived
q-de Rham–Witt complexes it uses.) -/

section HQ3

variable {A : Type u} [CommRing A] {Λ : LambdaRing A} {Ani 𝒟 ℰ Mod : Type*} [Category Ani]
  [Category 𝒟] [Category ℰ] [Category Mod] [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ]
  [HasPullbacks 𝒟] {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear A[X] 𝒞]
  [HasFiniteColimits 𝒞] {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod}

/-! ### Helpers on filtered modules -/

/-- The derived quotient is functorial in isomorphisms. -/
def quotByIso (f : A[X]) {M N : 𝒞} (e : M ≅ N) : quotBy f M ≅ quotBy f N :=
  cokernel.mapIso _ _ e e (by simp)

/-- The quotient convention commutes with exact `A[q]`-linear functors, applied degreewise. -/
def filQuotient_map {f : A[X]} (G : 𝒞 ⥤ 𝒞) [G.Linear A[X]] [PreservesFiniteColimits G]
    (M : FilModule f 𝒞) : filQuotient (M.map G) ≅ filQuotient M ⋙ G :=
  sorry

/-- A natural transformation between linear functors induces a map of transported filtered
modules. -/
def FilModule.mapNat {f : A[X]} {G G' : 𝒞 ⥤ 𝒞} [G.Linear A[X]] [G'.Linear A[X]] (α : G ⟶ G')
    (M : FilModule f 𝒞) : M.map G ⟶ M.map G' :=
  ⟨Functor.whiskerLeft M.fil α, fun n => α.naturality (M.mul n)⟩

/-- The completion `lim_k cofib(fil^{n+k} → fil^n)` of a filtered module, degreewise. -/
def FilModule.complete {f : A[X]} (M : FilModule f 𝒞) : FilModule f 𝒞 := sorry

/-- The map `gr^n → gr^{n+1}` induced by `β`. -/
def FilModule.grMul {f : A[X]} (M : FilModule f 𝒞) (n : ℕ) :
    FilN.gr M.fil n ⟶ FilN.gr M.fil (n + 1) :=
  cokernel.map _ _ (M.mul (n + 1)) (M.mul n) (by rw [M.trans_mul, M.mul_trans])

/-- The composite of `k` multiplications `fil^n → fil^{n+k}` (multiplication by `f^k`). -/
def FilModule.mulIter {f : A[X]} (M : FilModule f 𝒞) (n : ℕ) : ∀ k : ℕ,
    M.fil.obj (op n) ⟶ M.fil.obj (op (n + k))
  | 0 => 𝟙 _
  | k + 1 => FilModule.mulIter M n k ≫ M.mul (n + k)

/-- The colimit of `fil^0 → fil^1 → ⋯` along `β`: the degree-zero part of `M[1/β]`. -/
def FilModule.colimMul [HasColimitsOfShape ℕ 𝒞] {f : A[X]} (M : FilModule f 𝒞) : 𝒞 :=
  colimit (Functor.ofSequence M.mul)

/-- The canonical map `qdR_{S/A} → qΩ_{S/A}` on smooth algebras (from the universal property of
animation; it is the Hodge completion, not an equivalence). -/
def qdR.toQOmega (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) : K.ofSmooth ⋙ qdR K ⟶ qOmega K := sorry

/-! ### q-Hodge filtrations (node HQ.3/q-hodge-filtrations) -/

/-- **Definition (HQ.3/q-hodge-filtrations).** API `QHodgeFiltration`: a q-Hodge filtration on the
derived q-de Rham complex of an animated `A`-algebra `R` (Definition 3.2): a filtered
`(q-1)^⋆A[q]`-module, constant below zero, with

* (a) `zerothEquiv`, an equivalence `qdR_{R/A} ≃ fil^0`;
* (b) `modQSubOneEquiv`, an equivalence of the quotient by `q - 1` IN FILTRATION DEGREE ONE with
  the Hodge filtration of `dR_{R/A}`, agreeing in degree `0` with `qdR/(q-1) ≃ dR`;
* (c) `rationalEquiv`, an equivalence of the `(q-1)`-completed rationalisation with the combined
  Hodge and `(q-1)`-adic filtration, agreeing in degree `0` with the rational comparison, with its
  square against (b);
* (c_p) `pAdicRationalEquiv`, for every prime, the p-completed version, agreeing in degree `0`,
  with its squares against (c) and (b).

Clause (c_p) is a separate datum (it does not seem to follow from the others). The compatibility
between the two squares of (c_p) is a higher datum with no shadow in the 1-categorical model and is
left to the owner of the ∞-categorical enhancement (DerivedDeRhamCohomology DD.1). -/
structure QHodgeFiltration (H : HodgeContext K 𝒞) (R : Ani) where
  /-- The filtered `(q-1)^⋆A[q]`-module. -/
  fil : FilModule ((X : A[X]) - 1) 𝒞
  /-- (a) `c_0`: `qdR_{R/A} ≃ fil^0` (API `QHodgeFiltration.zerothEquiv`). -/
  c0 : H.forget.obj ((qdR K).obj R) ≅ fil.fil.obj (op 0)
  /-- (b) `c_{(q-1)}`: `fil^⋆/(q-1) ≃ fil^⋆_Hdg dR_{R/A}` (API `QHodgeFiltration.modQSubOneEquiv`). -/
  cQ1 : filQuotient fil ≅ H.hodgeFil.obj R
  cQ1_nonpos : cQ1.app (op 0) =
    filQuotient.piece_of_nonpos fil ≪≫ quotByIso _ c0.symm ≪≫
      H.forget_modQ ((qdR K).obj R) ≪≫ H.forgetE.mapIso ((qdR.modQSubOne K).app R) ≪≫
        (H.hodgeFil_zero.app R).symm
  /-- (c) `c_ℚ` (API `QHodgeFiltration.rationalEquiv`). -/
  cQ : fil.map H.ratC ≅ (combinedFiltration H).obj R
  cQ_nonpos : cQ.hom.1.app (op 0) =
    H.ratC.map c0.inv ≫ H.forget_rat.inv.app ((qdR K).obj R) ≫
      H.forget.map ((qdR.rationalComparison K).hom.app R) ≫ (combinedFiltration.of_nonpos H R).inv
  cQ_square : filQuotient.map cQ.hom ≫ (combinedFiltration.quotient H R).hom =
    (filQuotient_map H.ratC fil).hom ≫ Functor.whiskerRight cQ1.hom H.ratC
  /-- (c_p) `c_{ℚ_p}` (API `QHodgeFiltration.pAdicRationalEquiv`). -/
  cQp : ∀ p, fil.map (H.pRatC p) ≅ (combinedFiltration.pComplete H p).obj R
  cQp_nonpos : ∀ p, (cQp p).hom.1.app (op 0) =
    (H.pRatC p).map c0.inv ≫ (H.forget_pRat p).inv.app ((qdR K).obj R) ≫
      H.forget.map ((qdR.pRationalComparison K p).hom.app R) ≫
        (combinedFiltration.pComplete_of_nonpos H p R).inv
  cQp_square_cQ : ∀ p, cQ.hom ≫ (combinedFiltration.toPComplete H p).app R =
    FilModule.mapNat (H.ratToPRatC p) fil ≫ (cQp p).hom
  cQp_square_cQ1 : ∀ p, filQuotient.map (cQp p).hom ≫
      (combinedFiltration.pComplete_quotient H p R).hom =
    (filQuotient_map (H.pRatC p) fil).hom ≫ Functor.whiskerRight cQ1.hom (H.pRatC p)

namespace QHodgeFiltration

variable {H : HodgeContext K 𝒞} {R : Ani}

/-- API `QHodgeFiltration.zerothEquiv`: clause (a), the equivalence from the derived q-de Rham
complex onto the zeroth step. -/
def zerothEquiv (F : QHodgeFiltration H R) : H.forget.obj ((qdR K).obj R) ≅ F.fil.fil.obj (op 0) :=
  F.c0

/-- API `QHodgeFiltration.modQSubOneEquiv`: clause (b), `c_{(q-1)}` from the filtered quotient by
`q - 1` onto the Hodge filtration, agreeing in degree `0` with the unfiltered identification
(`F.cQ1_nonpos`). -/
def modQSubOneEquiv (F : QHodgeFiltration H R) : filQuotient F.fil ≅ H.hodgeFil.obj R := F.cQ1

/-- API `QHodgeFiltration.rationalEquiv`: clause (c), `c_ℚ`, with its square against `c_{(q-1)}`
(`F.cQ_square`). -/
def rationalEquiv (F : QHodgeFiltration H R) : F.fil.map H.ratC ≅ (combinedFiltration H).obj R :=
  F.cQ

/-- API `QHodgeFiltration.pAdicRationalEquiv`: clause (c_p), `c_{ℚ_p}`, with its squares against
`c_ℚ` and `c_{(q-1)}` (`F.cQp_square_cQ`, `F.cQp_square_cQ1`). -/
def pAdicRationalEquiv (F : QHodgeFiltration H R) (p : Nat.Primes) :
    F.fil.map (H.pRatC p) ≅ (combinedFiltration.pComplete H p).obj R :=
  F.cQp p

end QHodgeFiltration

/-- `dim(S/A) ≤ d` for a smooth algebra: `Ω¹_{S/A}` has rank at most `d` at every prime. -/
def RelDimLE (A S : Type u) [CommRing A] [CommRing S] [Algebra A S] (d : ℕ) : Prop :=
  ∀ (P : Ideal S) [P.IsPrime],
    Module.rank (Localization.AtPrime P) (LocalizedModule P.primeCompl Ω[S⁄A]) ≤ d

/-- The data of a filtration of the UNDERIVED q-de Rham complex of a smooth algebra satisfying
the analogues of clauses (a) to (c_p) (Remark 3.6): the targets are the Hodge filtration of
`Ω*_{S/A}` and the completed combined filtrations. -/
structure UnderivedQHodgeData (H : HodgeContext K 𝒞) (S : SmoothAlg A) where
  /-- The filtration of `qΩ_{S/A}`. -/
  fil : FilModule ((X : A[X]) - 1) 𝒞
  c0 : H.forget.obj ((qOmega K).obj S) ≅ fil.fil.obj (op 0)
  cQ1 : filQuotient fil ≅ H.hodgeFilSmooth.obj S
  cQ : fil.map H.ratC ≅ FilModule.complete ((combinedFiltration H).obj (K.ofSmooth.obj S))
  cQp : ∀ p, fil.map (H.pRatC p) ≅
    FilModule.complete ((combinedFiltration.pComplete H p).obj (K.ofSmooth.obj S))

/-- API `QHodgeFiltration.ofUnderived`: for smooth `S`, a filtration of the underived q-de Rham
complex satisfying the analogues of (a) to (c_p) pulls back along `qdR_{S/A} → qΩ_{S/A}` to a
q-Hodge filtration (Remark 3.6), because `Ω*_{S/A}` is the Hodge completion of `dR_{S/A}` and every
filtration is the pullback of its completion. -/
def QHodgeFiltration.ofUnderived {H : HodgeContext K 𝒞} {S : SmoothAlg A}
    (U : UnderivedQHodgeData H S) : QHodgeFiltration H (K.ofSmooth.obj S) :=
  sorry

/-- The filtration of `QHodgeFiltration.ofUnderived` is the degreewise pullback. -/
theorem QHodgeFiltration.ofUnderived_fil {H : HodgeContext K 𝒞} {S : SmoothAlg A}
    (U : UnderivedQHodgeData H S) (n : ℕ) :
    ∃ (f : (QHodgeFiltration.ofUnderived U).fil.fil.obj (op n) ⟶ U.fil.fil.obj (op n))
      (g : (QHodgeFiltration.ofUnderived U).fil.fil.obj (op n) ⟶
        H.forget.obj ((qdR K).obj (K.ofSmooth.obj S))),
      IsPullback f g (U.fil.fil.map (homOfLE (Nat.zero_le n)).op ≫ U.c0.inv)
        (H.forget.map ((qdR.toQOmega K).app S)) := by
  sorry

/-- API `QHodgeFiltration.ofRational`: over a `ℚ`-algebra `A`, the combined Hodge and
`(q-1)`-adic filtration, transported along the rational comparison, is a q-Hodge filtration. -/
def QHodgeFiltration.ofRational [Algebra ℚ A] (H : HodgeContext K 𝒞) (R : Ani) :
    QHodgeFiltration H R :=
  sorry

theorem QHodgeFiltration.ofRational_fil [Algebra ℚ A] (H : HodgeContext K 𝒞) (R : Ani) :
    Nonempty ((QHodgeFiltration.ofRational H R).fil ≅ (combinedFiltration H).obj R) := by
  sorry

/-! ### The category of pairs -/

/-- A pair: an animated `A`-algebra with a q-Hodge filtration on its derived q-de Rham complex. -/
structure Pair (H : HodgeContext K 𝒞) where
  /-- The animated algebra. -/
  R : Ani
  /-- The q-Hodge filtration. -/
  F : QHodgeFiltration H R

/-- The map of filtered modules induced by an `A[q]`-linear functor. -/
def FilModule.mapHom {f : A[X]} (G : 𝒞 ⥤ 𝒞) [G.Linear A[X]] {M N : FilModule f 𝒞} (φ : M ⟶ N) :
    M.map G ⟶ N.map G :=
  ⟨Functor.whiskerRight φ.1 G, fun n => by
    simp only [FilModule.map, Functor.whiskerRight_app, ← G.map_comp, φ.2 n]⟩

/-- Morphisms of pairs: a map of animated algebras and a map of filtrations compatible with all
the data of Definition 3.2 (the 1-categorical shadow of the iterated pullback). -/
structure Pair.Hom {H : HodgeContext K 𝒞} (P P' : Pair H) where
  /-- The map of algebras. -/
  f : P.R ⟶ P'.R
  /-- The map of filtrations. -/
  φ : P.F.fil ⟶ P'.F.fil
  comm_zeroth : P.F.zerothEquiv.hom ≫ φ.1.app (op 0) =
    H.forget.map ((qdR K).map f) ≫ P'.F.zerothEquiv.hom
  comm_modQ : filQuotient.map φ ≫ P'.F.modQSubOneEquiv.hom =
    P.F.modQSubOneEquiv.hom ≫ H.hodgeFil.map f
  comm_rational : P.F.rationalEquiv.hom ≫ (combinedFiltration H).map f =
    FilModule.mapHom H.ratC φ ≫ P'.F.rationalEquiv.hom
  comm_pAdic : ∀ p, (P.F.pAdicRationalEquiv p).hom ≫ (combinedFiltration.pComplete H p).map f =
    FilModule.mapHom (H.pRatC p) φ ≫ (P'.F.pAdicRationalEquiv p).hom

/-- API `PairsCat`: the category of pairs `(R, q-Hodge filtration)`, the iterated pullback of
animated `A`-algebras with categories of filtered modules. -/
def PairsCat (H : HodgeContext K 𝒞) : Type _ := Pair H

instance (H : HodgeContext K 𝒞) : Category (PairsCat H) where
  Hom P P' := Pair.Hom P P'
  id P := ⟨𝟙 _, 𝟙 _, sorry, sorry, sorry, sorry⟩
  comp α β := ⟨α.f ≫ β.f, α.φ ≫ β.φ, sorry, sorry, sorry, sorry⟩
  id_comp := sorry
  comp_id := sorry
  assoc := sorry

/-- The forgetful functor `PairsCat.forget` to animated `A`-algebras. -/
def PairsCat.forget (H : HodgeContext K 𝒞) : PairsCat H ⥤ Ani where
  obj P := P.R
  map α := α.f
  map_id _ := rfl
  map_comp _ _ := rfl

/-- API `PairsCat.forget_filtration`: the forgetful functor to filtered `(q-1)^⋆A[q]`-modules. -/
def PairsCat.forget_filtration (H : HodgeContext K 𝒞) :
    PairsCat H ⥤ FilModule ((X : A[X]) - 1) 𝒞 where
  obj P := P.F.fil
  map α := α.φ
  map_id _ := rfl
  map_comp _ _ := rfl

/-- The pair of a smooth algebra with the pullback of an underived filtration. -/
def PairsCat.ofUnderived {H : HodgeContext K 𝒞} {S : SmoothAlg A} (U : UnderivedQHodgeData H S) :
    PairsCat H :=
  ⟨K.ofSmooth.obj S, QHodgeFiltration.ofUnderived U⟩

/-- Unit test `QHodgeFiltration.dimOneDetermined`: for `S` smooth over `ℤ` of relative dimension at
most one, any filtered q-deformation of the Hodge filtration on the q-de Rham complex is
`(q-1)^{n-1}` times its first step in every degree `n ≥ 1` (the Hodge filtration vanishes from
degree two on). -/
example {Λℤ : LambdaRing ℤ} {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear ℤ[X] 𝒞]
    [HasFiniteColimits 𝒞] {K : QDeRhamContext ℤ Λℤ Ani 𝒟 ℰ Mod} {H : HodgeContext K 𝒞}
    (S : SmoothAlg ℤ) (hS : RelDimLE ℤ S.obj 1) (U : UnderivedQHodgeData H S) (n : ℕ) :
    IsIso (U.fil.mulIter 1 n) := by
  sorry

/-- Unit test `QHodgeFiltration.naivePullback`: the pullback of the Hodge filtration along
`qΩ → Ω` contains `(q-1)` times the whole complex in every step; already for `S = ℤ` its second step
is `(q-1)ℤ⟦q-1⟧ = ker(q ↦ 1)` instead of `(q-1)^2 ℤ⟦q-1⟧`, so it is not a q-Hodge filtration. -/
example :
    RingHom.ker (PowerSeries.constantCoeff (R := ℤ)) = Ideal.span {PowerSeries.X} ∧
      RingHom.ker (PowerSeries.constantCoeff (R := ℤ)) ≠ Ideal.span {(PowerSeries.X : PowerSeries ℤ)} ^ 2 := by
  sorry

/-- Unit test `QHodgeFiltration.agreement_nonpos`: in filtration degrees at most zero each of
`c_{(q-1)}`, `c_ℚ`, `c_{ℚ_p}` is the already known unfiltered identification. -/
example {H : HodgeContext K 𝒞} {R : Ani} (F : QHodgeFiltration H R) (p : Nat.Primes) :
    F.modQSubOneEquiv.app (op 0) =
      filQuotient.piece_of_nonpos F.fil ≪≫ quotByIso _ F.zerothEquiv.symm ≪≫
        H.forget_modQ ((qdR K).obj R) ≪≫ H.forgetE.mapIso ((qdR.modQSubOne K).app R) ≪≫
          (H.hodgeFil_zero.app R).symm ∧
    F.rationalEquiv.hom.1.app (op 0) =
      H.ratC.map F.zerothEquiv.inv ≫ H.forget_rat.inv.app ((qdR K).obj R) ≫
        H.forget.map ((qdR.rationalComparison K).hom.app R) ≫
          (combinedFiltration.of_nonpos H R).inv ∧
    (F.pAdicRationalEquiv p).hom.1.app (op 0) =
      (H.pRatC p).map F.zerothEquiv.inv ≫ (H.forget_pRat p).inv.app ((qdR K).obj R) ≫
        H.forget.map ((qdR.pRationalComparison K p).hom.app R) ≫
          (combinedFiltration.pComplete_of_nonpos H p R).inv :=
  ⟨F.cQ1_nonpos, F.cQ_nonpos, F.cQp_nonpos p⟩

/-- Unit test `QHodgeFiltration.ofRational`: if `A` is a `ℚ`-algebra, the combined filtration is a
q-Hodge filtration (clause (c_p) is vacuous), so the forgetful functor is essentially surjective;
this is the case Lemma 3.3 excludes. -/
example [Algebra ℚ A] (H : HodgeContext K 𝒞) :
    (∀ R : Ani, Nonempty ((QHodgeFiltration.ofRational H R).fil ≅ (combinedFiltration H).obj R)) ∧
      (PairsCat.forget H).EssSurj := by
  sorry

/-- **Owner: PrismaticCohomology PR.0.** The witness of Lemma 3.3: the quotient by `x` of the free
p-complete perfect δ-ring on `x` over `Â_p`, as an animated `A`-algebra, with the q-PD envelope data
of its p-completed derived q-de Rham complex (which is static). -/
structure WitnessData (K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod) (p : ℕ) where
  /-- The witness `R`. -/
  R : Ani
  /-- The envelope data: `qD = qdR_{R/A}^∧_p`, `D = dR_{R/A}^∧_p`, `x ∈ J`. -/
  E : QPDEnvelope.{u} p
  x : E.P
  hx : x ∈ E.J
  /-- Reduction modulo `q - 1`, `qD → D`. -/
  red : E.qD →+* E.D
  red_toqD : ∀ y, red (E.toqD y) = E.toD y

/-- **Lemma (HQ.3/the-witness-admits-no-q-hodge-filtration).** No element of the q-PD envelope
reducing modulo `q - 1` to the divided power `x^p/p` lies, after `(q-1)`-completed rationalisation,
in `(x, q - 1)^p`; consequently the p-completed derived q-de Rham complex of the witness admits no
filtration satisfying (b) and (c_p), and the witness admits no q-Hodge filtration. -/
theorem witness_no_qHodgeFiltration {p : ℕ} (hp : p.Prime) (H : HodgeContext K 𝒞)
    (W : WitnessData K p) :
    (∀ y : W.E.qD, W.red y = W.E.dividedPowers.dpow p (W.E.toD W.x) →
      W.E.ofqD y ∉ Ideal.span {W.E.ofqD (W.E.toqD W.x), W.E.ofqD W.E.q - 1} ^ p) ∧
    IsEmpty (QHodgeFiltration H W.R) := by
  sorry

/-- **Theorem (HQ.3/no-functorial-choice-of-q-hodge-filtration, Lemma 3.3).** If the perfectly
covered `A` is not a `ℚ`-algebra, the forgetful functor from pairs is not essentially surjective,
and it has no section, not even on smooth algebras (a section there would animate to one on all
animated algebras). -/
theorem no_functorial_qHodgeFiltration (hA : Λ.IsPerfectlyCovered)
    (hQ : ¬ Nonempty (Algebra ℚ A)) (H : HodgeContext K 𝒞) :
    ¬ (PairsCat.forget H).EssSurj ∧
      ¬ ∃ σ : SmoothAlg A ⥤ PairsCat H, Nonempty (σ ⋙ PairsCat.forget H ≅ K.ofSmooth) := by
  sorry

/-! ### The q-Hodge complex (node HQ.3/the-q-hodge-complex) -/

variable [HasColimitsOfShape ℕ 𝒞]

/-- The q-Hodge complex of a filtered module: `(colim(fil^0 → fil^1 → ⋯, q - 1))^∧_{(q-1)}`. -/
def qHodgeOf (H : HodgeContext K 𝒞) (M : FilModule ((X : A[X]) - 1) 𝒞) : 𝒞 :=
  H.qComplete.obj (FilModule.colimMul M)

/-- **Construction (HQ.3/the-q-hodge-complex).** API `qHodge`: the q-Hodge complex of a pair, the
`(q-1)`-completion of the colimit of the filtration along multiplication by `q - 1` (colimit first,
then completion). -/
def qHodge (H : HodgeContext K 𝒞) (P : PairsCat H) : 𝒞 := qHodgeOf H P.F.fil

/-- API `qHodge.ofCompletion`: unchanged when the filtration is replaced by its completion. -/
theorem qHodge.ofCompletion (H : HodgeContext K 𝒞) (P : PairsCat H) :
    Nonempty (qHodgeOf H (FilModule.complete P.F.fil) ≅ qHodge H P) := by
  sorry

/-- API `qHodge.map`: the q-Hodge complex is a functor on pairs (`qHodge.map_id`, `qHodge.map_comp`). -/
def qHodge.map (H : HodgeContext K 𝒞) {P P' : PairsCat H} (α : P ⟶ P') : qHodge H P ⟶ qHodge H P' :=
  sorry

theorem qHodge.map_id (H : HodgeContext K 𝒞) (P : PairsCat H) : qHodge.map H (𝟙 P) = 𝟙 _ := by
  sorry

theorem qHodge.map_comp (H : HodgeContext K 𝒞) {P P' P'' : PairsCat H} (α : P ⟶ P')
    (β : P' ⟶ P'') : qHodge.map H (α ≫ β) = qHodge.map H α ≫ qHodge.map H β := by
  sorry

/-- API `qHodge.ofUnderived`: for smooth `S` and an underived filtration, the q-Hodge complex of the
pulled-back filtration is the colimit computed on the underived filtration. -/
theorem qHodge.ofUnderived (H : HodgeContext K 𝒞) {S : SmoothAlg A} (U : UnderivedQHodgeData H S) :
    Nonempty (qHodge H (PairsCat.ofUnderived U) ≅ qHodgeOf H U.fil) := by
  sorry

/-- The coordinate q-Hodge filtration `(q-1)^{max(n - *, 0)} qΩ*_{S/A,□}` of a framed smooth
algebra, as underived data (Example 3.12). -/
def coordinateFiltration (H : HodgeContext K 𝒞) {S : Type u} [CommRing S] [Algebra A S]
    [Algebra.Smooth A S] {d : ℕ} (F : EtaleFraming A S d) : UnderivedQHodgeData H (SmoothAlg.of S) :=
  sorry

/-- The framed pair: the pullback of the coordinate filtration (an `E_0`-algebra in pairs). -/
def framedPair (H : HodgeContext K 𝒞) {S : Type u} [CommRing S] [Algebra A S] [Algebra.Smooth A S]
    {d : ℕ} (F : EtaleFraming A S d) : PairsCat H :=
  PairsCat.ofUnderived (coordinateFiltration H F)

/-- The operators `(q - 1) q∂_i` of the coordinate q-Hodge complex. -/
def qHodgeFramedOp {S : Type u} [CommRing S] [Algebra A S] {d : ℕ} (F : EtaleFraming A S d)
    (i : Fin d) : AddMonoid.End (PowerSeries S) :=
  (AddMonoidHom.mulLeft PowerSeries.X).comp (qOmegaFramed.qPartial F i)

/-- API `qHodge.framed`: for a framed smooth algebra with the coordinate filtration, the q-Hodge
complex is the q-difference complex with every differential multiplied by `q - 1`. -/
theorem qHodge.framed (H : HodgeContext K 𝒞) {S : Type u} [CommRing S] [Algebra A S]
    [Algebra.Smooth A S] {d : ℕ} (F : EtaleFraming A S d) :
    Nonempty (qHodge H (framedPair H F) ≅ H.ofMod.obj (K.koszul (qHodgeFramedOp F))) := by
  sorry

/-- Unit test `qHodge.framed`: for a framed smooth algebra with the coordinate filtration
`(q-1)^{max(n - *, 0)}`, the q-Hodge complex is the q-difference complex with every differential
multiplied by `q - 1`. -/
example (H : HodgeContext K 𝒞) {S : Type u} [CommRing S] [Algebra A S] [Algebra.Smooth A S] {d : ℕ}
    (F : EtaleFraming A S d) (i : Fin d) (f : PowerSeries S) :
    Nonempty (qHodge H (framedPair H F) ≅ H.ofMod.obj (K.koszul (qHodgeFramedOp F))) ∧
      qHodgeFramedOp F i f = PowerSeries.X * qOmegaFramed.qPartial F i f :=
  ⟨qHodge.framed H F, rfl⟩

/-- Unit test `qHodge.polynomial_one`: for `S = A[x]` with the coordinate filtration the q-Hodge
complex is `A[x]⟦q-1⟧ → A[x]⟦q-1⟧ dx`, `x^n ↦ (q^n - 1) x^{n-1} dx`, whereas the q-de Rham complex
has `x^n ↦ [n]_q x^{n-1} dx`. -/
example (q : A) (n : ℕ) :
    qHodgeDiff q ((X : A[X]) ^ n) = C (q ^ n - 1) * X ^ (n - 1) ∧
      qDiff q ((X : A[X]) ^ n) = C (qInt n q) * X ^ (n - 1) :=
  ⟨qHodgeDiff_X_pow q n, qDiff_X_pow q n⟩

/-- Unit test `qHodge.ofCompletion`: replacing the filtration by its completion does not change the
answer (a construction omitting the final `(q-1)`-completion would fail this). -/
example (H : HodgeContext K 𝒞) (P : PairsCat H) :
    Nonempty (qHodgeOf H (FilModule.complete P.F.fil) ≅ qHodge H P) :=
  qHodge.ofCompletion H P

/-- Unit test `qHodge.ne_qdR`: the q-Hodge complex is not the q-de Rham complex: for `A[x]` the
differential sends `x` to `(q - 1) dx`, so the cokernel in degree one has the summand
`A⟦q-1⟧/(q-1)·dx`, while the q-de Rham differential sends `x` to `[1]_q dx = dx`. -/
example (H : HodgeContext K 𝒞) (q : A) :
    qHodgeDiff q (X : A[X]) = C (q - 1) ∧ qDiff q (X : A[X]) = 1 ∧
      ¬ Nonempty (qHodge H (framedPair H (EtaleFraming.polyId A 1)) ≅
        H.ofMod.obj (K.koszul (qOmegaFramed.qPartial (EtaleFraming.polyId A 1)))) := by
  sorry

/-! ### The conjugate filtration (node HQ.3/the-conjugate-filtration) -/

/-- The ascending filtration `gr^0 → gr^1 → ⋯` along the maps induced by `β`, whose colimit is
`M[1/β]_0/(βt)` (the construction of the abstract colimit-filtration lemma). -/
def FilModule.conjFil {f : A[X]} (M : FilModule f 𝒞) : ℕ ⥤ 𝒞 := Functor.ofSequence M.grMul

/-- **Construction (HQ.3/the-conjugate-filtration).** API `qHodge.conjFil`: the exhaustive
ascending filtration on the reduction of the q-Hodge complex modulo `q - 1`, the colimit of the
Hodge-graded pieces along multiplication by `q - 1` (the ascending direction of the bifiltration). -/
def qHodge.conjFil (H : HodgeContext K 𝒞) (P : PairsCat H) : ℕ ⥤ 𝒞 := P.F.fil.conjFil

/-- API `qHodge.gr_conjFil`: its `n`-th graded piece is the `n`-th Hodge graded piece of derived de
Rham cohomology, equivalently the `n`-th derived form shifted by `-n` (from clause (b)). -/
theorem qHodge.gr_conjFil (H : HodgeContext K 𝒞) (P : PairsCat H) (n : ℕ) :
    Nonempty (cokernel ((qHodge.conjFil H P).map (homOfLE (Nat.le_succ n))) ≅
      FilN.gr (H.hodgeFil.obj P.R) (n + 1)) := by
  sorry

/-- API `qHodge.conjFil_exhaustive`: its colimit is the whole reduction modulo `q - 1`. -/
theorem qHodge.conjFil_exhaustive (H : HodgeContext K 𝒞) (P : PairsCat H) :
    Nonempty (colimit (qHodge.conjFil H P) ≅ quotBy ((X : A[X]) - 1) (qHodge H P)) := by
  sorry

/-- API `qHodge.conjFil_zero`: the zeroth step is the zeroth Hodge graded piece (which is `R`). -/
theorem qHodge.conjFil_zero (H : HodgeContext K 𝒞) (P : PairsCat H) :
    Nonempty ((qHodge.conjFil H P).obj 0 ≅ FilN.gr (H.hodgeFil.obj P.R) 0) := by
  sorry

/-- API `qHodge.modQSubOne`: the reduction of the q-Hodge complex modulo `q - 1` carries the
conjugate filtration. -/
theorem qHodge.modQSubOne (H : HodgeContext K 𝒞) (P : PairsCat H) :
    Nonempty (quotBy ((X : A[X]) - 1) (qHodge H P) ≅ colimit (qHodge.conjFil H P)) :=
  (qHodge.conjFil_exhaustive H P).map Iso.symm

/-- **Owners: EnhancedDerivedSheaves E1, E5, DerivedDeRhamCohomology DD.1, HabiroRings HR.2.** The
tensor products the monoidal statements use (their coherence constraints are the owners'): the
derived tensor product of animated `A`-algebras, the `(q-1)`-completed tensor product on `D(A[q])`,
the completed tensor product of filtered modules over `f^⋆A[q]` (Day convolution), the Day
convolution of ascending filtrations, and the completed tensor product of Habiro-complete objects. -/
structure TensorData (H : HodgeContext K 𝒞) where
  tensorAni : Ani → Ani → Ani
  completedTensor : 𝒞 → 𝒞 → 𝒞
  filTensor : ∀ {f : A[X]}, FilModule f 𝒞 → FilModule f 𝒞 → FilModule f 𝒞
  dayTensor : (ℕ ⥤ 𝒞) → (ℕ ⥤ 𝒞) → (ℕ ⥤ 𝒞)
  habiroTensor : 𝒞 → 𝒞 → 𝒞

/-- The tensor product of two pairs: the derived tensor product of the algebras with the
`(q-1)`-completed tensor product of the filtrations over the filtered coefficient ring. -/
def PairsCat.tensor {H : HodgeContext K 𝒞} (TD : TensorData H) (P P' : PairsCat H) : PairsCat H :=
  sorry

/-- API `qHodge.conjFil_laxMonoidal`: the lax symmetric monoidal structure on the conjugate
filtration (its structure maps; coherences are the owner's). -/
theorem qHodge.conjFil_laxMonoidal (H : HodgeContext K 𝒞) (TD : TensorData H) (P P' : PairsCat H) :
    Nonempty (TD.dayTensor (qHodge.conjFil H P) (qHodge.conjFil H P') ⟶
      qHodge.conjFil H (PairsCat.tensor TD P P')) := by
  sorry

/-- Unit test `qHodge.conjFil_zero`: the zeroth step, and zeroth graded piece, is `R`, the zeroth
Hodge graded piece of derived de Rham cohomology. -/
example (H : HodgeContext K 𝒞) (P : PairsCat H) :
    Nonempty ((qHodge.conjFil H P).obj 0 ≅ FilN.gr (H.hodgeFil.obj P.R) 0) :=
  qHodge.conjFil_zero H P

/-- Unit test `qHodge.conjFil_smooth_finite`: for `S` smooth of relative dimension `d`, the `n`-th
graded piece is `Ω^n_{S/A}[-n]`, zero for `n > d`, so the filtration reaches the whole object at
stage `d`. -/
example (H : HodgeContext K 𝒞) {S : SmoothAlg A} (d : ℕ) (hS : RelDimLE A S.obj d)
    (U : UnderivedQHodgeData H S) (n : ℕ) (hn : d ≤ n) :
    IsIso ((qHodge.conjFil H (PairsCat.ofUnderived U)).map (homOfLE (Nat.le_succ n))) := by
  sorry

/-- Unit test `qHodge.conjFil_ascending`: the conjugate filtration is ascending; the other direction
of the bifiltration is the `(q-1)`-adic filtration of the q-Hodge complex, whose graded pieces are
copies of the reduction modulo `q - 1`, not the shifted de Rham forms. -/
example (H : HodgeContext K 𝒞) (P : PairsCat H) (n : ℕ) :
    Nonempty (cokernel ((qHodge.conjFil H P).map (homOfLE (Nat.le_succ n))) ≅
      FilN.gr (H.hodgeFil.obj P.R) (n + 1)) ∧
    Nonempty (FilN.gr (FilModule.adic ((X : A[X]) - 1) (qHodge H P)).fil n ≅
      quotBy ((X : A[X]) - 1) (qHodge H P)) := by
  sorry

/-- Unit test `qHodge.conjFil_underlying`: its underlying object is the reduction of the q-Hodge
complex modulo `q - 1`, not the de Rham complex: for `A = ℤ`, `S = ℤ[x]` with the coordinate
filtration the differential `x^n ↦ (q^n - 1) x^{n-1} dx` vanishes modulo `q - 1`, so `H^1 = ℤ[x] dx`,
while `H^1` of the de Rham complex of `ℤ[x]` is `⊕_n ℤ/n`. -/
example (n : ℕ) : qHodgeDiff (1 : ℤ) ((X : ℤ[X]) ^ n) = 0 ∧
    qDiff (1 : ℤ) ((X : ℤ[X]) ^ n) = C (n : ℤ) * X ^ (n - 1) := by
  sorry

/-- **Theorem (HQ.3/the-abstract-colimit-filtration-lemma).** For a graded module over
`A[β, t]` (a filtered module in the graded presentation, with `f = βt`), the degree-zero part of
`M[1/β]` modulo `βt` has the canonical exhaustive ascending filtration `M.conjFil`, whose associated
graded is `M/(β, t)`. For the q-Hodge filtration this is the conjugate filtration; for the twisted
filtrations the q-Witt filtration. -/
theorem abstract_colimit_filtration {f : A[X]} (M : FilModule f 𝒞) (n : ℕ) :
    Nonempty (colimit M.conjFil ≅ quotBy f M.colimMul) ∧
      Nonempty (M.conjFil.obj 0 ≅ FilN.gr (filQuotient M) 0) ∧
      Nonempty (cokernel (M.conjFil.map (homOfLE (Nat.le_succ n))) ≅
        FilN.gr (filQuotient M) (n + 1)) := by
  sorry

/-- **Theorem (HQ.3/the-symmetric-monoidal-structure-on-pairs, Proposition 3.7).** The category of
pairs is symmetric monoidal, the tensor product having underlying algebra the derived tensor product
and filtration the `(q-1)`-completed tensor product of the filtrations; the q-Hodge complex functor
is symmetric monoidal (not merely lax) into `(q-1)`-complete `A[q]`-modules. -/
theorem qHodge_symmetricMonoidal (H : HodgeContext K 𝒞) (TD : TensorData H) (P P' : PairsCat H) :
    (PairsCat.tensor TD P P').R = TD.tensorAni P.R P'.R ∧
      Nonempty ((PairsCat.tensor TD P P').F.fil ≅ TD.filTensor P.F.fil P'.F.fil) ∧
      Nonempty (qHodge H (PairsCat.tensor TD P P') ≅ TD.completedTensor (qHodge H P) (qHodge H P')) := by
  sorry

/-! ### The comparison with the underived complex on smooth inputs
(node HQ.3/the-smooth-comparison-of-q-omega-with-the-q-hodge-completion) -/

section Twisted

variable [HasLimitsOfShape ℕᵒᵖ 𝒞] {H : HodgeContext K 𝒞}

/-- **Theorem (HQ.3/the-smooth-comparison-of-q-omega-with-the-q-hodge-completion,
Proposition 3.47).** For `S` smooth over a perfectly covered `A` and a q-Hodge filtration on
`qdR_{S/A}`: (a) `qΩ_{S/A}` is the completion of `qdR_{S/A}` at the q-Hodge filtration (using
`c_{ℚ_p}`); (b) `Lη_{(q-1)} qHdg_{S/A} ≃ qΩ_{S/A}` (the source prints `qΩ_{R/A}`, E2). Neither says
the uncompleted derived and underived complexes agree. -/
theorem qdR_completion_smooth (T : QWittContext K H) (hA : Λ.IsPerfectlyCovered) (S : SmoothAlg A)
    (F : QHodgeFiltration H (K.ofSmooth.obj S)) :
    Nonempty (H.forget.obj ((qOmega K).obj S) ≅ FilN.completion F.fil.fil) ∧
      Nonempty ((T.Leta ((X : A[X]) - 1)).obj (qHodge H ⟨K.ofSmooth.obj S, F⟩) ≅
        H.forget.obj ((qOmega K).obj S)) := by
  sorry

/-! ### Twisted q-Hodge filtrations, p-adically (node HQ.3/the-twisted-q-hodge-filtration-p-adically) -/

/-- API `filRescale`: rescaling a filtration by a polynomial `h`, restriction along `t ↦ h t`: the
transition maps are multiplied by `h`, `β` is unchanged, so a filtered `g^⋆A[q]`-module becomes an
`(h g)^⋆A[q]`-module. Lax symmetric monoidal, not symmetric monoidal. -/
def filRescale {g : A[X]} (h : A[X]) (M : FilModule g 𝒞) : FilModule (h * g) 𝒞 where
  fil :=
    { obj := M.fil.obj
      map := fun {i j} φ => (h ^ (i.unop - j.unop)) • M.fil.map φ
      map_id := sorry
      map_comp := sorry }
  mul := M.mul
  mul_trans := sorry
  trans_mul := sorry

/-- The p-adic twisted q-Hodge filtrations are defined by recursion on `a`; this is the
construction. -/
def twistedQHodgeFil_pAdic (_T : QWittContext K H) (P : PairsCat H) (p : Nat.Primes) (a : ℕ) :
    FilModule ((X : A[X]) ^ ((p : ℕ) ^ a) - 1) 𝒞 :=
  sorry

/-- API `twistedQHodgeFil_pAdic_zero`: for `a = 0` it is the p-completed given q-Hodge filtration. -/
theorem twistedQHodgeFil_pAdic_zero (T : QWittContext K H) (P : PairsCat H) (p : Nat.Primes) :
    Nonempty ((twistedQHodgeFil_pAdic T P p 0).fil ≅ P.F.fil.fil ⋙ T.pComplete p) := by
  sorry

/-- API `twistedQHodgeFil_pAdic_succ`: for `a ≥ 1`, degreewise, the pullback of the prismatic
Nygaard filtration of the p-completed `p^a`-th twisted complex (by the relative Frobenius) and the
`Φ_{p^a}(q)`-rescaled filtration of index `p^{a-1}`, over the `Φ_{p^a}(q)`-adic filtration of the
p-completed `p^{a-1}`-th twisted complex. -/
theorem twistedQHodgeFil_pAdic_succ (T : QWittContext K H) (P : PairsCat H) (p : Nat.Primes) (a : ℕ) (ha : 1 ≤ a) (n : ℕ) :
    ∃ (f : (twistedQHodgeFil_pAdic T P p a).fil.obj (op n) ⟶
          (filRescale (cyclotomic ((p : ℕ) ^ a) A) (twistedQHodgeFil_pAdic T P p (a - 1))).fil.obj (op n))
      (g : (twistedQHodgeFil_pAdic T P p a).fil.obj (op n) ⟶
          ((twistedQdR.nygaardFil T p a).obj P.R).obj (op n))
      (h : (filRescale (cyclotomic ((p : ℕ) ^ a) A) (twistedQHodgeFil_pAdic T P p (a - 1))).fil.obj (op n) ⟶
          (FilModule.adic (cyclotomic ((p : ℕ) ^ a) A)
            ((T.pComplete p).obj ((twistedQdR T (pPow p (a - 1))).obj P.R))).fil.obj (op n))
      (k : ((twistedQdR.nygaardFil T p a).obj P.R).obj (op n) ⟶
          (FilModule.adic (cyclotomic ((p : ℕ) ^ a) A)
            ((T.pComplete p).obj ((twistedQdR T (pPow p (a - 1))).obj P.R))).fil.obj (op n)),
      IsPullback f g h k := by
  sorry

/-- API `twistedQHodgeFil_pAdic_mod`: its reduction modulo `q^{p^a} - 1` (quotient convention) is
the p-completed animated stupid filtration on `qW_{p^a} dR`. -/
theorem twistedQHodgeFil_pAdic_mod (T : QWittContext K H) (P : PairsCat H) (p : Nat.Primes) (a : ℕ) :
    Nonempty (filQuotient (twistedQHodgeFil_pAdic T P p a) ⋙ T.pComplete p ≅
      (qWittDR.hodgeWittFil T (pPow p a)).obj P.R ⋙ T.pComplete p) := by
  sorry

/-- API `twistedQHodgeFil_pAdic.transition`: the canonical map to the filtration of index
`p^{a-1}`, compatible with the relative Frobenius (a symmetric monoidal transformation). -/
def twistedQHodgeFil_pAdic.transition (T : QWittContext K H) (P : PairsCat H) (p : Nat.Primes) (a : ℕ) :
    (twistedQHodgeFil_pAdic T P p (a + 1)).fil ⟶ (twistedQHodgeFil_pAdic T P p a).fil :=
  sorry

/-- API `twistedQHodgeFil_pAdic.laxMonoidal`: the lax symmetric monoidal structure maps in the pair. -/
theorem twistedQHodgeFil_pAdic.laxMonoidal (T : QWittContext K H) (TD : TensorData H) (P P' : PairsCat H)
    (p : Nat.Primes) (a : ℕ) :
    Nonempty (TD.filTensor (twistedQHodgeFil_pAdic T P p a) (twistedQHodgeFil_pAdic T P' p a) ⟶
      twistedQHodgeFil_pAdic T (PairsCat.tensor TD P P') p a) := by
  sorry

/-- API `twistedQHodgeFil_pAdic_rational`; **Lemma (HQ.3/the-p-adic-twisted-filtration-after-
inverting-p).** After inverting `p` and completing at `Φ_{p^a}(q)` the filtration is the combined
Hodge and `Φ_{p^a}(q)`-adic filtration on the p-completion of `dR_{R/A}` base-changed along `ψ^{p^a}`
(compatibly with the rational comparison); for `a = 0` this is clause (c_p). -/
theorem twistedQHodgeFil_pAdic_rational (T : QWittContext K H) (P : PairsCat H) (p : Nat.Primes) (a : ℕ) :
    Nonempty ((twistedQHodgeFil_pAdic T P p a).fil ⋙ T.invert p ⋙
        T.completeAt (cyclotomic ((p : ℕ) ^ a) A) ≅ ((combinedFiltrationCyc T p a).obj P.R).fil) := by
  sorry

/-- **Lemma (HQ.3/the-p-adic-twisted-filtration-at-lower-cyclotomic-points).** For `a ≥ 1` and
`0 ≤ i ≤ a - 1`, the transition from index `p^a` to `p^{a-1}` becomes an equivalence after inverting
`p` and completing at `Φ_{p^i}(q)`. -/
theorem twistedQHodgeFil_pAdic_lowerCyclotomic (T : QWittContext K H) (P : PairsCat H) (p : Nat.Primes) (a i : ℕ)
    (hi : i ≤ a) :
    IsIso (Functor.whiskerRight (twistedQHodgeFil_pAdic.transition T P p a)
      (T.invert p ⋙ T.completeAt (cyclotomic ((p : ℕ) ^ i) A))) := by
  sorry

/-- Unit test `twistedQHodgeFil_pAdic_zero`: for `a = 0` the filtration is the p-completion of the
given q-Hodge filtration. -/
example (T : QWittContext K H) (P : PairsCat H) (p : Nat.Primes) :
    Nonempty ((twistedQHodgeFil_pAdic T P p 0).fil ≅ P.F.fil.fil ⋙ T.pComplete p) :=
  twistedQHodgeFil_pAdic_zero T P p

/-- Unit test `twistedQHodgeFil_pAdic_mod`: reducing modulo `q^{p^a} - 1` gives the stupid
filtration on the p-completed q-de Rham–Witt complex; the Nygaard filtration would fail this
already for `S = A` and `a = 1`. -/
example (T : QWittContext K H) (P : PairsCat H) (p : Nat.Primes) (a : ℕ) (hP : P.R = K.ofSmooth.obj (SmoothAlg.of A))
    [Nontrivial A] :
    Nonempty (filQuotient (twistedQHodgeFil_pAdic T P p a) ⋙ T.pComplete p ≅
      (qWittDR.hodgeWittFil T (pPow p a)).obj P.R ⋙ T.pComplete p) ∧
    ¬ Nonempty ((qWittDR.hodgeWittFil T (pPow p 1)).obj P.R ⋙ T.pComplete p ≅
      (qWittDR.nygaardFil T p 1 le_rfl).obj P.R ⋙ T.pComplete p) := by
  sorry

/-- Unit test `filRescale_notMonoidal`: rescaling by `Φ_p(q)` is lax but not strong monoidal: it
does not preserve the unit, since the rescaled unit filtration (transitions `Φ_p(q)`) is not
equivalent to the unit filtration (identity transitions), `Φ_p(q)` not being a unit of `A[q]`. -/
example [Nontrivial A] (p : Nat.Primes) (M : 𝒞) (hM : ¬ IsIso ((cyclotomic p A) • 𝟙 M)) :
    ¬ IsUnit (cyclotomic p A) ∧
      ¬ Nonempty ((filRescale (cyclotomic p A) (FilModule.adic (1 : A[X]) M)).fil ≅ (FilModule.adic (1 : A[X]) M).fil) := by
  sorry

/-- Unit test `twistedQHodgeFil_pAdic_rational`: after inverting `p` and completing at `Φ_{p^a}(q)`
the filtration is the combined Hodge and `Φ_{p^a}(q)`-adic filtration; for `a = 0` this is (c_p). -/
example (T : QWittContext K H) (P : PairsCat H) (p : Nat.Primes) (a : ℕ) :
    Nonempty ((twistedQHodgeFil_pAdic T P p a).fil ⋙ T.invert p ⋙
        T.completeAt (cyclotomic ((p : ℕ) ^ a) A) ≅ ((combinedFiltrationCyc T p a).obj P.R).fil) :=
  twistedQHodgeFil_pAdic_rational T P p a

/-! ### The global twisted q-Hodge filtration (node HQ.3/the-twisted-q-hodge-filtration-globally) -/

/-- The global twisted q-Hodge filtration built with an auxiliary non-zero multiple `N` of `m`,
glued along the animated fracture square of the `m`-th twisted derived q-de Rham complex. -/
def twistedQHodgeFilN (_T : QWittContext K H) (P : PairsCat H) (m : ℕ+) (N : ℕ) :
    FilModule ((X : A[X]) ^ (m : ℕ) - 1) 𝒞 :=
  sorry

/-- **Construction (HQ.3/the-twisted-q-hodge-filtration-globally).** API `twistedQHodgeFil`: for
each `m`, the canonical filtration on the `m`-th twisted derived q-de Rham complex, functorial in the
pair (the limit of `twistedQHodgeFilN` along the factorials `N = n!`, `n ≥ m`). -/
def twistedQHodgeFil (_T : QWittContext K H) (P : PairsCat H) (m : ℕ+) :
    FilModule ((X : A[X]) ^ (m : ℕ) - 1) 𝒞 :=
  sorry

/-- API `twistedQHodgeFil.gluing`: its restrictions to the factors of the fracture square are
(a) on `(-)[1/N]^∧_{Φ_d(q)}`, `d ∣ m`, the q-Hodge filtration base-changed along `ψ^d`, and (c) on
`(-)^∧_{(p, Φ_{d_p}(q))}`, `d_p ∣ m` prime to `p`, the p-adic twisted filtration of index
`p^{v_p(m)}` base-changed along `ψ^{d_p}` (the family (b), on the p-completed p-inverted factors,
agrees with (a) by inspection). -/
theorem twistedQHodgeFil.gluing (T : QWittContext K H) (P : PairsCat H) (m : ℕ+) (N : ℕ)
    (hmN : (m : ℕ) ∣ N) :
    (∀ d : ℕ+, d ∣ m → Nonempty ((twistedQHodgeFil T P m).fil ⋙ T.invert N ⋙
        T.completeAt (cyclotomic d A) ≅
      P.F.fil.fil ⋙ T.adamsBC d ⋙ T.invert N ⋙ T.completeAt (cyclotomic d A))) ∧
    ∀ (p : Nat.Primes) (dp : ℕ+), dp ∣ m → Nat.Coprime dp p →
      Nonempty ((twistedQHodgeFil T P m).fil ⋙ T.pComplete p ⋙ T.completeAt (cyclotomic dp A) ≅
        (twistedQHodgeFil_pAdic T P p ((m : ℕ).factorization p)).fil ⋙ T.adamsBC dp ⋙
          T.completeAt (cyclotomic dp A)) := by
  sorry

/-- API `twistedQHodgeFil.indep`: the construction does not depend on the auxiliary integer `N`. -/
theorem twistedQHodgeFil.indep (T : QWittContext K H) (P : PairsCat H) (m : ℕ+) (N N' : ℕ)
    (hN : N ≠ 0) (hmN : (m : ℕ) ∣ N) (hNN' : N ∣ N') :
    Nonempty ((twistedQHodgeFilN T P m N).fil ≅ (twistedQHodgeFilN T P m N').fil) ∧
      Nonempty ((twistedQHodgeFil T P m).fil ≅ (twistedQHodgeFilN T P m N).fil) := by
  sorry

/-- API `twistedQHodgeFil_mod`; **Theorem (HQ.3/the-twisted-q-hodge-filtration-deforms-the-stupid-
filtration, Proposition 3.39).** The equivalence `twistedQdR_m/(q^m - 1) ≃ qW_m dR` upgrades to an
equivalence of the twisted q-Hodge filtration modulo `q^m - 1` (quotient convention, `q^m - 1` in
filtration degree one) with the animated stupid filtration `fil_{Hdg_m} qW_m dR_{R/A}`; it is lax
symmetric monoidal in the pair (so of filtered `E_n`-algebras for an `E_n`-pair). -/
theorem twistedQHodgeFil_mod (T : QWittContext K H) (P : PairsCat H) (m : ℕ+) :
    Nonempty (filQuotient (twistedQHodgeFil T P m) ≅ (qWittDR.hodgeWittFil T m).obj P.R) := by
  sorry

/-- API `twistedQHodgeFil.transition`: for `n ∣ m`, the canonical map to the filtration of index `n`
(from the `(q^n - 1)`-completion); the maps form a symmetric monoidal transformation. -/
def twistedQHodgeFil.transition (T : QWittContext K H) (P : PairsCat H) {n m : ℕ+} (h : n ∣ m) :
    (twistedQHodgeFil T P m).fil ⋙ T.completeAt ((X : A[X]) ^ (n : ℕ) - 1) ⟶
      (twistedQHodgeFil T P n).fil :=
  sorry

/-- API `twistedQHodgeFil.laxMonoidal`: the lax symmetric monoidal structure maps in the pair. -/
theorem twistedQHodgeFil.laxMonoidal (T : QWittContext K H) (TD : TensorData H) (P P' : PairsCat H)
    (m : ℕ+) :
    Nonempty (TD.filTensor (twistedQHodgeFil T P m) (twistedQHodgeFil T P' m) ⟶
      twistedQHodgeFil T (PairsCat.tensor TD P P') m) := by
  sorry

/-- API `twistedQHodgeFil_one`: for `m = 1` it is the given q-Hodge filtration. -/
theorem twistedQHodgeFil_one (T : QWittContext K H) (P : PairsCat H) :
    Nonempty ((twistedQHodgeFil T P 1).fil ≅ P.F.fil.fil) := by
  sorry

/-- Unit test `twistedQHodgeFil_one`: for `m = 1` the twisted complex is the derived q-de Rham
complex and the filtration is the given q-Hodge filtration. -/
example (T : QWittContext K H) (P : PairsCat H) :
    Nonempty ((twistedQHodgeFil T P 1).fil ≅ P.F.fil.fil) :=
  twistedQHodgeFil_one T P

/-- Unit test `twistedQHodgeFil_mod`: its reduction modulo `q^m - 1` is the animated stupid
filtration on `qW_m dR`, whose `n`-th graded piece is `qW_m dR^n` shifted by `-n`. -/
example [HasShift 𝒞 ℤ] (T : QWittContext K H) (P : PairsCat H) (m : ℕ+) (n : ℕ) :
    Nonempty (filQuotient (twistedQHodgeFil T P m) ≅ (qWittDR.hodgeWittFil T m).obj P.R) ∧
      Nonempty (FilN.gr ((qWittDR.hodgeWittFil T m).obj P.R) n ≅
        (shiftFunctor 𝒞 (-(n : ℤ))).obj ((qWittDR.form T m n).obj P.R)) := by
  sorry

/-- Unit test `twistedQHodgeFil.indep`: the filtrations built with `N` and with a multiple `N'`
agree. -/
example (T : QWittContext K H) (P : PairsCat H) (m : ℕ+) (N N' : ℕ) (hN : N ≠ 0)
    (hmN : (m : ℕ) ∣ N) (hNN' : N ∣ N') :
    Nonempty ((twistedQHodgeFilN T P m N).fil ≅ (twistedQHodgeFilN T P m N').fil) :=
  (twistedQHodgeFil.indep T P m N N' hN hmN hNN').1

/-- Unit test `twistedQHodgeFil_rationalFactor`: on the factor `(-)[1/N]^∧_{Φ_d(q)}`, `d ∣ m`, the
filtration is the q-Hodge filtration base-changed along `ψ^d`; for a framed smooth `S` with the
coordinate filtration this is `Φ_d(q)^{max(n - *, 0)}` up to units. -/
example (T : QWittContext K H) {S : Type u} [CommRing S] [Algebra A S] [Algebra.Smooth A S] {e : ℕ}
    (F : EtaleFraming A S e) (m d : ℕ+) (hd : d ∣ m) (N : ℕ) (hmN : (m : ℕ) ∣ N) :
    Nonempty ((twistedQHodgeFil T (framedPair H F) m).fil ⋙ T.invert N ⋙
        T.completeAt (cyclotomic d A) ≅
      (framedPair H F).F.fil.fil ⋙ T.adamsBC d ⋙ T.invert N ⋙ T.completeAt (cyclotomic d A)) :=
  (twistedQHodgeFil.gluing T (framedPair H F) m N hmN).1 d hd

/-! ### Partial descents (node HQ.3/the-m-truncated-descent) -/

/-- **Construction (HQ.3/the-m-truncated-descent).** API `partialDescent`: the `(q^m - 1)`-completion
of the colimit of the twisted q-Hodge filtration along `q^m - 1` (informally, the twisted complex
with the `i`-th step divided by `(q^m - 1)^i` adjoined). -/
def partialDescent (T : QWittContext K H) (P : PairsCat H) (m : ℕ+) : 𝒞 :=
  (T.completeAt ((X : A[X]) ^ (m : ℕ) - 1)).obj (twistedQHodgeFil T P m).colimMul

/-- API `partialDescent_one`: for `m = 1` it is the q-Hodge complex. -/
theorem partialDescent_one (T : QWittContext K H) (P : PairsCat H) :
    Nonempty (partialDescent T P 1 ≅ qHodge H P) := by
  sorry

/-- API `partialDescent.laxMonoidal`: the lax symmetric monoidal structure maps in the pair. -/
theorem partialDescent.laxMonoidal (T : QWittContext K H) (TD : TensorData H) (P P' : PairsCat H)
    (m : ℕ+) :
    Nonempty (TD.completedTensor (partialDescent T P m) (partialDescent T P' m) ⟶
      partialDescent T (PairsCat.tensor TD P P') m) := by
  sorry

/-- API `partialDescent.completion`; **Theorem (HQ.3/the-partial-descents-are-compatible,
Proposition 3.43).** For `n ∣ m` the transition maps induce an equivalence from the
`(q^n - 1)`-completion of the `m`-th partial descent onto the `n`-th; in particular the `m`-th
partial descent is a descent of the q-Hodge complex along `ℤ[q]^∧_{(q^m-1)} → ℤ⟦q-1⟧`. -/
theorem partialDescent.completion (T : QWittContext K H) (P : PairsCat H) {n m : ℕ+} (h : n ∣ m) :
    Nonempty ((T.completeAt ((X : A[X]) ^ (n : ℕ) - 1)).obj (partialDescent T P m) ≅
      partialDescent T P n) ∧
    Nonempty ((T.completeAt ((X : A[X]) - 1)).obj (partialDescent T P m) ≅ qHodge H P) := by
  sorry

/-- API `partialDescent_mod`: its reduction modulo `q^m - 1` is the colimit of the graded pieces of
the twisted q-Hodge filtration along `q^m - 1`, an exhaustive ascending filtration. -/
theorem partialDescent_mod (T : QWittContext K H) (P : PairsCat H) (m : ℕ+) :
    Nonempty (quotBy ((X : A[X]) ^ (m : ℕ) - 1) (partialDescent T P m) ≅
      colimit (twistedQHodgeFil T P m).conjFil) := by
  sorry

/-- Unit test `partialDescent_one`: for `m = 1` the partial descent is the q-Hodge complex. -/
example (T : QWittContext K H) (P : PairsCat H) : Nonempty (partialDescent T P 1 ≅ qHodge H P) :=
  partialDescent_one T P

/-- Unit test `partialDescent.completion`: for `n ∣ m` the `(q^n - 1)`-completion of the `m`-th
partial descent is the `n`-th. -/
example (T : QWittContext K H) (P : PairsCat H) {n m : ℕ+} (h : n ∣ m) :
    Nonempty ((T.completeAt ((X : A[X]) ^ (n : ℕ) - 1)).obj (partialDescent T P m) ≅
      partialDescent T P n) :=
  (partialDescent.completion T P h).1

/-- Unit test `partialDescent_framed_rational`: for a framed smooth `S` with the coordinate filtration,
after inverting `N` and completing at `Φ_d(q)` the `m`-th partial descent is the `ψ^d`-twisted
coordinate complex with every differential multiplied by `Φ_d(q)` up to a unit (the `ψ^d`-twist of
the coordinate q-Hodge complex). -/
example (T : QWittContext K H) {S : Type u} [CommRing S] [Algebra A S] [Algebra.Smooth A S] {e : ℕ}
    (F : EtaleFraming A S e) (m d : ℕ+) (hd : d ∣ m) (N : ℕ) (hmN : (m : ℕ) ∣ N) :
    Nonempty ((T.completeAt (cyclotomic d A)).obj ((T.invert N).obj
        (partialDescent T (framedPair H F) m)) ≅
      (T.completeAt (cyclotomic d A)).obj ((T.invert N).obj ((T.adamsBC d).obj
        (H.ofMod.obj (K.koszul (qHodgeFramedOp F)))))) := by
  sorry

/-- Unit test `partialDescent_isComplete`: each partial descent is `(q^m - 1)`-complete by
construction (so the limit over `m` is Habiro-complete). -/
example (T : QWittContext K H) (P : PairsCat H) (m : ℕ+) :
    IsIso ((T.completeUnit ((X : A[X]) ^ (m : ℕ) - 1)).app (partialDescent T P m)) := by
  sorry

/-- **Lemma (HQ.3/nygaard-denominators, Lemma 3.44).** Adjoining to the p-completed `p`-th twisted
complex its Nygaard filtration divided by powers of `Φ_p(q)` and `(p, q-1)`-completing gives the
p-completed derived q-de Rham complex; divided by powers of `q^p - 1` it gives zero. Stated for
smooth inputs (the source states it for animated ones). -/
theorem nygaard_denominators (T : QWittContext K H) (p : Nat.Primes) (S : SmoothAlg A) :
    Nonempty ((T.completeAt ((X : A[X]) - 1)).obj ((T.pComplete p).obj
        ((twistedQOmega.nygaardFil T p 1).obj S).colimMul) ≅
      (T.pComplete p).obj (H.forget.obj ((qdR K).obj (K.ofSmooth.obj S)))) ∧
    IsZero ((T.completeAt ((X : A[X]) - 1)).obj ((T.pComplete p).obj
        (FilModule.restrictScalars ((X : A[X]) - 1) ((twistedQOmega.nygaardFil T p 1).obj S)).colimMul)) := by
  sorry

/-! ### The Habiro–Hodge complex (node HQ.3/the-habiro-hodge-complex) -/

/-- **Owner: HabiroRings HR.2.** The Habiro completion on `D(A[q])` (the limit over `m` of the
`(q^m - 1)`-completions, left adjoint to the inclusion of Habiro-complete objects), with its unit. -/
structure HabiroData (H : HodgeContext K 𝒞) where
  /-- The Habiro completion. -/
  habiroCompletion : 𝒞 ⥤ 𝒞
  habiroUnit : 𝟭 𝒞 ⟶ habiroCompletion

/-- Habiro-complete: the unit of the Habiro completion is an equivalence. -/
def HabiroData.IsHabiroComplete {H : HodgeContext K 𝒞} (Hb : HabiroData H) (M : 𝒞) : Prop :=
  IsIso (Hb.habiroUnit.app M)

/-- The divisibility poset of the positive integers. -/
def DivPoset : Type := ℕ+

instance : Preorder DivPoset where
  le a b := @Dvd.dvd ℕ+ _ a b
  le_refl a := @dvd_refl ℕ+ _ a
  le_trans a b c := @dvd_trans ℕ+ _ a b c

/-- The tower of partial descents along the factorials `(n+1)!`, with the transition equivalences. -/
def factorialTower (_T : QWittContext K H) (P : PairsCat H) : ℕᵒᵖ ⥤ 𝒞 := sorry

theorem factorialTower_obj (T : QWittContext K H) (P : PairsCat H) (n : ℕ) :
    (factorialTower T P).obj (op n) = partialDescent T P ⟨(n + 1).factorial, Nat.factorial_pos _⟩ := by
  sorry

/-- **Construction (HQ.3/the-habiro-hodge-complex).** API `qHabiroHodge`: the limit of the partial
descents over the divisibility poset, computed along the cofinal factorials. -/
def qHabiroHodge (T : QWittContext K H) (P : PairsCat H) : 𝒞 := limit (factorialTower T P)

/-- API `qHabiroHodge.qSubOneCompletion`: its `(q-1)`-completion is the q-Hodge complex. -/
theorem qHabiroHodge.qSubOneCompletion (T : QWittContext K H) (P : PairsCat H) :
    Nonempty ((T.completeAt ((X : A[X]) - 1)).obj (qHabiroHodge T P) ≅ qHodge H P) := by
  sorry

/-- API `qHabiroHodge.completion`: its `(q^m - 1)`-completion is the `m`-th partial descent. -/
theorem qHabiroHodge.completion (T : QWittContext K H) (P : PairsCat H) (m : ℕ+) :
    Nonempty ((T.completeAt ((X : A[X]) ^ (m : ℕ) - 1)).obj (qHabiroHodge T P) ≅
      partialDescent T P m) := by
  sorry

/-- The diagram of partial descents over the divisibility poset (only its individual transition
maps are constructed; the limit is computed along the factorials). -/
def divisibilityDiagram (_T : QWittContext K H) (P : PairsCat H) : DivPosetᵒᵖ ⥤ 𝒞 := sorry

/-- API `qHabiroHodge.limit_factorial`: the limit over the divisibility poset may be computed along
the factorials. -/
theorem qHabiroHodge.limit_factorial [HasLimitsOfShape DivPosetᵒᵖ 𝒞] (T : QWittContext K H)
    (P : PairsCat H) : Nonempty (limit (divisibilityDiagram T P) ≅ qHabiroHodge T P) := by
  sorry

/-- API `qHabiroHodge.map`: functoriality on pairs (`map_id`, `map_comp` as for `qHodge.map`). -/
def qHabiroHodge.map (T : QWittContext K H) {P P' : PairsCat H} (α : P ⟶ P') :
    qHabiroHodge T P ⟶ qHabiroHodge T P' :=
  sorry

theorem qHabiroHodge.map_id (T : QWittContext K H) (P : PairsCat H) :
    qHabiroHodge.map T (𝟙 P) = 𝟙 _ := by
  sorry

theorem qHabiroHodge.map_comp (T : QWittContext K H) {P P' P'' : PairsCat H} (α : P ⟶ P')
    (β : P' ⟶ P'') : qHabiroHodge.map T (α ≫ β) = qHabiroHodge.map T α ≫ qHabiroHodge.map T β := by
  sorry

/-- API `qHabiroHodge.laxMonoidal`: the lax symmetric monoidal structure maps, compatible with those
of the q-Hodge complex (they are equivalences: `qHabiroHodge.tensorEquiv`). -/
theorem qHabiroHodge.laxMonoidal (T : QWittContext K H) (TD : TensorData H) (P P' : PairsCat H) :
    Nonempty (TD.habiroTensor (qHabiroHodge T P) (qHabiroHodge T P') ⟶
      qHabiroHodge T (PairsCat.tensor TD P P')) := by
  sorry

/-- API `qHabiroHodge.tensorEquiv`; **Theorem (HQ.3/the-habiro-hodge-complex-is-symmetric-monoidal,
Lemma 3.46).** For pairs `P, P'` the canonical map from the completed tensor product of their
Habiro–Hodge complexes to that of their tensor product is an equivalence (Künneth). -/
theorem qHabiroHodge.tensorEquiv (T : QWittContext K H) (TD : TensorData H) (P P' : PairsCat H) :
    ∃ f : TD.habiroTensor (qHabiroHodge T P) (qHabiroHodge T P') ⟶
      qHabiroHodge T (PairsCat.tensor TD P P'), IsIso f := by
  sorry

/-- **Theorem (HQ.3/habiro-descent, Theorem 3.11(a)).** For a perfectly covered `A`, the q-Hodge
complex functor factors symmetric monoidally through the Habiro-complete objects followed by
`(q-1)`-completion; the lift is the Habiro–Hodge complex. The factorisation is non-trivial: there
are `(q-1)`-complete objects that are not Habiro-complete. -/
theorem habiro_descent (hA : Λ.IsPerfectlyCovered) (T : QWittContext K H) (Hb : HabiroData H)
    (TD : TensorData H) :
    (∀ P : PairsCat H, Hb.IsHabiroComplete (qHabiroHodge T P) ∧
      Nonempty ((T.completeAt ((X : A[X]) - 1)).obj (qHabiroHodge T P) ≅ qHodge H P)) ∧
    (∀ P P' : PairsCat H, ∃ f : TD.habiroTensor (qHabiroHodge T P) (qHabiroHodge T P') ⟶
      qHabiroHodge T (PairsCat.tensor TD P P'), IsIso f) ∧
    ∃ M : 𝒞, IsIso ((T.completeUnit ((X : A[X]) - 1)).app M) ∧ ¬ Hb.IsHabiroComplete M := by
  sorry

/-- **Theorem (HQ.3/habiro-descent-the-q-de-rham-witt-filtration, Theorem 3.11(b)).** For every
`m`, `qHabiroHodge/(q^m - 1)` has an exhaustive ascending filtration, functorial and lax symmetric
monoidal in the pair, whose `n`-th graded piece is the DERIVED form `qW_m dR^n_{R/A}` shifted by
`-n`; for `m = 1` it is the conjugate filtration. -/
theorem habiroDescent_graded [HasShift 𝒞 ℤ] (hA : Λ.IsPerfectlyCovered) (T : QWittContext K H)
    (P : PairsCat H) (m : ℕ+) :
    ∃ G : ℕ ⥤ 𝒞, Nonempty (colimit G ≅ quotBy ((X : A[X]) ^ (m : ℕ) - 1) (qHabiroHodge T P)) ∧
      Nonempty (G.obj 0 ≅ (qWittDR.form T m 0).obj P.R) ∧
      (∀ n : ℕ, Nonempty (cokernel (G.map (homOfLE (Nat.le_succ n))) ≅
        (shiftFunctor 𝒞 (-((n + 1 : ℕ) : ℤ))).obj ((qWittDR.form T m (n + 1)).obj P.R))) ∧
      (m = 1 → Nonempty (G ≅ qHodge.conjFil H P)) := by
  sorry

/-- The empty framing of an étale algebra. -/
def EtaleFraming.ofEtale (S : Type u) [CommRing S] [Algebra A S] [Algebra.Etale A S] :
    EtaleFraming A S 0 :=
  ⟨(Algebra.ofId A S).comp (MvPolynomial.isEmptyAlgEquiv A (Fin 0)).toAlgHom, sorry⟩

/-- The pair of an étale algebra: its q-Hodge filtration is forced to be the `(q-1)`-adic one (the
framed filtration with no coordinates). -/
def etalePair (H : HodgeContext K 𝒞) (S : Type u) [CommRing S] [Algebra A S] [Algebra.Etale A S] :
    PairsCat H :=
  framedPair H (EtaleFraming.ofEtale S)

/-- **Theorem (HQ.3/the-etale-case, Corollary 3.13).** For `R` étale over `A`, the Habiro–Hodge
complex is the relative Habiro ring of `R` over `A` (HR.5), as `E∞`-algebras over the Habiro ring
(underlying objects here). -/
theorem qHabiroHodge_etale_eq (hA : Λ.IsPerfectlyCovered) (T : QWittContext K H) (S : Type u)
    [CommRing S] [Algebra A S] [Algebra.Etale A S] :
    Nonempty (qHabiroHodge T (etalePair H S) ≅ T.relHabiro.obj (SmoothAlg.of S)) := by
  sorry

/-- **Owner: EnhancedDerivedSheaves E1.** The standard t-structure on `D(A[q])`: cohomology
`H^n`, the truncations `τ^{≤ n}` with their maps to the identity, and the Bockstein
`H^n(M/f) → H^{n+1}(M/f)`. -/
structure CohomologyData (𝒞 : Type*) [Category 𝒞] [Preadditive 𝒞] [Linear A[X] 𝒞]
    [HasFiniteColimits 𝒞] where
  Hn : ℤ → 𝒞 ⥤ ModuleCat.{u} A[X]
  truncLE : ℤ → 𝒞 ⥤ 𝒞
  truncLEι : ∀ n, truncLE n ⟶ 𝟭 𝒞
  bockstein : ∀ (f : A[X]) (M : 𝒞) (n : ℤ), (Hn n).obj (quotBy f M) ⟶ (Hn (n + 1)).obj (quotBy f M)

/-- **Theorem (HQ.3/the-cohomology-of-the-reduction-for-smooth-algebras, Corollary 3.54).** For `S`
smooth with a q-Hodge filtration: (a) the filtration of Theorem 3.11(b) on `qHabiroHodge/(q^m - 1)`
is its Whitehead filtration `τ^{≤ *}` (the source writes `τ_{≥ *}`, E208); (b) its cohomology is
`qW_m Ω_{S/A}`, degree by degree, as `A[q]/(q^m - 1)`-modules (as algebras for an `E_1`-pair); (c)
the differential of `qW_m Ω_{S/A}` corresponds to the Bockstein for `q^m - 1`. -/
theorem qHabiroHodge_smoothCohomology_thm (hA : Λ.IsPerfectlyCovered) (T : QWittContext K H)
    (Hc : CohomologyData (A := A) 𝒞) (S : SmoothAlg A) (F : QHodgeFiltration H (K.ofSmooth.obj S))
    (m : ℕ+) :
    (∃ G : ℕ ⥤ 𝒞, Nonempty (colimit G ≅ quotBy ((X : A[X]) ^ (m : ℕ) - 1)
        (qHabiroHodge T ⟨K.ofSmooth.obj S, F⟩)) ∧
      ∀ n : ℕ, Nonempty (G.obj n ≅ (Hc.truncLE n).obj (quotBy ((X : A[X]) ^ (m : ℕ) - 1)
        (qHabiroHodge T ⟨K.ofSmooth.obj S, F⟩)))) ∧
    ∃ e : ∀ n : ℕ, (Hc.Hn n).obj (quotBy ((X : A[X]) ^ (m : ℕ) - 1)
        (qHabiroHodge T ⟨K.ofSmooth.obj S, F⟩)) ≃ₗ[A[X]] ((qWittOmega (T.qWitt S)).P m).deg n,
      ∀ (n : ℕ) (x : (Hc.Hn n).obj (quotBy ((X : A[X]) ^ (m : ℕ) - 1)
          (qHabiroHodge T ⟨K.ofSmooth.obj S, F⟩))),
        ((qWittOmega (T.qWitt S)).P m).d (e n x) =
          (e (n + 1) ((eqToHom (congrArg (fun k : ℤ => (Hc.Hn k).obj (quotBy ((X : A[X]) ^ (m : ℕ) - 1)
            (qHabiroHodge T ⟨K.ofSmooth.obj S, F⟩))) (Nat.cast_succ n).symm)).hom
              ((Hc.bockstein _ _ n).hom x)) : (qWittOmega (T.qWitt S)).P m) := by
  sorry

/-- Unit test `qHabiroHodge_etale`: for an étale `A`-algebra with its q-Hodge filtration, the
Habiro–Hodge complex is the relative Habiro ring. -/
example (hA : Λ.IsPerfectlyCovered) (T : QWittContext K H) (S : Type u) [CommRing S] [Algebra A S]
    [Algebra.Etale A S] :
    Nonempty (qHabiroHodge T (etalePair H S) ≅ T.relHabiro.obj (SmoothAlg.of S)) :=
  qHabiroHodge_etale_eq hA T S

/-- Unit test `qHabiroHodge.qSubOneCompletion`: its `(q-1)`-completion is the q-Hodge complex; a
construction returning the q-de Rham complex fails this already for `S = A[x]` with the coordinate
filtration. -/
example (T : QWittContext K H) :
    Nonempty ((T.completeAt ((X : A[X]) - 1)).obj
        (qHabiroHodge T (framedPair H (EtaleFraming.polyId A 1))) ≅
      qHodge H (framedPair H (EtaleFraming.polyId A 1))) ∧
    ¬ Nonempty ((T.completeAt ((X : A[X]) - 1)).obj
        (qHabiroHodge T (framedPair H (EtaleFraming.polyId A 1))) ≅
      H.ofMod.obj (K.koszul (qOmegaFramed.qPartial (EtaleFraming.polyId A 1)))) := by
  sorry

/-- Unit test `qHabiroHodge_smoothCohomology`: for smooth `S` with a q-Hodge filtration, the
cohomology of `qHabiroHodge/(q^m - 1)` is `qW_m Ω_{S/A}`, degree by degree, as
`A[q]/(q^m - 1)`-modules. -/
example (hA : Λ.IsPerfectlyCovered) (T : QWittContext K H) (Hc : CohomologyData (A := A) 𝒞)
    (S : SmoothAlg A) (F : QHodgeFiltration H (K.ofSmooth.obj S)) (m : ℕ+) (n : ℕ) :
    Nonempty ((Hc.Hn n).obj (quotBy ((X : A[X]) ^ (m : ℕ) - 1)
        (qHabiroHodge T ⟨K.ofSmooth.obj S, F⟩)) ≃ₗ[A[X]] ((qWittOmega (T.qWitt S)).P m).deg n) := by
  sorry

/-- Unit test `qHabiroHodge_ne_qdR`: it descends the q-Hodge complex, not the q-de Rham complex;
the latter is recovered only after the décalage at `q - 1`, and only for smooth inputs. -/
example (hA : Λ.IsPerfectlyCovered) (T : QWittContext K H) (S : SmoothAlg A)
    (F : QHodgeFiltration H (K.ofSmooth.obj S)) :
    Nonempty ((T.Leta ((X : A[X]) - 1)).obj ((T.completeAt ((X : A[X]) - 1)).obj
        (qHabiroHodge T ⟨K.ofSmooth.obj S, F⟩)) ≅ H.forget.obj ((qOmega K).obj S)) ∧
    ¬ Nonempty ((T.completeAt ((X : A[X]) - 1)).obj
        (qHabiroHodge T (framedPair H (EtaleFraming.polyId A 1))) ≅
      H.forget.obj ((qdR K).obj (K.ofPoly.obj (PolyAlg.of A 1)))) := by
  sorry

/-- The `(q-1)`-adic step of the Koszul complex: `(q-1)^{max(n - |I|, 0)} S⟦q-1⟧ dx_I`. -/
def coordinateStep (S : Type u) [CommRing S] (d n : ℕ) :
    AddSubgroup (Finset (Fin d) → PowerSeries S) :=
  AddSubgroup.pi Set.univ fun I => qAdicStep S (n - I.card)

/-- **Comparison (HQ.3/the-coordinate-model-and-the-etale-case, Example 3.12).** For `S` smooth with
an étale framing, the filtration `(q-1)^{max(n - *, 0)} qΩ*_{S/A,□}`, pulled back to the derived
complex, is a q-Hodge filtration (`framedPair`; an `E_0`-algebra in pairs), and its q-Hodge complex
is the coordinate q-Hodge complex (`qHodge.framed`). The source's explicit Koszul model of the
Habiro–Hodge complex (the operators `(γ_i - id)/x_i` on the relative Habiro ring of `S` over
`A[x_1, …, x_n]`, with its toric Λ-structure) is asserted without proof, used by no other node, and
is not stated here; its consequence `H^*(qHabiroHodge/(q^m - 1)) = qW_m Ω_{S/A}` is
`qHabiroHodge_smoothCohomology_thm`. -/
theorem framedPair_coordinate {S : Type u} [CommRing S] [Algebra A S] [Algebra.Smooth A S] {d : ℕ}
    (F : EtaleFraming A S d) (n : ℕ) :
    Nonempty ((coordinateFiltration H F).fil.fil.obj (op n) ≅
      H.koszulSub (qOmegaFramed.qPartial F) (coordinateStep S d n)) ∧
    Nonempty (qHodge H (framedPair H F) ≅ H.ofMod.obj (K.koszul (qHodgeFramedOp F))) := by
  sorry

/-- **Theorem (HQ.3/multiplicative-upgrades, Lemma 3.52 and its `E_n` form).** Multiplicative
structure on a pair is carried to the Habiro–Hodge complex: a multiplication of the pair (the pair
being an algebra in pairs, with all the data of Definition 3.2) induces one on the Habiro–Hodge
complex, compatible with the filtration of Theorem 3.11(b). Stated for the multiplication maps
(the `E_1` shadow); the `E_n`, `n ≥ 2`, and derived commutative forms (the latter proved in the
source only as a sketch) need the owners' operadic and derived commutative structures on pairs and
are not stated. No upgrade beyond the input's structure is claimed. -/
theorem multiplicative_upgrades (T : QWittContext K H) (TD : TensorData H) (P : PairsCat H)
    (μ : PairsCat.tensor TD P P ⟶ P) :
    ∃ μ' : TD.habiroTensor (qHabiroHodge T P) (qHabiroHodge T P) ⟶ qHabiroHodge T P,
      ∃ e : TD.habiroTensor (qHabiroHodge T P) (qHabiroHodge T P) ⟶
          qHabiroHodge T (PairsCat.tensor TD P P), IsIso e ∧ μ' = e ≫ qHabiroHodge.map T μ := by
  sorry

end Twisted

end HQ3

/-! ## HQ.5 — Existence of q-Hodge filtrations, algebraic Habiro cohomology, condition (R)

The packet's names for the items of this stage carry the prefix `TauCeti.QHodge.`; they are
declared in `TauCeti.HabiroCohomology`, and the unit-test docstrings keep the packet's full name. -/

section HQ5

variable {A : Type u} [CommRing A]

/-! ### Truncated filtered objects (node HQ.5/truncated-filtered-objects-and-the-left-adjoint)

`Fil^{≥0}` is `ℕᵒᵖ ⥤ 𝒵` (constant in degrees `≤ 0`), for `𝒵 = D(ℤ)` in the source; everything
below is stated for any `𝒵` with a zero object. -/

section Truncation

variable {𝒵 : Type*} [Category 𝒵] [HasZeroMorphisms 𝒵] [HasZeroObject 𝒵]

/-- `Fil^{[0,n]}`: the filtered objects vanishing in degrees `≥ n + 1`. -/
def FilLE (𝒵 : Type*) [Category 𝒵] [HasZeroMorphisms 𝒵] (n : ℕ) : ObjectProperty (ℕᵒᵖ ⥤ 𝒵) :=
  fun F => ∀ i : ℕ, n < i → IsZero (F.obj (op i))

/-- API `TauCeti.QHodge.truncateFil`: `τ*_n : Fil^{≥0} → Fil^{[0,n]}`, keeping the degrees at most
`n` and replacing every degree at least `n + 1` by zero. -/
def truncateFil (n : ℕ) : (ℕᵒᵖ ⥤ 𝒵) ⥤ (FilLE 𝒵 n).FullSubcategory := sorry

/-- API `TauCeti.QHodge.truncateFil_apply`: `(τ*_n M)^i ≃ M^i` for `i ≤ n` (with the transition
maps of `M`) and `(τ*_n M)^i ≃ 0` for `i ≥ n + 1`. -/
theorem truncateFil_apply (n : ℕ) (M : ℕᵒᵖ ⥤ 𝒵) (i : ℕ) :
    (i ≤ n → Nonempty (((truncateFil n).obj M).obj.obj (op i) ≅ M.obj (op i))) ∧
      (n < i → IsZero (((truncateFil n).obj M).obj.obj (op i))) := by
  sorry

/-- The extension by zero `Fil^{[0,n]} → Fil^{≥0}` (the inclusion). -/
abbrev extendByZero (𝒵 : Type*) [Category 𝒵] [HasZeroMorphisms 𝒵] (n : ℕ) :
    (FilLE 𝒵 n).FullSubcategory ⥤ (ℕᵒᵖ ⥤ 𝒵) :=
  ObjectProperty.ι _

/-- The constant extension above `n`. -/
def extendConst (n : ℕ) : (FilLE 𝒵 n).FullSubcategory ⥤ (ℕᵒᵖ ⥤ 𝒵) := sorry

/-- API `TauCeti.QHodge.truncateFil_adjunction`: extension by zero `⊣ τ*_n ⊣` constant extension,
the last fully faithful; so `τ*_n` is a localisation. (`τ*_n` is RIGHT adjoint to the inclusion;
the source prints "left adjoint", source issue E301.) -/
theorem truncateFil_adjunction (n : ℕ) :
    Nonempty (extendByZero 𝒵 n ⊣ truncateFil n) ∧
      Nonempty (truncateFil (𝒵 := 𝒵) n ⊣ extendConst n) ∧
      Nonempty (extendConst (𝒵 := 𝒵) n).FullyFaithful := by
  sorry

/-- **Owner: DerivedDeRhamCohomology DD.1.** The Day convolution on `Fil^{≥0}`. -/
structure FilDay (𝒵 : Type*) [Category 𝒵] where
  /-- `⊗^L` of filtered objects. -/
  tensor : (ℕᵒᵖ ⥤ 𝒵) ⥤ (ℕᵒᵖ ⥤ 𝒵) ⥤ (ℕᵒᵖ ⥤ 𝒵)

/-- API `TauCeti.QHodge.truncateFil_tensor`: `τ*_n(M ⊗^L τ*_n N) → τ*_n(M ⊗^L N)` is an equivalence,
so `Fil^{[0,n]}` and `τ*_n` are symmetric monoidal. -/
theorem truncateFil_tensor (Dy : FilDay 𝒵) (n : ℕ) (M N : ℕᵒᵖ ⥤ 𝒵)
    (adj : extendByZero 𝒵 n ⊣ truncateFil n) :
    IsIso ((truncateFil n).map ((Dy.tensor.obj M).map (adj.counit.app N))) := by
  sorry

/-- **Owner: EnhancedDerivedSheaves E5:abstract** (module categories over filtered `E∞`-algebras).
For a filtered `E∞`-algebra `T` in `Fil^{≥0}`, the categories of `T`-modules (`ModT`) and of
`τ*_n T`-modules in `Fil^{[0,n]}` (`ModTn`), the induced `τ*_n` on modules, the forgetful functors,
and the (completed) tensor products over `T` and `τ*_n T`. -/
structure TruncationModules (𝒵 : Type*) [Category 𝒵] [HasZeroMorphisms 𝒵] (ModT : Type*)
    [Category ModT] (n : ℕ) where
  ModTn : Type w
  [cat : Category.{w'} ModTn]
  forgetT : ModT ⥤ (ℕᵒᵖ ⥤ 𝒵)
  forgetTn : ModTn ⥤ (FilLE 𝒵 n).FullSubcategory
  /-- `τ*_n` on modules. -/
  restrict : ModT ⥤ ModTn
  restrict_forget : restrict ⋙ forgetTn ≅ forgetT ⋙ truncateFil n
  tensorT : ModT → ModT → ModT
  tensorTn : ModTn → ModTn → ModTn

attribute [instance] TruncationModules.cat

variable {ModT : Type*} [Category ModT]

/-- API `TauCeti.QHodge.truncateFilShriek`: `τ^T_{n,!}`, the left adjoint of `τ*_n` on `T`-modules
(from the adjoint functor theorem, EnhancedDerivedSheaves E1). -/
def truncateFilShriek {n : ℕ} (M : TruncationModules 𝒵 ModT n) : M.ModTn ⥤ ModT := sorry

/-- (b) `τ*_n` on `T`-modules is exact and has the left adjoint `τ^T_{n,!}`, which is only OPLAX
symmetric monoidal (its structure maps `τ_!(X ⊗ Y) → τ_!X ⊗ τ_!Y`). -/
theorem truncateFilShriek_spec {n : ℕ} (M : TruncationModules 𝒵 ModT n) :
    Nonempty (truncateFilShriek M ⊣ M.restrict) ∧
      ∀ X Y : M.ModTn, Nonempty ((truncateFilShriek M).obj (M.tensorTn X Y) ⟶
        M.tensorT ((truncateFilShriek M).obj X) ((truncateFilShriek M).obj Y)) := by
  sorry

/-- API `TauCeti.QHodge.truncateFilShriek_baseChange`: clause (c), for `T₁ → T₂`,
`τ^{T₂}_{n,!}(M ⊗_{τ*T₁} τ*T₂) ≃ τ^{T₁}_{n,!}(M) ⊗_{T₁} T₂`, naturally. -/
theorem truncateFilShriek_baseChange {n : ℕ} {ModT₂ : Type*} [Category ModT₂]
    (M₁ : TruncationModules 𝒵 ModT n) (M₂ : TruncationModules 𝒵 ModT₂ n) (bc : ModT ⥤ ModT₂)
    (bcn : M₁.ModTn ⥤ M₂.ModTn) :
    Nonempty (bcn ⋙ truncateFilShriek M₂ ≅ truncateFilShriek M₁ ⋙ bc) := by
  sorry

/-- API `TauCeti.QHodge.truncateFilRel`: clause (d), the unique `τ*_{n,n+1}` with
`τ*_{n,n+1} ∘ τ*_{n+1} ≃ τ*_n` (its oplax left adjoint on modules is `truncateFilShriek` for the
corresponding module categories). -/
def truncateFilRel (n : ℕ) : (FilLE 𝒵 (n + 1)).FullSubcategory ⥤ (FilLE 𝒵 n).FullSubcategory :=
  sorry

theorem truncateFilRel_comp (n : ℕ) :
    Nonempty (truncateFil (𝒵 := 𝒵) (n + 1) ⋙ truncateFilRel n ≅ truncateFil n) := by
  sorry

/-- The module categories of the unit `T = ℤ`: all filtered objects, `τ*_n` itself. -/
def TruncationModules.unit (Dy : FilDay 𝒵) (n : ℕ) : TruncationModules 𝒵 (ℕᵒᵖ ⥤ 𝒵) n where
  ModTn := (FilLE 𝒵 n).FullSubcategory
  forgetT := 𝟭 _
  forgetTn := 𝟭 _
  restrict := truncateFil n
  restrict_forget := Iso.refl _
  tensorT M N := (Dy.tensor.obj M).obj N
  tensorTn X Y := (truncateFil n).obj ((Dy.tensor.obj X.obj).obj Y.obj)

/-- API `TauCeti.QHodge.truncateFilShriek_unit_fullyFaithful`: clause (e), for `T` the unit,
`τ^ℤ_{n,!}` is the extension by zero and is fully faithful. -/
theorem truncateFilShriek_unit_fullyFaithful (Dy : FilDay 𝒵) (n : ℕ) :
    Nonempty (truncateFilShriek (TruncationModules.unit Dy n) ≅ extendByZero 𝒵 n) ∧
      Nonempty (extendByZero 𝒵 n).FullyFaithful :=
  ⟨sorry, ⟨ObjectProperty.fullyFaithfulι _⟩⟩

/-- `ℤ(j)`: the object `U` in filtration degrees `≤ j` and zero above. -/
def unitFil (U : 𝒵) (j : ℕ) : ℕᵒᵖ ⥤ 𝒵 :=
  (extendByZero 𝒵 j).obj ((truncateFil j).obj ((Functor.const _).obj U))

/-- Unit test `TauCeti.QHodge.truncateFil_unit_shift`: `τ*_n ℤ(j) ≃ ℤ(min(j, n))`. -/
example (U : 𝒵) (n j : ℕ) :
    Nonempty ((extendByZero 𝒵 n).obj ((truncateFil n).obj (unitFil U j)) ≅ unitFil U (min j n)) := by
  sorry

/-- Unit test `TauCeti.QHodge.truncateFil_of_vanishing`: for `M` vanishing in degrees `≥ n + 1`,
`τ^ℤ_{n,!} τ*_n M ≃ M`. -/
example (n : ℕ) (M : ℕᵒᵖ ⥤ 𝒵) (hM : ∀ i : ℕ, n < i → IsZero (M.obj (op i))) :
    Nonempty ((extendByZero 𝒵 n).obj ((truncateFil n).obj M) ≅ M) := by
  sorry

/-- Unit test `TauCeti.QHodge.truncateFil_ne_quotient`: `τ*_n` is not the quotient by the
`(n+1)`-st step (the left adjoint of the inclusion): on `ℤ(n+1)` that quotient is `ℤ(n+1)/ℤ(n+1)^{≥ n+1}`,
while `τ*_n ℤ(n+1) ≃ ℤ(n)`, which is not zero. -/
example (U : 𝒵) (hU : ¬ IsZero U) (n : ℕ) :
    Nonempty ((extendByZero 𝒵 n).obj ((truncateFil n).obj (unitFil U (n + 1))) ≅ unitFil U n) ∧
      ¬ IsZero ((extendByZero 𝒵 n).obj ((truncateFil n).obj (unitFil U (n + 1)))) := by
  sorry

end Truncation

/-! ### The canonical smooth q-Hodge filtration (nodes HQ.5/the-canonical-smooth-q-hodge-filtration
and following) -/

section Canonical

variable {Λ : LambdaRing A} {Ani 𝒟 ℰ Mod : Type*} [Category Ani] [Category 𝒟] [Category ℰ]
  [Category Mod] [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ] [HasPullbacks 𝒟]
  {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear A[X] 𝒞] [HasFiniteColimits 𝒞]
  [HasZeroObject 𝒞] {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod}

/-- Smooth algebras in which every prime `p ≤ n` is invertible. -/
def SmoothInv (A : Type u) [CommRing A] (n : ℕ) : ObjectProperty (SmoothAlg A) :=
  fun S => ∀ p : ℕ, p.Prime → p ≤ n → IsUnit (p : S.obj)

/-- The category `Sm_{A[n!^{-1}]}` of smooth `A`-algebras with the primes `p ≤ n` inverted. -/
abbrev SmoothAlgInv (A : Type u) [CommRing A] (n : ℕ) : Type (u + 1) := (SmoothInv A n).FullSubcategory

/-- `Sm^{≤d}_{A[n!^{-1}]}`: relative dimension at most `d`, primes `p ≤ n` inverted. -/
def SmoothLE (A : Type u) [CommRing A] (d n : ℕ) : ObjectProperty (SmoothAlg A) :=
  fun S => RelDimLE A S.obj d ∧ ∀ p : ℕ, p.Prime → p ≤ n → IsUnit (p : S.obj)

/-- `Sm^{≤n}_{A[dim!^{-1}]}`: the union over `d ≤ n` of `Sm^{≤d}_{A[d!^{-1}]}`. -/
def SmoothDimInvLE (A : Type u) [CommRing A] (n : ℕ) : ObjectProperty (SmoothAlg A) :=
  fun S => ∃ d ≤ n, SmoothLE A d d S

/-- `Sm_{A[dim!^{-1}]}`: smooth algebras with every prime `p ≤ dim(S/A)` inverted. -/
def SmoothDimInvObj (A : Type u) [CommRing A] : ObjectProperty (SmoothAlg A) :=
  fun S => ∃ d, SmoothLE A d d S

/-- The category `Sm_{A[dim!^{-1}]}`. -/
abbrev SmoothDimInvCat (A : Type u) [CommRing A] : Type (u + 1) := (SmoothDimInvObj A).FullSubcategory

/-- The reduction `fil^⋆_{(Hdg,q-1)}(Ω_{S/A}⟦q-1⟧/(q-1)^n)` of the combined filtration modulo
`(q-1)^n` placed in filtration degree `n` (not the `(q-1)`-adic filtration of the conventions). -/
def combinedFiltrationMod (H : HodgeContext K 𝒞) (n : ℕ) (S : SmoothAlg A) : ℕᵒᵖ ⥤ 𝒞 := sorry

/-- In degree `0` the reduced combined filtration is `Ω_{S/A}⟦q-1⟧/(q-1)^n`. -/
def combinedFiltrationMod.zero (H : HodgeContext K 𝒞) (n : ℕ) (S : SmoothAlg A) :
    (combinedFiltrationMod H n S).obj (op 0) ≅
      quotBy (((X : A[X]) - 1) ^ (n - 1) * ((X : A[X]) - 1))
        (H.forget.obj (K.powerSeries.obj (K.deRham.obj S))) :=
  sorry

/-- The map `quotBy (h g) M → quotBy g M`. -/
def quotByChange (g h : A[X]) (M : 𝒞) : quotBy (h * g) M ⟶ quotBy g M :=
  cokernel.map _ _ (h • 𝟙 M) (𝟙 M) (by rw [Category.comp_id, Linear.smul_comp, Linear.comp_smul,
    Category.id_comp, smul_smul])

/-- The factorisation map `qΩ_{S/A} → Ω_{S/A}⟦q-1⟧/(q-1)^n` (underlying `A[q]`-modules). -/
def qOmega_factorisationMap (H : HodgeContext K 𝒞) (n : ℕ) (S : SmoothAlgInv A n) :
    H.forget.obj ((qOmega K).obj S.obj) ⟶
      quotBy (((X : A[X]) - 1) ^ (n - 1) * ((X : A[X]) - 1))
        (H.forget.obj (K.powerSeries.obj (K.deRham.obj S.obj))) :=
  sorry

/-- API `TauCeti.QHodge.qOmega_factorisation`: clause (i) of the construction: if every prime
`p ≤ n` is invertible in `S`, the canonical map `qΩ_{S/A} → Ω_{S/A}` factors through
`Ω_{S/A}⟦q-1⟧/(q-1)^n` (checked after p-completion: for `p > n` through `(q-1)^{p-1}`, for `p ≤ n`
the p-completion vanishes). Stated for underlying `A[q]`-modules; the source's map is one of
`E∞`-`A⟦q-1⟧`-algebras. -/
theorem qOmega_factorisation (H : HodgeContext K 𝒞) (n : ℕ) (S : SmoothAlgInv A n) :
    qOmega_factorisationMap H n S ≫ quotByChange ((X : A[X]) - 1) (((X : A[X]) - 1) ^ (n - 1)) _ =
      cokernel.π (((X : A[X]) - 1) • 𝟙 (H.forget.obj ((qOmega K).obj S.obj))) ≫
        (H.forget_modQ _).hom ≫ H.forgetE.map ((qOmega.modQSubOne K).hom.app S.obj) ≫
          H.forgetE.map (K.powerSeries_modQ.inv.app (K.deRham.obj S.obj)) ≫ (H.forget_modQ _).inv := by
  sorry

/-- The truncated filtration `fil^{⋆≤n}_{q-Hdg,n} qΩ_{S/A}`: clause (iii), the pullback of
`τ*_n fil^⋆_{(Hdg,q-1)}(Ω⟦q-1⟧/(q-1)^n)` along the factorisation map, taken in
`τ*_n((q-1)^⋆A⟦q-1⟧)`-modules. -/
def canonicalSmoothFiltration.truncated (H : HodgeContext K 𝒞) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) (S : SmoothAlgInv A n) : M.ModTn :=
  sorry

/-- **Construction (HQ.5/the-canonical-smooth-q-hodge-filtration).** API
`TauCeti.QHodge.canonicalSmoothFiltration`: for `S` smooth with every prime `p ≤ n` invertible
(no bound on the dimension), `fil^⋆_{q-Hdg,n} qΩ_{S/A} = (τ_{n,!} fil^{⋆≤n})^∧_{(q-1)}`, a filtered
`(q-1)^⋆A⟦q-1⟧`-module, functorial in `S`. -/
def canonicalSmoothFiltration (H : HodgeContext K 𝒞) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) :
    SmoothAlgInv A n ⥤ FilModule ((X : A[X]) - 1) 𝒞 :=
  sorry

/-- Its definition: the completed `τ_{n,!}` of the truncated pullback. -/
theorem canonicalSmoothFiltration_eq (H : HodgeContext K 𝒞) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) (S : SmoothAlgInv A n) :
    Nonempty ((canonicalSmoothFiltration H M).obj S ≅
      FilModule.complete ((truncateFilShriek M).obj (canonicalSmoothFiltration.truncated H M S))) := by
  sorry

/-- The pullback of the canonical filtration to `qdR_{S/A}`. -/
def canonicalSmoothFiltration.toQdR (H : HodgeContext K 𝒞) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) (S : SmoothAlgInv A n) :
    FilModule ((X : A[X]) - 1) 𝒞 :=
  sorry

/-- API `TauCeti.QHodge.canonicalSmoothFiltration_truncate`: `τ*_n` of the filtration is the
pullback of (iii); in each degree `i ≤ n` it is the pullback of the `i`-th step of the reduced
combined filtration along the factorisation map. -/
theorem canonicalSmoothFiltration_truncate (H : HodgeContext K 𝒞) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) (S : SmoothAlgInv A n) :
    Nonempty (M.restrict.obj ((canonicalSmoothFiltration H M).obj S) ≅
      canonicalSmoothFiltration.truncated H M S) ∧
    ∀ i ≤ n, ∃ (f : ((canonicalSmoothFiltration H M).obj S).fil.obj (op i) ⟶
        (combinedFiltrationMod H n S.obj).obj (op i))
      (g : ((canonicalSmoothFiltration H M).obj S).fil.obj (op i) ⟶
        H.forget.obj ((qOmega K).obj S.obj))
      (h : (combinedFiltrationMod H n S.obj).obj (op i) ⟶
        quotBy (((X : A[X]) - 1) ^ (n - 1) * ((X : A[X]) - 1))
          (H.forget.obj (K.powerSeries.obj (K.deRham.obj S.obj)))),
      IsPullback f g h (qOmega_factorisationMap H n S) := by
  sorry

/-- The completion map of a filtered module. -/
def FilModule.completeUnit {f : A[X]} (N : FilModule f 𝒞) : N ⟶ N.complete := sorry

/-- API `TauCeti.QHodge.canonicalSmoothFiltration_lift`: maps from the canonical filtration to a
`(q-1)`-complete filtered module `N` are the maps from the truncated filtration to `τ*_n N`
(adjunction and completion); this is how comparison maps are built. -/
def canonicalSmoothFiltration_lift (H : HodgeContext K 𝒞) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) (S : SmoothAlgInv A n)
    (N : FilModule ((X : A[X]) - 1) 𝒞) (hN : IsIso (FilModule.completeUnit N)) :
    ((canonicalSmoothFiltration H M).obj S ⟶ N) ≃
      (canonicalSmoothFiltration.truncated H M S ⟶ M.restrict.obj N) :=
  sorry

/-- API `TauCeti.QHodge.canonicalSmoothFiltration_mod_q_sub_one`: its reduction modulo `q - 1`
(in filtration degree one) is `τ^ℤ_{n,!} τ*_n fil^⋆_Hdg Ω_{S/A}`. -/
theorem canonicalSmoothFiltration_mod_q_sub_one (H : HodgeContext K 𝒞) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) (S : SmoothAlgInv A n) :
    Nonempty (filQuotient ((canonicalSmoothFiltration H M).obj S) ≅
      (extendByZero 𝒞 n).obj ((truncateFil n).obj (H.hodgeFilSmooth.obj S.obj))) := by
  sorry

/-- API `TauCeti.QHodge.canonicalSmoothFiltration_map`: functoriality in `S` (with the identity
and composition laws of the functor). -/
def canonicalSmoothFiltration_map (H : HodgeContext K 𝒞) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) {S S' : SmoothAlgInv A n}
    (f : S ⟶ S') : (canonicalSmoothFiltration H M).obj S ⟶ (canonicalSmoothFiltration H M).obj S' :=
  (canonicalSmoothFiltration H M).map f

/-- API `TauCeti.QHodge.canonicalSmoothFiltration_framed`: for an étale framing in `n`
coordinates, the equivalence with the coordinate filtration. -/
theorem canonicalSmoothFiltration_framed (H : HodgeContext K 𝒞) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) {S : Type u} [CommRing S]
    [Algebra A S] [Algebra.Smooth A S] (F : EtaleFraming A S n)
    (hS : SmoothInv A n (SmoothAlg.of S)) [HasColimitsOfShape ℕ 𝒞] :
    Nonempty ((canonicalSmoothFiltration H M).obj ⟨SmoothAlg.of S, hS⟩ ≅ (coordinateFiltration H F).fil) := by
  sorry

/-- **Comparison (HQ.5/framed-and-fixed-point-descriptions-of-the-canonical-filtration).** For an
étale framing in `n` coordinates (primes `p ≤ n` invertible), the comparison map from the canonical
filtration to the coordinate filtration, produced by the adjunction `τ_{n,!} ⊣ τ*_n` and
completion (the coordinate filtration satisfies the defining pullback in degrees `≤ n`), is an
equivalence (both are `(q-1)`-complete and it is the identity modulo `q - 1`). -/
theorem framed_equiv (H : HodgeContext K 𝒞) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) {S : Type u} [CommRing S]
    [Algebra A S] [Algebra.Smooth A S] (F : EtaleFraming A S n)
    (hS : SmoothInv A n (SmoothAlg.of S)) [HasColimitsOfShape ℕ 𝒞]
    (φ : canonicalSmoothFiltration.truncated H M ⟨SmoothAlg.of S, hS⟩ ⟶
      M.restrict.obj (coordinateFiltration H F).fil)
    (hc : IsIso (FilModule.completeUnit (coordinateFiltration H F).fil)) :
    IsIso ((canonicalSmoothFiltration_lift H M ⟨SmoothAlg.of S, hS⟩ _ hc).symm φ) := by
  sorry

/-- Unit test `TauCeti.QHodge.canonicalSmoothFiltration_base`: for `S = A` and `n = 1`,
`qdR_{A/A} ≃ A⟦q-1⟧` and the filtration is the `(q-1)`-adic filtration `(q-1)^i A⟦q-1⟧`. -/
example (H : HodgeContext K 𝒞) (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) 1) :
    Nonempty ((canonicalSmoothFiltration H M).obj
        ⟨SmoothAlg.of A, fun p hp hp1 => absurd hp.two_le (by omega)⟩ ≅
      FilModule.adic ((X : A[X]) - 1) (H.forget.obj K.one)) := by
  sorry

/-- Unit test `TauCeti.QHodge.canonicalSmoothFiltration_line`: for `S = A[x]` and `n = 1` (no prime
inverted), in the coordinate model the `i`-th step is the subcomplex
`(q-1)^i A[x]⟦q-1⟧ → (q-1)^{i-1} A[x]⟦q-1⟧ dx`. -/
example (H : HodgeContext K 𝒞) (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) 1)
    [HasColimitsOfShape ℕ 𝒞] (hS : SmoothInv A 1 (SmoothAlg.of (MvPolynomial (Fin 1) A))) (i : ℕ) :
    Nonempty ((canonicalSmoothFiltration H M).obj ⟨SmoothAlg.of (MvPolynomial (Fin 1) A), hS⟩ ≅
        (coordinateFiltration H (EtaleFraming.polyId A 1)).fil) ∧
      Nonempty ((coordinateFiltration H (EtaleFraming.polyId A 1)).fil.fil.obj (op i) ≅
        H.koszulSub (qOmegaFramed.qPartial (EtaleFraming.polyId A 1))
          (coordinateStep (MvPolynomial (Fin 1) A) 1 i)) := by
  sorry

/-- Unit test `TauCeti.QHodge.canonicalSmoothFiltration_mod_of_dim_gt`: if `dim(S/A) > n`, the
reduction modulo `q - 1` is `τ^ℤ_{n,!} τ*_n` of the Hodge filtration, which vanishes in degree
`n + 1` while the Hodge filtration does not: the q-Hodge property needs `dim(S/A) ≤ n`. -/
example (H : HodgeContext K 𝒞) {n : ℕ} (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n)
    (S : SmoothAlgInv A n) (hS : ¬ RelDimLE A S.obj.obj n) :
    IsZero ((filQuotient ((canonicalSmoothFiltration H M).obj S)).obj (op (n + 1))) ∧
      ¬ IsZero ((H.hodgeFilSmooth.obj S.obj).obj (op (n + 1))) := by
  sorry

/-- Unit test `TauCeti.QHodge.naivePullback_not_qHodge`: without `τ*_n`, the pullback of the Hodge
filtration along `qΩ → Ω` contains `(q - 1) qΩ` in every step; for `S = A[x]` its second step
contains `q - 1` times the unit, which violates the rational clause since
`q - 1 ∉ (q-1)^2 A⟦q-1⟧` (the degree-zero part of `(q-1)^2 A⟦q-1⟧ + (q-1) fil^1_Hdg`). -/
example [Nontrivial A] :
    (PowerSeries.X : PowerSeries A) ∉ Ideal.span {(PowerSeries.X : PowerSeries A)} ^ 2 := by
  sorry

/-- Unit test `TauCeti.QHodge.truncateFilShriek_adic`: for `T = (q-1)^⋆A⟦q-1⟧` and `M = τ*_n T`,
`τ^T_{n,!} M ≃ T`: `τ_{n,!}` continues a module above degree `n` by multiplication by powers of
`q - 1`, the intended `(q-1)`-adic continuation of paragraph 4.1. -/
example (H : HodgeContext K 𝒞) {n : ℕ} (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) :
    Nonempty ((truncateFilShriek M).obj (M.restrict.obj
        (FilModule.adic ((X : A[X]) - 1) (H.forget.obj K.one))) ≅
      FilModule.adic ((X : A[X]) - 1) (H.forget.obj K.one)) := by
  sorry

/-- **Lemma (HQ.5/the-canonical-filtration-is-a-q-hodge-filtration, Lemma 4.6).** If moreover
`dim(S/A) ≤ n`: (a) the reduction modulo `q - 1` is the Hodge filtration (the only use of the
dimension bound, through the full faithfulness of `τ^ℤ_{n,!}`); (b) both rational clauses hold;
(c) its pullback to `qdR_{S/A}` is a q-Hodge filtration, naturally in `S`; (d) the filtration of
`qΩ_{S/A}` is the completion of the one of `qdR_{S/A}`. -/
theorem canonicalFiltration_isQHodge (H : HodgeContext K 𝒞) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) (S : SmoothAlgInv A n)
    (hS : RelDimLE A S.obj.obj n) :
    Nonempty (filQuotient ((canonicalSmoothFiltration H M).obj S) ≅ H.hodgeFilSmooth.obj S.obj) ∧
      ∃ F : QHodgeFiltration H (K.ofSmooth.obj S.obj),
        Nonempty (F.fil ≅ canonicalSmoothFiltration.toQdR H M S) ∧
          Nonempty (FilModule.complete F.fil ≅ (canonicalSmoothFiltration H M).obj S) := by
  sorry

/-! ### Functoriality across dimensions and the existence theorem -/

/-- The inclusion `Sm^{≤n}_{A[(n+1)!^{-1}]} ⊆ Sm_{A[n!^{-1}]}`. -/
def SmoothLE.toInv (n : ℕ) : (SmoothLE A n (n + 1)).FullSubcategory ⥤ SmoothAlgInv A n :=
  ObjectProperty.ιOfLE fun _ h p hp hpn => h.2 p hp (by omega)

/-- The inclusion `Sm^{≤n}_{A[(n+1)!^{-1}]} ⊆ Sm_{A[(n+1)!^{-1}]}`. -/
def SmoothLE.toInvSucc (n : ℕ) : (SmoothLE A n (n + 1)).FullSubcategory ⥤ SmoothAlgInv A (n + 1) :=
  ObjectProperty.ιOfLE fun _ h => h.2

/-- The inclusion `Sm^{≤n}_{A[dim!^{-1}]} ⊆ Sm_{A[dim!^{-1}]}`. -/
def SmoothDimInvLE.toCat (n : ℕ) : (SmoothDimInvLE A n).FullSubcategory ⥤ SmoothDimInvCat A :=
  ObjectProperty.ιOfLE fun _ ⟨d, _, h⟩ => ⟨d, h⟩

/-- **Theorem (HQ.5/functoriality-across-dimensions, Lemma 4.10).** (a) On the overlap
`Sm^{≤n}_{A[(n+1)!^{-1}]}` the constructions for `n` and `n + 1` agree naturally; (b) they assemble
(along the pushouts of `smoothPushout`) into one functor on `Sm_{A[dim!^{-1}]}` only. -/
theorem canonicalSection_smooth_functorial (H : HodgeContext K 𝒞)
    (M : ∀ n, TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) :
    (∀ n, Nonempty (SmoothLE.toInv n ⋙ canonicalSmoothFiltration H (M n) ≅
      SmoothLE.toInvSucc n ⋙ canonicalSmoothFiltration H (M (n + 1)))) ∧
    ∃ Φ : SmoothDimInvCat A ⥤ FilModule ((X : A[X]) - 1) 𝒞,
      ∀ n (S : (SmoothDimInvLE A n).FullSubcategory) (hS : SmoothInv A n S.obj),
        Nonempty (Φ.obj ((SmoothDimInvLE.toCat n).obj S) ≅
          (canonicalSmoothFiltration H (M n)).obj ⟨S.obj, hS⟩) := by
  sorry

/-- The canonical section `(-, fil^⋆_{q-Hdg} q-dR_{−/A})` on `Sm_{A[dim!^{-1}]}`. -/
def canonicalSection (H : HodgeContext K 𝒞) : SmoothDimInvCat A ⥤ PairsCat H := sorry

/-- **Theorem (HQ.5/existence-of-q-hodge-filtrations-for-smooth-algebras, Theorem 4.11).** For a
perfectly covered Λ-ring `A`, the derived q-de Rham complex of a smooth `A`-algebra in which every
prime `p ≤ dim(S/A)` (the RELATIVE dimension) is invertible has a canonical q-Hodge filtration:
`canonicalSection` is a partial section of the forgetful functor (it cannot be total when `A` is not
a `ℚ`-algebra, `no_functorial_qHodgeFiltration`). -/
theorem existence_smooth (hA : Λ.IsPerfectlyCovered) (H : HodgeContext K 𝒞) :
    Nonempty (canonicalSection H ⋙ PairsCat.forget H ≅ ObjectProperty.ι _ ⋙ K.ofSmooth) := by
  sorry

theorem RelDimLE.mono {S : Type u} [CommRing S] [Algebra A S] {d e : ℕ} (h : RelDimLE A S d)
    (hde : d ≤ e) : RelDimLE A S e := by
  sorry

/-- The four inclusions of the pushout square. -/
def pushoutι₁ (n : ℕ) :
    (SmoothLE A n (n + 1)).FullSubcategory ⥤ (SmoothLE A (n + 1) (n + 1)).FullSubcategory :=
  ObjectProperty.ιOfLE fun _ h => ⟨h.1.mono (Nat.le_succ n), h.2⟩

def pushoutι₂ (n : ℕ) : (SmoothLE A n (n + 1)).FullSubcategory ⥤ (SmoothDimInvLE A n).FullSubcategory :=
  ObjectProperty.ιOfLE fun _ h => ⟨n, le_rfl, h.1, fun p hp hpn => h.2 p hp (by omega)⟩

def pushoutj₁ (n : ℕ) :
    (SmoothLE A (n + 1) (n + 1)).FullSubcategory ⥤ (SmoothDimInvLE A (n + 1)).FullSubcategory :=
  ObjectProperty.ιOfLE fun _ h => ⟨n + 1, le_rfl, h⟩

def pushoutj₂ (n : ℕ) :
    (SmoothDimInvLE A n).FullSubcategory ⥤ (SmoothDimInvLE A (n + 1)).FullSubcategory :=
  ObjectProperty.ιOfLE fun _ ⟨d, hd, h⟩ => ⟨d, hd.trans (Nat.le_succ n), h⟩

/-- **Lemma (HQ.5/the-pushout-of-categories-of-smooth-algebras, Lemma 4.9).** The square of full
inclusions with corners `Sm^{≤n}_{A[(n+1)!^{-1}]}`, `Sm^{≤n+1}_{A[(n+1)!^{-1}]}`,
`Sm^{≤n}_{A[dim!^{-1}]}`, `Sm^{≤n+1}_{A[dim!^{-1}]}` is a pushout, stated by its universal property
for functors into any category (existence and uniqueness of the glued functor up to isomorphism);
the ∞-categorical pushout, via the stability of fully faithful functors under pushout, is
EnhancedDerivedSheaves E0's. -/
theorem smoothPushout (n : ℕ) (𝒳 : Type (u + 1)) [Category.{u} 𝒳]
    (F₁ : (SmoothLE A (n + 1) (n + 1)).FullSubcategory ⥤ 𝒳)
    (F₂ : (SmoothDimInvLE A n).FullSubcategory ⥤ 𝒳) (e : pushoutι₁ n ⋙ F₁ ≅ pushoutι₂ n ⋙ F₂) :
    ∃ G : (SmoothDimInvLE A (n + 1)).FullSubcategory ⥤ 𝒳,
      Nonempty (pushoutj₁ n ⋙ G ≅ F₁) ∧ Nonempty (pushoutj₂ n ⋙ G ≅ F₂) ∧
      ∀ G' : (SmoothDimInvLE A (n + 1)).FullSubcategory ⥤ 𝒳,
        Nonempty (pushoutj₁ n ⋙ G' ≅ F₁) → Nonempty (pushoutj₂ n ⋙ G' ≅ F₂) → Nonempty (G' ≅ G) := by
  sorry

end Canonical

/-! ### The partial sub-operad (node HQ.5/the-sub-operad-of-smooth-algebras-with-small-primes-inverted)

Objects of `Sm⊗_A` over `⟨i⟩` are lists of `i` algebras; a map of `Fin_*` is recorded by its
underlying partial map of indices `ℕ → Option ℕ`. -/

/-- `Sm_{A[dim!^{-1}]}` as a condition on an `A`-algebra. -/
def SmoothDimInv (S : CommAlgCat.{u} A) : Prop :=
  Algebra.Smooth A S ∧ ∃ d, RelDimLE A S d ∧ ∀ p : ℕ, p.Prime → p ≤ d → IsUnit (p : S)

/-- The tensor product over `A` of a list of algebras (`A` for the empty list). -/
def tensorList : List (CommAlgCat.{u} A) → CommAlgCat.{u} A
  | [] => CommAlgCat.of A A
  | S :: L => CommAlgCat.of A (TensorProduct A S (tensorList L))

/-- The entries of the target of the cocartesian lift of `α` from `(S_k)`: `⊗_{α(k) = j} S_k`. -/
def tensorOver (S : List (CommAlgCat.{u} A)) (α : ℕ → Option ℕ) (j : ℕ) : CommAlgCat.{u} A :=
  tensorList (((List.range S.length).filter fun k => α k = some j).map
    fun k => S.getD k (CommAlgCat.of A A))

/-- API `TauCeti.QHodge.SmoothDimInv.admissible`: a morphism `(S_k) → (S'_j)` over `α` is admissible
iff its source and target are admissible objects (conditions 4.12(a)) and so is the target
`(⊗_{α(k)=j} S_k)_j` of the cocartesian lift of `α` from the source (condition 4.12(b)). -/
def SmoothDimInv.admissible (S S' : List (CommAlgCat.{u} A)) (α : ℕ → Option ℕ) : Prop :=
  (∀ T ∈ S, SmoothDimInv T) ∧ (∀ T ∈ S', SmoothDimInv T) ∧
    ∀ j < S'.length, SmoothDimInv (tensorOver S α j)

/-- An `n`-simplex of the nerve of `Sm⊗_A`: `n` composable morphisms, recorded by their objects,
their maps of `Fin_*` and their algebra maps `⊗_{α(k)=j} S_k → S'_j`. -/
structure OperadSimplex (A : Type u) [CommRing A] (n : ℕ) where
  /-- The objects. -/
  obj : Fin (n + 1) → List (CommAlgCat.{u} A)
  /-- The maps of `Fin_*`. -/
  α : Fin n → ℕ → Option ℕ
  /-- The algebra maps. -/
  maps : ∀ (k : Fin n) (j : ℕ) (hj : j < (obj k.succ).length),
    tensorOver (obj k.castSucc) (α k) j ⟶ (obj k.succ)[j]

/-- The composite map of `Fin_*` from vertex `k` to vertex `l`. -/
def OperadSimplex.compα {n : ℕ} (σ : OperadSimplex A n) (k l : ℕ) : ℕ → Option ℕ := fun x =>
  (List.range' k (l - k)).foldl
    (fun acc i => acc.bind fun y => if h : i < n then σ.α ⟨i, h⟩ y else some y) (some x)

/-- API `TauCeti.QHodge.SmoothDimInv.operadic`: the simplicial subset `Sm⊗_{A[dim!^{-1}]}` of the
nerve of `Sm⊗_A`: the simplices ALL of whose vertices and edges (composites included) are
admissible. Admissible morphisms do not compose (source issue E305), so this is a simplicial set
over `N(Fin_*)`, not an ∞-category. -/
def SmoothDimInv.operadic (A : Type u) [CommRing A] (n : ℕ) : Type (u + 1) :=
  { σ : OperadSimplex A n // ∀ k l : Fin (n + 1), k ≤ l →
      SmoothDimInv.admissible (σ.obj k) (σ.obj l) (σ.compα k l) }

/-- API `TauCeti.QHodge.SmoothDimInv.fibre_one`: over `⟨1⟩` the fibre is the full subcategory
`Sm_{A[dim!^{-1}]}` (condition (b) is vacuous). -/
theorem SmoothDimInv.fibre_one (S : CommAlgCat.{u} A) :
    SmoothDimInv.admissible [S] [S] some ↔ SmoothDimInv S := by
  sorry

/-- API `TauCeti.QHodge.SmoothDimInv.mul_admissible`: for `S` of relative dimension `d`, the `r`-fold
multiplication `(S, …, S) → S` is admissible iff every prime `p ≤ r d` is invertible in `S` (for
`r = 2`: the multiplication, `p ≤ 2d`). -/
theorem SmoothDimInv.mul_admissible (S : CommAlgCat.{u} A) [Algebra.Smooth A S] (d r : ℕ)
    (hr : 1 ≤ r) (hd : RelDimLE A S d) (hd' : ∀ e < d, ¬ RelDimLE A S e) :
    SmoothDimInv.admissible (List.replicate r S) [S] (fun _ => some 0) ↔
      ∀ p : ℕ, p.Prime → p ≤ r * d → IsUnit (p : S) := by
  sorry

/-- API `TauCeti.QHodge.SmoothDimInv.boundedDim`: the bounded-dimension variant
`Sm^{≤n,⊗}_{A[n!^{-1}]}`: entries (and cocartesian targets) of dimension at most `n` in
`Sm_{A[n!^{-1}]}`. (Its dual in `(Sm⊗_{A[n!^{-1}]})^∨`, needed for the oplax encoding of paragraph
4.14, requires the dual fibrations of E5:abstract and is not stated.) -/
def SmoothDimInv.boundedDim (n : ℕ) (S S' : List (CommAlgCat.{u} A)) (α : ℕ → Option ℕ) : Prop :=
  let good : CommAlgCat.{u} A → Prop := fun T =>
    Algebra.Smooth A T ∧ RelDimLE A T n ∧ ∀ p : ℕ, p.Prime → p ≤ n → IsUnit (p : T)
  (∀ T ∈ S, good T) ∧ (∀ T ∈ S', good T) ∧ ∀ j < S'.length, good (tensorOver S α j)

/-- API `TauCeti.QHodge.SmoothDimInv.etale`: on étale `A`-algebras every morphism is admissible, and
the construction is the symmetric monoidal category of étale `A`-algebras. -/
theorem SmoothDimInv.etale (S S' : List (CommAlgCat.{u} A)) (α : ℕ → Option ℕ)
    (hS : ∀ T ∈ S, Algebra.Etale A T) (hS' : ∀ T ∈ S', Algebra.Etale A T) :
    SmoothDimInv.admissible S S' α := by
  sorry

/-- `ℤ[x]`, `ℤ[x, y]`, `ℤ[1/2][x]` and `ℤ[1/6][x]` as `ℤ`-algebras. -/
abbrev Zx : CommAlgCat.{0} ℤ := CommAlgCat.of ℤ (MvPolynomial (Fin 1) ℤ)
abbrev ZHalfx : CommAlgCat.{0} ℤ := CommAlgCat.of ℤ (MvPolynomial (Fin 1) (Localization.Away (2 : ℤ)))
abbrev ZSixthx : CommAlgCat.{0} ℤ := CommAlgCat.of ℤ (MvPolynomial (Fin 1) (Localization.Away (6 : ℤ)))
abbrev Zbase : CommAlgCat.{0} ℤ := CommAlgCat.of ℤ ℤ

/-- Unit test `TauCeti.QHodge.SmoothDimInv.not_comp_closed`: over `ℤ`, the edges
`(ℤ[x], ℤ[x]) → (ℤ, ℤ)` over `id_⟨2⟩` and `(ℤ, ℤ) → ℤ` over `⟨2⟩ → ⟨1⟩` are admissible but their
composite is not: `ℤ[x] ⊗ ℤ[x] = ℤ[x, y]` needs `2` inverted. -/
example :
    SmoothDimInv.admissible [Zx, Zx] [Zbase, Zbase] some ∧
      SmoothDimInv.admissible [Zbase, Zbase] [Zbase] (fun _ => some 0) ∧
      ¬ SmoothDimInv.admissible [Zx, Zx] [Zbase] (fun _ => some 0) := by
  sorry

/-- Unit test `TauCeti.QHodge.SmoothDimInv.mul_Z_x`: `ℤ[x]` lies in `Sm_{ℤ[dim!^{-1}]}` but its
multiplication is not admissible; `ℤ[1/2][x]` has an admissible multiplication but not an admissible
triple product; `ℤ[1/6][x]` has an admissible triple product. -/
example :
    SmoothDimInv Zx ∧ ¬ SmoothDimInv.admissible [Zx, Zx] [Zx] (fun _ => some 0) ∧
      SmoothDimInv.admissible [ZHalfx, ZHalfx] [ZHalfx] (fun _ => some 0) ∧
      ¬ SmoothDimInv.admissible [ZHalfx, ZHalfx, ZHalfx] [ZHalfx] (fun _ => some 0) ∧
      SmoothDimInv.admissible [ZSixthx, ZSixthx, ZSixthx] [ZSixthx] (fun _ => some 0) := by
