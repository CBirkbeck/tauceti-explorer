`Sm_{ℤ[dim!^{-1}]}`), which is not admissible: the two notions differ. -/
example : (∀ T ∈ [Zx, Zx], SmoothDimInv T) ∧ SmoothDimInv Zx ∧
    ¬ SmoothDimInv.admissible [Zx, Zx] [Zx] (fun _ => some 0) := by
  sorry

section Multiplicative

variable {Λ : LambdaRing A} {Ani 𝒟 ℰ Mod : Type*} [Category Ani] [Category 𝒟] [Category ℰ]
  [Category Mod] [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ] [HasPullbacks 𝒟]
  {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear A[X] 𝒞] [HasFiniteColimits 𝒞]
  [HasZeroObject 𝒞] {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod}

/-- The `r`-fold tensor power of a pair. -/
def PairsCat.tensorPow {H : HodgeContext K 𝒞} (TD : TensorData H) (P : PairsCat H) : ℕ → PairsCat H
  | 0 => P
  | r + 1 => PairsCat.tensor TD (PairsCat.tensorPow TD P r) P

/-- **Theorem (HQ.5/partial-operad-multiplicativity, Corollary 4.16).** `Sm_{A[dim!^{-1}]}` is not
closed under tensor products; the canonical section extends to the partial sub-operad
`SmoothDimInv.operadic`, preserving the cocartesian lifts that exist there (for `A` not a
`ℚ`-algebra; over `ℚ` every prime is invertible). Consequently, for `S` of
relative dimension `d`: if every prime `p ≤ r d` is invertible (`r ≥ 2`), the `r`-fold multiplication
of the pair of `S` exists (`A_2` for `r = 2`, coherence through `r` factors for `r ≥ 3`). Stated for the
multiplication maps; the map of simplicial sets over `N(Fin_*)` and the coherences are
EnhancedDerivedSheaves E5:abstract's. No multiplication is claimed when only the primes `p ≤ d` are
inverted. -/
theorem partialOperad_multiplicativity (hQ : ¬ Nonempty (Algebra ℚ A)) (H : HodgeContext K 𝒞)
    (TD : TensorData H) (S : SmoothDimInvCat A) (d r : ℕ) (hr : 2 ≤ r) (hd : RelDimLE A S.obj.obj d)
    (hp : ∀ p : ℕ, p.Prime → p ≤ r * d → IsUnit (p : S.obj.obj)) :
    ¬ (∀ S' S'' : SmoothDimInvCat A, SmoothDimInv (CommAlgCat.of A
        (TensorProduct A S'.obj.obj S''.obj.obj))) ∧
      Nonempty (PairsCat.tensorPow TD ((canonicalSection H).obj S) (r - 1) ⟶
        (canonicalSection H).obj S) := by
  sorry

/-- **Lemma (HQ.5/the-truncated-construction-is-symmetric-monoidal, Lemma 4.13).** The truncated
functor `S ↦ fil^{⋆≤n}_{q-Hdg,n} qdR_{S/A}` on `Sm_{A[n!^{-1}]}` (ANY dimension) is symmetric monoidal
for the `(q-1)`-completed tensor product of truncated modules. -/
theorem truncated_symmetricMonoidal (H : HodgeContext K 𝒞) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) (S S' S'' : SmoothAlgInv A n)
    (e : S''.obj.obj ≅ CommAlgCat.of A (TensorProduct A S.obj.obj S'.obj.obj)) :
    Nonempty (canonicalSmoothFiltration.truncated H M S'' ≅
      M.tensorTn (canonicalSmoothFiltration.truncated H M S)
        (canonicalSmoothFiltration.truncated H M S')) := by
  sorry

/-- **Lemma (HQ.5/cartesian-lifts-in-bounded-dimension-are-preserved, Lemma 4.15).** The oplax
functor `(Sm⊗_{A[n!^{-1}]})^∨ → (AniAlg^{q-Hdg,⊗}_A)^∨` sends cartesian morphisms whose source
entries have dimension `≤ n` to cartesian morphisms: the canonical filtration of a tensor product of
dimension `≤ n` is the completed tensor product of the canonical filtrations. (The encoding by dual
cartesian fibrations is E5:abstract's and is not stated.) -/
theorem cartesian_lifts_preserved (H : HodgeContext K 𝒞) (TD : TensorData H) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) (S S' S'' : SmoothAlgInv A n)
    (e : S''.obj.obj ≅ CommAlgCat.of A (TensorProduct A S.obj.obj S'.obj.obj))
    (hdim : RelDimLE A S''.obj.obj n) :
    Nonempty ((canonicalSmoothFiltration H M).obj S'' ≅
      TD.filTensor ((canonicalSmoothFiltration H M).obj S) ((canonicalSmoothFiltration H M).obj S')) := by
  sorry

end Multiplicative

/-! ### Algebraic Habiro cohomology of a scheme (node HQ.5/algebraic-habiro-cohomology-of-a-scheme)

Over `A = ℤ`; smooth schemes are Mathlib schemes, smooth of relative dimension `d` over
`Spec ℤ`. -/

section HabiroCohomology

open AlgebraicGeometry

variable {Λℤ : LambdaRing ℤ} {Ani 𝒟 ℰ Mod : Type*} [Category Ani] [Category 𝒟] [Category ℰ]
  [Category Mod] [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ] [HasPullbacks 𝒟]
  {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear ℤ[X] 𝒞] [HasFiniteColimits 𝒞]
  [HasZeroObject 𝒞] [HasColimitsOfShape ℕ 𝒞] [HasLimitsOfShape ℕᵒᵖ 𝒞]
  {K : QDeRhamContext ℤ Λℤ Ani 𝒟 ℰ Mod} {H : HodgeContext K 𝒞}

/-- `X` is smooth over `ℤ` of relative dimension `d` with every prime `p ≤ d` invertible on `X`. -/
def SmallPrimesInverted (Y : Scheme.{0}) : Prop :=
  ∃ d : ℕ, SmoothOfRelativeDimension d (specZIsTerminal.from Y) ∧
    ∀ p : ℕ, p.Prime → p ≤ d → IsUnit (p : Γ(Y, ⊤))

/-- **Owners: EnhancedDerivedSheaves E3/E4 (the derived category `D(X, H)` of sheaves with
Habiro-ring coefficients, its global sections and étale pullbacks) and HabiroRings HR.2.** Also the
sheaf cohomology `RΓ(X, qW_m Ω^i_{X/ℤ})`, supplied with the étale sheaves of HQ.4. -/
structure HabiroSheafData (𝒞 : Type*) [Category 𝒞] where
  D : Scheme.{0} → Type w
  [cat : ∀ Y, Category.{w'} (D Y)]
  RΓ : ∀ Y, D Y ⥤ 𝒞
  pullback : ∀ {Y Z : Scheme.{0}}, (Y ⟶ Z) → (D Z ⥤ D Y)
  RΓWitt : Scheme.{0} → ℕ+ → ℕ → 𝒞

attribute [instance] HabiroSheafData.cat

/-- **Construction (HQ.5/algebraic-habiro-cohomology-of-a-scheme).** API
`TauCeti.QHodge.algebraicHabiroCohomology`: for `X` smooth over `ℤ` with the primes `p ≤ dim(X/ℤ)`
invertible, `q-Hdg_{X/ℤ} ∈ D(X, H)`, glued from the Habiro–Hodge complexes of the canonical q-Hodge
filtrations of the affine opens (its global sections `RΓ(X, q-Hdg_{X/ℤ})` are
`(Hs.RΓ X).obj (algebraicHabiroCohomology …)`). Only over `ℤ`, as in the source. -/
def algebraicHabiroCohomology (Hs : HabiroSheafData.{w, w'} 𝒞) (T : QWittContext K H) (Y : Scheme.{0})
    (hY : SmallPrimesInverted Y) : Hs.D Y :=
  sorry

/-- API `TauCeti.QHodge.algebraicHabiroCohomology_affine`: for `X = Spec S`,
`RΓ(X, q-Hdg_{X/ℤ}) ≃ q-Hdg_{S/ℤ}`, the Habiro–Hodge complex of the canonical q-Hodge filtration. -/
theorem algebraicHabiroCohomology_affine (Hs : HabiroSheafData.{w, w'} 𝒞) (T : QWittContext K H)
    (S : SmoothDimInvCat ℤ) (hX : SmallPrimesInverted (Spec (CommRingCat.of S.obj.obj))) :
    Nonempty ((Hs.RΓ _).obj (algebraicHabiroCohomology Hs T _ hX) ≅
      qHabiroHodge T ((canonicalSection H).obj S)) := by
  sorry

/-- API `TauCeti.QHodge.algebraicHabiroCohomology_descent`: `q-Hdg_{−/ℤ}` satisfies étale descent on
smooth algebras with the small primes inverted: for an étale faithfully flat `S → S'` with
`S'' = S' ⊗_S S'`, `q-Hdg_S` is the equaliser of the two maps `q-Hdg_{S'} ⇉ q-Hdg_{S''}`. -/
theorem algebraicHabiroCohomology_descent [HasEqualizers 𝒞] (T : QWittContext K H)
    {S S' S'' : SmoothDimInvCat ℤ} (f : S ⟶ S') (g₁ g₂ : S' ⟶ S'') (hpush : IsPushout f f g₁ g₂)
    (hff : f.hom.hom.hom.toRingHom.FaithfullyFlat)
    (het : @Algebra.Etale S.obj.obj S'.obj.obj _ _ f.hom.hom.hom.toRingHom.toAlgebra) :
    Nonempty (qHabiroHodge T ((canonicalSection H).obj S) ≅
      equalizer (qHabiroHodge.map T ((canonicalSection H).map g₁))
        (qHabiroHodge.map T ((canonicalSection H).map g₂))) := by
  sorry

/-- API `TauCeti.QHodge.algebraicHabiroCohomology_pullback`: pullback along étale maps of such
schemes (with identity and composition laws, from the owner's pullback functors). -/
theorem algebraicHabiroCohomology_pullback (Hs : HabiroSheafData.{w, w'} 𝒞) (T : QWittContext K H)
    {Y Z : Scheme.{0}} (f : Y ⟶ Z) [Etale f] (hY : SmallPrimesInverted Y)
    (hZ : SmallPrimesInverted Z) :
    Nonempty ((Hs.pullback f).obj (algebraicHabiroCohomology Hs T Z hZ) ≅
      algebraicHabiroCohomology Hs T Y hY) := by
  sorry

/-- API `TauCeti.QHodge.algebraicHabiroCohomology_mod`: its reduction modulo `q^m - 1` carries the
exhaustive ascending filtration whose `i`-th graded piece is `RΓ(X, qW_m Ω^i_{X/ℤ})` placed in
cohomological degree `i`. -/
theorem algebraicHabiroCohomology_mod [HasShift 𝒞 ℤ] (Hs : HabiroSheafData.{w, w'} 𝒞)
    (T : QWittContext K H) (Y : Scheme.{0}) (hY : SmallPrimesInverted Y) (m : ℕ+) :
    ∃ G : ℕ ⥤ 𝒞, Nonempty (colimit G ≅ quotBy ((X : ℤ[X]) ^ (m : ℕ) - 1)
        ((Hs.RΓ Y).obj (algebraicHabiroCohomology Hs T Y hY))) ∧
      Nonempty (G.obj 0 ≅ Hs.RΓWitt Y m 0) ∧
      ∀ i : ℕ, Nonempty (cokernel (G.map (homOfLE (Nat.le_succ i))) ≅
        (shiftFunctor 𝒞 (-((i + 1 : ℕ) : ℤ))).obj (Hs.RΓWitt Y m (i + 1))) := by
  sorry

/-- API `TauCeti.QHodge.algebraicHabiroCohomology_complete`: its sections are Habiro-complete, and
on an affine its `(q-1)`-completion is the q-Hodge complex (Theorem 3.11(a)). -/
theorem algebraicHabiroCohomology_complete (Hs : HabiroSheafData.{w, w'} 𝒞) (T : QWittContext K H)
    (Hb : HabiroData H) (S : SmoothDimInvCat ℤ)
    (hX : SmallPrimesInverted (Spec (CommRingCat.of S.obj.obj))) :
    Hb.IsHabiroComplete ((Hs.RΓ _).obj (algebraicHabiroCohomology Hs T _ hX)) ∧
      Nonempty ((T.completeAt ((X : ℤ[X]) - 1)).obj ((Hs.RΓ _).obj (algebraicHabiroCohomology Hs T _ hX)) ≅
        qHodge H ((canonicalSection H).obj S)) := by
  sorry

/-- Unit test `TauCeti.QHodge.algebraicHabiroCohomology_etale`: for `X = Spec O_F[1/Δ]` (here any
`R` étale over `ℤ`, for instance `O_F[1/Δ]`), `RΓ(X, q-Hdg_{X/ℤ})` is the relative Habiro ring
`H_{R/ℤ}`, which for `O_F[1/Δ]` is the GSWZ Habiro ring of `F` (Corollaries 3.13 and 2.13). -/
example (Hs : HabiroSheafData.{w, w'} 𝒞) (T : QWittContext K H) (R : Type) [CommRing R]
    [Algebra.Etale ℤ R] (hX : SmallPrimesInverted (Spec (CommRingCat.of R))) :
    Nonempty ((Hs.RΓ _).obj (algebraicHabiroCohomology Hs T _ hX) ≅ T.relHabiro.obj (SmoothAlg.of R)) := by
  sorry

/-- Unit test `TauCeti.QHodge.algebraicHabiroCohomology_small_primes`: every prime `p ≤ dim(X/ℤ)` is
invertible on `RΓ(X, q-Hdg_{X/ℤ})`, because it is invertible on `X`: the theory contains no
information at those primes (paragraph 1.17(a)). -/
example (Hs : HabiroSheafData.{w, w'} 𝒞) (T : QWittContext K H) (Y : Scheme.{0}) (d : ℕ)
    (hd : SmoothOfRelativeDimension d (specZIsTerminal.from Y))
    (hp : ∀ p : ℕ, p.Prime → p ≤ d → IsUnit (p : Γ(Y, ⊤))) (p : ℕ) (hpp : p.Prime) (hpd : p ≤ d) :
    IsIso ((p : ℤ[X]) • 𝟙 ((Hs.RΓ Y).obj (algebraicHabiroCohomology Hs T Y ⟨d, hd, hp⟩))) := by
  sorry

/-- Unit test `TauCeti.QHodge.algebraicHabiroCohomology_line`: for `X = 𝔸¹_ℤ = Spec ℤ[x]` (no prime
inverted), `RΓ` is the Habiro–Hodge complex whose `(q-1)`-completion is
`ℤ[x]⟦q-1⟧ → ℤ[x]⟦q-1⟧ dx`, `x^m ↦ (q^m - 1) x^{m-1} dx`. -/
example (Hs : HabiroSheafData.{w, w'} 𝒞) (T : QWittContext K H)
    (hX : SmallPrimesInverted (Spec (CommRingCat.of (MvPolynomial (Fin 1) ℤ)))) (q : ℤ) (m : ℕ) :
    Nonempty ((T.completeAt ((X : ℤ[X]) - 1)).obj ((Hs.RΓ _).obj (algebraicHabiroCohomology Hs T _ hX)) ≅
        H.ofMod.obj (K.koszul (qHodgeFramedOp (EtaleFraming.polyId ℤ 1)))) ∧
      qHodgeDiff q ((X : ℤ[X]) ^ m) = C (q ^ m - 1) * X ^ (m - 1) := by
  sorry

/-- Unit test `TauCeti.QHodge.algebraicHabiroCohomology_ne_qdR`: its `(q-1)`-completion is the
q-Hodge complex, not the q-de Rham complex: for `ℤ[x]` the differential sends `x^m` to
`(q^m - 1) x^{m-1} dx`, not to `[m]_q x^{m-1} dx` (paragraph 1.13); at `q = 3`, `x^2 ↦ 8x` against
`4x`. -/
example (Hs : HabiroSheafData.{w, w'} 𝒞) (T : QWittContext K H)
    (hX : SmallPrimesInverted (Spec (CommRingCat.of (MvPolynomial (Fin 1) ℤ)))) :
    ¬ Nonempty ((T.completeAt ((X : ℤ[X]) - 1)).obj ((Hs.RΓ _).obj (algebraicHabiroCohomology Hs T _ hX)) ≅
        H.ofMod.obj (K.koszul (qOmegaFramed.qPartial (EtaleFraming.polyId ℤ 1)))) ∧
      qHodgeDiff (3 : ℤ) ((X : ℤ[X]) ^ 2) ≠ qDiff 3 ((X : ℤ[X]) ^ 2) := by
  sorry

/-- **Theorem (HQ.5/perfectness-for-smooth-proper-schemes, paragraph 1.16), asserted by the source
without proof (source issue E303).** For `N` divisible by every prime `p ≤ d` and `X` smooth and
proper over `ℤ[1/N]` of relative dimension `d`, `RΓ(X, q-Hdg_{X/ℤ})` is a perfect (compact) complex
over the Habiro completion of `H[1/N]` (the owner's category `𝒞N` of modules over that ring). -/
theorem perfectness_smoothProper (Hs : HabiroSheafData.{w, w'} 𝒞) (T : QWittContext K H)
    {𝒞N : Type*} [Category 𝒞N] (forgetN : 𝒞N ⥤ 𝒞) (N d : ℕ) (hN : ∀ p : ℕ, p.Prime → p ≤ d → p ∣ N)
    (Y : Scheme.{0}) (f : Y ⟶ Spec (CommRingCat.of (Localization.Away (N : ℤ)))) [IsProper f]
    [SmoothOfRelativeDimension d f] (hY : SmallPrimesInverted Y) :
    ∃ M : 𝒞N, Nonempty (forgetN.obj M ≅ (Hs.RΓ Y).obj (algebraicHabiroCohomology Hs T Y hY)) ∧
      IsFinitelyPresentable.{0} M := by
  sorry

/-- **Comparison (HQ.5/the-export-to-the-coefficient-roadmap).** For `R` étale over `A = ℤ` (for
instance `O_F[1/Δ]`) the canonical section applies with no prime inverted and `q-Hdg_{R/ℤ}` is the
relative Habiro ring `H_{R/ℤ}` (static): (i) `q-Hdg_{R/ℤ}/(q^m - 1) ≃ qW_m(R/ℤ) ≃ H_{R/ℤ}/(q^m - 1)`;
(ii) its `(q-1)`-completion is the q-Hodge complex `R⟦q-1⟧`, the comparison being HR.5's Taylor map;
(iii) the identification with the GSWZ ring is HR.5's. No statement about `K_3`-indexed modules. -/
theorem export_etale (T : QWittContext K H) (R : Type) [CommRing R] [Algebra.Etale ℤ R] (m : ℕ+) :
    Nonempty (quotBy ((X : ℤ[X]) ^ (m : ℕ) - 1) (qHabiroHodge T (etalePair H R)) ≅
        T.ofCDGA ((qWittOmega (T.qWitt (SmoothAlg.of R))).P m)) ∧
      Nonempty (quotBy ((X : ℤ[X]) ^ (m : ℕ) - 1) (qHabiroHodge T (etalePair H R)) ≅
        quotBy ((X : ℤ[X]) ^ (m : ℕ) - 1) (T.relHabiro.obj (SmoothAlg.of R))) ∧
      Nonempty ((T.completeAt ((X : ℤ[X]) - 1)).obj (qHabiroHodge T (etalePair H R)) ≅
        H.forget.obj (K.powerSeries.obj (K.staticE.obj (CommAlgCat.of ℤ R)))) := by
  sorry

end HabiroCohomology

/-! ### Quasi-lci inputs and condition (R) (node HQ.5/the-quasi-lci-inputs-and-condition-R) -/

section QuasiRegular

/-- `A` regarded as an `A`-module through a ring endomorphism `φ`. -/
def Twist (A : Type u) [CommRing A] (_φ : A →+* A) : Type u := A

instance {φ : A →+* A} : AddCommGroup (Twist A φ) := inferInstanceAs (AddCommGroup A)

instance {φ : A →+* A} : Module A (Twist A φ) :=
  letI : Module A A := Module.compHom A φ
  inferInstanceAs (Module A A)

/-- The relative Frobenius `R/p ⊗_{A,φ} A → R/p`, `r ⊗ a ↦ r^p a`. -/
def relFrobModP (A R : Type u) [CommRing A] [CommRing R] [Algebra A R] (p : ℕ) (φ : A →+* A) :
    TensorProduct A (R ⧸ Ideal.span {(p : R)}) (Twist A φ) →+ R ⧸ Ideal.span {(p : R)} :=
  sorry

theorem relFrobModP_tmul {R : Type u} [CommRing R] [Algebra A R] (p : ℕ) (φ : A →+* A)
    (r : R ⧸ Ideal.span {(p : R)}) (a : A) :
    relFrobModP A R p φ (r ⊗ₜ (show Twist A φ from a)) = r ^ p * algebraMap A _ a := by
  sorry

/-- API `TauCeti.QHodge.PerfectlyCoveredDelta`: a p-completely perfectly covered δ-ring: a p-complete
δ-ring whose Frobenius is p-completely flat (flat modulo every `p^n`). -/
structure PerfectlyCoveredDelta (p : ℕ) (A : Type u) [CommRing A] where
  /-- The δ-structure. -/
  delta : DeltaStructure p A
  /-- Its Frobenius `φ(x) = x^p + p δ(x)`, a ring endomorphism. -/
  frob : A →+* A
  frob_eq : ∀ x, frob x = delta.frob x
  complete : IsAdicComplete (Ideal.span {(p : A)}) A
  frob_le : ∀ n : ℕ, Ideal.span {(p : A) ^ n} ≤ (Ideal.span {(p : A) ^ n}).comap frob
  /-- p-complete flatness of the Frobenius. -/
  frob_pflat : ∀ n : ℕ, (Ideal.quotientMap (Ideal.span {(p : A) ^ n}) frob (frob_le n)).Flat

/-- Such an `A` is p-torsion free. -/
theorem PerfectlyCoveredDelta.torsionFree {p : ℕ} (hp : p.Prime) (P : PerfectlyCoveredDelta p A) :
    IsSMulRegular A (p : A) := by
  sorry

/-- **Owner: DerivedDeRhamCohomology DD.0.** The p-completed cotangent complex: for each
`A`-algebra `R`, the Tor groups `Tor^{R/p}_i(L_{R/A} ⊗^L R/p, M)`. -/
structure CotangentTheory (A : Type u) [CommRing A] (p : ℕ) where
  Tor : ∀ (R : Type u) [CommRing R] [Algebra A R], ℤ →
    ModuleCat.{u} (R ⧸ Ideal.span {(p : R)}) → ModuleCat.{u} (R ⧸ Ideal.span {(p : R)})

/-- API `TauCeti.QHodge.IsPQuasiLci`: `L_{R/A}` has p-complete Tor-amplitude in homological degrees
`[0, 1]`. -/
def IsPQuasiLci {p : ℕ} (CT : CotangentTheory A p) (R : Type u) [CommRing R] [Algebra A R] : Prop :=
  ∀ (i : ℤ) (M : ModuleCat.{u} (R ⧸ Ideal.span {(p : R)})), (i < 0 ∨ 1 < i) → Subsingleton (CT.Tor R i M)

/-- API `TauCeti.QHodge.IsRelSemiperfect`: the relative Frobenius `R/p ⊗_{A,φ} A → R/p` is
surjective. -/
def IsRelSemiperfect (A R : Type u) [CommRing A] [CommRing R] [Algebra A R] (p : ℕ) (φ : A →+* A) :
    Prop :=
  Function.Surjective (relFrobModP A R p φ)

/-- API `TauCeti.QHodge.IsRelSemiperfect.cotangent`: relative semiperfectness forces
`Ω¹_{R/A}/p = 0`, so a quasi-lci `L_{R/A}` is then concentrated in degree `1`. -/
theorem IsRelSemiperfect.cotangent {R : Type u} [CommRing R] [Algebra A R] {p : ℕ} {φ : A →+* A}
    (h : IsRelSemiperfect A R p φ) (CT : CotangentTheory A p) :
    (∀ ω : Ω[R⁄A], ∃ η, ω = (p : R) • η) ∧
      (IsPQuasiLci CT R → ∀ M, Subsingleton (CT.Tor R 0 M)) := by
  sorry

/-- Koszul-regular: the Koszul complex of multiplication by `f_1, …, f_r` is exact below the top
degree (homology only in degree `0` for the homological Koszul complex). -/
def KoszulRegular {B : Type u} [CommRing B] {r : ℕ} (f : Fin r → B) : Prop :=
  ∀ x : Finset (Fin r) → B, (∀ I : Finset (Fin r), I.card = r → x I = 0) →
    koszulDiff (fun i => AddMonoidHom.mulLeft (f i)) x = 0 →
      ∃ y, koszulDiff (fun i => AddMonoidHom.mulLeft (f i)) y = x

/-- API `TauCeti.QHodge.KoszulRegular.of_isRegular`: a sequence that is regular in Mathlib's sense
(`RingTheory.Sequence.IsRegular`) is Koszul-regular. -/
theorem KoszulRegular.of_isRegular {B : Type u} [CommRing B] {r : ℕ} (f : Fin r → B)
    (hf : RingTheory.Sequence.IsRegular B (List.ofFn f)) : KoszulRegular f := by
  sorry

/-- API `TauCeti.QHodge.PerfectRegularPresentation`: `R ≅ B/J` with `B` a p-complete relatively
perfect δ-`A`-algebra (the relative Frobenius is bijective modulo `p`) and `J` generated by a
Koszul-regular sequence. -/
structure PerfectRegularPresentation (A R : Type u) [CommRing A] [CommRing R] [Algebra A R] (p : ℕ)
    (φ : A →+* A) where
  B : Type u
  [ring : CommRing B]
  [alg : Algebra A B]
  deltaB : DeltaStructure p B
  relPerfect : Function.Bijective (relFrobModP A B p φ)
  complete : IsAdicComplete (Ideal.span {(p : B)}) B
  r : ℕ
  f : Fin r → B
  koszulRegular : KoszulRegular f
  equiv : (B ⧸ Ideal.span (Set.range f)) ≃ₐ[A] R

attribute [instance] PerfectRegularPresentation.ring PerfectRegularPresentation.alg

/-- API `TauCeti.QHodge.ConditionR`: condition (R) on an algebra over a perfectly covered Λ-ring
(the hypothesis of Construction 4.28): for every prime `p`, `R` is p-torsion free, `R̂_p` is
p-quasi-lci over `Â_p`, and `R/p` is relatively semiperfect over `Â_p` (Frobenius `ψ^p`). The
introduction's phrasing (static `(dR_{R/ℤ})^∧_p` with a Hodge filtration by ideals) is implied
(`staticity_quasiLci`). -/
structure ConditionR (Λ : LambdaRing A) (CT : ∀ p : Nat.Primes, CotangentTheory A p)
    (R : Type u) [CommRing R] [Algebra A R] : Prop where
  torsionFree : ∀ p : Nat.Primes, IsSMulRegular R (p : R)
  quasiLci : ∀ p : Nat.Primes, IsPQuasiLci (CT p) R
  semiperfect : ∀ p : Nat.Primes, IsRelSemiperfect A R p (Λ.psi p)

/-- API `TauCeti.QHodge.ConditionR.of_etale_quotient`: a p-torsion free quotient of an étale algebra
over a perfect Λ-ring by a Koszul-regular sequence satisfies (R). -/
theorem ConditionR.of_etale_quotient (Λ : LambdaRing A) (CT : ∀ p : Nat.Primes, CotangentTheory A p)
    (hperf : ∀ n, Function.Bijective (Λ.adams n)) (E : Type u) [CommRing E] [Algebra A E]
    [Algebra.Etale A E] {r : ℕ} (f : Fin r → E) (hf : KoszulRegular f) (R : Type u) [CommRing R]
    [Algebra A R] (e : (E ⧸ Ideal.span (Set.range f)) ≃ₐ[A] R)
    (htf : ∀ p : Nat.Primes, IsSMulRegular R (p : R)) : ConditionR Λ CT R := by
  sorry

/-- **Owner: PrismaticCohomology PR.0.** The free p-complete δ-ring `ℤ_p{x}^∧_p` on a generator. -/
structure FreeDeltaRing (p : ℕ) where
  /-- The ring. -/
  Ap : Type u
  [ring : CommRing Ap]
  delta : PerfectlyCoveredDelta p Ap
  /-- The generator. -/
  x : Ap

attribute [instance] FreeDeltaRing.ring

/-- Unit test `TauCeti.QHodge.ConditionR.free_delta_quotient`: for `A = ℤ_p{x}^∧_p` and `α ≥ 1`,
`R = A/x^α` has the perfect-regular presentation `B = A`, `J = (x^α)`, and satisfies the p-complete
conditions (Example 4.24). -/
example {p : ℕ} (hp : p.Prime) (Fr : FreeDeltaRing.{u} p) (α : ℕ) (hα : 1 ≤ α) (CT : CotangentTheory Fr.Ap p) :
    KoszulRegular ![Fr.x ^ α] ∧
      IsRelSemiperfect Fr.Ap (Fr.Ap ⧸ Ideal.span {Fr.x ^ α}) p Fr.delta.frob ∧
      IsSMulRegular (Fr.Ap ⧸ Ideal.span {Fr.x ^ α}) (p : Fr.Ap ⧸ Ideal.span {Fr.x ^ α}) ∧
      IsPQuasiLci CT (Fr.Ap ⧸ Ideal.span {Fr.x ^ α}) ∧
      Nonempty (PerfectRegularPresentation Fr.Ap (Fr.Ap ⧸ Ideal.span {Fr.x ^ α}) p Fr.delta.frob) := by
  sorry

/-- Unit test `TauCeti.QHodge.ConditionR.etale`: an étale `A`-algebra satisfies the p-complete
conditions: `L_{R/A} = 0` and the relative Frobenius of `R/p` is an isomorphism. -/
example {p : ℕ} (P : PerfectlyCoveredDelta p A) (CT : CotangentTheory A p) (R : Type u) [CommRing R]
    [Algebra A R] [Algebra.Etale A R] :
    Function.Bijective (relFrobModP A R p P.frob) ∧ ∀ i M, Subsingleton (CT.Tor R i M) := by
  sorry

/-- Unit test `TauCeti.QHodge.IsRelSemiperfect.not_of_torAmplitude`: Tor-amplitude in degree `1`
does not imply relative semiperfectness modulo `p` (Remark 4.20, `p ≥ 3`). -/
example {p : ℕ} (hp : p.Prime) (hp3 : 3 ≤ p) (P : PerfectlyCoveredDelta p A) (CT : CotangentTheory A p) :
    ∃ (R : Type u) (_ : CommRing R) (_ : Algebra A R),
      (∀ (i : ℤ) M, i ≠ 1 → Subsingleton (CT.Tor R i M)) ∧ ¬ IsRelSemiperfect A R p P.frob := by
  sorry

/-- Unit test `TauCeti.QHodge.ConditionR.not_smooth`: a smooth `A`-algebra of positive relative
dimension is p-quasi-lci but not relatively semiperfect, since `Ω¹_{R/A}/p ≠ 0`; the two existence
theorems overlap only in relative dimension zero. -/
example {p : ℕ} (hp : p.Prime) (φ : A →+* A) (CT : CotangentTheory A p) (R : Type u) [CommRing R]
    [Algebra A R] [Algebra.Smooth A R] (hdim : ¬ RelDimLE A R 0) (hR : Nontrivial (R ⧸ Ideal.span {(p : R)})) :
    IsPQuasiLci CT R ∧ ¬ IsRelSemiperfect A R p φ ∧ ∃ ω : Ω[R⁄A], ∀ η, ω ≠ (p : R) • η := by
  sorry

/-! ### The naive filtration (node HQ.5/the-naive-filtration-for-quasi-regular-inputs) -/

/-- Static models of the p-completed derived objects of a p-torsion free p-quasi-lci `A`-algebra
`R` with `R/p` relatively semiperfect (static by `staticity_quasiLci`; supplied by
DerivedDeRhamCohomology DD.2 and PrismaticCohomology PR.6): the rings `qdR_{R/A}`, `dR_{R/A}` and
`dR_{R/A}[1/p]⟦q-1⟧`, the rationalised comparison, the reduction modulo `q - 1`, the Hodge
filtration by ideals and the combined Hodge and `(q-1)`-adic filtration by ideals. -/
structure StaticQuasiRegular (A R : Type u) [CommRing A] [CommRing R] [Algebra A R] (p : ℕ) where
  qdR : Type u
  [ringq : CommRing qdR]
  dR : Type u
  [ringd : CommRing dR]
  dRQ : Type u
  [ringQ : CommRing dRQ]
  /-- `q ∈ qdR`. -/
  q : qdR
  /-- `qdR → dR[1/p]⟦q-1⟧`. -/
  comparison : qdR →+* dRQ
  /-- `qdR → dR`, reduction modulo `q - 1`. -/
  proj : qdR →+* dR
  proj_surjective : Function.Surjective proj
  /-- `R → dR`. -/
  ofR : R →+* dR
  hodge : ℕ → Ideal dR
  combined : ℕ → Ideal dRQ
  p_isUnit : IsUnit (p : dRQ)

attribute [instance] StaticQuasiRegular.ringq StaticQuasiRegular.ringd StaticQuasiRegular.ringQ

variable {R : Type u} [CommRing R] [Algebra A R] {p : ℕ}

/-- **Construction (HQ.5/the-naive-filtration-for-quasi-regular-inputs).** API
`TauCeti.QHodge.naiveFiltration`: the 1-categorical preimage of the combined Hodge and
`(q-1)`-adic filtration under `qdR_{R/A} → dR_{R/A}[1/p]⟦q-1⟧` (legitimate because both sides are
static): a descending filtration by ideals. In general it is NOT a q-deformation of the Hodge
filtration. -/
def naiveFiltration (D : StaticQuasiRegular A R p) (n : ℕ) : Ideal D.qdR :=
  (D.combined n).comap D.comparison

/-- API `TauCeti.QHodge.naiveFiltration_mem_iff`. -/
theorem naiveFiltration_mem_iff (D : StaticQuasiRegular A R p) (n : ℕ) (x : D.qdR) :
    x ∈ naiveFiltration D n ↔ D.comparison x ∈ D.combined n :=
  Iff.rfl

/-- API `TauCeti.QHodge.naiveFiltration_mul`: `fil^i · fil^j ⊆ fil^{i+j}` and
`(q - 1) fil^i ⊆ fil^{i+1}`: a filtered `E∞`-algebra over `(q-1)^⋆A⟦q-1⟧`. -/
theorem naiveFiltration_mul (D : StaticQuasiRegular A R p) (i j : ℕ) :
    naiveFiltration D i * naiveFiltration D j ≤ naiveFiltration D (i + j) ∧
      Ideal.span {D.q - 1} * naiveFiltration D i ≤ naiveFiltration D (i + 1) := by
  sorry

/-- API `TauCeti.QHodge.naiveFiltration_toHodge`: the (unique) filtered map to `fil^⋆_Hdg dR_{R/A}`
induced by the projection. -/
theorem naiveFiltration_toHodge (D : StaticQuasiRegular A R p) (n : ℕ) :
    (naiveFiltration D n).map D.proj ≤ D.hodge n := by
  sorry

/-- API `TauCeti.QHodge.naiveFiltration_injective_mod`; **Lemma (HQ.5/the-naive-filtration-is-
injective-modulo-q-minus-one, Lemma 4.26).** The map from the reduction modulo `q - 1` (in
filtration degree one) to the Hodge filtration is degreewise injective:
`(q - 1) fil^{n-1} = fil^n ∩ (q - 1) qdR` for all `n ≥ 1`; no presentation is needed. -/
theorem naiveFiltration_injective_mod (D : StaticQuasiRegular A R p) (n : ℕ) (hn : 1 ≤ n) :
    Ideal.span {D.q - 1} * naiveFiltration D (n - 1) = naiveFiltration D n ⊓ Ideal.span {D.q - 1} := by
  sorry

/-- API `TauCeti.QHodge.naiveFiltration_baseChange`: flat base change along `A → A'` (Lemma 4.27):
the naive filtration of `R' = (R ⊗_A A')^∧_p` is the `(p, q-1)`-completed extension of that of `R`
(equality modulo every power of `(p, q - 1)`). -/
theorem naiveFiltration_baseChange {A' R' : Type u} [CommRing A'] [CommRing R'] [Algebra A' R']
    (D : StaticQuasiRegular A R p) (D' : StaticQuasiRegular A' R' p) (φ : D.qdR →+* D'.qdR)
    (hφ : φ.Flat) (n k : ℕ) :
    naiveFiltration D' n ⊔ Ideal.span {(p : D'.qdR), D'.q - 1} ^ k =
      Ideal.map φ (naiveFiltration D n) ⊔ Ideal.span {(p : D'.qdR), D'.q - 1} ^ k := by
  sorry

/-- **Theorem (HQ.5/flat-base-change-for-the-naive-filtration, Lemma 4.27).** For a p-completely
flat map `A → A'` of p-completely perfectly covered δ-rings, the `(p, q-1)`-completed base change of
the naive filtration of `R` is the naive filtration of `R' = (R ⊗_A A')^∧_p`. -/
theorem naiveFiltration_flatBaseChange {A' R' : Type u} [CommRing A'] [CommRing R'] [Algebra A' R']
    (PA : PerfectlyCoveredDelta p A) (PA' : PerfectlyCoveredDelta p A') (g : A →+* A')
    (hgδ : ∀ x, g (PA.delta.δ x) = PA'.delta.δ (g x))
    (hle : ∀ n : ℕ, Ideal.span {(p : A) ^ n} ≤ (Ideal.span {(p : A') ^ n}).comap g)
    (hg : ∀ n : ℕ, (Ideal.quotientMap (Ideal.span {(p : A') ^ n}) g (hle n)).Flat)
    (D : StaticQuasiRegular A R p) (D' : StaticQuasiRegular A' R' p) (φ : D.qdR →+* D'.qdR) (n k : ℕ) :
    naiveFiltration D' n ⊔ Ideal.span {(p : D'.qdR), D'.q - 1} ^ k =
      Ideal.map φ (naiveFiltration D n) ⊔ Ideal.span {(p : D'.qdR), D'.q - 1} ^ k := by
  sorry

/-- Unit test `TauCeti.QHodge.naiveFiltration_etale`: for `R` étale over `A`, `qdR_{R/A} = R⟦q-1⟧`
(p-completed) and the filtration is the `(q-1)`-adic filtration; its reduction modulo `q - 1` is
the Hodge filtration (`R` in degree `0`). -/
example (D : StaticQuasiRegular A R p) [Algebra.Etale A R] (n : ℕ) :
    naiveFiltration D n = Ideal.span {D.q - 1} ^ n ∧ D.hodge (n + 1) = ⊥ := by
  sorry

/-- Unit test `TauCeti.QHodge.naiveFiltration_exponent_one`: for `A = ℤ_p{x}^∧_p` and `R = A/x`, the
filtration is not a q-deformation of the Hodge filtration (Example 4.24): `fil^p` does not surject
onto `fil^p_Hdg`. -/
example (Fr : FreeDeltaRing.{u} p) (D : StaticQuasiRegular Fr.Ap (Fr.Ap ⧸ Ideal.span {Fr.x}) p) :
    (naiveFiltration D p).map D.proj ≠ D.hodge p := by
  sorry

/-- Unit test `TauCeti.QHodge.naiveFiltration_exponent_two`: for `R = A/x^2`, with
`[p]_q = p u + (q-1)^{p-1}`, the element `γ_q(x^2) - (u^{-1} - 1) δ(x^2) + u^{-2} (q-1)^{p-1} δ(x)^2`
of the q-PD envelope lies in `fil^p` and reduces modulo `q - 1` to `x^{2p}/p` (Example 4.24). -/
example (hp : p.Prime) (Fr : FreeDeltaRing.{u} p)
    (D : StaticQuasiRegular Fr.Ap (Fr.Ap ⧸ Ideal.span {Fr.x ^ 2}) p) (E : QPDEnvelope.{u} p)
    (e : E.qD ≃+* D.qdR) (xE : E.P) (hx : xE ∈ E.J) (u : E.qDQ) (hu : IsUnit u)
    (hpu : qInt p (E.ofqD E.q) = p * u + (E.ofqD E.q - 1) ^ (p - 1)) :
    ∃ z : E.qD, E.ofqD z = E.gammaQ (E.ofqD (E.toqD (xE ^ 2))) -
          (↑hu.unit⁻¹ - 1) * E.delta.δ (E.ofqD (E.toqD (xE ^ 2))) +
          ↑hu.unit⁻¹ ^ 2 * (E.ofqD E.q - 1) ^ (p - 1) * E.delta.δ (E.ofqD (E.toqD xE)) ^ 2 ∧
      e z ∈ naiveFiltration D p ∧
      (p : D.dR) * D.proj (e z) = D.proj (e (E.toqD xE)) ^ (2 * p) := by
  sorry

/-- Unit test `TauCeti.QHodge.naiveFiltration_not_derived`: the derived pullback differs: its `H^1`
in filtration degree `1` contains the class of `1/p ∈ dR_{R/A}[1/p]⟦q-1⟧`, which lies neither in the
image of `qdR_{R/A}` nor in the combined filtration's first step plus that image. -/
example (D : StaticQuasiRegular A R p) :
    ∀ a ∈ D.combined 1, ∀ b : D.qdR, D.comparison b + a ≠ ↑D.p_isUnit.unit⁻¹ := by
  sorry

/-- **Theorem (HQ.5/when-the-naive-filtration-deforms-the-hodge-filtration, Theorem 4.22(a)).** Let
`A` be a p-completely perfectly covered δ-ring and `R` a p-torsion free quasi-lci `A`-algebra with
`R/p` relatively semiperfect. If `R ≅ B/J` has a perfect-regular presentation with `J` generated by
higher powers `x_1^{α_1}, …, x_r^{α_r}`, every `α_i ≥ 2`, then the naive filtration is a q-deformation
of the Hodge filtration: `fil^⋆_{q-Hdg}/(q-1) ≃ fil^⋆_Hdg` (injectivity is
`naiveFiltration_injective_mod`; surjectivity is stated). No restriction at `p = 2`. Condition (b)
of the source (a spherical `E_1`-lift of `R_∞`) is `deforms_of_E1Lift` in HQ.5-trace. -/
theorem deforms_of_higherPowers (PA : PerfectlyCoveredDelta p A) (CT : CotangentTheory A p)
    (hR : IsSMulRegular R (p : R)) (hlci : IsPQuasiLci CT R) (hsp : IsRelSemiperfect A R p PA.frob)
    (P : PerfectRegularPresentation A R p PA.frob)
    (hpow : ∃ (x : Fin P.r → P.B) (α : Fin P.r → ℕ), (∀ i, 2 ≤ α i) ∧ ∀ i, P.f i = x i ^ α i)
    (D : StaticQuasiRegular A R p) (n : ℕ) :
    (naiveFiltration D n).map D.proj = D.hodge n := by
  sorry

/-- **Lemma (HQ.5/the-exponent-one-quotient-is-not-a-q-deformation, Example 4.24).** For
`A = ℤ_p{x}^∧_p` and `R = A/x`, `fil^p_{q-Hdg}` of the q-PD envelope contains no lift of the divided
power `x^p/p`: modulo `(q-1)` every lift differs from `γ_q(x)` by the non-integral multiple
`u^{-2}(q-1)^{p-1} δ(x)/p` of the polynomial variable `δ(x)`. For `α ≥ 2` the obstruction disappears
(`deforms_of_higherPowers`). -/
theorem exponentOne_not_deformation (Fr : FreeDeltaRing.{u} p)
    (D : StaticQuasiRegular Fr.Ap (Fr.Ap ⧸ Ideal.span {Fr.x}) p) :
    ¬ ∃ y ∈ naiveFiltration D p,
      (p : D.dR) * D.proj y = D.ofR (Ideal.Quotient.mk _ Fr.x) ^ p := by
  sorry

end QuasiRegular

section QuasiRegularSections

variable {Λ : LambdaRing A} {Ani 𝒟 ℰ Mod : Type*} [Category Ani] [Category 𝒟] [Category ℰ]
  [Category Mod] [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ] [HasPullbacks 𝒟]
  {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear A[X] 𝒞] [HasFiniteColimits 𝒞]
  [HasZeroObject 𝒞] {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod} {H : HodgeContext K 𝒞}

/-- **Owner: this roadmap's staticity lemma, with DerivedDeRhamCohomology DD.2 and
PrismaticCohomology PR.6.** The static models of the p-completed derived objects of every
`A`-algebra satisfying (R), at every prime. -/
structure QuasiRegularModels (Λ : LambdaRing A) (CT : ∀ p : Nat.Primes, CotangentTheory A p) where
  static : ∀ (R : CommAlgCat.{u} A) (p : Nat.Primes), StaticQuasiRegular A R p

/-- `QReg^{q-Hdg}_A`: condition (R) and, at every prime, the naive filtration is a q-deformation of
the Hodge filtration. -/
def QRegObj (Λ : LambdaRing A) (CT : ∀ p : Nat.Primes, CotangentTheory A p)
    (Mo : QuasiRegularModels Λ CT) : ObjectProperty (CommAlgCat.{u} A) :=
  fun R => ConditionR Λ CT R ∧
    ∀ (p : Nat.Primes) (n : ℕ), (naiveFiltration (Mo.static R p) n).map (Mo.static R p).proj =
      (Mo.static R p).hodge n

/-- **Theorem (HQ.5/the-canonical-section-on-quasi-regular-inputs, Construction 4.28 and Theorem
4.29).** The global filtration (the pullback, in filtered `E∞`-algebras, of the p-complete naive
filtrations and the rational combined filtration) defines a partial section of the forgetful functor
on `QReg^{q-Hdg}_A`; every `R` that is p-torsion free for all `p` and has, at every prime, a
perfect-regular presentation by higher powers lies in `QReg^{q-Hdg}_A`. (The upgrade to
`CAlg(AniAlg^{q-Hdg}_A)` and to filtered derived commutative algebras, Remark 4.31, is not stated.) -/
theorem canonicalSection_quasiRegular (hA : Λ.IsPerfectlyCovered)
    (CT : ∀ p : Nat.Primes, CotangentTheory A p) (Mo : QuasiRegularModels Λ CT) :
    (∃ σ : (QRegObj Λ CT Mo).FullSubcategory ⥤ PairsCat H,
      Nonempty (σ ⋙ PairsCat.forget H ≅ ObjectProperty.ι _ ⋙ K.ofStatic)) ∧
    ∀ R : CommAlgCat.{u} A, ConditionR Λ CT R →
      (∀ p : Nat.Primes, ∃ P : PerfectRegularPresentation A R p (Λ.psi p),
        ∃ (x : Fin P.r → P.B) (α : Fin P.r → ℕ), (∀ i, 2 ≤ α i) ∧ ∀ i, P.f i = x i ^ α i) →
      QRegObj Λ CT Mo R := by
  sorry

/-- The canonical section on `QReg^{q-Hdg}_A`. -/
def canonicalSectionQReg (CT : ∀ p : Nat.Primes, CotangentTheory A p) (Mo : QuasiRegularModels Λ CT)
    (H : HodgeContext K 𝒞) : (QRegObj Λ CT Mo).FullSubcategory ⥤ PairsCat H :=
  sorry

/-- **Theorem (HQ.5/uniqueness-of-the-two-sections), part (a).** On `QReg^{q-Hdg}_A` the canonical
filtration is TERMINAL: every q-Hodge filtration maps to it compatibly with the identity of
`qdR_{R/A}`, and by the q-deformation clause the map is an equivalence; so the canonical section is
the unique one there. (The source asserts this in paragraph 1.21 without proof.) -/
theorem uniqueness_quasiRegular (CT : ∀ p : Nat.Primes, CotangentTheory A p)
    (Mo : QuasiRegularModels Λ CT) (R : (QRegObj Λ CT Mo).FullSubcategory)
    (F : QHodgeFiltration H (K.ofStatic.obj R.obj)) :
    ∃ φ : F.fil ⟶ ((canonicalSectionQReg CT Mo H).obj R).F.fil, IsIso φ := by
  sorry

/-- **Theorem (HQ.5/uniqueness-of-the-two-sections), part (b).** In the smooth case the canonical
filtration is INITIAL among q-Hodge filtrations on `qdR_{S/A}` compatible with the factorisation
`qΩ_{S/A} → Ω_{S/A}⟦q-1⟧/(q-1)^n` (a map of filtrations to the reduced combined filtration
extending it in degree `0`), and the q-deformation clause makes it unique. The alternative
compatibility, with a `ℤ_p^×`-action on the p-completions, is not stated. Without one of the two
compatibilities no uniqueness is claimed. -/
theorem uniqueness_smooth [HasColimitsOfShape ℕ 𝒞] {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) (S : SmoothAlgInv A n)
    (hS : RelDimLE A S.obj.obj n) (F : QHodgeFiltration H (K.ofSmooth.obj S.obj))
    (ψ : F.fil.fil ⟶ combinedFiltrationMod H n S.obj)
    (hψ : F.zerothEquiv.hom ≫ ψ.app (op 0) =
      H.forget.map ((qdR.toQOmega K).app S.obj) ≫ qOmega_factorisationMap H n S ≫
        (combinedFiltrationMod.zero H n S.obj).inv) :
    ∃ φ : canonicalSmoothFiltration.toQdR H M S ⟶ F.fil, IsIso φ := by
  sorry

/-- `M` is static: its cohomology is concentrated in degree `0`. -/
def CohomologyData.IsStatic (Hc : CohomologyData (A := A) 𝒞) (M : 𝒞) : Prop :=
  ∀ i : ℤ, i ≠ 0 → Subsingleton ((Hc.Hn i).obj M)

/-- **Lemma (HQ.5/staticity-for-quasi-lci-inputs, Lemma 4.18).** For `R` p-torsion free with
`L_{R/A}` of p-complete Tor-amplitude concentrated in degree `1`: (a) `dR_{R/A}` and `qdR_{R/A}` are
static and p-torsion free (p-completed); (b) the uncompleted Hodge filtration is static in every
degree iff `R/p` is relatively semiperfect. (Part (c), the identification with the PD and q-PD
envelopes of a perfect-regular presentation, is the envelope data of `QPDEnvelope`; it is not
restated here.) -/
theorem staticity_quasiLci (T : QWittContext K H) (Hc : CohomologyData (A := A) 𝒞) (p : Nat.Primes)
    (CT : CotangentTheory A p) (R : CommAlgCat.{u} A) (hR : IsSMulRegular R (p : R))
    (hL : ∀ (i : ℤ) M, i ≠ 1 → Subsingleton (CT.Tor R i M)) :
    Hc.IsStatic ((T.pComplete p).obj (H.forgetE.obj (K.dR.obj (K.ofStatic.obj R)))) ∧
      IsSMulRegular ((Hc.Hn 0).obj ((T.pComplete p).obj (H.forgetE.obj (K.dR.obj (K.ofStatic.obj R)))))
        (p : A[X]) ∧
      Hc.IsStatic ((T.pComplete p).obj (H.forget.obj ((qdR K).obj (K.ofStatic.obj R)))) ∧
      ((∀ n : ℕ, Hc.IsStatic ((T.pComplete p).obj ((H.hodgeFil.obj (K.ofStatic.obj R)).obj (op n)))) ↔
        IsRelSemiperfect A R p (Λ.psi p)) := by
  sorry

/-- **Theorem (HQ.5/tensor-products-in-the-quasi-regular-category, Proposition 4.32), part (a).**
If `R₁, R₂ ∈ QReg^{q-Hdg}_A` and `R₁ ⊗_A R₂` is static (here: `R₁` flat over `A`) and p-torsion free
for every `p`, then `R₁ ⊗_A R₂ ∈ QReg^{q-Hdg}_A`; the only obstruction to closure under tensor
products is staticity and torsion freeness. -/
theorem quasiRegular_tensor (CT : ∀ p : Nat.Primes, CotangentTheory A p) (Mo : QuasiRegularModels Λ CT)
    (R₁ R₂ : CommAlgCat.{u} A) (h₁ : QRegObj Λ CT Mo R₁) (h₂ : QRegObj Λ CT Mo R₂)
    [Module.Flat A R₁] (htf : ∀ p : Nat.Primes, IsSMulRegular (TensorProduct A R₁ R₂) (p : TensorProduct A R₁ R₂)) :
    QRegObj Λ CT Mo (CommAlgCat.of A (TensorProduct A R₁ R₂)) := by
  sorry

/-- **Theorem (HQ.5/tensor-products-in-the-quasi-regular-category), part (b).** In that case the
canonical map from the completed tensor product of the canonical filtrations to the canonical
filtration of `R₁ ⊗_A R₂` is an equivalence (so the section is symmetric monoidal on flat objects;
the partial sub-operad of part (c) is `SmoothDimInv.operadic`'s recipe, not restated). -/
theorem quasiRegular_tensor_filtration (CT : ∀ p : Nat.Primes, CotangentTheory A p)
    (Mo : QuasiRegularModels Λ CT) (TD : TensorData H) (R₁ R₂ : (QRegObj Λ CT Mo).FullSubcategory)
    (R : (QRegObj Λ CT Mo).FullSubcategory)
    (e : R.obj ≅ CommAlgCat.of A (TensorProduct A R₁.obj R₂.obj)) :
    ∃ f : TD.filTensor ((canonicalSectionQReg CT Mo H).obj R₁).F.fil
        ((canonicalSectionQReg CT Mo H).obj R₂).F.fil ⟶ ((canonicalSectionQReg CT Mo H).obj R).F.fil,
      IsIso f := by
  sorry

/-- **Owners: EnhancedDerivedSheaves E5:presentability and PrismaticCohomology PR.6.** The
p-tilde-de Rham complex of Bhatt–Lurie: the homotopy fixed points of `μ_{p-1} ⊆ ℤ_p^×` acting on
`(qΩ_{S/A})^∧_p` (through `q ↦ q^u` on the prism and the prismatic comparison), with its map to
`(Ω_{S/A})^∧_p`. -/
structure PTildeData (T : QWittContext K H) where
  pTilde : Nat.Primes → SmoothAlg A ⥤ 𝒞
  toDeRham : ∀ p, pTilde p ⟶ K.deRham ⋙ H.forgetE ⋙ T.pComplete p

/-- The p-completed q-Hodge filtration from the p-tilde-de Rham complex: the pullback of the Hodge
filtration along `toDeRham` (no combined filtration needed), extended by `τ_{n,!}` and base changed
to `(q-1)^⋆ℤ_p⟦q-1⟧`. -/
def pTildeFiltration {T : QWittContext K H} (PT : PTildeData T) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) (p : Nat.Primes) :
    SmoothAlgInv A n ⥤ FilModule ((X : A[X]) - 1) 𝒞 :=
  sorry

/-- **Comparison (HQ.5/the-p-tilde-de-rham-description-of-the-canonical-filtration).** The p-complete
filtrations from the p-tilde-de Rham complex, glued over all primes with the combined filtration,
give the canonical filtration; p-adically, `pTildeFiltration` is the p-completion of the canonical
filtration. The source does not spell the gluing out (flagged). -/
theorem pTilde_description {T : QWittContext K H} (PT : PTildeData T) {n : ℕ}
    (M : TruncationModules 𝒞 (FilModule ((X : A[X]) - 1) 𝒞) n) (p : Nat.Primes) (S : SmoothAlgInv A n) :
    Nonempty (((pTildeFiltration PT M p).obj S).fil ≅
      ((canonicalSmoothFiltration H M).obj S).fil ⋙ T.pComplete p) := by
  sorry

end QuasiRegularSections

end HQ5

/-! ## HQ.5-trace — The trace-theoretic existence theorem (imported from RefinedTraceMethods RT.4) -/

section HQ5trace

variable {A : Type u} [CommRing A] {Λ : LambdaRing A} {Ani 𝒟 ℰ Mod : Type*} [Category Ani]
  [Category 𝒟] [Category ℰ] [Category Mod] [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ]
  [HasPullbacks 𝒟] {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear A[X] 𝒞]
  [HasFiniteColimits 𝒞] [HasZeroObject 𝒞] {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod}

/-- **Owners: RefinedTraceMethods RT.4:q-Hodge and RT.6** (structured ring spectra, topological
cyclic homology over connective complex K-theory, the even filtration). For an `A`-algebra `R`: the
types of its lifts (connective `E₂`-lifts `S_R` over the sphere with `S_R ⊗ ℤ ≃ R`; p-complete
connective `E₁`-lifts of `R` itself; `E₁`-lifts of the p-completed base change `R_∞` to the
perfection; `E₁`-`ku`-algebra lifts; the body form's conditions (E_2) and (E_1) at each prime, the
latter with its quasi-syntomic cover and lifted Čech nerve), the base condition 3.1(tCp), the graded
pieces `Σ^{-2*} gr^*_{ev,hS¹} TC^-(ku ⊗ S_R/ku)` of the even filtration, the trace-theoretic q-Hodge
filtrations the construction outputs (consumed only as objects of the category of pairs), and, for
the identity-cover case, the p-complete trace filtration on a static model of `qdR_{R/A}`. -/
structure TraceData (H : HodgeContext K 𝒞) where
  E2Lift : CommAlgCat.{u} A → Type w
  E1Lift : Nat.Primes → CommAlgCat.{u} A → Type w
  E1LiftPerf : Nat.Primes → CommAlgCat.{u} A → Type w
  E1KuLift : Nat.Primes → CommAlgCat.{u} A → Type w
  condE2 : Nat.Primes → CommAlgCat.{u} A → Type w
  condE1 : Nat.Primes → CommAlgCat.{u} A → Type w
  baseTCp : Nat.Primes → Type w
  evenFil : ∀ R : CommAlgCat.{u} A, E2Lift R → (ℕᵒᵖ ⥤ 𝒞)
  evenFilBody : CommAlgCat.{u} A → (ℕᵒᵖ ⥤ 𝒞)
  traceFil : ∀ R : CommAlgCat.{u} A, E2Lift R → QHodgeFiltration H (K.ofStatic.obj R)
  traceFilBody : ∀ R : CommAlgCat.{u} A, QHodgeFiltration H (K.ofStatic.obj R)
  traceFilStatic : ∀ (p : Nat.Primes) (R : CommAlgCat.{u} A), E1Lift p R →
    ∀ D : StaticQuasiRegular A R p, ℕ → Ideal D.qdR

/-- **Theorem (HQ.5-trace/trace-theoretic-existence-of-q-hodge-filtrations), imported form (ku paper
Theorem 1.2), over `ℤ`.** For `R` quasi-syntomic (flat over `ℤ`, p-quasi-lci at every prime) with
`2 ∈ R^×` and a connective `E₂`-lift `S_R` over the sphere, `q-dR_{R/ℤ}` carries a q-deformation of
the Hodge filtration (an object of the category of pairs, `TD.traceFil`) whose completion agrees
with `Σ^{-2*} gr^*_{ev,hS¹} TC^-(ku ⊗ S_R/ku)`. A lift over `ku` alone does not suffice
(`ku_lift_not_enough`). -/
theorem trace_existence {Λℤ : LambdaRing ℤ} {𝒞z : Type*} [Category 𝒞z] [Preadditive 𝒞z]
    [Linear ℤ[X] 𝒞z] [HasFiniteColimits 𝒞z] {Kz : QDeRhamContext ℤ Λℤ Ani 𝒟 ℰ Mod}
    (Hz : HodgeContext Kz 𝒞z) (TD : TraceData.{0, w} Hz) (CT : ∀ p : Nat.Primes, CotangentTheory ℤ p)
    (R : CommAlgCat.{0} ℤ) [Module.Flat ℤ R] (hqs : ∀ p : Nat.Primes, IsPQuasiLci (CT p) R)
    (h2 : IsUnit (2 : R)) (L : TD.E2Lift R) :
    Nonempty ((FilModule.complete (TD.traceFil R L).fil).fil ≅ TD.evenFil R L) := by
  sorry

/-- **Theorem (HQ.5-trace/trace-theoretic-existence-of-q-hodge-filtrations), body form (ku paper
Theorem 4.27).** For a perfectly covered base satisfying 3.1(tCp) at every prime and a quasi-lci
`R` with bounded `p^∞`-torsion satisfying (E_2) or (E_1) at each prime (not necessarily the same),
and the addendum (R2) ((E_1) at `2`, which holds if `2 ∈ R^×`), the comparison map identifies the
completed q-Hodge filtration with the even filtration, making `(R, fil^⋆_{q-Hdg})` an object of the
category of pairs (its reductions modulo `β` and after rationalisation are the Hodge and combined
filtrations, as recorded by `QHodgeFiltration`). -/
theorem trace_existence_body (H : HodgeContext K 𝒞) (TD : TraceData.{u, w} H)
    (hA : Λ.IsPerfectlyCovered) (hbase : ∀ ℓ : Nat.Primes, Nonempty (TD.baseTCp ℓ))
    (CT : ∀ p : Nat.Primes, CotangentTheory A p) (R : CommAlgCat.{u} A)
    (hlci : ∀ ℓ : Nat.Primes, IsPQuasiLci (CT ℓ) R)
    (hbdd : ∀ ℓ : Nat.Primes, ∃ N : ℕ, ∀ (x : R) (k : ℕ), (ℓ : R) ^ k * x = 0 → (ℓ : R) ^ N * x = 0)
    (hE : ∀ ℓ : Nat.Primes, Nonempty (TD.condE2 ℓ R) ∨ Nonempty (TD.condE1 ℓ R))
    (hR2 : Nonempty (TD.condE1 ⟨2, Nat.prime_two⟩ R)) :
    Nonempty ((FilModule.complete (TD.traceFilBody R).fil).fil ≅ TD.evenFilBody R) := by
  sorry

/-- **Owner: PrismaticCohomology PR.1.** The free p-complete perfect δ-ring `ℤ_p{x}_∞` on `x`. -/
structure FreePerfectDeltaRing (p : ℕ) where
  Ainf : Type u
  [ring : CommRing Ainf]
  delta : PerfectlyCoveredDelta p Ainf
  frob_bijective : Function.Bijective delta.frob
  x : Ainf

attribute [instance] FreePerfectDeltaRing.ring

/-- **Comparison (HQ.5-trace/a-lift-over-connective-complex-k-theory-is-not-enough).** The `E₁`
version over `ku` is false: for `R = ℤ_p{x}_∞/x` the perfect δ-ring lifts to the sphere, so
`ku_R = ku_{ℤ_p{x}_∞}/x` is an `E₁`-`ku`-algebra (Angeltveit), but the naive filtration (Theorem
4.17 of the ku paper) is not a q-deformation of the Hodge filtration. The `E₂` version over `ku` is
open (the source doubts it); the image-of-J expectation is not stated. -/
theorem ku_lift_not_enough (H : HodgeContext K 𝒞) (TD : TraceData.{u, w} H) (p : Nat.Primes)
    (Fp : FreePerfectDeltaRing.{u} p) [Algebra A Fp.Ainf] (R : CommAlgCat.{u} A)
    (e : R ≃ₐ[A] Fp.Ainf ⧸ Ideal.span {Fp.x}) (D : StaticQuasiRegular A R p) :
    Nonempty (TD.E1KuLift p R) ∧ ¬ ∀ n, (naiveFiltration D n).map D.proj = D.hodge n := by
  sorry

/-- **Theorem (HQ.5-trace/the-one-disc-refinement-and-the-prime-two, ku paper Theorems 4.8, 4.14,
4.17).** In the IDENTITY-cover case (`R` p-torsion free, `R/p` relatively semiperfect and a
p-complete connective `E₁`-lift of `R` itself; `p = 2` allowed), the p-complete trace-theoretic
q-Hodge filtration is the naive filtration (the 1-categorical preimage of the combined filtration);
in particular it does not depend on the chosen `E₁`-lift. For a general cover only the limit
description over the Čech nerve is available (not stated); the removability of `2 ∈ R^×` is an
expectation (not stated). -/
theorem E1_refinement_identityCover (H : HodgeContext K 𝒞) (TD : TraceData.{u, w} H) (p : Nat.Primes)
    (R : CommAlgCat.{u} A) (htf : IsSMulRegular R (p : R)) (hsp : IsRelSemiperfect A R p (Λ.psi p))
    (D : StaticQuasiRegular A R p) (L L' : TD.E1Lift p R) :
    (∀ n, TD.traceFilStatic p R L D n = naiveFiltration D n) ∧
      TD.traceFilStatic p R L D = TD.traceFilStatic p R L' D := by
  sorry

/-- **Owners: RefinedTraceMethods RT.4:Habiro-comparison and HabiroRings HR.5.** For a number field
`F` and `Δ`: the Habiro ring `H_{O_F[1/Δ]}` and the ring
`π_0(lim_m THH(KU ⊗ S_{O_F[1/Δ]}/KU)^{C_m h(S¹/C_m)})`. -/
structure NumberFieldHabiro (F : Type) [Field F] [NumberField F] (Δ : ℤ) where
  habiroRing : Type
  [ring₁ : CommRing habiroRing]
  kuRing : Type
  [ring₂ : CommRing kuRing]

attribute [instance] NumberFieldHabiro.ring₁ NumberFieldHabiro.ring₂

/-- **Comparison (HQ.5-trace/the-number-field-ring-from-periodic-complex-k-theory), an import
boundary (ku paper Corollary 6.15, owned by RT.4:Habiro-comparison).** For `Δ` divisible by `6` and
by the discriminant of `F`, `H_{O_F[1/Δ]} ≅ π_0(lim_m THH(KU ⊗ S_{O_F[1/Δ]}/KU)^{C_m h(S¹/C_m)})`.
This roadmap proves nothing about it; its proof cites "Corollary 3.12", which is Corollary 3.13
(source issue E304). -/
theorem numberField_KU_citation (F : Type) [Field F] [NumberField F] (Δ : ℤ)
    (NF : NumberFieldHabiro F Δ) (h6 : (6 : ℤ) ∣ Δ) (hd : NumberField.discr F ∣ Δ) :
    Nonempty (NF.habiroRing ≃+* NF.kuRing) := by
  sorry

/-- **Theorem (HQ.5-trace/the-spherical-e1-lift-case-of-the-well-behavedness-theorem, Theorem
4.22(b)).** If `R_∞ = (R ⊗_A A_∞)^∧_p` (the base change to the perfection, not `R` itself) admits a
p-complete connective `E₁`-lift, the naive filtration is a q-deformation of the Hodge filtration (an
existence condition only). For `p > 2` a presentation by higher powers yields such a lift (so (a)
implies (b)); at `p = 2` only when every exponent is even and at least `4`, so case (a) at `p = 2`
is not subsumed. -/
theorem deforms_of_E1Lift (H : HodgeContext K 𝒞) (TD : TraceData.{u, w} H) (p : Nat.Primes)
    (PA : PerfectlyCoveredDelta p A) (CT : CotangentTheory A p) (R : CommAlgCat.{u} A)
    (hR : IsSMulRegular R (p : R)) (hlci : IsPQuasiLci CT R) (hsp : IsRelSemiperfect A R p PA.frob)
    (D : StaticQuasiRegular A R p) :
    (Nonempty (TD.E1LiftPerf p R) → ∀ n, (naiveFiltration D n).map D.proj = D.hodge n) ∧
    (2 < (p : ℕ) → ∀ P : PerfectRegularPresentation A R p PA.frob,
      (∃ (x : Fin P.r → P.B) (α : Fin P.r → ℕ), (∀ i, 2 ≤ α i) ∧ ∀ i, P.f i = x i ^ α i) →
        Nonempty (TD.E1LiftPerf p R)) ∧
    ((p : ℕ) = 2 → ∀ P : PerfectRegularPresentation A R p PA.frob,
      (∃ (x : Fin P.r → P.B) (α : Fin P.r → ℕ), (∀ i, 4 ≤ α i ∧ Even (α i)) ∧ ∀ i, P.f i = x i ^ α i) →
        Nonempty (TD.E1LiftPerf p R)) := by
  sorry

/-- The example of Theorem 4.22(b): for `A = ℤ_p[x]^∧_p` with `δ(x) = 0` and `R = A/(x - 1) ≅ ℤ_p`,
condition (b) holds (even with an `E∞`-lift) but (a) does not: `R` has no perfect-regular
presentation by higher powers. -/
theorem deforms_of_E1Lift_example (H : HodgeContext K 𝒞) (TD : TraceData.{u, w} H) (p : Nat.Primes)
    (PA : PerfectlyCoveredDelta p A) (x : A) (hx : PA.delta.δ x = 0) (R : CommAlgCat.{u} A)
    (e : R ≃ₐ[A] A ⧸ Ideal.span {x - 1}) :
    Nonempty (TD.E1LiftPerf p R) ∧ ¬ ∃ P : PerfectRegularPresentation A R p PA.frob,
      ∃ (y : Fin P.r → P.B) (α : Fin P.r → ℕ), (∀ i, 2 ≤ α i) ∧ ∀ i, P.f i = y i ^ α i := by
  sorry

end HQ5trace

/-! ## HQ.6 — The algebraic against the analytic theory -/

section HQ6

open AlgebraicGeometry

variable {Λℤ : LambdaRing ℤ} {Ani 𝒟 ℰ Mod : Type*} [Category Ani] [Category 𝒟] [Category ℰ]
  [Category Mod] [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ] [HasPullbacks 𝒟]
  {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear ℤ[X] 𝒞] [HasFiniteColimits 𝒞]
  [HasZeroObject 𝒞] [HasColimitsOfShape ℕ 𝒞] [HasLimitsOfShape ℕᵒᵖ 𝒞]
  {K : QDeRhamContext ℤ Λℤ Ani 𝒟 ℰ Mod} {H : HodgeContext K 𝒞}

/-- **Owner: AnalyticHabiroStack HS.3 (a draft roadmap, not in the atlas; its source is a lecture
course).** The analytic side: modules over the analytic Habiro ring `H^an` (after the coefficient
change), the analytic Habiro cohomology `RΓ(X^Hab, O)`, the base changes of both sides to a
completed localisation of `H^an`, the ring-level objects `Spf H_{O_F[1/Δ]}` and
`(Spec O_F[1/Δ])^Hab`, and the specialisation of the analytic stack at a root of unity with
Grothendieck's infinitesimal cohomology. -/
structure AnalyticHabiroData (𝒞 : Type*) [Category 𝒞] where
  𝒜 : Type w
  [cat : Category.{w'} 𝒜]
  [pre : Preadditive 𝒜]
  [lin : Linear ℤ[X] 𝒜]
  RΓan : Scheme.{0} → 𝒜
  bcAlg : 𝒞 ⥤ 𝒜
  bcAn : 𝒜 ⥤ 𝒜
  spfHabiro : ∀ (R : Type) [CommRing R], 𝒜
  habStack : ∀ (R : Type) [CommRing R], 𝒜
  specialise : ℕ+ → 𝒜 ⥤ 𝒜
  infinitesimal : Scheme.{0} → ℕ+ → 𝒜

attribute [instance] AnalyticHabiroData.cat AnalyticHabiroData.pre AnalyticHabiroData.lin

/-- API `TauCeti.QHodge.analyticComparisonProblem.domain`: the class of `X` on which both sides are
defined: smooth over `ℤ` with the primes `p ≤ dim(X/ℤ)` invertible. -/
def analyticComparisonProblem.domain (Y : Scheme.{0}) : Prop := SmallPrimesInverted Y

/-- API `TauCeti.QHodge.analyticComparisonProblem.coefficients`: the coefficient change, the base
change of both sides to a completed localisation of `H^an`, named by the analytic owner. -/
def analyticComparisonProblem.coefficients (An : AnalyticHabiroData.{w, w'} 𝒞) :
    (𝒞 ⥤ An.𝒜) × (An.𝒜 ⥤ An.𝒜) :=
  (An.bcAlg, An.bcAn)

/-- API `TauCeti.QHodge.analyticComparisonProblem.transformation`: the type of the comparisons to be
constructed, at the level of complexes (the ring and line-bundle levels are the analytic owner's). -/
def analyticComparisonProblem.transformation (Hs : HabiroSheafData.{w, w'} 𝒞) (T : QWittContext K H)
    (An : AnalyticHabiroData.{w, w'} 𝒞) : Type _ :=
  ∀ (Y : Scheme.{0}) (hY : analyticComparisonProblem.domain Y),
    An.bcAlg.obj ((Hs.RΓ Y).obj (algebraicHabiroCohomology Hs T Y hY)) ⟶ An.bcAn.obj (An.RΓan Y)

/-- **Definition (HQ.6/the-algebraic-against-analytic-comparison-problem).** The problem, as a
statement to be proved or refuted (never a hypothesis here): a comparison, after the coefficient
change, which is an equivalence. The source expects it; an equivalence after the lossy base change
is not an equivalence of the theories. -/
def analyticComparisonProblem.statement (Hs : HabiroSheafData.{w, w'} 𝒞) (T : QWittContext K H)
    (An : AnalyticHabiroData.{w, w'} 𝒞) : Prop :=
  ∃ τ : analyticComparisonProblem.transformation Hs T An, ∀ Y hY, IsIso (τ Y hY)

/-- API `TauCeti.QHodge.analyticComparisonProblem.lossy`: the base change is not conservative on
either side. -/
theorem analyticComparisonProblem.lossy (An : AnalyticHabiroData.{w, w'} 𝒞) :
    ¬ An.bcAlg.ReflectsIsomorphisms ∧ ¬ An.bcAn.ReflectsIsomorphisms := by
  sorry

/-- API `TauCeti.QHodge.analyticComparisonProblem.unused`: the declarations of this file that take
`analyticComparisonProblem.statement` as a hypothesis: none. This is bookkeeping, checkable by
reading the file, not a mathematical statement. -/
def analyticComparisonProblem.unused : List String := []

/-- The nodes that list the problem among their prerequisites, each to record a boundary. -/
def analyticComparisonProblem.consumers : List String :=
  ["HQ.6/the-three-recorded-differences", "HQ.6/what-may-not-be-inferred-from-the-analytic-side",
    "HQ.7/the-acceptance-tests"]

/-- Unit test `TauCeti.QHodge.analyticComparisonProblem.dim_zero_mismatch`: already for
`X = Spec O_F[1/Δ]` (here: `R` étale over `ℤ`), `Spf H_{O_F[1/Δ]}` does not precisely match
`(Spec O_F[1/Δ])^Hab`: a formulation asserting an equivalence before the completed localisation
fails. -/
example (An : AnalyticHabiroData.{w, w'} 𝒞) (R : Type) [CommRing R] [Algebra.Etale ℤ R] :
    ¬ Nonempty (An.spfHabiro R ≅ An.habStack R) := by
  sorry

/-- Unit test `TauCeti.QHodge.analyticComparisonProblem.domain_small_primes`: for `X` of relative
dimension `d` without the primes `p ≤ d` inverted (for example `𝔸²_ℤ`), the algebraic side is not
defined and the problem does not arise. -/
example : ¬ analyticComparisonProblem.domain (Spec (CommRingCat.of (MvPolynomial (Fin 2) ℤ))) := by
  sorry

/-- Unit test `TauCeti.QHodge.analyticComparisonProblem.small_primes_lost`: for `X` over `ℤ[1/N]`,
the algebraic side has every prime `p ≤ dim X` inverted, the analytic side does not; a comparison
must invert those primes on the analytic side, as part of the completed localisation. -/
example (Hs : HabiroSheafData.{w, w'} 𝒞) (T : QWittContext K H) (An : AnalyticHabiroData.{w, w'} 𝒞)
    (Y : Scheme.{0}) (d : ℕ) (hd : SmoothOfRelativeDimension d (specZIsTerminal.from Y))
    (hp : ∀ p : ℕ, p.Prime → p ≤ d → IsUnit (p : Γ(Y, ⊤))) (p : ℕ) (hpp : p.Prime) (hpd : p ≤ d) :
    IsIso ((p : ℤ[X]) • 𝟙 ((Hs.RΓ Y).obj (algebraicHabiroCohomology Hs T Y ⟨d, hd, hp⟩))) ∧
      ¬ IsIso ((p : ℤ[X]) • 𝟙 (An.RΓan Y)) := by
  sorry

/-- Unit test `TauCeti.QHodge.analyticComparisonProblem.consumers`: within the packet only the other
two HQ.6 nodes and the acceptance suite list the problem among their prerequisites, each to record a
boundary, and no declaration takes it as a hypothesis (bookkeeping). -/
example : analyticComparisonProblem.consumers.length = 3 ∧ analyticComparisonProblem.unused = [] :=
  ⟨rfl, rfl⟩

/-- **Comparison (HQ.6/the-three-recorded-differences).** (1) Small primes: the algebraic theory of
a smooth scheme inverts the primes `p ≤ dim`; the analytic one does not. (2) Roots of unity: modulo
`q^m - 1` the algebraic theory has the q-de Rham–Witt filtration (Theorem 3.11(b)); the analytic
stack specialises to the de Rham stack, with Grothendieck's infinitesimal cohomology. (3) The source
does not expect an `E∞`-structure on the Habiro–Hodge complex of a smooth scheme; this is an
expectation, not stated. -/
theorem three_differences [HasShift 𝒞 ℤ] (Hs : HabiroSheafData.{w, w'} 𝒞) (T : QWittContext K H)
    (An : AnalyticHabiroData.{w, w'} 𝒞) (Y : Scheme.{0}) (d : ℕ)
    (hd : SmoothOfRelativeDimension d (specZIsTerminal.from Y))
    (hp : ∀ p : ℕ, p.Prime → p ≤ d → IsUnit (p : Γ(Y, ⊤))) (m : ℕ+) :
    (∀ p : ℕ, p.Prime → p ≤ d →
      IsIso ((p : ℤ[X]) • 𝟙 ((Hs.RΓ Y).obj (algebraicHabiroCohomology Hs T Y ⟨d, hd, hp⟩)))) ∧
    (∃ G : ℕ ⥤ 𝒞, Nonempty (colimit G ≅ quotBy ((X : ℤ[X]) ^ (m : ℕ) - 1)
        ((Hs.RΓ Y).obj (algebraicHabiroCohomology Hs T Y ⟨d, hd, hp⟩))) ∧
      ∀ i : ℕ, Nonempty (cokernel (G.map (homOfLE (Nat.le_succ i))) ≅
        (shiftFunctor 𝒞 (-((i + 1 : ℕ) : ℤ))).obj (Hs.RΓWitt Y m (i + 1)))) ∧
    Nonempty ((An.specialise m).obj (An.RΓan Y) ≅ An.infinitesimal Y m) := by
  sorry

/-- **Comparison (HQ.6/what-may-not-be-inferred-from-the-analytic-side).** The condensed and
analytic-stack machinery supplies a language for the comparison problem, not a proof; no six-functor
formalism enters an algebraic statement here, and the expected comparison is not a hypothesis of any
statement. The only condensed statement used is HabiroRings HR.2's Lemma B.8: the solid tensor
product preserves bounded-below Habiro-complete objects. -/
theorem solid_tensor_habiroComplete (Hb : HabiroData H) (Hc : CohomologyData (A := ℤ) 𝒞)
    (solidTensor : 𝒞 → 𝒞 → 𝒞) (M N : 𝒞) (hM : Hb.IsHabiroComplete M) (hN : Hb.IsHabiroComplete N)
    (hMb : ∃ n : ℤ, ∀ i < n, Subsingleton ((Hc.Hn i).obj M))
    (hNb : ∃ n : ℤ, ∀ i < n, Subsingleton ((Hc.Hn i).obj N)) :
    Hb.IsHabiroComplete (solidTensor M N) := by
  sorry

end HQ6

/-! ## HQ.7 — Acceptance tests and the executable boundary

Node HQ.7/the-executable-boundary describes the executable layer below (the q-integers, the Jackson
operator and the q-Hodge differential, stated and mostly proved against the pinned Mathlib), and
says that everything above it is left out of the file. This file departs from that sentence as the
review requires: the objects above the executable layer are modelled by owner parameter structures
(named in their docstrings), with statements proved by `sorry`; no axiom, placeholder type or
proposition, or trivially true statement occurs. -/

section HQ7

/-! ### The executable layer (node HQ.7/the-executable-boundary) -/

section Executable

variable {A : Type u} [CommRing A]

/-- **Application (HQ.7/the-executable-boundary).** The executable layer, bundled: `[0]_q = 0`,
`[1]_q = 1`, `[n]_q (q - 1) = q^n - 1`, `[n]_1 = n`, `[p]_q = Φ_p(q)`; the Jackson operator
`x^n ↦ [n]_q x^{n-1}` (defined by these values), its twisted Leibniz rule and its value `d/dx` at
`q = 1`; the q-Hodge differential `x^n ↦ (q^n - 1) x^{n-1}` and its vanishing at `q = 1`. -/
theorem executable_layer (q : A) (n p : ℕ) (hp : p.Prime) (f g : A[X]) :
    qInt 0 q = 0 ∧ qInt 1 q = 1 ∧ qInt n q * (q - 1) = q ^ n - 1 ∧ qInt n (1 : A) = n ∧
    qInt p (X : A[X]) = cyclotomic p A ∧
    qDiff q ((X : A[X]) ^ n) = C (qInt n q) * X ^ (n - 1) ∧
    qDiff q (f * g) = qDiff q f * g.comp (C q * X) + f * qDiff q g ∧
    qDiff (1 : A) f = derivative f ∧
    qHodgeDiff q ((X : A[X]) ^ n) = C (q ^ n - 1) * X ^ (n - 1) ∧ qHodgeDiff (1 : A) f = 0 :=
  ⟨qInt_zero q, qInt_one q, qInt_mul_sub_one n q, qInt_at_one n, qInt_prime_eq_cyclotomic p hp,
    qDiff_X_pow q n, qDiff_mul q f g, qDiff_at_one f, qHodgeDiff_X_pow q n, qHodgeDiff_at_one f⟩

/-- **Acceptance test (2) (HQ.7/the-acceptance-tests).** The q-integer differential
`x^m ↦ [m]_q x^{m-1} dx` at `q = 1`: `[m]_1 = m` and the complex becomes the de Rham complex
`x^m ↦ m x^{m-1} dx`; over the q-de Rham prism `(ℤ_p⟦q-1⟧, [p]_q)` the prism generator `[p]_q`
specialises to `p` at `q = 1`, while the q-PD generator `q - 1` specialises to `0`. -/
theorem acceptance_qDiff_at_one (m p : ℕ) (hp : p.Prime) :
    qDiff (1 : A) ((X : A[X]) ^ m) = C (m : A) * X ^ (m - 1) ∧ qInt m (1 : A) = m ∧
      (qInt p (X : A[X])).eval 1 = p ∧ ((X : A[X]) - 1).eval 1 = 0 := by
  refine ⟨?_, qInt_at_one m, qInt_prime_eval_one p hp⟩
  rw [qDiff_at_one, derivative_X_pow]

/-- **Structural check (a) (HQ.7/the-acceptance-tests).** The q-Hodge complex of `A[x]` has
differential `x^m ↦ (q^m - 1) x^{m-1} dx`, the q-de Rham complex `x^m ↦ [m]_q x^{m-1} dx`: a
filtered object differs from its colimit modification. -/
theorem structural_qHodge_vs_qDeRham (q : A) (m : ℕ) :
    qHodgeDiff q ((X : A[X]) ^ m) = C (q ^ m - 1) * X ^ (m - 1) ∧
      qDiff q ((X : A[X]) ^ m) = C (qInt m q) * X ^ (m - 1) :=
  ⟨qHodgeDiff_X_pow q m, qDiff_X_pow q m⟩

/-- The witness of structural check (a): over `ℤ[q]`, on `x` the two differentials are `q - 1` and
`1`. -/
example : qHodgeDiff (X : ℤ[X]) (X : ℤ[X][X]) ≠ qDiff (X : ℤ[X]) (X : ℤ[X][X]) := by
  have h1 := qHodgeDiff_X_pow (X : ℤ[X]) 1
  have h2 := qDiff_X_pow (X : ℤ[X]) 1
  simp only [pow_one, qInt_one] at h1 h2
  rw [h1, h2]
  intro h
  have := congrArg (fun f : ℤ[X][X] => (f.coeff 0).eval 0) h
  simp at this

/-- **Structural check (b) (HQ.7/the-acceptance-tests): derived torsion corrections are kept.**
In the polynomial model `ℤ[q][x] → ℤ[q][x] dx` of the q-Hodge complex `M` of `ℤ[x]` (before the
`(q-1)`-completion): `H^0(M)` is the constants, so `H^0(M)/(q-1) = ℤ`, while the reduced
differential vanishes, so `H^0(M/^L(q-1)) = ℤ[x]`; the difference is the `(q-1)`-torsion of
`H^1(M)`, generated by the classes `[m]_q x^{m-1} dx`: `(q-1)` times such a class is a coboundary,
the class itself is not. -/
theorem structural_torsion (m : ℕ) (hm : 1 ≤ m) :
    (∀ f : ℤ[X][X], qHodgeDiff (X : ℤ[X]) f = 0 ↔ ∃ a, f = C a) ∧
    (∀ f : ℤ[X], qHodgeDiff (1 : ℤ) f = 0) ∧
    C ((X : ℤ[X]) - 1) * (C (qInt m (X : ℤ[X])) * X ^ (m - 1)) = qHodgeDiff (X : ℤ[X]) (X ^ m) ∧
    ¬ ∃ f : ℤ[X][X], qHodgeDiff (X : ℤ[X]) f = C (qInt m (X : ℤ[X])) * X ^ (m - 1) := by
  refine ⟨?_, qHodgeDiff_at_one, ?_, ?_⟩
  · sorry
  · rw [qHodgeDiff_X_pow, ← qInt_mul_sub_one, C_mul]
    ring
  · sorry

/-- **Structural check (c) (HQ.7/the-acceptance-tests): tensor powers leave the smooth existence
category.** `ℤ[x]` lies in `Sm_{ℤ[dim!^{-1}]}` but `ℤ[x] ⊗ ℤ[x] = ℤ[x, y]` does not, and the
multiplication of `ℤ[x]` is not admissible; that of `ℤ[1/2][x]` is. -/
theorem structural_tensorPowers :
    SmoothDimInv Zx ∧ ¬ SmoothDimInv (tensorList [Zx, Zx]) ∧
      ¬ SmoothDimInv.admissible [Zx, Zx] [Zx] (fun _ => some 0) ∧
      SmoothDimInv.admissible [ZHalfx, ZHalfx] [ZHalfx] (fun _ => some 0) := by
  sorry

/-- The derivation `d/dx` on `A[x, x⁻¹]`: `T n ↦ n T (n - 1)`. -/
def laurentDeriv (f : LaurentPolynomial A) : LaurentPolynomial A :=
  f.coeff.sum fun n a => LaurentPolynomial.C (a * n) * LaurentPolynomial.T (n - 1)

end Executable

section Acceptance

variable {A : Type u} [CommRing A] {Λ : LambdaRing A} {Ani 𝒟 ℰ Mod : Type*} [Category Ani]
  [Category 𝒟] [Category ℰ] [Category Mod] [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ]
  [HasPullbacks 𝒟] {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear A[X] 𝒞]
  [HasFiniteColimits 𝒞] [HasZeroObject 𝒞] {K : QDeRhamContext A Λ Ani 𝒟 ℰ Mod}

/-- `A[x]` lies in `Sm_{A[dim!^{-1}]}` with no prime inverted: its relative dimension is one and no
prime is `≤ 1`. -/
theorem polynomial_smoothDimInv : SmoothDimInvObj A (SmoothAlg.of (MvPolynomial (Fin 1) A)) :=
  ⟨1, sorry, fun _ hp hle => absurd hp.two_le (by omega)⟩

/-- **Acceptance test (1) (HQ.7/the-acceptance-tests).** For `A[x]` the canonical q-Hodge filtration
exists with no prime inverted and is the coordinate filtration: `(q-1)^i A[x]⟦q-1⟧ →
(q-1)^{i-1} A[x]⟦q-1⟧ dx` in degree `i`; at `q = 1` it reduces to the Hodge filtration (the clause
`QHodgeFiltration.modQSubOneEquiv`), and its q-Hodge complex is the coordinate q-Hodge complex. -/
theorem acceptance_polynomial [HasColimitsOfShape ℕ 𝒞] (hA : Λ.IsPerfectlyCovered)
    (H : HodgeContext K 𝒞) :
    Nonempty ((canonicalSection H).obj ⟨SmoothAlg.of (MvPolynomial (Fin 1) A), polynomial_smoothDimInv⟩ ≅
      framedPair H (EtaleFraming.polyId A 1)) ∧
    (∀ n : ℕ, Nonempty ((coordinateFiltration H (EtaleFraming.polyId A 1)).fil.fil.obj (op n) ≅
      H.koszulSub (qOmegaFramed.qPartial (EtaleFraming.polyId A 1))
        (coordinateStep (MvPolynomial (Fin 1) A) 1 n))) ∧
    Nonempty (qHodge H (framedPair H (EtaleFraming.polyId A 1)) ≅
      H.ofMod.obj (K.koszul (qHodgeFramedOp (EtaleFraming.polyId A 1)))) := by
  sorry

/-- **Structural check (d) (HQ.7/the-acceptance-tests, Remark 3.6): Hodge-completed against
uncompleted.** For `ℚ[x^{±1}]` the underived de Rham complex has `H^1 = ℚ · dx/x` (`x^{-1}` is not a
derivative, every other `x^n` is), while the uncompleted derived de Rham complex over `ℚ` is `ℚ`; so
`qdR` and `qΩ` differ on smooth inputs, and only the Hodge completion recovers `Ω`. -/
theorem structural_laurent {Λℚ : LambdaRing ℚ} (Kq : QDeRhamContext ℚ Λℚ Ani 𝒟 ℰ Mod) :
    (∀ f : LaurentPolynomial ℚ, laurentDeriv f ≠ LaurentPolynomial.T (-1)) ∧
    (∀ n : ℤ, n ≠ -1 → ∃ f : LaurentPolynomial ℚ, laurentDeriv f = LaurentPolynomial.T n) ∧
    Nonempty ((qdR Kq).obj (Kq.ofSmooth.obj (SmoothAlg.of (LaurentPolynomial ℚ))) ≅ Kq.one) ∧
    ¬ Nonempty ((qdR Kq).obj (Kq.ofSmooth.obj (SmoothAlg.of (LaurentPolynomial ℚ))) ≅
      (qOmega Kq).obj (SmoothAlg.of (LaurentPolynomial ℚ))) := by
  sorry

end Acceptance

section AcceptanceZ

open AlgebraicGeometry

variable {Λℤ : LambdaRing ℤ} {Ani 𝒟 ℰ Mod : Type*} [Category Ani] [Category 𝒟] [Category ℰ]
  [Category Mod] [HasProducts.{0} 𝒟] [HasProducts.{0} ℰ] [HasPullbacks 𝒟]
  {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [Linear ℤ[X] 𝒞] [HasFiniteColimits 𝒞]
  [HasZeroObject 𝒞] [HasColimitsOfShape ℕ 𝒞] [HasLimitsOfShape ℕᵒᵖ 𝒞]
  {K : QDeRhamContext ℤ Λℤ Ani 𝒟 ℰ Mod} {H : HodgeContext K 𝒞}

/-- **Acceptance test (3) (HQ.7/the-acceptance-tests).** For a number field `F`, `Δ` divisible by
its discriminant and `R = O_F[1/Δ]` (étale over `ℤ[1/Δ]`, hence over `ℤ`): `q-Hdg_{R/ℤ}` is the
relative Habiro ring `H_{R/ℤ}` (the Habiro ring of `F` of Garoufalidis–Scholze–Wheeler–Zagier), and
`q-Hdg_{R/ℤ}/(q^m - 1)` has cohomology `qW_m Ω_{R/ℤ}`, which is `qW_m(R/ℤ)` in degree `0`; `m = 1`
is the specialisation `q = 1`. -/
theorem acceptance_numberField (hA : Λℤ.IsPerfectlyCovered) (T : QWittContext K H)
    (Hc : CohomologyData (A := ℤ) 𝒞) (F : Type) [Field F] [NumberField F] (Δ : ℤ)
    (hd : NumberField.discr F ∣ Δ) (R : Type) [CommRing R] [Algebra.Etale ℤ R]
    (e : R ≃ₐ[ℤ] Localization.Away (Δ : NumberField.RingOfIntegers F)) (m : ℕ+) (n : ℕ) :
    Nonempty (qHabiroHodge T (etalePair H R) ≅ T.relHabiro.obj (SmoothAlg.of R)) ∧
    Nonempty ((Hc.Hn n).obj (quotBy ((X : ℤ[X]) ^ (m : ℕ) - 1) (qHabiroHodge T (etalePair H R))) ≃ₗ[ℤ[X]]
      ((qWittOmega (T.qWitt (SmoothAlg.of R))).P m).deg n) := by
  sorry

/-- **Acceptance test (4) (HQ.7/the-acceptance-tests).** For a smooth scheme `X` of relative
dimension `d` with every prime `p ≤ d` inverted, algebraic Habiro cohomology is defined and its
reduction modulo `q^m - 1` has the ascending filtration with `qW_m Ω^i` in degree `i`
(`algebraicHabiroCohomology_mod`). -/
theorem acceptance_scheme [HasShift 𝒞 ℤ] (Hs : HabiroSheafData.{w, w'} 𝒞) (T : QWittContext K H)
    (Y : Scheme.{0}) (d : ℕ) (hd : SmoothOfRelativeDimension d (specZIsTerminal.from Y))
    (hp : ∀ p : ℕ, p.Prime → p ≤ d → IsUnit (p : Γ(Y, ⊤))) (m : ℕ+) :
    ∃ G : ℕ ⥤ 𝒞, Nonempty (colimit G ≅ quotBy ((X : ℤ[X]) ^ (m : ℕ) - 1)
        ((Hs.RΓ Y).obj (algebraicHabiroCohomology Hs T Y ⟨d, hd, hp⟩))) ∧
      Nonempty (G.obj 0 ≅ Hs.RΓWitt Y m 0) ∧
      ∀ i : ℕ, Nonempty (cokernel (G.map (homOfLE (Nat.le_succ i))) ≅
        (shiftFunctor 𝒞 (-((i + 1 : ℕ) : ℤ))).obj (Hs.RΓWitt Y m (i + 1))) :=
  algebraicHabiroCohomology_mod Hs T Y ⟨d, hd, hp⟩ m

/-- **Acceptance test (5) (HQ.7/the-acceptance-tests).** For `R = ℤ[1/2][x]` with the explicit
`E∞`-lift `S_R = S[1/2][x]`, the trace-theoretic filtration of Theorem 1.2 is, by Raksit's Theorem
6.10 of the ku paper, the coordinate filtration (for the étale framing `ℤ[x] → ℤ[1/2][x]`), hence
agrees with the canonical smooth filtration of test (1). -/
theorem acceptance_trace [Algebra.Smooth ℤ ZHalfx] (TD : TraceData.{0, w} H) (L : TD.E2Lift ZHalfx)
    (F : EtaleFraming ℤ ZHalfx 1) (hS : SmoothDimInvObj ℤ (SmoothAlg.of ZHalfx)) :
    Nonempty ((TD.traceFil ZHalfx L).fil ≅ (coordinateFiltration H F).fil) ∧
      Nonempty ((TD.traceFil ZHalfx L).fil ≅ ((canonicalSection H).obj ⟨SmoothAlg.of ZHalfx, hS⟩).F.fil) := by
  sorry

end AcceptanceZ

