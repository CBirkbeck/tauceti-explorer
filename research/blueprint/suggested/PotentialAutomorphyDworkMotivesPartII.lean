open Polynomial

namespace TauCeti.Dwork

/-! ## Layer DM.0: linear algebra and finite linear groups -/

section PseudoReflection

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

/-- A pseudo-reflection is invertible and has rank-one displacement. -/
def _root_.LinearMap.IsPseudoReflection (g : Module.End K V) : Prop :=
  IsUnit g ∧ Module.finrank K (LinearMap.range (g - 1)) = 1

/-- `g` is a transvection: a pseudo-reflection with `(g - 1)² = 0`. -/
def _root_.LinearMap.IsTransvection (g : Module.End K V) : Prop :=
  LinearMap.IsPseudoReflection g ∧ (g - 1) * (g - 1) = 0

/-- A pseudo-reflection is `1 + v ⊗ φ` with `v ≠ 0`, `φ ≠ 0`; it is a transvection iff `φ v = 0`. -/
theorem _root_.LinearMap.IsPseudoReflection.exists_eq_one_add [FiniteDimensional K V] {g : Module.End K V}
    (hg : LinearMap.IsPseudoReflection g) :
    ∃ (v : V) (φ : Module.Dual K V), v ≠ 0 ∧ φ ≠ 0 ∧
      g = 1 + LinearMap.smulRight φ v ∧ (LinearMap.IsTransvection g ↔ φ v = 0) := by
  sorry

/-- The characteristic polynomial of a pseudo-reflection is `(X - 1)^(n-1) (X - det g)`. -/
theorem _root_.LinearMap.IsPseudoReflection.charpoly [FiniteDimensional K V] {g : Module.End K V}
    (hg : LinearMap.IsPseudoReflection g) :
    LinearMap.charpoly g =
      (X - 1) ^ (Module.finrank K V - 1) * (X - C (LinearMap.det g)) := by
  sorry

theorem _root_.LinearMap.IsTransvection.det [FiniteDimensional K V] {g : Module.End K V} (hg : LinearMap.IsTransvection g) :
    LinearMap.det g = 1 := by
  sorry

theorem _root_.LinearMap.IsPseudoReflection.conj {g : Module.End K V} (hg : LinearMap.IsPseudoReflection g)
    (e : V ≃ₗ[K] V) :
    LinearMap.IsPseudoReflection ((e : Module.End K V) * g * (e.symm : Module.End K V)) := by
  sorry

/-- Mathlib's elementary transvection matrices are transvections. -/
theorem _root_.Matrix.transvection_isTransvection {n : Type*} [Fintype n] [DecidableEq n] {i j : n}
    (hij : i ≠ j) {c : K} (hc : c ≠ 0) :
    LinearMap.IsTransvection (Matrix.toLin' (Matrix.transvection i j c)) := by
  sorry

/-- `SL_n(K)` is generated by transvections. -/
theorem _root_.Matrix.SpecialLinearGroup.closure_transvections (n : ℕ) :
    Subgroup.closure {g : Matrix.SpecialLinearGroup (Fin n) K |
      LinearMap.IsTransvection (Matrix.toLin' (g : Matrix (Fin n) (Fin n) K))} = ⊤ := by
  sorry

-- isPseudoReflection_diag
example : LinearMap.IsPseudoReflection (Matrix.toLin' (Matrix.diagonal ![(1 : ℚ), 2])) ∧
    ¬ LinearMap.IsTransvection (Matrix.toLin' (Matrix.diagonal ![(1 : ℚ), 2])) := by
  sorry

-- A singular rank-one displacement is excluded.
example : ¬ LinearMap.IsPseudoReflection
    (Matrix.toLin' (Matrix.diagonal ![(0 : ℚ), 1])) := by
  sorry

-- not_isPseudoReflection_one
example (n : ℕ) : ¬ LinearMap.IsPseudoReflection (1 : Module.End K (Fin n → K)) := by
  sorry

-- not_isPseudoReflection_neg_one
example : ¬ LinearMap.IsPseudoReflection (Matrix.toLin' (-1 : Matrix (Fin 2) (Fin 2) ℚ)) := by
  sorry

-- not_isTransvection_unipotent_rank_two
example : ¬ LinearMap.IsTransvection
    (Matrix.toLin' (!![1, 1, 0; 0, 1, 1; 0, 0, 1] : Matrix (Fin 3) (Fin 3) ℚ)) := by
  sorry

end PseudoReflection

section Companion

variable {R : Type*} [CommRing R]

/-- The companion matrix of `p`: ones on the subdiagonal and last column `-(coefficients of p)`.
This is a stand-in, with the same convention, for `Polynomial.companion` of the roadmap
ClassicalArithmeticCompletion (layer CA.2), which owns the notion. -/
def companion (p : R[X]) : Matrix (Fin p.natDegree) (Fin p.natDegree) R :=
  Matrix.of fun i j =>
    if (j : ℕ) + 1 = p.natDegree then -p.coeff i else if (i : ℕ) = j + 1 then 1 else 0

/-- For monic `p ≠ q` of the same degree with `p(0) ≠ 0`, `C(q) C(p)⁻¹ - 1` has rank one
(DM.0/companion-normal-form (3)). -/
theorem rank_companion_mul_inv_sub_one {K : Type*} [Field K] {n : ℕ} {p q : K[X]}
    (hp : p.Monic) (hq : q.Monic) (hpn : p.natDegree = n) (hqn : q.natDegree = n)
    (hn : 1 ≤ n) (h0 : p.coeff 0 ≠ 0) (hpq : p ≠ q) :
    Matrix.rank ((companion q).submatrix (Fin.cast hqn.symm) (Fin.cast hqn.symm) *
        ((companion p).submatrix (Fin.cast hpn.symm) (Fin.cast hpn.symm))⁻¹ -
          (1 : Matrix (Fin n) (Fin n) K)) = 1 := by
  sorry

-- Check of DM.0/companion-normal-form: the companion matrix of X² − 3X + 2
example : companion (X ^ 2 - C (3 : ℚ) * X + C 2) =
    (Matrix.of ![![0, -2], ![1, 3]]).submatrix (Fin.cast (by sorry)) (Fin.cast (by sorry)) := by
  sorry

end Companion

section Hypergeometric

variable {K : Type*} [Field K] {n : ℕ}

/-- Levelt's rigidity theorem (DM.0/levelt-rigidity): a triple `h₀ h₁ h_∞ = 1` with `h₁` a
pseudo-reflection and `h_∞`, `h₀⁻¹` of prescribed characteristic polynomials without common root is
conjugate to the companion triple. -/
theorem _root_.Matrix.levelt_rigidity {p q : K[X]} (hp : p.Monic) (hq : q.Monic) (hpn : p.natDegree = n)
    (hqn : q.natDegree = n) (hcop : IsCoprime p q) (h₀ h_inf : GL (Fin n) K)
    (hinf : (h_inf : Matrix (Fin n) (Fin n) K).charpoly = p)
    (h0 : ((h₀⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K).charpoly = q)
    (h1 : LinearMap.IsPseudoReflection
      (Matrix.toLin' (((h₀⁻¹ * h_inf⁻¹ : GL (Fin n) K)) : Matrix (Fin n) (Fin n) K))) :
    ∃ g : GL (Fin n) K,
      ((g * h_inf * g⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) =
          (companion p).submatrix (Fin.cast hpn.symm) (Fin.cast hpn.symm) ∧
      ((g * h₀⁻¹ * g⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) =
          (companion q).submatrix (Fin.cast hqn.symm) (Fin.cast hqn.symm) := by
  sorry

/-- Irreducibility of hypergeometric groups (DM.0/hypergeometric-group-irreducible): if `h₀ h₁ h_∞ = 1`
with `h₁` a pseudo-reflection and `h_∞`, `h₀⁻¹` have no common eigenvalue over `K̄`, then no proper
nonzero `K̄`-subspace is stable under both. -/
theorem _root_.Matrix.hypergeometric_group_irreducible (h₀ h_inf : GL (Fin n) K)
    (h1 : LinearMap.IsPseudoReflection
      (Matrix.toLin' (((h₀⁻¹ * h_inf⁻¹ : GL (Fin n) K)) : Matrix (Fin n) (Fin n) K)))
    (hcop : IsCoprime (h_inf : Matrix (Fin n) (Fin n) K).charpoly
      ((h₀⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K).charpoly)
    (W : Submodule (AlgebraicClosure K) (Fin n → AlgebraicClosure K))
    (hW0 : ∀ w ∈ W, ((h₀ : Matrix (Fin n) (Fin n) K).map (algebraMap K _)).mulVec w ∈ W)
    (hWinf : ∀ w ∈ W, ((h_inf : Matrix (Fin n) (Fin n) K).map (algebraMap K _)).mulVec w ∈ W) :
    W = ⊥ ∨ W = ⊤ := by
  sorry

end Hypergeometric

section Unitary

variable {ℓ : Type*} [Field ℓ] (c : ℓ ≃+* ℓ) {n : Type*} [Fintype n] [DecidableEq n]

/-- `M† = (M^c)ᵀ` for the automorphism `c`. -/
def _root_.Matrix.adjointConj (M : Matrix n n ℓ) : Matrix n n ℓ := (M.map c).transpose

/-- `M ∈ GU_n(ℓ)` with multiplier `a`: `M† M = a` with `a` a nonzero `c`-fixed scalar. -/
def _root_.Matrix.IsGeneralUnitaryWith (M : Matrix n n ℓ) (a : ℓ) : Prop :=
  a ≠ 0 ∧ c a = a ∧ Matrix.adjointConj c M * M = Matrix.scalar n a

/-- Compatibility with the existing matrix star; `U` and `SU` retain Mathlib's carriers. -/
theorem _root_.Matrix.adjointConj_eq_star [StarRing ℓ] (hc : ∀ a, c a = star a)
    (M : Matrix n n ℓ) : Matrix.adjointConj c M = star M := by
  sorry

/-- A nonzero-dimensional general unitary matrix has a unique multiplier. -/
theorem _root_.Matrix.IsGeneralUnitaryWith.multiplier_unique [Nonempty n]
    {M : Matrix n n ℓ} {a b : ℓ}
    (ha : Matrix.IsGeneralUnitaryWith c M a) (hb : Matrix.IsGeneralUnitaryWith c M b) :
    a = b := by
  sorry

theorem _root_.Matrix.adjointConj_mul (A B : Matrix n n ℓ) :
    Matrix.adjointConj c (A * B) = Matrix.adjointConj c B * Matrix.adjointConj c A := by
  sorry

theorem _root_.Matrix.IsGeneralUnitaryWith.norm_det {M : Matrix n n ℓ} {a : ℓ} (h : Matrix.IsGeneralUnitaryWith c M a) :
    c M.det * M.det = a ^ Fintype.card n := by
  sorry

theorem _root_.Matrix.isGeneralUnitaryWith_scalar (b : ℓ) (hb : b ≠ 0) (hc : c (c b * b) = c b * b) :
    Matrix.IsGeneralUnitaryWith c (Matrix.scalar n b) (c b * b) := by
  sorry

-- U_ne_SU: use Mathlib's existing carriers with star equal to c.
example [StarRing ℓ] (hc : ∀ a, c a = star a)
    (ζ : ℓ) (hζ : c ζ * ζ = 1) (hζ1 : ζ ≠ 1) :
    Matrix.diagonal ![ζ, 1] ∈ Matrix.unitaryGroup (Fin 2) ℓ ∧
      Matrix.diagonal ![ζ, 1] ∉ Matrix.specialUnitaryGroup (Fin 2) ℓ := by
  sorry

example [StarRing ℓ] : (1 : Matrix n n ℓ) ∈ Matrix.specialUnitaryGroup n ℓ := by
  sorry

variable {V : Type*} [AddCommGroup V] [Module ℓ V]

/-- A Hermitian form: `ℓ`-linear in the first variable, `c`-semilinear in the second, with
`B y x = c (B x y)`. -/
def _root_.LinearMap.IsHermitian (B : V →ₗ[ℓ] V →ₛₗ[(c : ℓ →+* ℓ)] ℓ) : Prop :=
  B.flip.IsSymm

/-- A skew-Hermitian form: `B y x = - c (B x y)`. -/
def _root_.LinearMap.IsSkewHermitian (B : V →ₗ[ℓ] V →ₛₗ[(c : ℓ →+* ℓ)] ℓ) : Prop :=
  ∀ x y, B y x = -c (B x y)

theorem _root_.LinearMap.IsHermitian.smul_skew {B : V →ₗ[ℓ] V →ₛₗ[(c : ℓ →+* ℓ)] ℓ}
    (hB : LinearMap.IsHermitian c B) {η : ℓ} (hη : c η = -η) :
    LinearMap.IsSkewHermitian c (η • B) := by
  sorry

-- hermitian_zero
example : LinearMap.IsHermitian c (0 : V →ₗ[ℓ] V →ₛₗ[(c : ℓ →+* ℓ)] ℓ) ∧
    LinearMap.IsSkewHermitian c (0 : V →ₗ[ℓ] V →ₛₗ[(c : ℓ →+* ℓ)] ℓ) := by
  sorry

/-- Uniqueness of nondegenerate Hermitian forms over a finite field (DM.0/hermitian-forms-unique):
every one has an orthonormal basis. -/
theorem _root_.LinearMap.IsHermitian.exists_orthonormal_basis [Finite ℓ] [FiniteDimensional ℓ V]
    (hc : c ≠ RingEquiv.refl ℓ) (hc2 : c.trans c = RingEquiv.refl ℓ)
    {B : V →ₗ[ℓ] V →ₛₗ[(c : ℓ →+* ℓ)] ℓ} (hB : LinearMap.IsHermitian c B)
    (hnd : ∀ x, (∀ y, B x y = 0) → x = 0) :
    ∃ b : Module.Basis (Fin (Module.finrank ℓ V)) ℓ V,
      ∀ i j, B (b i) (b j) = if i = j then 1 else 0 := by
  sorry

end Unitary

section FiniteGroups

/-- Simplicity of `PSL_n` over a finite field of odd characteristic (DM.0/special-linear-unitary-simple,
special linear part; the rank-two case is Mathlib's `rank_two_simple`). -/
theorem _root_.Matrix.ProjectiveSpecialLinearGroup.isSimpleGroup {K : Type*} [Field K] [Fintype K]
    (hK : ringChar K ≠ 2) (n : ℕ) (hn : 3 ≤ n) :
    IsSimpleGroup (Matrix.ProjectiveSpecialLinearGroup (Fin n) K) := by
  sorry

/-- Every proper normal subgroup of `SL_n(K)` is central (n ≥ 3, odd characteristic). -/
theorem _root_.Matrix.SpecialLinearGroup.normal_le_center {K : Type*} [Field K] [Fintype K]
    (hK : ringChar K ≠ 2) (n : ℕ) (hn : 3 ≤ n) (H : Subgroup (Matrix.SpecialLinearGroup (Fin n) K))
    [H.Normal] (hH : H ≠ ⊤) : H ≤ Subgroup.center _ := by
  sorry

/-- Artin's non-isomorphism (DM.0/artin-non-isomorphism), special linear part. -/
theorem _root_.Matrix.ProjectiveSpecialLinearGroup.not_mulEquiv_of_char_ne {K₁ K₂ : Type*} [Field K₁] [Fintype K₁]
    [Field K₂] [Fintype K₂] (n : ℕ) (hn : 2 ≤ n) (h1 : ringChar K₁ ≠ 2) (h2 : ringChar K₂ ≠ 2)
    (h12 : ringChar K₁ ≠ ringChar K₂) (h10 : 10 < max (ringChar K₁) (ringChar K₂)) :
    IsEmpty (Matrix.ProjectiveSpecialLinearGroup (Fin n) K₁ ≃*
      Matrix.ProjectiveSpecialLinearGroup (Fin n) K₂) := by
  sorry

/-- Surjectivity onto a product of two groups with distinct simple quotients
(DM.0/product-of-simple-images), from Mathlib's Goursat lemma. -/
theorem _root_.Subgroup.eq_top_of_surjective_of_simple_quotients {G₁ G₂ : Type*} [Group G₁] [Group G₂]
    [Finite G₁] [Finite G₂] (Γ : Subgroup (G₁ × G₂))
    (h₁ : Function.Surjective (fun x : Γ => (x : G₁ × G₂).1))
    (h₂ : Function.Surjective (fun x : Γ => (x : G₁ × G₂).2))
    (hq : ∀ (N₁ : Subgroup G₁) (N₂ : Subgroup G₂) [N₁.Normal] [N₂.Normal],
      Nonempty ((G₁ ⧸ N₁) ≃* (G₂ ⧸ N₂)) → N₁ = ⊤) :
    Γ = ⊤ := by
  sorry

end FiniteGroups

/-! ## Layer DM.1: exponent data -/

/-- A Dwork exponent datum: a vector `a : Fin N → ZMod N` with `∑ a = 0` taking exactly
`N - n` distinct values (DM.1/dwork-exponent-datum). -/
structure ExponentDatum (N n : ℕ) where
  odd_modulus : Odd N
  modulus_ge_three : 3 ≤ N
  rank_ge_two : 2 ≤ n
  rank_le_modulus : n ≤ N
  coprime_rank : Nat.Coprime N n
  /-- the exponents `a_1, …, a_N` -/
  a : Fin N → ZMod N
  sum_eq_zero : ∑ j, a j = 0
  card_image : (Finset.univ.image a).card = N - n

namespace ExponentDatum

variable {N n : ℕ}

/-- The index set `B = {b : b + a_j ≠ 0 for all j}`. -/
def indexSet [NeZero N] (D : ExponentDatum N n) : Finset (ZMod N) :=
  Finset.univ.filter fun b => ∀ j, b + D.a j ≠ 0

theorem card_indexSet [NeZero N] (D : ExponentDatum N n) :
    D.indexSet.card = n := by
  sorry

theorem zero_not_mem_indexSet [NeZero N] (D : ExponentDatum N n) (h0 : ∃ j, D.a j = 0) :
    (0 : ZMod N) ∉ D.indexSet := by
  sorry

end ExponentDatum

/-- Qian's index set for `n > 2` (QIAN23 §3, p. 1254): `{1, 2, N - 3} ∪ {(N - n + 4)/2 + k}` for `n`
odd and `{1, 2, 3, N - 6} ∪ {(N - n + 5)/2 + k}` for `n` even. -/
def qianIndexSet (N n : ℕ) : Finset (ZMod N) :=
  if n % 2 = 1 then
    {1, 2, ((N - 3 : ℕ) : ZMod N)} ∪
      (Finset.range (n - 3)).image fun k => (((N - n + 4) / 2 + k : ℕ) : ZMod N)
  else
    {1, 2, 3, ((N - 6 : ℕ) : ZMod N)} ∪
      (Finset.range (n - 4)).image fun k => (((N - n + 5) / 2 + k : ℕ) : ZMod N)

-- indexSet_qian_three
example : qianIndexSet 401 3 = {1, 2, 398} := by
  sorry

-- the index set for n = 4, N = 501
example : qianIndexSet 501 4 = {1, 2, 3, 495} := by
  sorry

/-- The index set has `n` elements and sums to zero. -/
theorem card_qianIndexSet (N n : ℕ) (hn : 2 < n) (hN : 100 * n + 100 < N) (hodd : Odd N) :
    (qianIndexSet N n).card = n ∧ ∑ b ∈ qianIndexSet N n, b = 0 := by
  sorry

/-- Qian's Lemma 3.1 (DM.1/asymmetric-stabiliser-trivial). -/
theorem qianIndexSet_stabiliser (N n : ℕ) (hn : 2 < n) (hN : 100 * n + 100 < N) (hodd : Odd N)
    (hcop : Nat.Coprime N n) (α : (ZMod N)ˣ)
    (hα : (qianIndexSet N n).image (fun b => (α : ZMod N) * b) = qianIndexSet N n) :
    α = 1 := by
  sorry

-- indexSet_qian_ne_neg
example : (qianIndexSet 401 3).image (fun b => (-1 : ZMod 401) * b) ≠ qianIndexSet 401 3 := by
  sorry

/-- The auxiliary modulus (DM.1/auxiliary-modulus; QIAN23 Lemma 2.3, BLGHT11 Lemma 6.1). -/
theorem exists_auxiliary_modulus (l s : ℕ) (hl : l.Prime) (hs : 0 < s)
    (S : Finset ℕ) (hS : ∀ p ∈ S, p.Prime) (bound : ℕ) :
    ∃ N : ℕ, bound < N ∧ Odd N ∧ l.Coprime N ∧ (∀ p ∈ S, ¬ p ∣ N) ∧
      s ∣ orderOf (l : ZMod N) ∧
      (Even (orderOf (l : ZMod N)) → ¬ N ∣ l ^ (orderOf (l : ZMod N) / 2) + 1) := by
  sorry

/-! ## Layer DM.6: the Gauss-sum identities -/

section Gauss

variable {F : Type*} [Field F] [Fintype F] {R : Type*} [CommRing R] [IsDomain R]

/-- Qian's normalised Gauss sum `g(a) = - ∑_x χ(x)^a ψ(x)` for a character `χ` of order `N`. -/
noncomputable def qianGauss (χ : MulChar F R) (ψ : AddChar F R) (N : ℕ) (a : ZMod N) : R :=
  -gaussSum (χ ^ a.val) ψ

/-- For a character of odd order `N`, `g(a) g(-a) = q` for `a ≠ 0` (used in
DM.6/dwork-determinant-gauss-formula). -/
theorem qianGauss_mul_neg {N : ℕ} (hN : Odd N) {χ : MulChar F R} (hχ : orderOf χ = N)
    {ψ : AddChar F R} (hψ : ψ.IsPrimitive) {a : ZMod N} (ha : a ≠ 0) :
    qianGauss χ ψ N a * qianGauss χ ψ N (-a) = Fintype.card F := by
  sorry

example {N : ℕ} (χ : MulChar F R) (ψ : AddChar F R) (hψ : ψ.IsPrimitive) :
    qianGauss χ ψ N 0 = 1 := by
  sorry

/-- The determinant identity (QIAN23 (3.1)) for an exponent datum in which `0` occurs `n + 1` times
and every nonzero residue at most once. -/
theorem prod_qianGauss_indexSet {N n : ℕ} [NeZero N] (hN : Odd N) (D : ExponentDatum N n)
    (hzero : (Finset.univ.filter fun j => D.a j = 0).card = n + 1)
    (honce : ∀ i j, D.a i = D.a j → D.a i ≠ 0 → i = j)
    {χ : MulChar F R} (hχ : orderOf χ = N) {ψ : AddChar F R} (hψ : ψ.IsPrimitive) :
    ∏ b ∈ D.indexSet, ∏ j, qianGauss χ ψ N (D.a j + b) =
      (∏ b ∈ D.indexSet, qianGauss χ ψ N b) ^ n *
        (Fintype.card F : R) ^ (n * (N - 1) / 2 - n * (n - 1) / 2) := by
  sorry

end Gauss

