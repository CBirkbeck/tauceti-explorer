    (hdpos : 0<d) (hepos : 0<e) :
    grossKoblitzLogOrbitAverage p ι ℓ q hq d=grossKoblitzLogOrbitAverage p ι ℓ q hq e := by sorry

lemma grossKoblitzLogOrbitAverage_translation (p : ℕ) [Fact p.Prime] {K : Type*} [Field K]  (ι : ℤ_[p] →+* K)
