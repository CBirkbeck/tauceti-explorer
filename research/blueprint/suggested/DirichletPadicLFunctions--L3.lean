    (hg : ∀ a : X, g (QuotientAddGroup.mk' (kubertRelations (X := X) S w) (FreeAbelianGroup.of (-a)))=(ε : ℤ) • g (QuotientAddGroup.mk' (kubertRelations (X := X) S w) (FreeAbelianGroup.of (a))))
