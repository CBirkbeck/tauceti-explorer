    (A : ℤ_[p] → K) (D : ℕ → ℤ_[p] → K) (hD : D 0 = A) (B : ℝ) (hB : 0 ≤ B)
    (hT : ∀ x h : ℤ_[p], ‖x-1‖ ≤ ‖(moritaModulus p : ℤ_[p])‖ →
