lemma grossKoblitzLogOrbitAverage_independent (p : ℕ) [Fact p.Prime] {K : Type*} [Field K] [CharZero K]  (ι : ℤ_[p] →+* K)
    (ℓ : K → K) (q : ℚ) (hq : ‖(q : ℚ_[p])‖≤1) (d e : ℕ)
