lemma grossKoblitzLogOrbitSum_translation (p : ℕ) [Fact p.Prime] {K : Type*} [Field K]  (ι : ℤ_[p] →+* K)
    (ℓ : K → K) (q : ℚ) (hq : ‖(q : ℚ_[p])‖≤1)
