    (hD : 1 < D) (hpD : ¬p ∣ D) (ε : K) (hε : IsPrimitiveRoot ε D)
    (n : ℕ) : (n : K) * coeff n (tameNormalizedLogPrimitive η ε hε) ∈ O := by sorry

