    (ε : K) (hε : IsPrimitiveRoot ε D) (ℓ : K → K)
    (hpow : (∑ a : (ZMod D)ˣ, η⁻¹ (a : ZMod D)*ℓ (ε^(p*(a : ZMod D).val)-1))=
      η (p : ZMod D)*(∑ a : (ZMod D)ˣ, η⁻¹ (a : ZMod D)*ℓ (ε^(a : ZMod D).val-1))) :
    cyclotomicFrobeniusLogConstant p η ε hε ℓ=
