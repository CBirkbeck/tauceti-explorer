    (A : ℤ_[p] → K) (v : K)
    (hv : Tendsto (fun n => moritaAngularMean p χ n A) atTop (𝓝 v)) :
    Tendsto (fun n => moritaAngularMean p (χ.ringHomComp κ) n (κ ∘ A)) atTop (𝓝 (κ v)) := by sorry

