    (∏h ∈ range (m-1),(fun z => (moritaGamma p z : ℤ_[p])) ((↑hm.unit⁻¹ : ℤ_[p])*(h+1)))^4=1 := by sorry

lemma moritaGamma_normalizer_log_sum (p : ℕ) [Fact p.Prime] {K : Type*} [Field K]
    (ι : ℤ_[p] →+* K) (ℓ : K → K)
    (hmul : ∀a b, a≠0 → b≠0 → ℓ (a*b)=ℓ a+ℓ b)
