     (ι : ℤ_[p] →+* K) (hι : ∀ x : ℤ_[p], ‖ι x‖=‖x‖)
    (m n : ℕ) :
    ‖moritaAngularMean p (moritaCharacterTwist p ι (moritaTorsionCharacterMap p ι) (m+2)) n
      (fun x => (ι x)^(-((m+1 : ℕ) : ℤ)))‖≤moritaMeanBoundConstant (K:=K) p (moritaModulus p) := by sorry

