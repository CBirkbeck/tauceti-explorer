    (hD : IsUnit (D : K)) (hpD : ¬p ∣ D) (k : ℕ) (hk : 1≤k)
    (ω α : (ℤ_[p])ˣ → K) (hfactor : ∀ u : (ℤ_[p])ˣ, ω u*α u=algebraMap ℤ_[p] K (u : ℤ_[p]))
    (κ : (ℤ_[p])ˣ →ₜ* K)
    (hκ : ∀ u : (ℤ_[p])ˣ, κ u=primePowerCharacter p n χ (u : ℤ_[p])*
