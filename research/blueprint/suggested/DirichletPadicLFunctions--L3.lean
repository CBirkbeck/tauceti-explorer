    (hT : ∀ x h : ℤ_[2], ‖x-1‖≤‖(moritaModulus 2 : ℤ_[2])‖ → ‖h‖<R →
      HasSum (fun m => (ι h)^m*moritaLogDivided ℓ m (ι x)) (ι (x+h)*(ℓ (ι (x+h))-1)))
