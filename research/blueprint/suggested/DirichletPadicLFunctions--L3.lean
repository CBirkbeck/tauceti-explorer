    grossKoblitzLogOrbitSum p ι ℓ q hq f=(f/d) • grossKoblitzLogOrbitSum p ι ℓ q hq d := by sorry

lemma grossKoblitzLogOrbitAverage_zero (p : ℕ) [Fact p.Prime] {K : Type*} [Field K]  (ι : ℤ_[p] →+* K)
    (ℓ : K → K) (q : ℚ) (hq : ‖(q : ℚ_[p])‖≤1) :
