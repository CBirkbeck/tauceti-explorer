    (hy : ‖y-1‖≤‖(moritaModulus p : ℤ_[p])‖) :
    ‖(ι x)^(-((m+1 : ℕ) : ℤ))-(ι y)^(-((m+1 : ℕ) : ℤ))‖≤‖x-y‖ := by sorry

