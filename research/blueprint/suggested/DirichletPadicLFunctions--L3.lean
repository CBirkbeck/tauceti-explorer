    grossKoblitzLogOrbitAverage p ι ℓ (q+n) hn f=grossKoblitzLogOrbitAverage p ι ℓ q hq f := by sorry

lemma grossKoblitzLogOrbitAverage_frobenius (p : ℕ) [Fact p.Prime] {K : Type*} [Field K]  (ι : ℤ_[p] →+* K)
    (ℓ : K → K) (q : ℚ) (hq : ‖(q : ℚ_[p])‖≤1)
