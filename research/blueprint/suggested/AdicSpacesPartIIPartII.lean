open Topology Filter

/-! ## Layer RZ.0: nowhere density, on the coordinate ring of an affinoid

`AdicSpacesPartIIPartII:RZ.0/nowhere-dense-criteria`, condition (c): on an affinoid open
`Spa(A, A°)` a Zariski closed set `V(I)` is nowhere dense exactly when `I` lies in no minimal prime
of `A`. The predicate below is that ring-theoretic condition; the rigid-space predicate
`TauCeti.Rigid.IsNowhereDense` is a README target. -/

namespace Ideal

variable {A : Type*} [CommRing A] [IsNoetherianRing A]

/-- For noetherian `A`, `V(I) ⊆ Spec A` is nowhere dense iff `I` is contained in no minimal prime of `A`. -/
def IsNowhereDense (I : Ideal A) : Prop :=
  ∀ p ∈ minimalPrimes A, ¬ I ≤ p

/-- Nowhere density depends only on the radical (Zariski closed sets see only the reduction). -/
theorem IsNowhereDense.radical_iff (I : Ideal A) :
    I.radical.IsNowhereDense ↔ I.IsNowhereDense := by
  sorry

/-- Nowhere density is detected after localizing at the minimal primes: `V(I)` is nowhere dense iff
`I` generates the unit ideal of `A_p` for every minimal prime `p`. -/
theorem IsNowhereDense.iff_map_localization_eq_top (I : Ideal A) :
    I.IsNowhereDense ↔
      ∀ p ∈ minimalPrimes A, ∀ _ : p.IsPrime, I.map (algebraMap A (Localization.AtPrime p)) = ⊤ := by
  sorry

end Ideal

/-- The origin of the affine line is nowhere dense. -/
example : (Ideal.span {(Polynomial.X : Polynomial ℚ)}).IsNowhereDense := by
  sorry

/-- The zero ideal of a nonzero ring is never nowhere dense (`V(0)` is everything). -/
example : ¬ (⊥ : Ideal ℚ).IsNowhereDense := by
  sorry

/-- On `Spec(ℚ × ℚ)`, one of the two points is a proper Zariski closed set that is open, hence not
nowhere dense: the ideal generated by `(1, 0)` lies in the minimal prime `ℚ × 0`. -/
example : ¬ (Ideal.span {((1 : ℚ), (0 : ℚ))} : Ideal (ℚ × ℚ)).IsNowhereDense := by
  sorry

/-! ## Layer RZ.2: rank loci through minors

`AdicSpacesPartIIPartII:RZ.2/rank-loci`: the locus where the differential has rank at least `r` is
the non-vanishing locus of the `r × r` minors of the Jacobian matrix. The algebraic core over a
field: -/

/-- A matrix over a field has rank at least `r` iff some `r × r` minor is nonzero. -/
theorem Matrix.le_rank_iff_exists_submatrix_det_ne_zero {K : Type*} [Field K] {m n : ℕ}
    (M : Matrix (Fin m) (Fin n) K) (r : ℕ) :
    r ≤ M.rank ↔ ∃ (f : Fin r → Fin m) (g : Fin r → Fin n), (M.submatrix f g).det ≠ 0 := by
  sorry

/-- The Jacobian of `z ↦ z²` at `a` has rank one exactly when `2a ≠ 0`. -/
example (a : ℚ) : (Matrix.of fun _ _ : Fin 1 => 2 * a).rank = 1 ↔ a ≠ 0 := by
  sorry

/-! ## Layer RZ.3: the residue-field input of the Gauss point theorem

`AdicSpacesPartIIPartII:RZ.3/gauss-point-in-closure`: a rational neighbourhood of the Gauss point
normalised by `|g|_η = 1` contains every integral point at which the reduction of `g` does not
vanish; such points exist when the residue field is infinite. -/

/-- Over a local ring with infinite residue field, a polynomial with nonzero reduction takes a
unit value at some integral point. -/
theorem MvPolynomial.exists_isUnit_eval_of_infinite_residueField {O : Type*} [CommRing O]
    [IsLocalRing O] [Infinite (IsLocalRing.ResidueField O)] {n : ℕ} (g : MvPolynomial (Fin n) O)
    (hg : MvPolynomial.map (IsLocalRing.residue O) g ≠ 0) :
    ∃ a : Fin n → O, IsUnit (MvPolynomial.eval a g) := by
  sorry

/-- Negative control: over `ℤ_[p]` (finite residue field `𝔽_p`) the reduction of `T^p - T` is
nonzero, yet `a^p - a` is never a unit; the neighbourhood `{|T^p - T| ≥ 1}` of the Gauss point of
the disc over `ℚ_[p]` contains no `ℚ_[p]`-point. -/
example (p : ℕ) [Fact p.Prime] (a : ℤ_[p]) : ¬ IsUnit (a ^ p - a) := by
  sorry

/- The closed polydisc of the pinned Tau Ceti library, on which the Gauss point theorem is stated
(the Gauss point itself, `TauCeti.ValuationSpectrum.gaussPoint`, is in the current library and
not at the pinned commit). -/


/-! ## Layer RZ.6: analytic manifolds of rational points

The analytic inverse function theorem, the constant rank theorem and the identity theorem across a
closed subfield, on model spaces `Fin m → F` over a complete nontrivially normed field `F`. The
manifold structure on the rational points of a smooth rigid space,
`TauCeti.Rigid.rationalPoints.isManifold`, is a README target. -/

namespace TauCeti

variable {F : Type*} [NontriviallyNormedField F] [CompleteSpace F]

/-- Analytic inverse function theorem (`AdicSpacesPartIIPartII:RZ.6/analytic-inverse-function-theorem`):
an analytic map with invertible derivative is a local homeomorphism with analytic inverse. -/
theorem AnalyticAt.exists_openPartialHomeomorph {E E' : Type*} [NormedAddCommGroup E]
    [NormedSpace F E] [CompleteSpace E] [NormedAddCommGroup E'] [NormedSpace F E']
    [CompleteSpace E'] {f : E → E'} {a : E} (hf : AnalyticAt F f a) (f' : E ≃L[F] E')
    (hf' : HasFDerivAt f (f' : E →L[F] E') a) :
    ∃ g : OpenPartialHomeomorph E E', a ∈ g.source ∧ (∀ x ∈ g.source, g x = f x) ∧
      AnalyticOnNhd F g.symm g.target := by
  sorry

/-- The normal form `(x_1, …, x_m) ↦ (x_1, …, x_k, 0, …, 0)`. -/
def constantRankNormalForm (m n k : ℕ) (y : Fin m → F) : Fin n → F :=
  fun j => if h : (j : ℕ) < k ∧ (j : ℕ) < m then y ⟨j, h.2⟩ else 0

example : constantRankNormalForm (F := F) 2 2 1 ![1, 1] = ![1, 0] := by
  sorry

/-- The constant rank theorem (`AdicSpacesPartIIPartII:RZ.6/constant-rank-theorem`), in
characteristic zero: an analytic map whose derivative has constant rank `k` near `a` is, in
analytic charts, the normal form. -/
theorem AnalyticAt.exists_charts_constantRank [CharZero F] {m n k : ℕ}
    (f : (Fin m → F) → (Fin n → F)) (a : Fin m → F) (hf : ∀ᶠ x in 𝓝 a, AnalyticAt F f x)
    (hrank : ∀ᶠ x in 𝓝 a,
      Module.finrank F (LinearMap.range ((fderiv F f x : (Fin m → F) →L[F] (Fin n → F)) :
        (Fin m → F) →ₗ[F] (Fin n → F))) = k) :
    ∃ (φ : OpenPartialHomeomorph (Fin m → F) (Fin m → F))
      (ψ : OpenPartialHomeomorph (Fin n → F) (Fin n → F)),
      a ∈ φ.source ∧ f a ∈ ψ.source ∧ φ a = 0 ∧ ψ (f a) = 0 ∧
      AnalyticOnNhd F φ φ.source ∧ AnalyticOnNhd F φ.symm φ.target ∧
      AnalyticOnNhd F ψ ψ.source ∧ AnalyticOnNhd F ψ.symm ψ.target ∧
      Set.MapsTo f φ.source ψ.source ∧
      ∀ y ∈ φ.target,
        ψ (f (φ.symm y)) = constantRankNormalForm m n k y := by
  sorry

/-- Negative control for the characteristic hypothesis: in characteristic `p` the Frobenius
`x ↦ x ^ p` has derivative zero everywhere, so constant rank `0`, without being locally constant. -/
example (p : ℕ) [Fact p.Prime] {K : Type*} [NontriviallyNormedField K] [CharP K p] (x : K) :
    fderiv K (fun y : K => y ^ p) x = 0 := by
  sorry

/-- Identity theorem across a closed subfield (`AdicSpacesPartIIPartII:RZ.6/subfield-identity-theorem`):
an analytic function near `0` in `C^m` vanishing near `0` on `E^m` vanishes near `0`. -/
theorem AnalyticAt.eventually_eq_zero_of_restrict {E C : Type*} [NontriviallyNormedField E]
    [CompleteSpace E] [CharZero E] [NontriviallyNormedField C] [CompleteSpace C]
    [NormedAlgebra E C] {m : ℕ} (φ : (Fin m → C) → C) (hφ : AnalyticAt C φ 0)
    (hvan : ∀ᶠ x in 𝓝 (0 : Fin m → E), φ (fun i => algebraMap E C (x i)) = 0) :
    ∀ᶠ z in 𝓝 (0 : Fin m → C), φ z = 0 := by
  sorry

end TauCeti

