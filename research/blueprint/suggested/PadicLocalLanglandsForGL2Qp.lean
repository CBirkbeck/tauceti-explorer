open Matrix

namespace TauCeti

/-! ## R30.1: GL₂(ℚ_p), its subgroups and characters of ℚ_p^× -/

namespace GL2Qp

variable (p : ℕ) [Fact p.Prime]

/-- `G = GL₂(ℚ_p)`. -/
abbrev G := GL (Fin 2) ℚ_[p]

/-- The upper triangular Borel subgroup `B`. -/
def borel : Subgroup (G p) where
  carrier := {g | (g : Matrix (Fin 2) (Fin 2) ℚ_[p]) 1 0 = 0}
  one_mem' := by simp
  mul_mem' := by
    intro a b ha hb
    simp only [Set.mem_ofPred_eq, Units.val_mul, Matrix.mul_apply, Fin.sum_univ_two] at *
    rw [ha, hb]; ring
  inv_mem' := by
    intro a ha
    sorry

/-- The mirabolic subgroup `P = {(a b; 0 1)}`. -/
def mirabolic : Subgroup (G p) where
  carrier := {g | (g : Matrix (Fin 2) (Fin 2) ℚ_[p]) 1 0 = 0 ∧ (g : Matrix (Fin 2) (Fin 2) ℚ_[p]) 1 1 = 1}
  one_mem' := by simp
  mul_mem' := by
    intro a b ha hb
    simp only [Set.mem_ofPred_eq, Units.val_mul, Matrix.mul_apply, Fin.sum_univ_two] at *
    refine ⟨?_, ?_⟩
    · rw [ha.1, hb.1]; ring
    · rw [ha.1, ha.2, hb.2]; ring
  inv_mem' := by
    intro a ha
    sorry

/-- The monoid `P⁺ = {(a b; 0 1) : a ∈ ℤ_p ∖ {0}, b ∈ ℤ_p}` acting on étale (φ,Γ)-modules. -/
def mirabolicPlus : Submonoid (G p) where
  carrier := {g | (g : Matrix (Fin 2) (Fin 2) ℚ_[p]) 1 0 = 0 ∧ (g : Matrix (Fin 2) (Fin 2) ℚ_[p]) 1 1 = 1 ∧
    ‖(g : Matrix (Fin 2) (Fin 2) ℚ_[p]) 0 0‖ ≤ 1 ∧ ‖(g : Matrix (Fin 2) (Fin 2) ℚ_[p]) 0 1‖ ≤ 1}
  one_mem' := by simp
  mul_mem' := by
    intro a b ha hb
    sorry

/-- `K = GL₂(ℤ_p)` as a subgroup of `GL₂(ℚ_p)`. -/
def maximalCompact : Subgroup (G p) :=
  (Matrix.GeneralLinearGroup.map (n := Fin 2) (PadicInt.Coe.ringHom (p := p))).range

/-- The centre `Z ≅ ℚ_p^×` of scalar matrices, as the image of `ℚ_p^×`. -/
def scalar : ℚ_[p]ˣ →* G p :=
  Units.map (algebraMap ℚ_[p] (Matrix (Fin 2) (Fin 2) ℚ_[p])).toMonoidHom

/-- The Weyl element `w = (0 1; 1 0)`. -/
def weylElement : G p :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero !![0, 1; 1, 0] (by simp [Matrix.det_fin_two])

/-- The element `(p 0; 0 1)`, acting as `φ` on étale (φ,Γ)-modules. -/
def phiElement : G p :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero !![(p : ℚ_[p]), 0; 0, 1]
    (by simp [Matrix.det_fin_two, (Fact.out : p.Prime).ne_zero])

/-- The unipotent element `(1 b; 0 1)`. -/
def unipotent (b : ℚ_[p]) : G p :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero !![1, b; 0, 1] (by simp [Matrix.det_fin_two])

/-- `GL2Qp.weylElement_sq`: `w² = 1`. -/
theorem weylElement_sq : weylElement p * weylElement p = 1 := by
  sorry

/-- `GL2Qp.mirabolicPlus_mul_mem`: `P⁺` is closed under multiplication. -/
theorem mirabolicPlus_mul_mem {a b : G p} (ha : a ∈ mirabolicPlus p) (hb : b ∈ mirabolicPlus p) :
    a * b ∈ mirabolicPlus p :=
  (mirabolicPlus p).mul_mem ha hb

/-- `GL2Qp.mem_mirabolic_iff`. -/
theorem mem_mirabolic_iff (g : G p) :
    g ∈ mirabolic p ↔ (g : Matrix (Fin 2) (Fin 2) ℚ_[p]) 1 0 = 0 ∧
      (g : Matrix (Fin 2) (Fin 2) ℚ_[p]) 1 1 = 1 := Iff.rfl

/-- `GL2Qp.closure_mirabolic_center_weyl`: `G` is generated by `P(ℚ_p)`, `Z` and `w`. -/
theorem closure_mirabolic_center_weyl :
    Subgroup.closure ((mirabolic p : Set (G p)) ∪ Set.range (scalar p) ∪ {weylElement p}) = ⊤ := by
  sorry

/-- Test `GL2Qp.weylElement_not_mem_borel`. -/
example : weylElement p ∉ borel p := by
  sorry

/-- Test `GL2Qp.phi_mem_mirabolicPlus`. -/
example : phiElement p ∈ mirabolicPlus p ∧ (phiElement p)⁻¹ ∉ mirabolicPlus p := by
  sorry

/-- Test `GL2Qp.mirabolic_inf_center`: `P ∩ Z = {1}`. -/
example (z : ℚ_[p]ˣ) (hz : scalar p z ∈ mirabolic p) : z = 1 := by
  sorry

/-- Test `GL2Qp.unipotent_mem_mirabolicPlus`. -/
example : unipotent p 1 ∈ mirabolicPlus p ∧ unipotent p (p : ℚ_[p])⁻¹ ∉ mirabolicPlus p := by
  sorry

end GL2Qp

/-! ### Characters of ℚ_p^× (`R30.1/character-dictionary`) -/

/-- `T̂(Λ)`: continuous characters `ℚ_p^× → Λ^×`. -/
abbrev PadicChar (p : ℕ) [Fact p.Prime] (Λ : Type*) [Monoid Λ] [TopologicalSpace Λ] :=
  ContinuousMonoidHom ℚ_[p]ˣ Λˣ

namespace PadicChar

variable (p : ℕ) [Fact p.Prime]

/-- The underlying function of `x ↦ x|x|`: `x ↦ x · p^{−v(x)}`, so that `p ↦ 1` and units are fixed. -/
def normCharFun (x : ℚ_[p]ˣ) : ℚ_[p]ˣ :=
  x * (Units.mk0 (p : ℚ_[p]) (by exact_mod_cast (Fact.out : p.Prime).ne_zero)) ^ (-(x : ℚ_[p]).valuation)

/-- `PadicChar.normChar`: the character `x ↦ x|x|` of `ℚ_p^×`, which corresponds to the cyclotomic
character under the geometric-Frobenius normalisation. -/
def normChar : ℚ_[p]ˣ →* ℚ_[p]ˣ where
  toFun := normCharFun p
  map_one' := by simp [normCharFun]
  map_mul' x y := by
    sorry

/-- `PadicChar.unramified`: `μ_λ`, with `μ_λ(p) = λ` and trivial on `ℤ_p^×`. -/
def unramified {Λ : Type*} [CommGroup Λ] (lam : Λ) : ℚ_[p]ˣ →* Λ where
  toFun x := lam ^ (x : ℚ_[p]).valuation
  map_one' := by simp
  map_mul' x y := by
    sorry

/-- A character `δ : ℚ_p^× → L^×` is unitary when `|δ(p)| = 1`. -/
def IsUnitary {L : Type*} [NormedField L] (δ : ℚ_[p]ˣ →* Lˣ) : Prop :=
  ‖((δ (Units.mk0 (p : ℚ_[p]) (by exact_mod_cast (Fact.out : p.Prime).ne_zero)) : Lˣ) : L)‖ = 1

/-- Test `PadicChar.normChar_apply_p`: `(x|x|)(p) = 1`. -/
example : normChar p (Units.mk0 (p : ℚ_[p]) (by exact_mod_cast (Fact.out : p.Prime).ne_zero)) = 1 := by
  sorry

/-- Test `PadicChar.normChar_apply_p` (units part): `(x|x|)(u) = u` for `u` of valuation `0`. -/
example (u : ℚ_[p]ˣ) (hu : (u : ℚ_[p]).valuation = 0) : normChar p u = u := by
  sorry

/-- Test `PadicChar.not_extends_id`: the identity character `x ↦ x` is not unitary. -/
example : ¬ IsUnitary p (MonoidHom.id ℚ_[p]ˣ) := by
  sorry

/-- `PadicChar.unramified` is unitary iff `|λ| = 1`. -/
theorem isUnitary_unramified {L : Type*} [NormedField L] (lam : Lˣ) :
    IsUnitary p (unramified p lam) ↔ ‖(lam : L)‖ = 1 := by
  sorry

end PadicChar

end TauCeti

/-! ## R30.2: smooth torsion representations, central characters, principal series -/

namespace TauCeti

namespace GL2Qp

variable (p : ℕ) [Fact p.Prime]
variable {A : Type*} [CommRing A] [TopologicalSpace A]

/-- The vectors of a continuous representation fixed by a subgroup `H`. -/
def fixedBy (X : TopRep A (G p)) (H : Subgroup (G p)) : Submodule A X.V where
  carrier := {v | ∀ h ∈ H, X.ρ h v = v}
  zero_mem' := by intro h _; simp
  add_mem' := by
    intro v w hv hw h hh
    simp [map_add, hv h hh, hw h hh]
  smul_mem' := by
    intro a v hv h hh
    simp [map_smul, hv h hh]

/-- `GL2Qp.IsAdmissible`: the fixed vectors of every compact open subgroup form a finitely
generated module. This is the fixed-level predicate for coefficients `O/ϖ^n`; for general
`O`-torsion objects the README requires finiteness of each `ϖ^n`-torsion part of the invariants. -/
def IsAdmissible (X : TopRep A (G p)) : Prop :=
  ∀ H : Subgroup (G p), IsOpen (H : Set (G p)) → IsCompact (H : Set (G p)) →
    Module.Finite A (fixedBy p X H)

/-- `GL2Qp.IsLocallyAdmissible`: every vector generates an admissible subrepresentation; stated
through the fixed vectors of compact open subgroups inside the span of the orbit. -/
def IsLocallyAdmissible (X : TopRep A (G p)) : Prop :=
  ∀ v : X.V, ∀ H : Subgroup (G p), IsOpen (H : Set (G p)) → IsCompact (H : Set (G p)) →
    Module.Finite A ↥(Submodule.span A (Set.range fun g : G p => X.ρ g v) ⊓ fixedBy p X H)

/-- `GL2Qp.IsLocallyFinite`: every vector generates a subrepresentation of finite length
(artinian and noetherian over the group algebra `A[G]`, rather than over `A`). -/
def IsLocallyFinite (X : TopRep A (G p)) : Prop :=
  ∀ v : X.ρ.toRepresentation.asModule,
    IsArtinian (MonoidAlgebra A (G p))
      ↥(Submodule.span (MonoidAlgebra A (G p)) ({v} : Set X.ρ.toRepresentation.asModule)) ∧
    IsNoetherian (MonoidAlgebra A (G p))
      ↥(Submodule.span (MonoidAlgebra A (G p)) ({v} : Set X.ρ.toRepresentation.asModule))

/-- `GL2Qp.HasCentralChar`: the centre acts through `ζ`. -/
def HasCentralChar (X : TopRep A (G p)) (ζ : ℚ_[p]ˣ →* Aˣ) : Prop :=
  ∀ (z : ℚ_[p]ˣ) (v : X.V), X.ρ (scalar p z) v = ((ζ z : Aˣ) : A) • v

/-- `GL2Qp.SmoothTorsionRep`: smooth (Tau Ceti `IsSmoothDiscrete`) and `p`-power torsion. -/
def IsSmoothTorsion (X : TopRep A (G p)) : Prop :=
  IsSmoothDiscrete A X ∧ ∀ v : X.V, ∃ n : ℕ, ((p : A) ^ n) • v = 0

/-- An admissible
representation is locally admissible when `A` is noetherian (SR.0.4 `isLocallyAdmissible`). -/
theorem IsAdmissible.isLocallyAdmissible [IsNoetherianRing A] {X : TopRep A (G p)}
    (hX : IsAdmissible p X) : IsLocallyAdmissible p X := by
  sorry

/-- Test `GL2Qp.smooth_compat`: smoothness is Tau Ceti's `IsSmoothDiscrete`. -/
example (X : TopRep A (G p)) (h : IsSmoothTorsion p X) : IsSmoothDiscrete A X := h.1

/-- The diagonal entries of an element of the Borel subgroup, as units. -/
def borelDiag (b : borel p) : ℚ_[p]ˣ × ℚ_[p]ˣ :=
  (Units.mk0 (((b : G p) : Matrix (Fin 2) (Fin 2) ℚ_[p]) 0 0) (by sorry),
   Units.mk0 (((b : G p) : Matrix (Fin 2) (Fin 2) ℚ_[p]) 1 1) (by sorry))

/-- `GL2Qp.principalSeries`: the space of `Ind_B^G(δ₁ ⊗ δ₂)` — locally constant `φ : G → A` with
`φ(bg) = δ₁(a)δ₂(d)φ(g)` for `b = (a *; 0 d)` — on which `G` acts by right translation. -/
def principalSeries (δ₁ δ₂ : ℚ_[p]ˣ →* Aˣ) : Submodule A (G p → A) where
  carrier := {φ | IsLocallyConstant φ ∧ ∀ (b : borel p) (g : G p),
    φ ((b : G p) * g) = ((δ₁ (borelDiag p b).1 * δ₂ (borelDiag p b).2 : Aˣ) : A) * φ g}
  zero_mem' := by
    refine ⟨IsLocallyConstant.const 0, fun b g => by simp⟩
  add_mem' := by
    intro φ ψ hφ hψ
    sorry
  smul_mem' := by
    intro a φ hφ
    sorry

/-- Right translation on `G → A`. -/
def rightTranslate (g : G p) (φ : G p → A) : G p → A := fun x => φ (x * g)

/-- `GL2Qp.principalSeries_centralChar`: on `Ind_B^G(δ₁ ⊗ δ₂)` the centre acts by `δ₁δ₂`. -/
theorem principalSeries_centralChar (δ₁ δ₂ : ℚ_[p]ˣ →* Aˣ) (z : ℚ_[p]ˣ)
    (φ : G p → A) (hφ : φ ∈ principalSeries p δ₁ δ₂) :
    rightTranslate p (scalar p z) φ = fun x => ((δ₁ z * δ₂ z : Aˣ) : A) * φ x := by
  sorry

/-- `GL2Qp.principalSeries_twist`: twisting by `η ∘ det`. -/
theorem principalSeries_twist (δ₁ δ₂ η : ℚ_[p]ˣ →* Aˣ) (φ : G p → A)
    (hφ : φ ∈ principalSeries p δ₁ δ₂)
    (hη : IsLocallyConstant (fun x : G p =>
      ((η (Matrix.GeneralLinearGroup.det x) : Aˣ) : A))) :
    (fun x => ((η (Matrix.GeneralLinearGroup.det x) : Aˣ) : A) * φ x) ∈
      principalSeries p (δ₁ * η) (δ₂ * η) := by
  sorry

end GL2Qp

/-! ## R30.1/R30.5: the Breuil–Mézard type normalisations (numerical dictionary) -/

namespace BMCycles

/-- `BMCycles.normalisation_dictionary`: Paškūnas's weights `w = (a, b)` with `b > a` correspond to
Tung's `λ = (b, a)`; both give the algebraic factor `Sym^{b−a−1} ⊗ det^a`, of dimension `b − a`. -/
def tungWeight (w : ℤ × ℤ) : ℤ × ℤ := (w.2, w.1)

/-- The dimension of the algebraic factor `Sym^{b−a−1} ⊗ det^a` (`LocAlgType.algFactor_dim`). -/
def algFactorDim (w : ℤ × ℤ) : ℤ := w.2 - w.1

example : tungWeight (0, 1) = (1, 0) := rfl

/-- Test `LocAlgType.algFactor_weights_0_1`: for weights `(0, 1)` the algebraic factor is
one-dimensional (trivial). -/
example : algFactorDim (0, 1) = 1 := rfl

/-- The dictionary is an involution on ordered pairs. -/
theorem tungWeight_tungWeight (w : ℤ × ℤ) : tungWeight (tungWeight w) = w := rfl

end BMCycles

end TauCeti
