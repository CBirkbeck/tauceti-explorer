/-!
# Period and index on real surfaces — suggested Lean signatures

This file is **not** the roadmap and is not exhaustive: the roadmap document
`research/blueprint/readmes/RealSurfacePeriodIndex.md` is definitive. The statements below suggest
Lean forms for the definitions, API items, unit tests and named theorems of the roadmap so that
contributors and reviewers converge on names and signatures. Everything is proved by `sorry`;
nothing here is claimed to be formalised.

Only what is statable at the pinned libraries (Mathlib `082e2d3`, Tau Ceti `f790474`) is typed:
the real-function-field layer PI.0, the field-level period and index statements of PI.1, the
field-level forms of the main theorems of PI.7 (Theorems 0.3, 0.10, 0.12 and the pair-of-quadrics
statement behind Theorem 0.13) and the real Puiseux field of PI.9. The geometric targets need
carriers that are not at the pins (Brauer groups of schemes, equivariant Betti cohomology of real
varieties, cycle class maps, variations of Hodge structure); they are README targets and are listed
at the end of the file.

Two notions owned by `SemisimpleAlgebrasPartII` (the index of a Brauer class, SA.0) and by the
upstream `RealAlgebraicGeometry` roadmap (existence of real closures, Layer 1) are given minimal
local forms so that the statements typecheck; the owners' declarations replace them.
-/

noncomputable section

open scoped TensorProduct

universe u

namespace TauCetiRoadmap.RealSurfacePeriodIndex

/-! ## Layer PI.0: orderings, real closures, signatures and the Elman–Lam invariant -/

namespace RealFunctionField

section Orderings

variable (F : Type u) [Field F]

/-- `PI.0/ordering-space`: the orderings of a field, as Mathlib ring preorderings that are
orderings. -/
def OrderingSpace : Type u := {P : RingPreordering F // P.IsOrdering}

namespace OrderingSpace

variable {F}

/-- The Harrison basic set `H(a) = {P : a ∈ P}`. -/
def harrisonSet (a : F) : Set (OrderingSpace F) := {P | a ∈ P.1}

/-- The Harrison topology, generated by the sets `H(a)` for `a ≠ 0`. -/
instance instTopologicalSpace : TopologicalSpace (OrderingSpace F) :=
  TopologicalSpace.generateFrom {S | ∃ a : F, a ≠ 0 ∧ S = harrisonSet a}

theorem isClopen_harrisonSet {a : F} (ha : a ≠ 0) : IsClopen (harrisonSet a) := sorry

theorem compl_harrisonSet {a : F} (ha : a ≠ 0) : (harrisonSet a)ᶜ = harrisonSet (-a) := sorry

/-- Restriction of orderings along a field embedding. -/
def restrict {L : Type u} [Field L] (ι : F →+* L) : OrderingSpace L → OrderingSpace F := sorry

theorem continuous_restrict {L : Type u} [Field L] (ι : F →+* L) : Continuous (restrict ι) := sorry

theorem restrict_preimage_harrisonSet {L : Type u} [Field L] (ι : F →+* L) (a : F) :
    restrict ι ⁻¹' harrisonSet a = harrisonSet (ι a) := sorry

theorem isEmpty_iff : IsEmpty (OrderingSpace F) ↔ ¬ IsSemireal F := sorry

/-- The sign of a nonzero element at an ordering. -/
def sign (P : OrderingSpace F) (a : Fˣ) : ℤ := by
  classical exact if (a : F) ∈ P.1 then 1 else -1

theorem sign_mul (P : OrderingSpace F) (a b : Fˣ) : sign P (a * b) = sign P a * sign P b := sorry

theorem sign_sq (P : OrderingSpace F) (a : Fˣ) : sign P (a * a) = 1 := sorry

/-- `PI.0/harrison-compact`: the Harrison space is compact, Hausdorff and totally disconnected. -/
theorem compactSpace : CompactSpace (OrderingSpace F) := sorry

theorem t2Space : T2Space (OrderingSpace F) := sorry

theorem totallyDisconnectedSpace : TotallyDisconnectedSpace (OrderingSpace F) := sorry

/-- The ordering of nonnegative elements of an ordered field. -/
def ofLinearOrder [LinearOrder F] [IsStrictOrderedRing F] : OrderingSpace F :=
  ⟨{ carrier := {a | 0 ≤ a}
     zero_mem' := sorry
     add_mem' := sorry
     one_mem' := sorry
     mul_mem' := sorry
     mem_of_isSquare' := sorry
     neg_one_notMem' := sorry }, sorry⟩

/-- Test `RealFunctionField.OrderingSpace.sumSq_not_ordering`. -/
example : ¬ ∃ P : OrderingSpace (RatFunc ℝ), ∀ a, a ∈ P.1 ↔ IsSumSq a := sorry

/-- Test `RealFunctionField.OrderingSpace.subsingleton_real`. -/
example : Subsingleton (OrderingSpace ℝ) := sorry

/-- Test `RealFunctionField.OrderingSpace.isEmpty_complex`. -/
example : IsEmpty (OrderingSpace ℂ) := sorry

/-- Test `RealFunctionField.OrderingSpace.card_sqrt_two`. -/
example (K : Type) [Field K] [Algebra ℚ K] (h2 : Module.finrank ℚ K = 2) (s : K) (hs : s * s = 2) :
    Nat.card (OrderingSpace K) = 2 := sorry

end OrderingSpace

/-- `PI.0/real-closure-at-ordering`: a real closure of `F` at the ordering `P`. -/
structure RealClosureAt (P : OrderingSpace F) where
  /-- The real closed field. -/
  carrier : Type u
  [field : Field carrier]
  [isRealClosed : IsRealClosed carrier]
  /-- The embedding of `F`. -/
  toRingHom : F →+* carrier
  isAlgebraic : @Algebra.IsAlgebraic F carrier _ _ toRingHom.toAlgebra
  map_mem : ∀ a ∈ P.1, IsSquare (toRingHom a)

attribute [instance] RealClosureAt.field RealClosureAt.isRealClosed

namespace RealClosureAt

variable {F}

/-- Every ordering has a real closure (upstream `RealAlgebraicGeometry` Layer 1,
`exists_realClosure`). -/
theorem nonempty (P : OrderingSpace F) : Nonempty (RealClosureAt F P) := sorry

/-- The pullback of the squares of `R` is `P`. -/
theorem ordering_eq {P : OrderingSpace F} (R : RealClosureAt F P) (a : F) :
    a ∈ P.1 ↔ IsSquare (R.toRingHom a) := sorry

/-- A real closed field is its own real closure. -/
def ofIsRealClosed [IsRealClosed F] (P : OrderingSpace F) : RealClosureAt F P :=
  { carrier := F, toRingHom := RingHom.id F, isAlgebraic := sorry, map_mem := sorry }

/-- Test `RealFunctionField.RealClosureAt.real_self`. `IsRealClosed ℝ` is not an instance at the pin
(upstream RealAlgebraicGeometry Layer 1 supplies it), so it is a hypothesis here. -/
example (h : IsRealClosed ℝ) : RealClosureAt ℝ OrderingSpace.ofLinearOrder := @ofIsRealClosed ℝ _ h _

/-- The base change of Brauer classes to a real closure. -/
def brauerRestrict {P : OrderingSpace F} (R : RealClosureAt F P) :
    BrauerGroup.{u, u} F →* BrauerGroup.{u, u} R.carrier :=
  letI := R.toRingHom.toAlgebra
  TauCeti.BrauerGroup.baseChange F R.carrier

end RealClosureAt

/-- `RealFunctionField.brauerGroup_realClosed`: the Brauer group of a real closed field is cyclic of
order two. -/
theorem brauerGroup_realClosed (R : Type u) [Field R] [IsRealClosed R] :
    Nonempty (BrauerGroup.{u, u} R ≃* Multiplicative (ZMod 2)) := sorry

/-- Test `RealFunctionField.brauerGroup_realClosed_real`: for `ℝ` this is Tau Ceti's
`TauCeti.Quaternion.card_brauerGroup_eq_two`. -/
example : Nat.card (BrauerGroup.{0, 0} ℝ) = 2 := TauCeti.Quaternion.card_brauerGroup_eq_two

/-- `RealFunctionField.VanishesAtRealClosures`. -/
def VanishesAtRealClosures (β : BrauerGroup.{u, u} F) : Prop :=
  ∀ (P : OrderingSpace F) (R : RealClosureAt F P), R.brauerRestrict β = 1

/-- Test `RealFunctionField.VanishesAtRealClosures.of_not_isSemireal`. -/
example (h : ¬ IsSemireal F) (β : BrauerGroup.{u, u} F) : VanishesAtRealClosures F β := sorry

/-- Test `RealFunctionField.VanishesAtRealClosures.quaternion_real`. -/
example : ¬ VanishesAtRealClosures ℝ (TauCeti.Quaternion.brauerGroupMulEquiv.symm
    (Multiplicative.ofAdd 1)) := sorry

end Orderings

section Signatures

variable {F : Type u} [Field F]

/-- The signature of the diagonal form `⟨w₁, …, wₙ⟩` at an ordering. -/
def diagSignature (P : OrderingSpace F) {n : ℕ} (w : Fin n → Fˣ) : ℤ :=
  ∑ i, OrderingSpace.sign P (w i)

variable {V : Type u} [AddCommGroup V] [Module F V] [FiniteDimensional F V] [Invertible (2 : F)]

/-- `PI.0/signature-at-ordering`: the signature of a nondegenerate form, through a chosen
diagonalisation (independence of the choice is `signatureAt_congr`). -/
def signatureAt (P : OrderingSpace F) (Q : QuadraticForm F V)
    (hQ : (QuadraticMap.associated (R := F) Q).SeparatingLeft) : ℤ :=
  diagSignature P (Classical.choose (QuadraticForm.equivalent_weightedSumSquares_units_of_nondegenerate' Q hQ))

theorem signatureAt_weightedSumSquares (P : OrderingSpace F) {n : ℕ} (w : Fin n → Fˣ)
    (hQ : (QuadraticMap.associated (R := F) (QuadraticMap.weightedSumSquares F (fun i => (w i : F)))).SeparatingLeft) :
    signatureAt P (QuadraticMap.weightedSumSquares F (fun i => (w i : F))) hQ = diagSignature P w := sorry

/-- Sylvester's law of inertia over an ordered field. -/
theorem signatureAt_congr {V' : Type u} [AddCommGroup V'] [Module F V'] [FiniteDimensional F V']
    (P : OrderingSpace F) {Q : QuadraticForm F V} {Q' : QuadraticForm F V'} (e : Q.Equivalent Q')
    (hQ : (QuadraticMap.associated (R := F) Q).SeparatingLeft)
    (hQ' : (QuadraticMap.associated (R := F) Q').SeparatingLeft) :
    signatureAt P Q hQ = signatureAt P Q' hQ' := sorry

theorem signatureAt_modTwo (P : OrderingSpace F) (Q : QuadraticForm F V)
    (hQ : (QuadraticMap.associated (R := F) Q).SeparatingLeft) :
    signatureAt P Q hQ ≡ (Module.finrank F V : ℤ) [ZMOD 2] ∧
      |signatureAt P Q hQ| ≤ Module.finrank F V := sorry

/-- `RealFunctionField.HasZeroSignatures`. -/
def HasZeroSignatures (Q : QuadraticForm F V) : Prop :=
  ∃ hQ : (QuadraticMap.associated (R := F) Q).SeparatingLeft, ∀ P : OrderingSpace F, signatureAt P Q hQ = 0

/-- Test `RealFunctionField.signatureAt_one_one_real`. -/
example (P : OrderingSpace ℝ) : diagSignature P (![1, 1] : Fin 2 → ℝˣ) = 2 := sorry

/-- Test `RealFunctionField.signatureAt_hyperbolic_zero`. -/
example (P : OrderingSpace F) : diagSignature P (![1, -1] : Fin 2 → Fˣ) = 0 := sorry

end Signatures

section ElmanLam

variable (F : Type u) [Field F]

/-- `PI.0/elman-lam-u`: the Elman–Lam u-invariant, the supremum of dimensions of anisotropic
diagonal forms with zero signature at every ordering (every nondegenerate form is diagonal up to
isometry when `2` is invertible). -/
def elmanLamU : ℕ∞ :=
  ⨆ (n : ℕ) (_ : ∃ w : Fin n → Fˣ,
      (QuadraticMap.weightedSumSquares F (fun i => (w i : F))).Anisotropic ∧
        ∀ P : OrderingSpace F, diagSignature P w = 0), (n : ℕ∞)

theorem elmanLamU_le_iff (n : ℕ) :
    elmanLamU F ≤ n ↔ ∀ (m : ℕ) (w : Fin m → Fˣ), n < m → (∀ P : OrderingSpace F, diagSignature P w = 0) →
      ¬ (QuadraticMap.weightedSumSquares F (fun i => (w i : F))).Anisotropic := sorry

theorem le_elmanLamU {m : ℕ} (w : Fin m → Fˣ)
    (ha : (QuadraticMap.weightedSumSquares F (fun i => (w i : F))).Anisotropic)
    (hs : ∀ P : OrderingSpace F, diagSignature P w = 0) : (m : ℕ∞) ≤ elmanLamU F := sorry

theorem elmanLamU_of_isRealClosed [IsRealClosed F] : elmanLamU F = 0 := sorry

/-- Test `RealFunctionField.elmanLamU_complex`. -/
example : elmanLamU ℂ = 1 := sorry

/-- Test `RealFunctionField.elmanLamU_real`. -/
example : elmanLamU ℝ = 0 := sorry

/-- Test `RealFunctionField.elmanLamU_ratFunc_real`. -/
example : elmanLamU (RatFunc ℝ) = 2 := sorry

/-- Test `RealFunctionField.sumSquares_not_counted`: `n⟨1⟩` is anisotropic over `ℝ(t)` but has
nonzero signature, so it is not counted. -/
example (n : ℕ) (hn : 0 < n) :
    (QuadraticMap.weightedSumSquares (RatFunc ℝ) (fun _ : Fin n => (1 : RatFunc ℝ))).Anisotropic ∧
      ∃ P : OrderingSpace (RatFunc ℝ), diagSignature P (fun _ : Fin n => (1 : (RatFunc ℝ)ˣ)) ≠ 0 := sorry

end ElmanLam

section ClassicalInputs

/-- `PI.0/curve-u-bound` (EKM Corollary 37.8). -/
theorem elmanLamU_le_two_of_trdeg_one (R F : Type u) [Field R] [IsRealClosed R] [Field F]
    [Algebra R F] (h : Algebra.trdeg R F = 1) : elmanLamU F ≤ 2 := sorry

/-- `PI.0/witt-real-curve` (a): over a function field of one variable over `ℝ`, a Brauer class
vanishing at every real closure is trivial. -/
theorem witt_real_curve (F : Type) [Field F] [Algebra ℝ F] (h : Algebra.trdeg ℝ F = 1)
    (hfg : (⊤ : IntermediateField ℝ F).FG) (β : BrauerGroup.{0, 0} F)
    (hβ : VanishesAtRealClosures F β) : β = 1 := sorry

/-- `PI.0/witt-real-curve` (c): a nonreal function field of a real curve has trivial Brauer group. -/
theorem witt_real_curve_nonreal (F : Type) [Field F] [Algebra ℝ F] (h : Algebra.trdeg ℝ F = 1)
    (hfg : (⊤ : IntermediateField ℝ F).FG) (hF : ¬ IsSemireal F) (β : BrauerGroup.{0, 0} F) :
    β = 1 := sorry

/-- `PI.0/springer-complete-dvr`, in the constant-coefficient form used for `ℂ((y₁))((y₂))`:
`⟨u⟩ ⊥ t⟨v⟩` with coefficients in `k` is anisotropic over `k((t))` iff both residue forms are
anisotropic over `k`. -/
theorem springer_laurentSeries (k : Type u) [Field k] [Invertible (2 : k)] {r s : ℕ}
    (a : Fin r → kˣ) (b : Fin s → kˣ) :
    (QuadraticMap.weightedSumSquares (LaurentSeries k)
        (Fin.append (fun i => (HahnSeries.C (a i : k) : LaurentSeries k))
          (fun j => HahnSeries.single 1 (b j : k)))).Anisotropic ↔
      (QuadraticMap.weightedSumSquares k (fun i => (a i : k))).Anisotropic ∧
        (QuadraticMap.weightedSumSquares k (fun j => (b j : k))).Anisotropic := sorry

/-- `PI.0/amer-brumer` (EKM Theorem 17.14). -/
theorem amer_brumer (F : Type u) [Field F] [Invertible (2 : F)] {V : Type u} [AddCommGroup V]
    [Module F V] [FiniteDimensional F V] (φ ψ : QuadraticForm F V) :
    ¬ (φ.baseChange (RatFunc F) + (RatFunc.X : RatFunc F) • ψ.baseChange (RatFunc F)).Anisotropic ↔
      ∃ v : V, v ≠ 0 ∧ φ v = 0 ∧ ψ v = 0 := sorry

/-- `PI.0/elman-lam-c2-bound`: if `u(F(√−1)) ≤ 4` then `u(F) ∈ {0, 1, 2, 4, 6}`. -/
theorem elmanLamU_mem_of_quadraticClosure_le_four (F L : Type u) [Field F] [Field L] [Algebra F L]
    (h2 : Module.finrank F L = 2) (i : L) (hi : i * i = -1) (hL : elmanLamU L ≤ 4) :
    elmanLamU F ∈ ({0, 1, 2, 4, 6} : Set ℕ∞) := sorry

end ClassicalInputs

end RealFunctionField

/-! ## Layer PI.1: period and index -/

namespace RealSurface

open RealFunctionField

section PeriodIndex

variable {K : Type u} [Field K]

/-- The index of a Brauer class (the target `SemisimpleAlgebrasPartII:SA.0/class-index`, in a local
form): the index of any representative. -/
def classIndex (x : BrauerGroup.{u, u} K) : ℕ :=
  Quotient.liftOn x (fun A => TauCeti.Algebra.index K A) (fun _ _ _ => sorry)

/-- The period of a Brauer class, its order in the Tau Ceti group structure. -/
abbrev period (x : BrauerGroup.{u, u} K) : ℕ := orderOf x

/-- `PI.1/de-jong-period-index`, characteristic zero, at the level of function fields: the function
field of a surface over an algebraically closed field of characteristic `0`. -/
theorem deJong_period_index (k : Type u) [Field k] [IsAlgClosed k] [CharZero k] [Algebra k K]
    (htr : Algebra.trdeg k K = 2) (hfg : (⊤ : IntermediateField k K).FG) (α : BrauerGroup.{u, u} K) :
    classIndex α = period α := sorry

/-- `PI.1/real-closed-norm-bound`. -/
theorem classIndex_dvd_two_mul_period (R : Type u) [Field R] [IsRealClosed R] [Algebra R K]
    (htr : Algebra.trdeg R K = 2) (hfg : (⊤ : IntermediateField R K).FG) (α : BrauerGroup.{u, u} K) :
    classIndex α ∣ 2 * period α := sorry

theorem classIndex_eq_period_of_odd (R : Type u) [Field R] [IsRealClosed R] [Algebra R K]
    (htr : Algebra.trdeg R K = 2) (hfg : (⊤ : IntermediateField R K).FG) (α : BrauerGroup.{u, u} K)
    (hodd : Odd (period α)) : classIndex α = period α := sorry

/-- `PI.0/pfister-brauer-criterion` (sufficiency, the direction Benoist uses). -/
theorem pfister_criterion (K : Type) [Field K] [Algebra ℝ K] (htr : Algebra.trdeg ℝ K = 2)
    (h : ∀ α : BrauerGroup.{0, 0} K, α ^ 2 = 1 → α ≠ 1 → VanishesAtRealClosures K α → classIndex α = 2) :
    elmanLamU K ≤ 4 := sorry

end PeriodIndex

/-! ## Layer PI.7: the main theorems at the level of function fields

For `K = ℝ(S)` with `S` a smooth projective model, `S(ℝ) = ∅` is equivalent to `K` being nonreal
(Artin–Lang), which is the form used below. -/

section MainTheorems

/-- `PI.7/no-real-points-period-index` (Theorem 0.3). -/
theorem period_eq_index_of_no_real_points (K : Type) [Field K] [Algebra ℝ K]
    (htr : Algebra.trdeg ℝ K = 2) (hfg : (⊤ : IntermediateField ℝ K).FG) (hK : ¬ IsSemireal K)
    (α : BrauerGroup.{0, 0} K) : classIndex α = period α := sorry

/-- `PI.7/u-invariant-upper-bound` (Theorem 0.12, first assertion). -/
theorem elmanLamU_le_four (K : Type) [Field K] [Algebra ℝ K] (htr : Algebra.trdeg ℝ K = 2) :
    elmanLamU K ≤ 4 := sorry

/-- `PI.7/u-invariant-equals-four` (Theorem 0.12, second assertion). -/
theorem elmanLamU_eq_four (K : Type) [Field K] [Algebra ℝ K] (htr : Algebra.trdeg ℝ K = 2)
    (hfg : (⊤ : IntermediateField ℝ K).FG) : elmanLamU K = 4 := sorry

/-- `PI.7/rank-five-isotropy` (Theorem 0.10). -/
theorem isotropic_of_five_le_finrank (K : Type) [Field K] [Algebra ℝ K]
    (htr : Algebra.trdeg ℝ K = 2) (hK : ¬ IsSemireal K) {V : Type} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] (Q : QuadraticForm K V) (hV : 5 ≤ Module.finrank K V) : ¬ Q.Anisotropic := sorry

/-- `PI.7/del-pezzo-point` in the form proved: two quadratic forms in five variables over the
function field of a real curve without real points have a common nontrivial zero. A degree-four
del Pezzo surface is such an intersection of two quadrics in `ℙ⁴`. -/
theorem common_zero_of_two_quadrics (F : Type) [Field F] [Algebra ℝ F] (htr : Algebra.trdeg ℝ F = 1)
    (hfg : (⊤ : IntermediateField ℝ F).FG) (hF : ¬ IsSemireal F) (φ ψ : QuadraticForm F (Fin 5 → F)) :
    ∃ v : Fin 5 → F, v ≠ 0 ∧ φ v = 0 ∧ ψ v = 0 := sorry

end MainTheorems

/-! ## Layer PI.9: the field of real Puiseux series -/

section Puiseux

/-- `PI.9/real-puiseux-field`: Hahn series over `ℝ` with rational exponents whose support lies in
`(1/n)ℤ` for some `n ≥ 1`. -/
def RealPuiseux : Subfield (HahnSeries ℚ ℝ) where
  carrier := {x | ∃ n : ℕ, 0 < n ∧ ∀ q ∈ x.support, ∃ k : ℤ, q = k / n}
  zero_mem' := sorry
  one_mem' := sorry
  add_mem' := sorry
  mul_mem' := sorry
  neg_mem' := sorry
  inv_mem' := sorry

/-- The parameter `t`. -/
def RealPuiseux.t : RealPuiseux := ⟨HahnSeries.single 1 1, sorry⟩

/-- `RealSurface.RealPuiseux.isRealClosed`. -/
theorem RealPuiseux.isRealClosed : IsRealClosed RealPuiseux := sorry

/-- `RealSurface.RealPuiseux.ofLaurent`: `ℝ((t^{1/n}))` inside the Puiseux field. -/
def RealPuiseux.ofLaurent (n : ℕ) (hn : 0 < n) : LaurentSeries ℝ →+* RealPuiseux := sorry

/-- Test `RealSurface.RealPuiseux.sqrt_t`. -/
example : ∃ s : RealPuiseux, s * s = RealPuiseux.t := sorry

/-- Test `RealSurface.RealPuiseux.real_embedding`. -/
example : Function.Injective (algebraMap ℝ (HahnSeries ℚ ℝ)) := sorry

end Puiseux

end RealSurface

