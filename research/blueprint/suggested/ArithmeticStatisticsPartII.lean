/-!
# Arithmetic statistics, Part II: random Γ-groups (suggested Lean forms)

This file is not the roadmap and is not exhaustive. The roadmap document
(`research/blueprint/readmes/ArithmeticStatisticsPartII.md`) is definitive. The statements
suggest Lean forms so that contributors and reviewers converge on names and signatures. Every
proof is `sorry`; nothing here is an implementation.

Only notions whose carriers exist at the pinned Mathlib and Tau Ceti are stated: the map `Y`,
pro-`n′` groups, admissibility, the coprime conjugacy hypothesis (SZ), Property E for finite
Γ-groups, equivariant surjection counts, minimal normal subgroups, the image of Haar measure on a
finite quotient, and the truncated-product limit of Liu–Wood. The free pro-`|Γ|′` Γ-group, the
free admissible Γ-group `𝓕_n`, level-`𝒞` completions, the space `𝒫`, the random groups
`X_{u,n}`, the measures `μ_u`, chief factor pairs, `H`-extensions with their Möbius function, the
`λ`-invariants, the `p`-covering group and the conjecture are targets of the roadmap document
and are not declared here: their carriers (free pro-C groups, completions with respect to
non-extension-closed classes, measures on isomorphism classes) are not available at the pins.
-/

open MeasureTheory Filter Topology

namespace TauCeti.GammaGroup

variable (Γ : Type*) [Group Γ]

section YMap

variable (G : Type*) [Group G] [MulDistribMulAction Γ G]

/-- The map `Y`, indexed by all of `Γ`: `g ↦ (γ ↦ g⁻¹ γ(g))`. The tuple version for a chosen
generating tuple of `Γ` is its restriction to the generators. -/
def yMap (g : G) : Γ → G := fun γ => g⁻¹ * (γ • g)

@[simp] theorem yMap_apply (g : G) (γ : Γ) : yMap Γ G g γ = g⁻¹ * (γ • g) := rfl

@[simp] theorem yMap_one : yMap Γ G 1 = 1 := by sorry

theorem yMap_mul (g h : G) (γ : Γ) :
    yMap Γ G (g * h) γ = h⁻¹ * yMap Γ G g γ * h * yMap Γ G h γ := by sorry

theorem yMap_eq_yMap_iff (g h : G) :
    yMap Γ G g = yMap Γ G h ↔ h * g⁻¹ ∈ FixedPoints.subgroup Γ G := by sorry

theorem yMap_eq_one_iff (g : G) : yMap Γ G g = 1 ↔ g ∈ FixedPoints.subgroup Γ G := by sorry

theorem yMap_map {H : Type*} [Group H] [MulDistribMulAction Γ H] (φ : G →*[Γ] H) (g : G) :
    yMap Γ H (φ g) = φ ∘ yMap Γ G g := by sorry

/-- LWZB Lemma 3.5: `|G| = |G^Γ| · |Y(G)|`. -/
theorem card_eq_card_fixedPoints_mul_card_range_yMap [Finite G] :
    Nat.card G = Nat.card (FixedPoints.subgroup Γ G) * Nat.card (Set.range (yMap Γ G)) := by
  sorry

theorem continuous_yMap [TopologicalSpace G] [IsTopologicalGroup G] [ContinuousConstSMul Γ G] :
    Continuous (yMap Γ G) := by sorry

end YMap

section Counts

variable (G H : Type*) [Group G] [Group H] [MulDistribMulAction Γ G] [MulDistribMulAction Γ H]

/-- `|Sur_Γ(G, H)|` for finite Γ-groups (discrete topology). -/
noncomputable def countSur : ℕ := Nat.card {f : G →*[Γ] H // Function.Surjective f}

/-- `h_Γ(H) = |Hom_Γ(H, H)|`. -/
noncomputable def hEnd : ℕ := Nat.card (H →*[Γ] H)

/-- The closed normal Γ-subgroup `[S]_G` generated by a subset. -/
def closedNormalClosure [TopologicalSpace G] [IsTopologicalGroup G] (S : Set G) : Subgroup G :=
  (Subgroup.normalClosure (⋃ γ : Γ, (fun g => γ • g) '' S)).topologicalClosure

theorem closedNormalClosure_le_iff [TopologicalSpace G] [IsTopologicalGroup G] (S : Set G)
    (N : Subgroup G) [N.Normal] (hN : IsClosed (N : Set G)) (hΓ : ∀ γ : Γ, ∀ n ∈ N, γ • n ∈ N) :
    closedNormalClosure Γ G S ≤ N ↔ S ⊆ N := by sorry

end Counts

section Admissible

/-- `G` is pro-`n′`: every quotient by an open normal subgroup has order prime to `n`. -/
def IsPrimeTo (n : ℕ) (G : Type*) [Group G] [TopologicalSpace G] : Prop :=
  ∀ U : OpenNormalSubgroup G, Nat.Coprime (Nat.card (G ⧸ U.toSubgroup)) n

theorem isPrimeTo_iff_coprime_profiniteOrder (n : ℕ) (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [CompactSpace G] [TotallyDisconnectedSpace G] :
    IsPrimeTo n G ↔ ∀ p : Nat.Primes, p.1 ∣ n → TauCeti.profiniteOrder G p = 0 := by sorry

/-- A Γ-group is admissible when it is pro-`|Γ|′` and topologically generated by the elements
`g⁻¹ γ(g)` (the notion of InverseGaloisAndArithmeticFundamentalGroups IG.4, restated for
prototyping). -/
def IsAdmissible [Finite Γ] (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [MulDistribMulAction Γ G] : Prop :=
  IsPrimeTo (Nat.card Γ) G ∧
    (Subgroup.closure (Set.range fun p : G × Γ => p.1⁻¹ * (p.2 • p.1))).topologicalClosure = ⊤

/-- LWZB §7.1: a finite abelian `|Γ|′`-Γ-group is admissible iff it has no non-zero invariants. -/
theorem isAdmissible_iff_fixedPoints_eq_bot [Finite Γ] (H : Type*) [CommGroup H] [Finite H]
    [TopologicalSpace H] [DiscreteTopology H] [IsTopologicalGroup H] [MulDistribMulAction Γ H]
    (hH : Nat.Coprime (Nat.card H) (Nat.card Γ)) :
    IsAdmissible Γ H ↔ FixedPoints.subgroup Γ H = ⊥ := by sorry

/-- LWZB Lemma 3.12: a normal subgroup on which Γ acts trivially is central in an admissible
Γ-group. -/
theorem IsAdmissible.conj_eq_of_fixed [Finite Γ] {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [T2Space G] [MulDistribMulAction Γ G] (hG : IsAdmissible Γ G)
    (N : Subgroup G) [N.Normal] (hN : ∀ γ : Γ, ∀ n ∈ N, γ • n = n) :
    ∀ g : G, ∀ n ∈ N, g * n * g⁻¹ = n := by sorry

/-- Rigidity used in LWZB Theorem 4.12: a Γ-subgroup with the same `Y`-image is everything. -/
theorem IsAdmissible.eq_top_of_range_yMap [Finite Γ] {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [MulDistribMulAction Γ G] (hG : IsAdmissible Γ G) (D : Subgroup G)
    (hD : IsClosed (D : Set G)) (hΓ : ∀ γ : Γ, ∀ d ∈ D, γ • d ∈ D)
    (hY : ∀ g : G, ∃ d ∈ D, yMap Γ G d = yMap Γ G g) : D = ⊤ := by sorry

end Admissible

section CoprimeConjugacy

/-- The hypothesis (SZ_Γ): for every finite group `N` of order prime to `|Γ|` with an action of
`Γ` by automorphisms, every crossed homomorphism `Γ → N` is principal. -/
def CoprimeH1Trivial [Finite Γ] : Prop :=
  ∀ (N : Type) [Group N] [Finite N] [MulDistribMulAction Γ N],
    Nat.Coprime (Nat.card N) (Nat.card Γ) →
    ∀ c : Γ → N, (∀ σ τ : Γ, c (σ * τ) = c σ * σ • c τ) → ∃ g : N, ∀ σ : Γ, c σ = g⁻¹ * σ • g

/-- (SZ_Γ) holds for solvable `Γ`, without the Feit–Thompson theorem. -/
theorem coprimeH1Trivial_of_isSolvable [Finite Γ] [Group.IsSolvable Γ] : CoprimeH1Trivial Γ := by
  sorry

/-- The abelian case needs no hypothesis on `Γ`. -/
theorem crossedHom_principal_of_commGroup [Finite Γ] (N : Type*) [CommGroup N] [Finite N]
    [MulDistribMulAction Γ N] (hN : Nat.Coprime (Nat.card N) (Nat.card Γ)) (c : Γ → N)
    (hc : ∀ σ τ : Γ, c (σ * τ) = c σ * σ • c τ) : ∃ g : N, ∀ σ : Γ, c σ = g⁻¹ * σ • g := by
  sorry

/-- Under (SZ_Γ), the sections of `H ⋊ Γ → Γ` correspond to `Y(H)`, so there are `[H : H^Γ]`
of them (LWZB, paragraph after (3.3), and Lemma 3.5). -/
theorem CoprimeH1Trivial.card_sections [Finite Γ] (hSZ : CoprimeH1Trivial Γ) (H : Type)
    [Group H] [Finite H] [MulDistribMulAction Γ H] (hH : Nat.Coprime (Nat.card H) (Nat.card Γ)) :
    Nat.card {c : Γ → H // ∀ σ τ : Γ, c (σ * τ) = c σ * σ • c τ} =
      Nat.card (Set.range (yMap Γ H)) := by sorry

/-- LWZB Lemma 3.6(1): fixed points are exact for coprime finite Γ-groups, under (SZ_Γ). -/
theorem CoprimeH1Trivial.fixedPoints_surjective [Finite Γ] (hSZ : CoprimeH1Trivial Γ)
    {G H : Type} [Group G] [Group H] [Finite G] [MulDistribMulAction Γ G]
    [MulDistribMulAction Γ H] (hG : Nat.Coprime (Nat.card G) (Nat.card Γ)) (π : G →*[Γ] H)
    (hπ : Function.Surjective π) :
    ∀ h ∈ FixedPoints.subgroup Γ H, ∃ g ∈ FixedPoints.subgroup Γ G, π g = h := by sorry

end CoprimeConjugacy

section PropertyE

/-- Property E (LWZB Definition 2.3) for a finite Γ-group `H` relative to a class `𝒦` of finite
Γ-groups: surjections onto `G ∈ 𝒦` lift along every non-split central extension
`1 → Z/p → E → G → 1` in `𝒦` with trivial Γ-action on the kernel. -/
def HasPropertyE (𝒦 : (E : Type) → [Group E] → [MulDistribMulAction Γ E] → Prop)
    (H : Type) [Group H] [MulDistribMulAction Γ H] : Prop :=
  ∀ (G E : Type) [Group G] [Group E] [Finite E] [MulDistribMulAction Γ G]
    [MulDistribMulAction Γ E] (π : E →*[Γ] G), 𝒦 E → 𝒦 G → Function.Surjective π →
    (Nat.card (π : E →* G).ker).Prime → (π : E →* G).ker ≤ Subgroup.center E →
    (∀ γ : Γ, ∀ z ∈ (π : E →* G).ker, γ • z = z) →
    (¬ ∃ s : G →*[Γ] E, ∀ g, π (s g) = g) →
    ∀ f : H →*[Γ] G, Function.Surjective f →
      ∃ f' : H →*[Γ] E, Function.Surjective f' ∧ ∀ h, π (f' h) = f h

/-- Property E passes to smaller classes containing `H` (RG.1, Property E at a level, (a)). -/
theorem HasPropertyE.mono {𝒦 𝒦' : (E : Type) → [Group E] → [MulDistribMulAction Γ E] → Prop}
    (h𝒦 : ∀ (E : Type) [Group E] [MulDistribMulAction Γ E], 𝒦' E → 𝒦 E)
    {H : Type} [Group H] [MulDistribMulAction Γ H] (hH : HasPropertyE Γ 𝒦 H) :
    HasPropertyE Γ 𝒦' H := by sorry

end PropertyE

section ChiefFactors

/-- A minimal non-trivial normal subgroup (the steps of a chief series, Liu–Wood §6). -/
def IsMinimalNormal {G : Type*} [Group G] (N : Subgroup G) : Prop :=
  N.Normal ∧ N ≠ ⊥ ∧ ∀ M : Subgroup G, M.Normal → M ≤ N → M = ⊥ ∨ M = N

theorem exists_isMinimalNormal_le {G : Type*} [Group G] [Finite G] (N : Subgroup G) [N.Normal]
    (hN : N ≠ ⊥) : ∃ M : Subgroup G, IsMinimalNormal M ∧ M ≤ N := by sorry

end ChiefFactors

/-! ### Unit tests (LWZB examples); `C3`, `C4` with `Γ = MulAut` act by `±1`. -/

/-- `Z/3`, on which `MulAut` is `{id, inversion}`, i.e. `Γ = Z/2` acting by inversion. -/
abbrev C3 := Multiplicative (ZMod 3)
/-- `Z/4` with `Γ = MulAut (Z/4) = {id, inversion}`. -/
abbrev C4 := Multiplicative (ZMod 4)

-- GammaGroup.test_inversion_Z3: fixed points 1, h_Γ = 3, |Sur_Γ| = 2.
example : FixedPoints.subgroup (MulAut C3) C3 = ⊥ := by sorry
example : hEnd (MulAut C3) C3 = 3 := by sorry
example : countSur (MulAut C3) C3 C3 = 2 := by sorry

-- yMap_test_inversion_Z3: |Y(Z/3)| = 3.
example : Nat.card (Set.range (yMap (MulAut C3) C3)) = 3 := by sorry

-- yMap_test_Z4: |Z/4| = |G^Γ| · |Y(G)| = 2 · 2.
example : Nat.card (FixedPoints.subgroup (MulAut C4) C4) = 2 := by sorry
example : Nat.card (Set.range (yMap (MulAut C4) C4)) = 2 := by sorry

-- CoprimeH1Trivial.test_Z2: `MulAut C3` has order 2, hence is solvable.
example : CoprimeH1Trivial (MulAut C3) := by sorry

end TauCeti.GammaGroup

namespace TauCeti.RandomGammaGroup

/-- The image of Haar probability under a continuous surjection onto a finite group is uniform
(the finite-level law of the random relations, RG.2). -/
theorem map_haarProb_uniform {G Q : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [CompactSpace G] [MeasurableSpace G] [BorelSpace G] [Group Q] [Finite Q] [TopologicalSpace Q]
    [DiscreteTopology Q] [MeasurableSpace Q]
    [MeasurableSingletonClass Q] (f : G →* Q) (hf : Continuous f) (hs : Function.Surjective f) :
    Measure.map f (TauCeti.haarProb G) = ProbabilityTheory.uniformOn Set.univ := by sorry

end TauCeti.RandomGammaGroup

namespace TauCeti.GammaGroup

/-- Liu–Wood Lemma 8.11: truncated products `∏_{i ≤ y_n} (1 - x_n a^{-i})` converge to a
continuous function of `lim x_n` when `y_n → ∞`. -/
theorem exists_tendsto_prod_one_sub {a : ℝ} (ha : 1 < a) :
    ∃ F : ℝ → ℝ, Continuous F ∧ ∀ (x : ℕ → ℝ) (x₀ : ℝ) (y : ℕ → ℕ),
      Tendsto x atTop (𝓝 x₀) → Tendsto y atTop atTop →
      Tendsto (fun n => ∏ i ∈ Finset.Icc 1 (y n), (1 - x n * (a ^ i)⁻¹)) atTop (𝓝 (F x₀)) := by
  sorry

end TauCeti.GammaGroup
