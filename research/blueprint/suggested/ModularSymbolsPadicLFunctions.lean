    Function.Injective fun f : CuspForm ((CongruenceSubgroup.Gamma1 N).map (mapGL ℝ)) ((k : ℤ) + 2) ↦
      toH1 (CongruenceSubgroup.Gamma1 N) (vkRep ℂ k _) ⟨periodSymbol _ k f, periodSymbol_mem _ k f⟩ :=
  sorry

