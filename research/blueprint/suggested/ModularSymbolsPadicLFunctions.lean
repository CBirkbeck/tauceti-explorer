    rw [sq_abs] at this
    omega
  have hp' : (5 : ℤ) ≤ p := by exact_mod_cast hp
  have h1 : (p : ℤ) ^ 2 ≤ (p : ℤ) ^ 2 * c ^ 2 := le_mul_of_one_le_right (sq_nonneg _) hc2
  have h2 : (p : ℤ) ^ 2 * c ^ 2 < 4 * p := by rw [← mul_pow]; exact hH
  have h3 : 5 * (p : ℤ) ≤ (p : ℤ) ^ 2 := by nlinarith
  linarith

