    ((conductorIdealSheaf f).comap f).subscheme ⟶ (conductorIdealSheaf f).subscheme :=
  ((conductorIdealSheaf f).comapIso f).hom ≫
    pullback.snd f (conductorIdealSheaf f).subschemeι

