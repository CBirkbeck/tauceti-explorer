lemma absoluteNormalizationComparisonSectionsAlgEquiv_symm_apply (a b : k)
    (U : (curve a b).Opens)
    (s : Γ(normalizationSource a b, normalization a b ⁻¹ᵁ U)) :
    (absoluteNormalizationComparisonSectionsAlgEquiv a b U).symm
