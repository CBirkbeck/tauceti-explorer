open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Overlap
variable {k : Type u} [Field k]

lemma infinity_denominator_ne_zero (a b : k) : InfinityChart.denominator a b ≠ 0 := by
  intro h
  have h0 := congrArg (fun p : k[X] => p.coeff 0) h
  simp [InfinityChart.denominator] at h0

lemma infinity_isDomain (a b : k) : IsDomain (InfinityChart.Chart a b) := by
  let := InfinityChart.localization a b
  exact IsLocalization.isDomain_of_le_nonZeroDivisors _
    (Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr (infinity_denominator_ne_zero a b)))

lemma overlap_isDomain (a b : k) : IsDomain (Ring (1 : k) a b) := by
  apply IsLocalization.isDomain_of_le_nonZeroDivisors (Ring (1 : k) a b)
    (Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr (show X * quadratic (1 : k) a b ≠ 0 from ?_)))
  apply mul_ne_zero X_ne_zero
  rw [quadratic_monic]
  exact Polynomial.Monic.ne_zero (by
    simpa [Polynomial.Monic] using
      (Polynomial.leadingCoeff_quadratic (a := (1 : k)) (b := a) (c := b) one_ne_zero))

lemma normalizationChart_surjective (a b : k) : Function.Surjective (normalizationChart a b) := by
  let := normalizationChart_isFinite a b
  have hi : IsIntegralHom (normalizationChart a b) := inferInstance
  exact (IsIntegralHom.SpecMap_iff.mp hi).comap_surjective Subtype.val_injective

lemma normalization_surjective (a b : k) : Function.Surjective (normalization a b) := by
  intro x
  rcases charts_cover a b x with ⟨y, rfl⟩ | ⟨y, rfl⟩
  · obtain ⟨z, rfl⟩ := normalizationChart_surjective a b y
    exact ⟨sourceFiniteι a b z, by
      rw [← Scheme.Hom.comp_apply, normalization_finite_chart, Scheme.Hom.comp_apply]⟩
  · exact ⟨sourceInfinityι a b y, by
      rw [← Scheme.Hom.comp_apply, normalization_infinity_chart]⟩

lemma finiteOpen_dense (a b : k) : DenseRange (finiteOpen a b) := by
  let := overlap_isDomain a b
  exact (finiteOpen a b).isOpenEmbedding.isOpenMap.denseRange_of_isPreirreducibleSpace _

lemma normalizationOpen_dense (a b : k) : DenseRange (normalizationOpen a b) := by
  let := overlap_isDomain a b
  exact (normalizationOpen a b).isOpenEmbedding.isOpenMap.denseRange_of_isPreirreducibleSpace _

lemma infinityι_dense (a b : k) : DenseRange (infinityι a b) := by
  intro x
  rcases charts_cover a b x with ⟨y, rfl⟩ | ⟨y, rfl⟩
  · apply closure_mono (s := (finiteι a b) '' Set.range (finiteOpen a b)) ?_
      ((finiteι a b).continuous.range_subset_closure_image_dense (finiteOpen_dense a b) ⟨y, rfl⟩)
    rintro _ ⟨_, ⟨z, rfl⟩, rfl⟩
    exact ⟨infinityOpen a b z, by
      rw [← Scheme.Hom.comp_apply, ← chart_condition, Scheme.Hom.comp_apply]⟩
  · exact subset_closure ⟨y, rfl⟩

lemma sourceInfinityι_dense (a b : k) : DenseRange (sourceInfinityι a b) := by
  intro x
  rcases source_charts_cover a b x with ⟨y, rfl⟩ | ⟨y, rfl⟩
  · apply closure_mono (s := (sourceFiniteι a b) '' Set.range (normalizationOpen a b)) ?_
      ((sourceFiniteι a b).continuous.range_subset_closure_image_dense (normalizationOpen_dense a b) ⟨y, rfl⟩)
    rintro _ ⟨_, ⟨z, rfl⟩, rfl⟩
    exact ⟨infinityOpen a b z, by
      rw [← Scheme.Hom.comp_apply, ← source_chart_condition, Scheme.Hom.comp_apply]⟩
  · exact subset_closure ⟨y, rfl⟩

lemma curve_isIntegral (a b : k) : AlgebraicGeometry.IsIntegral (curve a b) := by
  let := infinity_isDomain a b
  have hirr := (IrreducibleSpace.isIrreducible_univ (X := infinityChart a b)).image
    (infinityι a b) (infinityι a b).continuous.continuousOn
  rw [Set.image_univ] at hirr
  have : IrreducibleSpace (curve a b) := (irreducibleSpace_def _).mpr (by
    change IsIrreducible Set.univ
    rw [← (infinityι_dense a b).closure_range]; exact hirr.closure)
  let U : (curve a b).OpenCover := Scheme.Cover.mkOfCovers Bool
    (fun | false => finiteChart a b | true => infinityChart a b)
    (fun | false => finiteι a b | true => infinityι a b)
    (by intro x; rcases charts_cover a b x with ⟨y, hy⟩ | ⟨y, hy⟩
        · exact ⟨false, y, hy⟩
        · exact ⟨true, y, hy⟩)
    (by intro i; cases i <;> infer_instance)
  have : ∀ i, IsReduced (U.X i) := by
    intro i
    cases i
    · change IsReduced (finiteChart a b); infer_instance
    · change IsReduced (infinityChart a b); infer_instance
  have : IsReduced (curve a b) := IsReduced.of_openCover _ U
  exact isIntegral_of_irreducibleSpace_of_isReduced _

lemma source_isIntegral (a b : k) : AlgebraicGeometry.IsIntegral (normalizationSource a b) := by
  let := infinity_isDomain a b
  have hirr := (IrreducibleSpace.isIrreducible_univ (X := infinityChart a b)).image
    (sourceInfinityι a b) (sourceInfinityι a b).continuous.continuousOn
  rw [Set.image_univ] at hirr
  have : IrreducibleSpace (normalizationSource a b) := (irreducibleSpace_def _).mpr (by
    change IsIrreducible Set.univ
    rw [← (sourceInfinityι_dense a b).closure_range]; exact hirr.closure)
  let U : (normalizationSource a b).OpenCover := Scheme.Cover.mkOfCovers Bool
    (fun | false => Spec (.of k[X]) | true => infinityChart a b)
    (fun | false => sourceFiniteι a b | true => sourceInfinityι a b)
    (by intro x; rcases source_charts_cover a b x with ⟨y, hy⟩ | ⟨y, hy⟩
        · exact ⟨false, y, hy⟩
        · exact ⟨true, y, hy⟩)
    (by intro i; cases i <;> infer_instance)
  have : ∀ i, IsReduced (U.X i) := by
    intro i
    cases i
    · change IsReduced (Spec (.of k[X])); infer_instance
    · change IsReduced (infinityChart a b); infer_instance
  have : IsReduced (normalizationSource a b) := IsReduced.of_openCover _ U
  exact isIntegral_of_irreducibleSpace_of_isReduced _

def normalizationPartialIso (a b : k) : (normalizationSource a b).PartialIso (curve a b) where
  source := (sourceInfinityι a b).opensRange
  dense_source := sourceInfinityι_dense a b
  target := (infinityι a b).opensRange
  dense_target := infinityι_dense a b
  iso := (sourceInfinityι a b).isoOpensRange.symm ≪≫ (infinityι a b).isoOpensRange

lemma normalizationPartialIso_source (a b : k) :
    (normalizationPartialIso a b).source = (sourceInfinityι a b).opensRange := rfl
lemma normalizationPartialIso_target (a b : k) :
    (normalizationPartialIso a b).target = (infinityι a b).opensRange := rfl
lemma normalizationPartialIso_map (a b : k) :
    (normalizationPartialIso a b).iso.hom ≫ (normalizationPartialIso a b).target.ι =
      (normalizationPartialIso a b).source.ι ≫ normalization a b := by
  dsimp [normalizationPartialIso]
  rw [Category.assoc, Scheme.Hom.isoOpensRange_hom_ι, ← normalization_infinity_chart,
    ← Category.assoc, Scheme.Hom.isoOpensRange_inv_comp]
lemma normalizationPartialIso_over (a b : k) :
    (normalizationPartialIso a b).IsOver (normalization a b ≫ structureMap a b) (structureMap a b) := by
  change _ = _
  rw [← Category.assoc, normalizationPartialIso_map, Category.assoc]
lemma normalization_birationalOver (a b : k) :
    Scheme.BirationalOver (normalization a b ≫ structureMap a b) (structureMap a b) :=
  ⟨normalizationPartialIso a b, normalizationPartialIso_over a b⟩

lemma infinity_isIntegrallyClosed (a b : k) : IsIntegrallyClosed (InfinityChart.Chart a b) := by
  let := InfinityChart.localization a b
  exact isIntegrallyClosed_of_isLocalization _ _
    (Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr (infinity_denominator_ne_zero a b)))

lemma source_stalk_isIntegrallyClosed (a b : k) (x : normalizationSource a b) :
    IsIntegrallyClosed ((normalizationSource a b).presheaf.stalk x) := by
  let := infinity_isDomain a b
  let := infinity_isIntegrallyClosed a b
  have affine (R : CommRingCat.{u}) [IsDomain R] [IsIntegrallyClosed R] (y : Spec R) :
      IsIntegrallyClosed ((Spec R).presheaf.stalk y) := by
    let : y.asIdeal.IsPrime := y.isPrime
    have : IsIntegrallyClosed (Localization.AtPrime y.asIdeal) :=
      isIntegrallyClosed_of_isLocalization _ _ y.asIdeal.primeCompl_le_nonZeroDivisors
    exact IsIntegrallyClosed.of_equiv (Spec.stalkIso R y).symm.commRingCatIsoToRingEquiv
  rcases source_charts_cover a b x with ⟨y, rfl⟩ | ⟨y, rfl⟩
  · have := affine (.of k[X]) y
    exact IsIntegrallyClosed.of_equiv (asIso ((sourceFiniteι a b).stalkMap y)).symm.commRingCatIsoToRingEquiv
  · have := affine (.of (InfinityChart.Chart a b)) y
    exact IsIntegrallyClosed.of_equiv (asIso ((sourceInfinityι a b).stalkMap y)).symm.commRingCatIsoToRingEquiv

lemma normalizationPartialIso_inverse (a b : k) :
    (normalizationPartialIso a b).iso.inv ≫ (normalizationPartialIso a b).source.ι ≫ normalization a b =
      (normalizationPartialIso a b).target.ι := by
  rw [← normalizationPartialIso_map, Iso.inv_hom_id_assoc]

