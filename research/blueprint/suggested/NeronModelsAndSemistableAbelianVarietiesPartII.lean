namespace TauCeti.GenusOne.QuadraticPinch
variable {k : Type u} [Field k]

def polynomialProduct (a b : k) (z w : k[X] × k[X]) : k[X] × k[X] :=
  (z.1 * w.1 + (X ^ 3 - C b * X ^ 2) * z.2 * w.2,
   z.1 * w.2 + z.2 * w.1 - C a * X * z.2 * w.2)

lemma polynomialProduct_unit (a b : k) (z : k[X] × k[X]) :
    polynomialProduct a b (1, 0) z = z := by
  simp [polynomialProduct]

lemma polynomialCoordinates_mul (a b : k) (z w : k[X] × k[X]) :
    polynomialCoordinates a b (polynomialProduct a b z w) =
      polynomialCoordinates a b z * polynomialCoordinates a b w := by
  apply Subtype.ext
  simp only [polynomialCoordinates_coe, polynomialProduct, Subalgebra.coe_mul,
    Polynomial.add_comp, Polynomial.sub_comp, Polynomial.mul_comp,
    Polynomial.pow_comp, Polynomial.X_comp, Polynomial.C_comp]
  ring

lemma polynomialCoordinates_inverse_mul (a b : k)
    (f g : algebra (X ^ 2 + C a * X + C b)) :
    (polynomialCoordinates a b).symm (f * g) = polynomialProduct a b
      ((polynomialCoordinates a b).symm f) ((polynomialCoordinates a b).symm g) := by
  apply (polynomialCoordinates a b).injective
  simp [polynomialCoordinates_mul]

lemma polynomialBasis_zero_eq_one (a b : k) :
    polynomialBasis a b 0 = (1 : algebra (X ^ 2 + C a * X + C b)) := by
  apply Subtype.ext
  exact polynomialBasis_zero a b

lemma polynomialBasis_square (a b : k) :
    polynomialBasis a b 1 ^ 2 =
      algebraMap k[X] (algebra (X ^ 2 + C a * X + C b)) (X ^ 3 - C b * X ^ 2) -
        algebraMap k[X] (algebra (X ^ 2 + C a * X + C b)) (C a * X) *
          polynomialBasis a b 1 := by
  apply Subtype.ext
  change (polynomialBasis a b 1 : k[X]) ^ 2 =
    (parameterHom a b (X ^ 3 - C b * X ^ 2) : k[X]) -
      (parameterHom a b (C a * X) : k[X]) * (polynomialBasis a b 1 : k[X])
  simp only [parameterHom_coe, polynomialBasis_one,
    Polynomial.sub_comp, Polynomial.mul_comp, Polynomial.pow_comp,
    Polynomial.X_comp, Polynomial.C_comp]
  ring

variable {B : Type v} [CommRing B] [Algebra k[X] B]

def polynomialEvaluation (a b : k) (y : B) :
    algebra (X ^ 2 + C a * X + C b) →ₗ[k[X]] B :=
  { toFun := fun f =>
      algebraMap k[X] B ((polynomialCoordinates a b).symm f).1 +
        algebraMap k[X] B ((polynomialCoordinates a b).symm f).2 * y
    map_add' := by
      intro f g
      simp only [map_add, Prod.fst_add, Prod.snd_add]
      ring
    map_smul' := by
      intro P f
      change algebraMap k[X] B ((polynomialCoordinates a b).symm (P • f)).1 +
        algebraMap k[X] B ((polynomialCoordinates a b).symm (P • f)).2 * y =
        P • (algebraMap k[X] B ((polynomialCoordinates a b).symm f).1 +
          algebraMap k[X] B ((polynomialCoordinates a b).symm f).2 * y)
      rw [(polynomialCoordinates a b).symm.map_smul]
      simp only [Prod.smul_fst, Prod.smul_snd]
      simp only [smul_eq_mul]
      rw [Algebra.smul_def]
      change algebraMap k[X] B (P * ((polynomialCoordinates a b).symm f).1) +
        algebraMap k[X] B (P * ((polynomialCoordinates a b).symm f).2) * y =
        algebraMap k[X] B P *
          (algebraMap k[X] B ((polynomialCoordinates a b).symm f).1 +
            algebraMap k[X] B ((polynomialCoordinates a b).symm f).2 * y)
      rw [map_mul, map_mul]
      ring }

lemma polynomialEvaluation_apply (a b : k) (y : B) (z : k[X] × k[X]) :
    polynomialEvaluation a b y (polynomialCoordinates a b z) =
      algebraMap k[X] B z.1 + algebraMap k[X] B z.2 * y := by
  simp [polynomialEvaluation]

lemma polynomialEvaluation_parameter (a b : k) (y : B) (P : k[X]) :
    polynomialEvaluation a b y (parameterHom a b P) = algebraMap k[X] B P := by
  rw [parameterHom_coordinates, polynomialEvaluation_apply]
  simp

lemma polynomialEvaluation_mul (a b : k) (y : B)
    (hy : y ^ 2 = algebraMap k[X] B (X ^ 3 - C b * X ^ 2) -
      algebraMap k[X] B (C a * X) * y)
    (f g : algebra (X ^ 2 + C a * X + C b)) :
    polynomialEvaluation a b y (f * g) =
      polynomialEvaluation a b y f * polynomialEvaluation a b y g := by
  simp only [map_sub, map_mul] at hy
  simp only [polynomialEvaluation, LinearMap.coe_mk, AddHom.coe_mk,
    polynomialCoordinates_inverse_mul, polynomialProduct, map_add, map_sub, map_mul]
  linear_combination -algebraMap k[X] B ((polynomialCoordinates a b).symm f).2 *
    algebraMap k[X] B ((polynomialCoordinates a b).symm g).2 * hy

def polynomialLift (a b : k) (y : B)
    (hy : y ^ 2 = algebraMap k[X] B (X ^ 3 - C b * X ^ 2) -
      algebraMap k[X] B (C a * X) * y) :
    algebra (X ^ 2 + C a * X + C b) →ₐ[k[X]] B :=
  { toFun := polynomialEvaluation a b y
    map_zero' := map_zero _
    map_add' := map_add _
    map_one' := by
      rw [show (1 : algebra (X ^ 2 + C a * X + C b)) =
        polynomialCoordinates a b (1, 0) by
          rw [← parameterHom_coordinates]; exact (parameterHom a b).map_one.symm]
      simp [polynomialEvaluation_apply]
    map_mul' := polynomialEvaluation_mul a b y hy
    commutes' := by
      intro P
      change polynomialEvaluation a b y (parameterHom a b P) = _
      rw [parameterHom_coordinates, polynomialEvaluation_apply]
      simp }

lemma polynomialLift_apply (a b : k) (y : B)
    (hy : y ^ 2 = algebraMap k[X] B (X ^ 3 - C b * X ^ 2) -
      algebraMap k[X] B (C a * X) * y) (z : k[X] × k[X]) :
    polynomialLift a b y hy (polynomialCoordinates a b z) =
      algebraMap k[X] B z.1 + algebraMap k[X] B z.2 * y :=
  polynomialEvaluation_apply a b y z

lemma polynomialLift_basis (a b : k) (y : B)
    (hy : y ^ 2 = algebraMap k[X] B (X ^ 3 - C b * X ^ 2) -
      algebraMap k[X] B (C a * X) * y) :
    polynomialLift a b y hy (polynomialBasis a b 1) = y := by
  change polynomialLift a b y hy (polynomialCoordinates a b
    ((Module.Basis.finTwoProd k[X]) 1)) = y
  simp [polynomialLift_apply]

lemma polynomialLift_unique (a b : k) (y : B)
    (hy : y ^ 2 = algebraMap k[X] B (X ^ 3 - C b * X ^ 2) -
      algebraMap k[X] B (C a * X) * y)
    (F : algebra (X ^ 2 + C a * X + C b) →ₐ[k[X]] B)
    (hF : F (polynomialBasis a b 1) = y) : F = polynomialLift a b y hy := by
  ext f
  rw [← polynomialCoordinates_reconstruction a b f]
  simp only [Algebra.smul_def, polynomialBasis_zero_eq_one, mul_one, map_add,
    map_mul, AlgHom.commutes, hF, polynomialLift_basis]

lemma polynomialHom_relation (a b : k)
    (F : algebra (X ^ 2 + C a * X + C b) →ₐ[k[X]] B) :
    F (polynomialBasis a b 1) ^ 2 =
      algebraMap k[X] B (X ^ 3 - C b * X ^ 2) -
        algebraMap k[X] B (C a * X) * F (polynomialBasis a b 1) := by
  have h := congrArg F (polynomialBasis_square a b)
  simpa only [map_pow, map_sub, map_mul, AlgHom.commutes] using h

def polynomialHomEquivRoots (a b : k) :
    (algebra (X ^ 2 + C a * X + C b) →ₐ[k[X]] B) ≃
      {y : B // y ^ 2 = algebraMap k[X] B (X ^ 3 - C b * X ^ 2) -
        algebraMap k[X] B (C a * X) * y} where
  toFun F := ⟨F (polynomialBasis a b 1), polynomialHom_relation a b F⟩
  invFun y := polynomialLift a b y.1 y.2
  left_inv F := (polynomialLift_unique a b _ _ F rfl).symm
  right_inv y := Subtype.ext (polynomialLift_basis a b y.1 y.2)

lemma polynomialHomEquivRoots_apply (a b : k)
    (F : algebra (X ^ 2 + C a * X + C b) →ₐ[k[X]] B) :
    (polynomialHomEquivRoots a b F).1 = F (polynomialBasis a b 1) := rfl

lemma polynomialHomEquivRoots_symm_apply (a b : k)
    (y : {y : B // y ^ 2 = algebraMap k[X] B (X ^ 3 - C b * X ^ 2) -
      algebraMap k[X] B (C a * X) * y}) :
    (polynomialHomEquivRoots a b).symm y = polynomialLift a b y.1 y.2 := rfl

lemma polynomialHomEquivRoots_parameter (a b : k)
    (y : {y : B // y ^ 2 = algebraMap k[X] B (X ^ 3 - C b * X ^ 2) -
      algebraMap k[X] B (C a * X) * y}) (P : k[X]) :
    (polynomialHomEquivRoots a b).symm y (parameterHom a b P) =
      algebraMap k[X] B P :=
  ((polynomialHomEquivRoots a b).symm y).commutes P

-- test: QuadraticPinch.test_product_cusp
example : polynomialProduct (0 : k) 0 (0, 1) (0, 1) = (X ^ 3, 0) := by
  simp [polynomialProduct]

-- test: QuadraticPinch.test_product_char2
example : polynomialProduct (1 : ZMod 2) 1 (0, 1) (0, 1) =
    (X ^ 3 - X ^ 2, -X) := by
  simp [polynomialProduct]

-- test: QuadraticPinch.test_product_unit
example (a b : k) (z : k[X] × k[X]) : polynomialProduct a b (1, 0) z = z := by
  simp [polynomialProduct]

-- test: QuadraticPinch.test_evaluation_parameter
example (a b : k) (y : B) (P : k[X]) :
    polynomialEvaluation a b y (parameterHom a b P) = algebraMap k[X] B P := by
  rw [parameterHom_coordinates, polynomialEvaluation_apply]
  simp

-- test: QuadraticPinch.test_evaluation_zero
example (a b : k) (y : B) : polynomialEvaluation a b y 0 = 0 := map_zero _

-- test: QuadraticPinch.test_evaluation_second
example (a b : k) (y : B) : polynomialEvaluation a b y
    (polynomialCoordinates a b (0, 1)) = y := by
  simp [polynomialEvaluation_apply]

-- test: QuadraticPinch.test_lift_self
example (a b : k) :
    polynomialLift (B := algebra (X ^ 2 + C a * X + C b))
      a b (polynomialBasis a b 1) (polynomialBasis_square a b) =
      AlgHom.id k[X] (algebra (X ^ 2 + C a * X + C b)) := by
  symm
  exact polynomialLift_unique a b _ _ _ rfl

-- test: QuadraticPinch.test_lift_root
example (a b : k) (y : B)
    (hy : y ^ 2 = algebraMap k[X] B (X ^ 3 - C b * X ^ 2) -
      algebraMap k[X] B (C a * X) * y) :
    polynomialLift a b y hy (polynomialBasis a b 1) = y :=
  polynomialLift_basis a b y hy

-- test: QuadraticPinch.test_lift_unique
example (a b : k) (y : B)
    (hy : y ^ 2 = algebraMap k[X] B (X ^ 3 - C b * X ^ 2) -
      algebraMap k[X] B (C a * X) * y)
    (F : algebra (X ^ 2 + C a * X + C b) →ₐ[k[X]] B)
    (hF : F (polynomialBasis a b 1) = y) : F = polynomialLift a b y hy :=
  polynomialLift_unique a b y hy F hF

-- test: QuadraticPinch.test_hom_roots_forward_inverse
example (a b : k)
    (y : {y : B // y ^ 2 = algebraMap k[X] B (X ^ 3 - C b * X ^ 2) -
      algebraMap k[X] B (C a * X) * y}) :
    polynomialHomEquivRoots a b ((polynomialHomEquivRoots a b).symm y) = y :=
  (polynomialHomEquivRoots a b).apply_symm_apply y

-- test: QuadraticPinch.test_hom_roots_inverse_forward
example (a b : k) (F : algebra (X ^ 2 + C a * X + C b) →ₐ[k[X]] B) :
    (polynomialHomEquivRoots a b).symm (polynomialHomEquivRoots a b F) = F :=
  (polynomialHomEquivRoots a b).symm_apply_apply F

-- test: QuadraticPinch.test_hom_roots_parameter
example (a b : k)
    (y : {y : B // y ^ 2 = algebraMap k[X] B (X ^ 3 - C b * X ^ 2) -
      algebraMap k[X] B (C a * X) * y}) (P : k[X]) :
    (polynomialHomEquivRoots a b).symm y (parameterHom a b P) =
      algebraMap k[X] B P :=
  ((polynomialHomEquivRoots a b).symm y).commutes P

