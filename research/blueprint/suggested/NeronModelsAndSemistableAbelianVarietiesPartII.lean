def relativeNormalizationIso (a b : k) : normalizationSource a b ≅ relativeNormalization a b :=
  letI := toRelativeNormalization_isIso a b
  asIso (toRelativeNormalization a b)

lemma relativeNormalization_factorization (a b : k) :
    toRelativeNormalization a b ≫ fromRelativeNormalization a b = normalization a b := by
  let := normalization_isFinite a b
  exact (normalization a b).toNormalization_fromNormalization

