  sorry

lemma normalizationFunctionFieldAlgEquiv_coefficient (a b : k)
    (U : (curve a b).Opens) [Nonempty U] (r : Γ(curve a b, U)) :
    normalizationFunctionFieldAlgEquiv a b U ((curve a b).germToFunctionField U r) =
