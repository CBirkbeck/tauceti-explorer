namespace TauCeti.GenusOne.FerrandPushout
variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]

lemma conductor_mem_iff_generators (n : ℕ) (g : Fin n → B)
    (hg : Submodule.span A (Set.range g) = ⊤) (a : A) :
    a ∈ ((algebraMap A B).range.conductor).comap (algebraMap A B) ↔
      ∀ i, algebraMap A B a * g i ∈ (algebraMap A B).range := by sorry

lemma conductor_common_denominator (n : ℕ) (g : Fin n → B)
    (hg : Submodule.span A (Set.range g) = ⊤) (S : Submonoid A) (a : A) :
    (∀ i, ∃ s ∈ S, algebraMap A B (s * a) * g i ∈ (algebraMap A B).range) ↔
      ∃ s ∈ S, s * a ∈ ((algebraMap A B).range.conductor).comap (algebraMap A B) := by sorry

lemma conductor_fraction_mem_iff_generators (n : ℕ) (g : Fin n → B)
    (hg : Submodule.span A (Set.range g) = ⊤) (S : Submonoid A)
    (L : Type u) [CommRing L] [Algebra A L] [IsLocalization S L] (a : A) (t : S) :
    IsLocalization.mk' L a t ∈
      (((algebraMap A B).range.conductor).comap (algebraMap A B)).map (algebraMap A L) ↔
      ∀ i, ∃ s ∈ S, algebraMap A B (s * a) * g i ∈ (algebraMap A B).range := by sorry

end TauCeti.GenusOne.FerrandPushout

