lemma quadratic_normalization_inclusion_not_surjective (a b : k) :
    ¬ Function.Surjective
      ((algebra (Polynomial.X ^ 2 + Polynomial.C a * Polynomial.X + Polynomial.C b)).val) := by
  intro h
  obtain ⟨f, hf⟩ := h Polynomial.X
  have hmem : Polynomial.X ∈
      algebra (Polynomial.X ^ 2 + Polynomial.C a * Polynomial.X + Polynomial.C b) :=
    hf ▸ f.property
  apply normalization_quotient_generator_ne_zero
    (Polynomial.X ^ 2 + Polynomial.C a * Polynomial.X + Polynomial.C b)
    (by simpa [Polynomial.Monic] using (Polynomial.leadingCoeff_quadratic
      (a := a) (b := b) (c := (1 : k)) one_ne_zero)) (quadratic_natDegree a b)
  rw [Submodule.Quotient.mk_eq_zero, normalization_image_span]
  exact hmem

