namespace TauCeti.GenusOne.QuadraticPinch.Global
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
noncomputable section
variable {k : Type u} [Field k]

lemma normalization_schemeTheoreticallyDominant (a b : k) :
    IsSchemeTheoreticallyDominant (normalization a b) := by
  let := curve_isIntegral a b
  let : IsDominant (normalization a b) :=
    ⟨(normalization_surjective a b).denseRange⟩
  exact IsSchemeTheoreticallyDominant.of_isDominant _

lemma normalization_kernel (a b : k) : (normalization a b).ker = ⊥ := by
  let := normalization_schemeTheoreticallyDominant a b
  exact (normalization a b).ker_eq_bot

lemma normalization_sections_injective (a b : k) (U : (curve a b).Opens) :
    Function.Injective ((normalization a b).app U) := by
  let := normalization_isFinite a b
  let := normalization_schemeTheoreticallyDominant a b
  exact (normalization a b).app_injective U

lemma normalization_flat_pullback_schemeTheoreticallyDominant
    (a b : k) {T : Scheme.{u}} (g : T ⟶ curve a b) [Flat g] :
    IsSchemeTheoreticallyDominant (pullback.snd (normalization a b) g) := by
  let := normalization_isFinite a b
  let := normalization_schemeTheoreticallyDominant a b
  infer_instance

lemma normalization_flat_pullback_kernel
    (a b : k) {T : Scheme.{u}} (g : T ⟶ curve a b) [Flat g] :
    (pullback.snd (normalization a b) g).ker = ⊥ := by
  let := normalization_flat_pullback_schemeTheoreticallyDominant a b g
  exact (pullback.snd (normalization a b) g).ker_eq_bot

/-- Relative integral factorization of the specified finite map, not the absolute
normalization of the curve in a generic-point function field. -/
def relativeNormalization (a b : k) : Scheme.{u} :=
  letI := normalization_isFinite a b
  (normalization a b).normalization

def toRelativeNormalization (a b : k) : normalizationSource a b ⟶ relativeNormalization a b :=
  letI := normalization_isFinite a b
  (normalization a b).toNormalization

def fromRelativeNormalization (a b : k) : relativeNormalization a b ⟶ curve a b :=
  letI := normalization_isFinite a b
  (normalization a b).fromNormalization

lemma toRelativeNormalization_isIso (a b : k) : IsIso (toRelativeNormalization a b) := by
  let := normalization_isFinite a b
  exact inferInstanceAs (IsIso (normalization a b).toNormalization)

/-- Comparison for the relative integral factorization of the existing map. -/
def relativeNormalizationIso (a b : k) : normalizationSource a b ≅ relativeNormalization a b :=
  letI := toRelativeNormalization_isIso a b
  asIso (toRelativeNormalization a b)

lemma relativeNormalization_factorization (a b : k) :
    toRelativeNormalization a b ≫ fromRelativeNormalization a b = normalization a b := by
  let := normalization_isFinite a b
  exact (normalization a b).toNormalization_fromNormalization

lemma relativeNormalizationIso_hom (a b : k) :
    (relativeNormalizationIso a b).hom = toRelativeNormalization a b := rfl

lemma relativeNormalizationIso_inv_from (a b : k) :
    (relativeNormalizationIso a b).inv ≫ normalization a b = fromRelativeNormalization a b := by
  rw [← relativeNormalization_factorization, ← relativeNormalizationIso_hom,
    Iso.inv_hom_id_assoc]

/-- The actual affine section comparison to the integral closure inside ν_*O_N. -/
def relativeNormalizationSectionsIso (a b : k) (U : (curve a b).Opens)
    (hU : IsAffineOpen U) :
    (letI := ((normalization a b).app U).hom.toAlgebra
     Γ(relativeNormalization a b, fromRelativeNormalization a b ⁻¹ᵁ U) ≅
       CommRingCat.of (integralClosure Γ(curve a b, U)
         Γ(normalizationSource a b, normalization a b ⁻¹ᵁ U))) := by
  let := normalization_isFinite a b
  exact (normalization a b).normalizationObjIso hU

/-- The specified integral-factorization map from Mathlib relative normalization. -/
def relativeNormalizationDesc (a b : k) {T : Scheme.{u}}
    (f : normalizationSource a b ⟶ T) (g : T ⟶ curve a b) [IsIntegralHom g]
    (h : normalization a b = f ≫ g) : relativeNormalization a b ⟶ T := by
  let := normalization_isFinite a b
  exact (normalization a b).normalizationDesc f g h

lemma toRelativeNormalization_desc (a b : k) {T : Scheme.{u}}
    (f : normalizationSource a b ⟶ T) (g : T ⟶ curve a b) [IsIntegralHom g]
    (h : normalization a b = f ≫ g) :
    toRelativeNormalization a b ≫ relativeNormalizationDesc a b f g h = f := by
  let := normalization_isFinite a b
  exact (normalization a b).toNormalization_normalizationDesc f g h

lemma relativeNormalizationDesc_from (a b : k) {T : Scheme.{u}}
    (f : normalizationSource a b ⟶ T) (g : T ⟶ curve a b) [IsIntegralHom g]
    (h : normalization a b = f ≫ g) :
    relativeNormalizationDesc a b f g h ≫ g = fromRelativeNormalization a b := by
  let := normalization_isFinite a b
  exact (normalization a b).normalizationDesc_comp f g h

lemma relativeNormalizationDesc_eq (a b : k) {T : Scheme.{u}}
    (f : normalizationSource a b ⟶ T) (g : T ⟶ curve a b) [IsIntegralHom g]
    (h : normalization a b = f ≫ g) :
    relativeNormalizationDesc a b f g h = (relativeNormalizationIso a b).inv ≫ f := by
  apply (cancel_epi (relativeNormalizationIso a b).hom).mp
  rw [Iso.hom_inv_id_assoc, relativeNormalizationIso_hom, toRelativeNormalization_desc]

lemma relativeNormalizationDesc_unique (a b : k) {T : Scheme.{u}}
    (f : normalizationSource a b ⟶ T) (g : T ⟶ curve a b) [IsIntegralHom g]
    (h : normalization a b = f ≫ g) (j : relativeNormalization a b ⟶ T)
    (hj : toRelativeNormalization a b ≫ j = f) :
    j = relativeNormalizationDesc a b f g h := by
  apply (cancel_epi (relativeNormalizationIso a b).hom).mp
  rw [relativeNormalizationIso_hom, hj, toRelativeNormalization_desc]

lemma relativeNormalizationSectionsIso_hom_inv (a b : k) (U : (curve a b).Opens)
    (hU : IsAffineOpen U) :
    (relativeNormalizationSectionsIso a b U hU).hom ≫
      (relativeNormalizationSectionsIso a b U hU).inv = 𝟙 _ := by
  exact Iso.hom_inv_id _

lemma relativeNormalizationSectionsIso_inv_hom (a b : k) (U : (curve a b).Opens)
    (hU : IsAffineOpen U) :
    (relativeNormalizationSectionsIso a b U hU).inv ≫
      (relativeNormalizationSectionsIso a b U hU).hom = 𝟙 _ := by
  exact Iso.inv_hom_id _

lemma relativeNormalizationSectionsIso_cancel (a b : k) (U : (curve a b).Opens)
    (hU : IsAffineOpen U)
    (f g : Γ(relativeNormalization a b, fromRelativeNormalization a b ⁻¹ᵁ U) ⟶
      Γ(relativeNormalization a b, fromRelativeNormalization a b ⁻¹ᵁ U)) :
    f ≫ (relativeNormalizationSectionsIso a b U hU).hom =
      g ≫ (relativeNormalizationSectionsIso a b U hU).hom ↔ f = g := by
  exact cancel_mono _

end
end TauCeti.GenusOne.QuadraticPinch.Global

namespace TauCeti.GenusOne.QuadraticPinch
noncomputable section
variable {k : Type u} [Field k]

lemma quadratic_normalization_inclusion_not_surjective (a b : k) :
    ¬ Function.Surjective
      ((algebra (Polynomial.X ^ 2 + Polynomial.C a * Polynomial.X + Polynomial.C b)).val) := by
  intro h
  obtain ⟨f, hf⟩ := h Polynomial.X
  have hmem : Polynomial.X ∈
      algebra (Polynomial.X ^ 2 + Polynomial.C a * Polynomial.X + Polynomial.C b) :=
    hf ▸ f.property
  apply normalization_quotient_generator_ne_zero
    (Polynomial.X ^ 2 + Polynomial.C a * Polynomial.X + Polynomial.C b)
    (by simpa [Polynomial.Monic] using (Polynomial.leadingCoeff_quadratic
      (a := a) (b := b) (c := (1 : k)) one_ne_zero)) (quadratic_natDegree a b)
  rw [Submodule.Quotient.mk_eq_zero, normalization_image_span]
  exact hmem

end
end TauCeti.GenusOne.QuadraticPinch

namespace TauCeti.GenusOne.QuadraticPinch.Global
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
noncomputable section
variable {k : Type u} [Field k]

-- test: QuadraticPinch.Global.test_relativeNormalization_cusp
example : toRelativeNormalization (0 : k) 0 ≫ fromRelativeNormalization 0 0 = normalization 0 0 := by exact relativeNormalization_factorization 0 0

-- test: QuadraticPinch.Global.test_relativeNormalization_char2
example : toRelativeNormalization (1 : ZMod 2) 1 ≫ fromRelativeNormalization 1 1 = normalization 1 1 := by exact relativeNormalization_factorization 1 1

-- test: QuadraticPinch.Global.test_relativeNormalization_iso
example (a b : k) : IsIso (toRelativeNormalization a b) := by exact toRelativeNormalization_isIso a b

-- test: QuadraticPinch.Global.test_toRelativeNormalization_cusp
example : toRelativeNormalization (0 : k) 0 ≫ fromRelativeNormalization 0 0 = normalization 0 0 := by exact relativeNormalization_factorization 0 0

-- test: QuadraticPinch.Global.test_toRelativeNormalization_char2
example : toRelativeNormalization (1 : ZMod 2) 1 ≫ fromRelativeNormalization 1 1 = normalization 1 1 := by exact relativeNormalization_factorization 1 1

-- test: QuadraticPinch.Global.test_toRelativeNormalization_descent
example (a b : k) {T : Scheme.{u}} (f : normalizationSource a b ⟶ T) (g : T ⟶ curve a b) [IsIntegralHom g] (h : normalization a b = f ≫ g) : toRelativeNormalization a b ≫ relativeNormalizationDesc a b f g h = f := by exact toRelativeNormalization_desc a b f g h

-- test: QuadraticPinch.Global.test_fromRelativeNormalization_cusp
example : toRelativeNormalization (0 : k) 0 ≫ fromRelativeNormalization 0 0 = normalization 0 0 := by exact relativeNormalization_factorization 0 0

-- test: QuadraticPinch.Global.test_fromRelativeNormalization_char2
example : toRelativeNormalization (1 : ZMod 2) 1 ≫ fromRelativeNormalization 1 1 = normalization 1 1 := by exact relativeNormalization_factorization 1 1

-- test: QuadraticPinch.Global.test_fromRelativeNormalization_inverse
example (a b : k) : (relativeNormalizationIso a b).inv ≫ normalization a b = fromRelativeNormalization a b := by exact relativeNormalizationIso_inv_from a b

-- test: QuadraticPinch.Global.test_iso_forward
example (a b : k) : (relativeNormalizationIso a b).hom = toRelativeNormalization a b := by exact relativeNormalizationIso_hom a b

-- test: QuadraticPinch.Global.test_iso_cusp_left
example : (relativeNormalizationIso (0 : k) 0).hom ≫ (relativeNormalizationIso 0 0).inv = 𝟙 _ := by exact Iso.hom_inv_id _

-- test: QuadraticPinch.Global.test_iso_char2_right
example : (relativeNormalizationIso (1 : ZMod 2) 1).inv ≫ (relativeNormalizationIso 1 1).hom = 𝟙 _ := by exact Iso.inv_hom_id _

-- test: QuadraticPinch.Global.test_sections_left
example (a b : k) (U : (curve a b).Opens) (hU : IsAffineOpen U) : (relativeNormalizationSectionsIso a b U hU).hom ≫ (relativeNormalizationSectionsIso a b U hU).inv = 𝟙 _ := by exact relativeNormalizationSectionsIso_hom_inv a b U hU

-- test: QuadraticPinch.Global.test_sections_cusp_right
example (U : (curve (0 : k) 0).Opens) (hU : IsAffineOpen U) : (relativeNormalizationSectionsIso (0 : k) 0 U hU).inv ≫ (relativeNormalizationSectionsIso 0 0 U hU).hom = 𝟙 _ := by exact relativeNormalizationSectionsIso_inv_hom 0 0 U hU

-- test: QuadraticPinch.Global.test_sections_char2_right
example (U : (curve (1 : ZMod 2) 1).Opens) (hU : IsAffineOpen U) : (relativeNormalizationSectionsIso (1 : ZMod 2) 1 U hU).inv ≫ (relativeNormalizationSectionsIso 1 1 U hU).hom = 𝟙 _ := by exact relativeNormalizationSectionsIso_inv_hom 1 1 U hU

-- test: QuadraticPinch.Global.test_desc_source
example (a b : k) {T : Scheme.{u}} (f : normalizationSource a b ⟶ T) (g : T ⟶ curve a b) [IsIntegralHom g] (h : normalization a b = f ≫ g) : toRelativeNormalization a b ≫ relativeNormalizationDesc a b f g h = f := by exact toRelativeNormalization_desc a b f g h

-- test: QuadraticPinch.Global.test_desc_target
example (a b : k) {T : Scheme.{u}} (f : normalizationSource a b ⟶ T) (g : T ⟶ curve a b) [IsIntegralHom g] (h : normalization a b = f ≫ g) : relativeNormalizationDesc a b f g h ≫ g = fromRelativeNormalization a b := by exact relativeNormalizationDesc_from a b f g h

-- test: QuadraticPinch.Global.test_desc_unique
example (a b : k) {T : Scheme.{u}} (f : normalizationSource a b ⟶ T) (g : T ⟶ curve a b) [IsIntegralHom g] (h : normalization a b = f ≫ g) (j : relativeNormalization a b ⟶ T) (hj : toRelativeNormalization a b ≫ j = f) : j = relativeNormalizationDesc a b f g h := by exact relativeNormalizationDesc_unique a b f g h j hj

-- test: QuadraticPinch.Global.test_sections_cusp_injective
example (U : (curve (0 : k) 0).Opens) : Function.Injective ((normalization (0 : k) 0).app U) := by exact normalization_sections_injective 0 0 U

-- test: QuadraticPinch.Global.test_flat_pullback_kernel
example (a b : k) {T : Scheme.{u}} (g : T ⟶ curve a b) [Flat g] : (pullback.snd (normalization a b) g).ker = ⊥ := by exact normalization_flat_pullback_kernel a b g

end
end TauCeti.GenusOne.QuadraticPinch.Global

namespace TauCeti.GenusOne.QuadraticPinch
