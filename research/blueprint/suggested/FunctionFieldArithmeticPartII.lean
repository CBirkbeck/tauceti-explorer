    e.inv ≫ q.normalizationSpecMap = pullback.fst _ _ ∧
    e.inv ≫ p.normalizationChangeSpecMap (χ.comp (ψ.comp φ)) = pullback.snd _ _ ≫ pullback.snd _ _ ≫ pullback.snd _ _ ∧
    e.hom ≫ e.inv = 𝟙 _ ∧ e.inv ≫ e.hom = 𝟙 _ := by
