example (φ : A →+* B) (x : FactorialAffineColimit (1 : A)) :
    factorialQZTensorCoefficientMap φ (1 : A) (factorialQZCoaction (1 : A) x) =
      factorialQZCoaction (φ 1) (factorialCoefficientMap φ (1 : A) x) := by
