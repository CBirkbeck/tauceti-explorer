example (φ : A →+* B) (f a : A) :
    factorialQZCoaction (φ f) (factorialCoefficientMap φ f (algebraMap A _ a)) =
      (1 : MonoidAlgebra B (Multiplicative (AddCircle (1 : ℚ)))) ⊗ₜ[B]
        factorialCoefficientMap φ f (algebraMap A _ a) := by
