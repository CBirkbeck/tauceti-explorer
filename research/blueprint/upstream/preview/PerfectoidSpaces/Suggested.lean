/-! ### Layer 5: Coherence and stable full subcategories -/
namespace CategoryTheory
universe v u w
variable {J : Type u} [SmallCategory J] [hJ : IsFiltered J]
  (F : Pseudofunctor (LocallyDiscrete J) Cat.{v, w})
namespace FilteredTwoColimit

theorem ι_map (i : J) {x y : F.obj ⟨i⟩} (f : x ⟶ y) :
    HEq ((ι F i).map f)
      ((filteredTransitionArrows F).Q.map
        (show (⟨i, x⟩ : Pseudofunctor.Grothendieck F) ⟶ ⟨i, y⟩ from
          ⟨𝟙 i, (F.mapId ⟨i⟩).hom.toNatTrans.app x ≫ f⟩)) := sorry

theorem ιCompIso_id (i : J) (x : F.obj ⟨i⟩) :
    (ιCompIso F (𝟙 i)).hom.app x =
      (ι F i).map ((F.mapId ⟨i⟩).hom.toNatTrans.app x) := sorry

theorem ιCompIso_comp {i j k : J} (a : i ⟶ j) (b : j ⟶ k) (x : F.obj ⟨i⟩) :
    (ιCompIso F (a ≫ b)).hom.app x =
      (ι F k).map ((F.mapComp a.toLoc b.toLoc).hom.toNatTrans.app x) ≫
        (ιCompIso F b).hom.app ((F.map ⟨a⟩).toFunctor.obj x) ≫ (ιCompIso F a).hom.app x := sorry

theorem ιCompDescIso_coherence {C : Type w} [Category.{v} C]
    (G : Pseudofunctor.StrongTrans F ((Functor.const J).obj (Cat.of C)).toPseudofunctor')
    {i j : J} (a : i ⟶ j) (x : F.obj ⟨i⟩) :
    (desc F G).map ((ιCompIso F a).hom.app x) ≫ (ιCompDescIso F G i).hom.app x =
      (ιCompDescIso F G j).hom.app ((F.map ⟨a⟩).toFunctor.obj x) ≫
        (G.naturality ⟨a⟩).hom.toNatTrans.app x := sorry

/-- Restrict to full subcategories stable under all transition functors. -/
def fullSubdiagram (P : ∀ j : J, ObjectProperty (F.obj ⟨j⟩))
    (hP : ∀ {i j} (a : i ⟶ j) (x : F.obj ⟨i⟩), P i x → P j ((F.map ⟨a⟩).toFunctor.obj x)) :
    Pseudofunctor (LocallyDiscrete J) Cat.{v, w} where
  obj j := Cat.of (P j.as).FullSubcategory
  map a := { toFunctor := {
    obj := fun x ↦ ⟨(F.map a).toFunctor.obj x.obj, hP a.as x.obj x.property⟩
    map := fun f ↦ ObjectProperty.homMk ((F.map a).toFunctor.map f.hom)
    map_id := by sorry
    map_comp := by sorry } }
  map₂ := by sorry
  map₂_id := by sorry
  map₂_comp := by sorry
  mapId := by sorry
  mapComp := by sorry
  map₂_whisker_left := by sorry
  map₂_whisker_right := by sorry
  map₂_associator := by sorry
  map₂_left_unitor := by sorry
  map₂_right_unitor := by sorry

/-- Full subcategories need not be replete: objects remain tagged by their original stage. -/
def fullSubcategory {J : Type u} [SmallCategory J] [IsFiltered J]
    (F : Pseudofunctor (LocallyDiscrete J) Cat.{v, w}) (P : ∀ j : J, ObjectProperty (F.obj ⟨j⟩))
    (hP : ∀ {i j} (a : i ⟶ j) (x : F.obj ⟨i⟩), P i x → P j ((F.map ⟨a⟩).toFunctor.obj x)) :
    FilteredTwoColimit (fullSubdiagram F P hP) ≌
      ObjectProperty.FullSubcategory (fun z : FilteredTwoColimit F ↦
        ∃ (i : J) (x : F.obj ⟨i⟩), P i x ∧ z = (ι F i).obj x) := sorry

end FilteredTwoColimit
end CategoryTheory

/-! ### Layer 5: Integral quotients and uncompleted comparisons -/
namespace Perfectoid
universe u
variable (p : ℕ) [Fact p.Prime] {J : Type u} [SmallCategory J] [hJ : IsFiltered J]
  (D : J ⥤ PairCat.{u} p) (j₀ : J) (ϖ : PseudoUniformizerRoots p (D.obj j₀))

namespace completedColimit
/-- On a tail, the distinguished elements are genuinely compatible before taking the colimit. -/
def quotientDiagram (t : ∀ j, (D.obj j).pair.plus)
    (ht : ∀ {i j} (a : i ⟶ j), (plusDiagram p D).map a (t i) = t j) (n : ℕ) :
    J ⥤ CommRingCat.{u} where
  obj j := CommRingCat.of ((D.obj j).pair.plus ⧸ Ideal.span {t j ^ n})
  map a := CommRingCat.ofHom (Ideal.Quotient.lift _
    ((Ideal.Quotient.mk _).comp ((plusDiagram p D).map a).hom) (by sorry))
  map_id := by sorry
  map_comp := by sorry

/-- Reduction commutes with completion and with the filtered colimit. -/
def plusQuotientEquiv (t : ∀ j, (D.obj j).pair.plus)
    (ht : ∀ {i j} (a : i ⟶ j), (plusDiagram p D).map a (t i) = t j)
    (h₀ : t j₀ = uniformizer p D j₀ ϖ) (n : ℕ) (hn : 0 < n) :
    (↥(colimit (quotientDiagram p D t ht n))) ≃+*
      completedColimitPlus p D j₀ ϖ ⧸ Ideal.span {
        (⟨(ι p D j₀ ϖ j₀).toRingHom (t j₀),
          (ι p D j₀ ϖ j₀).map_mem_plus _ (t j₀).property⟩ :
            completedColimitPlus p D j₀ ϖ) ^ n} := sorry

theorem plusQuotientEquiv_ι (t : ∀ j, (D.obj j).pair.plus)
    (ht : ∀ {i j} (a : i ⟶ j), (plusDiagram p D).map a (t i) = t j)
    (h₀ : t j₀ = uniformizer p D j₀ ϖ) (n : ℕ) (hn : 0 < n)
    (j : J) (x : (D.obj j).pair.plus) :
    plusQuotientEquiv p D j₀ ϖ t ht h₀ n hn
      (colimit.ι (quotientDiagram p D t ht n) j (Ideal.Quotient.mk _ x)) =
    Ideal.Quotient.mk _ ⟨(ι p D j₀ ϖ j).toRingHom x,
      (ι p D j₀ ϖ j).map_mem_plus _ x.property⟩ := sorry

-- Check: quotientDiagram_zero
example (t : ∀ j, (D.obj j).pair.plus)
    (ht : ∀ {i j} (a : i ⟶ j), (plusDiagram p D).map a (t i) = t j) (j : J) :
    Subsingleton ((quotientDiagram p D t ht 0).obj j) := sorry
-- Check: quotientDiagram_unit
example (t : ∀ j, (D.obj j).pair.plus)
    (ht : ∀ {i j} (a : i ⟶ j), (plusDiagram p D).map a (t i) = t j)
    (j : J) (hj : IsUnit (t j)) (n : ℕ) :
    Subsingleton ((quotientDiagram p D t ht n).obj j) := sorry
-- Check: quotientDiagram_zero_element
example (t : ∀ j, (D.obj j).pair.plus)
    (ht : ∀ {i j} (a : i ⟶ j), (plusDiagram p D).map a (t i) = t j)
    (j : J) (hj : t j = 0) (n : ℕ) (hn : 0 < n) :
    Function.Bijective (Ideal.Quotient.mk (Ideal.span {t j ^ n})) := sorry
end completedColimit
end Perfectoid

namespace PerfectoidSpace
open Perfectoid TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime] {I : Type} [SmallCategory I] [hI : IsCofiltered I]
  (X : I ⥤ Perfd p) (hX : ∀ i, IsAffinoidPerfectoid p (X.obj i).obj)

/-- Actual global sections and restriction homomorphisms form the ring diagram. -/
def sectionsDiagram : Iᵒᵖ ⥤ CommRingCat.{1} where
  obj i := CommRingCat.of (globalSections p (X.obj i.unop))
  map a := CommRingCat.ofHom (globalPullback p (X.map a.unop))
  map_id := by sorry
  map_comp := by sorry

def plusSectionsDiagram : Iᵒᵖ ⥤ CommRingCat.{1} where
  obj i := CommRingCat.of (globalPlus p (X.obj i.unop))
  map a := CommRingCat.ofHom ((globalPullback p (X.map a.unop)).restrict _ _
    (fun x hx ↦ globalPullback_plus p (X.map a.unop) ⟨x, hx⟩))
  map_id := by sorry
  map_comp := by sorry

local instance : Fact (Cardinal.aleph.{0} 1).IsRegular := ⟨Cardinal.isRegular_aleph_one⟩
/-- ECD 6.5: under countable directedness the global ring colimit needs no completion. -/
def cofilteredLimit.globalSections_of_isCardinalFiltered
    [IsCardinalFiltered Iᵒᵖ (Cardinal.aleph.{0} 1)] :
    (↥(colimit (sectionsDiagram p X))) ≃+* globalSections p (cofilteredLimit p X hX) := sorry

theorem cofilteredLimit.globalSections_of_isCardinalFiltered_ι
    [IsCardinalFiltered Iᵒᵖ (Cardinal.aleph.{0} 1)] (i : I) (x : globalSections p (X.obj i)) :
    cofilteredLimit.globalSections_of_isCardinalFiltered p X hX
      (colimit.ι (sectionsDiagram p X) (op i) x) =
    globalPullback p (cofilteredLimit.π p X hX i) x := sorry

def cofilteredLimit.globalPlus_of_isCardinalFiltered
    [IsCardinalFiltered Iᵒᵖ (Cardinal.aleph.{0} 1)] :
    (↥(colimit (plusSectionsDiagram p X))) ≃+* globalPlus p (cofilteredLimit p X hX) := sorry

theorem cofilteredLimit.globalPlus_of_isCardinalFiltered_ι
    [IsCardinalFiltered Iᵒᵖ (Cardinal.aleph.{0} 1)] (i : I) (x : globalPlus p (X.obj i)) :
    (cofilteredLimit.globalPlus_of_isCardinalFiltered p X hX
      (colimit.ι (plusSectionsDiagram p X) (op i) x)).val =
    globalPullback p (cofilteredLimit.π p X hX i) x.val := sorry

theorem cofilteredLimit.baseChangeHomeomorph_apply (i : I) {Y : Perfd p} (g : Y ⟶ X.obj i)
    (hY : CompactSpace (underlyingPoints p Y) ∧ QuasiSeparatedSpace (underlyingPoints p Y))
    (x : underlyingPoints p (pullback g (cofilteredLimit.π p X hX i))) (a : Over i) :
    (cofilteredLimit.baseChangeHomeomorph p X hX i g hY x).val a =
      pointMap p ((cofilteredLimit.baseChangeCone p X hX i g).π.app a) x := sorry
end PerfectoidSpace

namespace Perfectoid
universe u
variable (p : ℕ) [Fact p.Prime] (R : PairCat.{u} p) (ϖ : PseudoUniformizerRoots p R)
local instance : Fact (Cardinal.aleph.{u} 1).IsRegular := ⟨Cardinal.isRegular_aleph_one⟩
instance countablePerfectoidSubrings_isCardinalFiltered :
    IsCardinalFiltered (countablePerfectoidSubrings p R ϖ) (Cardinal.aleph.{u} 1) := sorry

instance countablePerfectoidSubrings_isFiltered :
    IsFiltered (countablePerfectoidSubrings p R ϖ) := sorry

