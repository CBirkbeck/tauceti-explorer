example (A : ScholzeAffinoidTower p K)
    (D : Fin 2 ⥤ affinoidEtaleSmall p A.realization ⟨A.completedPair, ⟨Iso.refl _⟩⟩) :
    IsIso ((proEtaleEquivalence.cone p A.realization
      ⟨A.completedPair, ⟨Iso.refl _⟩⟩ D).π.app 0) ∧
