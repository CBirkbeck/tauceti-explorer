/-! ### P7/good-affinoid-finite-etale-equivalence -/

/-- Finite étale algebras on a filtered diagram of complete affinoid rings,
with ordinary algebraic scalar extension. -/
def affinoidFiniteEtaleDiagram {J : Type} [SmallCategory J] (E : J ⥤ CAff) :
    Pseudofunctor (LocallyDiscrete J) Cat.{0, 1} where
  obj i := Cat.of (CommAlgCat.FiniteEtale (E.obj i.as).A)
  map {i j} a :=
    letI := (CAff.toRingHom (E.map a.as)).toAlgebra
    (CommAlgCat.FiniteEtale.baseChange (E.obj i.as).A (E.obj j.as).A).toCatHom
  map₂ := by sorry
  map₂_id := by sorry
  map₂_comp := by sorry
  mapId := by sorry
  mapComp := by sorry
  map₂_whisker_left := by sorry
  map₂_whisker_right := by sorry
  map₂_associator := by sorry
  map₂_left_unitor := by sorry
  map₂_right_unitor := by sorry

-- Check: affinoidFiniteEtaleDiagram_identity
example {J : Type} [SmallCategory J] (E : J ⥤ CAff) (i : J) :
    Nonempty ((affinoidFiniteEtaleDiagram E).map (𝟙 (LocallyDiscrete.mk i)) ≅
      𝟙 ((affinoidFiniteEtaleDiagram E).obj (LocallyDiscrete.mk i))) := sorry
-- Check: affinoidFiniteEtaleDiagram_zero
example {J : Type} [SmallCategory J] (E : J ⥤ CAff) {i j : J} (a : i ⟶ j)
    (B : CommAlgCat.FiniteEtale (E.obj i).A) [Subsingleton B.obj] :
    Subsingleton (((affinoidFiniteEtaleDiagram E).map a.toLoc).toFunctor.obj B).obj := sorry
-- Check: affinoidFiniteEtaleDiagram_two
example {J : Type} [SmallCategory J] (E : J ⥤ CAff) {i j : J} (a : i ⟶ j)
    (B : CommAlgCat.FiniteEtale (E.obj i).A)
    (e : B.obj ≃ₐ[(E.obj i).A] (Fin 2 → (E.obj i).A)) :
    Nonempty ((((affinoidFiniteEtaleDiagram E).map a.toLoc).toFunctor.obj B).obj ≃ₐ[(E.obj j).A]
      (Fin 2 → (E.obj j).A)) := sorry

variable (p : ℕ) [Fact p.Prime] {I : Type} [SmallCategory I] [IsCofiltered I]
  {D : I ⥤ YonedaAdicSpace} {c : Cone D} (W : GoodAffinoid p D c)
  (h : IsTildeLimit p D c)
  (E : (Over W.level)ᵒᵖ ⥤ CAff)
  (hE : ∀ i, (E.obj i).Sheafy) (hT : ∀ i, IsTateRing (E.obj i).A)
  (v : ∀ i : Over W.level, ofSpaY (E.obj (op i)) ⟶ D.obj i.left)
  (b : ∀ i : Over W.level, ofSpaY (E.obj (op i)) ⟶ W.finiteOpen)
  (hv : ∀ i, IsPullback (v i) (b i) (D.map i.hom) W.inclusion)
  (hn : ∀ {i j : Over W.level} (a : i ⟶ j),
    (ObjectProperty.homMk (spaYFunctor.map (E.map a.op).op) :
      ofSpaY (E.obj (op i)) ⟶ ofSpaY (E.obj (op j))) ≫ v j = v i ≫ D.map a.left)
  (r : ∀ i : Over W.level, E.obj (op i) ⟶ CAff.of W.ring.pair)
  (hr : ∀ i, (ObjectProperty.homMk (spaYFunctor.map (r i).op) :
    (ofPair p W.ring).obj ⟶ ofSpaY (E.obj (op i))) ≫ v i = W.chart ≫ c.π.app i.left)

include h hE hT hv hn hr

/-! ### P7/good-affinoid-uniform-completion -/

/-- The uniform completion is characterized by its maps to complete uniform Tate pairs.
The prescribed maps to finite levels determine the comparison. -/
theorem GoodAffinoid.isUniformCompletion (B : CAff) [IsTateRing B.A] [IsUniform B.A]
    (F : ∀ i : Over W.level, E.obj (op i) ⟶ B)
    (hF : ∀ {i j : Over W.level} (a : i ⟶ j), E.map a.op ≫ F i = F j) :
    ∃! φ : CAff.of W.ring.pair ⟶ B, ∀ i, r i ≫ φ = F i := sorry

/-- Finite étale algebras on a good affinoid descend to its finite-level affinoids.
The inverse equivalence is the canonical scalar-extension comparison. -/
theorem GoodAffinoid.finiteEtaleEquiv :
    ∃ e : CommAlgCat.FiniteEtale W.ring ≌
      CategoryTheory.FilteredTwoColimit (affinoidFiniteEtaleDiagram E),
      ∀ (i : Over W.level) (B : CommAlgCat.FiniteEtale (E.obj (op i)).A),
        letI := (CAff.toRingHom (r i)).toAlgebra
        Nonempty (e.inverse.obj
          ((CategoryTheory.FilteredTwoColimit.ι (affinoidFiniteEtaleDiagram E) (op i)).obj B) ≅
            (CommAlgCat.FiniteEtale.baseChange (E.obj (op i)).A W.ring).obj B) := by
  classical
  let A : (Over W.level)ᵒᵖ ⥤ CommRingCat :=
    { obj := fun i ↦ CommRingCat.of (E.obj i).A
      map := fun a ↦ CommRingCat.ofHom (CAff.toRingHom (E.map a))
      map_id := by sorry
      map_comp := by sorry }
  let : ∀ i, IsTateRing (A.obj i) := hT
  -- Compatible rings of definition give the topology of the algebraic colimit.
  obtain ⟨A₀, hopen, hplus, hmap, t, ht, htop, htmap⟩ :
      ∃ (A₀ : ∀ i, Subring (A.obj i))
        (hopen : ∀ i, IsOpen (A₀ i : Set (A.obj i)))
        (hplus : ∀ i, A₀ i ≤ (E.obj i).P.plus)
        (hmap : ∀ {i j} (a : i ⟶ j) (x : A.obj i), x ∈ A₀ i → A.map a x ∈ A₀ j)
        (t : ∀ i, A₀ i),
        (∀ i, IsPseudoUniformizer (t i : A.obj i)) ∧
        (∀ i, IsAdic (Ideal.span {t i})) ∧
        (∀ {i j} (a : i ⟶ j), A.map a (t i) = (t j : A.obj j)) := by
    sorry
  let : UniformSpace (↥(colimit A)) := by sorry
  let : IsUniformAddGroup (↥(colimit A)) := by sorry
  let : IsTopologicalRing (↥(colimit A)) := by sorry
  let C := UniformSpace.Completion (↥(colimit A))
  let := (UniformSpace.Completion.coeRingHom : ↥(colimit A) →+* C).toAlgebra
  have : (CommAlgCat.FiniteEtale.baseChange.{0} (↥(colimit A)) C).IsEquivalence :=
    finiteEtale_completedColimit A (fun i ↦ (E.obj i).P)
      (fun a ↦ E.map a) (by intros; rfl) A₀ hopen hplus hmap t ht htop htmap
      (op (Over.mk (𝟙 W.level))) (by sorry)
  -- The completed pair and its uniformization retain the specified maps from E.
  let : IsTateRing C := by sorry
  let S : Pair C := by sorry
  let U := TauCetiRoadmap.AdicSpacesPartII.Huber.Uniformization C
  let := (TauCetiRoadmap.AdicSpacesPartII.Huber.Pair.toUniformization S).toRingHom.toAlgebra
  let F := CommAlgCat.FiniteEtale.baseChange.{0} C U
  -- KL15 2.8.16(a), p. 64: the categorical form of AdicEtaleGeometry's
  -- Huber.Pair.uniformization.baseChange_finiteEtale_equivalence.
  have : F.IsEquivalence := by sorry
  -- Algebraic finite presentation gives descent before completion.
  let eAlg : CategoryTheory.FilteredTwoColimit (affinoidFiniteEtaleDiagram E) ≌
      CommAlgCat.FiniteEtale (↥(colimit A)) := by sorry
  -- GoodAffinoid.isUniformCompletion identifies U with the chart's ring.
  obtain ⟨q, hq⟩ : ∃ q : U ≃+* W.ring, ∀ (i : Over W.level) (x : (E.obj (op i)).A),
      q ((TauCetiRoadmap.AdicSpacesPartII.Huber.Pair.toUniformization S).toRingHom
        (UniformSpace.Completion.coeRingHom ((colimit.ι A (op i)).hom x))) =
          CAff.toRingHom (r i) x := by
    sorry
  let := q.toRingHom.toAlgebra
  let G := CommAlgCat.FiniteEtale.baseChange.{0} U W.ring
  have : G.IsEquivalence := by sorry
  let eChart := G.asEquivalence
  let e := ((eAlg.trans
    (CommAlgCat.FiniteEtale.baseChange.{0} (↥(colimit A)) C).asEquivalence).trans
      F.asEquivalence).trans eChart
  refine ⟨e.symm, ?_⟩
  intro i B
  -- The scalar-extension identifications compose along A_i → L → C → U → W.ring.
  sorry

end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
end

noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace.TowerGeometry
open _root_.CategoryTheory _root_.CategoryTheory.Limits Opposite
open _root_.TauCeti _root_.TauCeti.Huber
open TauCetiRoadmap.AdicEtaleGeometry
open Perfectoid PerfectoidSpace
variable (p : ℕ) [Fact p.Prime]
/-! ### P7/finite-level-analytic-carriers -/

/-- A finite map is affinoid over every affinoid open of its target, with finite module map. -/
def IsFinite {X Y : YonedaAdicSpace} (f : X ⟶ Y) : Prop :=
  ∀ (R : CAff) (v : YonedaAdicSpace.ofSpaY R ⟶ Y),
    YonedaAdicSpace.IsOpenImmersion v.hom →
    ∃ (S : CAff) (a : R ⟶ S) (u : YonedaAdicSpace.ofSpaY S ⟶ X)
      (h : u ≫ f = ObjectProperty.homMk (YonedaAdicSpace.spaYFunctor.map a.op) ≫ v),
      YonedaAdicSpace.IsOpenImmersion u.hom ∧
      TauCetiRoadmap.AdicSpacesPartII.Huber.Pair.Hom.IsFinite (show Pair.Hom R.P S.P from a) ∧
      Nonempty (IsLimit (PullbackCone.mk u
        (ObjectProperty.homMk (YonedaAdicSpace.spaYFunctor.map a.op) :
          YonedaAdicSpace.ofSpaY S ⟶ YonedaAdicSpace.ofSpaY R) h))

/-- Analytic spaces over Z_p have topologically nilpotent p on every affinoid chart.
This is HJ's standing convention on p. 26, and fixes the residue characteristic of the site. -/
def IsOverZp (p : ℕ) (X : YonedaAdicSpace) : Prop :=
  ∀ (R : CAff) (u : YonedaAdicSpace.ofSpaY R ⟶ X),
    YonedaAdicSpace.IsOpenImmersion u.hom → IsTopologicallyNilpotent (p : R.A)

-- Check: overZp_perfectoid.
example (R : PairCat.{0} p) : IsOverZp p (ofPair p R).obj := sorry
-- Check: overZp_empty.
example (R : CAff) [Subsingleton R.A] : IsOverZp p (YonedaAdicSpace.ofSpaY R) := sorry
-- Check: overZp_wrong_prime.
example (ℓ q : ℕ) [Fact ℓ.Prime] [Fact q.Prime] (hℓq : ℓ ≠ q) :
    ¬ IsOverZp ℓ (YonedaAdicSpace.ofSpaY (CAff.of (Pair.powerBounded ℚ_[q]))) := sorry


end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace.TowerGeometry
end


noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSites
open _root_.CategoryTheory TopologicalSpace
universe u v
variable {C : Type v} [Category.{u} C] (sp : C ⥤ TopCat.{u})

/-- Small families covering each compact open by finitely many compact open images
(ECD Definition 8.1(iii), p. 39). The definition also applies to categories of
spaces without local spectrality. -/
def vPrecoverage : Precoverage C where
  coverings X := {R | ∃ (ι : Type u) (U : ι → C) (f : ∀ i, U i ⟶ X),
    R = Presieve.ofArrows U f ∧ ∀ V : Opens (sp.obj X),
      IsCompact (V : Set (sp.obj X)) →
        IsCompactOpenCovered (fun i => sp.map (f i)) (V : Set (sp.obj X))}

-- Check: vPrecoverage_point
example : Presieve.singleton (𝟙 (1 : Fin 2)) ∈
    (vPrecoverage ((Functor.const (Fin 2)).obj (TopCat.of PUnit.{1}))).coverings 1 := by
  sorry
-- Check: vPrecoverage_empty
example (X : C) [IsEmpty (sp.obj X)] :
    (⊥ : Presieve X) ∈ (vPrecoverage sp).coverings X := by sorry
-- Check: vPrecoverage_nonempty
example : (⊥ : Presieve (1 : Fin 2)) ∉
    (vPrecoverage ((Functor.const (Fin 2)).obj (TopCat.of PUnit.{1}))).coverings 1 := by
  sorry

/-- The Grothendieck topology generated by compact-open covering families. -/
def vTopology : GrothendieckTopology C := (vPrecoverage sp).toGrothendieck

-- Check: vTopology_point
example : Sieve.generate (Presieve.singleton (𝟙 (1 : Fin 2))) ∈
    vTopology ((Functor.const (Fin 2)).obj (TopCat.of PUnit.{1})) 1 := by sorry
-- Check: vTopology_empty
example : vTopology ((Functor.const (Fin 2)).obj (TopCat.of Empty)) = ⊤ := by sorry
-- Check: vTopology_nonempty
example : (⊥ : Sieve (1 : Fin 2)) ∉
    vTopology ((Functor.const (Fin 2)).obj (TopCat.of PUnit.{1})) 1 := by sorry

end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSites
end

noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace.VQuotient
open _root_.CategoryTheory _root_.CategoryTheory.Limits Opposite
open _root_.TauCeti _root_.TauCeti.Huber
open TauCetiRoadmap.AdicEtaleGeometry
open Perfectoid YonedaAdicSpace
variable (p : ℕ) [Fact p.Prime]
/-! ### P7/perfectoid-untilt-test-sheaves -/

/-- The shared v-precoverage specialized to all perfectoid untilt test spaces. -/
abbrev vPrecoverage : Precoverage (Perfd p) :=
  PerfectoidSites.vPrecoverage
    (ObjectProperty.ι (IsPerfectoidSpace p) ⋙ YonedaAdicSpace.space)

/-- The shared v-topology specialized to all perfectoid untilt test spaces. -/
abbrev vTopology : GrothendieckTopology (Perfd p) :=
  PerfectoidSites.vTopology
    (ObjectProperty.ι (IsPerfectoidSpace p) ⋙ YonedaAdicSpace.space)

theorem vTopology_eq : vTopology p = (vPrecoverage p).toGrothendieck := rfl

-- Check: vPrecoverage_identity; vTopology_identity
example (X : Perfd p) :
    Presieve.singleton (𝟙 X) ∈ (vPrecoverage p).coverings X ∧
      Sieve.generate (Presieve.singleton (𝟙 X)) ∈ vTopology p X := sorry
-- Check: vPrecoverage_empty; vTopology_empty
example (X : Perfd p) [IsEmpty (underlyingPoints p X)] :
    (⊥ : Presieve X) ∈ (vPrecoverage p).coverings X ∧ (⊥ : Sieve X) ∈ vTopology p X := sorry
-- Check: vPrecoverage_nonempty; vTopology_nonempty
example (X : Perfd p) [Nonempty (underlyingPoints p X)] :
    (⊥ : Presieve X) ∉ (vPrecoverage p).coverings X ∧ (⊥ : Sieve X) ∉ vTopology p X := sorry

/-- Restrict the analytic functor of points to perfectoid untilt test objects, then
v-sheafify. For an adic space over Z_p these are the fibers of its diamond over Spd Z_p. -/
def adicVFunctor : YonedaAdicSpace ⥤ Sheaf (vTopology p) (Type 2) where
  obj X := (presheafToSheaf (vTopology p) (Type 2)).obj
    (((ObjectProperty.ι (IsPerfectoidSpace p)).op ⋙ yoneda.obj X) ⋙ uliftFunctor.{2, 1})
  map f := (presheafToSheaf (vTopology p) (Type 2)).map
    (Functor.whiskerRight (Functor.whiskerLeft (ObjectProperty.ι (IsPerfectoidSpace p)).op (yoneda.map f))
      uliftFunctor.{2, 1})
  map_id := by sorry
  map_comp := by sorry

/-- Perfectoid test objects already represent v-sheaves. This identifies the sheafification
unit with evaluation and fixes the action on sections and morphisms. -/
theorem adicVFunctor_perfectoid (X : Perfd p) :
    ∃ e : ((adicVFunctor p).obj X.obj).obj ≅ yoneda.obj X ⋙ uliftFunctor.{2, 1},
      ∀ (Y : Perfd p) (f : Y ⟶ X),
        e.hom.app (op Y)
          ((toSheafify (vTopology p)
            (((ObjectProperty.ι (IsPerfectoidSpace p)).op ⋙ yoneda.obj X.obj) ⋙
              uliftFunctor.{2, 1})).app (op Y) (ULift.up f.hom)) = ULift.up f := sorry

-- Check: adicVFunctor_identity
example (X : Perfd p) : IsIso ((adicVFunctor p).map (𝟙 X.obj)) := inferInstance
-- Check: adicVFunctor_empty
example (X Y : Perfd p) [IsEmpty (underlyingPoints p X)]
    [Nonempty (underlyingPoints p Y)] :
    IsEmpty (((adicVFunctor p).obj X.obj).obj.obj (op Y)) := sorry
-- Check: adicVFunctor_two_points
example (K : AffinoidField p) [IsAlgClosed K] :
    Nonempty ((((adicVFunctor p).obj
      (prodProfinite p (ofPair p (K.toPairCat p)) (Profinite.of (Fin 2))).obj).obj.obj
        (op (ofPair p (K.toPairCat p)))) ≃
      (ULift.{2} (ofPair p (K.toPairCat p) ⟶ ofPair p (K.toPairCat p))) × Fin 2) := sorry

/-! ### P7/represented-functor-comparison -/

section RepresentedLimits
variable {I : Type} [SmallCategory I] [IsCofiltered I]

/-- SW13 2.4.5, pp. 20–21: the v-sheaf limit and the topological limit use the same
cone projections. The sheaves are evaluated on perfectoid untilt test spaces. -/
theorem tildeLimit_represented_comparison (D : I ⥤ YonedaAdicSpace) (c : Cone D)
    (h : PerfectoidSpace.IsTildeLimit p D c)
    (hpD : ∀ i, TowerGeometry.IsOverZp p (D.obj i)) :
    Nonempty (IsLimit ((adicVFunctor p).mapCone c)) ∧
      (∃ e : (adicVFunctor p).obj c.pt ≅ limit (D ⋙ adicVFunctor p),
        ∀ i, e.hom ≫ limit.π (D ⋙ adicVFunctor p) i = (adicVFunctor p).map (c.π.app i)) ∧
      ∃ e : space.obj c.pt ≃ₜ {y : ∀ i, space.obj (D.obj i) |
        ∀ (i j : I) (a : i ⟶ j), space.map (D.map a) (y i) = y j},
        ∀ x i, (e x).val i = space.map (c.π.app i) x := sorry

/-- The represented comparison on a genuine adic-space cone after the Yoneda embedding.
AdicSpacesPartIV R5 supplies the general tilde-limit criterion. -/
theorem tildeLimit_represented_of_adic (D : I ⥤ TauCeti.AdicSpace) (c : Cone D)
    (h : AdicSpace.IsTildeLimit (D ⋙ ofAdicSpace) (ofAdicSpace.mapCone c))
    (hX : IsPerfectoidSpace p (ofAdicSpace.obj c.pt))
    (ha : ∀ i, YonedaAdicSpace.IsAnalytic (ofAdicSpace.obj (D.obj i)))
    (hpD : ∀ i, TowerGeometry.IsOverZp p (ofAdicSpace.obj (D.obj i)))
    (hq : ∀ {i j} (a : i ⟶ j), AdicSpace.Qcqs (ofAdicSpace.map (D.map a))) :
    Nonempty (IsLimit ((ofAdicSpace ⋙ adicVFunctor p).mapCone c)) := sorry

section FiniteTransitions
variable (D : I ⥤ YonedaAdicSpace) (c : Cone D)
    (hpX : IsPerfectoidSpace p c.pt)
    (hpD : ∀ i, TowerGeometry.IsOverZp p (D.obj i))
    (hn : ∀ i, AdicSpace.IsLocallyNoetherianAnalytic (D.obj i))
    (ht : ∀ {i j} (a : i ⟶ j), TowerGeometry.IsFinite (D.map a))
    (hlim : IsLimit ((adicVFunctor p).mapCone c))

include hpX hpD hn ht hlim in
/-- HJ 5.11, p. 32: perfectoid representation of the sheaf limit gives the canonical
homeomorphism without a density assumption on finite-level functions. -/
theorem represented_limit_homeomorph :
    ∃ e : space.obj c.pt ≃ₜ {y : ∀ i, space.obj (D.obj i) |
      ∀ (i j : I) (a : i ⟶ j), space.map (D.map a) (y i) = y j},
      ∀ x i, (e x).val i = space.map (c.π.app i) x := sorry

include hpX hpD hn ht hlim in
/-- HJ 5.11, p. 32: the basis consists of affinoid perfectoid inverse images of
finite-level affinoid opens, not merely arbitrary quasicompact opens. -/
theorem represented_limit_affinoid_basis :
    TopologicalSpace.IsTopologicalBasis {U : Set (space.obj c.pt) |
      ∃ (R : PairCat.{0} p) (u : (ofPair p R).obj ⟶ c.pt)
        (i : I) (B : CAff) (v : ofSpaY B ⟶ D.obj i),
        YonedaAdicSpace.IsOpenImmersion u.hom ∧
        YonedaAdicSpace.IsOpenImmersion v.hom ∧
        U = Set.range (space.map u) ∧
        U = space.map (c.π.app i) ⁻¹' Set.range (space.map v)} := sorry

include hpX hpD hn ht hlim in
/-- HJ 5.11, p. 32, with spectral descent of quasicompact opens: qcqs levels
permit one finite level for each quasicompact open of the represented limit. -/
theorem represented_limit_quasicompact_open
    (hc : ∀ i, CompactSpace (space.obj (D.obj i)))
    (hs : ∀ i, QuasiSeparatedSpace (space.obj (D.obj i)))
    (U : TopologicalSpace.Opens (space.obj c.pt)) (hU : IsCompact (U : Set (space.obj c.pt))) :
    ∃ (i : I) (V : TopologicalSpace.Opens (space.obj (D.obj i))),
      IsCompact (V : Set (space.obj (D.obj i))) ∧
      (U : Set (space.obj c.pt)) = space.map (c.π.app i) ⁻¹' (V : Set (space.obj (D.obj i))) := sorry

/-! ### P7/rational-subsets-from-finite-level -/

include hpD hn ht hlim in
/-- HJ 5.11, p. 32: on an affinoid tower, a rational subset of the perfectoid
representative is pulled back from rational data at a finite stage. -/
theorem represented_limit_rational_subset (R : PairCat.{0} p)
    (eX : (ofPair p R).obj ≅ c.pt)
    (B : I → CAff) (eB : ∀ i, ofSpaY (B i) ≅ D.obj i) (U : RationalOpen p R) :
    ∃ (i : I) (T : Finset (B i).A) (s : (B i).A),
      IsOpen ((Ideal.span (T : Set (B i).A) : Ideal (B i).A) : Set (B i).A) ∧
      Set.range (space.map (((spaFunctor p).map (rationalMap p R U).op).hom ≫ eX.hom)) =
        space.map (c.π.app i ≫ (eB i).inv) ⁻¹'
          {x | (AdicSpace.affinoidPoints (B i) x).down.val ∈
            ValuationSpectrum.rationalSubset (B i).P.plus T s} := sorry

end FiniteTransitions
end RepresentedLimits

/-! ### P7/tilde-limit-from-completed-colimit -/

section UniformizedColimits
open TauCetiRoadmap.AdicSpacesPartII.Huber
attribute [local instance] Pair.uniformization.isTateRing
variable {J : Type} [SmallCategory J] [IsFiltered J]

/-- SW13 2.4.2, p. 20, and KL I 2.8.13, p. 63: completion and uniformization
preserve the functor on perfectoid tests. The perfectoid case also gives a tilde-limit;
its general completed-affinoid criterion is supplied by AdicSpacesPartIV R5. -/
theorem completed_colimit_uniformization_comparison
    (B : J ⥤ CAff) (b : Cocone B) [IsTateRing b.pt.A]
    (hB : ∀ j, CAff.Sheafy (B.obj j))
    (ha : ∀ j, IsTateRing (B.obj j).A)
    (hpB : ∀ j, IsTopologicallyNilpotent (p : (B.obj j).A))
    (B₀ : ∀ j, Subring (B.obj j).A) (ϖ : b.pt.A)
    (hb : IsCompletedColimitOfTower (fun j ↦ (B.obj j).P)
      (fun f ↦ B.map f) b.pt.P (fun j ↦ b.ι.app j) B₀ ϖ) :
    let S := ObjectProperty.lift IsYonedaAdic spaYFunctor (fun A ↦ isYonedaAdic_spaY A.unop)
    let D := B.op ⋙ S
    let U := CAff.of (Pair.uniformization b.pt.P)
    ∃ (c : Cone D) (eX : c.pt ≅ ofSpaY U),
      (∀ j, c.π.app (op j) = eX.hom ≫ (ObjectProperty.homMk
        (spaYFunctor.map ((b.ι.app j ≫
          (show b.pt ⟶ U from Pair.toUniformization b.pt.P)).op)) :
            ofSpaY U ⟶ ofSpaY (B.obj j))) ∧
      Nonempty (IsLimit ((adicVFunctor p).mapCone c)) ∧
      (∃ e : limit (D ⋙ adicVFunctor p) ≅ (adicVFunctor p).obj (ofSpaY U),
        ∀ j, e.inv ≫ limit.π (D ⋙ adicVFunctor p) (op j) =
          (adicVFunctor p).map (eX.inv ≫ c.π.app (op j))) ∧
      (∃ e : space.obj (ofSpaY U) ≃ₜ {y : ∀ i, space.obj (D.obj i) |
        ∀ (i j : Jᵒᵖ) (a : i ⟶ j), space.map (D.map a) (y i) = y j},
        ∀ x i, (e x).val i = space.map (eX.inv ≫ c.π.app i) x) ∧
      (IsPerfectoidTateRing p U.A → PerfectoidSpace.IsTildeLimit p D c) := sorry

/-- The density clause is separate from sheaf representability. In the affinoid
case it holds precisely when the completed pair's uniformization is perfectoid
(SW13 2.4.5, pp. 20–21; KL I 2.8.13, p. 63; HJ 5.11, p. 32). -/
theorem represented_uniformization_density_iff
    (B : J ⥤ CAff) (b : Cocone B) [IsTateRing b.pt.A]
    (hB : ∀ j, CAff.Sheafy (B.obj j))
    (ha : ∀ j, IsTateRing (B.obj j).A)
    (hpB : ∀ j, IsTopologicallyNilpotent (p : (B.obj j).A))
    (B₀ : ∀ j, Subring (B.obj j).A) (ϖ : b.pt.A)
    (hb : IsCompletedColimitOfTower (fun j ↦ (B.obj j).P)
      (fun f ↦ B.map f) b.pt.P (fun j ↦ b.ι.app j) B₀ ϖ)
    (R : PairCat.{0} p) (q : b.pt ⟶ CAff.of R.pair)
    (hq : IsIso ((adicVFunctor p).map (ObjectProperty.homMk
      (spaYFunctor.map q.op) : ofSpaY (CAff.of R.pair) ⟶ ofSpaY b.pt))) :
    Dense (⋃ j, Set.range (show Pair.Hom (B.obj j).P R.pair from b.ι.app j ≫ q).toRingHom) ↔
      IsPerfectoidTateRing p (Uniformization b.pt.A) := sorry
end UniformizedColimits

-- Check: tildeLimit_represented_comparison_identity
example (X : Perfd p) :
    Nonempty (IsLimit ((adicVFunctor p).mapCone (AdicSpace.singletonCone (𝟙 X.obj)))) := sorry
-- Check: tildeLimit_represented_comparison_empty
example (R : PairCat.{0} p) [Subsingleton R] (K : AffinoidField p) :
    IsEmpty (((adicVFunctor p).obj (ofPair p R).obj).obj.obj
      (op (ofPair p (K.toPairCat p)))) := sorry
-- Check: represented_uniformization_density_iff_wrong_cone
example (q : CAff.of (Pair.powerBounded ℚ_[p]) ⟶ CAff.of (Pair.powerBounded ℂ_[p])) :
    ¬ IsIso ((adicVFunctor p).map (ObjectProperty.homMk (spaYFunctor.map q.op) :
      ofSpaY (CAff.of (Pair.powerBounded ℂ_[p])) ⟶
        ofSpaY (CAff.of (Pair.powerBounded ℚ_[p])))) := sorry


end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace.VQuotient
end


noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
open _root_.CategoryTheory _root_.CategoryTheory.Limits Opposite
open _root_.TauCeti _root_.TauCeti.Huber
open TauCetiRoadmap.AdicEtaleGeometry
open Perfectoid YonedaAdicSpace
variable (p : ℕ) [Fact p.Prime]
/-! ### P7/preperfectoid-base-change -/

/-- SW13 2.3.10: absolute preperfectoidness implies the relative condition over a perfectoid field. -/
theorem IsPreperfectoid.baseChange (K : PairCat.{0} p) (hK : IsField K) [CharZero K]
    (X : YonedaAdicSpace) (x : X ⟶ (ofPair p K).obj)
    (k : (ofPair p K).obj ⟶ ofSpaY (CAff.of (Pair.powerBounded ℚ_[p])))
    (h : ∀ (L : PairCat.{0} p), IsField L → CharZero L →
      ∀ (l : (ofPair p L).obj ⟶ ofSpaY (CAff.of (Pair.powerBounded ℚ_[p])))
        (Y : YonedaAdicSpace) (a : Y ⟶ X) (b : Y ⟶ (ofPair p L).obj),
        IsPullback a b (x ≫ k) l → IsPreperfectoid p Y) : IsPreperfectoid p X := sorry

end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
end

/-!
## Unital representatives for differentials

For a morphism of almost algebras A → B,
`Almost.Algebra.kaehlerDifferential.shriekIso` identifies
`(m ⊗[V] m) ⊗[V] Ω_{B_*/A_*}` with `Ω_{B_!!/A_!!}`.
Here `shriekRing` is the nonunital algebra `B_!`, and `shriekShriekObj` is
its unitalization modulo `shriekIdeal` (GR Lemma 2.5.28, p. 34).
-/

/-! ### P0/almost-local-flatness-criterion -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Almost
open _root_.CategoryTheory
open scoped TensorProduct
/-- GR (3.2.19) and Lemma 3.2.6: reduction and the multiplication map detect flatness. -/
theorem flat_squareZero_criterion (V R : Type u) [CommRing V] [CommRing R]
    [_root_.Algebra V R] (S : BasicSetup V) (J : Ideal R) (hJ : J ^ 2 = ⊥)
    (M : Type u) [AddCommGroup M] [_root_.Module R M] :
    let N : Submodule R M := J • ⊤
    let Q := R ⧸ J
    letI : _root_.Module Q J :=
      (show _root_.Module.IsTorsionBySet R J J from by sorry).module
    letI : _root_.Module Q N :=
      (show _root_.Module.IsTorsionBySet R N J from by sorry).module
    letI : _root_.Module Q (M ⧸ N) := inferInstance
    ∃ μ : J ⊗[Q] (M ⧸ N) →ₗ[Q] N,
      (∀ (a : J) (m : M), (μ (a ⊗ₜ[Q] (Submodule.mkQ N m)) : M) = a.val • m) ∧
      (_root_.Module.Flat R M ↔ _root_.Module.Flat Q (M ⧸ N) ∧ Function.Bijective μ) ∧
      (Module.Flat (S.baseChange R) ((toAlmost (S.baseChange R)).obj (ModuleCat.of R M)) ↔
        Module.Flat (S.baseChange Q) ((toAlmost (S.baseChange Q)).obj (ModuleCat.of Q (M ⧸ N))) ∧
          IsIso ((toAlmost (S.baseChange Q)).map (ModuleCat.ofHom μ))) := sorry

-- Check: flat_squareZero_ideal_action
example (R : Type u) [CommRing R] (J : Ideal R) (hJ : J ^ 2 = ⊥)
    (r : R) (a : J) :
    letI := (show _root_.Module.IsTorsionBySet R J J from by sorry).module
    (Ideal.Quotient.mk J r • a : J).val = r * a.val := rfl
-- Check: flat_squareZero_image_action
example (R M : Type u) [CommRing R] [AddCommGroup M] [_root_.Module R M]
    (J : Ideal R) (hJ : J ^ 2 = ⊥) (r : R) (n : (J • ⊤ : Submodule R M)) :
    letI := (show _root_.Module.IsTorsionBySet R (J • ⊤ : Submodule R M) J from by sorry).module
    (Ideal.Quotient.mk J r • n : (J • ⊤ : Submodule R M)).val = r • n.val := rfl
-- Check: flat_squareZero_quotient_action
example (R M : Type u) [CommRing R] [AddCommGroup M] [_root_.Module R M]
    (J : Ideal R) (r : R) (m : M) :
    Ideal.Quotient.mk J r • Submodule.mkQ (J • ⊤ : Submodule R M) m =
      Submodule.mkQ (J • ⊤ : Submodule R M) (r • m) := rfl

-- Check: flat_squareZero_regular
example : _root_.Module.Flat (DualNumber ℚ) (DualNumber ℚ) := by infer_instance
-- Check: flat_squareZero_residue
example :
    letI : _root_.Algebra (DualNumber ℚ) ℚ := (TrivSqZeroExt.fstHom ℚ ℚ ℚ).toRingHom.toAlgebra
    ¬ _root_.Module.Flat (DualNumber ℚ) ℚ := sorry
end TauCetiRoadmap.PerfectoidSpaces.Almost
end

noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Almost
open _root_.CategoryTheory _root_.CategoryTheory.Limits Opposite
open _root_.CategoryTheory.MonoidalCategory ZeroObject
universe u
variable {V : Type u} [CommRing V] (S : BasicSetup V)
namespace Module
/-- Scalar extension is ordinary extension on almost elements followed by almostification. -/
def baseChange {A B : Algebra S} (f : A ⟶ B) :
    Module (S.baseChange ((Algebra.elements S).obj A)) ⥤
      Module (S.baseChange ((Algebra.elements S).obj B)) :=
  elements _ ⋙ ModuleCat.extendScalars ((Algebra.elements S).map f).hom.toRingHom ⋙ toAlmost _

/-- Scalar extension transports every rank projector, GR Proposition 4.3.27, p. 88.
The unit comparison conjugates the transported endomorphisms to the new projectors. -/
theorem rankDecomposition_baseChange {A B : Algebra S} (f : A ⟶ B)
    (P : Module (S.baseChange ((Algebra.elements S).obj A))) (r : ℕ)
    (hP : AlmostFiniteProjective _ P) (D : RankDecomposition _ P r) :
    ∃ E : RankDecomposition (S.baseChange ((Algebra.elements S).obj B))
        ((baseChange S f).obj P) r,
      ∃ u : 𝟙_ (Module (S.baseChange ((Algebra.elements S).obj B))) ≅
          (baseChange S f).obj (𝟙_ (Module (S.baseChange ((Algebra.elements S).obj A)))),
        ∀ i, E.projector i = u.hom ≫ (baseChange S f).map (D.projector i) ≫ u.inv := sorry

/-- The scalar-extension generator is the ordinary adjunction unit followed by
 the almost-elements adjunction unit. -/
def baseChangeUnit {A B : Algebra S} (f : A ⟶ B)
    (M : Module (S.baseChange ((Algebra.elements S).obj A))) :
    (elements _).obj M → (elements _).obj ((baseChange S f).obj M) :=
  fun m ↦ ((adjElements _).unit.app _).hom
    (((ModuleCat.extendRestrictScalarsAdj ((Algebra.elements S).map f).hom.toRingHom).unit.app
      ((elements _).obj M)).hom m)

-- Check: baseChangeUnit_zero
set_option backward.isDefEq.respectTransparency false in
example {A B : Algebra S} (f : A ⟶ B)
    (M : Module (S.baseChange ((Algebra.elements S).obj A))) :
    baseChangeUnit S f M 0 = 0 := by simp only [baseChangeUnit, map_zero]
-- Check: baseChangeUnit_add
set_option backward.isDefEq.respectTransparency false in
example {A B : Algebra S} (f : A ⟶ B)
    (M : Module (S.baseChange ((Algebra.elements S).obj A))) (m n : (elements _).obj M) :
    baseChangeUnit S f M (m + n) = baseChangeUnit S f M m + baseChangeUnit S f M n := by
  simp only [baseChangeUnit, map_add]
-- Check: baseChangeUnit_identity_injective
example (A : Algebra S) (M : Module (S.baseChange ((Algebra.elements S).obj A))) :
    Function.Injective (baseChangeUnit S (𝟙 A) M) := sorry

/-- The identity comparison is uniquely determined on scalar-extension generators. -/
theorem baseChangeIdIso_exists (A : Algebra S) :
    ∃! e : baseChange S (𝟙 A) ≅ 𝟭 _,
      ∀ (M : Module (S.baseChange ((Algebra.elements S).obj A))) (m : (elements _).obj M),
        (elements _).map (e.hom.app M) (baseChangeUnit S (𝟙 A) M m) = m := sorry

/-- Scalar extension along the identity, normalized by its adjunction unit. -/
def baseChangeIdIso (A : Algebra S) : baseChange S (𝟙 A) ≅ 𝟭 _ :=
  (baseChangeIdIso_exists S A).exists.choose

theorem baseChangeIdIso_unit (A : Algebra S)
    (M : Module (S.baseChange ((Algebra.elements S).obj A))) (m : (elements _).obj M) :
    (elements _).map ((baseChangeIdIso S A).hom.app M) (baseChangeUnit S (𝟙 A) M m) = m :=
  (baseChangeIdIso_exists S A).exists.choose_spec M m

-- Check: baseChangeIdIso_generator
example (A : Algebra S) (M : Module (S.baseChange ((Algebra.elements S).obj A)))
    (m : (elements _).obj M) :
    (elements _).map ((baseChangeIdIso S A).hom.app M) (baseChangeUnit S (𝟙 A) M m) = m :=
  baseChangeIdIso_unit S A M m
-- Check: baseChangeIdIso_zero
example (A : Algebra S) (M : Module (S.baseChange ((Algebra.elements S).obj A))) :
    (elements _).map ((baseChangeIdIso S A).hom.app M) 0 = 0 := map_zero _
-- Check: baseChangeIdIso_not_negated
example (A : Algebra S) (M : Module (S.baseChange ((Algebra.elements S).obj A)))
    (m : (elements _).obj M) (hm : m ≠ -m) :
    (elements _).map ((baseChangeIdIso S A).hom.app M) (baseChangeUnit S (𝟙 A) M m) ≠ -m := by
  rwa [baseChangeIdIso_unit]

/-- The composite comparison sends iterated generators back to the direct generator. -/
theorem baseChangeCompIso_exists {A B C : Algebra S} (f : A ⟶ B) (g : B ⟶ C) :
    ∃! e : baseChange S (f ≫ g) ≅ baseChange S f ⋙ baseChange S g,
      ∀ (M : Module (S.baseChange ((Algebra.elements S).obj A))) (m : (elements _).obj M),
        (elements _).map (e.inv.app M)
          (baseChangeUnit S g ((baseChange S f).obj M) (baseChangeUnit S f M m)) =
            baseChangeUnit S (f ≫ g) M m := sorry

/-- The canonical associativity comparison for almost scalar extension. -/
def baseChangeCompIso {A B C : Algebra S} (f : A ⟶ B) (g : B ⟶ C) :
    baseChange S (f ≫ g) ≅ baseChange S f ⋙ baseChange S g :=
  (baseChangeCompIso_exists S f g).exists.choose

theorem baseChangeCompIso_unit {A B C : Algebra S} (f : A ⟶ B) (g : B ⟶ C)
    (M : Module (S.baseChange ((Algebra.elements S).obj A))) (m : (elements _).obj M) :
    (elements _).map ((baseChangeCompIso S f g).inv.app M)
      (baseChangeUnit S g ((baseChange S f).obj M) (baseChangeUnit S f M m)) =
        baseChangeUnit S (f ≫ g) M m :=
  (baseChangeCompIso_exists S f g).exists.choose_spec M m

-- Check: baseChangeCompIso_generator
example {A B C : Algebra S} (f : A ⟶ B) (g : B ⟶ C)
    (M : Module (S.baseChange ((Algebra.elements S).obj A))) (m : (elements _).obj M) :
    (elements _).map ((baseChangeCompIso S f g).inv.app M)
      (baseChangeUnit S g ((baseChange S f).obj M) (baseChangeUnit S f M m)) =
        baseChangeUnit S (f ≫ g) M m := baseChangeCompIso_unit S f g M m
-- Check: baseChangeCompIso_zero
example {A B C : Algebra S} (f : A ⟶ B) (g : B ⟶ C)
    (M : Module (S.baseChange ((Algebra.elements S).obj A))) :
    (elements _).map ((baseChangeCompIso S f g).inv.app M) 0 = 0 := map_zero _
-- Check: baseChangeCompIso_not_negated
example {A B C : Algebra S} (f : A ⟶ B) (g : B ⟶ C)
    (M : Module (S.baseChange ((Algebra.elements S).obj A))) (m : (elements _).obj M)
    (hm : baseChangeUnit S (f ≫ g) M m ≠ -baseChangeUnit S (f ≫ g) M m) :
    (elements _).map ((baseChangeCompIso S f g).inv.app M)
      (baseChangeUnit S g ((baseChange S f).obj M) (baseChangeUnit S f M m)) ≠
        -baseChangeUnit S (f ≫ g) M m := by
  rwa [baseChangeCompIso_unit]

/-- Modules on the opposite category of almost affine algebras, with scalar extension. -/
def descentPseudofunctor : Pseudofunctor (LocallyDiscrete ((Algebra S)ᵒᵖ)ᵒᵖ) Cat.{u, u + 1} :=
  pseudofunctorOfIsLocallyDiscrete
    (fun A ↦ Cat.of (Module (S.baseChange ((Algebra.elements S).obj A.as.unop.unop))))
    (fun f ↦ (baseChange S f.as.unop.unop).toCatHom)
    (fun A ↦ Cat.Hom.isoMk (baseChangeIdIso S A.as.unop.unop))
    (fun f g ↦ Cat.Hom.isoMk (baseChangeCompIso S f.as.unop.unop g.as.unop.unop))
    (by sorry) (by sorry) (by sorry)

-- Check: baseChange_identity; descentPseudofunctor_identity
example (A : Algebra S) : Nonempty (baseChange S (𝟙 A) ≅ 𝟭 _) := sorry
-- Check: baseChange_zero; descentPseudofunctor_zero
example {A B : Algebra S} (f : A ⟶ B) : IsZero ((baseChange S f).obj 0) := sorry
-- Check: baseChange_two; descentPseudofunctor_two
example {A B : Algebra S} (f : A ⟶ B) : Nonempty
    ((baseChange S f).obj ((toAlmost _).obj (ModuleCat.of ((Algebra.elements S).obj A)
      (Fin 2 → (Algebra.elements S).obj A))) ≅
      (toAlmost _).obj (ModuleCat.of ((Algebra.elements S).obj B) (Fin 2 → (Algebra.elements S).obj B))) := sorry
end Module
namespace Algebra
/-- Algebra descent uses actual pushouts in the almost algebra category. -/
def descentPseudofunctor : Pseudofunctor (LocallyDiscrete ((Algebra S)ᵒᵖ)ᵒᵖ) Cat.{u, u + 1} :=
  pseudofunctorOfIsLocallyDiscrete
    (fun A ↦ Cat.of (Under A.as.unop.unop))
    (fun f ↦ (Under.pushout f.as.unop.unop).toCatHom)
    (fun _ ↦ Cat.Hom.isoMk Under.pushoutId)
    (fun f g ↦ Cat.Hom.isoMk (Under.pushoutComp f.as.unop.unop g.as.unop.unop))
    (by sorry) (by sorry) (by sorry)

-- Check: descentPseudofunctor_identity
example (A : Algebra S) : Nonempty (Under.pushout (𝟙 A) ≅ 𝟭 _) := ⟨Under.pushoutId⟩
-- Check: descentPseudofunctor_unit
example {A B : Algebra S} (f : A ⟶ B) :
    Nonempty ((Under.pushout f).obj (Under.mk (𝟙 A)) ≅ Under.mk (𝟙 B)) := sorry
-- Check: descentPseudofunctor_two
example {A B : Algebra S} (f : A ⟶ B) :
    Nonempty ((Under.pushout f).obj (Under.mk (prod.lift (𝟙 A) (𝟙 A))) ≅
      Under.mk (prod.lift (𝟙 B) (𝟙 B))) := sorry
end Algebra

/-! ### P0/almost-faithfully-flat-descent -/

/-- GR (3.4.1): the canonical functors to Čech descent data are equivalences. -/
theorem faithfullyFlat_descent {A B : Algebra S} (f : A ⟶ B)
    (hf : Algebra.IsFaithfullyFlat S f) :
    ((Module.descentPseudofunctor S).toDescentData (fun _ : Unit ↦ f.op)).IsEquivalence ∧
    ((Algebra.descentPseudofunctor S).toDescentData (fun _ : Unit ↦ f.op)).IsEquivalence ∧
    ∀ (C : Algebra S) (g : A ⟶ C),
      ((Module.descentPseudofunctor S).toDescentData
        (fun _ : Unit ↦ (pushout.inr f g).op)).IsEquivalence ∧
      ((Algebra.descentPseudofunctor S).toDescentData
        (fun _ : Unit ↦ (pushout.inr f g).op)).IsEquivalence := sorry

/-- The finiteness and flatness conditions descend; almost projectivity needs finite presentation
of the faithfully flat algebra unless the module is already almost finite. -/
theorem faithfullyFlat_module_properties {A B : Algebra S} (f : A ⟶ B)
    (hf : Algebra.IsFaithfullyFlat S f)
    (M : Module (S.baseChange ((Algebra.elements S).obj A))) :
    let T := S.baseChange ((Algebra.elements S).obj A)
    let U := S.baseChange ((Algebra.elements S).obj B)
    let N := (Module.baseChange S f).obj M
    (Module.Flat T M ↔ Module.Flat U N) ∧
    (Module.AlmostFG T ((Module.elements T).obj M) ↔ Module.AlmostFG U ((Module.elements U).obj N)) ∧
    (Module.AlmostFP T ((Module.elements T).obj M) ↔ Module.AlmostFP U ((Module.elements U).obj N)) ∧
    (Module.AlmostFiniteProjective T M ↔ Module.AlmostFiniteProjective U N) ∧
    (Module.AlmostFP T ((Module.elements T).obj (Algebra.relativeModule S f)) →
      (Module.AlmostProjective T M ↔ Module.AlmostProjective U N)) := sorry

/-- Weak étaleness, étaleness and finite étaleness are reflected by faithfully flat base change. -/
theorem faithfullyFlat_algebra_properties {A B C : Algebra S} (f : A ⟶ B) (g : A ⟶ C)
    (hf : Algebra.IsFaithfullyFlat S f) :
    (Algebra.IsWeaklyEtale S g ↔ Algebra.IsWeaklyEtale S (pushout.inl f g)) ∧
    (Algebra.IsEtale S g ↔ Algebra.IsEtale S (pushout.inl f g)) ∧
    (Algebra.IsFiniteEtale S g ↔ Algebra.IsFiniteEtale S (pushout.inl f g)) := sorry

end TauCetiRoadmap.PerfectoidSpaces.Almost
end

noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Almost
open _root_.CategoryTheory _root_.CategoryTheory.Limits
open _root_.CategoryTheory.MonoidalCategory ZeroObject
open scoped MonoidalCategory
universe u
variable {V : Type u} [CommRing V] (S : BasicSetup V)
local instance : HasDerivedCategory (Module S) := HasDerivedCategory.standard _
local instance (R : Type u) [CommRing R] : HasDerivedCategory (ModuleCat.{u} R) :=
  HasDerivedCategory.standard _

/-- An extension is exact on underlying almost modules; its kernel multiplication vanishes
and its quotient action is the prescribed B-module action. -/
structure SquareZeroExtension {A B : Algebra S} (f : A ⟶ B) (M : Algebra.ModuleCat S B) where
  algebra : Algebra S
  base : A ⟶ algebra
  projection : algebra ⟶ B
  over_base : base ≫ projection = f
  inclusion : M.X ⟶ algebra.X
  zero : inclusion ≫ projection.hom.hom = 0
  exact : (ShortComplex.mk inclusion projection.hom.hom zero).ShortExact
  square_zero : (inclusion ⊗ₘ inclusion) ≫ _root_.CategoryTheory.MonObj.mul (X := algebra.X) = 0
  scalar : (projection.hom.hom ⊗ₘ 𝟙 M.X) ≫ _root_.CategoryTheory.ModObj.smul (M := B.X) (X := M.X) ≫ inclusion =
    (𝟙 algebra.X ⊗ₘ inclusion) ≫ _root_.CategoryTheory.MonObj.mul (X := algebra.X)

/-- Extension isomorphisms fix the base, the quotient, and the identified kernel. -/
def extensionSetoid {A B : Algebra S} (f : A ⟶ B) (M : Algebra.ModuleCat S B) :
    Setoid (SquareZeroExtension S f M) where
  r E F := ∃ e : E.algebra ≅ F.algebra,
    E.base ≫ e.hom = F.base ∧ e.hom ≫ F.projection = E.projection ∧
      E.inclusion ≫ e.hom.hom.hom = F.inclusion
  iseqv := by sorry

abbrev Exal {A B : Algebra S} (f : A ⟶ B) (M : Algebra.ModuleCat S B) :=
  Quotient (extensionSetoid S f M)

/-! ### P0/almost-exal-ext-comparison -/

/-- GR 2.5.30 and (3.2.8): Ext¹ classifies extensions and detects their splittings. -/
theorem cotangentComplex_ext_one {A B : Algebra S} (f : A ⟶ B) (M : Algebra.ModuleCat S B) :
    let T := S.baseChange ((Algebra.elements S).obj B)
    let N := (Algebra.moduleEquiv S B).functor.obj M
    letI : HasDerivedCategory (Module T) := HasDerivedCategory.standard _
    ∃ e : Exal S f M ≃ (almostCotangentComplex S f ⟶
      ((DerivedCategory.singleFunctor (Module T) 0).obj N)⟦(1 : ℤ)⟧),
      ∀ E : SquareZeroExtension S f M, e (Quotient.mk _ E) = 0 ↔
        ∃ s : B ⟶ E.algebra, s ≫ E.projection = 𝟙 B ∧ f ≫ s = E.base := sorry

/-- GR 2.5.17(i): almostification identifies ordinary and almost extension classes. -/
theorem exal_toAlmost {A B : Algebra S} (f : A ⟶ B) (M : Algebra.ModuleCat S B) :
    let R := (Algebra.shriekShriek S).obj A
    let T := (Algebra.shriekShriek S).obj B
    let U := S.baseChange ((Algebra.elements S).obj B)
    letI : _root_.Algebra R T := ((Algebra.shriekShriek S).map f).hom.toAlgebra
    let N := (ModuleCat.restrictScalars
      ((Algebra.shriekShriekToElements S).app B).hom.toRingHom).obj
        ((Module.elements U).obj ((Algebra.moduleEquiv S B).functor.obj M))
    Nonempty (CotangentComplex.Exal R T N ≃ Exal S f M) := sorry

/-- Comparison of derived Hom uses lower shriek coefficients, GR 2.5.26 and 3.2.8. -/
theorem cotangentComplex_ext_iso {A B : Algebra S} (f : A ⟶ B)
    (M : Module (S.baseChange ((Algebra.elements S).obj B))) (n : ℤ) :
    let T := (Algebra.shriekShriek S).obj B
    let U := S.baseChange ((Algebra.elements S).obj B)
    letI : HasDerivedCategory (Module U) := HasDerivedCategory.standard _
    let N := (ModuleCat.restrictScalars
      ((Algebra.shriekShriekToElements S).app B).hom.toRingHom).obj ((Module.shriek U).obj M)
    Nonempty ((cotangentComplex S f ⟶
        ((DerivedCategory.singleFunctor (ModuleCat.{u} T) 0).obj N)⟦n⟧) ≃+
      (almostCotangentComplex S f ⟶
        ((DerivedCategory.singleFunctor (Module U) 0).obj M)⟦n⟧)) := sorry

-- Check: SquareZeroExtension_zero; extensionSetoid_zero; Exal_zero
example {A B : Algebra S} (f : A ⟶ B) (M : Algebra.ModuleCat S B) (hM : IsZero M.X)
    (E : SquareZeroExtension S f M) : IsIso E.projection ∧ Subsingleton (Exal S f M) := sorry
-- Check: SquareZeroExtension_classical; extensionSetoid_classical; Exal_classical
example (M : Algebra.ModuleCat (BasicSetup.classical ℚ)
    ((Algebra.toAlmost (BasicSetup.classical ℚ)).obj (CommAlgCat.of ℚ ℚ))) :
    Subsingleton (Exal (BasicSetup.classical ℚ) (𝟙 _) M) := sorry
-- Check: SquareZeroExtension_nonsplit; extensionSetoid_nonsplit; Exal_nonsplit
example : ∃ M : Algebra.ModuleCat (BasicSetup.classical ℤ)
    ((Algebra.toAlmost (BasicSetup.classical ℤ)).obj (CommAlgCat.of ℤ (ZMod 2))),
    Nontrivial (Exal (BasicSetup.classical ℤ)
      ((Algebra.toAlmost (BasicSetup.classical ℤ)).map
        (CommAlgCat.ofHom (Algebra.ofId ℤ (ZMod 2)))) M) := sorry
end TauCetiRoadmap.PerfectoidSpaces.Almost
end

noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Almost
open _root_.CategoryTheory _root_.CategoryTheory.Limits Opposite
open _root_.CategoryTheory.MonoidalCategory ZeroObject
open scoped MonoidalCategory Simplicial
universe u
variable {V : Type u} [CommRing V] (S : BasicSetup V)
namespace Algebra
/-- Forget an A-algebra to its underlying almost A-module. -/
def relativeForget (A : Algebra S) : Under A ⥤ Module (S.baseChange ((elements S).obj A)) where
  obj B := relativeModule S B.hom
  map := by sorry
  map_id := by sorry
  map_comp := by sorry

/-- The map on representatives is the linear map of almost elements over A_*. -/
theorem relativeForget_map (A : Algebra S) {B C : Under A} (f : B ⟶ C) :
    let R := (elements S).obj A
    letI : _root_.Algebra R ((elements S).obj B.right) := ((elements S).map B.hom).hom.toAlgebra
    letI : _root_.Algebra R ((elements S).obj C.right) := ((elements S).map C.hom).hom.toAlgebra
    ∃ g : (elements S).obj B.right →ₗ[R] (elements S).obj C.right,
      (∀ x, g x = ((elements S).map f.right).hom x) ∧
      (relativeForget S A).map f = (Almost.toAlmost (S.baseChange R)).map (ModuleCat.ofHom g) := sorry

-- Check: relativeForget_unit
example (A : Algebra S) : Nonempty ((relativeForget S A).obj (Under.mk (𝟙 A)) ≅ 𝟙_ _) := sorry
-- Check: relativeForget_zero
example (A B : Algebra S) (f : A ⟶ B) (hB : IsZero B.X) :
    IsZero ((relativeForget S A).obj (Under.mk f)) := sorry
-- Check: relativeForget_two
example (A : Algebra S) : Nonempty
    ((relativeForget S A).obj (Under.mk (prod.lift (𝟙 A) (𝟙 A))) ≅ biprod (𝟙_ _) (𝟙_ _)) := sorry
end Algebra

local instance (A : Algebra S) : HasFiniteColimits (Under A) := sorry

/-- The cosimplicial tensor powers, formed by the actual Čech conerve of A → B. -/
def amitsurCosimplicial {A B : Algebra S} (f : A ⟶ B)
    (M : Module (S.baseChange ((Algebra.elements S).obj A))) :
    CosimplicialObject (Module (S.baseChange ((Algebra.elements S).obj A))) :=
  let a : Under.mk (𝟙 A) ⟶ Under.mk f := Under.homMk f (by simp)
  (Arrow.mk a).cechConerve ⋙ Algebra.relativeForget S A ⋙ tensorRight M

/-- Alternating cofaces fix the differential and its sign in every degree. -/
def amitsurComplex {A B : Algebra S} (f : A ⟶ B)
    (M : Module (S.baseChange ((Algebra.elements S).obj A))) :
    CochainComplex (Module (S.baseChange ((Algebra.elements S).obj A))) ℕ :=
  (AlgebraicTopology.alternatingCofaceMapComplex _).obj (amitsurCosimplicial S f M)

/-! ### P0/almost-amitsur-complex-exact -/

/-- GR (3.4.1): the augmented Amitsur complex is exact for every coefficient module. -/
theorem amitsur_exact {A B : Algebra S} (f : A ⟶ B) (hf : Algebra.IsFaithfullyFlat S f)
    (M : Module (S.baseChange ((Algebra.elements S).obj A))) :
    (∀ n : ℕ, 0 < n → IsZero ((amitsurComplex S f M).homology n)) ∧
    ∃ e : (Algebra.relativeForget S A).obj (Under.mk (𝟙 A)) ≅ 𝟙_ _,
      let a : Under.mk (𝟙 A) ⟶ Under.mk f := Under.homMk f (by simp)
      let η := (λ_ M).inv ≫ (e.inv ▷ M) ≫
        (((Algebra.relativeForget S A).map
          ((Arrow.mk a).augmentedCechConerve.hom.app ⦋0⦌)) ▷ M)
      Mono η ∧ ∃ h : η ≫ (amitsurComplex S f M).d 0 1 = 0,
        (ShortComplex.mk η ((amitsurComplex S f M).d 0 1) h).Exact := sorry

-- Check: amitsurCosimplicial_identity; amitsurComplex_identity
example (A : Algebra S) (M : Module (S.baseChange ((Algebra.elements S).obj A))) :
    Nonempty ((amitsurComplex S (𝟙 A) M).homology 0 ≅ M) ∧
      ∀ n : ℕ, 0 < n → IsZero ((amitsurComplex S (𝟙 A) M).homology n) := sorry
-- Check: amitsurCosimplicial_zero; amitsurComplex_zero
example {A B : Algebra S} (f : A ⟶ B) : IsZero (amitsurComplex S f 0) := sorry
-- Check: amitsurCosimplicial_two; amitsurComplex_two
example (A : Algebra S) (hA : ¬ IsZero A.X) :
    (amitsurComplex S (prod.lift (𝟙 A) (𝟙 A)) (𝟙_ _)).d 0 1 ≠ 0 ∧
    (amitsurComplex S (prod.lift (𝟙 A) (𝟙 A)) (𝟙_ _)).d 0 1 =
      (amitsurCosimplicial S (prod.lift (𝟙 A) (𝟙 A)) (𝟙_ _)).δ 0 -
        (amitsurCosimplicial S (prod.lift (𝟙 A) (𝟙 A)) (𝟙_ _)).δ 1 := sorry
end TauCetiRoadmap.PerfectoidSpaces.Almost
