noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
open _root_.CategoryTheory _root_.CategoryTheory.Limits TauCeti TauCeti.Huber
open TauCetiRoadmap.AdicEtaleGeometry Perfectoid
variable (p : ℕ) [Fact p.Prime]

/-- Functions with their multiplication retained on the perfectoid étale site. -/
def etaleORing (X : Perfd p) : (smallEtale p X)ᵒᵖ ⥤ CommRingCat.{1} where
  obj U := CommRingCat.of (globalSections p U.unop.obj.left)
  map f := CommRingCat.ofHom (globalPullback p f.unop.hom.left)
  map_id := by sorry
  map_comp := by sorry

/-- Integral functions with ring homomorphisms as restriction maps. -/
def etaleOPlusRing (X : Perfd p) : (smallEtale p X)ᵒᵖ ⥤ CommRingCat.{1} where
  obj U := CommRingCat.of (globalPlus p U.unop.obj.left)
  map f := CommRingCat.ofHom
    ((globalPullback p f.unop.hom.left).restrict _ _ (fun a ha ↦
      globalPullback_plus p f.unop.hom.left ⟨a, ha⟩))
  map_id := by sorry
  map_comp := by sorry

/-- Ring-valued descent, Sch12 Proposition 7.13 and ECD Theorem 6.3. -/
theorem etaleORing_isSheaf (X : Perfd p) :
    Presheaf.IsSheaf (smallEtaleTopology p X) (etaleORing p X) := sorry

theorem etaleOPlusRing_isSheaf (X : Perfd p) :
    Presheaf.IsSheaf (smallEtaleTopology p X) (etaleOPlusRing p X) := sorry

/-- Forgetting multiplication recovers the coefficient presheaves used for cohomology. -/
theorem etaleRing_forget (X : Perfd p) :
    Nonempty (etaleORing p X ⋙ forget₂ CommRingCat RingCat ⋙
      forget₂ RingCat AddCommGrpCat ≅ etaleO p X) ∧
    Nonempty (etaleOPlusRing p X ⋙ forget₂ CommRingCat RingCat ⋙
      forget₂ RingCat AddCommGrpCat ≅ etaleOPlus p X) := sorry

/-- The additive cokernel is the underlying sheaf of the quotient ring sheaf;
the quotient arrow, not only the object, agrees with the additive cokernel. -/
theorem etaleOPlusQuotient_ring (X : Perfd p) (a : globalPlus p X) :
    ∃ (Q : Sheaf (smallEtaleTopology p X) CommRingCat.{1})
      (q : etaleOPlusRing p X ⟶ Q.obj)
      (e : Q.obj ⋙ forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat ≅
        (etaleOPlusQuotient p X a).obj),
      ∀ (U : smallEtale p X) (s : globalPlus p U.obj.left),
        e.hom.app (Opposite.op U) ((q.app (Opposite.op U)).hom s) =
          (cokernel.π (etaleIntegralScalar p X a)).hom.app (Opposite.op U) s := sorry

-- Check: etaleORing_affinoid
example (R : PairCat.{0} p) (U : smallEtale p (ofPair p R))
    (hU : U.obj = Over.mk (𝟙 _)) :
    Nonempty ((etaleORing p (ofPair p R)).obj (Opposite.op U) ≃+* R) := sorry
-- Check: etaleORing_empty
example (X : Perfd p) (U : smallEtale p X)
    [IsEmpty (YonedaAdicSpace.space.obj U.obj.left.obj)] :
    Subsingleton ((etaleORing p X).obj (Opposite.op U)) := sorry
-- Check: etaleORing_first_component
example (R : PairCat.{0} p) (a b : R) :
    let S : PairCat.{0} p :=
      { carrier := R × R, pair := ⟨R.pair.plus.prod R.pair.plus, by sorry⟩ }
    let r : S ⟶ R := ⟨RingHom.fst R R, continuous_fst, fun _ h ↦ h.1⟩
    let X := ofPair p S
    let U : smallEtale p X := ⟨Over.mk ((spaFunctor p).map r.op), by sorry⟩
    let V : smallEtale p X := ⟨Over.mk (𝟙 X), by sorry⟩
    let f : U ⟶ V := ObjectProperty.homMk (Over.homMk ((spaFunctor p).map r.op))
    globalSectionsAffinoidEquiv p R (((etaleORing p X).map f.op).hom
      ((globalSectionsAffinoidEquiv p S).symm (a, b))) = a := sorry

-- Check: etaleOPlusRing_affinoid
example (R : PairCat.{0} p) (U : smallEtale p (ofPair p R))
    (hU : U.obj = Over.mk (𝟙 _)) :
    Nonempty ((etaleOPlusRing p (ofPair p R)).obj (Opposite.op U) ≃+* R.pair.plus) := sorry
-- Check: etaleOPlusRing_empty
example (X : Perfd p) (U : smallEtale p X)
    [IsEmpty (YonedaAdicSpace.space.obj U.obj.left.obj)] :
    Subsingleton ((etaleOPlusRing p X).obj (Opposite.op U)) := sorry
-- Check: etaleOPlusRing_second_component
example (R : PairCat.{0} p) (a b : R.pair.plus) :
    let S : PairCat.{0} p :=
      { carrier := R × R, pair := ⟨R.pair.plus.prod R.pair.plus, by sorry⟩ }
    let r : S ⟶ R := ⟨RingHom.snd R R, continuous_snd, fun _ h ↦ h.2⟩
    let X := ofPair p S
    let U : smallEtale p X := ⟨Over.mk ((spaFunctor p).map r.op), by sorry⟩
    let V : smallEtale p X := ⟨Over.mk (𝟙 X), by sorry⟩
    let f : U ⟶ V := ObjectProperty.homMk (Over.homMk ((spaFunctor p).map r.op))
    let z : globalPlus p X := ⟨(globalSectionsAffinoidEquiv p S).symm (a.val, b.val), by sorry⟩
    globalSectionsAffinoidEquiv p R
      ((((etaleOPlusRing p X).map f.op).hom z).val) = b.val := sorry

/-- Integral functions are algebras over integral functions on the base, via pullback. -/
def etaleOPlusAlgebra (X : Perfd p) :
    (smallEtale p X)ᵒᵖ ⥤ CommAlgCat.{1} (globalPlus p X) where
  obj U := by
    let φ : globalPlus p X →+* globalPlus p U.unop.obj.left :=
      (globalPullback p U.unop.obj.hom).restrict _ _
        (fun a ha ↦ globalPullback_plus p U.unop.obj.hom ⟨a, ha⟩)
    letI := φ.toAlgebra
    exact CommAlgCat.of (globalPlus p X) (globalPlus p U.unop.obj.left)
  map {U V} f := by
    letI : Algebra (globalPlus p X) (globalPlus p U.unop.obj.left) :=
      ((globalPullback p U.unop.obj.hom).restrict _ _
        (fun a ha ↦ globalPullback_plus p U.unop.obj.hom ⟨a, ha⟩)).toAlgebra
    letI : Algebra (globalPlus p X) (globalPlus p V.unop.obj.left) :=
      ((globalPullback p V.unop.obj.hom).restrict _ _
        (fun a ha ↦ globalPullback_plus p V.unop.obj.hom ⟨a, ha⟩)).toAlgebra
    exact CommAlgCat.ofHom
      { toRingHom := ((etaleOPlusRing p X).map f).hom
        commutes' := by sorry }
  map_id := by sorry
  map_comp := by sorry

/-- The algebra lift has the same ring presheaf and satisfies étale descent. -/
theorem etaleOPlusAlgebra_forget (X : Perfd p) :
    Nonempty (etaleOPlusAlgebra p X ⋙ forget₂ (CommAlgCat (globalPlus p X)) CommRingCat ≅
      etaleOPlusRing p X) ∧
    Presheaf.IsSheaf (smallEtaleTopology p X) (etaleOPlusAlgebra p X) := sorry

-- Check: etaleOPlusAlgebra_scalars
example (X : Perfd p) (U : smallEtale p X) (a : globalPlus p X) :
    (algebraMap (globalPlus p X)
      ((etaleOPlusAlgebra p X).obj (Opposite.op U)) a).val =
        globalPullback p U.obj.hom a.val := rfl
-- Check: etaleOPlusAlgebra_empty
example (X : Perfd p) (U : smallEtale p X)
    [IsEmpty (YonedaAdicSpace.space.obj U.obj.left.obj)] :
    Subsingleton ((etaleOPlusAlgebra p X).obj (Opposite.op U)) := sorry
-- Check: etaleOPlusAlgebra_nonzero
example (R : PairCat.{0} p) [Nontrivial R] (U : smallEtale p (ofPair p R))
    (hU : U.obj = Over.mk (𝟙 _)) :
    (1 : (etaleOPlusAlgebra p (ofPair p R)).obj (Opposite.op U)) ≠ 0 := sorry

/-- Almost integral functions relative to an explicit basic setup on base sections. -/
def etaleOPlusAlmost (X : Perfd p) (S : Almost.BasicSetup (globalPlus p X)) :
    (smallEtale p X)ᵒᵖ ⥤ Almost.Algebra S :=
  etaleOPlusAlgebra p X ⋙ Almost.Algebra.toAlmost S

/-- Almostification preserves the sheaf condition, GR 3.3.1–3.3.2. -/
theorem etaleOPlusAlmost_isSheaf (X : Perfd p) (S : Almost.BasicSetup (globalPlus p X)) :
    Presheaf.IsSheaf (smallEtaleTopology p X) (etaleOPlusAlmost p X S) := sorry

/-- The geometric almost setup on affinoid integral sections is the transport of
(R⁺, R°°) along the global section identification. -/
theorem etaleOPlusAlmost_affinoidSetup (R : PairCat.{0} p) :
    ∃ S : Almost.BasicSetup (globalPlus p (ofPair p R)),
      ∀ a : globalPlus p (ofPair p R), a ∈ S.ideal ↔
        IsTopologicallyNilpotent (globalSectionsAffinoidEquiv p R a.val) := sorry

-- Check: etaleOPlusAlmost_classical
example (X : Perfd p) (U : smallEtale p X) :
    Nonempty (((Almost.Algebra.classicalEquiv (V := globalPlus p X)).inverse.obj
      ((etaleOPlusAlmost p X (Almost.BasicSetup.classical (globalPlus p X))).obj
        (Opposite.op U))) ≅ (etaleOPlusAlgebra p X).obj (Opposite.op U)) := sorry
-- Check: etaleOPlusAlmost_zero_ideal
example (X : Perfd p) (S : Almost.BasicSetup (globalPlus p X)) (hS : S.ideal = ⊥)
    (U : smallEtale p X) :
    IsZero (((etaleOPlusAlmost p X S).obj (Opposite.op U)).X) := sorry
-- Check: etaleOPlusAlmost_classical_nonzero
example (R : PairCat.{0} p) [Nontrivial R] (U : smallEtale p (ofPair p R))
    (hU : U.obj = Over.mk (𝟙 _)) :
    ¬ IsZero (((etaleOPlusAlmost p (ofPair p R)
      (Almost.BasicSetup.classical (globalPlus p (ofPair p R)))).obj (Opposite.op U)).X) := sorry

/-- Pullback of the supplied adic étale site to a perfectoid space. -/
def etaleAdicBaseChange (X : Perfd p) (Y : TauCeti.AdicSpace)
    (hY : AdicSpace.IsLocallyStronglySheafy Y)
    (f : X.obj ⟶ YonedaAdicSpace.ofAdicSpace.obj Y) :
    AdicSpace.smallEtale Y ⥤ smallEtale p X := sorry

/-- Both pullback projections determine base change on objects and arrows. -/
theorem etaleAdicBaseChange_isPullback (X : Perfd p) (Y : TauCeti.AdicSpace)
    (hY : AdicSpace.IsLocallyStronglySheafy Y)
    (f : X.obj ⟶ YonedaAdicSpace.ofAdicSpace.obj Y) :
    ∃ π : ∀ U : AdicSpace.smallEtale Y,
      ((etaleAdicBaseChange p X Y hY f).obj U).obj.left.obj ⟶
        YonedaAdicSpace.ofAdicSpace.obj U.left,
      (∀ U, IsPullback (π U) ((etaleAdicBaseChange p X Y hY f).obj U).obj.hom.hom
        (YonedaAdicSpace.ofAdicSpace.map U.hom) f) ∧
      ∀ {U V : AdicSpace.smallEtale Y} (g : U ⟶ V),
        ((etaleAdicBaseChange p X Y hY f).map g).hom.left.hom ≫ π V =
          π U ≫ YonedaAdicSpace.ofAdicSpace.map g.left := sorry

theorem etaleAdicBaseChange_continuous (X : Perfd p) (Y : TauCeti.AdicSpace)
    (hY : AdicSpace.IsLocallyStronglySheafy Y)
    (f : X.obj ⟶ YonedaAdicSpace.ofAdicSpace.obj Y) :
    (etaleAdicBaseChange p X Y hY f).IsContinuous
      (AdicSpace.smallEtaleTopology Y hY) (smallEtaleTopology p X) := sorry

theorem etaleAdicBaseChange_preservesFiniteLimits (X : Perfd p) (Y : TauCeti.AdicSpace)
    (hY : AdicSpace.IsLocallyStronglySheafy Y)
    (f : X.obj ⟶ YonedaAdicSpace.ofAdicSpace.obj Y) :
    PreservesFiniteLimits (etaleAdicBaseChange p X Y hY f) := sorry

-- Check: etaleAdicBaseChange_identity_object
example (X : Perfd p) (Y : TauCeti.AdicSpace)
    (hY : AdicSpace.IsLocallyStronglySheafy Y)
    (f : X.obj ⟶ YonedaAdicSpace.ofAdicSpace.obj Y)
    (U : AdicSpace.smallEtale Y) [IsIso U.hom] :
    IsIso ((etaleAdicBaseChange p X Y hY f).obj U).obj.hom := sorry
-- Check: etaleAdicBaseChange_empty
