section Homeomorph

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  (P : Pair R)

/-! ### P2/tilting-homeomorphism-and-rational-subsets -/

/-- The tilting map is a homeomorphism
`Spa(R, R⁺) ≃ₜ Spa(R♭, R♭⁺)` (ECD Theorem 3.12; Sch12 Corollary 6.7(iii); KL II Theorem 3.3.16;
AWS Theorem 2.5.1). Its naturality is `spaTilt_comp_spaComap`. -/
def spaTiltHomeomorph : spa P.plus ≃ₜ spa (Perfectoid.Pair.tilt p P).plus := sorry

/-- The forward map is `spaTilt`. -/
@[simp] theorem coe_spaTiltHomeomorph : ⇑(spaTiltHomeomorph p P) = spaTilt p P := sorry

/-- `U ⊆ X` is rational iff `τ_R(U) ⊆ X♭` is
rational (ECD Theorem 3.12). The explicit image formula is
`Perfectoid.rationalLocalization.image_spaTilt`. -/
theorem isRational_image_spaTilt_iff (U : Set (spa P.plus)) :
    U ∈ spaRationalFamily P.plus ↔
      spaTilt p P '' U ∈ spaRationalFamily (Perfectoid.Pair.tilt p P).plus := sorry

open scoped Classical in
/-- Every rational `U ⊆ X` is `U(T♯/s♯)` for some
`T ⊆ R♭⁺` containing `(ϖ♭)^N` and `s ∈ R♭⁺` (Sch12 Corollary 6.7(iii)). -/
theorem exists_sharp_presentation (ϖ : PseudoUniformizerRoots p R) {U : Set (spa P.plus)}
    (hU : U ∈ spaRationalFamily P.plus) :
    ∃ (T : Finset (tilt p R)) (s : tilt p R) (N : ℕ),
      (∀ t ∈ T, t ∈ (Perfectoid.Pair.tilt p P).plus) ∧ s ∈ (Perfectoid.Pair.tilt p P).plus ∧
      ϖ.toTilt ^ N ∈ T ∧
      U = Subtype.val ⁻¹' rationalSubset P.plus (T.image (tilt.sharp : tilt p R → R))
        (tilt.sharp s) := sorry

/-- The valuation tilting map is continuous (ECD Theorem 3.12, p. 17). -/
theorem continuous_spaTilt : Continuous (spaTilt p P) := by
  rw [← coe_spaTiltHomeomorph]
  exact (spaTiltHomeomorph p P).continuous

end Homeomorph

section TiltingChecks

variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R] (P : Pair R)

-- Check spaTilt_test_zero_one: the direction is |0| ≤ |1|, never |1| ≤ |0|.
example (x : spa P.plus) :
    (spaTilt p P x).1.toValuativeRel.vle 0 1 ∧
      ¬ (spaTilt p P x).1.toValuativeRel.vle 1 0 := sorry

-- Check spaTilt_test_two_powers: |ϖ²| < |ϖ| at every analytic point.
example (ϖ : PseudoUniformizerRoots p R) (x : spa P.plus) :
    (spaTilt p P x).1.toValuativeRel.vle (ϖ.toTilt ^ 2) ϖ.toTilt ∧
      ¬ (spaTilt p P x).1.toValuativeRel.vle ϖ.toTilt (ϖ.toTilt ^ 2) := sorry

-- Check spaTilt_test_charP_eq_id.
example [CharP R p] (x : spa P.plus) :
    (spaTilt p P x).1 =
      ValuationSpectrum.comap (tilt.equivOfCharP : tilt p R ≃+* R).toRingHom x.1 :=
  spaTilt_eq_id_of_charP p P x

-- Check spaTilt_test_no_ringHom.
example : IsEmpty (tilt p (padicCyclotomic p) →+* padicCyclotomic p) := sorry

-- Check spaTiltHomeomorph_test_empty.
example : spaTiltHomeomorph p P '' (∅ : Set (spa P.plus)) = ∅ := Set.image_empty _

-- Check spaTiltHomeomorph_test_whole.
example : spaTiltHomeomorph p P '' (Set.univ : Set (spa P.plus)) = Set.univ :=
  Set.image_univ_of_surjective (spaTiltHomeomorph p P).surjective

-- Check spaTiltHomeomorph_test_charP.
example [CharP R p] (x : spa P.plus) :
    (spaTiltHomeomorph p P x).1 =
      ValuationSpectrum.comap (tilt.equivOfCharP : tilt p R ≃+* R).toRingHom x.1 := by
  rw [coe_spaTiltHomeomorph]
  exact spaTilt_eq_id_of_charP p P x

end TiltingChecks

