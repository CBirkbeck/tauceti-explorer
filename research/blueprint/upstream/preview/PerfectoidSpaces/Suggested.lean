/-! ### P3/finite-etale-untilting-functor -/

/-- Untilting finite étale algebras by reducing their almost integral structures modulo
`ϖ♭`, transporting along `R♭°/ϖ♭ ≃ R°/ϖ`, deforming uniquely, and inverting `ϖ`.
The choice satisfies `ϖ = (ϖ♭)♯` and `ϖ ^ p ∣ p`; different choices give naturally
isomorphic functors (Sch12 Proposition 5.22; AWS Lemma 2.8.10). -/
def FiniteEtale.untilt (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R]
    [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R]
    [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] :
    CommAlgCat.FiniteEtale.{u} (tilt p R) ⥤ CommAlgCat.FiniteEtale.{u} R := sorry

-- check untilt_test_rank_zero
example : Nonempty ((FiniteEtale.untilt p R).obj
    (CommAlgCat.FiniteEtale.of (tilt p R) (Fin 0 → tilt p R)) ≅
      CommAlgCat.FiniteEtale.of R (Fin 0 → R)) := sorry

-- check untilt_test_rank_one
example : Nonempty ((FiniteEtale.untilt p R).obj
    (CommAlgCat.FiniteEtale.of (tilt p R) (tilt p R)) ≅
      CommAlgCat.FiniteEtale.of R R) := sorry

-- check untilt_test_rank_two
example : Nonempty ((FiniteEtale.untilt p R).obj
    (CommAlgCat.FiniteEtale.of (tilt p R) (Fin 2 → tilt p R)) ≅
      CommAlgCat.FiniteEtale.of R (Fin 2 → R)) := sorry

-- check almost_purity_test_product_perfectoid
/- The product of two copies of a perfectoid Tate ring, with the product uniformity, is a
perfectoid Tate ring (`ϖ = (ϖ, ϖ)`, `(R × R)° = R° × R°`, Frobenius componentwise): the ring of
the split finite étale cover `X ⊔ X → X`. -/
include hperfect in
example (ϖ : PseudoUniformizerRoots p R) :
    IsPerfectoidTateRing p (R × R) ∧
      powerBoundedSubring (R × R) = (powerBoundedSubring R).prod (powerBoundedSubring R) ∧
      IsPseudoUniformizer (ϖ.root 0, ϖ.root 0) := sorry

end Untilt

