/-! ### P0/almost-nakayama -/

/-- GR 5.1.6: Nakayama for an almost finite module and a tight radical ideal.
The vanishing of the represented quotient expresses IM = M after almostification. -/
theorem almostZero_of_quotient_almostZero (A : Algebra S)
    (I : _root_.Ideal ((elements S).obj A)) (hI : IsTight S A I)
    (hrad : I ≤ jacobson S A) (M : Type u) [AddCommGroup M]
    [_root_.Module ((elements S).obj A) M]
    (hM : Module.AlmostFG (S.baseChange ((elements S).obj A)) M)
    (hq : (S.baseChange ((elements S).obj A)).IsAlmostZero
      (M ⧸ (I • (⊤ : Submodule ((elements S).obj A) M)))) :
    (S.baseChange ((elements S).obj A)).IsAlmostZero M := sorry

/-! ### P0/tight-henselian-idempotent-lifting -/

/-- GR 5.1.17: idempotents lift uniquely in a tight henselian almost pair. -/
theorem existsUnique_idempotent_lift (A : Algebra S)
    (I : _root_.Ideal ((elements S).obj A)) (hI : IsTight S A I)
    (hh : IsHenselianPair S A I)
    (e : (elements S).obj (quotient S A I)) (he : IsIdempotentElem e) :
    ∃! d : (elements S).obj A,
      IsIdempotentElem d ∧ ((elements S).map (quotientMap S A I)).hom d = e := sorry

/-! ### P0/unramified-lifts-from-complete-reduction -/

/-- GR 5.2.12(ii): two unramified reductions give an unramified product-ideal reduction. -/
theorem isUnramified_quotient_mul {A B : Algebra S} (f : A ⟶ B)
    (I J : _root_.Ideal ((elements S).obj A))
    (hI : IsUnramified S (pushout.inr f (quotientMap S A I)))
    (hJ : IsUnramified S (pushout.inr f (quotientMap S A J))) :
    IsUnramified S (pushout.inr f (quotientMap S A (I * J))) := sorry

/-- GR 5.2.15: a tight radical reduction detects unramifiedness of an almost finite algebra. -/
theorem isUnramified_of_quotient {A B : Algebra S} (f : A ⟶ B)
    (I : _root_.Ideal ((elements S).obj A)) (hI : IsTight S A I)
    (hrad : I ≤ jacobson S A) (hfinite : IsAlmostFinite S f)
    (hred : IsUnramified S (pushout.inr f (quotientMap S A I))) :
    IsUnramified S f := sorry

/-- GR 5.3.29: the complete almost finite projective case. -/
theorem isUnramified_of_complete_quotient {A B : Algebra S} (f : A ⟶ B)
    (I : _root_.Ideal ((elements S).obj A)) (hI : IsTight S A I)
    (hc : IsAdicComplete S A I)
    (hfinite : Module.AlmostFiniteProjective _ (relativeModule S f))
    (hred : IsUnramified S (pushout.inr f (quotientMap S A I))) :
    IsUnramified S f := sorry

/-! ### P0/finite-etale-lift-flat-and-complete -/

/-- Sch12 4.17: finite étale almost algebras retain principal-adic completeness
and, when the base is flat over the basic setup, that flatness. -/
theorem IsFiniteEtale.isAdicComplete {A B : Algebra S} (f : A ⟶ B)
    (hf : IsFiniteEtale S f) (ϖ : V) (hϖ : ϖ ∈ S.ideal)
    (hc : IsAdicComplete S A (_root_.Ideal.span {algebraMap V ((elements S).obj A) ϖ})) :
    IsAdicComplete S B (_root_.Ideal.span {algebraMap V ((elements S).obj B) ϖ}) ∧
      (Module.Flat S A.X → Module.Flat S B.X) := sorry

/-! ### P0/uniform-finite-projectivity-mod-varpi -/

/-- Sch12 4.17: a root setup preserves the same uniform bound under complete reduction. -/
theorem uniformlyAlmostFG_quotient_iff (p : ℕ) (hp : 2 ≤ p)
    (t : ℕ → V) (ht : ∀ n, t (n + 1) ^ p = t n)
    (A B : Algebra (BasicSetup.ofCompatibleRoots p hp t ht)) (f : A ⟶ B)
    (hf : IsFiniteEtale (BasicSetup.ofCompatibleRoots p hp t ht) f)
    (hc : IsAdicComplete (BasicSetup.ofCompatibleRoots p hp t ht) A
      (_root_.Ideal.span {algebraMap V ((elements _).obj A) (t 0)})) (r : ℕ) :
    let S := BasicSetup.ofCompatibleRoots p hp t ht
    let I := _root_.Ideal.span {algebraMap V ((elements S).obj A) (t 0)}
    let q := quotientMap S A I
    let g : quotient S A I ⟶ pushout f q := pushout.inr f q
    Module.UniformlyAlmostFG (S.baseChange ((elements S).obj A))
      ((Module.elements _).obj (relativeModule S f)) r ↔
    Module.UniformlyAlmostFG (S.baseChange ((elements S).obj (quotient S A I)))
      ((Module.elements _).obj (relativeModule S g)) r := sorry

/-! ### P0/almost-differentials -/

/-- Almost differentials are almostified differentials of the almost-element rings, GR (2.5.22)–(2.5.28). -/
def kaehlerDifferential {A B : Algebra S} (f : A ⟶ B) : Module (S.baseChange ((elements S).obj B)) :=
  letI := ((elements S).map f).hom.toAlgebra
  (Almost.toAlmost _).obj (_root_.ModuleCat.of ((elements S).obj B)
    (KaehlerDifferential ((elements S).obj A) ((elements S).obj B)))

/-- The universal derivation on almost elements, obtained from the ordinary derivation. -/
def kaehlerDifferentialD {A B : Algebra S} (f : A ⟶ B) :
    ((elements S).obj B) → (Module.elements _).obj (kaehlerDifferential S f) :=
  letI := ((elements S).map f).hom.toAlgebra
  fun b => ((Module.adjElements _).unit.app
    (_root_.ModuleCat.of ((elements S).obj B)
      (KaehlerDifferential ((elements S).obj A) ((elements S).obj B)))).hom
        (KaehlerDifferential.D ((elements S).obj A) ((elements S).obj B) b)

/-- Derivations of almost algebras are derivations on their almost elements, GR 2.5.22. -/
abbrev Derivation {A B : Algebra S} (f : A ⟶ B)
    (M : Module (S.baseChange ((elements S).obj B))) :=
  letI := ((elements S).map f).hom.toAlgebra
  letI : _root_.Module ((elements S).obj A) ((Module.elements _).obj M) :=
    _root_.Module.compHom _ (((elements S).map f).hom.toRingHom)
  _root_.Derivation ((elements S).obj A) ((elements S).obj B)
    ((Module.elements _).obj M)

/-- GR 2.5.25: the universal almost derivation represents derivations, including its value. -/
theorem kaehlerDifferential.liftEquiv {A B : Algebra S} (f : A ⟶ B)
    (M : Module (S.baseChange ((elements S).obj B))) :
    letI := ((elements S).map f).hom.toAlgebra
    letI : _root_.Module ((elements S).obj A) ((Module.elements _).obj M) :=
      _root_.Module.compHom _ (((elements S).map f).hom.toRingHom)
    ∃ e : (kaehlerDifferential S f ⟶ M) ≃ Derivation S f M,
      ∀ (u : kaehlerDifferential S f ⟶ M) b,
        (e u).toLinearMap b = ((Module.elements _).map u).hom (kaehlerDifferentialD S f b) := sorry

-- Check: Derivation_identity
example (A : Algebra S) (M : Module (S.baseChange ((elements S).obj A))) :
    Subsingleton (Derivation S (𝟙 A) M) := sorry
-- Check: Derivation_zero
example {A B : Algebra S} (f : A ⟶ B) :
    Subsingleton (Derivation S f (0 : Module (S.baseChange ((elements S).obj B)))) := sorry
-- Check: Derivation_polynomial
example : let T := BasicSetup.classical ℚ
    let f := (toAlmost T).map (CommAlgCat.ofHom (Algebra.ofId ℚ (Polynomial ℚ)))
    Nontrivial (Derivation T f (𝟙_ (Module (T.baseChange
      ((elements T).obj ((toAlmost T).obj (CommAlgCat.of ℚ (Polynomial ℚ)))))))) := sorry

/-- Almost differentials of honest representatives, with scalars extended to the ring of
almost elements, GR Definition 2.5.22 and Proposition 2.5.25. -/
theorem kaehlerDifferential_toAlmost (R T : Type u) [CommRing R] [CommRing T]
    [_root_.Algebra V R] [_root_.Algebra V T] [_root_.Algebra R T] [IsScalarTower V R T] :
    let A := (toAlmost S).obj (CommAlgCat.of V R)
    let B := (toAlmost S).obj (CommAlgCat.of V T)
    letI : _root_.Algebra T ((elements S).obj B) :=
      (((adj S).unit.app (CommAlgCat.of V T)).hom.toRingHom).toAlgebra
    let U := S.baseChange ((elements S).obj B)
    let N := _root_.ModuleCat.of ((elements S).obj B)
      (((elements S).obj B) ⊗[T] KaehlerDifferential R T)
    ∃ e : kaehlerDifferential S ((toAlmost S).map
        (CommAlgCat.ofHom (IsScalarTower.toAlgHom V R T))) ≅ (Almost.toAlmost U).obj N,
      ∀ t : T, ((Module.elements U).map e.hom).hom
        (kaehlerDifferentialD S ((toAlmost S).map
          (CommAlgCat.ofHom (IsScalarTower.toAlgHom V R T)))
          (((adj S).unit.app (CommAlgCat.of V T)).hom t)) =
        ((Module.adjElements U).unit.app N).hom
          ((1 : (elements S).obj B) ⊗ₜ[T] KaehlerDifferential.D R T t) := sorry

/-- Unramified almost algebra maps have zero differentials: the diagonal idempotent gives
`I = I²`, so `I/I² = 0`, GR Proposition 3.1.4, p. 40, and Definition 2.5.22(ii), p. 33. -/
theorem kaehlerDifferential_eq_zero_of_isUnramified {A B : Algebra S} (f : A ⟶ B)
    (hf : IsUnramified S f) : IsZero (kaehlerDifferential S f) := sorry

/-- Exactness of the transitivity sequence after almostification, GR Proposition 2.5.25(i). -/
theorem kaehlerDifferential.exact_seq (R T U : Type u) [CommRing R] [CommRing T] [CommRing U]
    [_root_.Algebra V R] [_root_.Algebra V T] [_root_.Algebra V U]
    [_root_.Algebra R T] [_root_.Algebra R U] [_root_.Algebra T U]
    [IsScalarTower V R T] [IsScalarTower V T U] [IsScalarTower R T U] :
    let F := Almost.toAlmost (S.baseChange U)
    let a := F.map (_root_.ModuleCat.ofHom (KaehlerDifferential.mapBaseChange R T U))
    let b := F.map (_root_.ModuleCat.ofHom (KaehlerDifferential.map R T U U))
    (ShortComplex.mk a b (by sorry)).Exact ∧ Epi b := sorry

/-- The conormal sequence for a quotient after almostification, GR Proposition 2.5.25(ii). -/
theorem kaehlerDifferential.exact_seq_quotient (R T : Type u) [CommRing R] [CommRing T]
    [_root_.Algebra V R] [_root_.Algebra V T] [_root_.Algebra R T] [IsScalarTower V R T]
    (I : _root_.Ideal T) :
    let U := T ⧸ I
    let F := Almost.toAlmost (S.baseChange T)
    let a := F.map (_root_.ModuleCat.ofHom (KaehlerDifferential.kerCotangentToTensor R T U))
    let b := F.map (_root_.ModuleCat.ofHom ((KaehlerDifferential.mapBaseChange R T U).restrictScalars T))
    (ShortComplex.mk a b (by sorry)).Exact ∧ Epi b := sorry

