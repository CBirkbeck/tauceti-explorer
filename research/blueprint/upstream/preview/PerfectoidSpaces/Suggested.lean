/-! ### Layer 6: Global cardinal predicates and the pro-étale categories -/
open TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]

/-! ### P6/kappa-small-perfectoid-space -/

/-- ECD Definition 4.2, p. 20, on all open affinoid charts of the supplied space. -/
structure IsKappaSmall (κ : Cardinal.{1}) (X : Perfd p) : Prop where
  card_lt : #(underlyingPoints p X) < κ
  card_sections_lt : ∀ C : Chart p X, Cardinal.lift.{1} #C.ring < κ

/-! ### P6/uniformly-kappa-small-perfectoid-space -/

/-- One cardinal bounds points and all affinoid section rings (ECD 6.4, p. 27). -/
def IsUniformlyKappaSmall (κ : Cardinal.{1}) (X : Perfd p) : Prop :=
  ∃ μ < κ, #(underlyingPoints p X) ≤ μ ∧
    ∀ C : Chart p X, Cardinal.lift.{1} #C.ring ≤ μ

abbrev KappaSmall (κ : Cardinal.{1}) := ObjectProperty.FullSubcategory (IsKappaSmall p κ)

theorem IsKappaSmall.mono {κ κ' : Cardinal.{1}} (hκ : κ ≤ κ') {X : Perfd p}
    (h : IsKappaSmall p κ X) : IsKappaSmall p κ' X :=
  ⟨h.card_lt.trans_le hκ, fun C ↦ (h.card_sections_lt C).trans_le hκ⟩

theorem IsKappaSmall.of_iso {κ : Cardinal.{1}} {X Y : Perfd p} (e : X ≅ Y)
    (h : IsKappaSmall p κ X) : IsKappaSmall p κ Y := sorry

theorem IsKappaSmall.empty (X : Perfd p) [IsEmpty (underlyingPoints p X)]
    {κ : Cardinal.{1}} (hκ : 1 < κ) : IsKappaSmall p κ X := sorry

theorem isKappaSmall_affinoid_iff (R : PairCat.{0} p) {κ : Cardinal.{1}}
    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) :
    IsKappaSmall p κ (ofPair p R) ↔ Cardinal.lift.{1} #R < κ := sorry

theorem isUniformlyKappaSmall_iff_exists_lt {κ : Cardinal.{1}}
    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (X : Perfd p) :
    IsUniformlyKappaSmall p κ X ↔ ∃ κ' < κ, IsKappaSmall p κ' X := sorry

theorem IsUniformlyKappaSmall.isKappaSmall {κ : Cardinal.{1}} {X : Perfd p}
    (h : IsUniformlyKappaSmall p κ X) : IsKappaSmall p κ X := by
  obtain ⟨μ, hμ, hX, hC⟩ := h
  exact ⟨hX.trans_lt hμ, fun C ↦ (hC C).trans_lt hμ⟩

theorem IsUniformlyKappaSmall.of_isKappaSmall_of_compactSpace
    {κ : Cardinal.{1}} (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    (X : Perfd p) [CompactSpace (underlyingPoints p X)] (h : IsKappaSmall p κ X) :
    IsUniformlyKappaSmall p κ X := sorry

theorem IsUniformlyKappaSmall.of_isRegular {κ : Cardinal.{1}}
    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (hr : κ.IsRegular)
    (X : Perfd p) (h : IsKappaSmall p κ X) : IsUniformlyKappaSmall p κ X := sorry

theorem isUniformlyKappaSmall_affinoid_iff (R : PairCat.{0} p) {κ : Cardinal.{1}}
    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) :
    IsUniformlyKappaSmall p κ (ofPair p R) ↔ Cardinal.lift.{1} #R < κ := sorry

/-! ### P6/kappa-small-closure -/

theorem IsKappaSmall.isOpen {κ : Cardinal.{1}} {X Y : Perfd p} (f : Y ⟶ X)
    (hf : IsOpenImmersion p f) (hX : IsKappaSmall p κ X) : IsKappaSmall p κ Y := sorry

theorem IsUniformlyKappaSmall.isOpen {κ : Cardinal.{1}} {X Y : Perfd p} (f : Y ⟶ X)
    (hf : IsOpenImmersion p f) (hX : IsUniformlyKappaSmall p κ X) :
    IsUniformlyKappaSmall p κ Y := sorry

theorem IsUniformlyKappaSmall.fibreProduct {κ : Cardinal.{1}}
    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) {X Y Z : Perfd p}
    (f : X ⟶ Z) (g : Y ⟶ Z) (hX : IsUniformlyKappaSmall p κ X)
    (hY : IsUniformlyKappaSmall p κ Y) :
    IsUniformlyKappaSmall p κ (pullback f g) := sorry

/-! ### P6/kappa-small-cover-criterion -/

theorem IsKappaSmall.of_cover {κ : Cardinal.{1}} (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    (X : Perfd p) {J : Type*} (C : J → Chart p X)
    (hcover : ∀ x, ∃ j, x ∈ Set.range (pointMap p (C j).map))
    (hC : ∀ j, Cardinal.lift.{1} #(C j).ring < κ)
    (hX : #(underlyingPoints p X) < κ) : IsKappaSmall p κ X := sorry

theorem uniform_of_cover {κ : Cardinal.{1}} (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    (X : Perfd p) {J : Type} (C : J → Chart p X)
    (hcover : ∀ x, ∃ j, x ∈ Set.range (pointMap p (C j).map))
    {μ : Cardinal.{1}} (hμ : μ < κ) (hJ : Cardinal.lift.{1} #J ≤ μ)
    (hC : ∀ j, Cardinal.lift.{1} #(C j).ring ≤ μ) : IsUniformlyKappaSmall p κ X := sorry

/-! ### P6/kappa-small-tilting -/

theorem IsKappaSmall.tilt_iff {κ : Cardinal.{1}} (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    (X : Perfd p) : IsKappaSmall p κ ((tiltFunctor p).obj X) ↔ IsKappaSmall p κ X := sorry

theorem IsUniformlyKappaSmall.tilt_iff {κ : Cardinal.{1}}
    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (X : Perfd p) :
    IsUniformlyKappaSmall p κ ((tiltFunctor p).obj X) ↔ IsUniformlyKappaSmall p κ X := sorry

/-- ECD 7.10, p. 33: the affinoid part of the supplied small étale category. -/
abbrev AffinoidEtale (X : Perfd p) := ObjectProperty.FullSubcategory
  (fun Y : Over X ↦ IsAffinoidPerfectoid p Y.left.obj ∧ IsEtale p Y.hom)

/-! ### P6/affinoid-pro-etale-map -/

/-- ECD 7.8(i), p. 32: a small cofiltered étale diagram and its actual limit cone.
The cone is over X, so the structure map is part of the limit identification. -/
structure ProEtalePresentation {Y X : Perfd p} (f : Y ⟶ X) where
  source_affinoid : IsAffinoidPerfectoid p Y.obj
  target_affinoid : IsAffinoidPerfectoid p X.obj
  I : Type
  [category : SmallCategory I]
  [cofiltered : IsCofiltered I]
  diagram : I ⥤ AffinoidEtale p X
  cone : Cone (diagram ⋙ ObjectProperty.ι _)
  point_eq : cone.pt = Over.mk f
  isLimit : IsLimit cone
attribute [instance] ProEtalePresentation.category ProEtalePresentation.cofiltered

/-- Existence of the ECD presentation, without restrictions on transition maps. -/
def IsAffinoidProEtale {Y X : Perfd p} (f : Y ⟶ X) : Prop :=
  Nonempty (ProEtalePresentation p f)

abbrev AffinoidProEtale (X : Perfd p) :=
  ObjectProperty.FullSubcategory (fun Y : Over X ↦ IsAffinoidProEtale p Y.hom)

/-! ### P6: pro-etale-site-corrected -/

/-! ### P6: proetale-site-on-analytic-carriers -/

/-! ### P6/pro-etale-map -/

/-- ECD 7.8(ii), p. 32: open affinoid charts containing each source point. -/
def IsProEtale {Y X : Perfd p} (f : Y ⟶ X) : Prop :=
  ∀ y : underlyingPoints p Y, ∃ (V : Chart p Y) (U : Chart p X)
    (g : ofPair p V.ring ⟶ ofPair p U.ring),
      y ∈ Set.range (pointMap p V.map) ∧ V.map ≫ f = g ≫ U.map ∧
      IsAffinoidProEtale p g

abbrev ProEtaleOver (X : Perfd p) :=
  ObjectProperty.FullSubcategory (fun Y : Over X ↦ IsProEtale p Y.hom)

abbrev KappaSmallProEtaleOver (κ : Cardinal.{1}) (X : Perfd p) :=
  ObjectProperty.FullSubcategory (fun Y : ProEtaleOver p X ↦ IsKappaSmall p κ Y.obj.left)

theorem IsAffinoidProEtale.of_presentation {Y X : Perfd p} {f : Y ⟶ X}
    (P : ProEtalePresentation p f) : IsAffinoidProEtale p f := ⟨P⟩

/-- The one-object presentation of an affinoid étale map. -/
def ProEtalePresentation.constant {Y X : Perfd p} (f : Y ⟶ X)
    (hY : IsAffinoidPerfectoid p Y.obj) (hX : IsAffinoidPerfectoid p X.obj)
    (hf : IsEtale p f) : ProEtalePresentation p f where
  source_affinoid := hY
  target_affinoid := hX
  I := Discrete PUnit
  diagram := (Functor.const _).obj ⟨Over.mk f, hY, hf⟩
  cone := { pt := Over.mk f, π := { app := fun _ ↦ 𝟙 _, naturality := by sorry } }
  point_eq := rfl
  isLimit := by sorry

theorem IsAffinoidProEtale.of_isEtale {Y X : Perfd p} {f : Y ⟶ X}
    (hY : IsAffinoidPerfectoid p Y.obj) (hX : IsAffinoidPerfectoid p X.obj)
    (hf : IsEtale p f) : IsAffinoidProEtale p f :=
  ⟨ProEtalePresentation.constant p f hY hX hf⟩

theorem IsAffinoidProEtale.id (X : Perfd p) (hX : IsAffinoidPerfectoid p X.obj) :
    IsAffinoidProEtale p (𝟙 X) := sorry

/-! ### P6/affinoid-pro-etale-composition -/

theorem IsAffinoidProEtale.comp {Z Y X : Perfd p} {g : Z ⟶ Y} {f : Y ⟶ X}
    (hg : IsAffinoidProEtale p g) (hf : IsAffinoidProEtale p f) :
    IsAffinoidProEtale p (g ≫ f) := sorry

/-! ### P6/affinoid-pro-etale-base-change -/

theorem IsAffinoidProEtale.baseChange {Y X X' : Perfd p} {f : Y ⟶ X}
    (hf : IsAffinoidProEtale p f) (g : X' ⟶ X) (hX' : IsAffinoidPerfectoid p X'.obj) :
    IsAffinoidProEtale p (pullback.snd f g) := sorry

/-! ### P6/affinoid-pro-etale-cancellation -/

theorem IsAffinoidProEtale.of_comp {Z Y X : Perfd p} (g : Z ⟶ Y) (f : Y ⟶ X)
    (hgf : IsAffinoidProEtale p (g ≫ f)) (hf : IsAffinoidProEtale p f) :
    IsAffinoidProEtale p g := sorry

/-! ### P6/affinoid-pro-etale-sections -/

theorem IsAffinoidProEtale.section {Y X : Perfd p} {f : Y ⟶ X}
    (hf : IsAffinoidProEtale p f) (s : X ⟶ Y) (hs : s ≫ f = 𝟙 X) :
    IsAffinoidProEtale p s := sorry

theorem IsProEtale.of_isAffinoidProEtale {Y X : Perfd p} {f : Y ⟶ X}
    (hf : IsAffinoidProEtale p f) : IsProEtale p f := sorry

theorem IsProEtale.of_isEtale {Y X : Perfd p} {f : Y ⟶ X}
    (hf : IsEtale p f) : IsProEtale p f := sorry

/-! ### P6/pro-etale-stability-and-limits -/

theorem IsProEtale.comp {Z Y X : Perfd p} {g : Z ⟶ Y} {f : Y ⟶ X}
    (hg : IsProEtale p g) (hf : IsProEtale p f) : IsProEtale p (g ≫ f) := sorry

theorem IsProEtale.baseChange {Y X X' : Perfd p} {f : Y ⟶ X}
    (hf : IsProEtale p f) (g : X' ⟶ X) : IsProEtale p (pullback.snd f g) := sorry

theorem IsProEtale.of_comp {Z Y X : Perfd p} (g : Z ⟶ Y) (f : Y ⟶ X)
    (hgf : IsProEtale p (g ≫ f)) (hf : IsProEtale p f) : IsProEtale p g := sorry

/-! ### P6/diagonals-are-pro-etale -/

theorem IsProEtale.diagonal {Y X : Perfd p} (f : Y ⟶ X) :
    IsProEtale p (pullback.diagonal f) := sorry

/-! ### P6/zariski-closed-immersions-are-pro-etale -/

theorem IsAffinoidProEtale.zariskiClosed (R : PairCat.{0} p) {Y : Perfd p}
    (f : Y ⟶ ofPair p R) (hf : IsZariskiClosedImmersion p R f) :
    IsAffinoidProEtale p f := sorry

theorem IsProEtale.of_sourceOpenCover {Y X : Perfd p} (f : Y ⟶ X)
    {J : Type*} (V : J → Perfd p) (v : ∀ j, V j ⟶ Y)
    (hv : ∀ j, IsOpenImmersion p (v j))
    (hcover : ∀ y, ∃ j, y ∈ Set.range (pointMap p (v j)))
    (hf : ∀ j, IsProEtale p (v j ≫ f)) : IsProEtale p f := sorry

theorem IsProEtale.of_openCover {Y X : Perfd p} (f : Y ⟶ X)
    {J : Type*} (U : J → Perfd p) (u : ∀ j, U j ⟶ X)
    (hu : ∀ j, IsOpenImmersion p (u j))
    (hcover : ∀ x, ∃ j, x ∈ Set.range (pointMap p (u j)))
