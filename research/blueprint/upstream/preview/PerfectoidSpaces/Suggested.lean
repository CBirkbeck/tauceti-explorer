/-- The tensor representative of the left adjoint, with inverse given by evaluation,
GR (2.2.20) and Proposition 2.2.21. -/
def shriekIsoTensor : shriek S ≅ elements S ⋙ tensorLeft (ModuleCat.of V S.tilde) := by
  let e : elements S ⋙ tensorLeft (ModuleCat.of V S.tilde) ⟶ shriek S :=
    Functor.whiskerLeft (shriek S) (ihom.ev (ModuleCat.of V S.tilde))
  letI : IsIso e := by sorry
  exact (asIso e).symm

/-- In the firm model, the inverse tensor comparison evaluates an almost element. -/
theorem shriekIsoTensor_inv_apply (M : Module S) (t : S.tilde)
    (f : ModuleCat.of V S.tilde ⟶ (shriek S).obj M) :
    (shriekIsoTensor S).inv.app M (t ⊗ₜ[V] f) = f t := by
  change (ihom.ev (ModuleCat.of V S.tilde)).app ((shriek S).obj M) (t ⊗ₜ[V] f) = f t
  rw [← MonoidalClosed.uncurry_id_eq_ev]
  rfl

