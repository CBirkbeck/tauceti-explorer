/-- Naturality of the sharp comparison on small integral quotients, Berkeley 6.2.5. -/
theorem tilt.mapQuot_comm (R S : PairCat.{0} p) (f : R ⟶ S)
    (t : (Pair.tilt p R.pair).plus) (ht : IsPseudoUniformizer (tilt.sharp t.val))
    (hs : tilt.sharp t.val ∈ R.pair.plus)
    (hp : (⟨tilt.sharp t.val, hs⟩ : R.pair.plus) ∣ (p : R.pair.plus)) :
    let fplus := f.toRingHom.restrict R.pair.plus S.pair.plus f.map_mem_plus
    let ftilt := (Pair.tiltHom p f).toRingHom.restrict _ _ (Pair.tiltHom p f).map_mem_plus
    ∃ (ht' : IsPseudoUniformizer (tilt.sharp (ftilt t).val))
      (hs' : tilt.sharp (ftilt t).val ∈ S.pair.plus)
      (hp' : (⟨tilt.sharp (ftilt t).val, hs'⟩ : S.pair.plus) ∣ (p : S.pair.plus)),
      ∀ x : (Pair.tilt p R.pair).plus,
        tilt.sharpQuotEquiv p S.pair (ftilt t) ht' hs' hp' (Ideal.Quotient.mk _ (ftilt x)) =
          (Ideal.quotientMap _ fplus (by sorry))
            (tilt.sharpQuotEquiv p R.pair t ht hs hp (Ideal.Quotient.mk _ x)) := sorry

