section isKappaSmall_empty
example {R : Type u} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [IsHuberRing R]
    [Subsingleton R] (P : Pair R) (κ : Cardinal.{u}) :
    #(spa P.plus) = 0 ∧ #R = 1 ∧ (IsKappaSmall_affinoid κ P ↔ 1 < κ) := by
  exact ⟨Cardinal.mk_eq_zero _, Cardinal.mk_eq_one _,
    isKappaSmall_affinoid_subsingleton_iff P κ⟩
end isKappaSmall_empty

