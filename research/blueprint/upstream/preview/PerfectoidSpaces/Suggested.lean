/-! ### P0/almost-exactness-passes-to-completion -/

/-- Reduction is scalar extension followed by restriction; GR Lemma 2.4.2(i). -/
def modPowerComplex (ϖ : V) (n : ℕ) (C : CochainComplex (ModuleCat.{u} V) ℕ) :
    CochainComplex (ModuleCat.{u} V) ℕ :=
  (((ModuleCat.extendScalars (Ideal.Quotient.mk (_root_.Ideal.span {ϖ ^ n}))) ⋙
    ModuleCat.restrictScalars (Ideal.Quotient.mk (_root_.Ideal.span {ϖ ^ n}))).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj C

/-- Completeness and regularity lift almost exactness from the first reduction.
ECD proof of Proposition 8.8; GR Lemma 2.4.2(i). -/
theorem almostExact_of_complete_mod (ϖ : V) (hϖ : ϖ ∈ S.ideal)
    (C : CochainComplex (ModuleCat.{u} V) ℕ)
    (hreg : ∀ i, Function.Injective (fun x : C.X i ↦ ϖ • x))
    (hcomplete : ∀ i, IsAdicComplete (_root_.Ideal.span {ϖ}) (C.X i))
    (hmod : ∀ i, S.IsAlmostZero ((modPowerComplex ϖ 1 C).homology i)) :
    (∀ n i, 0 < n → S.IsAlmostZero ((modPowerComplex ϖ n C).homology i)) ∧
      (∀ i, S.IsAlmostZero (C.homology i)) ∧
      ∀ i, (((ModuleCat.extendScalars (algebraMap V (Localization.Away ϖ))).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj C).ExactAt i := sorry

