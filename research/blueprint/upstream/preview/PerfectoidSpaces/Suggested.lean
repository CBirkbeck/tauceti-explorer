    (h : a.hom ≫ f = b.hom ≫ g) :
    ∃! w : T ⟶ pullbackOverAnalytic p hZ f g,
      w ≫ pullbackOverAnalytic.fst p hZ f g = a ∧
      w ≫ pullbackOverAnalytic.snd p hZ f g = b := sorry

