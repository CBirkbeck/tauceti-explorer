/-! ### Layer 6: Small subdiagram approximation and constructible images -/

/-- ECD 8.2, p. 39: approximation by embedded cofiltered subdiagrams. The embeddings are faithful
and injective on objects. -/
theorem bounded_subdiagram_approximation {Y X : Perfd p} {f : Y ⟶ X}
    (P : ProEtalePresentation p f) {κ : Cardinal.{1}}
    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (hX : IsKappaSmall p κ X) :
    ∃ (J : Type) (_ : PartialOrder J) (_ : Nonempty J) (_ : IsDirectedOrder J)
      (D : Jᵒᵖ ⥤ AffinoidProEtale p X) (c : Cone (D ⋙ ObjectProperty.ι _)),
      c.pt = Over.mk f ∧ Nonempty (IsLimit c) ∧
      ∀ j, IsKappaSmall p κ (D.obj j).obj.left ∧
        ∃ (Q : ProEtalePresentation p (D.obj j).obj.hom) (F : Q.I ⥤ P.I),
          F.Faithful ∧ Function.Injective F.obj ∧
          Cardinal.lift.{1} #(Σ i k : Q.I, i ⟶ k) < κ ∧
          Nonempty (Q.diagram ≅ F ⋙ P.diagram) := sorry

/-- The image is an intersection of compact open subsets, hence pro-constructible and
stable under generalization; this states the topology without another predicate. -/
theorem IsAffinoidProEtale.isProConstructible_range {Y X : Perfd p} {f : Y ⟶ X}
    (hf : IsAffinoidProEtale p f) :
    (∃ (I : Type) (U : I → Set (underlyingPoints p X)),
      (∀ i, IsOpen (U i) ∧ IsCompact (U i)) ∧ Set.range (pointMap p f) = ⋂ i, U i) ∧
    ∀ x ∈ Set.range (pointMap p f), ∀ z, Specializes z x → z ∈ Set.range (pointMap p f) := sorry

/-- In the monoid-indexed identity cover, a small nonempty subdiagram cannot be full
when the original endomorphism set reaches the cutoff (ECD 8.2, p. 39). -/
theorem bounded_subdiagram_approximation_not_full
    (X : Perfd p) (hX : IsAffinoidPerfectoid p X.obj)
    (M : Type) [MonoidWithZero M] {κ : Cardinal.{1}}
    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (hsmall : IsKappaSmall p κ X)
    (hM : κ ≤ Cardinal.lift.{1} #M) :
    ∃ (Y : Perfd p) (f : Y ⟶ X) (Q : ProEtalePresentation p f)
      (F : Q.I ⥤ (zeroMonoidPresentation p X hX M).I),
      F.Faithful ∧ Function.Injective F.obj ∧
      Cardinal.lift.{1} #(Σ i j : Q.I, i ⟶ j) < κ ∧ ¬ F.Full ∧
      Nonempty (Q.diagram ≅ F ⋙ (zeroMonoidPresentation p X hX M).diagram) := by
  obtain ⟨J, _, hJ, _, D, _, _, _, hstages⟩ :=
    bounded_subdiagram_approximation p (zeroMonoidPresentation p X hX M) hκ hκ₀ hsmall
  let j : Jᵒᵖ := Opposite.op (Classical.choice hJ)
  obtain ⟨Q, F, hfaithful, hinjective, hcard, hiso⟩ := (hstages j).2
  refine ⟨(D.obj j).obj.left, (D.obj j).obj.hom, Q, F,
    hfaithful, hinjective, hcard, ?_, hiso⟩
  sorry

