/-- Shift the original compatible sequence to obtain the roots in its tilt. -/
def PseudoUniformizerRoots.tilt (ϖ : PseudoUniformizerRoots p R) :
    PseudoUniformizerRoots p (Perfectoid.tilt p R) := sorry

theorem PseudoUniformizerRoots.tilt_coeff (ϖ : PseudoUniformizerRoots p R) (n m : ℕ) :
    Perfectoid.tilt.coeff m ((ϖ.tilt p).root n) = ϖ.root (n + m) := sorry

-- Check: tilted_roots_first_two
example (ϖ : PseudoUniformizerRoots p R) :
