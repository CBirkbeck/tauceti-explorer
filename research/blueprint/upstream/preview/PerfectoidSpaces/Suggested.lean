section WittPlus
variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R]
  [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CharP R p]
  (P : Pair R) (t : P.plus) (ht : IsPseudoUniformizer (t : R))

/-! ### P1/witt-vectors-of-perfect-plus-ring -/
/-- BMS Lemma 3.2 and AWS 2.2.7–2.2.10, with both adic parameters retained. -/
theorem witt_plus_ring :
    IsAdicComplete (Ideal.span {t}) P.plus ∧
    t ∈ nonZeroDivisors P.plus ∧
    WittVector.teichmuller p t ∈ nonZeroDivisors (WittVector p P.plus) ∧
    IsAdicComplete (Ideal.span {WittVector.teichmuller p t}) (WittVector p P.plus) ∧
    Nonempty ((WittVector p P.plus ⧸ Ideal.span {(p : WittVector p P.plus)}) ≃+* P.plus) ∧
    Nonempty ((WittVector p P.plus ⧸ Ideal.span {(p : WittVector p P.plus),
      WittVector.teichmuller p t}) ≃+* (P.plus ⧸ Ideal.span {t})) := sorry

/-- The unique Teichmüller expansion is characterized by all its finite congruences. -/
theorem witt_teichmuller_expansion (w : WittVector p P.plus) :
    ∃! x : ℕ → P.plus, ∀ N : ℕ,
      w - ∑ n ∈ Finset.range N, (p : WittVector p P.plus) ^ n * WittVector.teichmuller p (x n)
        ∈ Ideal.span {(p : WittVector p P.plus) ^ N} := sorry

/-- A Witt vector over the perfect plus ring is a unit precisely at its zeroth coordinate. -/
theorem witt_unit_iff (w : WittVector p P.plus) : IsUnit w ↔ IsUnit (w.coeff 0) := sorry

/-- The universal lift uses the specified reduction map, including rings with p-torsion. -/
theorem witt_unique_lift (A : Type*) [CommRing A]
    [IsAdicComplete (Ideal.span {(p : A)}) A]
    (f : P.plus →+* (A ⧸ Ideal.span {(p : A)})) :
    ∃! g : WittVector p P.plus →+* A,
      ∀ w, Ideal.Quotient.mk (Ideal.span {(p : A)}) (g w) = f (w.coeff 0) := sorry

/-- Changing the small unit changes neither the two-generator adic topology nor Frobenius. -/
theorem witt_topology_independent (u : P.plus) (hu : IsPseudoUniformizer (u : R)) :
    Ideal.adicTopology (Ideal.span {(p : WittVector p P.plus), WittVector.teichmuller p t}) =
      Ideal.adicTopology (Ideal.span {(p : WittVector p P.plus), WittVector.teichmuller p u}) ∧
    Function.Bijective (WittVector.map (p := p) (frobenius P.plus p)) := sorry
end WittPlus

section Untilt

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]

/-! ### P1/untilt-construction -/

/-- The multiplicative set of `W(R⁺)` generated by the Teichmüller
lifts `[ϖ]` of all pseudo-uniformizers `ϖ ∈ R⁺`; inverting it is inverting one `[ϖ]`, since any
two pseudo-uniformizers divide powers of each other in `R⁺`. -/
def teichmullerPseudoUniformizers (P : Pair R) : Submonoid (WittVector p P.plus) :=
  Submonoid.closure
    {w | ∃ ϖ : P.plus, IsPseudoUniformizer (ϖ : R) ∧ w = WittVector.teichmuller p ϖ}

/-- `W^b(R) = W(R⁺)[1/[ϖ]]`, independent of `ϖ` (and of `R⁺`
up to the evident inclusions). -/
abbrev boundedWitt (P : Pair R) : Type _ := Localization (teichmullerPseudoUniformizers p P)

/-- The untilt `A = W(R⁺)[1/[ϖ]] ⧸ J` of a perfectoid pair
`(R, R⁺)` of characteristic `p` along a primitive ideal `J ⊆ W(R⁺)`: the localisation of
`A⁺ = W(R⁺) ⧸ J` at the images of all `[ϖ]`, so that no choice of `ϖ` enters (ECD proof of
Theorem 3.17; KL II Lemma 3.3.7; AWS Definition 2.3.14). -/
def untilt (P : Pair R) (J : Ideal (WittVector p P.plus)) : Type _ :=
  Localization ((teichmullerPseudoUniformizers p P).map (Ideal.Quotient.mk J))

namespace untilt

variable (P : Pair R) (J : Ideal (WittVector p P.plus))

/-- The ring structure of the untilt (a localisation). -/
instance instCommRing : CommRing (untilt p P J) := inferInstanceAs (CommRing (Localization _))

/-- The untilt is a `W(R⁺) ⧸ J`-algebra. -/
instance instAlgebra : Algebra (WittVector p P.plus ⧸ J) (untilt p P J) :=
  inferInstanceAs (Algebra _ (Localization _))

/-- The untilt is the localisation of `W(R⁺) ⧸ J` at the
Teichmüller lifts of the pseudo-uniformizers. -/
instance instIsLocalization :
    IsLocalization ((teichmullerPseudoUniformizers p P).map (Ideal.Quotient.mk J))
      (untilt p P J) :=
  inferInstanceAs (IsLocalization ((teichmullerPseudoUniformizers p P).map (Ideal.Quotient.mk J))
    (Localization ((teichmullerPseudoUniformizers p P).map (Ideal.Quotient.mk J))))

/-- The topology of the untilt, in which `A⁺` is open with its
`π`-adic (equivalently `(p, [ϖ])`-adic) topology, `π` the image of `[ϖ]`. -/
instance instUniformSpace [IsPerfectoidTateRing p R] [CharP R p] [Fact (IsPrimitiveIdeal J)] :
    UniformSpace (untilt p P J) := sorry

variable [IsPerfectoidTateRing p R] [CharP R p] [Fact (IsPrimitiveIdeal J)]

/-- The uniformity is that of the additive group. -/
instance instIsUniformAddGroup : IsUniformAddGroup (untilt p P J) := sorry

/-- The untilt is a topological ring. -/
instance instIsTopologicalRing : IsTopologicalRing (untilt p P J) := sorry

/-- The untilt is a Tate ring with pair of definition
`(A⁺, π A⁺)` and pseudo-uniformizer `π`, independent of `ϖ`. -/
instance instIsTateRing : IsTateRing (untilt p P J) := sorry

/-- The untilt is complete. -/
instance instCompleteSpace : CompleteSpace (untilt p P J) := sorry

/-- The untilt is Hausdorff. -/
instance instT2Space : T2Space (untilt p P J) := sorry

/-! ### P1/untilt-is-perfectoid-pair -/

/-- The untilt is a perfectoid Tate ring
(KL II Theorem 3.3.8, AWS Lemmas 2.6.14 and 2.7.9). -/
instance isPerfectoidTateRing : IsPerfectoidTateRing p (untilt p P J) := sorry

end untilt

/-- The plus ring `A⁺ ⊆ A`, the image of `W(R⁺) ⧸ J`. -/
def untiltPlus (P : Pair R) (J : Ideal (WittVector p P.plus)) : Subring (untilt p P J) :=
  (algebraMap (WittVector p P.plus ⧸ J) (untilt p P J)).range

namespace untilt

variable (P : Pair R) (J : Ideal (WittVector p P.plus))

variable [IsPerfectoidTateRing p R] [CharP R p]

/-- `♯_J : R →* A`, `x ↦ θ_J([x])` (extended from `R⁺` by
`♯_J(ϖ⁻¹ x) = ♯_J(ϖ)⁻¹ ♯_J(x)`); continuous and multiplicative, with `♯_J(ϖ)` a
pseudo-uniformizer. -/
def sharp [Fact (IsPrimitiveIdeal J)] : R →* untilt p P J := sorry

/-- On the plus ring, sharp is Teichmüller lifting followed by the quotient and localization
maps (ECD Theorem 3.17, p. 18). -/
theorem sharp_apply [Fact (IsPrimitiveIdeal J)] (x : P.plus) :
    sharp p P J (x : R) = algebraMap (WittVector p P.plus ⧸ J) (untilt p P J)
      (Ideal.Quotient.mk J (WittVector.teichmuller p x)) := sorry

/-- Every integral pseudo-uniformizer gives the quotient-adic neighborhood basis of the
untilt (ECD Theorem 3.17, p. 18). -/
theorem nhds_zero_hasBasis [Fact (IsPrimitiveIdeal J)] (t : P.plus)
    (ht : IsPseudoUniformizer (t : R)) :
    (𝓝 (0 : untilt p P J)).HasBasis (fun n : ℕ ↦ 0 ≤ n)
      (fun n ↦ {x | ∃ y : untiltPlus p P J,
        x = (algebraMap (WittVector p P.plus ⧸ J) (untilt p P J)
          (Ideal.Quotient.mk J (WittVector.teichmuller p t))) ^ n * y.val}) := sorry

/-- A morphism `f` of characteristic-`p` perfectoid pairs with `W(f)(J) ⊆ J'`
induces a ring homomorphism between the localised quotients. This algebraic map is defined
for arbitrary ideals; topological untilts require primitive ideals. -/
def map {R' : Type*} [CommRing R'] [UniformSpace R'] [IsUniformAddGroup R'] [IsTopologicalRing R']
    [IsTateRing R'] [CompleteSpace R'] [T2Space R'] [IsPerfectoidTateRing p R'] [CharP R' p]
    {P' : Pair R'} (f : Pair.Hom P P') (J' : Ideal (WittVector p P'.plus))
    (hJ : J.map (WittVector.map (f.toRingHom.restrict _ _ f.map_mem_plus)) ≤ J') :
    untilt p P J →+* untilt p P' J' := sorry

/-- The induced map on localized quotients acts on every Witt vector by `W(f)`;
primitivity is unnecessary for this algebraic identity (ECD Theorem 3.17, p. 18). -/
theorem map_algebraMap {R' : Type*} [CommRing R'] [UniformSpace R']
    [IsUniformAddGroup R'] [IsTopologicalRing R'] [IsTateRing R']
    [CompleteSpace R'] [T2Space R'] [IsPerfectoidTateRing p R'] [CharP R' p]
    {P' : Pair R'} (f : Pair.Hom P P') (J' : Ideal (WittVector p P'.plus))
    (hJ : J.map (WittVector.map (f.toRingHom.restrict _ _ f.map_mem_plus)) ≤ J')
    (w : WittVector p P.plus) :
    map p P J f J' hJ
        (algebraMap (WittVector p P.plus ⧸ J) (untilt p P J) (Ideal.Quotient.mk J w)) =
      algebraMap (WittVector p P'.plus ⧸ J') (untilt p P' J')
        (Ideal.Quotient.mk J'
          (WittVector.map (f.toRingHom.restrict _ _ f.map_mem_plus) w)) := sorry

/-! ### P1/untilt-tilt-identification -/

/-- The tilt of the untilt is `R`, identifying the plus
rings. -/
def tiltEquiv [Fact (IsPrimitiveIdeal J)] : tilt p (untilt p P J) ≃+* R := sorry

/-- The canonical tilt identification intertwines sharp with Teichmüller reduction
(ECD Theorem 3.17, p. 18). -/
theorem sharp_tiltEquiv [Fact (IsPrimitiveIdeal J)] (x : tilt p (untilt p P J)) :
    sharp p P J (tiltEquiv p P J x) = tilt.sharp x := sorry

/-- ECD 3.17: changing the Teichmüller parameter gives the canonical algebra isomorphism. -/
theorem congr_pseudoUniformizer (t u : P.plus)
    (ht : IsPseudoUniformizer (t : R)) (hu : IsPseudoUniformizer (u : R)) :
    Nonempty (Localization.Away (Ideal.Quotient.mk J (WittVector.teichmuller p t)) ≃ₐ[
      WittVector p P.plus ⧸ J]
      Localization.Away (Ideal.Quotient.mk J (WittVector.teichmuller p u))) := sorry

/-- `(p)` is a primitive ideal. -/
instance fact_isPrimitiveIdeal_span_p :
    Fact (IsPrimitiveIdeal (Ideal.span {(p : WittVector p P.plus)})) := ⟨⟨_, isPrimitive_p, rfl⟩⟩

end untilt

end Untilt

section UntiltTests

variable (p : ℕ) [Fact p.Prime]

-- Check: untilt_p_recovery
example {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CharP R p]
    (P : Pair R) :
    ∃ e : untilt p P (Ideal.span {(p : WittVector p P.plus)}) ≃+* R,
      Continuous e ∧ Continuous e.symm ∧
      (untiltPlus p P (Ideal.span {(p : WittVector p P.plus)})).map e.toRingHom = P.plus :=
  sorry

-- Check: untilt_p_minus_t
example {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CharP R p]
    (P : Pair R) (t : P.plus) (ht : IsPseudoUniformizer (t : R))
    [Fact (IsPrimitiveIdeal (Ideal.span
      {(p : WittVector p P.plus) - WittVector.teichmuller p t}))] :
    untilt.sharp p P (Ideal.span {(p : WittVector p P.plus) - WittVector.teichmuller p t})
      (t : R) = p := sorry

-- Check: untilt_cyclotomic_recovery
example (ε : (Pair.powerBounded (tilt p (padicCyclotomic p))).plus)
    (hε : ∀ n, IsPrimitiveRoot (tilt.coeff n (ε : tilt p (padicCyclotomic p))) (p ^ (n + 1)))
    [Fact (IsPrimitiveIdeal (Ideal.span
      {∑ i ∈ Finset.range p, WittVector.teichmuller p ε ^ i}))] :
    let P := Pair.powerBounded (tilt p (padicCyclotomic p))
    let J := Ideal.span {∑ i ∈ Finset.range p, WittVector.teichmuller p ε ^ i}
    ∃ (e : untilt p P J ≃+* padicCyclotomic p) (he : Continuous e), Continuous e.symm ∧
      (∀ x, untilt.tiltEquiv p P J x = tilt.map p e.toRingHom he x) ∧
      (untiltPlus p P J).map e.toRingHom = powerBoundedSubring (padicCyclotomic p) := sorry

-- test untilt_not_primitive (non-example)
/- `W(R⁺)[1/[ϖ]]/(p²)` is not reduced: `p² = 0` there while `p ≠ 0`, because
`W(R⁺)[1/[ϖ]]/(p) = R⁺[1/ϖ] = R ≠ 0`. The ring structure of `untilt` needs no primitivity. -/
-- Check: untilt_p_squared_nonreduced
example {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] [CharP R p]
    [Nontrivial R] (P : Pair R) :
    (p : untilt p P (Ideal.span {(p : WittVector p P.plus) ^ 2})) ≠ 0 ∧
      (p : untilt p P (Ideal.span {(p : WittVector p P.plus) ^ 2})) ^ 2 = 0 := sorry

-- test untilt_not_primitive (degenerate)
/- For the zero ring every quotient is the zero ring; `R ≠ 0` is needed for `p ≠ 0` above. -/
-- Check: untilt_zero_base
example {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
    [Subsingleton R] (P : Pair R) :
    Subsingleton (untilt p P (Ideal.span {(p : WittVector p P.plus) ^ 2})) := sorry

-- test untilt_quotEquiv_test (characterisation)
/- For `J = (p − [p♭]) ⊆ W(𝒪_{ℂ_p♭})` and `ϖ = p♭`: `♯_J(p♭) = θ_J([p♭]) = p`,
`untiltPlus = 𝒪_{ℂ_p}`, and `𝒪_{ℂ_p}/(p) ≃+* 𝒪_{ℂ_p♭}/(p♭)`, stated on the carrier of the
untilt. -/
-- Check: untilt_small_quotient
example (pflat : (Pair.powerBounded (tilt p ℂ_[p])).plus)
    (hp : tilt.sharp (pflat : tilt p ℂ_[p]) = p)
    (hϖ : IsPseudoUniformizer (pflat : tilt p ℂ_[p]))
    [Fact (IsPrimitiveIdeal (Ideal.span
      {(p : WittVector p (Pair.powerBounded (tilt p ℂ_[p])).plus) -
        WittVector.teichmuller p pflat}))] :
    let J := Ideal.span {(p : WittVector p (Pair.powerBounded (tilt p ℂ_[p])).plus) -
      WittVector.teichmuller p pflat}
    untilt.sharp p (Pair.powerBounded (tilt p ℂ_[p])) J (pflat : tilt p ℂ_[p]) = p ∧
      ∃ π : untiltPlus p (Pair.powerBounded (tilt p ℂ_[p])) J,
        (π : untilt p (Pair.powerBounded (tilt p ℂ_[p])) J) = p ∧
        Nonempty (untiltPlus p (Pair.powerBounded (tilt p ℂ_[p])) J ⧸ Ideal.span {π} ≃+*
          (Pair.powerBounded (tilt p ℂ_[p])).plus ⧸ Ideal.span {pflat}) := sorry

/-- Reduction modulo `p²` in `O_C` is not of characteristic `p`; the quotient comparison
with the characteristic-`p` tilt requires a suitably small pseudo-uniformizer. -/
-- Check: untilt_large_quotient_negative
example : ¬ CharP (powerBoundedSubring ℂ_[p] ⧸
    Ideal.span {((p : powerBoundedSubring ℂ_[p]) ^ 2)}) p := sorry

end UntiltTests

section UntiltPair

variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R]
  [CharP R p] (P : Pair R) (J : Ideal (WittVector p P.plus)) [Fact (IsPrimitiveIdeal J)]

/-- The perfectoid Huber pair `(A, A⁺)` of the untilt: `A⁺ =
W(R⁺) ⧸ J` is a ring of integral elements (open, integrally closed, in `A°`) (KL II Theorem
3.3.8, AWS Lemmas 2.6.14 and 2.7.9). -/
def untilt.pair : Pair (untilt p P J) where
  plus := untiltPlus p P J
  isRingOfIntegralElements := sorry

end UntiltPair



section BoundaryChecks

variable (p : ℕ) [Fact p.Prime]

-- Check: frobenius_two_terms
example :
    frobeniusModPow 2 (0 : ZMod 2) (by decide)
        (Ideal.Quotient.mk _ 1 + Ideal.Quotient.mk _ 1) = 0 ∧
      frobeniusModPow 2 (0 : ZMod 2) (by decide) 1 = 1 ∧
      frobeniusQuot 2 (⊥ : Ideal (ZMod 2)) ⊥
        (by simpa using (CharP.cast_eq_zero (ZMod 2) 2)) (by simp)
        (Ideal.Quotient.mk _ 1 + Ideal.Quotient.mk _ 1) = 0 ∧
      frobeniusQuot 2 (⊥ : Ideal (ZMod 2)) ⊥
        (by simpa using (CharP.cast_eq_zero (ZMod 2) 2)) (by simp) 1 = 1 := sorry

-- Check: frobenius_unit_ideal
example (A : Type*) [CommRing A] (x : A) :
    frobeniusQuot p (⊤ : Ideal A) ⊤ (by simp) (by simp)
      (Ideal.Quotient.mk _ x) = 0 ∧
      frobeniusModPow p (1 : A) (by simp) (Ideal.Quotient.mk _ x) = 0 := sorry

-- Check: frobenius_polynomial
example :
    ¬ Function.Surjective (frobeniusModPow 2 (0 : Polynomial (ZMod 2))
      (by simpa using (CharP.cast_eq_zero (Polynomial (ZMod 2)) 2))) ∧
      ¬ Function.Surjective (frobeniusQuot 2 (⊥ : Ideal (Polynomial (ZMod 2))) ⊥
        (by simpa using (CharP.cast_eq_zero (Polynomial (ZMod 2)) 2)) (by simp)) := sorry

-- Check: cyclotomic_root_membership
example (ζ : ℂ_[p]) (n : ℕ) (hζ : ζ ^ p ^ n = 1) :
    ζ ∈ padicCyclotomic p ∧ ‖ζ‖ = 1 := sorry

-- Check: cyclotomic_p_norm
example : ‖(p : padicCyclotomic p)‖ = (p : ℝ)⁻¹ ∧ (p : padicCyclotomic p) ≠ 0 := sorry

-- Check: cyclotomic_nondiscrete
example (ε : ℝ) (hε : 1 < ε) :
    ∃ x : padicCyclotomic p, 1 < ‖x‖ ∧ ‖x‖ < ε := sorry

-- Check: roots_first_two
example (ϖ : PseudoUniformizerRoots p ℂ_[p]) :
    ϖ.root 1 ^ p = ϖ.root 0 ∧ ϖ.root 2 ^ p = ϖ.root 1 ∧
      (ϖ.rootPB 1 : ℂ_[p]) ^ p = (ϖ.rootPB 0 : ℂ_[p]) ∧
      ϖ.rootPB 0 ≠ 0 := sorry

-- Check: roots_exponent_convention
example (ϖ : PseudoUniformizerRoots p ℂ_[p]) :
    ϖ.zpow 0 1 = 1 ∧ ϖ.zpow (p : ℤ) 1 = ϖ.zpow 1 0 ∧
      ϖ.zpow 1 0 * ϖ.zpow (-1) 0 = 1 ∧
      ((ϖ.zpow 2 0 : ℂ_[p]ˣ) : ℂ_[p]) = ϖ.root 0 ^ 2 := sorry

-- Check: roots_nonintegral_inverse
example (ϖ : PseudoUniformizerRoots p ℂ_[p]) :
    ((ϖ.zpow 1 0 : ℂ_[p]ˣ) : ℂ_[p]) = (ϖ.rootPB 0 : ℂ_[p]) ∧
      ((ϖ.zpow (-1) 0 : ℂ_[p]ˣ) : ℂ_[p]) ∉ powerBoundedSubring ℂ_[p] := sorry

-- Check: roots_zero_gauge
example (R : Type*) [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
    [IsTateRing R] [Subsingleton R] (ϖ : PseudoUniformizerRoots p R) :
    ϖ.rootPB 0 = 0 ∧ ϖ.root 1 = 0 ∧ ϖ.zpow (-1) 0 = 1 ∧
      ϖ.gauge 1 = 0 ∧ ϖ.gauge (0 ^ 0) ≠ (ϖ.gauge 0) ^ 0 := sorry

-- Check: tilt_zero_characteristic
example (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] [Subsingleton R] (P : Pair R)
    (ϖ : PseudoUniformizerRoots p R) :
    Subsingleton (tilt p R) ∧ CharP (tilt p R) 1 ∧ ¬ CharP (tilt p R) p ∧
      tilt.coeff 0 ϖ.toTilt = 0 ∧ tilt.sharp ϖ.toTilt = 0 ∧
      (Pair.tilt p P).plus = ⊤ := sorry

-- Check: tilt_roots_and_plus
example (ϖ : PseudoUniformizerRoots p ℂ_[p]) :
    tilt.coeff 0 ϖ.toTilt = ϖ.root 0 ∧ tilt.coeff 1 ϖ.toTilt = ϖ.root 1 ∧
      tilt.sharp ϖ.toTilt = (ϖ.rootPB 0 : ℂ_[p]) ∧
      ϖ.toTilt ∈ (Pair.tilt p (Pair.powerBounded ℂ_[p])).plus ∧
      ϖ.toTilt ≠ 0 := sorry

-- Check: sharp_epsilon
example (ε : tilt p (padicCyclotomic p)) (hε : ∀ n, IsPrimitiveRoot (tilt.coeff n ε) (p ^ n))
    (r : tilt p ℂ_[p]) (hr : tilt.coeff 0 r = p) :
    tilt.sharp ε = 1 ∧ tilt.sharp r = p := sorry

-- Check: sharp_eq_zero_iff_test
example (x : tilt p (ℂ_[p] × tilt p ℂ_[p])) : tilt.sharp x = 0 ↔ x = 0 := sorry

-- Check: sharp_cyclotomic_two_terms
example (ε : tilt p (padicCyclotomic p))
    (hε : ∀ n, IsPrimitiveRoot (tilt.coeff n ε) (p ^ n)) :
    tilt.sharp ε = 1 ∧ tilt.sharp (ε * ε) = 1 ∧
      tilt.sharp (ε - 1) ≠ tilt.sharp ε - tilt.sharp (1 : tilt p (padicCyclotomic p)) := sorry

-- Check: tilt_charP_two_terms
example (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] [CharP R p] (ϖ : PseudoUniformizerRoots p R) :
    tilt.equivOfCharP (ϖ.toTilt + 1) = ϖ.root 0 + 1 ∧
      tilt.equivOfCharP (ϖ.toTilt ^ 2) = ϖ.root 0 ^ 2 ∧
      tilt.sharp (ϖ.toTilt + 1) = tilt.sharp ϖ.toTilt + 1 := sorry

-- Check: tilt_charP_plus
example (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] [CharP R p] (P : Pair R) :
    (Pair.tilt p P).plus.map (tilt.equivOfCharP : tilt p R ≃+* R).toRingHom = P.plus ∧
      (tilt.equivOfCharP : tilt p R ≃+* R) 0 = 0 := sorry

-- Check: tilt_map_identity_roots
example (ϖ : PseudoUniformizerRoots p ℂ_[p]) :
    tilt.map p (RingHom.id ℂ_[p]) continuous_id (ϖ.toTilt + 1) = ϖ.toTilt + 1 ∧
      (ϖ.map p (RingHom.id ℂ_[p]) continuous_id).root 1 = ϖ.root 1 ∧
      (Pair.tiltHom p (Pair.Hom.id (Pair.powerBounded ℂ_[p]))).toRingHom
        (ϖ.toTilt + 1) = ϖ.toTilt + 1 := sorry

-- Check: tilt_map_projection
example (ϖ : PseudoUniformizerRoots p (ℂ_[p] × ℂ_[p])) :
    tilt.coeff 1 (tilt.map p (RingHom.fst ℂ_[p] ℂ_[p]) continuous_fst ϖ.toTilt) =
        (ϖ.root 1).1 ∧
      (ϖ.map p (RingHom.snd ℂ_[p] ℂ_[p]) continuous_snd).root 0 = (ϖ.root 0).2 := sorry

-- Check: tilt_map_swap
example (ϖ : PseudoUniformizerRoots p (ℂ_[p] × ℂ_[p])) :
    let f := (RingEquiv.prodComm : (ℂ_[p] × ℂ_[p]) ≃+* (ℂ_[p] × ℂ_[p])).toRingHom
    tilt.coeff 0 (tilt.map p f (continuous_snd.prodMk continuous_fst) ϖ.toTilt) =
        ((ϖ.root 0).2, (ϖ.root 0).1) ∧
      (ϖ.map p f (continuous_snd.prodMk continuous_fst)).root 1 =
        ((ϖ.root 1).2, (ϖ.root 1).1) := sorry

-- Check: almost_residue
example (K : Type*) [NontriviallyNormedField K] [IsUltrametricDist K]
    [CompleteSpace K] [IsPerfectoidField p K] :
    (almostSetup p K).IsAlmostZero
      (powerBoundedSubring K ⧸ topologicallyNilpotentIdeal K) ∧
    ∀ (ϖ : PseudoUniformizerRoots p K) (n : ℕ)
