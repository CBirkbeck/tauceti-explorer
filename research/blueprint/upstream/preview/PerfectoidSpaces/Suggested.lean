example (M : Module S) (t u : S.tilde) (f g : ModuleCat.of V S.tilde ⟶ (shriek S).obj M) :
    (shriekIsoTensor S).inv.app M (t ⊗ₜ[V] f + u ⊗ₜ[V] g) = f t + g u := by
  erw [map_add, shriekIsoTensor_inv_apply, shriekIsoTensor_inv_apply]
  rfl

-- Check: shriekIsoTensor_not_negated
