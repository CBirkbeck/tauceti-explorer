section not_isKappaSmall_zero_one
example {R : Type u} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [IsHuberRing R]
    (P : Pair R) : ¬ IsKappaSmall_affinoid 0 P ∧ ¬ IsKappaSmall_affinoid 1 P :=
  ⟨not_isKappaSmall_affinoid_of_le_one P (by simp),
    not_isKappaSmall_affinoid_of_le_one P le_rfl⟩
