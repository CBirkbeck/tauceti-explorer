namespace Algebra

/-! ### P0/almost-algebra-lower-shriek-shriek -/

/-- The nonunital algebra underlying lower shriek, with Mathlib tensor multiplication. -/
abbrev shriekRing (B : Algebra S) := S.tilde ⊗[V] ((elements S).obj B)

instance shriekRing.nonUnitalCommRing (B : Algebra S) : NonUnitalCommRing (shriekRing S B) :=
  { (inferInstance : NonUnitalRing (shriekRing S B)) with mul_comm := by sorry }

/-- The relation has positive scalar component and negative tensor component. -/
def shriekRelation (B : Algebra S) (x y : S.ideal) : Unitization V (shriekRing S B) :=
  Unitization.inl ((x : V) * y) - Unitization.inr ((x ⊗ₜ[V] y) ⊗ₜ[V] (1 : (elements S).obj B))

/-- The ideal generated by the unitalization relations, GR (2.2.23). -/
def shriekIdeal (B : Algebra S) : Ideal (Unitization V (shriekRing S B)) :=
  Ideal.span {z | ∃ x y : S.ideal, z = shriekRelation S B x y}

instance (B : Algebra S) : CommRing (Unitization V (shriekRing S B)) := inferInstance

/-- The underlying unital algebra of lower shriek-shriek. -/
abbrev shriekShriekObj (B : Algebra S) := (Unitization V (shriekRing S B)) ⧸ (shriekIdeal S B)

/-- Lower shriek-shriek on algebras, GR Proposition 2.2.27. -/
def shriekShriek : Algebra S ⥤ CommAlgCat.{u} V where
  obj B := CommAlgCat.of V (shriekShriekObj S B)
  map := sorry
  map_id := sorry
  map_comp := sorry

/-- The defining relation, extended linearly to the tensor ideal. -/
def shriekRelationLinear (B : Algebra S) : S.tilde →ₗ[V] Unitization V (shriekRing S B) := sorry

theorem shriekRelationLinear_tmul (B : Algebra S) (x y : S.ideal) :
    shriekRelationLinear S B (x ⊗ₜ[V] y) = shriekRelation S B x y := sorry

/-- Exact algebras have injective relation map; the quotient gives the other exactness clauses. -/
def IsExact (B : Algebra S) : Prop := Function.Injective (shriekRelationLinear S B)

def shriekShriekAdj : shriekShriek S ⊣ toAlmost S := sorry

def shriekShriekUnitIso (B : Algebra S) : B ≅ (toAlmost S).obj ((shriekShriek S).obj B) := sorry

def shriekShriekToElements : shriekShriek S ⟶ elements S := sorry

/-- The comparison sends an honest scalar to its image and a tensor to its product. -/
theorem shriekShriekToElements_apply (B : Algebra S) (v : V)
    (x y : S.ideal) (b : (elements S).obj B) :
    ((shriekShriekToElements S).app B).hom
      (Ideal.Quotient.mk (shriekIdeal S B) (Unitization.inl v + Unitization.inr ((x ⊗ₜ[V] y) ⊗ₜ[V] b))) =
      algebraMap V _ v + ((x : V) * y) • b := sorry

theorem isExact_of_bijective (h : Function.Bijective S.tildeToIdeal) (B : Algebra S) :
    IsExact S B := sorry

instance shriekShriek_preservesColimits : PreservesColimits (shriekShriek S) := sorry

