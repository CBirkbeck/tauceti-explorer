      ((finiteStageFiniteEtaleDiagram p X).mapId ⟨Opposite.op i⟩).hom.toNatTrans.app T := sorry


/-- Finite étale spaces over the limit form the filtered 2-colimit of the finite-stage slices.
ECD Proposition 6.4(i), p. 27. -/
