/-! ### Layer 4: Ordinary and compatible-root annuli -/
namespace PerfectoidSpace
open Perfectoid TauCetiRoadmap.AdicEtaleGeometry TauCetiRoadmap.AdicEtaleGeometry.Huber
variable (p : ℕ) [Fact p.Prime] (K : AffinoidField p) (π : PseudoUniformizerRoots p K)

/-! ### P4/integral-perfectoid-criterion-for-annuli -/

/-- The ordinary annulus is the affinoid quotient TU = π^a, with quotient topology. -/
abbrev ordinaryAnnulus (a : ℕ) :=
  tateSeries 2 K ⧸ Ideal.span ({(tateSeries.X 2 K 0 * tateSeries.X 2 K 1 -
    algebraMap K (tateSeries 2 K) (π.root 0 ^ a))} : Set (tateSeries 2 K))

instance ordinaryAnnulus.uniformSpace (a : ℕ) : UniformSpace (ordinaryAnnulus p K π a) :=
  IsTopologicalAddGroup.rightUniformSpace _
instance ordinaryAnnulus.uniformAddGroup (a : ℕ) : IsUniformAddGroup (ordinaryAnnulus p K π a) := sorry
instance ordinaryAnnulus.tate (a : ℕ) : IsTateRing (ordinaryAnnulus p K π a) := sorry
instance ordinaryAnnulus.complete (a : ℕ) : CompleteSpace (ordinaryAnnulus p K π a) := sorry
instance ordinaryAnnulus.hausdorff (a : ℕ) : T2Space (ordinaryAnnulus p K π a) := sorry

/-- The compatible-root annulus is a rational localization of the root disc. -/
def rootAnnulus (a : ℕ) : PairCat.{0} p :=
  rationalPair p (discPair p K π)
    ⟨{x | x.val.toValuativeRel.vle
      (algebraMap K (perfectedTateAlgebra p π Unit) (π.root 0 ^ a))
      (perfectedTateAlgebra.rootX π () 0)}, by sorry⟩

theorem rootAnnulus_isPerfectoid (a : ℕ) : IsPerfectoidTateRing p (rootAnnulus p K π a) := inferInstance

theorem ordinaryAnnulus_not_perfectoid (a : ℕ) (ha : 0 < a) :
    ¬ IsPerfectoidTateRing p (ordinaryAnnulus p K π a) := sorry

