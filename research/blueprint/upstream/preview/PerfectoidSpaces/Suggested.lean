namespace AdicSpace
open TauCetiRoadmap.AdicEtaleGeometry

open _root_.TauCeti.ValuationSpectrum

/-- The valued residue field is the pinned residue field of the affinoid valuation. -/
abbrev CompletedResidue (R : CAff) (x : spa R.P.plus) :=
  UniformSpace.Completion (WithVal (residueFieldValuation x.val))

def residueMap (R : CAff) (x : spa R.P.plus) : R.A →+* CompletedResidue R x :=
  UniformSpace.Completion.coeRingHom.comp
    (algebraMap R.A (WithVal (residueFieldValuation x.val)))

end AdicSpace

namespace Perfectoid
open TauCetiRoadmap.AdicEtaleGeometry _root_.TauCeti.ValuationSpectrum

/-- Evaluation of a rational localization in the completed valued residue field.
It exists without a sheafiness assumption. -/
def rationalResidueMap (A : CAff) [IsTateRing A.A] (D : PairOfDefinition A.A)
    (x : spa A.P.plus) (P : D.Presentation)
    (hx : x.val ∈ rationalSubset A.P.plus P.num P.den) :
    RationalLoc P →+* AdicSpace.CompletedResidue A x := sorry

theorem rationalResidueMap_spec (A : CAff) [IsTateRing A.A] (D : PairOfDefinition A.A)
    (x : spa A.P.plus) (P : D.Presentation)
    (hx : x.val ∈ rationalSubset A.P.plus P.num P.den) :
    Continuous (rationalResidueMap A D x P hx) ∧
      (rationalResidueMap A D x P hx).comp (RationalLoc.structureMap P A.P).toRingHom =
        AdicSpace.residueMap A x := sorry

-- Check: rationalResidueMap_base
example (A : CAff) [IsTateRing A.A] (D : PairOfDefinition A.A)
    (x : spa A.P.plus) (P : D.Presentation)
    (hx : x.val ∈ rationalSubset A.P.plus P.num P.den) (a : A.A) :
    rationalResidueMap A D x P hx ((RationalLoc.structureMap P A.P).toRingHom a) = 0 ↔
      x.val.valuation a = 0 := sorry
-- Check: rationalResidueMap_denominator
example (A : CAff) [IsTateRing A.A] (D : PairOfDefinition A.A)
    (x : spa A.P.plus) (P : D.Presentation)
    (hx : x.val ∈ rationalSubset A.P.plus P.num P.den) :
    rationalResidueMap A D x P hx ((RationalLoc.structureMap P A.P).toRingHom P.den) ≠ 0 := sorry
-- Check: rationalResidueMap_fraction
example (A : CAff) [IsTateRing A.A] (D : PairOfDefinition A.A)
    (x : spa A.P.plus) (P : D.Presentation)
    (hx : x.val ∈ rationalSubset A.P.plus P.num P.den) (t : A.A) :
    let j := (RationalLoc.structureMap P A.P).toRingHom
    rationalResidueMap A D x P hx (j t * Ring.inverse (j P.den)) =
      AdicSpace.residueMap A x t * Ring.inverse (AdicSpace.residueMap A x P.den) := sorry
-- Check: rationalResidueMap_empty
example (A : CAff) [IsTateRing A.A] (D : PairOfDefinition A.A)
    (x : spa A.P.plus) (P : D.Presentation) [Subsingleton (RationalLoc P)] :
    x.val ∉ rationalSubset A.P.plus P.num P.den := sorry

end Perfectoid


namespace Perfectoid

noncomputable section
open _root_.CategoryTheory _root_.CategoryTheory.Limits
open _root_.TauCeti _root_.TauCeti.Huber _root_.TauCeti.ValuationSpectrum
open _root_.TauCetiRoadmap.AdicEtaleGeometry
open scoped TensorProduct

/-! ### P3/residue-field-finite-etale-colimit -/

/-- Berkeley 7.4.6: objects descend to a rational neighbourhood. -/
theorem residue_field_finite_etale_essSurj (A : CAff) [IsTateRing A.A]
    (D : PairOfDefinition A.A) (x : spa A.P.plus)
    (B : CommAlgCat.FiniteEtale (AdicSpace.CompletedResidue A x)) :
    ∃ (P : D.Presentation) (hx : x.val ∈ rationalSubset A.P.plus P.num P.den),
      Ideal.span (P.num : Set A.A) = ⊤ ∧
      letI := (rationalResidueMap A D x P hx).toAlgebra
      ∃ C : CommAlgCat.FiniteEtale (RationalLoc P), Nonempty
        ((CommAlgCat.FiniteEtale.baseChange (RationalLoc P)
          (AdicSpace.CompletedResidue A x)).obj C ≅ B) := sorry

/-- Morphisms descend after rational refinement. Scalar-extension is specified on
pure tensors, including the maps used to compare with the residue-field morphism. -/
theorem residue_field_finite_etale_full (A : CAff) [IsTateRing A.A]
    (D : PairOfDefinition A.A) (x : spa A.P.plus) (P : D.Presentation)
    (hx : x.val ∈ rationalSubset A.P.plus P.num P.den)
    (hP : Ideal.span (P.num : Set A.A) = ⊤)
    (B C : Type) [CommRing B] [CommRing C]
    [Algebra (RationalLoc P) B] [Algebra (RationalLoc P) C]
    [Algebra.Etale (RationalLoc P) B] [Algebra.Etale (RationalLoc P) C]
    [Module.Finite (RationalLoc P) B] [Module.Finite (RationalLoc P) C] :
    let K := AdicSpace.CompletedResidue A x
    letI := (rationalResidueMap A D x P hx).toAlgebra
    ∀ φ : K ⊗[RationalLoc P] B →ₐ[K] K ⊗[RationalLoc P] C,
      ∃ (Q : D.Presentation) (hxQ : x.val ∈ rationalSubset A.P.plus Q.num Q.den)
        (r : RationalLoc P →+* RationalLoc Q),
        Ideal.span (Q.num : Set A.A) = ⊤ ∧
        rationalSubset A.P.plus Q.num Q.den ⊆ rationalSubset A.P.plus P.num P.den ∧
        Continuous r ∧ r.comp (RationalLoc.structureMap P A.P).toRingHom =
          (RationalLoc.structureMap Q A.P).toRingHom ∧
        (rationalResidueMap A D x Q hxQ).comp r = rationalResidueMap A D x P hx ∧
        letI := r.toAlgebra
        ∃ (ψ : B →ₐ[RationalLoc P] RationalLoc Q ⊗[RationalLoc P] C)
          (e : RationalLoc Q ⊗[RationalLoc P] C →+* K ⊗[RationalLoc P] C),
          (∀ (a : RationalLoc Q) (c : C), e (a ⊗ₜ[RationalLoc P] c) =
            rationalResidueMap A D x Q hxQ a ⊗ₜ[RationalLoc P] c) ∧
          ∀ b : B, e (ψ b) = φ (1 ⊗ₜ[RationalLoc P] b) := sorry

/-- Equality of two finite-level maps is detected on a smaller rational neighbourhood. -/
theorem residue_field_finite_etale_faithful (A : CAff) [IsTateRing A.A]
    (D : PairOfDefinition A.A) (x : spa A.P.plus) (P : D.Presentation)
    (hx : x.val ∈ rationalSubset A.P.plus P.num P.den)
    (hP : Ideal.span (P.num : Set A.A) = ⊤)
    (B C : Type) [CommRing B] [CommRing C]
    [Algebra (RationalLoc P) B] [Algebra (RationalLoc P) C]
    [Algebra.Etale (RationalLoc P) B] [Algebra.Etale (RationalLoc P) C]
    [Module.Finite (RationalLoc P) B] [Module.Finite (RationalLoc P) C]
    (f g : B →ₐ[RationalLoc P] C) :
    let K := AdicSpace.CompletedResidue A x
    letI := (rationalResidueMap A D x P hx).toAlgebra
    (∀ b : B, (1 : K) ⊗ₜ[RationalLoc P] f b = 1 ⊗ₜ[RationalLoc P] g b) →
      ∃ (Q : D.Presentation) (r : RationalLoc P →+* RationalLoc Q),
        x.val ∈ rationalSubset A.P.plus Q.num Q.den ∧
        Ideal.span (Q.num : Set A.A) = ⊤ ∧
        rationalSubset A.P.plus Q.num Q.den ⊆ rationalSubset A.P.plus P.num P.den ∧
        Continuous r ∧ r.comp (RationalLoc.structureMap P A.P).toRingHom =
          (RationalLoc.structureMap Q A.P).toRingHom ∧
        letI := r.toAlgebra
        ∀ b : B, (1 : RationalLoc Q) ⊗ₜ[RationalLoc P] f b = 1 ⊗ₜ[RationalLoc P] g b := sorry

end



/-! ### P3/finite-etale-over-perfectoid-is-perfectoid -/

/-- Every finite étale algebra over a perfectoid Tate ring is perfectoid for its
natural module topology (ECD Theorem 6.1(i)). -/
theorem FiniteEtale.isPerfectoid (p : ℕ) [Fact p.Prime]
    (R S : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] [CommRing S] [Algebra R S]
    [Module.Finite R S] [Algebra.Etale R S] [UniformSpace S] [IsUniformAddGroup S]
    [IsTopologicalRing S] [IsModuleTopology R S] :
    ∃ (_ : IsTateRing S) (_ : CompleteSpace S) (_ : T2Space S),
      IsPerfectoidTateRing p S := sorry

end Perfectoid

/-! ### Layer 3: Almost inversion and the geometric construction of untilting -/
namespace Perfectoid
open TauCetiRoadmap.AdicEtaleGeometry
/-- Transport the supplied finite dependent-product étaleness across the binary-product equivalence. -/
local instance finiteProductEtale (A B C : Type*) [CommRing A] [CommRing B] [CommRing C]
    [Algebra A B] [Algebra A C] [Algebra.Etale A B] [Algebra.Etale A C] :
    Algebra.Etale A (B × C) := by sorry
variable (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R]

/-- Finite étale algebras over the almostification of R°. -/
abbrev AlmostFiniteEtale := Almost.Algebra.FiniteEtale (almostSetup p R)
  ((Almost.Algebra.toAlmost (almostSetup p R)).obj
    (CommAlgCat.of (powerBoundedSubring R) (powerBoundedSubring R)))

/-- Inversion of a pseudouniformizer in the actual algebra of almost elements. -/
def almostInversion (ϖ : PseudoUniformizerRoots p R) :
    AlmostFiniteEtale p R ⥤ CommAlgCat.FiniteEtale.{u} R := sorry

/-- The canonical map of almost elements into their localization. -/
def almostInversionMap (ϖ : PseudoUniformizerRoots p R) (A : AlmostFiniteEtale p R) :
    (Almost.Algebra.elements (almostSetup p R)).obj A.obj.right →+*
      (almostInversion p R ϖ).obj A := sorry

theorem almostInversionMap_scalars (ϖ : PseudoUniformizerRoots p R)
    (A : AlmostFiniteEtale p R) (a : powerBoundedSubring R) :
    almostInversionMap p R ϖ A (algebraMap _ _ a) = algebraMap R _ a.val := sorry

theorem almostInversion_isLocalization (ϖ : PseudoUniformizerRoots p R)
    (A : AlmostFiniteEtale p R) :
    let E := (Almost.Algebra.elements (almostSetup p R)).obj A.obj.right
    letI := (almostInversionMap p R ϖ A).toAlgebra
    IsLocalization.Away (algebraMap (powerBoundedSubring R) E (ϖ.rootPB 0))
      ((almostInversion p R ϖ).obj A) := sorry

theorem almostInversionMap_natural (ϖ : PseudoUniformizerRoots p R)
    {A B : AlmostFiniteEtale p R} (f : A ⟶ B) :
    (((almostInversion p R ϖ).map f).hom.hom.toRingHom).comp (almostInversionMap p R ϖ A) =
      (almostInversionMap p R ϖ B).comp
        (((Almost.Algebra.elements (almostSetup p R)).map f.hom.right).hom.toRingHom) := sorry

/-! ### P3/characteristic-p-almost-purity-equivalence -/

/-- GR 3.5.28, pp. 69–71: almost elements are perfect in characteristic p. -/
theorem almostInversion_charP_perfect (hchar : (p : R) = 0)
    (A : AlmostFiniteEtale p R) :
    Function.Bijective (fun x : (Almost.Algebra.elements (almostSetup p R)).obj A.obj.right ↦
      x ^ p) := sorry

/-- GR 3.5.28 and Sch12 5.3(iv): regularity and completeness of almost elements. -/
theorem almostInversion_elements_complete (ϖ : PseudoUniformizerRoots p R)
    (A : AlmostFiniteEtale p R) :
    let E := (Almost.Algebra.elements (almostSetup p R)).obj A.obj.right
    Function.Injective (fun x : E ↦ (ϖ.rootPB 0) • x) ∧
      IsAdicComplete (Ideal.span {ϖ.rootPB 0}) E := sorry

/-- GR 3.5.32: the localization embeds almost elements as the integral closure. -/
theorem almostInversion_elements_integralClosure (ϖ : PseudoUniformizerRoots p R)
    (A : AlmostFiniteEtale p R) :
    Function.Injective (almostInversionMap p R ϖ A) ∧
    ∀ x : (almostInversion p R ϖ).obj A,
      (∃ a, almostInversionMap p R ϖ A a = x) ↔
        IsIntegral ((powerBoundedSubring R).map
          (algebraMap R ((almostInversion p R ϖ).obj A))) x := sorry

/-- Sch12 5.23 and 5.25: one finite bound works for every almost scalar. -/
theorem almostInversion_uniformlyAlmostFiniteProjective (A : AlmostFiniteEtale p R) :
    ∃ n : ℕ, Almost.Module.UniformlyAlmostFiniteProjective (almostSetup p R)
      A.obj.right.X n := sorry

/-- Almost faithful flatness is detected after inversion, GR 3.5.28 and Sch12 7.9. -/
theorem almostInversion_faithfullyFlat_iff (ϖ : PseudoUniformizerRoots p R)
    (A : AlmostFiniteEtale p R) :
    Almost.Algebra.IsFaithfullyFlat (almostSetup p R) A.obj.hom ↔
      Module.FaithfullyFlat R ((almostInversion p R ϖ).obj A) := sorry

/-! ### P3/almost-finite-etale-equivalence -/

instance almostInversion_isEquivalence (ϖ : PseudoUniformizerRoots p R) :
    (almostInversion p R ϖ).IsEquivalence := sorry

/-- The split almost algebra, with its structural map from R°a. -/
def almostSplit (n : ℕ) : AlmostFiniteEtale p R :=
  ⟨Under.mk ((Almost.Algebra.toAlmost (almostSetup p R)).map
    (CommAlgCat.ofHom (Algebra.ofId (powerBoundedSubring R) (Fin n → powerBoundedSubring R)))),
    by sorry⟩

-- Check: inversion_rank_zero
example (ϖ : PseudoUniformizerRoots p R) : Nonempty
    ((almostInversion p R ϖ).obj (almostSplit p R 0) ≅ CommAlgCat.FiniteEtale.of R (Fin 0 → R)) := sorry
-- Check: inversion_rank_one
example (ϖ : PseudoUniformizerRoots p R) : Nonempty
    ((almostInversion p R ϖ).obj (almostSplit p R 1) ≅ CommAlgCat.FiniteEtale.of R R) := sorry
-- Check: inversion_rank_two
example (ϖ : PseudoUniformizerRoots p R) : Nonempty
    ((almostInversion p R ϖ).obj (almostSplit p R 2) ≅ CommAlgCat.FiniteEtale.of R (R × R)) := sorry
local notation "NatFE" => TauCetiRoadmap.AdicEtaleGeometry.Huber.FiniteEtale

/-- ECD 6.1(i) on the supplied finite-algebra module topology. -/
theorem FiniteEtale.naturalPerfectoid (S : CommAlgCat.FiniteEtale.{u} R) :
    IsPerfectoidTateRing p (NatFE R S) := sorry

attribute [instance] FiniteEtale.naturalPerfectoid

/-- Finite étale algebras map to their tilts with the induced algebra structures. -/
def FiniteEtale.tiltFunctor : CommAlgCat.FiniteEtale.{u} R ⥤ CommAlgCat.FiniteEtale.{u} (tilt p R) where
  obj S := by
    letI : Algebra (tilt p R) (tilt p (NatFE R S)) :=
      (tilt.map p (algebraMap R (NatFE R S)) (by sorry)).toAlgebra
    exact ⟨CommAlgCat.of (tilt p R) (tilt p (NatFE R S)), by sorry⟩
  map := by sorry
  map_id := by sorry
  map_comp := by sorry

/-- The geometric tilt acts coordinatewise on maps of finite algebras. -/
theorem FiniteEtale.tiltFunctor_map_coeff {S T : CommAlgCat.FiniteEtale.{u} R}
    (f : S ⟶ T) (x : tilt p (NatFE R S)) (n : ℕ) :
    tilt.coeff (R := NatFE R T) n (((FiniteEtale.tiltFunctor p R).map f).hom.hom x) =
      f.hom.hom (tilt.coeff (R := NatFE R S) n x) := sorry

/-- The untilt object with its natural module topology is perfectoid. -/
theorem FiniteEtale.untilt_isPerfectoid (T : CommAlgCat.FiniteEtale.{u} (tilt p R)) :
    IsPerfectoidTateRing p (NatFE R ((FiniteEtale.untilt p R).obj T)) := inferInstance

/-- Natural comparison with the actual geometric tilt, Sch12 5.22 and 5.25. -/
def FiniteEtale.tiltUntiltIso :
    FiniteEtale.untilt p R ⋙ FiniteEtale.tiltFunctor p R ≅ 𝟭 _ := sorry

def FiniteEtale.untiltTiltIso :
    FiniteEtale.tiltFunctor p R ⋙ FiniteEtale.untilt p R ≅ 𝟭 _ := sorry

/-- The abstract inverse chosen by asEquivalence agrees with coordinatewise tilting. -/
def finiteEtaleTiltEquiv_comparison :
    (finiteEtaleTiltEquiv p R).functor ≅ FiniteEtale.tiltFunctor p R := sorry

/-- The comparison satisfies the triangle identity; it is a coherent inverse. -/
theorem FiniteEtale.tiltUntilt_triangle (S : CommAlgCat.FiniteEtale.{u} R) :
    (FiniteEtale.tiltFunctor p R).map ((FiniteEtale.untiltTiltIso p R).hom.app S) =
      (FiniteEtale.tiltUntiltIso p R).hom.app ((FiniteEtale.tiltFunctor p R).obj S) := sorry

-- Check: geometric_tilt_zero
example : Nonempty ((FiniteEtale.tiltFunctor p R).obj (CommAlgCat.FiniteEtale.of R (Fin 0 → R)) ≅
    CommAlgCat.FiniteEtale.of (tilt p R) (Fin 0 → tilt p R)) := sorry
-- Check: geometric_tilt_one
example : Nonempty ((FiniteEtale.tiltFunctor p R).obj (CommAlgCat.FiniteEtale.of R R) ≅
    CommAlgCat.FiniteEtale.of (tilt p R) (tilt p R)) := sorry
-- Check: geometric_tilt_two
example : Nonempty ((FiniteEtale.tiltFunctor p R).obj (CommAlgCat.FiniteEtale.of R (R × R)) ≅
    CommAlgCat.FiniteEtale.of (tilt p R) (tilt p R × tilt p R)) := sorry
-- Check: untilt_actual_tilt
example :
    let T := CommAlgCat.FiniteEtale.of (tilt p R) (tilt p R × tilt p R)
    let S := (FiniteEtale.untilt p R).obj T
    ∃ e : S ≅ CommAlgCat.FiniteEtale.of R (R × R),
      e.hom.hom.hom (tilt.sharp (R := NatFE R S)
        (((FiniteEtale.tiltUntiltIso p R).inv.app T).hom.hom (1, 0))) = (1, 0) ∧
      e.hom.hom.hom (tilt.sharp (R := NatFE R S)
        (((FiniteEtale.tiltUntiltIso p R).inv.app T).hom.hom (0, 1))) = (0, 1) := sorry

/-- Naturality in a continuous perfectoid base-ring map, ECD 6.1(ii). -/
def FiniteEtale.untiltBaseChangeIso
    (R' : Type u) [CommRing R'] [UniformSpace R'] [IsUniformAddGroup R']
    [IsTopologicalRing R'] [IsTateRing R'] [CompleteSpace R'] [T2Space R']
    [IsPerfectoidTateRing p R'] (f : R →+* R') (hf : Continuous f) :
    letI := f.toAlgebra
    letI := (tilt.map p f hf).toAlgebra
    CommAlgCat.FiniteEtale.baseChange (tilt p R) (tilt p R') ⋙ FiniteEtale.untilt p R' ≅
      FiniteEtale.untilt p R ⋙ CommAlgCat.FiniteEtale.baseChange R R' := sorry

/-- ECD 6.1(ii), p. 26: the base-change component sends the sharp of a pure
tilted tensor to the tensor of the corresponding sharps. -/
theorem FiniteEtale.untiltBaseChangeIso_app
    (R' : Type u) [CommRing R'] [UniformSpace R'] [IsUniformAddGroup R']
    [IsTopologicalRing R'] [IsTateRing R'] [CompleteSpace R'] [T2Space R']
    [IsPerfectoidTateRing p R'] (f : R →+* R') (hf : Continuous f)
    (T : CommAlgCat.FiniteEtale.{u} (tilt p R)) :
    letI := f.toAlgebra
    letI := (tilt.map p f hf).toAlgebra
    let T' := (CommAlgCat.FiniteEtale.baseChange (tilt p R) (tilt p R')).obj T
    ∀ (a : tilt p R') (t : T),
      ((FiniteEtale.untiltBaseChangeIso p R R' f hf).hom.app T).hom.hom
        (tilt.sharp (R := NatFE R' ((FiniteEtale.untilt p R').obj T'))
          (((FiniteEtale.tiltUntiltIso p R').inv.app T').hom.hom
          (a ⊗ₜ[tilt p R] t))) =
        (tilt.sharp a) ⊗ₜ[R]
          (tilt.sharp (R := NatFE R ((FiniteEtale.untilt p R).obj T))
            (((FiniteEtale.tiltUntiltIso p R).inv.app T).hom.hom t)) := sorry

/-- The identity base map gives the tensor-unit comparison (Sch12 5.25,
p. 29; ECD 6.1(ii), p. 26). -/
theorem FiniteEtale.untiltBaseChangeIso_id (T : CommAlgCat.FiniteEtale.{u} (tilt p R)) :
    let e : CommAlgCat.FiniteEtale.baseChange (tilt p R) (tilt p R) ⋙
        FiniteEtale.untilt p R ≅
      FiniteEtale.untilt p R ⋙ CommAlgCat.FiniteEtale.baseChange R R := by
        have hR : (RingHom.id R).toAlgebra = Algebra.id R := toAlgebra_algebraMap
        have hTilt : (RingHom.id (tilt p R)).toAlgebra = Algebra.id (tilt p R) :=
          toAlgebra_algebraMap
        simpa +instances only [tilt.map_id, hR, hTilt] using
          FiniteEtale.untiltBaseChangeIso p R R (RingHom.id R) continuous_id
    e.hom.app T ≫ (CommAlgCat.FiniteEtale.baseChangeSelfIso R).hom.app
        ((FiniteEtale.untilt p R).obj T) =
      (FiniteEtale.untilt p R).map
        ((CommAlgCat.FiniteEtale.baseChangeSelfIso (tilt p R)).hom.app T) := sorry

/-- Iterated base change agrees with base change along the composite, using
the canonical tensor associativity maps (ECD 6.1(ii), p. 26). -/
theorem FiniteEtale.untiltBaseChangeIso_comp
    (R' R'' : Type u) [CommRing R'] [UniformSpace R'] [IsUniformAddGroup R']
    [IsTopologicalRing R'] [IsTateRing R'] [CompleteSpace R'] [T2Space R']
    [IsPerfectoidTateRing p R'] [CommRing R''] [UniformSpace R''] [IsUniformAddGroup R'']
    [IsTopologicalRing R''] [IsTateRing R''] [CompleteSpace R''] [T2Space R'']
    [IsPerfectoidTateRing p R''] (f : R →+* R') (hf : Continuous f)
    (g : R' →+* R'') (hg : Continuous g) (T : CommAlgCat.FiniteEtale.{u} (tilt p R)) :
    letI := f.toAlgebra
    letI := g.toAlgebra
    letI := (g.comp f).toAlgebra
    letI : IsScalarTower R R' R'' := IsScalarTower.of_algebraMap_eq' rfl
    letI := (tilt.map p f hf).toAlgebra
    letI := (tilt.map p g hg).toAlgebra
    letI := (tilt.map p (g.comp f) (hg.comp hf)).toAlgebra
    letI : IsScalarTower (tilt p R) (tilt p R') (tilt p R'') :=
      IsScalarTower.of_algebraMap_eq' (tilt.map_comp f hf g hg)
    let c := Algebra.TensorProduct.cancelBaseChange
      (tilt p R) (tilt p R') (tilt p R'') (tilt p R'') T
    let d := Algebra.TensorProduct.cancelBaseChange R R' R'' R''
      ((FiniteEtale.untilt p R).obj T)
    (FiniteEtale.untilt p R'').map (CommAlgCat.FiniteEtale.ofHom c.toAlgHom) ≫
        (FiniteEtale.untiltBaseChangeIso p R R'' (g.comp f) (hg.comp hf)).hom.app T =
      (FiniteEtale.untiltBaseChangeIso p R' R'' g hg).hom.app
          ((CommAlgCat.FiniteEtale.baseChange (tilt p R) (tilt p R')).obj T) ≫
        (CommAlgCat.FiniteEtale.baseChange R' R'').map
          ((FiniteEtale.untiltBaseChangeIso p R R' f hf).hom.app T) ≫
        CommAlgCat.FiniteEtale.ofHom d.toAlgHom := sorry

-- Check: untiltBaseChangeIso_identity
example (T : CommAlgCat.FiniteEtale.{u} (tilt p R)) :=
  FiniteEtale.untiltBaseChangeIso_id p R T
-- Check: untiltBaseChangeIso_composite
example (R' R'' : Type u) [CommRing R'] [UniformSpace R'] [IsUniformAddGroup R']
    [IsTopologicalRing R'] [IsTateRing R'] [CompleteSpace R'] [T2Space R']
    [IsPerfectoidTateRing p R'] [CommRing R''] [UniformSpace R''] [IsUniformAddGroup R'']
    [IsTopologicalRing R''] [IsTateRing R''] [CompleteSpace R''] [T2Space R'']
    [IsPerfectoidTateRing p R''] (f : R →+* R') (hf : Continuous f)
    (g : R' →+* R'') (hg : Continuous g) (T : CommAlgCat.FiniteEtale.{u} (tilt p R)) :=
  FiniteEtale.untiltBaseChangeIso_comp p R R' R'' f hf g hg T
-- Check: untiltBaseChangeIso_scalar
example (R' : Type u) [CommRing R'] [UniformSpace R'] [IsUniformAddGroup R']
    [IsTopologicalRing R'] [IsTateRing R'] [CompleteSpace R'] [T2Space R']
    [IsPerfectoidTateRing p R'] (f : R →+* R') (hf : Continuous f)
    (T : CommAlgCat.FiniteEtale.{u} (tilt p R)) :
    letI := f.toAlgebra
    letI := (tilt.map p f hf).toAlgebra
    let T' := (CommAlgCat.FiniteEtale.baseChange (tilt p R) (tilt p R')).obj T
    ∀ a : tilt p R',
      ((FiniteEtale.untiltBaseChangeIso p R R' f hf).hom.app T).hom.hom
        (tilt.sharp (R := NatFE R' ((FiniteEtale.untilt p R').obj T'))
          (((FiniteEtale.tiltUntiltIso p R').inv.app T').hom.hom
          (a ⊗ₜ[tilt p R] (1 : T)))) =
        (tilt.sharp a) ⊗ₜ[R] (1 : (FiniteEtale.untilt p R).obj T) := sorry

/-- Parameter independence is the unique localization comparison fixing almost elements. -/
def almostInversionParameterIso (ϖ ψ : PseudoUniformizerRoots p R) :
    almostInversion p R ϖ ≅ almostInversion p R ψ := sorry

theorem almostInversionParameterIso_elements (ϖ ψ : PseudoUniformizerRoots p R)
    (A : AlmostFiniteEtale p R)
    (a : (Almost.Algebra.elements (almostSetup p R)).obj A.obj.right) :
    ((almostInversionParameterIso p R ϖ ψ).hom.app A).hom.hom
      (almostInversionMap p R ϖ A a) = almostInversionMap p R ψ A a := sorry

theorem almostInversionParameterIso_cocycle (ϖ ψ χ : PseudoUniformizerRoots p R) :
    almostInversionParameterIso p R ϖ ψ ≪≫ almostInversionParameterIso p R ψ χ =
      almostInversionParameterIso p R ϖ χ := sorry

/-- A finite algebra with its natural topology and integral-closure plus ring,
regarded as an object under the base perfectoid pair. -/
def finiteEtalePairFunctor (B : PairCat.{u} p) :
    CommAlgCat.FiniteEtale.{u} B ⥤ Under B where
  obj S := Under.mk (show B ⟶
      (⟨NatFE B S, Huber.Pair.finiteEtale B.pair S⟩ : PairCat.{u} p) from
    Huber.Pair.finiteEtale.hom B.pair S)
  map := by sorry
  map_id := by sorry
  map_comp := by sorry

theorem finiteEtalePairFunctor_map (B : PairCat.{u} p)
    {S T : CommAlgCat.FiniteEtale.{u} B} (f : S ⟶ T) :
    ((finiteEtalePairFunctor p B).map f).right.toRingHom = f.hom.hom.toRingHom := sorry

/-- The finite-algebra untilt agrees, over the original pair, with P1's
Witt-vector slice untilt; this comparison fixes the base action and the plus ring. -/
def FiniteEtale.untiltPairIso (P : Pair R) :
    let B : PairCat.{u} p := ⟨R, P⟩
    FiniteEtale.untilt p R ⋙ finiteEtalePairFunctor p B ≅
      finiteEtalePairFunctor p ((PairCat.tiltFunctor p).obj B) ⋙
        PairCat.sliceUntiltFunctor p B := sorry

-- Check: finite_pair_zero
example (B : PairCat.{u} p) :
    Subsingleton (((finiteEtalePairFunctor p B).obj
      (CommAlgCat.FiniteEtale.of B (Fin 0 → B))).right) := by sorry
-- Check: finite_pair_one
example (B : PairCat.{u} p) :
    Nonempty ((finiteEtalePairFunctor p B).obj (CommAlgCat.FiniteEtale.of B B) ≅
      Under.mk (𝟙 B)) := sorry
-- Check: finite_pair_two
example (B : PairCat.{u} p) (x : B × B) :
    x ∈ (((finiteEtalePairFunctor p B).obj (CommAlgCat.FiniteEtale.of B (B × B))).right.pair.plus) ↔
      x.1 ∈ B.pair.plus ∧ x.2 ∈ B.pair.plus := sorry

/-- Compatibility with P1's concrete Witt-vector quotient, AWS 2.8.10.
The primitive ideal is the extension of the kernel of the base Fontaine map. -/
def FiniteEtale.untiltWittIso (P : Pair R)
    (T : CommAlgCat.FiniteEtale.{u} (tilt p R)) :
    let Q := Huber.Pair.finiteEtale (Pair.tilt p P) T
    let f := Huber.Pair.finiteEtale.hom (Pair.tilt p P) T
    let J := (RingHom.ker (tilt.theta p P)).map
      (WittVector.map (f.toRingHom.restrict _ _ f.map_mem_plus))
    let B : PairCat.{u} p := ⟨R, P⟩
    let V := (finiteEtalePairFunctor p ((PairCat.tiltFunctor p).obj B)).obj T
    let X := PairCat.sliceTriple p B V
    letI : Algebra R (Perfectoid.untilt p Q J) :=
      ((PrimitiveTriple.untiltCarrierEquiv p X).toRingHom.comp
        (((PairCat.sliceUntiltFunctor p B).obj V).hom.toRingHom)).toAlgebra
    ((FiniteEtale.untilt p R).obj T) ≃ₐ[R] Perfectoid.untilt p Q J := sorry

/-- The Witt comparison sends the sharp specified by the geometric marking
to the localized Teichmüller class (KL I 3.6.20, p. 97; P1's tiltIso_sharp). -/
theorem FiniteEtale.untiltWittIso_apply (P : Pair R)
    (T : CommAlgCat.FiniteEtale.{u} (tilt p R))
    (x : (Huber.Pair.finiteEtale (Pair.tilt p P) T).plus) :
    let Q := Huber.Pair.finiteEtale (Pair.tilt p P) T
    let f := Huber.Pair.finiteEtale.hom (Pair.tilt p P) T
    let J := (RingHom.ker (tilt.theta p P)).map
      (WittVector.map (f.toRingHom.restrict _ _ f.map_mem_plus))
    let B : PairCat.{u} p := ⟨R, P⟩
    let V := (finiteEtalePairFunctor p ((PairCat.tiltFunctor p).obj B)).obj T
    let X := PairCat.sliceTriple p B V
    letI : Algebra R (Perfectoid.untilt p Q J) :=
      ((PrimitiveTriple.untiltCarrierEquiv p X).toRingHom.comp
      (((PairCat.sliceUntiltFunctor p B).obj V).hom.toRingHom)).toAlgebra
    (FiniteEtale.untiltWittIso p R P T).toRingEquiv
        (tilt.sharp (R := NatFE R ((FiniteEtale.untilt p R).obj T))
          (((FiniteEtale.tiltUntiltIso p R).inv.app T).hom.hom x.val)) =
      algebraMap (WittVector p Q.plus ⧸ J) (Perfectoid.untilt p Q J)
        (Ideal.Quotient.mk J (WittVector.teichmuller p x)) := sorry

/-- The scalar action is the base Fontaine map followed by extension of Witt
vectors and localization (KL I 3.6.20, p. 97). -/
theorem FiniteEtale.untiltWittIso_scalars (P : Pair R)
    (T : CommAlgCat.FiniteEtale.{u} (tilt p R))
    (w : WittVector p (Pair.tilt p P).plus) :
    let Q := Huber.Pair.finiteEtale (Pair.tilt p P) T
    let f := Huber.Pair.finiteEtale.hom (Pair.tilt p P) T
    let j := WittVector.map (f.toRingHom.restrict _ _ f.map_mem_plus)
    let J := (RingHom.ker (tilt.theta p P)).map j
    let B : PairCat.{u} p := ⟨R, P⟩
    let V := (finiteEtalePairFunctor p ((PairCat.tiltFunctor p).obj B)).obj T
    let X := PairCat.sliceTriple p B V
    letI : Algebra R (Perfectoid.untilt p Q J) :=
      ((PrimitiveTriple.untiltCarrierEquiv p X).toRingHom.comp
      (((PairCat.sliceUntiltFunctor p B).obj V).hom.toRingHom)).toAlgebra
    (FiniteEtale.untiltWittIso p R P T).toRingEquiv
        (algebraMap R ((FiniteEtale.untilt p R).obj T) (tilt.theta p P w).val) =
      algebraMap (WittVector p Q.plus ⧸ J) (Perfectoid.untilt p Q J)
        (Ideal.Quotient.mk J (j w)) := sorry

/-- The comparison of pairs induces exactly the specified Witt algebra
comparison on carriers (KL I 3.6.20, p. 97; ECD 6.1(ii), p. 26). -/
theorem FiniteEtale.untiltPairIso_app (P : Pair R)
    (T : CommAlgCat.FiniteEtale.{u} (tilt p R)) (x : (FiniteEtale.untilt p R).obj T) :
    let Q := Huber.Pair.finiteEtale (Pair.tilt p P) T
    let f := Huber.Pair.finiteEtale.hom (Pair.tilt p P) T
    let J := (RingHom.ker (tilt.theta p P)).map
      (WittVector.map (f.toRingHom.restrict _ _ f.map_mem_plus))
    let B : PairCat.{u} p := ⟨R, P⟩
    let V := (finiteEtalePairFunctor p ((PairCat.tiltFunctor p).obj B)).obj T
    let X := PairCat.sliceTriple p B V
    letI : Algebra R (Perfectoid.untilt p Q J) :=
      ((PrimitiveTriple.untiltCarrierEquiv p X).toRingHom.comp
      (((PairCat.sliceUntiltFunctor p B).obj V).hom.toRingHom)).toAlgebra
    PrimitiveTriple.untiltCarrierEquiv p X
        (((FiniteEtale.untiltPairIso p R P).hom.app T).right.toRingHom x) =
      (FiniteEtale.untiltWittIso p R P T).toRingEquiv x := sorry

-- Check: untiltWittIso_zero
example (P : Pair R) :
    let T := CommAlgCat.FiniteEtale.of (tilt p R) (Fin 0 → tilt p R)
    let Q := Huber.Pair.finiteEtale (Pair.tilt p P) T
    let f := Huber.Pair.finiteEtale.hom (Pair.tilt p P) T
    let J := (RingHom.ker (tilt.theta p P)).map
      (WittVector.map (f.toRingHom.restrict _ _ f.map_mem_plus))
    let B : PairCat.{u} p := ⟨R, P⟩
    let V := (finiteEtalePairFunctor p ((PairCat.tiltFunctor p).obj B)).obj T
    let X := PairCat.sliceTriple p B V
    letI : Algebra R (Perfectoid.untilt p Q J) :=
      ((PrimitiveTriple.untiltCarrierEquiv p X).toRingHom.comp
      (((PairCat.sliceUntiltFunctor p B).obj V).hom.toRingHom)).toAlgebra
    ∀ x : (FiniteEtale.untilt p R).obj T,
      (FiniteEtale.untiltWittIso p R P T).toRingEquiv x = 0 := sorry
