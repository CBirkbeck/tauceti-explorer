/-- The unit annulus is the P1 completed Laurent algebra, with its specified topology. -/
theorem unitAnnulus_laurent (K : AffinoidField p) (π : PseudoUniformizerRoots p K) :
    ∃ e : rationalPair p (discPair p K π) (unitAnnulus p K π) ≃+*
      perfectedTateAlgebra.laurent p π Unit,
      Continuous e ∧ Continuous e.symm ∧ ∀ a : K,
        e ((rationalMap p (discPair p K π) (unitAnnulus p K π)).toRingHom
          (algebraMap K (perfectedTateAlgebra p π Unit) a)) =
        algebraMap K (perfectedTateAlgebra.laurent p π Unit) a := sorry
