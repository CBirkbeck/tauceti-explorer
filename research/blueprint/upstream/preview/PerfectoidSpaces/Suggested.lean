namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
open TauCeti Huber Perfectoid _root_.CategoryTheory TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]

/-- The perfectoid affinoid presentation agrees with the classical adic presentation.
Berkeley 3.2.2 and §3.4, printed pp. 20 and 22. -/
theorem isAffinoidPerfectoid_ofAdicSpace_iff (X : TauCeti.AdicSpace.{0}) :
    IsAffinoidPerfectoid p (YonedaAdicSpace.ofAdicSpace.obj X) ↔
      ∃ (R : PairCat.{0} p) (hR : (CAff.of R.pair).Sheafy),
        Nonempty (X ≅ (CAff.of R.pair).adicSpa hR) := sorry

/-- The Yoneda perfectoid predicate is the classical open-cover condition.
ECD Definition 3.19, p. 18; Berkeley §3.4, printed p. 22. -/
theorem isPerfectoidSpace_ofAdicSpace_iff (X : TauCeti.AdicSpace.{0}) :
    IsPerfectoidSpace p (YonedaAdicSpace.ofAdicSpace.obj X) ↔
      ∀ x : X.obj, ∃ (R : PairCat.{0} p) (hR : (CAff.of R.pair).Sheafy)
        (f : (CAff.of R.pair).adicSpa hR ⟶ X),
        PreAdicSpace.IsOpenImmersion f.hom ∧ x ∈ Set.range f.hom.base := sorry

/-- Wedhorn 8.25, p. 80, on morphisms into the perfectoid Yoneda spectrum.
The continuous integral map is the supplied comparison on the underlying sheaf morphism. -/
theorem spaHomEquiv_adic (R : PairCat.{0} p) (Y : TauCeti.AdicSpace.{0}) :
    ∃ e : (YonedaAdicSpace.ofAdicSpace.obj Y ⟶ (ofPair p R).obj) ≃
      {φ : R →+* Y.obj.toPresheafedSpace.presheaf.obj (Opposite.op ⊤) //
        Continuous φ ∧ ∀ a ∈ R.pair.plus,
          φ a ∈ TauCetiRoadmap.AdicEtaleGeometry.AdicSpace.Oplus Y ⊤},
      ∀ f, e f = YonedaAdicSpace.mapsFromAdicSpaceEquiv Y (CAff.of R.pair) f.hom := sorry

-- Check: adic_comparison_affinoid
example (R : PairCat.{0} p) (hR : (CAff.of R.pair).Sheafy) :
    IsAffinoidPerfectoid p (YonedaAdicSpace.ofAdicSpace.obj ((CAff.of R.pair).adicSpa hR)) :=
  (isAffinoidPerfectoid_ofAdicSpace_iff p _).mpr ⟨R, hR, ⟨Iso.refl _⟩⟩

-- Check: adic_comparison_empty
example (X : TauCeti.AdicSpace.{0}) [IsEmpty X.obj] :
    IsPerfectoidSpace p (YonedaAdicSpace.ofAdicSpace.obj X) :=
  (isPerfectoidSpace_ofAdicSpace_iff p X).mpr (fun x => isEmptyElim x)

