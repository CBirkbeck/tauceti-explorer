 theorem stronglyZariskiClosed_tilt_iff {R S : PairCat.{0} p} (f : R ⟶ S) :
    IsStronglyZariskiClosed_affinoid ((PairCat.tiltFunctor p).map f) ↔
      IsStronglyZariskiClosed_affinoid f := sorry

 theorem tilt_kernel_sharp {R S : PairCat.{0} p} (f : R ⟶ S)
    (hf : Function.Surjective f.toRingHom) :
    RingHom.ker f.toRingHom = (Ideal.span
      ((tilt.sharp (p := p) (R := R)) '' {x : tilt p R | ((PairCat.tiltFunctor p).map f).toRingHom x = 0})).closure := sorry

