/-! ### Layer 5: Countable perfectoid subrings -/
namespace Perfectoid
universe u
variable (p : ℕ) [Fact p.Prime] (R : PairCat.{u} p) (ϖ : PseudoUniformizerRoots p R)

/-! ### P5/countably-generated-decomposition -/

/-- Closed perfectoid subrings with countable dense subsets and the chosen small unit inverted. -/
def countablePerfectoidSubrings : Set (Subring R) :=
  {S | IsClosed (S : Set R) ∧ ϖ.root 0 ∈ S ∧ (ϖ.zpow (-1) 0 : R) ∈ S ∧
    (∃ C : Set S, C.Countable ∧ Dense C) ∧
    ∃ hT : IsTateRing S, letI := hT
      ∃ hC : CompleteSpace S, letI := hC
        IsPerfectoidTateRing p S}

/-! ### P5/countable-perfectoid-hull -/

/-- ECD 6.5: the hull contains the specified roots as well as the countable input. -/
theorem countablePerfectoidHull (C : Set R) (hC : C.Countable) :
    ∃ S ∈ countablePerfectoidSubrings p R ϖ,
      C ⊆ S ∧ ∀ n, ϖ.root n ∈ S := sorry

theorem countablePerfectoidSubrings_directed
    (T : Set (countablePerfectoidSubrings p R ϖ)) (hT : T.Countable) :
    ∃ S : countablePerfectoidSubrings p R ϖ, ∀ t ∈ T, t ≤ S := sorry

theorem countablePerfectoidSubrings_cover (x : R) :
    ∃ S : countablePerfectoidSubrings p R ϖ, x ∈ S.val := sorry

theorem countablePerfectoidSubrings_card (S : countablePerfectoidSubrings p R ϖ) :
    Cardinal.mk S.val ≤ (2 : Cardinal.{u}) ^ Cardinal.aleph0 := sorry

-- Check: countableSubrings_separable_top
example [TopologicalSpace.SeparableSpace R] : (⊤ : Subring R) ∈ countablePerfectoidSubrings p R ϖ := sorry
-- Check: countableSubrings_nonseparable_top
example (h : ¬ TopologicalSpace.SeparableSpace R) : (⊤ : Subring R) ∉ countablePerfectoidSubrings p R ϖ := sorry
-- Check: countableSubrings_zero
example [Subsingleton R] : Unique (countablePerfectoidSubrings p R ϖ) := sorry

/-- The plus ring of a subring is its inverse image from the ambient pair. -/
def countableSubringPair (S : countablePerfectoidSubrings p R ϖ) : PairCat.{u} p := by
  letI : IsTateRing S.val := Classical.choose S.property.2.2.2.2
  letI : CompleteSpace S.val := Classical.choose (Classical.choose_spec S.property.2.2.2.2)
  letI : IsPerfectoidTateRing p S.val := Classical.choose_spec
    (Classical.choose_spec S.property.2.2.2.2)
  exact { carrier := S.val, pair := ⟨R.pair.plus.comap S.val.subtype, by sorry⟩ }

def countableSubringDiagram : countablePerfectoidSubrings p R ϖ ⥤ PairCat.{u} p where
  obj := countableSubringPair p R ϖ
  map f := { toRingHom := Subring.inclusion (leOfHom f)
             continuous_toRingHom := by sorry
             map_mem_plus := by sorry }
  map_id := by sorry
  map_comp := by sorry

def countableSubringCocone : Cocone (countableSubringDiagram p R ϖ) where
  pt := R
  ι := { app := fun S ↦
           { toRingHom := S.val.subtype
             continuous_toRingHom := by sorry
             map_mem_plus := by sorry }
         naturality := by sorry }

/-- The ring and pair colimit is uncompleted, ECD 6.5. -/
def countableSubringIsColimit : IsColimit (countableSubringCocone p R ϖ) := sorry
end Perfectoid

/-! ### Layer 5: Spectral descent with explicit limit cones -/
namespace PerfectoidSpace
open Perfectoid TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]
variable {I : Type} [SmallCategory I] [hI : IsCofiltered I]

/-! ### P5/quasicompact-opens-in-limits-of-spectral-spaces -/

/-- A cofiltered limit of spectral spaces along spectral maps is spectral, with
spectral projections (ECD Lemma 2.11, p. 13). -/
theorem spectralLimit_spectral {J : Type u} [SmallCategory J] [IsCofiltered J]
    (D : J ⥤ TopCat.{v}) (hD : ∀ j, SpectralSpace (D.obj j))
    (hm : ∀ {i j} (a : i ⟶ j), IsSpectralMap (D.map a))
    (c : Cone D) (hc : IsLimit c) :
    SpectralSpace c.pt ∧ ∀ j, IsSpectralMap (c.π.app j) := sorry

include hI in
/-- Stacks 0A30: qc opens of the actual topological limit descend. -/
theorem spectralLimit_qcOpen (D : I ⥤ TopCat.{1})
    (hD : ∀ i, SpectralSpace (D.obj i))
    (hm : ∀ {i j} (a : i ⟶ j), IsSpectralMap (D.map a))
    (c : Cone D) (hc : IsLimit c) (U : Set c.pt) (ho : IsOpen U) (hq : IsCompact U) :
    ∃ (i : I) (V : Set (D.obj i)), IsOpen V ∧ IsCompact V ∧ U = c.π.app i ⁻¹' V := sorry

include hI in
/-- Stacks 0A2Y: constructible sets descend under the same spectral hypotheses. -/
theorem spectralLimit_constructible (D : I ⥤ TopCat.{1})
    (hD : ∀ i, SpectralSpace (D.obj i))
    (hm : ∀ {i j} (a : i ⟶ j), IsSpectralMap (D.map a))
    (c : Cone D) (hc : IsLimit c) (U : Set c.pt) (hU : IsConstructible U) :
    ∃ (i : I) (V : Set (D.obj i)), IsConstructible V ∧ U = c.π.app i ⁻¹' V := sorry

include hI in
theorem spectralLimit_eventual_inclusion (D : I ⥤ TopCat.{1})
    (hD : ∀ i, SpectralSpace (D.obj i))
    (hm : ∀ {i j} (a : i ⟶ j), IsSpectralMap (D.map a))
    (c : Cone D) (hc : IsLimit c) (i : I) (U V : Set (D.obj i))
    (hU : IsOpen U ∧ IsCompact U) (hV : IsOpen V ∧ IsCompact V)
    (h : c.π.app i ⁻¹' U ⊆ c.π.app i ⁻¹' V) :
    ∃ (j : I) (a : j ⟶ i), D.map a ⁻¹' U ⊆ D.map a ⁻¹' V := sorry

include hI in
theorem spectralLimit_eventual_clopen (D : I ⥤ TopCat.{1})
    (hD : ∀ i, SpectralSpace (D.obj i))
    (hm : ∀ {i j} (a : i ⟶ j), IsSpectralMap (D.map a))
    (c : Cone D) (hc : IsLimit c) (i : I) (U : Set (D.obj i))
    (hU : IsOpen U ∧ IsCompact U) (h : IsClopen (c.π.app i ⁻¹' U)) :
    ∃ (j : I) (a : j ⟶ i), IsClopen (D.map a ⁻¹' U) := sorry

variable (X : I ⥤ Perfd p) (hX : ∀ i, IsAffinoidPerfectoid p (X.obj i).obj)

/-! ### P5/limit-of-qcqs-base-changes -/

/-- The diagram on the over-category uses the genuine geometric pullbacks. -/
def cofilteredLimit.baseChangeDiagram (i : I) {Y : Perfd p} (g : Y ⟶ X.obj i) :
    Over i ⥤ Perfd p where
  obj a := pullback g (X.map a.hom)
  map f := pullback.map _ _ _ _ (𝟙 Y) (X.map f.left) (𝟙 _) (by simp) (by sorry)
  map_id := by sorry
  map_comp := by sorry

def cofilteredLimit.baseChangeCone (i : I) {Y : Perfd p} (g : Y ⟶ X.obj i) :
    Cone (cofilteredLimit.baseChangeDiagram p X i g) where
  pt := pullback g (cofilteredLimit.π p X hX i)
  π := { app := fun a ↦
           pullback.map _ _ _ _ (𝟙 Y) (cofilteredLimit.π p X hX a.left) (𝟙 _)
             (by simp) (by sorry)
         naturality := by sorry }

/-- ECD 6.4(ii): base change of the limit, including qcqs sources. -/
def cofilteredLimit.baseChange (i : I) {Y : Perfd p} (g : Y ⟶ X.obj i)
    (hY : CompactSpace (underlyingPoints p Y) ∧ QuasiSeparatedSpace (underlyingPoints p Y)) :
    IsLimit (cofilteredLimit.baseChangeCone p X hX i g) := sorry

def cofilteredLimit.baseChangeHomeomorph (i : I) {Y : Perfd p} (g : Y ⟶ X.obj i)
    (hY : CompactSpace (underlyingPoints p Y) ∧ QuasiSeparatedSpace (underlyingPoints p Y)) :
    underlyingPoints p (pullback g (cofilteredLimit.π p X hX i)) ≃ₜ
      {s : ∀ a : Over i, underlyingPoints p ((cofilteredLimit.baseChangeDiagram p X i g).obj a) //
        ∀ (a b : Over i) (f : a ⟶ b),
          pointMap p ((cofilteredLimit.baseChangeDiagram p X i g).map f) (s a) = s b} := sorry

-- Check: baseChange_identity
example (i : I) : Nonempty
    (pullback (𝟙 (X.obj i)) (cofilteredLimit.π p X hX i) ≅ cofilteredLimit p X hX) := sorry
-- Check: baseChange_empty
example (i : I) (Y : Perfd p) [IsEmpty (underlyingPoints p Y)] (g : Y ⟶ X.obj i) :
    IsEmpty (underlyingPoints p (cofilteredLimit.baseChangeCone p X hX i g).pt) := sorry
-- Check: baseChange_split
example (i : I) : Nonempty
    (pullback (coprod.desc (𝟙 (X.obj i)) (𝟙 (X.obj i))) (cofilteredLimit.π p X hX i) ≅
      cofilteredLimit p X hX ⨿ cofilteredLimit p X hX) := sorry

/-! ### P5/limit-restriction-to-rational-subsets -/

/-- Rational restriction is the base-change cone of the rational open immersion. -/
def cofilteredLimit.restrictRational (i : I) (R : PairCat.{0} p)
    (e : X.obj i ≅ ofPair p R) (U : RationalOpen p R) :
    IsLimit (cofilteredLimit.baseChangeCone p X hX i
      ((spaFunctor p).map (rationalMap p R U).op ≫ e.inv)) := sorry

/-! ### P5/descent-of-quasicompact-opens -/

/-- All finite systems of qc-open inclusions descend to one common stage. -/
theorem cofilteredLimit.qcOpen_descent (U : Set (underlyingPoints p (cofilteredLimit p X hX)))
    (hU : IsOpen U ∧ IsCompact U) :
    ∃ (i : I) (V : Set (underlyingPoints p (X.obj i))), IsOpen V ∧ IsCompact V ∧
      U = pointMap p (cofilteredLimit.π p X hX i) ⁻¹' V := sorry

/-! ### P5/limit-cardinal-bounds -/

/-- ECD 6.4: a uniform stage bound is required even at a singular strong limit. -/
theorem cofilteredLimit.card_lt (κ κ' : Cardinal.{1})
    (hκ : κ.IsStrongLimit) (hω : Cardinal.aleph0 < κ)
    (hκ' : κ'.IsStrongLimit) (hlt : κ' < κ)
    (hI : Cardinal.lift.{1} (Cardinal.mk (Σ i j : I, i ⟶ j)) < κ)
    (hR : ∀ i, Cardinal.mk (globalSections p (X.obj i)) < κ') :
    Cardinal.mk (globalSections p (cofilteredLimit p X hX)) < κ ∧
    Cardinal.mk (globalPlus p (cofilteredLimit p X hX)) < κ ∧
    Cardinal.mk (underlyingPoints p (cofilteredLimit p X hX)) < κ ∧
    ∀ U : TopologicalSpace.Opens (underlyingPoints p (cofilteredLimit p X hX)),
      IsAffinoidPerfectoid p (restrict p (cofilteredLimit p X hX) U).obj →
      Cardinal.mk (globalSections p (restrict p (cofilteredLimit p X hX) U)) < κ := sorry
end PerfectoidSpace

/-! ### Layer 5: Cospan morphisms and coherent uniqueness -/
namespace CategoryTheory
universe v u w
variable {J : Type u} [SmallCategory J] [hJ : IsFiltered J]
  (F : Pseudofunctor (LocallyDiscrete J) Cat.{v, w})
namespace FilteredTwoColimit

/-- A finite-stage representative of a morphism between two tagged objects. -/
structure HomRepresentative {i j : J} (x : F.obj ⟨i⟩) (y : F.obj ⟨j⟩) where
  stage : J
  left : i ⟶ stage
  right : j ⟶ stage
  hom : (F.map ⟨left⟩).toFunctor.obj x ⟶ (F.map ⟨right⟩).toFunctor.obj y

/-- Transport includes the pseudofunctor's composition comparison on both ends. -/
def HomRepresentative.transport {i j : J} {x : F.obj ⟨i⟩} {y : F.obj ⟨j⟩}
    (r : HomRepresentative F x y) {k : J} (a : r.stage ⟶ k) :
    (F.map ⟨r.left ≫ a⟩).toFunctor.obj x ⟶ (F.map ⟨r.right ≫ a⟩).toFunctor.obj y :=
  (F.mapComp r.left.toLoc a.toLoc).hom.toNatTrans.app x ≫
    (F.map ⟨a⟩).toFunctor.map r.hom ≫ (F.mapComp r.right.toLoc a.toLoc).inv.toNatTrans.app y

/-- Two representatives agree after a common refinement of both cospans. -/
def HomRepresentative.Rel {i j : J} {x : F.obj ⟨i⟩} {y : F.obj ⟨j⟩}
    (r s : HomRepresentative F x y) : Prop :=
  ∃ (k : J) (a : r.stage ⟶ k) (b : s.stage ⟶ k),
    r.left ≫ a = s.left ≫ b ∧ r.right ≫ a = s.right ≫ b ∧
      HEq (r.transport F a) (s.transport F b)

def homEquiv {J : Type u} [SmallCategory J] [IsFiltered J]
    (F : Pseudofunctor (LocallyDiscrete J) Cat.{v, w}) {i j : J} (x : F.obj ⟨i⟩) (y : F.obj ⟨j⟩) :
    ((ι F i).obj x ⟶ (ι F j).obj y) ≃ Quot (HomRepresentative.Rel F (x := x) (y := y)) := sorry

/-- The comparison data must respect transport; arbitrary isomorphisms do not suffice. -/
theorem descUniqueIso {C : Type w} [Category.{v} C]
    (G : Pseudofunctor.StrongTrans F ((Functor.const J).obj (Cat.of C)).toPseudofunctor')
    (H : FilteredTwoColimit F ⥤ C)
    (α : ∀ i, ι F i ⋙ H ≅ (G.app ⟨i⟩).toFunctor)
    (hα : ∀ (i j : J) (a : i ⟶ j) (x : F.obj ⟨i⟩),
      H.map ((ιCompIso F a).hom.app x) ≫ (α i).hom.app x =
        (α j).hom.app ((F.map ⟨a⟩).toFunctor.obj x) ≫
          (G.naturality ⟨a⟩).hom.toNatTrans.app x) :
    ∃! e : H ≅ desc F G, ∀ (i : J) (x : F.obj ⟨i⟩),
      e.hom.app ((ι F i).obj x) ≫ (ιCompDescIso F G i).hom.app x = (α i).hom.app x := sorry

/-- Restriction of a pseudofunctor along an ordinary functor. -/
def reindex {J' : Type u} [SmallCategory J'] (G : J' ⥤ J) :
    Pseudofunctor (LocallyDiscrete J') Cat.{v, w} where
  obj j := F.obj ⟨G.obj j.as⟩
  map a := F.map ⟨G.map a.as⟩
  map₂ := by sorry
  map₂_id := by sorry
  map₂_comp := by sorry
  mapId := by sorry
  mapComp := by sorry
  map₂_whisker_left := by sorry
  map₂_whisker_right := by sorry
  map₂_associator := by sorry
  map₂_left_unitor := by sorry
  map₂_right_unitor := by sorry

def equivOfFinal {J' : Type u} [SmallCategory J'] [IsFiltered J']
    (G : J' ⥤ J) [G.Final] : FilteredTwoColimit (reindex F G) ≌ FilteredTwoColimit F := sorry

def equivOfFinal_ι {J' : Type u} [SmallCategory J'] [IsFiltered J']
    (G : J' ⥤ J) [G.Final] (j : J') :
    ι (reindex F G) j ⋙ (equivOfFinal F G).functor ≅ ι F (G.obj j) := sorry

-- Check: cospan_constant_empty_hom
example (i : J) :
    let F := ((Functor.const J).obj (Cat.of (Discrete Bool))).toPseudofunctor'
    IsEmpty (Quot (HomRepresentative.Rel F (x := Discrete.mk false) (y := Discrete.mk true)
      (i := i) (j := i))) := sorry
-- Check: cospan_constant_identity
include hJ in
example (i j : J) :
    let F := ((Functor.const J).obj (Cat.of (Discrete PUnit))).toPseudofunctor'
    Unique (Quot (HomRepresentative.Rel F (x := Discrete.mk PUnit.unit)
      (y := Discrete.mk PUnit.unit) (i := i) (j := j))) := sorry
-- Check: cospan_constant_automorphisms
include hJ in
example (C : Type w) [Category.{v} C] (i : J) (x y : C) :
    Nonempty (Quot (HomRepresentative.Rel
      (((Functor.const J).obj (Cat.of C)).toPseudofunctor') (x := x) (y := y)
      (i := i) (j := i)) ≃ (x ⟶ y)) := sorry
end FilteredTwoColimit
end CategoryTheory

/-! ### Layer 5: Fullness with canonical pullback comparisons -/
namespace PerfectoidSpace
open Perfectoid TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime] {I : Type} [SmallCategory I] [hI : IsCofiltered I]
  (X : I ⥤ Perfd p) (hX : ∀ i, IsAffinoidPerfectoid p (X.obj i).obj)

/-- The comparison between an iterated pullback and pullback to the limit. -/
def finiteStagePullbackIso {i j : I} (a : j ⟶ i) (Y : smallEtale p (X.obj i)) :
    (etaleBaseChange p (cofilteredLimit.π p X hX j)).obj
      ((etaleBaseChange p (X.map a)).obj Y) ≅
    (etaleBaseChange p (cofilteredLimit.π p X hX i)).obj Y := sorry

theorem finiteStagePullbackIso_fst {i j : I} (a : j ⟶ i) (Y : smallEtale p (X.obj i)) :
    (finiteStagePullbackIso p X hX a Y).hom.hom.left ≫
      pullback.fst Y.obj.hom (cofilteredLimit.π p X hX i) =
    pullback.fst (pullback.snd Y.obj.hom (X.map a)) (cofilteredLimit.π p X hX j) ≫
      pullback.fst Y.obj.hom (X.map a) := sorry

/-! ### P5/finite-stage-fullness -/

/-- ECD 6.4(ii): the specified morphism, not just its isomorphism class, descends. -/
theorem finiteStage_fullness (i : I) (Y Z : smallEtale p (X.obj i))
    (hY : QuasiCompact p Y.obj.hom ∧ QuasiSeparated p Y.obj.hom)
    (hZ : QuasiCompact p Z.obj.hom ∧ QuasiSeparated p Z.obj.hom)
    (f : (etaleBaseChange p (cofilteredLimit.π p X hX i)).obj Y ⟶
      (etaleBaseChange p (cofilteredLimit.π p X hX i)).obj Z) :
    ∃ (j : I) (a : j ⟶ i)
      (g : (etaleBaseChange p (X.map a)).obj Y ⟶ (etaleBaseChange p (X.map a)).obj Z),
      (finiteStagePullbackIso p X hX a Y).inv ≫
        (etaleBaseChange p (cofilteredLimit.π p X hX j)).map g ≫
        (finiteStagePullbackIso p X hX a Z).hom = f := sorry

-- Check: finiteStage_identity_detection
example (R : PairCat.{0} p) (i : I) (Y Z : smallEtale p (ofPair p R)) (f : Y ⟶ Z) :
    let D := (Functor.const I).obj (ofPair p R)
    let hD : ∀ i, IsAffinoidPerfectoid p (D.obj i).obj := fun _ ↦ ⟨R, ⟨Iso.refl _⟩⟩
    IsIso ((etaleBaseChange p (cofilteredLimit.π p D hD i)).map f) ↔ IsIso f := sorry
-- Check: finiteStage_empty_detection
example (i : I) (Y Z : smallEtale p (X.obj i))
    [IsEmpty (underlyingPoints p Y.obj.left)] [Nonempty (underlyingPoints p Z.obj.left)]
    (f : Y ⟶ Z) : ¬ Function.Surjective (pointMap p f.hom.left) := by
  intro h
  obtain ⟨z⟩ := ‹Nonempty (underlyingPoints p Z.obj.left)›
  obtain ⟨y, _⟩ := h z
  exact isEmptyElim y
end PerfectoidSpace

/-! ### Layer 5: Profinite computations and the ring-space comparison -/
namespace Perfectoid
universe u
variable (p : ℕ) [Fact p.Prime]

/-- Continuous functions on a profinite space, with the uniform topology and pointwise plus ring. -/
def continuousFunctionPair (S : Type u) [TopologicalSpace S] [CompactSpace S] [T2Space S]
    [TotallyDisconnectedSpace S] (R : PairCat.{u} p) : PairCat.{u} p := by
  letI : IsUniformAddGroup C(S, R) := by sorry
  letI : IsTateRing C(S, R) := by sorry
  letI : IsPerfectoidTateRing p C(S, R) := by sorry
  exact { carrier := C(S, R)
          pair := ⟨{ carrier := {f | ∀ s, f s ∈ R.pair.plus}
                     zero_mem' := by sorry
                     one_mem' := by sorry
                     add_mem' := by sorry
                     mul_mem' := by sorry
                     neg_mem' := by sorry }, by sorry⟩ }

instance continuousFunctionPair_coeFun (S : Type u) [TopologicalSpace S] [CompactSpace S]
    [T2Space S] [TotallyDisconnectedSpace S] (R : PairCat.{u} p) :
    CoeFun (continuousFunctionPair p S R) (fun _ ↦ S → R) where
  coe f := (show C(S, R) from f)

-- Check: continuousFunctions_empty
example (R : PairCat.{u} p) : Subsingleton (continuousFunctionPair p PEmpty.{u+1} R) := sorry
-- Check: continuousFunctions_point
example (R : PairCat.{u} p) :
    Function.Bijective (fun f : continuousFunctionPair p PUnit.{u+1} R ↦ f PUnit.unit) := sorry
-- Check: continuousFunctions_two_points
example (R : PairCat.{0} p) :
    Function.Bijective (fun f : continuousFunctionPair p Bool R ↦ (f false, f true)) := sorry

/-- Binary cylinder functions, with transition by forgetting the last coordinates. -/
def binaryFunctionDiagram (R : PairCat.{0} p) : ℕ ⥤ PairCat.{0} p where
  obj n := continuousFunctionPair p (Fin n → Bool) R
  map f := { toRingHom := by sorry
             continuous_toRingHom := by sorry
             map_mem_plus := by sorry }
  map_id := by sorry
  map_comp := by sorry

instance binaryFunctionDiagram_coeFun (R : PairCat.{0} p) (n : ℕ) :
    CoeFun ((binaryFunctionDiagram p R).obj n) (fun _ ↦ (Fin n → Bool) → R) where
  coe f := (show C((Fin n → Bool), R) from f)

theorem binaryFunctionDiagram_map (R : PairCat.{0} p) {n m : ℕ} (a : n ⟶ m)
    (f : (binaryFunctionDiagram p R).obj n) (s : Fin m → Bool) :
    ((binaryFunctionDiagram p R).map a).toRingHom f s =
      f (fun i ↦ s (Fin.castLE (leOfHom a) i)) := sorry

/-- ECD 6.5 and Sch13 4.6: the completion adds all continuous functions. -/
def binaryFunctionEquiv (R : PairCat.{0} p)
    (π : PseudoUniformizerRoots p ((binaryFunctionDiagram p R).obj 0)) :
    completedColimitPair p (binaryFunctionDiagram p R) 0 π ≅
      continuousFunctionPair p (ℕ → Bool) R := sorry

theorem binaryFunctionEquiv_ι (R : PairCat.{0} p)
    (π : PseudoUniformizerRoots p ((binaryFunctionDiagram p R).obj 0))
    (n : ℕ) (f : (binaryFunctionDiagram p R).obj n) (s : ℕ → Bool) :
    (binaryFunctionEquiv p R π).hom.toRingHom
      ((completedColimit.ι p (binaryFunctionDiagram p R) 0 π n).toRingHom f) s =
        f (fun i ↦ s i) := sorry

-- Check: completedColimit_test_profinite
example (R : PairCat.{0} p) [Nontrivial R]
    (π : PseudoUniformizerRoots p ((binaryFunctionDiagram p R).obj 0)) :
    let f : (binaryFunctionDiagram p R).obj 1 :=
      (⟨fun s ↦ if s 0 then 1 else 0, by continuity⟩ : C((Fin 1 → Bool), R))
    let e := (completedColimit.ι p (binaryFunctionDiagram p R) 0 π 1).toRingHom f
    e * e = e ∧ e ≠ 0 ∧ e ≠ 1 ∧
      (binaryFunctionEquiv p R π).hom.toRingHom e (fun _ ↦ false) = 0 ∧
      (binaryFunctionEquiv p R π).hom.toRingHom e (fun _ ↦ true) = 1 := sorry

-- Check: binaryFunctions_zero_coordinates
example (R : PairCat.{0} p) : Function.Bijective
    (fun f : (binaryFunctionDiagram p R).obj 0 ↦ f (fun i ↦ Fin.elim0 i)) := sorry
-- Check: binaryFunctions_one_coordinate
example (R : PairCat.{0} p) : Function.Bijective
    (fun f : (binaryFunctionDiagram p R).obj 1 ↦ (f (fun _ ↦ false), f (fun _ ↦ true))) := sorry
-- Check: binaryFunctions_two_terms
example (R : PairCat.{0} p) (f : (binaryFunctionDiagram p R).obj 1) (s : Fin 2 → Bool) :
    ((binaryFunctionDiagram p R).map (homOfLE (show 1 ≤ 2 by decide))).toRingHom f s =
      f (fun _ ↦ s 0) := sorry

-- Check: completedColimit_test_uncompleted
example (R : PairCat.{0} p) [Nontrivial R] :
    ∃ f : continuousFunctionPair p (ℕ → Bool) R,
      ∀ n, ¬ ∃ g : (binaryFunctionDiagram p R).obj n,
        ∀ s : ℕ → Bool, f s = g (fun i ↦ s i) := sorry

-- Check: completedColimit_test_plusQuotient
example (R : PairCat.{0} p) (t : R.pair.plus)
    (ht : IsPseudoUniformizer (t : R)) (n : ℕ) (hn : 0 < n) :
    let tC : (continuousFunctionPair p (ℕ → Bool) R).pair.plus :=
      ⟨(show continuousFunctionPair p (ℕ → Bool) R from
        ContinuousMap.const (ℕ → Bool) (t : R)), fun _ ↦ t.property⟩
    (∃ e : ((continuousFunctionPair p (ℕ → Bool) R).pair.plus ⧸ Ideal.span {tC ^ n}) ≃+*
      LocallyConstant (ℕ → Bool) (R.pair.plus ⧸ Ideal.span {t ^ n}),
      ∀ (f : (continuousFunctionPair p (ℕ → Bool) R).pair.plus) (s : ℕ → Bool),
        e (Ideal.Quotient.mk _ f) s =
          Ideal.Quotient.mk (Ideal.span {t ^ n}) ⟨f.val s, f.property s⟩) ∧
    ∀ f : (continuousFunctionPair p (ℕ → Bool) R).pair.plus,
      ∃ (m : ℕ) (g : (Fin m → Bool) → R.pair.plus ⧸ Ideal.span {t ^ n}),
        ∀ s : ℕ → Bool,
          Ideal.Quotient.mk (Ideal.span {t ^ n}) ⟨f.val s, f.property s⟩ =
            g (fun i ↦ s i) := sorry
end Perfectoid

namespace PerfectoidSpace
open Perfectoid TauCetiRoadmap.AdicEtaleGeometry
