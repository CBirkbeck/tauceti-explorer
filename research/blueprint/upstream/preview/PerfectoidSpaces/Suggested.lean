namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open _root_.TauCeti.Huber
variable (p : ℕ) [Fact p.Prime]
variable {R S : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
  [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]

/-- Perfectoidness is invariant under a ring isomorphism preserving the topology in both directions. -/
theorem IsPerfectoidTateRing.of_ringEquiv [IsPerfectoidTateRing p R]
    (e : R ≃+* S) (he : Continuous e) (hi : Continuous e.symm) :
    IsPerfectoidTateRing p S := sorry

variable [IsPerfectoidTateRing p R] [IsPerfectoidTateRing p S]
namespace tilt
/-- Apply a topological ring isomorphism to every coordinate of a compatible root sequence. -/
def mapEquiv (e : R ≃+* S) (he : Continuous e) (hi : Continuous e.symm) :
    tilt p R ≃+* tilt p S :=
  { map p e.toRingHom he with
    invFun := map p e.symm.toRingHom hi
    left_inv := by sorry
    right_inv := by sorry }

theorem mapEquiv_coeff (e : R ≃+* S) (he : Continuous e) (hi : Continuous e.symm)
    (x : tilt p R) (n : ℕ) : coeff n (mapEquiv p e he hi x) = e (coeff n x) := sorry

theorem mapEquiv_continuous (e : R ≃+* S) (he : Continuous e) (hi : Continuous e.symm) :
    Continuous (mapEquiv p e he hi) ∧ Continuous (mapEquiv p e he hi).symm := sorry

-- Check: mapEquiv_identity
example : mapEquiv p (RingEquiv.refl R) continuous_id continuous_id = RingEquiv.refl _ := sorry
-- Check: mapEquiv_swap
example (x : tilt p (R × R)) (n : ℕ) :
    coeff n (mapEquiv p (RingEquiv.prodComm : R × R ≃+* R × R) continuous_swap continuous_swap x) =
      ((coeff n x).2, (coeff n x).1) := sorry
-- Check: mapEquiv_charP
example [CharP R p] [CharP S p] (e : R ≃+* S) (he : Continuous e)
    (hi : Continuous e.symm) (x : tilt p R) :
    equivOfCharP (mapEquiv p e he hi x) = e (equivOfCharP x) := sorry
end tilt

end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
end

