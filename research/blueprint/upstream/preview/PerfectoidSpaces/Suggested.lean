/-- At cofinality ω₁, small Gauss discs need not have a small disjoint union.
The component inclusions give the cover in ECD Proposition 4.4, pp. 20–21. -/
theorem not_isKappaSmall_gaussDisc_sigma
    (L : AffinoidField p) [CharP L p] {κ : Cardinal.{0}}
    (hκ : κ.IsStrongLimit) (hcf : κ.ord.cof = Cardinal.aleph.{0} 1)
    (hκ₁ : Cardinal.aleph.{0} 1 < κ) (hL : #L < κ)
    (J : (Cardinal.aleph.{0} 1).ord.ToType → Type)
    (hJ : ∀ i, ℵ₀ ≤ #(J i) ∧ #(J i) < κ)
    (hcofinal : ∀ μ < κ, ∃ i, μ < #(J i)) :
    ∃ π : ∀ i, PseudoUniformizerRoots p (gaussPerfectoidField p L (J i)).field,
      let R := fun i ↦ discPair p (gaussPerfectoidField p L (J i)).field (π i)
      let X := ∐ fun i ↦ ofPair p (R i)
      Cardinal.lift.{1} #((Cardinal.aleph.{0} 1).ord.ToType) < Cardinal.lift.{1} κ ∧
      (∀ i, #(R i) < κ ∧ IsOpenImmersion p (Sigma.ι (fun j ↦ ofPair p (R j)) i)) ∧
      (∀ x : underlyingPoints p X,
        ∃ i, x ∈ Set.range (pointMap p (Sigma.ι (fun j ↦ ofPair p (R j)) i))) ∧
      Cardinal.lift.{1} κ ≤ #(underlyingPoints p X) ∧
      ¬ IsKappaSmall p (Cardinal.lift.{1} κ) X := sorry

