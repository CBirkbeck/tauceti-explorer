/-- Density after inverting the adic element, for the topology with the specified integral basis. -/
theorem adicCompletion_localized_density (A : Type u) [CommRing A] (t : A)
    (ht : t ∈ nonZeroDivisors A)
    [TopologicalSpace (Localization.Away (algebraMap A (AdicCompletion (Ideal.span {t}) A) t))]
    [IsTopologicalRing (Localization.Away (algebraMap A (AdicCompletion (Ideal.span {t}) A) t))]
    (f : Localization.Away t →+*
      Localization.Away (algebraMap A (AdicCompletion (Ideal.span {t}) A) t))
    (hf : ∀ x : A, f (algebraMap A _ x) =
      algebraMap (AdicCompletion (Ideal.span {t}) A) _ (algebraMap A _ x))
    (hbase : (𝓝 (0 : Localization.Away (algebraMap A (AdicCompletion (Ideal.span {t}) A) t))).HasBasis
      (fun n : ℕ ↦ 0 ≤ n)
      (fun n ↦ {x | ∃ b : AdicCompletion (Ideal.span {t}) A,
        x = algebraMap (AdicCompletion (Ideal.span {t}) A) _
          ((algebraMap A (AdicCompletion (Ideal.span {t}) A) t) ^ n * b)})) :
    DenseRange f := sorry
