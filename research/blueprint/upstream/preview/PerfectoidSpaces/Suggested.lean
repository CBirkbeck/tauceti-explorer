end FieldComparisons

section UniformTiltTopology
variable (p : ℕ) [Fact p.Prime] {B : Type u} [CommRing B] [UniformSpace B]
  [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B] [CompleteSpace B] [T2Space B]
  [Fact (IsBounded (powerBoundedSubring B : Set B))]
  [Fact (IsTopologicallyNilpotent (p : B))]
namespace uniformTilt
/-- Reduction is a homeomorphism when the chosen ideal defines the integral topology. -/
theorem plusEquiv_topology (P : Pair B) (I : Ideal P.plus) [IsAdicComplete I P.plus]
    [CharP (P.plus ⧸ I) p] (hI : IsAdic I) :
    letI : TopologicalSpace (P.plus ⧸ I) := ⊥
    letI : TopologicalSpace (Perfection (P.plus ⧸ I) p) :=
      inferInstanceAs (TopologicalSpace {f : ℕ → P.plus ⧸ I // ∀ n, f (n + 1) ^ p = f n})
    Continuous (plusEquiv (p := p) P I) ∧ Continuous (plusEquiv (p := p) P I).symm := sorry

/-- A continuous map from a perfectoid Tate ring supplies compatible small units. -/
theorem isPerfectoidTateRing_of_hom {A : Type u} [CommRing A] [UniformSpace A]
    [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A] [CompleteSpace A] [T2Space A]
    [IsPerfectoidTateRing p A] (f : A →+* B) (hf : Continuous f) :
    ∃ h : IsTateRing (uniformTilt p B), letI := h; IsPerfectoidTateRing p (uniformTilt p B) := sorry

/-- A closed perfect subring containing a small unit and its inverse is perfectoid. -/
theorem isPerfectoidTateRing_closure (ϖ : PseudoUniformizerRoots p B)
    {A : Type u} [CommRing A] [CharP A p] [PerfectRing A p]
    (f : A →+* uniformTilt p B)
    (hr : (show uniformTilt p B from ϖ.roots) ∈ f.range)
    (hi : ∃ y ∈ f.range, (show uniformTilt p B from ϖ.roots) * y = 1) :
    ∃ h : IsTateRing f.range.topologicalClosure,
      letI := h
      letI : CompleteSpace f.range.topologicalClosure := sorry
      IsPerfectoidTateRing p f.range.topologicalClosure := sorry

-- Check: uniform_map_identity
example (x : uniformTilt p B) :
    map (p := p) (RingHom.id B) continuous_id (x + 1) = x + 1 ∧
      map (p := p) (RingHom.id B) continuous_id (x ^ 2) = x ^ 2 := sorry
-- Check: uniform_plus_small_inverse
example [Nontrivial B] (ϖ : PseudoUniformizerRoots p B) (P : Pair B)
    (x : uniformTilt p B) (hx : x * (show uniformTilt p B from ϖ.roots) = 1) :
    x ∉ plus (p := p) P := sorry
end uniformTilt
end UniformTiltTopology

section FontaineKernel
variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R]
/-- Berkeley 6.2.8: the Fontaine kernel has a regular primitive generator. -/
theorem tilt.theta_kernel_generator (P : Pair R) :
    ∃ ξ : WittVector p (Pair.tilt p P).plus, IsPrimitive ξ ∧
      RingHom.ker (tilt.theta p P) = Ideal.span {ξ} ∧ ξ ∈ nonZeroDivisors _ := sorry

/-- Primitive elements over the plus ring of a characteristic-`p` perfectoid Tate pair are
nonzerodivisors (Berkeley Lemma 6.2.10, p. 46; ECD Lemma 3.16, p. 17). -/
theorem IsPrimitive.mem_nonZeroDivisors [CharP R p] (P : Pair R)
    (ξ : WittVector p P.plus) (hξ : IsPrimitive ξ) : ξ ∈ nonZeroDivisors _ := sorry

/-- BMS 3.20: a ring of integral elements of a perfectoid Tate ring is integral perfectoid. -/
theorem IsIntegralPerfectoid.of_perfectoid_pair (P : Pair R) : IsIntegralPerfectoid p P.plus := sorry
end FontaineKernel

section CategoryComparisonLaws
variable (p : ℕ) [Fact p.Prime]
namespace MarkedUntilt

theorem iso_iff_primitiveIdeal_eq {P : PairCat.{u} p} (X Y : MarkedUntilt p P) :
    Nonempty (X ≅ Y) ↔ X.primitiveIdeal = Y.primitiveIdeal := sorry

theorem plusEquiv_primitiveIdeal (P : PairCat.{u} p) (hp : (p : P) = 0)
    (X : MarkedUntilt p P) :
    ((plusEquiv p P hp).functor.obj X).primitiveIdeal =
      X.primitiveIdeal.map (WittVector.map
        ((RingHom.id P).restrict P.pair.plus (powerBoundedSubring P) (by
          intro x hx
          exact P.pair.isRingOfIntegralElements.isPowerBounded_of_mem hx))) := sorry

theorem pullback_id (P : PairCat.{u} p) (hp : (p : P) = 0) (X : MarkedUntilt p P) :
    Nonempty (pullback hp (𝟙 P) X ≅ X) := sorry

theorem pullback_comp {P Q R : PairCat.{u} p} (hq : (p : Q) = 0) (hr : (p : R) = 0)
    (f : P ⟶ Q) (g : Q ⟶ R) (X : MarkedUntilt p P) :
    Nonempty (pullback hr g (pullback hq f X) ≅ pullback hr (f ≫ g) X) := sorry
end MarkedUntilt

namespace PairCat
/-- The inverse functor acts on the same localized quotient map as the triple functor. -/
theorem sliceUntiltFunctor_map (R : PairCat.{u} p)
    {X Y : Under ((tiltFunctor p).obj R)} (f : X ⟶ Y) :
    ∃ h : (sliceTriple p R X).ideal.map
        (WittVector.map (f.right.toRingHom.restrict _ _ f.right.map_mem_plus)) ≤
          (sliceTriple p R Y).ideal,
      ((sliceUntiltFunctor p R).map f).right =
        (primitiveUntiltingFunctor p).map (show sliceTriple p R X ⟶ sliceTriple p R Y from
          ⟨f.right, h⟩) := sorry
end PairCat
end CategoryComparisonLaws

section RestrictedComparison
variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R] (ϖ : PseudoUniformizerRoots p R)
namespace perfectedTateAlgebra
variable (n : ℕ)
/-- Embed the ordinary Tate algebra as the series with integral exponents. -/
def restrictedIncl : restrictedMvPowerSeriesCompletion n R →ₐ[R]
    perfectedTateAlgebra p ϖ (ULift.{u} (Fin n)) := sorry

theorem restrictedIncl_X (i : Fin n) :
    restrictedIncl p ϖ n ((weightedX (fun _ : Fin n ↦ ({1} : Set R))
      isWeightFamily_one_weight i : weightedRestrictedSubring _ _) :
        restrictedMvPowerSeriesCompletion n R) = rootX ϖ (ULift.up i) 0 := sorry

theorem restrictedIncl_isClosedEmbedding : Topology.IsClosedEmbedding (restrictedIncl p ϖ n) := sorry

/-- The continuous R-linear projection retaining exactly the integral exponents. -/
def retraction : perfectedTateAlgebra p ϖ (ULift.{u} (Fin n)) →L[R]
    restrictedMvPowerSeriesCompletion n R := sorry

theorem retraction_comp_incl : Function.LeftInverse (retraction p ϖ n) (restrictedIncl p ϖ n) := sorry

theorem retraction_fractional (d : ULift.{u} (Fin n) →₀ pPowerExponents p)
    (hd : ∃ i, ∀ m : ℕ, (d i : ℚ) ≠ m) :
    retraction p ϖ n (d.prod (fun i a ↦ X p ϖ _ i a)) = 0 := sorry

-- Check: restricted_two_monomials
example (i : Fin n) :
    retraction p ϖ n (rootX ϖ (ULift.up i) 0 + rootX ϖ (ULift.up i) 0 ^ 2) =
      ((weightedX (fun _ : Fin n ↦ ({1} : Set R)) isWeightFamily_one_weight i :
        weightedRestrictedSubring _ _) : restrictedMvPowerSeriesCompletion n R) +
      ((weightedX (fun _ : Fin n ↦ ({1} : Set R)) isWeightFamily_one_weight i :
        weightedRestrictedSubring _ _) : restrictedMvPowerSeriesCompletion n R) ^ 2 := sorry
-- Check: restricted_fractional_root
example (i : Fin n) : retraction p ϖ n (rootX ϖ (ULift.up i) 1) = 0 := sorry
-- Check: restricted_empty
example : Function.Bijective (restrictedIncl p ϖ 0) ∧ Function.Bijective (retraction p ϖ 0) := sorry
-- Check: restricted_not_surjective
example [Nontrivial R] (i : Fin n) : rootX ϖ (ULift.up i) 1 ∉ Set.range (restrictedIncl p ϖ n) := sorry

variable {σ σ' σ'' : Type u}
theorem continuous_mapIndex (g : σ → σ') : Continuous (mapIndex ϖ g) := sorry

theorem mapIndex_id : mapIndex ϖ (id : σ → σ) = AlgHom.id R _ := sorry

theorem mapIndex_comp (f : σ → σ') (g : σ' → σ'') :
    mapIndex ϖ (g ∘ f) = (mapIndex ϖ g).comp (mapIndex ϖ f) := sorry

theorem continuous_algebraMap : Continuous (algebraMap R (perfectedTateAlgebra p ϖ σ)) := sorry

variable {S : Type u} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
  [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S]
/-- Evaluation at a family of integral tilted elements. -/
def liftTilt (f : R →+* S) (hf : Continuous f)
    (x : σ → powerBoundedSubring (tilt p S)) : perfectedTateAlgebra p ϖ σ →+* S := sorry

theorem liftTilt_spec (f : R →+* S) (hf : Continuous f)
    (x : σ → powerBoundedSubring (tilt p S)) :
    Continuous (liftTilt p ϖ f hf x) ∧ (liftTilt p ϖ f hf x).comp (algebraMap R _) = f ∧
    ∀ s m, liftTilt p ϖ f hf x (rootX ϖ s m) = tilt.coeff m (x s).val := sorry

-- Check: liftTilt_ones
example (s : σ) : liftTilt p ϖ (RingHom.id R) continuous_id (fun _ : σ ↦ 1)
    (rootX ϖ s 0 + rootX ϖ s 1) = 2 := sorry
-- Check: liftTilt_zeroes
example (s : σ) : liftTilt p ϖ (RingHom.id R) continuous_id (fun _ : σ ↦ 0)
    (rootX ϖ s 0 + 1) = 1 := sorry
-- Check: liftTilt_small_unit
example (s : σ) :
    liftTilt p ϖ (RingHom.id R) continuous_id (fun _ : σ ↦ ⟨ϖ.toTilt, sorry⟩)
      (rootX ϖ s 0) = ϖ.root 0 ∧
    liftTilt p ϖ (RingHom.id R) continuous_id (fun _ : σ ↦ ⟨ϖ.toTilt, sorry⟩)
      (rootX ϖ s 1) = ϖ.root 1 := sorry
end perfectedTateAlgebra
end RestrictedComparison

section FieldAlmostCategories
variable {V : Type u} [CommRing V]

/-- Kernel and cokernel annihilation for a possibly semilinear ring map. -/
def IsAlmostBijective {A B : Type u} [CommRing A] [CommRing B]
    [Algebra V A] [Algebra V B] (m : Ideal V) (f : A →+* B) : Prop :=
  (∀ x, f x = 0 → ∀ ε ∈ m, ε • x = 0) ∧
  ∀ y : B, ∀ ε ∈ m, ∃ x : A, f x = ε • y

-- Check: almost_frobenius_classical
example {A B : Type u} [CommRing A] [CommRing B] [Algebra V A] [Algebra V B]
    (f : A →+* B) : IsAlmostBijective (⊤ : Ideal V) f ↔ Function.Bijective f := sorry
-- Check: almost_frobenius_zero_ideal
example {A B : Type u} [CommRing A] [CommRing B] [Algebra V A] [Algebra V B]
    (f : A →+* B) : IsAlmostBijective (⊥ : Ideal V) f := sorry
-- Check: almost_frobenius_identity
example (m : Ideal V) : IsAlmostBijective m (RingHom.id V) := sorry

variable (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R]
  (ϖ : PseudoUniformizerRoots p R)

/-- Scholze Definition 5.1(ii), expressed on the canonical algebra of almost elements. -/
def IsIntegralAlmostPerfectoid (A : Almost.Algebra (almostSetup p R)) : Prop :=
  let E := (Almost.Algebra.elements (almostSetup p R)).obj A
  Almost.Module.Flat (almostSetup p R) A.X ∧
  IsAdicComplete (Ideal.span {(algebraMap (powerBoundedSubring R) E (ϖ.rootPB 0))}) E ∧
  IsAlmostBijective (almostSetup p R).ideal
    (frobeniusModPow p (algebraMap (powerBoundedSubring R) E (ϖ.rootPB 1)) (by sorry))

abbrev IntegralAlmostPerfectoid := ObjectProperty.FullSubcategory
  (IsIntegralAlmostPerfectoid p R ϖ)

/-- The reduction uses the base-changed almost setup, hence flatness over `R°/ϖ`. -/
abbrev modVarpiSetup := (almostSetup p R).baseChange
  (powerBoundedSubring R ⧸ Ideal.span {ϖ.rootPB 0})

/-- Scholze Definition 5.1(iii); Frobenius is a ring map, with its scalar twist retained. -/
def IsModAlmostPerfectoid (A : Almost.Algebra (modVarpiSetup p R ϖ)) : Prop :=
  let Q := powerBoundedSubring R ⧸ Ideal.span {ϖ.rootPB 0}
  let E := (Almost.Algebra.elements (modVarpiSetup p R ϖ)).obj A
  Almost.Module.Flat (modVarpiSetup p R ϖ) A.X ∧
  IsAlmostBijective (modVarpiSetup p R ϖ).ideal
    (frobeniusQuot p
      (Ideal.span {(algebraMap Q E (Ideal.Quotient.mk _ (ϖ.rootPB 1)))})
      (⊥ : Ideal E) (by sorry) (by sorry))

abbrev ModAlmostPerfectoid := ObjectProperty.FullSubcategory (IsModAlmostPerfectoid p R ϖ)

section FieldReduction
variable (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K]
  [CompleteSpace K] [IsPerfectoidField p K] (ϖ : PseudoUniformizerRoots p K)

/-- Reduction followed by almostification over the quotient base. -/
def almostReductionFunctor : IntegralAlmostPerfectoid p K ϖ ⥤ ModAlmostPerfectoid p K ϖ := sorry

theorem almostReductionFunctor_obj (A : IntegralAlmostPerfectoid p K ϖ) :
    let E := (Almost.Algebra.elements (almostSetup p K)).obj A.obj
    let Q := powerBoundedSubring K ⧸ Ideal.span {ϖ.rootPB 0}
    let B := E ⧸ Ideal.span {(algebraMap (powerBoundedSubring K) E (ϖ.rootPB 0))}
    letI : Algebra Q B := (Ideal.Quotient.lift _
      ((Ideal.Quotient.mk _).comp (algebraMap (powerBoundedSubring K) E)) (by sorry)).toAlgebra
    Nonempty (((almostReductionFunctor p K ϖ).obj A).obj ≅
      (Almost.Algebra.toAlmost (modVarpiSetup p K ϖ)).obj (CommAlgCat.of Q B)) := sorry

/-- Reduction carries every algebra map to the induced quotient map, under one
family of object comparisons; Scholze Theorem 5.10, p. 24. -/
theorem almostReductionFunctor_map :
    let E := fun A : IntegralAlmostPerfectoid p K ϖ ↦
      (Almost.Algebra.elements (almostSetup p K)).obj A.obj
    let Q := powerBoundedSubring K ⧸ Ideal.span {ϖ.rootPB 0}
    let I := fun A : IntegralAlmostPerfectoid p K ϖ ↦
      Ideal.span {(algebraMap (powerBoundedSubring K) (E A) (ϖ.rootPB 0))}
    let B := fun A : IntegralAlmostPerfectoid p K ϖ ↦ E A ⧸ I A
    letI : ∀ A, Algebra Q (B A) := fun A ↦ (Ideal.Quotient.lift _
      ((Ideal.Quotient.mk (I A)).comp (algebraMap (powerBoundedSubring K) (E A)))
      (by sorry)).toAlgebra
    ∃ e : ∀ A, ((almostReductionFunctor p K ϖ).obj A).obj ≅
        (Almost.Algebra.toAlmost (modVarpiSetup p K ϖ)).obj (CommAlgCat.of Q (B A)),
      ∀ (A A' : IntegralAlmostPerfectoid p K ϖ) (f : A ⟶ A'),
        let g : B A →ₐ[Q] B A' :=
          { Ideal.quotientMap (I A')
              ((Almost.Algebra.elements (almostSetup p K)).map f.hom).hom.toRingHom
              (by sorry) with
            commutes' := by sorry }
        ((almostReductionFunctor p K ϖ).map f).hom ≫ (e A').hom =
          (e A).hom ≫ (Almost.Algebra.toAlmost (modVarpiSetup p K ϖ)).map
            (CommAlgCat.ofHom g) := sorry

/-! ### P1/deformation-lifting-of-perfectoid-mod-varpi-algebras -/

/-- Flat deformation over a perfectoid field, Scholze Theorem 5.10 (p. 24, proof p. 26).
Lemma 5.3(i) supplies flatness from absence of ϖ-torsion over the valuation ring K°. -/
def almostReductionEquivalence : IntegralAlmostPerfectoid p K ϖ ≌ ModAlmostPerfectoid p K ϖ where
  functor := almostReductionFunctor p K ϖ
  inverse := sorry
  unitIso := sorry
  counitIso := sorry
  functor_unitIso_comp := sorry

end FieldReduction

/-! ### P1/cotangent-complex-vanishing-mod-varpi -/

/-- Almost flatness and the relative Frobenius condition imply derived vanishing
in the mod-ϖ setting; the field case is Scholze Corollary 5.16. -/
theorem almost_mod_cotangent_vanishes (A : ModAlmostPerfectoid p R ϖ)
    (f : (Almost.Algebra.toAlmost (modVarpiSetup p R ϖ)).obj
      (CommAlgCat.of (powerBoundedSubring R ⧸ Ideal.span {ϖ.rootPB 0})
        (powerBoundedSubring R ⧸ Ideal.span {ϖ.rootPB 0})) ⟶ A.obj) :
    IsZero (Almost.almostCotangentComplex (modVarpiSetup p R ϖ) f) := sorry

section Field
variable (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K]
  [CompleteSpace K] [IsPerfectoidField p K] (ϖ : PseudoUniformizerRoots p K)

/-- Perfectoid algebras with their maximal integral subring. -/
abbrev FieldAlgebras := ObjectProperty.FullSubcategory
  (fun X : Under (show PairCat p from ⟨K, Pair.powerBounded K⟩) ↦
    X.right.pair.plus = powerBoundedSubring X.right)

/-- The integral almost algebra of a perfectoid field algebra. -/
def fieldIntegralFunctor : FieldAlgebras p K ⥤ IntegralAlmostPerfectoid p K ϖ := sorry

theorem fieldIntegralFunctor_obj (X : FieldAlgebras p K) :
    letI := (X.obj.hom.toRingHom.restrict (powerBoundedSubring K)
      (powerBoundedSubring X.obj.right) (by sorry)).toAlgebra
    Nonempty (((fieldIntegralFunctor p K ϖ).obj X).obj ≅
      (Almost.Algebra.toAlmost (almostSetup p K)).obj
        (CommAlgCat.of (powerBoundedSubring K) (powerBoundedSubring X.obj.right))) := sorry

/-- The integral functor carries a continuous algebra map to its restriction on
power-bounded elements and then almostifies; Scholze Definition 5.1 and Proposition 5.5,
pp. 21–23. The comparison family is simultaneous for all objects and maps. -/
theorem fieldIntegralFunctor_map :
    letI : ∀ X : FieldAlgebras p K,
        Algebra (powerBoundedSubring K) (powerBoundedSubring X.obj.right) := fun X ↦
      (X.obj.hom.toRingHom.restrict (powerBoundedSubring K)
        (powerBoundedSubring X.obj.right) (by sorry)).toAlgebra
    ∃ e : ∀ X : FieldAlgebras p K, ((fieldIntegralFunctor p K ϖ).obj X).obj ≅
        (Almost.Algebra.toAlmost (almostSetup p K)).obj
          (CommAlgCat.of (powerBoundedSubring K) (powerBoundedSubring X.obj.right)),
      ∀ (X Y : FieldAlgebras p K) (f : X ⟶ Y),
        let g : powerBoundedSubring X.obj.right →ₐ[powerBoundedSubring K]
            powerBoundedSubring Y.obj.right :=
          { f.hom.right.toRingHom.restrict (powerBoundedSubring X.obj.right)
              (powerBoundedSubring Y.obj.right) (by sorry) with
            commutes' := by sorry }
        ((fieldIntegralFunctor p K ϖ).map f).hom ≫ (e Y).hom =
          (e X).hom ≫ (Almost.Algebra.toAlmost (almostSetup p K)).map
            (CommAlgCat.ofHom g) := sorry

/-! ### P1/perfectoid-mod-varpi-equivalence -/

def fieldIntegralEquivalence : FieldAlgebras p K ≌ IntegralAlmostPerfectoid p K ϖ where
  functor := fieldIntegralFunctor p K ϖ
  inverse := sorry
  unitIso := sorry
  counitIso := sorry
  functor_unitIso_comp := sorry

/-- The inverse inverts the chosen small element in the almost-elements algebra. -/
def fieldIntegralEquivalence_inverse (A : IntegralAlmostPerfectoid p K ϖ) :
    ((fieldIntegralEquivalence p K ϖ).inverse.obj A).obj.right ≃+*
      Localization.Away
        (algebraMap (powerBoundedSubring K)
          ((Almost.Algebra.elements (almostSetup p K)).obj A.obj) (ϖ.rootPB 0)) := sorry

-- Check: almost_integral_base
example : IsIntegralAlmostPerfectoid p K ϖ
    ((Almost.Algebra.toAlmost (almostSetup p K)).obj
      (CommAlgCat.of (powerBoundedSubring K) (powerBoundedSubring K))) := sorry
-- Check: almost_integral_zero
example :
    letI : Algebra (powerBoundedSubring K) (ULift.{u} (ZMod 1)) := by sorry
    IsIntegralAlmostPerfectoid p K ϖ
    ((Almost.Algebra.toAlmost (almostSetup p K)).obj
      (CommAlgCat.of (powerBoundedSubring K) (ULift.{u} (ZMod 1)))) := sorry
-- Check: almost_integral_dual_numbers
example : ¬ IsIntegralAlmostPerfectoid p K ϖ
    ((Almost.Algebra.toAlmost (almostSetup p K)).obj
      (CommAlgCat.of (powerBoundedSubring K) (DualNumber (powerBoundedSubring K)))) := sorry
-- Check: almost_mod_base
example : IsModAlmostPerfectoid p K ϖ
    ((Almost.Algebra.toAlmost (modVarpiSetup p K ϖ)).obj
      (CommAlgCat.of (powerBoundedSubring K ⧸ Ideal.span {ϖ.rootPB 0})
        (powerBoundedSubring K ⧸ Ideal.span {ϖ.rootPB 0}))) := sorry
-- Check: almost_mod_zero
example :
    letI : Algebra (powerBoundedSubring K ⧸ Ideal.span {ϖ.rootPB 0}) (ULift.{u} (ZMod 1)) := by sorry
    IsModAlmostPerfectoid p K ϖ
    ((Almost.Algebra.toAlmost (modVarpiSetup p K ϖ)).obj
      (CommAlgCat.of (powerBoundedSubring K ⧸ Ideal.span {ϖ.rootPB 0}) (ULift.{u} (ZMod 1)))) := sorry
-- Check: almost_mod_dual_numbers
example : ¬ IsModAlmostPerfectoid p K ϖ
    ((Almost.Algebra.toAlmost (modVarpiSetup p K ϖ)).obj
      (CommAlgCat.of (powerBoundedSubring K ⧸ Ideal.span {ϖ.rootPB 0})
        (DualNumber (powerBoundedSubring K ⧸ Ideal.span {ϖ.rootPB 0})))) := sorry

end Field
end FieldAlmostCategories

section ColimitCategories
variable (p : ℕ) [Fact p.Prime]

/-- Maximal integral subrings make pair morphisms exactly continuous ring maps. -/
abbrev PerfectoidRingCat := ObjectProperty.FullSubcategory
  (fun X : PairCat.{u} p ↦ X.pair.plus = powerBoundedSubring X)

/-- Replace the chosen plus ring by the power-bounded subring. -/
def PairCat.maximalFunctor : PairCat.{u} p ⥤ PerfectoidRingCat.{u} p where
  obj X := ⟨{ X with pair := Pair.powerBounded X }, rfl⟩
  map f := ObjectProperty.homMk
    { toRingHom := f.toRingHom, continuous_toRingHom := f.continuous_toRingHom, map_mem_plus := by sorry }
  map_id := sorry
  map_comp := sorry

variable {J : Type u} [SmallCategory J] [IsFiltered J]
  (F : J ⥤ PairCat.{u} p) (j₀ : J) (ϖ : PseudoUniformizerRoots p (F.obj j₀))
namespace completedFilteredColimit

def cocone : Cocone (F ⋙ PairCat.maximalFunctor p) where
  pt := ⟨{ carrier := completedFilteredColimit p F j₀ ϖ,
           pair := Pair.powerBounded _ }, rfl⟩
  ι := { app := fun j ↦ ObjectProperty.homMk
           { toRingHom := ι p F j₀ ϖ j
             continuous_toRingHom := continuous_ι p F j₀ ϖ j
             map_mem_plus := by sorry }
         naturality := by sorry }

def isColimit : IsColimit (cocone p F j₀ ϖ) := sorry

-- Check: colimit_constant
example (X : PairCat.{u} p) (ψ : PseudoUniformizerRoots p X) :
    ∃ e : completedFilteredColimit p ((Functor.const J).obj X) j₀ ψ ≃+* X,
      Continuous e ∧ Continuous e.symm ∧
      ∀ j x, e (ι p ((Functor.const J).obj X) j₀ ψ j x) = x := sorry
-- Check: colimit_cofinal_coordinates
example {J' : Type u} [SmallCategory J'] [IsFiltered J'] (G : J' ⥤ J) [G.Final]
    (j₁ : J') (ψ : PseudoUniformizerRoots p (F.obj (G.obj j₁))) :
    equivOfChoice p F j₀ ϖ G j₁ ψ (ι p (G ⋙ F) j₁ ψ j₁ (ψ.root 0)) =
      ι p F j₀ ϖ (G.obj j₁) (ψ.root 0) ∧
    equivOfChoice p F j₀ ϖ G j₁ ψ (ι p (G ⋙ F) j₁ ψ j₁ (ψ.root 1)) =
      ι p F j₀ ϖ (G.obj j₁) (ψ.root 1) := sorry
end completedFilteredColimit

variable (R : PairCat.{u} p)
namespace completedFilteredColimit
/-- The colimit inherits the common structural map from any stage. -/
def underObject (G : J ⥤ Under R) (j : J)
    (ψ : PseudoUniformizerRoots p (G.obj j).right) : Under R :=
  Under.mk (show R ⟶ (show PairCat p from
    { carrier := completedFilteredColimit p (G ⋙ Under.forget R) j ψ,
      pair := Pair.powerBounded _ }) from
    { toRingHom := (ι p (G ⋙ Under.forget R) j ψ j).comp (G.obj j).hom.toRingHom
      continuous_toRingHom := by sorry
      map_mem_plus := by sorry })

def untiltEquiv (G : J ⥤ Under ((PairCat.tiltFunctor p).obj R)) (j : J)
    (ψ : PseudoUniformizerRoots p (G.obj j).right)
    (η : PseudoUniformizerRoots p (((PairCat.sliceUntiltFunctor p R).obj (G.obj j)).right)) :
    ((PairCat.sliceUntiltFunctor p R).obj
      (underObject p ((PairCat.tiltFunctor p).obj R) G j ψ)).right ≃+*
    completedFilteredColimit p
      (G ⋙ PairCat.sliceUntiltFunctor p R ⋙ Under.forget R) j η := sorry

theorem untiltEquiv_continuous (G : J ⥤ Under ((PairCat.tiltFunctor p).obj R)) (j : J)
    (ψ : PseudoUniformizerRoots p (G.obj j).right)
    (η : PseudoUniformizerRoots p (((PairCat.sliceUntiltFunctor p R).obj (G.obj j)).right)) :
    Continuous (untiltEquiv p R G j ψ η) ∧ Continuous (untiltEquiv p R G j ψ η).symm := sorry

/-- The untilting comparison preserves each structural map of the filtered diagram. -/
theorem untiltEquiv_ι (G : J ⥤ Under ((PairCat.tiltFunctor p).obj R)) (j : J)
    (ψ : PseudoUniformizerRoots p (G.obj j).right)
    (η : PseudoUniformizerRoots p (((PairCat.sliceUntiltFunctor p R).obj (G.obj j)).right))
    (i : J) :
    let stageMap : G.obj i ⟶ underObject p ((PairCat.tiltFunctor p).obj R) G j ψ :=
      Under.homMk
        { toRingHom := ι p (G ⋙ Under.forget ((PairCat.tiltFunctor p).obj R)) j ψ i
          continuous_toRingHom :=
            continuous_ι p (G ⋙ Under.forget ((PairCat.tiltFunctor p).obj R)) j ψ i
          map_mem_plus := by sorry }
        (by sorry)
    (untiltEquiv p R G j ψ η).toRingHom.comp
        (((PairCat.sliceUntiltFunctor p R).map stageMap).right.toRingHom) =
      ι p (G ⋙ PairCat.sliceUntiltFunctor p R ⋙ Under.forget R) j η i := sorry
-- Check: completedFilteredColimit.untiltEquiv_zero_diagram
example (G : J ⥤ Under ((PairCat.tiltFunctor p).obj R)) (j : J)
    (ψ : PseudoUniformizerRoots p (G.obj j).right)
    (η : PseudoUniformizerRoots p (((PairCat.sliceUntiltFunctor p R).obj (G.obj j)).right))
    (hG : ∀ i, Subsingleton (G.obj i).right) :
    Subsingleton (completedFilteredColimit p
      (G ⋙ PairCat.sliceUntiltFunctor p R ⋙ Under.forget R) j η) ∧
      ∀ x, untiltEquiv p R G j ψ η x = 0 := sorry

-- Check: completedFilteredColimit.untiltEquiv_two_roots
set_option maxHeartbeats 800000 in
example (G : J ⥤ Under ((PairCat.tiltFunctor p).obj R)) (j : J) (hj : IsTerminal j)
    (ψ : PseudoUniformizerRoots p (G.obj j).right)
    (η : PseudoUniformizerRoots p (((PairCat.sliceUntiltFunctor p R).obj (G.obj j)).right)) :
    let stageMap : G.obj j ⟶ underObject p ((PairCat.tiltFunctor p).obj R) G j ψ :=
      Under.homMk
        { toRingHom := ι p (G ⋙ Under.forget ((PairCat.tiltFunctor p).obj R)) j ψ j
          continuous_toRingHom :=
            continuous_ι p (G ⋙ Under.forget ((PairCat.tiltFunctor p).obj R)) j ψ j
          map_mem_plus := by sorry } (by sorry)
    terminalEquiv p (G ⋙ PairCat.sliceUntiltFunctor p R ⋙ Under.forget R) j η j hj
      (untiltEquiv p R G j ψ η
        (((PairCat.sliceUntiltFunctor p R).map stageMap).right.toRingHom
          (η.root 0 + η.root 1))) = η.root 0 + η.root 1 := sorry

-- Check: completedFilteredColimit.untiltEquiv_not_frobenius
set_option maxHeartbeats 800000 in
example (G : J ⥤ Under ((PairCat.tiltFunctor p).obj R)) (j : J) (hj : IsTerminal j)
    (ψ : PseudoUniformizerRoots p (G.obj j).right)
    (η : PseudoUniformizerRoots p (((PairCat.sliceUntiltFunctor p R).obj (G.obj j)).right))
    [Nontrivial (((PairCat.sliceUntiltFunctor p R).obj (G.obj j)).right)] :
    let stageMap : G.obj j ⟶ underObject p ((PairCat.tiltFunctor p).obj R) G j ψ :=
      Under.homMk
        { toRingHom := ι p (G ⋙ Under.forget ((PairCat.tiltFunctor p).obj R)) j ψ j
          continuous_toRingHom :=
            continuous_ι p (G ⋙ Under.forget ((PairCat.tiltFunctor p).obj R)) j ψ j
          map_mem_plus := by sorry } (by sorry)
    untiltEquiv p R G j ψ η
        (((PairCat.sliceUntiltFunctor p R).map stageMap).right.toRingHom (η.root 0)) ≠
      ι p (G ⋙ PairCat.sliceUntiltFunctor p R ⋙ Under.forget R) j η j ((η.root 0) ^ p) := sorry

end completedFilteredColimit
end ColimitCategories

/-- Sch12, proof of Theorem 3.7, p. 29: finite subextensions of an algebraic closure
of the tilt exhaust that closure, and their untilts have dense union in the completed
colimit. The comparison with the completed closure is the one induced by `tiltEquiv`.
The embeddings identify each stage, with its topology and base map, with a finite
intermediate field of the chosen normed algebraic closure. -/
theorem completedFilteredColimit_tilt_algebraicClosure
    (p : ℕ) [Fact p.Prime] (K : Type u) [NontriviallyNormedField K]
    [IsUltrametricDist K] [CompleteSpace K] [IsPerfectoidField p K]
    (Ω : Type u) [NontriviallyNormedField Ω] [IsUltrametricDist Ω]
    [NormedAlgebra (tiltField p K) Ω] [IsAlgClosure (tiltField p K) Ω]
    {J : Type u} [SmallCategory J] [IsFiltered J]
    (G : J ⥤ Under ((PairCat.tiltFunctor p).obj
      (⟨K, Pair.powerBounded K⟩ : PairCat.{u} p)))
    (L : J → IntermediateField (tiltField p K) Ω)
    (hfinite : ∀ j, Module.Finite (tiltField p K) (L j))
    (c : ∀ j, (G.obj j).right →+* Ω)
    (hembed : ∀ j, Topology.IsEmbedding (c j))
    (hrange : ∀ j, (c j).range = (L j).toSubring)
    (hbase : ∀ j, (c j).comp (G.obj j).hom.toRingHom =
      (algebraMap (tiltField p K) Ω).comp (tiltField.toTilt p K).symm.toRingHom)
    (hnat : ∀ {i j} (a : i ⟶ j), (c j).comp (G.map a).right.toRingHom = c i)
    (hcover : (⋃ j, Set.range (c j)) = Set.univ)
    (j₀ : J) (η : PseudoUniformizerRoots p
      (((PairCat.sliceUntiltFunctor p (⟨K, Pair.powerBounded K⟩ : PairCat.{u} p)).obj
        (G.obj j₀)).right)) :
    let B : PairCat.{u} p := ⟨K, Pair.powerBounded K⟩
    let F := G ⋙ PairCat.sliceUntiltFunctor p B ⋙ Under.forget B
    letI : CommRing (completedFilteredColimit p (F ⋙ PairCat.tiltFunctor p) j₀ (η.tilt p)) :=
      completedFilteredColimit.instCommRing p (F ⋙ PairCat.tiltFunctor p) j₀ (η.tilt p)
    letI : UniformSpace (completedFilteredColimit p (F ⋙ PairCat.tiltFunctor p) j₀ (η.tilt p)) :=
      completedFilteredColimit.instUniformSpace p (F ⋙ PairCat.tiltFunctor p) j₀ (η.tilt p)
    ∃ e : completedFilteredColimit p (F ⋙ PairCat.tiltFunctor p) j₀ (η.tilt p) ≃+*
        UniformSpace.Completion Ω,
      Continuous e ∧ Continuous e.symm ∧
      (∀ j (x : (G.obj j).right),
        e (completedFilteredColimit.tiltEquiv p F j₀ η
          (tilt.map p (completedFilteredColimit.ι p F j₀ η j)
            (completedFilteredColimit.continuous_ι p F j₀ η j)
            (((PairCat.sliceTiltingEquivalence p B).counitIso.inv.app
              (G.obj j)).right.toRingHom x))) = (c j x : UniformSpace.Completion Ω)) ∧
      Dense (⋃ j, Set.range (completedFilteredColimit.ι p F j₀ η j)) := sorry

section FiniteVariableColimit
variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R] (ϖ : PseudoUniformizerRoots p R) (σ : Type u)
namespace perfectedTateAlgebra

def finiteDiagram : Finset σ ⥤ PairCat.{u} p where
  obj s := { carrier := perfectedTateAlgebra p ϖ s, pair := Pair.powerBounded _ }
  map f := { toRingHom := (mapIndex ϖ (fun x ↦ ⟨x.val, (leOfHom f) x.property⟩)).toRingHom
             continuous_toRingHom := continuous_mapIndex p ϖ _
             map_mem_plus := by sorry }
  map_id := sorry
  map_comp := sorry

def finiteDiagramRoots : PseudoUniformizerRoots p ((finiteDiagram p ϖ σ).obj ∅) :=
  PseudoUniformizerRoots.map p (algebraMap R (perfectedTateAlgebra p ϖ (∅ : Finset σ)))
    (continuous_algebraMap p ϖ) ϖ

def equivCompletedColimit :
    completedFilteredColimit p (finiteDiagram p ϖ σ) ∅ (finiteDiagramRoots p ϖ σ) ≃+*
      perfectedTateAlgebra p ϖ σ := sorry

theorem equivCompletedColimit_spec :
    Continuous (equivCompletedColimit p ϖ σ) ∧ Continuous (equivCompletedColimit p ϖ σ).symm ∧
    ∀ s, (equivCompletedColimit p ϖ σ).toRingHom.comp
      (completedFilteredColimit.ι p (finiteDiagram p ϖ σ) ∅ (finiteDiagramRoots p ϖ σ) s) =
        (mapIndex ϖ (Subtype.val : s → σ)).toRingHom := sorry

-- Check: finite_colimit_two_roots
example (s : Finset σ) (i : s) :
    equivCompletedColimit p ϖ σ
      (completedFilteredColimit.ι p (finiteDiagram p ϖ σ) ∅ (finiteDiagramRoots p ϖ σ) s
        (rootX ϖ i 0)) = rootX ϖ i.val 0 ∧
    equivCompletedColimit p ϖ σ
      (completedFilteredColimit.ι p (finiteDiagram p ϖ σ) ∅ (finiteDiagramRoots p ϖ σ) s
        (rootX ϖ i 1)) = rootX ϖ i.val 1 := sorry
-- Check: finite_colimit_zero
example [Subsingleton R] : Subsingleton
    (completedFilteredColimit p (finiteDiagram p ϖ σ) ∅ (finiteDiagramRoots p ϖ σ)) := sorry
-- Check: variable_collision
example [Nontrivial R] :
    rootX ϖ (ULift.up.{u} true) 0 - rootX ϖ (ULift.up false) 0 ≠ 0 ∧
    mapIndex ϖ (fun _ : ULift.{u} Bool ↦ (ULift.up () : ULift.{u} Unit))
      (rootX ϖ (ULift.up true) 0 - rootX ϖ (ULift.up false) 0) = 0 := sorry

-- Check: variable_index_empty
example (r : R) :
    mapIndex ϖ (PEmpty.elim : PEmpty.{u+1} → σ)
      ((emptyEquiv ϖ).symm r) = algebraMap R _ r := sorry
-- Check: variable_index_zero
example [Subsingleton R] (g : σ → σ) (x : perfectedTateAlgebra p ϖ σ) :
    mapIndex ϖ g x = 0 := sorry
end perfectedTateAlgebra
end FiniteVariableColimit

section AdditionalSupportingInterfaces
variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R]
namespace tilt
variable (P : Pair R) (t : (Pair.tilt p P).plus)
  (ht : IsPseudoUniformizer (sharp t.val))
  (hs : sharp t.val ∈ P.plus)
  (hp : (⟨sharp t.val, hs⟩ : P.plus) ∣ (p : P.plus))

/-- Berkeley Lemma 6.2.5: sharp induces the small-quotient ring equivalence. -/
def sharpQuotEquiv (P : Pair R) (t : (Pair.tilt p P).plus)
    (ht : IsPseudoUniformizer (sharp t.val)) (hs : sharp t.val ∈ P.plus)
    (hp : (⟨sharp t.val, hs⟩ : P.plus) ∣ (p : P.plus)) : (Pair.tilt p P).plus ⧸ Ideal.span {t} ≃+*
    P.plus ⧸ Ideal.span {(⟨sharp t.val, hs⟩ : P.plus)} := sorry

theorem sharpQuotEquiv_apply (x : (Pair.tilt p P).plus) :
    ∃ hx : sharp x.val ∈ P.plus,
      sharpQuotEquiv p P t ht hs hp (Ideal.Quotient.mk _ x) =
        Ideal.Quotient.mk _ ⟨sharp x.val, hx⟩ := sorry

-- Check: sharp_quotient_generator
example : sharpQuotEquiv p P t ht hs hp (Ideal.Quotient.mk _ t) = 0 := sorry
-- Check: sharp_quotient_two_terms
example (x y : (Pair.tilt p P).plus) :
    ∃ (hx : sharp x.val ∈ P.plus) (hy : sharp y.val ∈ P.plus),
      sharpQuotEquiv p P t ht hs hp (Ideal.Quotient.mk _ (x + y)) =
        Ideal.Quotient.mk _ (⟨sharp x.val, hx⟩ + ⟨sharp y.val, hy⟩) ∧
      sharpQuotEquiv p P t ht hs hp (Ideal.Quotient.mk _ (x * y)) =
        Ideal.Quotient.mk _ (⟨sharp x.val, hx⟩ * ⟨sharp y.val, hy⟩) := sorry
-- Check: sharp_quotient_zero
example [Subsingleton R] : Subsingleton (P.plus ⧸ Ideal.span {(⟨sharp t.val, hs⟩ : P.plus)}) ∧
    sharpQuotEquiv p P t ht hs hp 1 = 0 := sorry
end tilt

/-! ### P1/rings-of-integral-elements-under-tilting -/

theorem Pair.tilt_bijective : Function.Bijective (Pair.tilt p : Pair R → Pair (Perfectoid.tilt p R)) := sorry

theorem Pair.tilt_plus_le_iff (P Q : Pair R) :
    (Pair.tilt p P).plus ≤ (Pair.tilt p Q).plus ↔ P.plus ≤ Q.plus := sorry

theorem tilt.primitive_iff_generates_kernel (P : Pair R)
    (ξ : WittVector p (Pair.tilt p P).plus) (hξ : ξ ∈ RingHom.ker (tilt.theta p P)) :
    IsPrimitive ξ ↔ RingHom.ker (tilt.theta p P) = Ideal.span {ξ} := sorry

variable [CharP R p] (P : Pair R)

/-! ### P1/distinguished-element-criterion -/

theorem IsPrimitive.iff_teichmuller_add (ξ : WittVector p P.plus) :
    IsPrimitive ξ ↔ ∃ (a : P.plus) (u : (WittVector p P.plus)ˣ),
      IsTopologicallyNilpotent a ∧ ξ = WittVector.teichmuller p a + p * u := sorry

theorem IsPrimitive.exists_associated_p_add (ξ : WittVector p P.plus) (hξ : IsPrimitive ξ) :
    ∃ (u : (WittVector p P.plus)ˣ) (t : P.plus) (α : WittVector p P.plus),
      IsPseudoUniformizer (t : R) ∧ (u : WittVector p P.plus) * ξ = p + WittVector.teichmuller p t * α := sorry

theorem IsPrimitive.mul_unit (ξ : WittVector p P.plus) (u : (WittVector p P.plus)ˣ) :
    IsPrimitive (ξ * (u : WittVector p P.plus)) ↔ IsPrimitive ξ := sorry

theorem IsPrimitive.isUnit_of_eq_mul (ξ ξ' y : WittVector p P.plus)
    (hξ : IsPrimitive ξ) (hξ' : IsPrimitive ξ') (h : ξ' = y * ξ) : IsUnit y := sorry

theorem IsPrimitive.frobenius (ξ : WittVector p P.plus) (hξ : IsPrimitive ξ) :
    IsPrimitive (WittVector.frobenius ξ) := sorry

/-! ### P1/quotient-by-primitive-element -/

/-- The quotient is regular and complete for the same chosen Teichmüller parameter. -/
theorem primitive_quotient_complete (t : P.plus) (ht : IsPseudoUniformizer (t : R))
    (α : WittVector p P.plus) :
    let ξ : WittVector p P.plus := p + WittVector.teichmuller p t * α
    let A := WittVector p P.plus ⧸ Ideal.span {ξ}
    let π : A := Ideal.Quotient.mk _ (WittVector.teichmuller p t)
    π ∈ nonZeroDivisors A ∧ IsAdicComplete (Ideal.span {π}) A ∧
      IsAdicComplete (Ideal.span {(p : A)}) A ∧
      Nonempty ((A ⧸ Ideal.span {π}) ≃+* (P.plus ⧸ Ideal.span {t})) := sorry
end AdditionalSupportingInterfaces

section IntegralAdicComparison
variable (p : ℕ) [Fact p.Prime] (A : Type u) [CommRing A]

/-- BMS's admissible presentation with the adic element specified. -/
structure IntegralAdicPresentation (π : A) : Prop where
  pow_dvd_p : π ^ p ∣ (p : A)
  complete : IsAdicComplete (Ideal.span {π}) A
  frobenius_surjective : Function.Surjective (fun x : ModP A p ↦ x ^ p)
  theta_kernel_principal : ∀ (hp : ¬ IsUnit (p : A))
      (hc : IsAdicComplete (Ideal.span {(p : A)}) A),
    letI : Fact (¬ IsUnit (p : A)) := ⟨hp⟩
    letI := hc
    (RingHom.ker (WittVector.fontaineTheta A p)).IsPrincipal

theorem IsIntegralPerfectoid.iff_adicPresentation (π : A) (hp : π ^ p ∣ (p : A))
    [IsAdicComplete (Ideal.span {π}) A] :
    IsIntegralPerfectoid p A ↔ IntegralAdicPresentation p A π := sorry

