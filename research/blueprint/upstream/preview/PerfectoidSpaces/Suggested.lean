/-- The counit of almostification followed by almost elements. -/
def counitIso (A : Algebra S) : (toAlmost S).obj ((elements S).obj A) ≅ A :=
  asIso ((adj S).counit.app A)
theorem counitIso_hom (A : Algebra S) : (counitIso S A).hom = (adj S).counit.app A := rfl

/-- Full faithfulness of the almost-elements algebra functor. -/
def homEquiv (A B : Algebra S) : (A ⟶ B) ≃ (((elements S).obj A) →ₐ[V] ((elements S).obj B)) := sorry
theorem homEquiv_apply {A B : Algebra S} (f : A ⟶ B) :
    homEquiv S A B f = ((elements S).map f).hom := sorry

/-- Free modules are transported from the almostification of finitely supported functions. -/
def free (A : Algebra S) (ι : Type u) : ModuleCat S A :=
  (moduleEquiv S A).inverse.obj
    ((Almost.toAlmost (S.baseChange ((elements S).obj A))).obj
      (_root_.ModuleCat.of ((elements S).obj A) (ι →₀ ((elements S).obj A))))

def prod (A B : Algebra S) : Algebra S :=
  (toAlmost S).obj (CommAlgCat.of V (((elements S).obj A) × ((elements S).obj B)))
def tensor (A B : Algebra S) : Algebra S :=
  (toAlmost S).obj (CommAlgCat.of V (((elements S).obj A) ⊗[V] ((elements S).obj B)))

theorem prod_universal (A B C : Algebra S) :
    Nonempty ((C ⟶ prod S A B) ≃ ((C ⟶ A) × (C ⟶ B))) := sorry
theorem tensor_universal (A B C : Algebra S) :
    Nonempty ((tensor S A B ⟶ C) ≃ ((A ⟶ C) × (B ⟶ C))) := sorry

