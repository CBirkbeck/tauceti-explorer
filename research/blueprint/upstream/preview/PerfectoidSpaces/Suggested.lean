/-! ### Layer 2: Quantitative approximation and the naive integral model -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open TauCeti Huber ValuationSpectrum Topology Filter
variable (p : ℕ) [Fact p.Prime]
section QuantitativeApproximation
variable {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R] (P : Pair R) (ϖ : PseudoUniformizerRoots p R)

/-! ### P2/approximation-lemma -/

/-- Sch12 Corollary 6.7(i), pp. 34–35, in the base-ring form of ECD 3.12.
Here c = a/p^m and ε = b/p^n; the compatible root systems define the fractional powers. -/
theorem exists_sharp_approximation (f : R) (a m b n : ℕ)
    (hb : 0 < b) (hbn : b < p ^ n) :
    ∃ g : tilt p R, ∀ x : spa P.plus,
      x.val.valuation (f - tilt.sharp g) ≤
        x.val.valuation (ϖ.root n ^ (p ^ n - b)) *
          max (x.val.valuation f) (x.val.valuation (ϖ.root m ^ a)) ∧
      max (x.val.valuation f) (x.val.valuation (ϖ.root m ^ a)) =
        max (x.val.valuation (tilt.sharp g)) (x.val.valuation (ϖ.root m ^ a)) := sorry

-- Check: sharp_approximation_zero
example (a m b n : ℕ) (hb : 0 < b) (hbn : b < p ^ n) :
    ∀ x : spa P.plus, x.val.valuation (0 - tilt.sharp (0 : tilt p R)) ≤
      x.val.valuation (ϖ.root n ^ (p ^ n - b)) *
        max (x.val.valuation 0) (x.val.valuation (ϖ.root m ^ a)) := by
  sorry
-- Check: sharp_approximation_exact
example (g : tilt p R) (x : spa P.plus) :
    x.val.valuation (tilt.sharp g - tilt.sharp g) = 0 := by simp
end QuantitativeApproximation

section DiscIntegralModels
variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K]
  [CompleteSpace K] [IsPerfectoidField p K] (ϖ : PseudoUniformizerRoots p K)

/-- The disc endomorphism T^(1/p^n) ↦ ϖ^(1/p^n) T^(1/p^n).
The source coordinate is T and the target coordinate is T/ϖ. -/
def discScale : perfectedTateAlgebra p ϖ PUnit →ₐ[K] perfectedTateAlgebra p ϖ PUnit := sorry

theorem discScale_continuous : Continuous (discScale p ϖ) := sorry

theorem discScale_rootX (n : ℕ) :
    discScale p ϖ (perfectedTateAlgebra.rootX ϖ PUnit.unit n) =
      algebraMap K _ (ϖ.root n) * perfectedTateAlgebra.rootX ϖ PUnit.unit n := sorry

/-- The closed naive integral subring K°⟨T^(1/p^∞)⟩⟨T/ϖ⟩ inside the normalized disc.
The closure is in the Tate topology of K⟨(T/ϖ)^(1/p^∞)⟩. -/
def naiveDiscModel : Subring (perfectedTateAlgebra p ϖ PUnit) :=
  (Subring.closure
    ((discScale p ϖ '' (powerBoundedSubring (perfectedTateAlgebra p ϖ PUnit) : Set _)) ∪
      {perfectedTateAlgebra.rootX ϖ PUnit.unit 0})).topologicalClosure

/-- Adjoining all roots of the normalized coordinate before closure. -/
def rootedDiscModel : Subring (perfectedTateAlgebra p ϖ PUnit) :=
  (Subring.closure
    ((discScale p ϖ '' (powerBoundedSubring (perfectedTateAlgebra p ϖ PUnit) : Set _)) ∪
      Set.range (perfectedTateAlgebra.rootX ϖ PUnit.unit))).topologicalClosure

/-- Sch12 Lemma 6.4: the root-adjoined model on a disc is exactly its unit ball. -/
theorem rootedDiscModel_eq : rootedDiscModel p ϖ =
    powerBoundedSubring (perfectedTateAlgebra p ϖ PUnit) := sorry

/-- No fixed p-power root of ϖ annihilates the discrepancy of the naive model. -/
theorem naiveDiscModel_not_almost (k : ℕ) (hk : 1 ≤ k) :
    ∃ n : ℕ, algebraMap K (perfectedTateAlgebra p ϖ PUnit) (ϖ.root k) *
      perfectedTateAlgebra.rootX ϖ PUnit.unit n ^ (p ^ n - 1) ∉ naiveDiscModel p ϖ := sorry

-- Check: discScale_constants
example (a : K) : discScale p ϖ (algebraMap K _ a) = algebraMap K _ a :=
  (discScale p ϖ).commutes a
-- Check: discScale_two_roots
example : discScale p ϖ (perfectedTateAlgebra.rootX ϖ PUnit.unit 0) =
    algebraMap K _ (ϖ.root 0) * perfectedTateAlgebra.rootX ϖ PUnit.unit 0 ∧
    discScale p ϖ (perfectedTateAlgebra.rootX ϖ PUnit.unit 1) =
    algebraMap K _ (ϖ.root 1) * perfectedTateAlgebra.rootX ϖ PUnit.unit 1 :=
  ⟨discScale_rootX p ϖ 0, discScale_rootX p ϖ 1⟩
-- Check: discScale_not_surjective_unit_ball
example : ¬ Set.SurjOn (discScale p ϖ)
    (powerBoundedSubring (perfectedTateAlgebra p ϖ PUnit))
    (powerBoundedSubring (perfectedTateAlgebra p ϖ PUnit)) := sorry
-- Check: naiveModel_fractional_member
example : algebraMap K (perfectedTateAlgebra p ϖ PUnit) (ϖ.root 1) *
    perfectedTateAlgebra.rootX ϖ PUnit.unit 1 ∈ naiveDiscModel p ϖ := sorry
-- Check: naiveModel_smaller_root_nonmember
example : algebraMap K (perfectedTateAlgebra p ϖ PUnit) (ϖ.root 2) *
    perfectedTateAlgebra.rootX ϖ PUnit.unit 1 ∉ naiveDiscModel p ϖ := sorry
-- Check: naiveModel_integral_generator
example : perfectedTateAlgebra.rootX ϖ PUnit.unit 0 ∈ naiveDiscModel p ϖ ∧
    perfectedTateAlgebra.rootX ϖ PUnit.unit 1 ∉ naiveDiscModel p ϖ := sorry
-- Check: rootedModel_fractional_generator
example : perfectedTateAlgebra.rootX ϖ PUnit.unit 1 ∈ rootedDiscModel p ϖ := sorry
-- Check: rootedModel_unbounded_constant
example (a : K) (ha : 1 < ‖a‖) :
    algebraMap K (perfectedTateAlgebra p ϖ PUnit) a ∉ rootedDiscModel p ϖ := sorry
-- Check: rootedModel_two_term_sum
example : perfectedTateAlgebra.rootX ϖ PUnit.unit 0 +
    perfectedTateAlgebra.rootX ϖ PUnit.unit 1 ∈ rootedDiscModel p ϖ := sorry
-- Check: restriction_disc_two_radii
example (m : ℕ) : discScale p ϖ (perfectedTateAlgebra.rootX ϖ PUnit.unit m) =
    algebraMap K _ (ϖ.root m) * perfectedTateAlgebra.rootX ϖ PUnit.unit m :=
  discScale_rootX p ϖ m
end DiscIntegralModels
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
end

/-! ### Layer 2: Perfectoid spaces on the Yoneda-adic category -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
open TauCeti Huber Perfectoid CategoryTheory CategoryTheory.Limits
open TauCetiRoadmap.AdicEtaleGeometry
local notation "YAdic" => YonedaAdicSpace
local notation "YSpace" => YonedaAdicSpace.space
variable (p : ℕ) [Fact p.Prime]

/-! ### P2/perfectoid-space -/

/-- A Yoneda-adic space is perfectoid if open perfectoid affinoids cover its valuation points
(ECD Definition 3.19). -/
def IsPerfectoidSpace (X : YAdic) : Prop :=
  ∀ x : YonedaAdicSpace.space.obj X, ∃ (R : PairCat.{0} p)
    (f : YonedaAdicSpace.ofSpaY (CAff.of R.pair) ⟶ X),
    YonedaAdicSpace.IsOpenImmersion f.hom ∧ x ∈ Set.range (YonedaAdicSpace.space.map f)

/-! ### P2/affinoid-perfectoid-space -/

/-- An affinoid perfectoid space is a spectrum of a complete perfectoid pair. -/
def IsAffinoidPerfectoid (X : YAdic) : Prop :=
  ∃ R : PairCat.{0} p, Nonempty (X ≅ YonedaAdicSpace.ofSpaY (CAff.of R.pair))

theorem IsPerfectoidSpace.of_isAffinoidPerfectoid {X : YAdic}
    (h : IsAffinoidPerfectoid p X) : IsPerfectoidSpace p X := sorry

theorem IsPerfectoidSpace.isAnalyticPoint {X : YAdic}
    (h : IsPerfectoidSpace p X) (x : YonedaAdicSpace.space.obj X) :
    YonedaAdicSpace.IsAnalyticPoint X x := sorry

theorem IsAffinoidPerfectoid.isAnalyticPoint {X : YAdic}
    (h : IsAffinoidPerfectoid p X) (x : YonedaAdicSpace.space.obj X) :
    YonedaAdicSpace.IsAnalyticPoint X x := sorry

abbrev Perfd := ObjectProperty.FullSubcategory (IsPerfectoidSpace p)

/-- Characteristic p means p annihilates the structure sheaf; evaluating the integer
on global functions suffices, and includes the empty space. -/
def InCharP (X : Perfd p) : Prop :=
  ∀ (R : PairCat.{0} p) (f : YonedaAdicSpace.ofSpaY (CAff.of R.pair) ⟶ X.obj),
    YonedaAdicSpace.IsOpenImmersion f.hom → (p : R) = 0

abbrev Perf := ObjectProperty.FullSubcategory (InCharP p)

/-- The perfectoid affinoid associated to a pair, represented on the rational site. -/
def ofPair (R : PairCat.{0} p) : Perfd p :=
  ⟨YonedaAdicSpace.ofSpaY (CAff.of R.pair), by sorry⟩

/-- Contravariant affinoid functor; the map is fixed by `spaFunctor_map`. -/
def spaFunctor : (PairCat.{0} p)ᵒᵖ ⥤ Perfd p where
  obj R := ofPair p R.unop
  map f := ObjectProperty.homMk (ObjectProperty.homMk
    (YonedaAdicSpace.spaYFunctor.map (CAff.ofHom f.unop).op))
  map_id := by sorry
  map_comp := by sorry

theorem spaFunctor_obj (R : PairCat.{0} p) :
    (spaFunctor p).obj (Opposite.op R) = ofPair p R := sorry

theorem spaFunctor_map {R S : PairCat.{0} p} (f : R ⟶ S) :
    ((spaFunctor p).map f.op).hom.hom =
      YonedaAdicSpace.spaYFunctor.map (CAff.ofHom f).op := sorry

instance spaFunctor_full : (spaFunctor p).Full := sorry
instance spaFunctor_faithful : (spaFunctor p).Faithful := sorry

theorem affinoid_iff_iso_spa (X : Perfd p) : IsAffinoidPerfectoid p X.obj ↔
    ∃ R : PairCat.{0} p, Nonempty (X ≅ ofPair p R) := sorry

/-! ### P2/open-subspaces-of-perfectoid-spaces -/

/-- The open subspace, characterized by its open embedding and its image. -/
def restrict (X : Perfd p) (U : TopologicalSpace.Opens (YonedaAdicSpace.space.obj X.obj)) : Perfd p := sorry

def restrictι (X : Perfd p) (U : TopologicalSpace.Opens (YonedaAdicSpace.space.obj X.obj)) :
    restrict p X U ⟶ X := sorry

theorem restrict_spec (X : Perfd p) (U : TopologicalSpace.Opens (YonedaAdicSpace.space.obj X.obj)) :
    YonedaAdicSpace.IsOpenImmersion (restrictι p X U).hom.hom ∧
    Topology.IsOpenEmbedding (YonedaAdicSpace.space.map (restrictι p X U).hom) ∧
    Set.range (YonedaAdicSpace.space.map (restrictι p X U).hom) = U := sorry

/-! ### P2/affinoid-perfectoid-basis -/

theorem affinoid_basis (X : Perfd p) :
    TopologicalSpace.IsTopologicalBasis {U : Set (YonedaAdicSpace.space.obj X.obj) |
      ∃ (R : PairCat.{0} p) (f : ofPair p R ⟶ X),
        YonedaAdicSpace.IsOpenImmersion f.hom.hom ∧
        Set.range (YonedaAdicSpace.space.map f.hom) = U} := sorry

/-! ### P2/perfectoid-spaces-and-glued-tilting -/

/-- Gluing the affinoid tilt, ECD Theorem 3.20. -/
def tiltFunctor : Perfd p ⥤ Perfd p := sorry

/-! ### P2/affinoid-perfectoid-pairs-tilting-equivalence -/

def tiltSpaIso (R : PairCat.{0} p) :
    (tiltFunctor p).obj (ofPair p R) ≅ ofPair p ((PairCat.tiltFunctor p).obj R) := sorry

theorem tiltSpaIso_naturality {R S : PairCat.{0} p} (f : R ⟶ S) :
    (tiltFunctor p).map ((spaFunctor p).map f.op) ≫ (tiltSpaIso p R).hom =
      (tiltSpaIso p S).hom ≫ (spaFunctor p).map ((PairCat.tiltFunctor p).map f).op := sorry

/-- The global homeomorphism must agree with valuation tilting on each affinoid. -/
def tiltHomeomorph (X : Perfd p) :
    YonedaAdicSpace.space.obj X.obj ≃ₜ YonedaAdicSpace.space.obj ((tiltFunctor p).obj X).obj := sorry

theorem tiltHomeomorph_naturality {X Y : Perfd p} (f : X ⟶ Y)
    (x : YonedaAdicSpace.space.obj X.obj) :
    tiltHomeomorph p Y (YonedaAdicSpace.space.map f.hom x) =
      YonedaAdicSpace.space.map ((tiltFunctor p).map f).hom (tiltHomeomorph p X x) := sorry

/-- The points of a perfectoid affinoid are the continuous valuations bounded by its plus ring. -/
def spaSpaceEquiv (R : PairCat.{0} p) :
    YonedaAdicSpace.space.obj (ofPair p R).obj ≃ₜ ULift.{1} (ValuationSpectrum.spa R.pair.plus) := sorry

theorem spaSpaceEquiv_naturality {R S : PairCat.{0} p} (f : R ⟶ S)
    (x : YonedaAdicSpace.space.obj (ofPair p S).obj) :
    spaSpaceEquiv p R (YonedaAdicSpace.space.map ((spaFunctor p).map f.op).hom x) =
      ULift.up (f.spaComap (spaSpaceEquiv p S x).down) := sorry

theorem tiltHomeomorph_spa (R : PairCat.{0} p)
    (x : YonedaAdicSpace.space.obj (ofPair p R).obj) :
    (spaSpaceEquiv p ((PairCat.tiltFunctor p).obj R))
      (YonedaAdicSpace.space.map (tiltSpaIso p R).hom.hom (tiltHomeomorph p (ofPair p R) x)) =
    ULift.up (spaTilt p R.pair ((spaSpaceEquiv p R) x).down) := sorry

theorem tilt_inCharP (X : Perfd p) : InCharP p ((tiltFunctor p).obj X) := sorry

def tiltCharPIso (X : Perf p) : (tiltFunctor p).obj X.obj ≅ X.obj := sorry

/-- Restricting the tilt to the corresponding open commutes with tilting. -/
def tiltRestrictIso (X : Perfd p) (U : TopologicalSpace.Opens (YonedaAdicSpace.space.obj X.obj)) :
    (tiltFunctor p).obj (restrict p X U) ≅
      restrict p ((tiltFunctor p).obj X) ⟨tiltHomeomorph p X '' (U : Set _), (tiltHomeomorph p X).isOpenMap _ U.isOpen⟩ := sorry

/-! ### P2/tilting-slice-equivalence -/

/-- The slice functor sends an arrow and its commuting triangles to their tilts. -/
def sliceTiltFunctor (X : Perfd p) : Over X ⥤ Over ((tiltFunctor p).obj X) where
  obj Y := Over.mk ((tiltFunctor p).map Y.hom)
  map f := Over.homMk ((tiltFunctor p).map f.left) (by
    change (tiltFunctor p).map f.left ≫ (tiltFunctor p).map _ = _
    rw [← Functor.map_comp, Over.w f]
    rfl)

instance sliceTiltFunctor_isEquivalence (X : Perfd p) :
    (sliceTiltFunctor p X).IsEquivalence := sorry

