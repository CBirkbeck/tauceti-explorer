/-! ### P6/kappa-bounded-pro-etale-presentations -/

/-- A cardinal bound on the set of all arrows of a cofiltered presentation.
The carrier is the opposite of Mathlib's Ind category; count all arrows of the index. -/
def HasKappaSmallPresentation {C : Type u} [Category.{v} C] (κ : Cardinal.{v+1}) (Z : (Ind Cᵒᵖ)ᵒᵖ) : Prop :=
  ∃ (I : Type v) (_ : SmallCategory I) (_ : IsCofiltered I) (D : I ⥤ C),
    Cardinal.lift.{v+1} #(Σ i j : I, i ⟶ j) < κ ∧
      Nonempty (Z ≅ Opposite.op ((Ind.lim Iᵒᵖ).obj D.op))

abbrev ProKappa (κ : Cardinal.{v+1}) (C : Type u) [Category.{v} C] :=
  ObjectProperty.FullSubcategory (HasKappaSmallPresentation (C := C) κ)

/-- A bounded cofiltered diagram supplies an object of the bounded pro-category. -/
theorem HasKappaSmallPresentation.of_diagram {C : Type u} [Category.{v} C]
    {κ : Cardinal.{v+1}} {I : Type v} [SmallCategory I] [IsCofiltered I]
    (D : I ⥤ C) (hD : Cardinal.lift.{v+1} #(Σ i j : I, i ⟶ j) < κ) :
    HasKappaSmallPresentation κ (Opposite.op ((Ind.lim Iᵒᵖ).obj D.op)) :=
  ⟨I, inferInstance, inferInstance, D, hD, ⟨Iso.refl _⟩⟩

variable {C : Type} [SmallCategory C]

-- Check: HasKappaSmallPresentation_constant
-- Check: proKappa_constant
