  obj i := Cat.of (qcqsEtale p (X.obj i.as.unop))
  map a := (qcqsEtaleBaseChange p (X.map a.as.unop)).toCatHom
  map₂ η := eqToHom (by
    cases LocallyDiscrete.eq_of_hom η
    rfl)
  map₂_id := by sorry
  map₂_comp := by sorry
  mapId := by sorry
  mapComp := by sorry
  map₂_whisker_left := by sorry
  map₂_whisker_right := by sorry
  map₂_associator := by sorry
  map₂_left_unitor := by sorry
  map₂_right_unitor := by sorry

/-- The unit comparison is identity pullback after the diagram's identity equation. -/
theorem finiteStageQcqsDiagram_mapId_hom_app (i : I) (T : qcqsEtale p (X.obj i)) :
    (((finiteStageQcqsDiagram p X).mapId ⟨Opposite.op i⟩).hom.toNatTrans.app T).hom.hom =
      eqToHom (congrArg (fun f ↦ (Over.pullback f).obj T.obj.obj) (X.map_id i)) ≫
        Over.pullbackId.hom.app T.obj.obj := sorry

