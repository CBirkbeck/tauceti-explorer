/-! ### Layer 5: The general Tate-pair spectral comparison -/
namespace PerfectoidSpace
universe u
/-! ### P5/spa-of-filtered-colimit-of-tate-pairs -/

/-- A Tate pair with a specified algebraic colimit ring; no completeness is included. -/
structure TateColimitModel {J : Type u} [SmallCategory J] (D : J ⥤ CommRingCat.{u}) where
  carrier : Type u
  [ring : CommRing carrier]
  [topology : TopologicalSpace carrier]
  [topologicalRing : IsTopologicalRing carrier]
  [tate : IsTateRing carrier]
  pair : Pair carrier
  ringEquiv : carrier ≃+* (↥(colimit D))
attribute [instance] TateColimitModel.ring TateColimitModel.topology
  TateColimitModel.topologicalRing TateColimitModel.tate
instance {J : Type u} [SmallCategory J] (D : J ⥤ CommRingCat.{u}) :
    CoeSort (TateColimitModel D) (Type u) := ⟨TateColimitModel.carrier⟩

/-- KL15 2.6.3: the topology is defined using compatible bounded rings of definition.
No completeness, uniformity or injectivity hypothesis is imposed on the stages. -/
theorem tateColimit_spectrum {J : Type u} [SmallCategory J] [IsFiltered J]
    (D : J ⥤ CommRingCat.{u})
    [∀ j, TopologicalSpace (D.obj j)] [∀ j, IsTopologicalRing (D.obj j)]
    [∀ j, IsTateRing (D.obj j)] (P : ∀ j, Pair (D.obj j))
    (f : ∀ {i j}, (i ⟶ j) → Pair.Hom (P i) (P j))
    (hf : ∀ {i j} (a : i ⟶ j), (f a).toRingHom = (D.map a).hom)
    (A₀ : ∀ j, Subring (D.obj j))
    (hopen : ∀ j, IsOpen (A₀ j : Set (D.obj j)))
    (hplus : ∀ j, A₀ j ≤ (P j).plus)
    (hmap : ∀ {i j} (a : i ⟶ j) (x : D.obj i), x ∈ A₀ i → D.map a x ∈ A₀ j)
    (t : ∀ j, A₀ j) (ht : ∀ j, IsPseudoUniformizer (t j : D.obj j))
    (htop : ∀ j, IsAdic (Ideal.span {t j}))
    (htmap : ∀ {i j} (a : i ⟶ j), D.map a (t i) = (t j : D.obj j)) (j₀ : J) :
    ∃ M : TateColimitModel D,
      let ι : ∀ j, D.obj j →+* M := fun j ↦ M.ringEquiv.symm.toRingHom.comp (colimit.ι D j).hom
      let L₀ : Subring M := Subring.closure (⋃ j, ι j '' (A₀ j : Set (D.obj j)))
      M.pair.plus = Subring.closure (⋃ j, ι j '' ((P j).plus : Set (D.obj j))) ∧
      (𝓝 (0 : M)).HasBasis (fun n : ℕ ↦ 0 ≤ n)
        (fun n ↦ {x | ∃ y : L₀, x = (ι j₀ (t j₀)) ^ n * y.val}) ∧
      ∃ g : ∀ j, Pair.Hom (P j) M.pair,
        (∀ j, (g j).toRingHom = ι j) ∧
        ∃ e : spa M.pair.plus ≃ₜ
          {x : ∀ j, spa (P j).plus //
            ∀ (i j : J) (a : i ⟶ j), (f a).spaComap (x j) = x i},
          (∀ (x : spa M.pair.plus) j, (e x).val j = (g j).spaComap x) ∧
          ∀ (T : Finset M) (s : M), Ideal.span (T : Set M) = ⊤ →
            ∃ (j : J) (Tj : Finset (D.obj j)) (sj : D.obj j),
              Ideal.span (Tj : Set (D.obj j)) = ⊤ ∧
              {x : spa M.pair.plus | x.val ∈ rationalSubset M.pair.plus T s} =
                (g j).spaComap ⁻¹'
                  {x : spa (P j).plus | x.val ∈ rationalSubset (P j).plus Tj sj} := sorry

-- Check: tateColimitModel_zero
example {J : Type u} [SmallCategory J] (D : J ⥤ CommRingCat.{u})
    (M : TateColimitModel D) [Subsingleton (↥(colimit D))] : Subsingleton M :=
  ⟨fun _ _ ↦ M.ringEquiv.injective (Subsingleton.elim _ _)⟩
-- Check: tateColimitModel_nonzero
example {J : Type u} [SmallCategory J] (D : J ⥤ CommRingCat.{u})
    (M : TateColimitModel D) [Nontrivial (↥(colimit D))] : Nontrivial M := sorry
-- Check: tateColimitModel_terminal
example {J : Type u} [SmallCategory J] (D : J ⥤ CommRingCat.{u})
    (M : TateColimitModel D) (j : J) (hj : IsTerminal j) :
    Function.Bijective (M.ringEquiv.symm.toRingHom.comp (colimit.ι D j).hom) := sorry
end PerfectoidSpace

/-! ### Layer 5: The contracting disc and the failure of uncompleted limits -/
namespace Perfectoid
open PerfectoidSpace
variable (p : ℕ) [Fact p.Prime] (K : AffinoidField p) (ϖ : PseudoUniformizerRoots p K)

/-- Each step scales every chosen root coordinate by the corresponding root of ϖ. -/
def contractingDiscDiagram : ℕ ⥤ PairCat.{0} p where
  obj _ := discPair p K ϖ
  map a := { toRingHom := by sorry
             continuous_toRingHom := by sorry
             map_mem_plus := by sorry }
  map_id := by sorry
  map_comp := by sorry

theorem contractingDiscDiagram_scalar {n m : ℕ} (a : n ⟶ m) (c : K) :
    ((contractingDiscDiagram p K ϖ).map a).toRingHom
      (algebraMap K (perfectedTateAlgebra p ϖ Unit) c) =
    algebraMap K (perfectedTateAlgebra p ϖ Unit) c := sorry

theorem contractingDiscDiagram_root {n m : ℕ} (a : n ⟶ m) (r : ℕ) :
    ((contractingDiscDiagram p K ϖ).map a).toRingHom (perfectedTateAlgebra.rootX ϖ () r) =
      algebraMap K (perfectedTateAlgebra p ϖ Unit) ((ϖ.root r) ^ (m - n)) *
        perfectedTateAlgebra.rootX ϖ () r := sorry

