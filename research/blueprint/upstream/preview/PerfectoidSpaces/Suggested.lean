example (A : Algebra S) : Nonempty
    (tensor S A ((toAlmost S).obj (CommAlgCat.of V (Fin 2 → V))) ≅ prod S A A) := sorry

/-- Invert an element of the setup ideal in the algebra of almost elements. -/
def invert (ε : V) (_hε : ε ∈ S.ideal) : Algebra S ⥤ CommAlgCat.{u} V where
  obj A := CommAlgCat.of V (Localization.Away (algebraMap V ((elements S).obj A) ε))
  map := by intros; exact sorry
  map_id := by sorry
  map_comp := by sorry

