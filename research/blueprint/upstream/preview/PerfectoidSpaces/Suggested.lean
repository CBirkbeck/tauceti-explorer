section KummerExamples

variable (p : ℕ) [Fact p.Prime]

/-- The completed field generated by one specified compatible root sequence. -/
def kummerField (r : ℕ → ℂ_[p]) : Subfield ℂ_[p] :=
  (Subfield.closure (Set.range r)).topologicalClosure

theorem kummerField_eq (r : ℕ → ℂ_[p]) :
    kummerField p r = (Subfield.closure (Set.range r)).topologicalClosure := rfl

/-- The integers of a subfield of C_p inherit the valuation on C_p. -/
def kummerIntegersMap (K L : Subfield ℂ_[p]) (h : K ≤ L) :
    (PadicComplexInt p).comap K.subtype →+* (PadicComplexInt p).comap L.subtype where
  toFun x := ⟨⟨x.val.val, h x.val.property⟩, x.property⟩
  map_zero' := rfl
  map_one' := rfl
  map_add' := by intros; rfl
  map_mul' := by intros; rfl

theorem kummerIntegersMap_apply (K L : Subfield ℂ_[p]) (h : K ≤ L)
    (x : (PadicComplexInt p).comap K.subtype) :
    (kummerIntegersMap p K L h x).val.val = x.val.val := rfl

-- Check: kummerField_zero
example : kummerField p (fun _ ↦ 0) =
    (Subfield.closure (Set.range (algebraMap ℚ_[p] ℂ_[p]))).topologicalClosure := sorry
-- Check: kummerField_roots
example (r : ℕ → ℂ_[p]) (hzero : r 0 = p) (hroot : ∀ n, r (n + 1) ^ p = r n) (n : ℕ) :
    r n ∈ kummerField p r ∧ ‖r n‖ ^ (p ^ n) = (p : ℝ)⁻¹ := sorry
-- Check: kummerField_quadratic
example (r : ℕ → ℂ_[p]) (hzero : r 0 = p) (hroot : ∀ n, r (n + 1) ^ p = r n)
    (hp : p ≠ 2) (z : ℂ_[p]) (hz : z ^ 2 = p) : z ∉ kummerField p r := sorry
-- Check: kummerIntegersMap_identity
example (K : Subfield ℂ_[p]) :
    kummerIntegersMap p K K le_rfl = RingHom.id _ := rfl
-- Check: kummerIntegersMap_composition
example (K L M : Subfield ℂ_[p]) (h : K ≤ L) (k : L ≤ M) :
    (kummerIntegersMap p L M k).comp (kummerIntegersMap p K L h) =
      kummerIntegersMap p K M (h.trans k) := rfl
-- Check: kummerIntegersMap_prime
example (K L : Subfield ℂ_[p]) (h : K ≤ L) :
    kummerIntegersMap p K L h (p : (PadicComplexInt p).comap K.subtype) = p := by simp

-- Check: kummerIntegersMap_quadratic_not_surjective
example (r : ℕ → ℂ_[p]) (hzero : r 0 = p) (hroot : ∀ n, r (n + 1) ^ p = r n)
    (hp : p ≠ 2) (z : ℂ_[p]) (hz : z ^ 2 = p) :
    let K := kummerField p r
    let L := Subfield.closure ((K : Set ℂ_[p]) ∪ {z})
    ∀ hKL : K ≤ L, ¬ Function.Surjective (kummerIntegersMap p K L hKL) := sorry

