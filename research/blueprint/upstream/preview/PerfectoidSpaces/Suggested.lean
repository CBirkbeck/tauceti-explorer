  [IsTopologicalRing C] [IsTateRing C] [CompleteSpace C] [T2Space C]
  [Fact (IsBounded (powerBoundedSubring C : Set C))]
  [Fact (IsTopologicallyNilpotent (p : C))] [IsPerfectoidTateRing p C]
theorem equivTilt_map (f : B →+* C) (hf : Continuous f) :
    (equivTilt (p := p) (B := C)).toRingHom.comp (map (p := p) f hf) =
      (tilt.map p f hf).comp (equivTilt (p := p) (B := B)).toRingHom := sorry
end uniformTilt
