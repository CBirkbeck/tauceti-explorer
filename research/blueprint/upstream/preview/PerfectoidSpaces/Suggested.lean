/-! ### Layer 4: Perfectoid disc and annulus tests -/
namespace PerfectoidSpace
open Perfectoid TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]

/-- The closed disc uses the completed root-polynomial algebra of P1. -/
def discPair (K : AffinoidField p) (π : PseudoUniformizerRoots p K) : PairCat.{0} p :=
  { carrier := perfectedTateAlgebra p π Unit,
    pair := Pair.powerBounded (perfectedTateAlgebra p π Unit) }

/-- The nth inner radius is the nth chosen root of the small unit. -/
def discAnnulus (K : AffinoidField p) (π : PseudoUniformizerRoots p K) (n : ℕ) :
    RationalOpen p (discPair p K π) :=
  ⟨{x | x.val.toValuativeRel.vle
      (algebraMap K (perfectedTateAlgebra p π Unit) (π.root n))
      (perfectedTateAlgebra.rootX π () 0)}, by sorry⟩

def annulusSystem (K : AffinoidField p) (π : PseudoUniformizerRoots p K) :
    RationalSystem p (discPair p K π) where
  family := Set.range (discAnnulus p K π)
  nonempty := ⟨_, ⟨0, rfl⟩⟩
  filtered := by sorry

/-- The closed unit annulus, including all compatible inverse roots. -/
def unitAnnulus (K : AffinoidField p) (π : PseudoUniformizerRoots p K) :
    RationalOpen p (discPair p K π) :=
  ⟨{x | x.val.toValuativeRel.vle 1 (perfectedTateAlgebra.rootX π () 0)}, by sorry⟩

def openUnitDisc (K : AffinoidField p) (π : PseudoUniformizerRoots p K) :
    TopologicalSpace.Opens ((underlyingPoints p) (ofPair p (discPair p K π))) where
  carrier := {x | ∃ n : ℕ, 0 < n ∧ (spaSpaceEquiv p (discPair p K π) x).down.val.toValuativeRel.vle
    (perfectedTateAlgebra.rootX π () 0 ^ n)
    (algebraMap K (perfectedTateAlgebra p π Unit) (π.root 0))}
  is_open' := by sorry

/-- The Gauss valuation, specified on finite root polynomials by their maximum coefficient norm. -/
def gaussPoint (K : AffinoidField p) (π : PseudoUniformizerRoots p K) :
    spa (discPair p K π).pair.plus := sorry

theorem gaussPoint_polynomial (K : AffinoidField p) (π : PseudoUniformizerRoots p K)
    (c : pPowerExponents p →₀ K) (a : K) :
    (gaussPoint p K π).val.toValuativeRel.vle
      (c.sum fun e b ↦ algebraMap K (perfectedTateAlgebra p π Unit) b *
        perfectedTateAlgebra.X p π Unit () e)
      (algebraMap K (perfectedTateAlgebra p π Unit) a) ↔ ∀ e, ‖c e‖ ≤ ‖a‖ := sorry

theorem gaussPoint_support (K : AffinoidField p) (π : PseudoUniformizerRoots p K) :
    (gaussPoint p K π).val.supp = ⊥ := sorry

theorem gaussPoint_rankOne (K : AffinoidField p) (π : PseudoUniformizerRoots p K) :
    ∀ x, x ⤳ gaussPoint p K π → x = gaussPoint p K π := sorry

