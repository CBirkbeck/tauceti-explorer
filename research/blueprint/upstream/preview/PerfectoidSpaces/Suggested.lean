/-- Stacks 08SP: flat lifting across a square-zero extension of the base.
The classical almost setup gives the category of ordinary commutative algebras. -/
theorem flatDeformation (R T : Type) [CommRing R] [CommRing T] [Algebra R T]
    [Module.Flat R T] (I : ModuleCat.{0} R)
    (E : SquareZeroExtension ℤ R I) :
    let S := Almost.BasicSetup.classical ℤ
    let F := Almost.Algebra.toAlmost S
    let q := F.map (CommAlgCat.ofHom
      (IsScalarTower.toAlgHom ℤ E.presentation.Ring R))
    let f := F.map (CommAlgCat.ofHom (IsScalarTower.toAlgHom ℤ R T))
    let J := (DerivedCategory.singleFunctor (ModuleCat.{0} T) 0).obj (ModuleCat.of T (T ⊗[R] I))
    ∃ ω : object R T ⟶ J⟦(2 : ℤ)⟧,
      (ω = 0 ↔ Nonempty (Almost.FlatDeformation S q f)) ∧
      (ω = 0 → Nonempty (AddTorsor (object R T ⟶ J⟦(1 : ℤ)⟧)
        (Quotient (Almost.flatDeformationSetoid S q f)))) ∧
      ∀ D : Almost.FlatDeformation S q f,
        ∃ e : {g : D.algebra ≅ D.algebra //
          D.map ≫ g.hom = D.map ∧ g.hom ≫ D.reduction = D.reduction} ≃ (object R T ⟶ J),
          e ⟨Iso.refl _, by simp⟩ = 0 := sorry
end TauCetiRoadmap.PerfectoidSpaces.CotangentComplex
