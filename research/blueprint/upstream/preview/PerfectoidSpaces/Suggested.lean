    let Q := Huber.Pair.finiteEtale (Pair.tilt p P) T
    let f := Huber.Pair.finiteEtale.hom (Pair.tilt p P) T
    let J := (RingHom.ker (tilt.theta p P)).map
      (WittVector.map (f.toRingHom.restrict _ _ f.map_mem_plus))
    let B : PairCat.{u} p := ⟨R, P⟩
    let V := (finiteEtalePairFunctor p ((PairCat.tiltFunctor p).obj B)).obj T
    let X := PairCat.sliceTriple p B V
    letI : Algebra R (Perfectoid.untilt p Q J) :=
