section CompletionRemainder
variable (A : Type u) [CommRing A] (t : A)
/-- Bhatt 5.1.1: the infinitesimal kernel is t-divisible when t is regular. -/
theorem adicCompletion_kernel_divisible (ht : t ∈ nonZeroDivisors A) :
    RingHom.ker (algebraMap A (AdicCompletion (Ideal.span {t}) A)) =
      ⨅ n : ℕ, Ideal.span {t} ^ n ∧
    (⨅ n : ℕ, Ideal.span {t} ^ n) = Ideal.span {t} * (⨅ n : ℕ, Ideal.span {t} ^ n) := sorry

theorem adicCompletion_separatedQuotient (ht : t ∈ nonZeroDivisors A)
    [IsIntegrallyClosedIn A (Localization.Away t)] :
    let K := RingHom.ker (algebraMap A (AdicCompletion (Ideal.span {t}) A))
    Ideal.Quotient.mk K t ∈ nonZeroDivisors (A ⧸ K) ∧
      IsIntegrallyClosedIn (A ⧸ K) (Localization.Away (Ideal.Quotient.mk K t)) := sorry

/-- Bhatt 5.1.1: root closure survives completion, without separatedness of the source. -/
theorem adicCompletion_rootClosed (q : ℕ) (hq : 1 < q)
    (ht : t ∈ nonZeroDivisors A)
    (hroot : ∀ x : Localization.Away t, x ^ q ∈ (algebraMap A _).range →
      x ∈ (algebraMap A _).range) :
    let B := AdicCompletion (Ideal.span {t}) A
    ∀ x : Localization.Away (algebraMap A B t),
      x ^ q ∈ (algebraMap B _).range → x ∈ (algebraMap B _).range := sorry
end CompletionRemainder
end Perfectoid

/-! ### Layer 5: Global limits, topology and finite-stage recognition -/
namespace PerfectoidSpace
open Perfectoid TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]
variable {I : Type} [SmallCategory I] [hI : IsCofiltered I]
  (X : I ⥤ Perfd p) (hX : ∀ i, IsAffinoidPerfectoid p (X.obj i).obj)

/-! ### P5/cofiltered-limits-of-affinoid-perfectoid-spaces -/

/-- ECD 6.5: the limit object, characterized by the cone and its universal property. -/
def cofilteredLimit {I : Type} [SmallCategory I] [IsCofiltered I] (X : I ⥤ Perfd p)
    (hX : ∀ i, IsAffinoidPerfectoid p (X.obj i).obj) : Perfd p := sorry
namespace cofilteredLimit

def π (i : I) : cofilteredLimit p X hX ⟶ X.obj i := sorry

theorem π_comp {i j : I} (a : j ⟶ i) :
    π p X hX j ≫ X.map a = π p X hX i := sorry

def cone : Cone X where
  pt := cofilteredLimit p X hX
  π := { app := π p X hX, naturality := by sorry }

def isLimit : IsLimit (cone p X hX) := sorry

def lift (s : Cone X) : s.pt ⟶ cofilteredLimit p X hX := (isLimit p X hX).lift s

theorem lift_π (s : Cone X) (i : I) : lift p X hX s ≫ π p X hX i = s.π.app i :=
  (isLimit p X hX).fac s i

theorem hom_ext {Y : Perfd p} (f g : Y ⟶ cofilteredLimit p X hX)
    (h : ∀ i, f ≫ π p X hX i = g ≫ π p X hX i) : f = g :=
  (isLimit p X hX).hom_ext h

theorem isAffinoid : IsAffinoidPerfectoid p (cofilteredLimit p X hX).obj := sorry

/-! ### P5/limit-underlying-space-homeomorphism -/

/-- Compatible tuples, with the subspace topology of the product. -/
def homeomorph : underlyingPoints p (cofilteredLimit p X hX) ≃ₜ
    {x : ∀ i, underlyingPoints p (X.obj i) //
      ∀ (i j : I) (a : i ⟶ j), pointMap p (X.map a) (x i) = x j} := sorry

theorem homeomorph_apply (x : underlyingPoints p (cofilteredLimit p X hX)) (i : I) :
    (homeomorph p X hX x).val i = pointMap p (π p X hX i) x := sorry

def isoOfInitial {I' : Type} [SmallCategory I'] [IsCofiltered I']
    (G : I' ⥤ I) [G.Initial] :
    cofilteredLimit p (G ⋙ X) (fun i ↦ hX (G.obj i)) ≅ cofilteredLimit p X hX := sorry

theorem isoOfInitial_π {I' : Type} [SmallCategory I'] [IsCofiltered I']
    (G : I' ⥤ I) [G.Initial] (i : I') :
    (isoOfInitial p X hX G).hom ≫ π p X hX (G.obj i) =
      π p (G ⋙ X) (fun i ↦ hX (G.obj i)) i := sorry

-- Check: cofilteredLimit_test_initial
example (i : I) (hi : IsInitial i) : IsIso (π p X hX i) := sorry
-- Check: cofilteredLimit_test_const
example (R : PairCat.{0} p) :
    ∃ e : cofilteredLimit p ((Functor.const I).obj (ofPair p R))
      (fun _ ↦ ⟨R, ⟨Iso.refl _⟩⟩) ≅ ofPair p R,
      ∀ i, π p ((Functor.const I).obj (ofPair p R)) (fun _ ↦ ⟨R, ⟨Iso.refl _⟩⟩) i = e.hom := sorry
-- Check: cofilteredLimit_test_empty_stage
example (i : I) [IsEmpty (underlyingPoints p (X.obj i))] :
    IsEmpty (underlyingPoints p (cofilteredLimit p X hX)) := sorry
-- Check: cofilteredLimit_lift_identity
example : lift p X hX (cone p X hX) = 𝟙 _ := sorry
-- Check: cofilteredLimit_lift_empty
example (Y : Perfd p) [IsEmpty (underlyingPoints p Y)]
    (s t : Cone X) (hs : s.pt = Y) (ht : t.pt = Y) :
    HEq (lift p X hX s) (lift p X hX t) := sorry
end cofilteredLimit

/-! ### P5/integral-sections-are-varpi-complete -/

/-- ECD 6.5: on every affinoid chart the same section is a small unit. -/
theorem integral_sections_adicComplete (Y : Perfd p) (t : globalPlus p Y)
    (ht : ∀ C : Chart p Y, IsPseudoUniformizer (t.val.val C)) :
    t ∈ nonZeroDivisors (globalPlus p Y) ∧
      IsAdicComplete (Ideal.span {t}) (globalPlus p Y) := sorry

/-! ### P5/finite-stage-faithfulness -/

/-- ECD 6.4(ii): eventual equality of maps between qcqs étale objects. -/
theorem finiteStage_faithfulness (i : I) (Y Z : smallEtale p (X.obj i))
    (hY : QuasiCompact p Y.obj.hom ∧ QuasiSeparated p Y.obj.hom)
    (hZ : QuasiCompact p Z.obj.hom ∧ QuasiSeparated p Z.obj.hom)
    (f g : Y ⟶ Z)
    (hfg : (etaleBaseChange p (cofilteredLimit.π p X hX i)).map f =
      (etaleBaseChange p (cofilteredLimit.π p X hX i)).map g) :
    ∃ (j : I) (a : j ⟶ i), (etaleBaseChange p (X.map a)).map f =
      (etaleBaseChange p (X.map a)).map g := sorry

/-- Surjectivity of a morphism of qcqs étale objects is eventually visible. -/
theorem finiteStage_surjectivity (i : I) (Y Z : smallEtale p (X.obj i))
    (hY : QuasiCompact p Y.obj.hom ∧ QuasiSeparated p Y.obj.hom)
    (hZ : QuasiCompact p Z.obj.hom ∧ QuasiSeparated p Z.obj.hom) (f : Y ⟶ Z)
    (hf : Function.Surjective (pointMap p
      ((etaleBaseChange p (cofilteredLimit.π p X hX i)).map f).hom.left)) :
    ∃ (j : I) (a : j ⟶ i), Function.Surjective
      (pointMap p ((etaleBaseChange p (X.map a)).map f).hom.left) := sorry

/-! ### P5/finite-stage-isomorphism-detection -/

theorem finiteStage_isomorphism (i : I) (Y Z : smallEtale p (X.obj i))
    (hY : QuasiCompact p Y.obj.hom ∧ QuasiSeparated p Y.obj.hom)
    (hZ : QuasiCompact p Z.obj.hom ∧ QuasiSeparated p Z.obj.hom) (f : Y ⟶ Z)
    (hf : IsIso ((etaleBaseChange p (cofilteredLimit.π p X hX i)).map f)) :
    ∃ (j : I) (a : j ⟶ i), IsIso ((etaleBaseChange p (X.map a)).map f) := sorry

/-! ### P5/separatedness-recognition-at-finite-stage -/

theorem finiteStage_separatedness (i : I) (Y : smallEtale p (X.obj i))
    (hY : QuasiCompact p Y.obj.hom ∧ QuasiSeparated p Y.obj.hom)
    (hf : IsSeparated p
      ((etaleBaseChange p (cofilteredLimit.π p X hX i)).obj Y).obj.hom) :
    ∃ (j : I) (a : j ⟶ i), IsSeparated p ((etaleBaseChange p (X.map a)).obj Y).obj.hom := sorry

/-! ### P5/qcqs-etale-essential-surjectivity -/

/-- The lift is an isomorphism over the limit, so its descent data is retained. -/
theorem finiteStage_essentialSurjectivity
    (Y : smallEtale p (cofilteredLimit p X hX))
    (hY : QuasiCompact p Y.obj.hom ∧ QuasiSeparated p Y.obj.hom) :
    ∃ (i : I) (Yᵢ : smallEtale p (X.obj i)),
      (QuasiCompact p Yᵢ.obj.hom ∧ QuasiSeparated p Yᵢ.obj.hom) ∧
      Nonempty ((etaleBaseChange p (cofilteredLimit.π p X hX i)).obj Yᵢ ≅ Y) := sorry
end PerfectoidSpace

/-! ### Layer 5: Filtered pseudocolimits from the supplied Grothendieck construction -/
namespace CategoryTheory
open _root_.CategoryTheory.Pseudofunctor
universe v u w
variable {J : Type u} [SmallCategory J] [hJ : IsFiltered J]
  (F : Pseudofunctor (LocallyDiscrete J) Cat.{v, w})

/-! ### P5/filtered-two-colimit-of-categories -/

/-- The arrows to invert are exactly those whose fibre component is invertible. -/
def filteredTransitionArrows : MorphismProperty (Pseudofunctor.Grothendieck F) :=
  fun _ _ f ↦ IsIso f.fiber

/-- The pseudocolimit localizes the Grothendieck category at its transport arrows. -/
abbrev FilteredTwoColimit := (filteredTransitionArrows F).Localization

namespace FilteredTwoColimit
/-- The inclusion sends x to the localization of (j,x). -/
def ι (j : J) : F.obj ⟨j⟩ ⥤ FilteredTwoColimit F := sorry

theorem ι_obj (j : J) (x : F.obj ⟨j⟩) :
    (ι F j).obj x = (filteredTransitionArrows F).Q.obj ⟨j, x⟩ := sorry

def ιCompIso {i j : J} (a : i ⟶ j) :
    (F.map ⟨a⟩).toFunctor ⋙ ι F j ≅ ι F i := sorry

variable {C : Type w} [Category.{v} C]
/-- A coherent pseudococone is Mathlib's strong transformation to the constant diagram. -/
def desc (G : Pseudofunctor.StrongTrans F ((Functor.const J).obj (Cat.of C)).toPseudofunctor') :
    FilteredTwoColimit F ⥤ C := sorry

def ιCompDescIso
    (G : Pseudofunctor.StrongTrans F ((Functor.const J).obj (Cat.of C)).toPseudofunctor') (j : J) :
    ι F j ⋙ desc F G ≅ (G.app ⟨j⟩).toFunctor := sorry

/-- Full faithfulness and essential surjectivity are tested at finite stages. -/
theorem isEquivalence_desc_iff
    (G : Pseudofunctor.StrongTrans F ((Functor.const J).obj (Cat.of C)).toPseudofunctor') :
    (desc F G).IsEquivalence ↔
      (∀ (i j : J) (x : F.obj ⟨i⟩) (y : F.obj ⟨j⟩),
        Function.Bijective (fun f : (ι F i).obj x ⟶ (ι F j).obj y ↦
          (ιCompDescIso F G i).inv.app x ≫ (desc F G).map f ≫
            (ιCompDescIso F G j).hom.app y)) ∧
      (∀ c : C, ∃ (j : J) (x : F.obj ⟨j⟩), Nonempty ((G.app ⟨j⟩).toFunctor.obj x ≅ c)) := sorry

/-- Objects do not need to be identified when they acquire an isomorphism at a later stage. -/
theorem eventually_isomorphic {i j : J} (a : i ⟶ j) (x y : F.obj ⟨i⟩)
    (h : Nonempty ((F.map ⟨a⟩).toFunctor.obj x ≅ (F.map ⟨a⟩).toFunctor.obj y)) :
    Nonempty ((ι F i).obj x ≅ (ι F i).obj y) := sorry

/-- The constant pseudofunctor uses Mathlib's exact constructor. -/
def equivConst {J : Type u} [SmallCategory J] [IsFiltered J] (C : Type w) [Category.{v} C] :
    FilteredTwoColimit (((Functor.const J).obj (Cat.of C)).toPseudofunctor') ≌ C := sorry

-- Check: filteredTwoColimit_test_const
example :
    let F := (((Functor.const (Discrete PUnit)).obj (Cat.of (Discrete Bool))).toPseudofunctor')
    let a := (ι F (Discrete.mk PUnit.unit)).obj (Discrete.mk false)
    let b := (ι F (Discrete.mk PUnit.unit)).obj (Discrete.mk true)
    Nat.card (a ⟶ a) = 1 ∧ Nat.card (b ⟶ b) = 1 ∧ IsEmpty (a ⟶ b) := sorry
-- Check: filteredTwoColimit_empty
example : IsEmpty (FilteredTwoColimit
    (((Functor.const J).obj (Cat.of (Discrete PEmpty.{w+1}))).toPseudofunctor')) := sorry
-- Check: filteredTwoColimit_bool
example (j : J) :
    let F := (((Functor.const J).obj (Cat.of (Discrete Bool))).toPseudofunctor')
    IsEmpty ((ι F j).obj (Discrete.mk false) ⟶ (ι F j).obj (Discrete.mk true)) := sorry
-- Check: filteredTwoColimit_test_notNaive
example :
    let D : Fin 2 ⥤ Cat :=
      { obj := fun i ↦ if i = 0 then Cat.of (Discrete Bool) else Cat.of (Discrete PUnit)
        map := by sorry
        map_id := by sorry
        map_comp := by sorry }
    let F := D.toPseudofunctor'
    let a : F.obj ⟨0⟩ := Discrete.mk false
    let b : F.obj ⟨0⟩ := Discrete.mk true
    IsEmpty (a ⟶ b) ∧ Nat.card ((ι F 0).obj a ⟶ (ι F 0).obj b) = 1 ∧
      Nonempty ((ι F 0).obj a ≅ (ι F 0).obj b) := sorry
end FilteredTwoColimit
end CategoryTheory

/-! ### Layer 5: The geometric descent functors -/
namespace PerfectoidSpace
open Perfectoid TauCetiRoadmap.AdicEtaleGeometry CategoryTheory
variable (p : ℕ) [Fact p.Prime]

/-- Adic representatives of perfectoid Yoneda spaces, with arrows transported through
A1's fully faithful embedding. ECD Definition 3.19, p. 18. -/
def toAdicSpace : Perfd p ⥤ TauCeti.AdicSpace.{0} where
  obj X := (locallyStronglySheafy p X).choose
  map {X Y} f := YonedaAdicSpace.ofAdicSpace.preimage
    ((locallyStronglySheafy p X).choose_spec.2.some.hom ≫ f.hom ≫
      (locallyStronglySheafy p Y).choose_spec.2.some.inv)
  map_id := by sorry
  map_comp := by sorry

/-- The comparison identifies both objects and morphisms with the given Yoneda spaces. -/
theorem toAdicSpace_spec :
    Nonempty (toAdicSpace p ⋙ YonedaAdicSpace.ofAdicSpace ≅
      ObjectProperty.ι (IsPerfectoidSpace p)) := by sorry

-- Check: toAdicSpace_empty
example (X : Perfd p) [IsEmpty (underlyingPoints p X)] :
    IsEmpty ((toAdicSpace p).obj X).obj := sorry
-- Check: toAdicSpace_affinoid
example (R : PairCat.{0} p) :
    ∃ hR : (CAff.of R.pair).Sheafy,
      Nonempty ((toAdicSpace p).obj (ofPair p R) ≅ (CAff.of R.pair).adicSpa hR) := sorry
-- Check: toAdicSpace_nonidentity
example (X : Perfd p) (f : X ⟶ X) (hf : f ≠ 𝟙 X) :
    (toAdicSpace p).map f ≠ 𝟙 ((toAdicSpace p).obj X) := sorry

/-- Compactness and separation are imposed on the actual arrow in the étale slice. -/
abbrev qcqsEtale (X : Perfd p) := ObjectProperty.FullSubcategory
  (fun Y : smallEtale p X ↦
    TauCetiRoadmap.AdicSpacesPartII.AdicSpace.QuasiCompact ((toAdicSpace p).map Y.obj.hom) ∧
    TauCetiRoadmap.AdicSpacesPartII.AdicSpace.QuasiCompact
      ((toAdicSpace p).map (pullback.diagonal Y.obj.hom)))

-- Check: qcqsEtale_identity
example (X : Perfd p) :
    ∃ U : qcqsEtale p X, U.obj.obj = Over.mk (𝟙 X) := sorry

-- Check: qcqsEtale_empty
example (X : Perfd p) :
    ∃ U : qcqsEtale p X, U.obj.obj = Over.mk (restrictι p X ⊥) := sorry

-- Check: qcqsEtale_noncompact
example (X : Perfd p) (U : smallEtale p X)
    (hU : ¬ TauCetiRoadmap.AdicSpacesPartII.AdicSpace.QuasiCompact
      ((toAdicSpace p).map U.obj.hom)) :
    ¬ ∃ V : qcqsEtale p X, V.obj = U := by
  rintro ⟨V, rfl⟩
  exact hU V.property.1

abbrev qcSeparatedEtale (X : Perfd p) := ObjectProperty.FullSubcategory
  (fun Y : smallEtale p X ↦ QuasiCompact p Y.obj.hom ∧ IsSeparated p Y.obj.hom)

variable {I : Type} [SmallCategory I] [hI : IsCofiltered I]
  (X : I ⥤ Perfd p) (hX : ∀ i, IsAffinoidPerfectoid p (X.obj i).obj)

/-! ### P5/finite-etale-finite-stage-approximation -/

/-- Pullback gives the pseudofunctor of finite étale spaces over the stages. -/
def finiteStageFiniteEtaleDiagram : Pseudofunctor (LocallyDiscrete Iᵒᵖ) Cat.{1, 2} where
  obj i := Cat.of (smallFiniteEtale p (X.obj i.as.unop))
  map a := (finiteEtaleBaseChange p (X.map a.as.unop)).toCatHom
  map₂ η := eqToHom (by
    cases LocallyDiscrete.eq_of_hom η
    rfl)
  map₂_id := by sorry
  map₂_comp := by sorry
  mapId := by sorry
  mapComp := by sorry
  map₂_whisker_left := by sorry
  map₂_whisker_right := by sorry
  map₂_associator := by sorry
  map₂_left_unitor := by sorry
  map₂_right_unitor := by sorry

/-- The unit comparison is identity pullback after the diagram's identity equation. -/
theorem finiteStageFiniteEtaleDiagram_mapId_hom_app (i : I) (T : smallFiniteEtale p (X.obj i)) :
    (((finiteStageFiniteEtaleDiagram p X).mapId ⟨Opposite.op i⟩).hom.toNatTrans.app T).hom =
      eqToHom (congrArg (fun f ↦ (Over.pullback f).obj T.obj) (X.map_id i)) ≫
        Over.pullbackId.hom.app T.obj := sorry

/-- The composition comparison is canonical pullback after the diagram's composition equation. -/
theorem finiteStageFiniteEtaleDiagram_mapComp_hom_app {i j k : I} (a : j ⟶ i) (b : k ⟶ j)
    (T : smallFiniteEtale p (X.obj i)) :
    (((finiteStageFiniteEtaleDiagram p X).mapComp a.op.toLoc b.op.toLoc).hom.toNatTrans.app T).hom =
      eqToHom (congrArg (fun f ↦ (Over.pullback f).obj T.obj) (X.map_comp b a)) ≫
        (Over.pullbackComp (X.map b) (X.map a)).hom.app T.obj := sorry

-- Check: finiteStageFiniteEtaleDiagram_identity_projection
example (i : I) (T : smallFiniteEtale p (X.obj i)) :
    (((finiteStageFiniteEtaleDiagram p X).mapId ⟨Opposite.op i⟩).hom.toNatTrans.app T).hom.left =
      pullback.fst T.obj.hom (X.map (𝟙 i)) := sorry

-- Check: finiteStageFiniteEtaleDiagram_two_steps
example {i j k : I} (a : j ⟶ i) (b : k ⟶ j) (T : smallFiniteEtale p (X.obj i)) :
