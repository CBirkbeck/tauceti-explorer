namespace CotangentComplex

local instance (T : Type u) [CommRing T] : HasDerivedCategory (ModuleCat.{u} T) :=
  HasDerivedCategory.standard _

open scoped Simplicial
open Opposite

/-! ### P0/cotangent-complex-of-ring-map -/

/-- A polynomial simplicial resolution, with contraction of the augmented underlying sets.
The splitting is in sets, not in algebras; Stacks 08PL, Definitions 92.3.1–92.3.2. -/
structure PolynomialResolution (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] where
  augmentation : SimplicialObject.Augmented (CommAlgCat.{u} R)
  target : augmentation.right ≅ CommAlgCat.of R T
  vars : ℕ → Type u
  polynomial : ∀ n, augmentation.left.obj (op ⦋n⦌) ≅ CommAlgCat.of R (MvPolynomial (vars n) R)
  contraction : SimplicialObject.Augmented.ExtraDegeneracy
    (((SimplicialObject.Augmented.whiskering _ _).obj (forget (CommAlgCat.{u} R))).obj augmentation)

variable {R T : Type u} [CommRing R] [CommRing T] [Algebra R T]

namespace PolynomialResolution

abbrev ring (P : PolynomialResolution R T) (n : ℕ) := P.augmentation.left.obj (op ⦋n⦌)

instance (P : PolynomialResolution R T) (n : ℕ) : Algebra (P.ring n) T :=
  (P.augmentation.hom.app (op ⦋n⦌) ≫ P.target.hom).hom.toAlgebra

/-- Termwise differentials with coefficients in the augmented algebra. -/
def differentials (P : PolynomialResolution R T) : SimplicialObject (ModuleCat.{u} T) := sorry

/-- Each term is T tensor the differentials of the corresponding polynomial algebra. -/
def termIso (P : PolynomialResolution R T) (n : ℕ) :
    (P.differentials).obj (op ⦋n⦌) ≅
      ModuleCat.of T (T ⊗[P.ring n] KaehlerDifferential R (P.ring n)) := sorry

/-- Faces act on differentials without a sign; signs enter the alternating face complex. -/
theorem face_tmul (P : PolynomialResolution R T) (n : ℕ) (i : Fin (n + 2))
    (t : T) (x : P.ring (n + 1)) :
    (P.termIso n).hom.hom
      ((P.differentials.δ i).hom ((P.termIso (n + 1)).inv.hom
        (t ⊗ₜ[P.ring (n + 1)] KaehlerDifferential.D R (P.ring (n + 1)) x))) =
      t ⊗ₜ[P.ring n] KaehlerDifferential.D R (P.ring n) ((P.augmentation.left.δ i).hom x) := sorry

/-- Unnormalized chains give the same cotangent complex as normalized chains. -/
def complex (P : PolynomialResolution R T) : ChainComplex (ModuleCat.{u} T) ℕ :=
  (AlgebraicTopology.alternatingFaceMapComplex _).obj P.differentials

end PolynomialResolution

/-- The standard free resolution of an algebra. -/
def resolution (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] :
    PolynomialResolution R T := sorry

/-- A full nonnegative homological model of the cotangent complex. -/
def model (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] :
    ChainComplex (ModuleCat.{u} T) ℕ := (resolution R T).complex

/-- The derived cotangent complex, placed in nonpositive cohomological degrees. -/
def object (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] : DerivedCategory (ModuleCat.{u} T) :=
  DerivedCategory.Q.obj ((model R T).extend (ComplexShape.embeddingUpIntLE 0))

/-- The choice of polynomial resolution does not change the derived object. -/
def resolutionIso (P : PolynomialResolution R T) :
    DerivedCategory.Q.obj (P.complex.extend (ComplexShape.embeddingUpIntLE 0)) ≅ object R T := sorry

def homologyZeroIso : (model R T).homology 0 ≅ ModuleCat.of T (KaehlerDifferential R T) := sorry

def homologyOneIso : (model R T).homology 1 ≅ ModuleCat.of T (_root_.Algebra.H1Cotangent R T) := sorry

