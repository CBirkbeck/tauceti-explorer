    YonedaAdicSpace.IsEtaleLocalDescription f.hom ↔
      YonedaAdicSpace.IsEtaleLocalDescription ((restrictι p Y ⊤) ≫ f).hom := by
  simpa using etale_iff_openCover_source p f (fun _ : Unit ↦ ⊤)
    (fun _ ↦ ⟨(), trivial⟩)

