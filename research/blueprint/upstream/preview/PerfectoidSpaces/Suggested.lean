/-- A strongly Zariski closed map identifies its target pair with the quotient by its kernel. -/
theorem stronglyZariskiClosed_quotient_comparison {R S : PairCat.{0} p} (f : R ⟶ S)
    (hf : IsStronglyZariskiClosed_affinoid f) :
    ∃ e : (R ⧸ RingHom.ker f.toRingHom) ≃+* S,
      Continuous e ∧ Continuous e.symm ∧
      (R.pair.quotient (RingHom.ker f.toRingHom)).plus.map e.toRingHom = S.pair.plus ∧
      e.toRingHom.comp (Ideal.Quotient.mk _) = f.toRingHom := sorry

