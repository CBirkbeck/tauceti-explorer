example (U V : TopologicalSpace.Opens (spa R.pair.plus)) (h : V ≤ U)
    (s t : rationalIntegralSections p R U) (W : {W : RationalOpen p R // W.val ⊆ V}) :
    ((integralPresheaf p R).map (homOfLE h).op (s + t)).val.val W =
      s.val.val ⟨W.val, W.property.trans h⟩ + t.val.val ⟨W.val, W.property.trans h⟩ := rfl
-- Check: integral_scalar_zero
example : integralScalar p R 0 = 0 := sorry
-- Check: integral_scalar_one
example : integralScalar p R 1 = 𝟙 _ := sorry
-- Check: integral_scalar_two_terms
example (a b : R.pair.plus) : integralScalar p R (a + b) =
    integralScalar p R a + integralScalar p R b := sorry

/-! ### P2/integral-almost-acyclicity -/

/-- ECD 3.24: every topologically nilpotent integral scalar kills positive integral
Čech cohomology. The complex and its scalar map are Mathlib's functorial Čech complex. -/
theorem integral_cech_almost_acyclic (n : ℕ)
    (U : Fin n → TopologicalSpace.Opens (spa R.pair.plus))
    (hU : ∀ i, (U i : Set _) ∈ spaRationalFamily R.pair.plus) (hcover : iSup U = ⊤)
    (q : ℕ) (hq : 0 < q) (a : R.pair.plus) (ha : IsTopologicallyNilpotent a.val) :
    HomologicalComplex.homologyMap
      ((cechComplexFunctor U).map (integralScalar p R a).hom) q = 0 := sorry

/-- The degree-zero Čech differential on a two-member cover, with the order (U,V). -/
def rationalCechDifference (U V W : RationalOpen p R)
    (hU : W.val ⊆ U.val) (hV : W.val ⊆ V.val)
    (a : rationalPair p R U) (b : rationalPair p R V) : rationalPair p R W :=
  (rationalRes p R V W hV).toRingHom b - (rationalRes p R U W hU).toRingHom a
-- Check: cech_actual_two_terms
example (U V W : RationalOpen p R) (hU : W.val ⊆ U.val) (hV : W.val ⊆ V.val) :
    rationalCechDifference p R U V W hU hV 2 5 = 3 := by
  simp only [rationalCechDifference, map_ofNat]
  ring
-- Check: cech_actual_reverse
example (U V W : RationalOpen p R) (hU : W.val ⊆ U.val) (hV : W.val ⊆ V.val) :
    rationalCechDifference p R U V W hU hV 5 2 = -3 := by
  simp only [rationalCechDifference, map_ofNat]
  ring
-- Check: cech_actual_diagonal
example (U V W : RationalOpen p R) (hU : W.val ⊆ U.val) (hV : W.val ⊆ V.val) :
    rationalCechDifference p R U V W hU hV 2 2 = 0 := by
  simp only [rationalCechDifference, map_ofNat, sub_self]
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
