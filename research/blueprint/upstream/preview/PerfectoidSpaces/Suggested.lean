section StronglyZariskiClosedDef

variable {A B : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsHuberRing A]
  [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsHuberRing B] {P : Pair A}
  {Q : Pair B}

/-- The affinoid core of a strongly Zariski closed immersion (ECD Definition 5.7 (ii)):
`Spa(B, B⁺) → Spa(A, A⁺)` induced by `φ` with `A → B` surjective and `B⁺` the integral closure
of the image of `A⁺`. The plus-ring clause is part of the definition; ECD (after Definition 5.7)
records that it agrees with Torsion Definition II.2.6, since `A⁺ → B⁺` is then almost surjective
(KL15 Proposition 3.6.9 (c)). Almost surjectivity of `A⁺ → B⁺` alone, with no condition on `B⁺`,
is strictly weaker: `(A, A⁺) → (A, A°)` with `A⁺ ⊊ A°` satisfies it and is not a closed
immersion. For perfectoid `A`, `B` this is the notion of the README. -/
structure IsStronglyZariskiClosed_affinoid (φ : Pair.Hom P Q) : Prop where
  /-- `A → B` is surjective. -/
  surjective : Function.Surjective φ.toRingHom
  /-- `B⁺` is the integral closure of the image of `A⁺`. -/
  plus_eq : Q.plus = (integralClosure (P.plus.map φ.toRingHom) B).toSubring

end StronglyZariskiClosedDef

section StronglyZariskiClosedTests

variable {A : Type u} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
  [IsHuberRing A] (P : Pair A)

-- Check stronglyClosed_id: the integral closure of the plus ring is itself.
example : IsStronglyZariskiClosed_affinoid (Pair.Hom.id P) := sorry

-- Check stronglyClosed_quotient: agreement with the supplier, including I = 0 and I = ⊤.
example (I : Ideal A) : IsStronglyZariskiClosed_affinoid (Pair.quotientHom P I) := by
  exact ⟨Ideal.Quotient.mk_surjective, Pair.quotient_plus P I⟩

end StronglyZariskiClosedTests

section StronglyZariskiClosedBaseChange

variable (p : ℕ) [Fact p.Prime] {A B C : Type u}
  [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A]
  [CompleteSpace A] [T2Space A] [hA : IsPerfectoidTateRing p A]
  [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B]
  [CompleteSpace B] [T2Space B] [hB : IsPerfectoidTateRing p B]
  [CommRing C] [UniformSpace C] [IsUniformAddGroup C] [IsTopologicalRing C] [IsTateRing C]
  [CompleteSpace C] [T2Space C] [hC : IsPerfectoidTateRing p C]
  [Algebra A B] [Algebra A C] [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)]
  (S : Pair A) (T : Pair B) (U : Pair C) (hT : ∀ a ∈ S.plus, algebraMap A B a ∈ T.plus)
  (hU : ∀ a ∈ S.plus, algebraMap A C a ∈ U.plus)

-- Check completedTensor_inr_two_terms: base change uses the right-hand factor.
example (c d : C) :
    (Pair.completedTensor.inr S T U hT hU).toRingHom (c + d) =
      Pair.completedTensor.tmul A B C ((1 : B) ⊗ₜ[A] c + (1 : B) ⊗ₜ[A] d) := by
  simp [Pair.completedTensor.inr, TensorProduct.tmul_add]

include hA hB hC in
/-- If
`Spa(B, B⁺) → Spa(A, A⁺)` is strongly Zariski closed, so is its base change along any
`Spa(C, C⁺) → Spa(A, A⁺)`, `(C, C⁺) → (B ⊗̂_A C)` (Torsion Lemma II.2.9 (ii); fibre products via the
completed tensor product of Huber pairs). -/
theorem IsStronglyZariskiClosed_affinoid.baseChange
    (h : IsStronglyZariskiClosed_affinoid
      (⟨algebraMap A B, IsAdicHom.continuous _, hT⟩ : Pair.Hom S T)) :
    IsStronglyZariskiClosed_affinoid (Pair.completedTensor.inr S T U hT hU) := sorry

-- Check not_isStronglyZariskiClosed_ofPowerBounded.
/- For `R⁺ ⊊ R°` the identity `(R, R⁺) → (R, R°)` is surjective on rings and almost surjective
on plus rings (`ϖ^{1/pⁿ} R° ⊆ R°° ⊆ R⁺`), but `R° ≠ R⁺` is not the integral closure of `R⁺`, and
the image of `Spa(R, R°)`, which contains every rank-one point, is not closed. -/
example {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (P : Pair R)
    (hP : P.plus < (Pair.powerBounded R).plus) :
    let φ : Pair.Hom P (Pair.powerBounded R) := ⟨RingHom.id R, continuous_id, fun _ h ↦ hP.le h⟩
    Function.Surjective φ.toRingHom ∧
      (∀ (ϖ : PseudoUniformizerRoots p R) (n : ℕ), ∀ x ∈ (Pair.powerBounded R).plus,
        ϖ.root n * x ∈ P.plus) ∧
      ¬ IsStronglyZariskiClosed_affinoid φ ∧ ¬ IsClosed (Set.range φ.spaComap) := sorry

end StronglyZariskiClosedBaseChange

end PerfectoidSpace

