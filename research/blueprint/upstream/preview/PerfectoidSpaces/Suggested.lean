section isKappaSmall_empty_two
example {R : Type u} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [IsHuberRing R]
    [Subsingleton R] (P : Pair R) : IsKappaSmall_affinoid 2 P :=
  (isKappaSmall_affinoid_subsingleton_iff P 2).mpr (by norm_num)
