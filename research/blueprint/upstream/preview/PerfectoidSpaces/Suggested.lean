/-- The scalar action on an étale object's functions is pullback from the base affinoid. -/
def etaleScalarMap (R : PairCat.{0} p) (U : smallEtale p (ofPair p R)) :
    R →+* globalSections p U.obj.left :=
  (globalPullback p U.obj.hom).comp (globalSectionsAffinoidEquiv p R).symm.toRingHom

/-- The actual tensor presheaf for a finite projective module over the affinoid ring. -/
def etaleOCoefficients (R : PairCat.{0} p) (M : Type) [AddCommGroup M] [Module R M] :
    (smallEtale p (ofPair p R))ᵒᵖ ⥤ AddCommGrpCat.{1} where
  obj U := by
    letI := (etaleScalarMap p R U.unop).toAlgebra
    exact AddCommGrpCat.of (M ⊗[R] globalSections p U.unop.obj.left)
  map := by sorry
  map_id := by sorry
  map_comp := by sorry

theorem etaleOCoefficients_map (R : PairCat.{0} p) (M : Type) [AddCommGroup M] [Module R M]
    {U V : smallEtale p (ofPair p R)} (f : U ⟶ V) (m : M) (s : globalSections p V.obj.left) :
    letI := (etaleScalarMap p R U).toAlgebra
    letI := (etaleScalarMap p R V).toAlgebra
    (etaleOCoefficients p R M).map f.op (m ⊗ₜ[R] s) =
      m ⊗ₜ[R] globalPullback p f.hom.left s := sorry

theorem etaleOCoefficients_isSheaf (R : PairCat.{0} p) (M : Type)
    [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.Projective R M] :
    Presheaf.IsSheaf (smallEtaleTopology p (ofPair p R)) (etaleOCoefficients p R M) := sorry

def etaleOCoefficientSheaf (R : PairCat.{0} p) (M : Type)
    [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.Projective R M] :
    Sheaf (smallEtaleTopology p (ofPair p R)) AddCommGrpCat.{1} :=
  ⟨etaleOCoefficients p R M, etaleOCoefficients_isSheaf p R M⟩

