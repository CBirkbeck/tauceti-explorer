/-- The degree-zero derived Hom is the group of derivations. -/
theorem extZero (M : ModuleCat.{u} T) :
    letI : Module R M := Module.compHom M (algebraMap R T)
    Nonempty ((object R T ⟶ (DerivedCategory.singleFunctor (ModuleCat.{u} T) 0).obj M) ≃+
      _root_.Derivation R T M) := sorry


/-- A square-zero extension with its kernel identified with the prescribed target module. -/
structure SquareZeroExtension (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    (M : ModuleCat.{u} B) where
  presentation : Algebra.Extension.{u} R B
  inclusion : M →+ presentation.Ring
  injective : Function.Injective inclusion
  range_eq : Set.range inclusion = (presentation.ker : Set presentation.Ring)
  scalar : ∀ (a : presentation.Ring) (m : M),
    inclusion ((algebraMap presentation.Ring B a) • m) = a * inclusion m
  square_zero : ∀ m n : M, inclusion m * inclusion n = 0

/-- Isomorphisms preserve both the quotient and the specified kernel identification. -/
def extensionSetoid (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    (M : ModuleCat.{u} B) : Setoid (SquareZeroExtension R B M) where
  r E F := ∃ e : E.presentation.Ring ≃ₐ[R] F.presentation.Ring,
    (∀ x, algebraMap F.presentation.Ring B (e x) = algebraMap E.presentation.Ring B x) ∧
    ∀ m, e (E.inclusion m) = F.inclusion m
  iseqv := by sorry

/-- Isomorphism classes, with no choice of a splitting. -/
abbrev Exal (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    (M : ModuleCat.{u} B) := Quotient (extensionSetoid R B M)

/-- The class of the pullback of E along f. On a polynomial resolution it is the
cocycle obtained by subtracting the two lifted faces, as in `morphismObstruction_cocycle`. -/
def morphismObstruction (B : Type u) [CommRing B] [Algebra R B]
    (f : T →ₐ[R] B) (M : ModuleCat.{u} B) (E : SquareZeroExtension R B M) :
    letI : Module T M := Module.compHom M f.toRingHom
    object R T ⟶
      ((DerivedCategory.singleFunctor (ModuleCat.{u} T) 0).obj (ModuleCat.of T M))⟦(1 : ℤ)⟧ := sorry

/-- The polynomial-resolution cocycle fixes the class, including its sign.
A lift of the degree-zero free algebra always exists; every such lift gives this class. -/
theorem morphismObstruction_cocycle (B : Type u) [CommRing B] [Algebra R B]
    (f : T →ₐ[R] B) (M : ModuleCat.{u} B) (E : SquareZeroExtension R B M) :
    let P := resolution R T
    let lifts := {l : P.ring 0 →ₐ[R] E.presentation.Ring // ∀ x,
      algebraMap E.presentation.Ring B (l x) =
        f ((P.augmentation.hom.app (op ⦋0⦌) ≫ P.target.hom).hom x)}
    letI : Module T M := Module.compHom M f.toRingHom
    let N := ModuleCat.of T M
    let K := (model R T).extend (ComplexShape.embeddingUpIntLE 0)
    let J := (CochainComplex.singleFunctor (ModuleCat.{u} T) (-1)).obj N
    Nonempty lifts ∧ ∀ l : lifts, ∃ k : K ⟶ J,
      (DerivedCategory.Q.map k ≫
        ((DerivedCategory.singleFunctors (ModuleCat.{u} T)).shiftIso 1 (-1) 0 (by decide)).inv.app N =
          morphismObstruction B f M E) ∧
      ∀ x : P.ring 1,
        E.inclusion ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) (-1) N).hom
          (k.f (-1) (((model R T).extendXIso (ComplexShape.embeddingUpIntLE 0) (by rfl :
              (ComplexShape.embeddingUpIntLE 0).f 1 = (-1 : ℤ))).inv
            ((P.termIso 1).inv.hom
              (1 ⊗ₜ[P.ring 1] KaehlerDifferential.D R (P.ring 1) x))))) =
          l.val ((P.augmentation.left.δ 0).hom x) -
            l.val ((P.augmentation.left.δ 1).hom x) := sorry

/-- The extension class is the identity-pullback cocycle on isomorphism classes. -/
def extensionClass (M : ModuleCat.{u} T) : Exal R T M →
    (object R T ⟶ ((DerivedCategory.singleFunctor (ModuleCat.{u} T) 0).obj M)⟦(1 : ℤ)⟧) := sorry

/-- The quotient map uses the cocycle of this extension, with its specified kernel map. -/
theorem extensionClass_mk (M : ModuleCat.{u} T) (E : SquareZeroExtension R T M) :
    extensionClass M (Quotient.mk _ E) = morphismObstruction T (AlgHom.id R T) M E := sorry

