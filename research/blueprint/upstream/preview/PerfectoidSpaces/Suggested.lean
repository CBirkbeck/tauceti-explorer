/-- The prestack has the actual finite étale slice categories as fibres and
geometric pullback as transition functor. -/
def finiteEtalePrestack (X : Perfd p) :
    Pseudofunctor (LocallyDiscrete (smallEtale p X)ᵒᵖ) Cat.{1, 2} where
  obj U := Cat.of (smallFiniteEtale p U.as.unop.obj.left)
  map f := (finiteEtaleBaseChange p f.as.unop.hom.left).toCatHom
  map₂ η := eqToHom (by
    cases LocallyDiscrete.eq_of_hom η
    rfl)
  map₂_id := by sorry
  map₂_comp := by sorry
  mapId := by sorry
  mapComp := by sorry
  map₂_whisker_left := by sorry
  map₂_whisker_right := by sorry
  map₂_associator := by sorry
  map₂_left_unitor := by sorry
  map₂_right_unitor := by sorry

/-- The unit comparison is the canonical identity pullback in the slice. -/
theorem finiteEtalePrestack_mapId_hom_app (X : Perfd p) (U : smallEtale p X)
    (T : smallFiniteEtale p U.obj.left) :
    (((finiteEtalePrestack p X).mapId ⟨Opposite.op U⟩).hom.toNatTrans.app T).hom =
      Over.pullbackId.hom.app T.obj := sorry

/-- The composition comparison identifies direct pullback with successive pullbacks. -/
theorem finiteEtalePrestack_mapComp_hom_app (X : Perfd p)
    {U V W : smallEtale p X} (f : V ⟶ U) (g : W ⟶ V)
    (T : smallFiniteEtale p U.obj.left) :
    (((finiteEtalePrestack p X).mapComp f.op.toLoc g.op.toLoc).hom.toNatTrans.app T).hom =
      (Over.pullbackComp g.hom.left f.hom.left).hom.app T.obj := sorry

