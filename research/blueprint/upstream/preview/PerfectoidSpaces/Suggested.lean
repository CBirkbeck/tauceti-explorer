    z = algebraMap (WittVector p Q.plus ⧸ J) (Perfectoid.untilt p Q J)
      (Ideal.Quotient.mk J (WittVector.teichmuller p a)) ∧ z ≠ 0 ∧ z ≠ 1 := sorry

/-- The finite-product comparison for the actual untilt functor. -/
def FiniteEtale.untiltProductIso (T U : CommAlgCat.FiniteEtale.{u} (tilt p R)) :
    (FiniteEtale.untilt p R).obj (CommAlgCat.FiniteEtale.of (tilt p R) (T × U)) ≅
      CommAlgCat.FiniteEtale.of R
        (((FiniteEtale.untilt p R).obj T) × ((FiniteEtale.untilt p R).obj U)) := sorry

/-- Both components are the untilts of the two projections; their order is fixed
(Sch12 5.25, p. 29; ECD 6.1(ii), p. 26). -/
theorem FiniteEtale.untiltProductIso_app (T U : CommAlgCat.FiniteEtale.{u} (tilt p R))
    (x : (FiniteEtale.untilt p R).obj (CommAlgCat.FiniteEtale.of (tilt p R) (T × U))) :
    (FiniteEtale.untiltProductIso p R T U).hom.hom.hom x =
      (((FiniteEtale.untilt p R).map
          (CommAlgCat.FiniteEtale.ofHom (AlgHom.fst (tilt p R) T U))).hom.hom x,
       ((FiniteEtale.untilt p R).map
          (CommAlgCat.FiniteEtale.ofHom (AlgHom.snd (tilt p R) T U))).hom.hom x) := sorry

/-- Product comparison commutes with maps on both factors (ECD 6.1(ii), p. 26). -/
theorem FiniteEtale.untiltProductIso_natural
    {T U V W : CommAlgCat.FiniteEtale.{u} (tilt p R)} (f : T ⟶ V) (g : U ⟶ W) :
    (FiniteEtale.untilt p R).map
        (CommAlgCat.FiniteEtale.ofHom (f.hom.hom.prodMap g.hom.hom)) ≫
        (FiniteEtale.untiltProductIso p R V W).hom =
      (FiniteEtale.untiltProductIso p R T U).hom ≫
        CommAlgCat.FiniteEtale.ofHom
          (((FiniteEtale.untilt p R).map f).hom.hom.prodMap
            ((FiniteEtale.untilt p R).map g).hom.hom) := sorry

/-- Conjugating the untilt of the identity product map is the identity
on the product of untilts (ECD 6.1(ii), p. 26). -/
theorem FiniteEtale.untiltProductIso_id (T U : CommAlgCat.FiniteEtale.{u} (tilt p R)) :
    (FiniteEtale.untiltProductIso p R T U).inv ≫
        (FiniteEtale.untilt p R).map
          (CommAlgCat.FiniteEtale.ofHom ((AlgHom.id (tilt p R) T).prodMap
            (AlgHom.id (tilt p R) U))) ≫
        (FiniteEtale.untiltProductIso p R T U).hom = 𝟙 _ := sorry

/-- Product comparison respects composite maps on both factors
(ECD 6.1(ii), p. 26). -/
theorem FiniteEtale.untiltProductIso_comp
    {T₁ T₂ T₃ U₁ U₂ U₃ : CommAlgCat.FiniteEtale.{u} (tilt p R)}
    (f₁ : T₁ ⟶ T₂) (f₂ : T₂ ⟶ T₃) (g₁ : U₁ ⟶ U₂) (g₂ : U₂ ⟶ U₃) :
    (FiniteEtale.untilt p R).map (CommAlgCat.FiniteEtale.ofHom
        ((f₁ ≫ f₂).hom.hom.prodMap (g₁ ≫ g₂).hom.hom)) ≫
        (FiniteEtale.untiltProductIso p R T₃ U₃).hom =
      (FiniteEtale.untiltProductIso p R T₁ U₁).hom ≫
        CommAlgCat.FiniteEtale.ofHom
          (((FiniteEtale.untilt p R).map f₁).hom.hom.prodMap
            ((FiniteEtale.untilt p R).map g₁).hom.hom) ≫
        CommAlgCat.FiniteEtale.ofHom
          (((FiniteEtale.untilt p R).map f₂).hom.hom.prodMap
            ((FiniteEtale.untilt p R).map g₂).hom.hom) := sorry

-- Check: untiltProductIso_ordered_idempotent
example (T U : CommAlgCat.FiniteEtale.{u} (tilt p R)) :
    let V := CommAlgCat.FiniteEtale.of (tilt p R) (T × U)
    (FiniteEtale.untiltProductIso p R T U).hom.hom.hom
      (tilt.sharp (R := NatFE R ((FiniteEtale.untilt p R).obj V))
        (((FiniteEtale.tiltUntiltIso p R).inv.app V).hom.hom (1, 0))) =
      (1, 0) := sorry
-- Check: untiltProductIso_identity
example (T U : CommAlgCat.FiniteEtale.{u} (tilt p R)) :=
  FiniteEtale.untiltProductIso_id p R T U
-- Check: untiltProductIso_composite
example {T₁ T₂ T₃ U₁ U₂ U₃ : CommAlgCat.FiniteEtale.{u} (tilt p R)}
    (f₁ : T₁ ⟶ T₂) (f₂ : T₂ ⟶ T₃) (g₁ : U₁ ⟶ U₂) (g₂ : U₂ ⟶ U₃) :=
  FiniteEtale.untiltProductIso_comp p R f₁ f₂ g₁ g₂

-- Check: untilt_arbitrary_product
example (T U : CommAlgCat.FiniteEtale.{u} (tilt p R)) :
    let V := CommAlgCat.FiniteEtale.of (tilt p R) (T × U)
    let S := (FiniteEtale.untilt p R).obj V
    (FiniteEtale.untiltProductIso p R T U).hom.hom.hom
      (tilt.sharp (R := NatFE R S)
        (((FiniteEtale.tiltUntiltIso p R).inv.app V).hom.hom (0, 1))) = (0, 1) := sorry

end Perfectoid

