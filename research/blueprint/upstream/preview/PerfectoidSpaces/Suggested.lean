        e.hom.left ∧
      (c.π.app 1).left ≫ (ε.inv.app ((twoPointTransition p X hX).obj 1)).hom.left =
        e.hom.left ≫ prodProfinite.map p X
          (CompHausLike.ofHom _ (ContinuousMap.const (Fin 2) (0 : Fin 2))) := sorry

