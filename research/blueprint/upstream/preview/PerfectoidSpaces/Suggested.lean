    ∃ e : ofPair p (PairCat.tensorPair p A B C f g) ≅
      pullback ((spaFunctor p).map f.op) ((spaFunctor p).map g.op),
      e.hom ≫ pullback.fst _ _ = (spaFunctor p).map (PairCat.tensorInl p A B C f g).op ∧
      e.hom ≫ pullback.snd _ _ = (spaFunctor p).map (PairCat.tensorInr p A B C f g).op := sorry

