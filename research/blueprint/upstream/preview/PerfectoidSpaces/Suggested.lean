    let X := (contractingDiscDiagram p K ϖ).op ⋙ spaFunctor p
    let hX : ∀ i, IsAffinoidPerfectoid p (X.obj i).obj :=
      fun i ↦ ⟨(contractingDiscDiagram p K ϖ).obj i.unop, ⟨Iso.refl _⟩⟩
    ∃ (Y Z : smallEtale p (X.obj (op 0))) (f g : Y ⟶ Z),
