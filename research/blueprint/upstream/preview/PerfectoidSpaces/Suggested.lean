namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open _root_.TauCeti _root_.TauCeti.Huber
open scoped Topology
variable (p : ℕ) [Fact p.Prime]
/-! ### P1/perfectoid-almost-setup -/
abbrev RationalResiduePerfection := PerfectClosure (RatFunc (ZMod p)) p
/-- The valuation ring at x=0 in the perfect closure of F_p(x). -/
def residueValuationRing : ValuationSubring (RationalResiduePerfection p) where
  carrier := {z | ∃ n, ∃ a b : Polynomial (ZMod p), b.eval 0 ≠ 0 ∧
    z = PerfectClosure.mk _ p (n, RatFunc.mk a b)}
  zero_mem' := by sorry
  one_mem' := by sorry
  add_mem' := by sorry
  mul_mem' := by sorry
  neg_mem' := by sorry
  mem_or_inv_mem' := by sorry
abbrev ResidueLaurentPolynomial := AddMonoidAlgebra (RationalResiduePerfection p) (pPowerExponents p)
def residueLaurentMonomial (n : ℕ) : ResidueLaurentPolynomial p :=
  AddMonoidAlgebra.single ⟨(p : ℚ)⁻¹ ^ n, AddSubmonoid.subset_closure ⟨n, rfl⟩⟩ 1
abbrev ResidueLaurentIntegral := AdicCompletion (Ideal.span {residueLaurentMonomial p 0})
  (ResidueLaurentPolynomial p)
def residueLaurentParameter : ResidueLaurentIntegral p :=
  AdicCompletion.of (Ideal.span {residueLaurentMonomial p 0}) (ResidueLaurentPolynomial p)
    (residueLaurentMonomial p 0)
/-- The completed perfection of F_p(x)((t)). -/
abbrev ResidueLaurentField := Localization.Away (residueLaurentParameter p)
instance : TopologicalSpace (ResidueLaurentField p) := sorry
instance : IsTopologicalRing (ResidueLaurentField p) := sorry
instance : UniformSpace (ResidueLaurentField p) := IsTopologicalAddGroup.rightUniformSpace _
instance : IsUniformAddGroup (ResidueLaurentField p) := sorry
instance : IsTateRing (ResidueLaurentField p) := sorry
instance : CompleteSpace (ResidueLaurentField p) := sorry
instance : T2Space (ResidueLaurentField p) := sorry
instance : IsPerfectoidTateRing p (ResidueLaurentField p) := sorry
instance : CharP (ResidueLaurentField p) p := sorry
instance : Algebra (RationalResiduePerfection p) (ResidueLaurentField p) := sorry

theorem residueLaurentTopology_basis :
    (nhds (0 : ResidueLaurentField p)).HasBasis (fun _ : ℕ ↦ True)
      (fun n ↦ {z | ∃ y : ResidueLaurentIntegral p,
        z = algebraMap (ResidueLaurentIntegral p) _ (residueLaurentParameter p ^ n * y)}) := sorry

def residueLaurentRoot (n : ℕ) : ResidueLaurentField p :=
  algebraMap (ResidueLaurentIntegral p) _
    (AdicCompletion.of (Ideal.span {residueLaurentMonomial p 0}) (ResidueLaurentPolynomial p)
      (residueLaurentMonomial p n))
/-- Reduction at t on the power-bounded ring. -/
def residueLaurentReduction : powerBoundedSubring (ResidueLaurentField p) →+* RationalResiduePerfection p := sorry

theorem residueLaurentReduction_spec :
    Function.Surjective (residueLaurentReduction p) ∧
    (∀ z : powerBoundedSubring (ResidueLaurentField p), residueLaurentReduction p z = 0 ↔
      IsTopologicallyNilpotent z.val) ∧
    ∀ a : RationalResiduePerfection p, ∃ ha : algebraMap _ (ResidueLaurentField p) a ∈
      powerBoundedSubring (ResidueLaurentField p),
      residueLaurentReduction p ⟨algebraMap _ _ a, ha⟩ = a := sorry

/-- Compose the t-adic valuation with the x-adic residue valuation. -/
def residueLaurentPlus : Subring (ResidueLaurentField p) :=
  ((residueValuationRing p).toSubring.comap (residueLaurentReduction p)).map
    (powerBoundedSubring (ResidueLaurentField p)).subtype

theorem mem_residueLaurentPlus (z : ResidueLaurentField p) :
    z ∈ residueLaurentPlus p ↔ ∃ hz : z ∈ powerBoundedSubring (ResidueLaurentField p),
      residueLaurentReduction p ⟨z, hz⟩ ∈ residueValuationRing p := sorry

theorem residueLaurent_isField : IsField (ResidueLaurentField p) := sorry
theorem residueLaurentPlus_integral : IsRingOfIntegralElements (residueLaurentPlus p) := sorry

theorem residueLaurentPlus_proper :
    residueLaurentPlus p < powerBoundedSubring (ResidueLaurentField p) ∧
    (∀ z : ResidueLaurentField p, IsTopologicallyNilpotent z → z ∈ residueLaurentPlus p) ∧
    ∀ x : powerBoundedSubring (ResidueLaurentField p), ∀ n,
      residueLaurentRoot p n * x.val ∈ residueLaurentPlus p := sorry

-- Check: RationalResiduePerfection_roots; residueValuationRing_roots; ResidueLaurentPolynomial_roots
-- Check: residueLaurentMonomial_roots; ResidueLaurentIntegral_roots; residueLaurentParameter_roots
-- Check: ResidueLaurentField_roots; residueLaurentRoot_roots; residueLaurentReduction_roots; residueLaurentPlus_roots
example (n : ℕ) :
    residueLaurentRoot p (n + 1) ^ p = residueLaurentRoot p n ∧
    IsPseudoUniformizer (residueLaurentRoot p n) ∧
    residueLaurentRoot p n ∈ residueLaurentPlus p := sorry
-- Check: RationalResiduePerfection_zero; residueValuationRing_zero; ResidueLaurentPolynomial_zero
-- Check: residueLaurentMonomial_zero; ResidueLaurentIntegral_zero; residueLaurentParameter_zero
-- Check: ResidueLaurentField_zero; residueLaurentRoot_zero; residueLaurentReduction_zero; residueLaurentPlus_zero
example : residueLaurentReduction p 0 = 0 ∧ (0 : ResidueLaurentField p) ∈ residueLaurentPlus p ∧
    residueLaurentParameter p ≠ 0 ∧ ¬ IsUnit (residueLaurentParameter p) := sorry
-- Check: RationalResiduePerfection_proper; residueValuationRing_proper; ResidueLaurentPolynomial_proper
-- Check: residueLaurentMonomial_proper; ResidueLaurentIntegral_proper; residueLaurentParameter_proper
-- Check: ResidueLaurentField_proper; residueLaurentRoot_proper; residueLaurentReduction_proper; residueLaurentPlus_proper
example : let x : RationalResiduePerfection p := PerfectClosure.mk _ p (0, RatFunc.X)
    algebraMap _ (ResidueLaurentField p) x ∈ residueLaurentPlus p ∧
    algebraMap _ (ResidueLaurentField p) x⁻¹ ∈ powerBoundedSubring (ResidueLaurentField p) ∧
    algebraMap _ (ResidueLaurentField p) x⁻¹ ∉ residueLaurentPlus p := sorry
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
end


