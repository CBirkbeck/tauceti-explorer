    (X : Perfd p) (hX : IsKappaSmall p κ X) (hXa : IsAffinoidPerfectoid p X.obj)
    (Y : AffinoidEtale p X) : IsKappaSmall p κ Y.obj.left := sorry

/-- The bounded equivalence is the restriction of the specified realization. -/
def proEtaleKappaEquivalence_forget (X : Perfd p) (hX : IsAffinoidPerfectoid p X.obj)
    {κ : Cardinal.{1}} (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (hsmall : IsKappaSmall p κ X) :
