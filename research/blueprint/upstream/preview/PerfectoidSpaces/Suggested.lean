/-! ### P3/strongly-finite-etale-maps-are-affinoid-over-affinoids -/

/-- Algebraic comparison; the opposite direction is forced by global sections. -/
def finiteEtaleAffinoidEquiv (R : PairCat.{0} p) :
    smallFiniteEtale p (ofPair p R) ≌ (CommAlgCat.FiniteEtale R)ᵒᵖ := sorry

/-- The affine comparison is global sections, with scalars pulled back from the base. -/
def finiteEtaleAffinoidSectionsIso (R : PairCat.{0} p) (U : smallFiniteEtale p (ofPair p R)) :
    letI := ((globalPullback p U.obj.hom).comp
      (globalSectionsAffinoidEquiv p R).symm.toRingHom).toAlgebra
    ((finiteEtaleAffinoidEquiv p R).functor.obj U).unop ≃ₐ[R]
      globalSections p U.obj.left := sorry

theorem finiteEtaleAffinoidSectionsIso_map (R : PairCat.{0} p)
    {U V : smallFiniteEtale p (ofPair p R)} (f : U ⟶ V)
    (a : ((finiteEtaleAffinoidEquiv p R).functor.obj V).unop) :
    finiteEtaleAffinoidSectionsIso p R U
      (((finiteEtaleAffinoidEquiv p R).functor.map f).unop.hom.hom a) =
      globalPullback p f.hom.left (finiteEtaleAffinoidSectionsIso p R V a) := sorry

theorem smallEtaleAdicEquiv_map (X : Perfd p) {U V : smallEtale p X} (f : U ⟶ V) :
    HEq (((smallEtaleAdicEquiv p X).functor.map f).left) f.hom.left.hom := sorry

theorem smallFiniteEtaleAdicEquiv_map (X : Perfd p) {U V : smallFiniteEtale p X} (f : U ⟶ V) :
    HEq (((smallFiniteEtaleAdicEquiv p X).functor.map f).left) f.hom.left.hom := sorry

/-! ### P3/etale-site-tilting-equivalence -/

/-- The restriction of the supplied slice tilt functor, ECD Theorem 6.3. -/
def etaleTiltFunctor (X : Perfd p) :
    smallEtale p X ⥤ smallEtale p ((tiltFunctor p).obj X) where
  obj U := ⟨(sliceTiltFunctor p X).obj U.obj, (etale_tilt_iff p U.obj.hom).2 U.property⟩
  map f := ObjectProperty.homMk ((sliceTiltFunctor p X).map f.hom)
