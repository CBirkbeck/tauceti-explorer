/-! ### P4/almost-integral-perfectoid-criterion -/
noncomputable section
namespace Perfectoid
open _root_.TauCeti _root_.TauCeti.Huber
open scoped Topology
/-- Almost bijective Frobenius for the ideal generated by compatible roots makes the
localization of a complete ring at the regular root perfectoid. Its power-bounded subring
is almost equal to the original ring. This extends the argument of Sch12 Lemmas 5.6–5.7,
p. 23, from a perfectoid field to the root-ideal setup without a base field. -/
theorem perfectoid_of_almost_frobenius (p : ℕ) [Fact p.Prime]
    (A : Type u) [CommRing A] (t : ℕ → A)
    (ht : ∀ n, t (n + 1) ^ p = t n) (hreg : t 0 ∈ nonZeroDivisors A)
    (hp : t 0 ^ p ∣ (p : A)) [IsAdicComplete (Ideal.span {t 0}) A]
    (hpq : (p : A) ∈ Ideal.span {t 0})
    (hroot : ∀ a ∈ Ideal.span {t 1}, a ^ p ∈ Ideal.span {t 0})
    (hF : IsAlmostBijective (Ideal.span (Set.range t))
      (frobeniusQuot p (Ideal.span {t 1}) (Ideal.span {t 0}) hpq hroot)) :
    let B := Localization.Away (t 0)
    ∃ (top : TopologicalSpace B),
      letI := top
      ∃ (hring : IsTopologicalRing B) (htate : IsTateRing B),
        letI := hring
        letI := htate
        letI : UniformSpace B := IsTopologicalAddGroup.rightUniformSpace B
        letI : IsUniformAddGroup B := by sorry
        ∃ (hc : CompleteSpace B) (hsep : T2Space B),
        letI := hc
        letI := hsep
        IsPerfectoidTateRing p B ∧
        (𝓝 (0 : B)).HasBasis (fun _ : ℕ ↦ True)
          (fun n ↦ (algebraMap A B) '' ((Ideal.span {t 0} ^ n : Ideal A) : Set A)) ∧
        (∀ a : A, algebraMap A B a ∈ powerBoundedSubring B) ∧
        ∀ x : powerBoundedSubring B, ∀ n : ℕ,
          ∃ a : A, algebraMap A B a = algebraMap A B (t n) * (x : B) := sorry
end Perfectoid
end

/-! ### Layer 4: Rational intersections and affine quotient interfaces -/
namespace PerfectoidSpace
open Perfectoid TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]

/-! ### P4/intersection-of-rational-subsets -/

/-- A nonempty family of rational subsets filtered by reverse inclusion. -/
structure RationalSystem (R : PairCat.{0} p) where
  family : Set (RationalOpen p R)
  nonempty : family.Nonempty
  filtered : ∀ U ∈ family, ∀ V ∈ family, ∃ W ∈ family, W.val ⊆ U.val ∩ V.val

def RationalSystem.intersection {R : PairCat.{0} p} (D : RationalSystem p R) : Set (spa R.pair.plus) :=
  {x | ∀ U ∈ D.family, x ∈ U.val}

def RationalSystem.singleton (R : PairCat.{0} p) (U : RationalOpen p R) : RationalSystem p R where
  family := {U}
  nonempty := ⟨U, rfl⟩
  filtered := by
    intro V hV W hW
    simp only [Set.mem_singleton_iff] at hV hW
    subst V; subst W
    exact ⟨U, rfl, fun _ hx ↦ ⟨hx, hx⟩⟩

/-- The restriction diagram consists of the genuine P2 integral section rings. -/
def RationalSystem.plusDiagram {R : PairCat.{0} p} (D : RationalSystem p R) :
    D.familyᵒᵖ ⥤ CommRingCat where
  obj U := CommRingCat.of (rationalPair p R U.unop.val).pair.plus
  map f := CommRingCat.ofHom ((rationalRes p R _ _ (leOfHom f.unop)).toRingHom.restrict _ _
    (rationalRes p R _ _ (leOfHom f.unop)).map_mem_plus)
  map_id := by sorry
  map_comp := by sorry

/-- The common scalar map into the filtered integral colimit. -/
def RationalSystem.scalar {R : PairCat.{0} p} (D : RationalSystem p R) :
    R.pair.plus →+* ↥(colimit (D.plusDiagram p)) := sorry

theorem RationalSystem.scalar_stage {R : PairCat.{0} p} (D : RationalSystem p R)
    (U : D.family) (a : R.pair.plus) :
    D.scalar p a = (colimit.ι (D.plusDiagram p) (Opposite.op U)).hom
      ⟨(rationalMap p R U.val).toRingHom a, (rationalMap p R U.val).map_mem_plus a a.property⟩ := sorry

/-- ECD Proposition 6.5 and the remark following Lemma 7.6, pp. 29, 31:
the integral rational-section colimit has a perfectoid completion with regular parameter. -/
theorem proRationalSubspace.integralCompletion_isIntegralPerfectoid
    (R : PairCat.{0} p) (D : RationalSystem p R)
    (π : R.pair.plus) (hπ : IsPseudoUniformizer (π : R)) (hp : π ^ p ∣ (p : R.pair.plus)) :
    let A := AdicCompletion (Ideal.span {D.scalar p π}) ↥(colimit (D.plusDiagram p))
    IsIntegralPerfectoid p A ∧
      algebraMap ↥(colimit (D.plusDiagram p)) A (D.scalar p π) ∈ nonZeroDivisors A := sorry

/-- The pair for a rational intersection; its plus ring is the completed integral colimit. -/
def proRationalPair (R : PairCat.{0} p) (D : RationalSystem p R) : PairCat.{0} p := sorry
 def proRationalMap (R : PairCat.{0} p) (D : RationalSystem p R) : R ⟶ proRationalPair p R D := sorry
 def proRationalSubspace (R : PairCat.{0} p) (D : RationalSystem p R) : Perfd p :=
  ofPair p (proRationalPair p R D)
 def proRationalSubspace.ι (R : PairCat.{0} p) (D : RationalSystem p R) :
    proRationalSubspace p R D ⟶ ofPair p R := (spaFunctor p).map (proRationalMap p R D).op

 theorem proRationalSubspace.integralCompletion (R : PairCat.{0} p) (D : RationalSystem p R)
    (π : R.pair.plus) (hπ : IsPseudoUniformizer (π : R)) :
    ∃ e : (proRationalPair p R D).pair.plus ≃+*
      AdicCompletion (Ideal.span {D.scalar p π}) ↥(colimit (D.plusDiagram p)),
      ∀ a : R.pair.plus, e ⟨(proRationalMap p R D).toRingHom a,
        (proRationalMap p R D).map_mem_plus a a.property⟩ =
        AdicCompletion.of _ _ (D.scalar p a) := sorry

 theorem proRationalSubspace.range_ι (R : PairCat.{0} p) (D : RationalSystem p R) :
    Topology.IsEmbedding ((pointMap p) (proRationalSubspace.ι p R D)) ∧
      Set.range ((pointMap p) (proRationalSubspace.ι p R D)) =
        {x | (spaSpaceEquiv p R x).down ∈ D.intersection p} := sorry
 theorem proRationalSubspace.lift (R : PairCat.{0} p) (D : RationalSystem p R)
    (Y : Perfd p) (f : Y ⟶ ofPair p R)
    (hf : ∀ y, (spaSpaceEquiv p R ((pointMap p) f y)).down ∈ D.intersection p) :
    ∃! g : Y ⟶ proRationalSubspace p R D, g ≫ proRationalSubspace.ι p R D = f := sorry
 theorem proRationalSubspace.isInjection (R : PairCat.{0} p) (D : RationalSystem p R) :
    Mono (proRationalSubspace.ι p R D) := sorry
 theorem proRationalSubspace.congr (R : PairCat.{0} p) (D E : RationalSystem p R)
    (h : D.intersection p = E.intersection p) :
    ∃! e : proRationalSubspace p R D ≅ proRationalSubspace p R E,
      e.hom ≫ proRationalSubspace.ι p R E = proRationalSubspace.ι p R D := sorry

 def proRationalStage (R : PairCat.{0} p) (D : RationalSystem p R) (U : D.family) :
    rationalPair p R U.val ⟶ proRationalPair p R D := sorry
 theorem proRationalStage_base (R : PairCat.{0} p) (D : RationalSystem p R) (U : D.family) :
    rationalMap p R U.val ≫ proRationalStage p R D U = proRationalMap p R D := sorry
 theorem proRationalStage_comp (R : PairCat.{0} p) (D : RationalSystem p R)
    (U V : D.family) (h : V.val ≤ U.val) :
    rationalRes p R U.val V.val h ≫ proRationalStage p R D V = proRationalStage p R D U := sorry
 theorem proRationalStage_dense (R : PairCat.{0} p) (D : RationalSystem p R) :
    Dense (⋃ U : D.family, Set.range (proRationalStage p R D U).toRingHom) := sorry

