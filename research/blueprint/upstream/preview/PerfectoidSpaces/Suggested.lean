/-! ### Layer 6: Ring bounds and the size of the étale site -/

/-! ### P6/complete-tate-ring-cardinality -/

/-- The dense localization and its completion have the countable-power bound of P6.2. -/
theorem rationalLocalization_cardinality (A : Type) [CommRing A] [TopologicalSpace A]
    [IsTopologicalRing A] [IsHuberRing A] (D : PairOfDefinition A) (q : D.Presentation)
    (hq : Ideal.span (q.num : Set A) = ⊤) :
    #((D.completionLocObj q.num q.den (Localization.Away q.den) q.hasDenominatorPower).obj) ≤
      (#A + ℵ₀) ^ ℵ₀ := sorry

/-- Finite modules suffice for the finite étale clause; no norm or freeness is required. -/
theorem finiteAlgebra_cardinality (A B : Type) [CommRing A] [CommRing B]
    [Algebra A B] [Module.Finite A B] : #B ≤ #A + ℵ₀ := sorry

/-- Completed tensor products and their uniformizations share the same cardinal bound. -/
theorem completedTensor_cardinality (A B C : Type)
    [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsTateRing A]
    [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsHuberRing B]
    [CommRing C] [TopologicalSpace C] [IsTopologicalRing C] [IsHuberRing C]
    [Algebra A B] [Algebra A C]
    [IsAdicHom (algebraMap A B)] [IsAdicHom (algebraMap A C)] :
    #(CompletedTensor A B C) ≤ (#B * #C * ℵ₀) ^ ℵ₀ ∧
    #(Uniformization (CompletedTensor A B C)) ≤ (#B * #C * ℵ₀) ^ ℵ₀ := sorry

