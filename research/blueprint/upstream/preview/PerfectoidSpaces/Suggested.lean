/-! ### P3/cyclotomic-completion-of-finite-extension -/
noncomputable section
open _root_.TauCeti _root_.TauCeti.Huber
open scoped Topology
/-- Sch12 Theorem 3.7: the completed compositum remains a finite perfectoid extension. -/
theorem cyclotomic_finite_extension (p : ℕ) [Fact p.Prime]
    (K : IntermediateField ℚ_[p] ℂ_[p]) [FiniteDimensional ℚ_[p] K] :
    let L := (K.toSubfield ⊔ padicCyclotomic p).topologicalClosure
    letI : NontriviallyNormedField L :=
      { (inferInstance : NormedField L) with non_trivial := by sorry }
    letI : CompleteSpace L := (Subfield.isClosed_topologicalClosure _).completeSpace_coe
    letI : Algebra (padicCyclotomic p) L :=
      (Subfield.inclusion (le_trans le_sup_right (Subfield.le_topologicalClosure _))).toAlgebra
    IsPerfectoidField p L ∧ FiniteDimensional (padicCyclotomic p) L ∧
      Module.finrank (padicCyclotomic p) L ≤ Module.finrank ℚ_[p] K ∧
      Dense {x : L | x.val ∈ K.toSubfield ⊔
        Subfield.closure {ζ : ℂ_[p] | ∃ n : ℕ, ζ ^ p ^ n = 1}} := sorry
end

noncomputable section
open _root_.TauCeti _root_.TauCeti.Huber
