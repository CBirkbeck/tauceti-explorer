/-! ### Layer 6: Affinoid towers over a characteristic-zero perfectoid field -/

/-! ### P6/scholze-2013-affinoid-perfectoid-comparison -/

/-- The ring data of Sch13 Definition 4.3(i), p. 23. The stages are strongly noetherian
Tate affinoids, the transitions finite étale and surjective on spectra, and the completion
is a perfectoid pair. The colimit universal property is in complete Huber pairs. -/
structure ScholzeAffinoidTower (K : AffinoidField p) [CharZero K] where
  I : Type
  [category : SmallCategory I]
  [cofiltered : IsCofiltered I]
  pairs : Iᵒᵖ ⥤ CAff
  [tate : ∀ i, IsTateRing (pairs.obj i).A]
  noetherian : ∀ (i : Iᵒᵖ) (n : ℕ),
    IsNoetherianRing (restrictedMvPowerSeriesCompletion n (pairs.obj i).A)
  finiteEtale : ∀ {i j : Iᵒᵖ} (a : i ⟶ j),
    letI := (CAff.toRingHom (pairs.map a)).toAlgebra
    Module.Finite (pairs.obj i).A (pairs.obj j).A ∧
    Algebra.Etale (pairs.obj i).A (pairs.obj j).A ∧
    (pairs.obj j).P.plus =
      (integralClosure ((pairs.obj i).P.plus.map (CAff.toRingHom (pairs.map a))) (pairs.obj j).A).toSubring
  surjective : ∀ {i j : Iᵒᵖ} (a : i ⟶ j), Function.Surjective (CAff.spaMap (pairs.map a))
  scalar : (Functor.const Iᵒᵖ).obj (CAff.of (K.toPair p)) ⟶ pairs
  completedPair : PairCat.{0} p
  completedScalar : CAff.of (K.toPair p) ⟶ CAff.of completedPair.pair
  cocone : Cocone pairs
  point_eq : cocone.pt = CAff.of completedPair.pair
  scalar_comp : ∀ i, scalar.app i ≫ cocone.ι.app i ≫ eqToHom point_eq = completedScalar
  isCompletedColimit : IsColimit cocone
attribute [instance] ScholzeAffinoidTower.category ScholzeAffinoidTower.cofiltered ScholzeAffinoidTower.tate

namespace ScholzeAffinoidTower
variable {p} {K : AffinoidField p} [CharZero K]

abbrev realization (A : ScholzeAffinoidTower p K) : Perfd p := ofPair p A.completedPair

def ι (A : ScholzeAffinoidTower p K) (i : A.Iᵒᵖ) : A.pairs.obj i ⟶ CAff.of A.completedPair.pair :=
  A.cocone.ι.app i ≫ eqToHom A.point_eq

/-- A compatible morphism of presentations induces the map of their completed pairs. -/
def map (A B : ScholzeAffinoidTower p K) (F : A.Iᵒᵖ ⥤ B.Iᵒᵖ)
    (a : A.pairs ⟶ F ⋙ B.pairs) : A.completedPair ⟶ B.completedPair := sorry

theorem map_stage (A B : ScholzeAffinoidTower p K) (F : A.Iᵒᵖ ⥤ B.Iᵒᵖ)
    (a : A.pairs ⟶ F ⋙ B.pairs) (i : A.Iᵒᵖ) :
    A.ι i ≫ CAff.ofHom (map A B F a) = a.app i ≫ B.ι (F.obj i) := sorry

theorem map_id (A : ScholzeAffinoidTower p K) :
    map A A (𝟭 _) (𝟙 A.pairs) = 𝟙 _ := sorry

/-- Sch13 4.5(i), p. 23, for a rational elementary factor at a finite stage. -/
theorem rational_baseChange (A : ScholzeAffinoidTower p K) (i : A.Iᵒᵖ)
    (B : CAff) (a : A.pairs.obj i ⟶ B) (T : Finset (A.pairs.obj i).A)
    (s : (A.pairs.obj i).A) (ha : CAff.IsRationalLocalization a T s)
    (c : PushoutCocone a (A.ι i)) (hc : IsColimit c) :
    ∃ (R : PairCat.{0} p) (e : c.pt ≅ CAff.of R.pair),
      IsEtale p ((spaFunctor p).map (show A.completedPair ⟶ R from
        (c.inr ≫ e.hom : CAff.of A.completedPair.pair ⟶ CAff.of R.pair)).op) := sorry

/-- The finite étale elementary factor of the same comparison. -/
theorem finiteEtale_baseChange (A : ScholzeAffinoidTower p K) (i : A.Iᵒᵖ)
    (B : CAff) (a : A.pairs.obj i ⟶ B)
    (ha : letI := (CAff.toRingHom a).toAlgebra
      Module.Finite (A.pairs.obj i).A B.A ∧ Algebra.Etale (A.pairs.obj i).A B.A ∧
      B.P.plus = (integralClosure ((A.pairs.obj i).P.plus.map (CAff.toRingHom a)) B.A).toSubring)
    (c : PushoutCocone a (A.ι i)) (hc : IsColimit c) :
    ∃ (R : PairCat.{0} p) (e : c.pt ≅ CAff.of R.pair),
      IsFiniteEtale p ((spaFunctor p).map (show A.completedPair ⟶ R from
        (c.inr ≫ e.hom : CAff.of A.completedPair.pair ⟶ CAff.of R.pair)).op) := sorry

/-- Sch13 Lemma 4.6, pp. 24–25: completing a cofiltered system of affinoid
perfectoid towers with étale realizations gives the specified pro-étale presentation.
The comparison is over the base and preserves every projection. -/
theorem isAffinoidProEtale_scholze2013 (A : ScholzeAffinoidTower p K)
    {J : Type} [SmallCategory J] [IsCofiltered J]
    (B : J → ScholzeAffinoidTower p K) (D : Jᵒᵖ ⥤ PairCat.{0} p)
    (hD : ∀ j, D.obj (Opposite.op j) = (B j).completedPair)
    (E : J ⥤ affinoidEtaleSmall p A.realization ⟨A.completedPair, ⟨Iso.refl _⟩⟩)
    (e : D.rightOp ⋙ spaFunctor p ≅
      E ⋙ (affinoidEtaleSmallEquivalence p A.realization
        ⟨A.completedPair, ⟨Iso.refl _⟩⟩).inverse ⋙ ObjectProperty.ι _ ⋙ Over.forget _)
    (j₀ : Jᵒᵖ) (ϖ : PseudoUniformizerRoots p (D.obj j₀))
    (a : A.completedPair ⟶ completedColimitPair p D j₀ ϖ)
    (ha : ∀ j, (spaFunctor p).map (completedColimit.ι p D j₀ ϖ (Opposite.op j)).op ≫
      e.hom.app j ≫ ((affinoidEtaleSmallEquivalence p A.realization
        ⟨A.completedPair, ⟨Iso.refl _⟩⟩).inverse.obj (E.obj j)).obj.hom =
          (spaFunctor p).map a.op) :
    IsAffinoidProEtale p ((spaFunctor p).map a.op) ∧
    (∃ P : ProEtalePresentation p ((spaFunctor p).map a.op), P.I = J ∧
      HEq P.diagram (E ⋙ (affinoidEtaleSmallEquivalence p A.realization
        ⟨A.completedPair, ⟨Iso.refl _⟩⟩).inverse)) ∧
    ∃ q : Over.mk ((spaFunctor p).map a.op) ≅
      (proEtaleEquivalence.cone p A.realization
        ⟨A.completedPair, ⟨Iso.refl _⟩⟩ E).pt,
      ∀ j, (q.hom ≫ (proEtaleEquivalence.cone p A.realization
        ⟨A.completedPair, ⟨Iso.refl _⟩⟩ E).π.app j).left =
          (spaFunctor p).map (completedColimit.ι p D j₀ ϖ (Opposite.op j)).op ≫ e.hom.app j := sorry

/-- ECD Proposition 7.10, p. 33: the realization of a map of completed étale
presentations acts on projections by that map. Together with the preceding comparison,
this identifies the completion maps with the maps of ρ_X. -/
theorem isAffinoidProEtale_scholze2013_naturality (A : ScholzeAffinoidTower p K)
    {J : Type} [SmallCategory J] [IsCofiltered J]
    (D E : J ⥤ affinoidEtaleSmall p A.realization ⟨A.completedPair, ⟨Iso.refl _⟩⟩)
    (α : D ⟶ E) (j : J) :
    eqToHom (proEtaleEquivalence.cone_pt p A.realization
      ⟨A.completedPair, ⟨Iso.refl _⟩⟩ D) ≫
      ((proEtaleEquivalence p A.realization ⟨A.completedPair, ⟨Iso.refl _⟩⟩).functor.map
        ((Ind.lim Jᵒᵖ).map (NatTrans.op α)).op).hom ≫
      eqToHom (proEtaleEquivalence.cone_pt p A.realization
        ⟨A.completedPair, ⟨Iso.refl _⟩⟩ E).symm ≫
      (proEtaleEquivalence.cone p A.realization
        ⟨A.completedPair, ⟨Iso.refl _⟩⟩ E).π.app j =
    (proEtaleEquivalence.cone p A.realization
      ⟨A.completedPair, ⟨Iso.refl _⟩⟩ D).π.app j ≫
      ((affinoidEtaleSmallEquivalence p A.realization
        ⟨A.completedPair, ⟨Iso.refl _⟩⟩).inverse.map (α.app j)).hom := sorry

-- Check: isAffinoidProEtale_scholze2013_constant
example (A : ScholzeAffinoidTower p K)
    (d : affinoidEtaleSmall p A.realization ⟨A.completedPair, ⟨Iso.refl _⟩⟩) :
    Nonempty (((proEtaleEquivalence p A.realization
      ⟨A.completedPair, ⟨Iso.refl _⟩⟩).functor.obj
        (Opposite.op (Ind.yoneda.obj (Opposite.op d)))).obj ≅
      ((affinoidEtaleSmallEquivalence p A.realization
        ⟨A.completedPair, ⟨Iso.refl _⟩⟩).inverse.obj d).obj) := sorry

-- Check: isAffinoidProEtale_scholze2013_empty_stage
example (A : ScholzeAffinoidTower p K)
    {J : Type} [SmallCategory J] [IsCofiltered J]
    (D : J ⥤ affinoidEtaleSmall p A.realization ⟨A.completedPair, ⟨Iso.refl _⟩⟩)
    (j : J) (hj : IsEmpty (underlyingPoints p
      ((affinoidEtaleSmallEquivalence p A.realization
        ⟨A.completedPair, ⟨Iso.refl _⟩⟩).inverse.obj (D.obj j)).obj.left)) :
