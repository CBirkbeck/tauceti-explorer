/-! ### Layer 2: Homogeneous polydisc approximation -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open TauCeti Huber ValuationSpectrum
open scoped BigOperators
variable (p : ℕ) [Fact p.Prime]
section HomogeneousComponents
variable {R₀ : Type} [CommRing R₀] [UniformSpace R₀] [IsUniformAddGroup R₀]
  [IsTopologicalRing R₀] [IsTateRing R₀] [CompleteSpace R₀] [T2Space R₀]
  [IsPerfectoidTateRing p R₀] (ϖ : PseudoUniformizerRoots p R₀) (n : ℕ)

/-! ### P2/approximation-on-perfectoid-polydisc -/

/-- Closed homogeneous component: completion of the span of monomials of the specified
total degree. It does not assert a direct-sum grading of the completed algebra. -/
def homogeneousPart (d : ℚ) : Submodule R₀ (perfectedTateAlgebra p ϖ (Fin n)) :=
  (Submodule.span R₀ {f | ∃ e : Fin n → pPowerExponents p,
    (∑ i, (e i : ℚ)) = d ∧
      f = ∏ i, perfectedTateAlgebra.X p ϖ (Fin n) i (e i)}).topologicalClosure

-- Check: homogeneous_degree_zero_constant
example (a : R₀) : algebraMap R₀ (perfectedTateAlgebra p ϖ (Fin n)) a ∈
    homogeneousPart p ϖ n 0 := sorry
-- Check: homogeneous_two_variables
example : perfectedTateAlgebra.rootX ϖ (0 : Fin 2) 0 +
    algebraMap R₀ _ (ϖ.root 0) * perfectedTateAlgebra.rootX ϖ (1 : Fin 2) 0 ∈
      homogeneousPart p ϖ 2 1 := sorry
-- Check: homogeneous_wrong_degree
example [Nontrivial R₀] : perfectedTateAlgebra.rootX ϖ (0 : Fin 1) 0 ∉
    homogeneousPart p ϖ 1 0 := sorry
-- Check: homogeneous_zero
example (d : ℚ) : (0 : perfectedTateAlgebra p ϖ (Fin n)) ∈ homogeneousPart p ϖ n d :=
  Submodule.zero_mem _
end HomogeneousComponents

variable {K : Type} [NontriviallyNormedField K] [IsUltrametricDist K]
  [CompleteSpace K] [IsPerfectoidField p K] (ϖ : PseudoUniformizerRoots p K) (n : ℕ)

/-- Sch12 Lemma 6.5 and Remark 6.6, pp. 33–34, over a perfectoid field.
The degree is preserved; c and ε use only the chosen p-power roots. -/
theorem homogeneous_sharp_approximation (P : Pair (perfectedTateAlgebra p ϖ (Fin n)))
    (hP : P.plus = powerBoundedSubring (perfectedTateAlgebra p ϖ (Fin n)))
    (d : ℚ) (f : perfectedTateAlgebra p ϖ (Fin n))
    (hf : f ∈ homogeneousPart p ϖ n d)
    (hfPB : f ∈ powerBoundedSubring (perfectedTateAlgebra p ϖ (Fin n))) (a m b k : ℕ) (hb : 0 < b) (hbk : b < p ^ k) :
    ∃ g ∈ homogeneousPart p (ϖ.tilt p) n d,
      g ∈ powerBoundedSubring (perfectedTateAlgebra p (ϖ.tilt p) (Fin n)) ∧ ∀ x : spa P.plus,
      x.val.valuation (f - tilt.sharp ((perfectedTateAlgebra.tiltEquiv p ϖ (Fin n)).symm g)) ≤
        x.val.valuation (algebraMap K _ (ϖ.root k ^ (p ^ k - b))) *
          max (x.val.valuation f) (x.val.valuation (algebraMap K _ (ϖ.root m ^ a))) ∧
      max (x.val.valuation f) (x.val.valuation (algebraMap K _ (ϖ.root m ^ a))) =
        max (x.val.valuation (tilt.sharp ((perfectedTateAlgebra.tiltEquiv p ϖ (Fin n)).symm g)))
          (x.val.valuation (algebraMap K _ (ϖ.root m ^ a))) := sorry

end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
end

/-! ### Layer 2: p-finite models -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open TauCeti Huber TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]
variable (K : Type) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  [IsPerfectoidField p K] [CharP K p]

/-- Sch12 Definition 6.9. A reduced finite-type affinoid with its original topology,
embedded in its completed perfection. The density condition uses all p-power roots,
and the plus-ring equation fixes the integral convention. -/
structure PFiniteModel (R : PairCat.{0} p) [Algebra K R] where
  source : CAff
  scalar : K →+* source.A
  finiteType : IsStrictlyTopologicallyFiniteType scalar
  reduced : IsReduced source.A
  sourcePlus : source.P.plus = powerBoundedSubring source.A
  map : source.A →+* R
  continuous_map : Continuous map
  inducing_map : Topology.IsInducing map
  injective_map : Function.Injective map
  scalar_map : map.comp scalar = algebraMap K R
  dense_roots : Dense {x : R | ∃ (n : ℕ) (s : source.A), x ^ (p ^ n) = map s}
  plus_eq : R.pair.plus = (Subring.closure {x : R |
    ∃ (n : ℕ) (s : source.P.plus), x ^ (p ^ n) = map s.val}).topologicalClosure

/-- Existence of a p-finite model with the specified K-algebra structure. -/
def IsPFinite (R : PairCat.{0} p) [Algebra K R] : Prop := Nonempty (PFiniteModel p K R)

-- Check: pfinite_field
example (R : PairCat.{0} p) [Algebra K R] (e : R ≃ₐ[K] K)
    (he : Continuous e ∧ Continuous e.symm)
    (hplus : R.pair.plus.map e.toRingEquiv.toRingHom = powerBoundedSubring K) :
    IsPFinite p K R := sorry
-- Check: pfinite_disc
example (ϖ : PseudoUniformizerRoots p K) :
    IsPFinite p K ({ carrier := perfectedTateAlgebra p ϖ (Fin 1), pair := perfectedTateAlgebra.pair p ϖ (Fin 1) (Pair.powerBounded K) } : PairCat.{0} p) := sorry
-- Check: pfinite_infinite_variables_nonexample
example (ϖ : PseudoUniformizerRoots p K) :
    ¬ IsPFinite p K ({ carrier := perfectedTateAlgebra p ϖ ℕ, pair := perfectedTateAlgebra.pair p ϖ ℕ (Pair.powerBounded K) } : PairCat.{0} p) := sorry

/-- A finite collection of integral functions is contained in the image of a p-finite
perfectoid affinoid; this is the finite-stage input to Sch12 Lemma 6.13. -/
theorem exists_pfinite_stage (R : PairCat.{0} p) [Algebra K R]
    (hc : Continuous (algebraMap K R))
    (hplus : ∀ a ∈ powerBoundedSubring K, algebraMap K R a ∈ R.pair.plus)
    (hp : (p : R) = 0) (I : Finset R.pair.plus) :
    ∃ (S : PairCat.{0} p) (_ : Algebra K S), IsPFinite p K S ∧
      ∃ f : S ⟶ R, f.toRingHom.comp (algebraMap K S) = algebraMap K R ∧
        ∀ a ∈ I, ∃ s ∈ S.pair.plus, f.toRingHom s = a.val := sorry
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
end

/-! ### Layer 2: Compatible rational sections and cohomology -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open TauCeti Huber ValuationSpectrum CategoryTheory CategoryTheory.Limits Opposite
variable (p : ℕ) [Fact p.Prime] (R : PairCat.{0} p)

/-- Sections on an open are compatible families on its rational subsets: the right
Kan extension of the rational localization presheaf. -/
def rationalSections (U : TopologicalSpace.Opens (spa R.pair.plus)) :
    Subring (∀ V : {V : RationalOpen p R // V.val ⊆ U}, rationalPair p R V.val) where
  carrier := {s | ∀ V W : {V : RationalOpen p R // V.val ⊆ U},
    ∀ h : W.val.val ⊆ V.val.val,
      (rationalRes p R V.val W.val h).toRingHom (s V) = s W}
  zero_mem' := by sorry
  one_mem' := by sorry
  add_mem' := by sorry
  neg_mem' := by sorry
  mul_mem' := by sorry

/-- Integral sections are the compatible families whose rational components belong
to the completed plus subrings. -/
def rationalIntegralSections (U : TopologicalSpace.Opens (spa R.pair.plus)) :
    Subring (rationalSections p R U) where
  carrier := {s | ∀ V, s.val V ∈ (rationalPair p R V.val).pair.plus}
  zero_mem' := by sorry
  one_mem' := by sorry
  add_mem' := by sorry
  neg_mem' := by sorry
  mul_mem' := by sorry

/-! ### P2/sheaf-theorem-and-almost-acyclicity -/

/-- The additive structure presheaf; its objects and restrictions are fixed below. -/
def rationalPresheaf : (TopologicalSpace.Opens (spa R.pair.plus))ᵒᵖ ⥤ AddCommGrpCat :=
  { obj := fun U ↦ AddCommGrpCat.of (rationalSections p R U.unop)
    map := fun {U V} h ↦ by
      exact AddCommGrpCat.ofHom
        { toFun := fun s ↦ ⟨fun W ↦ s.val ⟨W.val, W.property.trans h.unop.le⟩, by sorry⟩
          map_zero' := by sorry
          map_add' := by sorry }
    map_id := by sorry
    map_comp := by sorry }

def integralPresheaf : (TopologicalSpace.Opens (spa R.pair.plus))ᵒᵖ ⥤ AddCommGrpCat :=
  { obj := fun U ↦ AddCommGrpCat.of (rationalIntegralSections p R U.unop)
    map := fun {U V} h ↦ by
      exact AddCommGrpCat.ofHom
        { toFun := fun s ↦ ⟨⟨fun W ↦ s.val.val ⟨W.val, W.property.trans h.unop.le⟩,
            by sorry⟩, by sorry⟩
          map_zero' := by sorry
          map_add' := by sorry }
    map_id := by sorry
    map_comp := by sorry }

/-- The compatible-family model agrees with the underlying ring of Tau Ceti's
presentation limit (Wedhorn §8.1, p. 75; ECD Theorem 3.18, p. 18). -/
def rationalSectionsEquivPresentationLimit (D : PairOfDefinition R)
    (U : TopologicalSpace.Opens (spa R.pair.plus)) :
    rationalSections p R U ≃+*
      (presentationLimitPresheafInCommRingCat D R.pair.plus).obj (op U) := sorry

/-- A family obtained from a base element is sent to the supplier's canonical section
(Wedhorn §8.1, pp. 74–75). -/
theorem rationalSectionsEquivPresentationLimit_base (D : PairOfDefinition R)
    (U : TopologicalSpace.Opens (spa R.pair.plus)) (a : R) (s : rationalSections p R U)
    (hs : ∀ V, s.val V = (rationalMap p R V.val).toRingHom a) :
    rationalSectionsEquivPresentationLimit p R D U s =
      (toPresentationLimit (P := D) R.pair.plus U) a := sorry

/-- The comparison commutes with every open restriction. -/
theorem rationalSectionsEquivPresentationLimit_natural (D : PairOfDefinition R)
    (U V : TopologicalSpace.Opens (spa R.pair.plus)) (h : V ≤ U)
    (s : rationalSections p R U) :
    rationalSectionsEquivPresentationLimit p R D V
        ((rationalPresheaf p R).map (homOfLE h).op s) =
      (presentationLimitPresheafInCommRingCat D R.pair.plus).map (homOfLE h).op
        (rationalSectionsEquivPresentationLimit p R D U s) := sorry

/-- Integral families are exactly the sections bounded by one at every stalk valuation
(Wedhorn §8.1, Proposition 8.16, pp. 78–79). -/
theorem rationalSectionsEquivPresentationLimit_plus (D : PairOfDefinition R)
    (hD : D.ringOfDefinition ≤ R.pair.plus)
    (U : TopologicalSpace.Opens (spa R.pair.plus)) :
    (rationalIntegralSections p R U).map
        (rationalSectionsEquivPresentationLimit p R D U).toRingHom =
      presentationLimitPlusSubring R.pair.isRingOfIntegralElements.isPowerBounded_of_mem hD U :=
  sorry

/-- The natural ring comparison induces an isomorphism of the additive presheaves. -/
theorem rationalPresheaf_iso_presentationLimit (D : PairOfDefinition R) :
    ∃ e : rationalPresheaf p R ≅
        presentationLimitPresheafInCommRingCat D R.pair.plus ⋙
          (forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat),
      ∀ U (s : rationalSections p R U),
        e.hom.app (op U) s = rationalSectionsEquivPresentationLimit p R D U s := sorry

/-- The same comparison restricts to the integral presheaves. -/
theorem integralPresheaf_iso_presentationLimit (D : PairOfDefinition R)
    (hD : D.ringOfDefinition ≤ R.pair.plus) :
    ∃ e : integralPresheaf p R ≅
        presentationLimitPlusPresheaf
          R.pair.isRingOfIntegralElements.isPowerBounded_of_mem hD ⋙
            (forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat),
      ∀ U (s : rationalIntegralSections p R U),
        (e.hom.app (op U) s).val =
          rationalSectionsEquivPresentationLimit p R D U s.val := sorry

-- Check: rationalSectionsEquivPresentationLimit_empty
example (D : PairOfDefinition R) (s : rationalSections p R ⊥) :
    rationalSectionsEquivPresentationLimit p R D ⊥ s = 0 := sorry
-- Check: rationalSectionsEquivPresentationLimit_two_constants
example (D : PairOfDefinition R) (U : TopologicalSpace.Opens (spa R.pair.plus)) :
    rationalSectionsEquivPresentationLimit p R D U (2 + 5) = 7 := by
  calc
    _ = rationalSectionsEquivPresentationLimit p R D U (7 : rationalSections p R U) :=
      congrArg _ (by norm_num)
    _ = 7 := map_ofNat (rationalSectionsEquivPresentationLimit p R D U) 7
-- Check: rationalSectionsEquivPresentationLimit_nonintegral
example (D : PairOfDefinition R) (hD : D.ringOfDefinition ≤ R.pair.plus)
    (ϖ : PseudoUniformizerRoots p R) (U : TopologicalSpace.Opens (spa R.pair.plus))
    (x : spa R.pair.plus) (hx : x ∈ U) (s : rationalSections p R U)
    (hs : ∀ V, s.val V = (rationalMap p R V.val).toRingHom (ϖ.zpow (-1) 0 : R)) :
    rationalSectionsEquivPresentationLimit p R D U s ∉
      presentationLimitPlusSubring R.pair.isRingOfIntegralElements.isPowerBounded_of_mem hD U :=
  sorry

/-- ECD Theorem 3.18, p. 18: transport sheafiness along the presentation-limit comparison. -/
theorem rationalPresheaf_isSheaf : TopCat.Presheaf.IsSheaf (X := TopCat.of (spa R.pair.plus))
    (rationalPresheaf p R) := by
  obtain ⟨D, hD⟩ := exists_pairOfDefinition_ringOfDefinition_le
    R.pair.isRingOfIntegralElements.isOpen
  obtain ⟨e, _⟩ := rationalPresheaf_iso_presentationLimit p R D
  apply TopCat.Presheaf.isSheaf_of_iso e.symm
  exact CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf _ _
    (TopCommRingCat.isCompleteSeparated.ι ⋙ forget₂ TopCommRingCat CommRingCat ⋙
      forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat)
    (((isSheafyRing p R).isSheafyForEveryPresentation
      R.pair.isRingOfIntegralElements).isSheaf D hD)

theorem integralPresheaf_isSheaf : TopCat.Presheaf.IsSheaf (X := TopCat.of (spa R.pair.plus))
    (integralPresheaf p R) := sorry

def rationalSheaf : (TopCat.of (spa R.pair.plus)).Sheaf AddCommGrpCat :=
  ⟨rationalPresheaf p R, rationalPresheaf_isSheaf p R⟩
def integralSheaf : (TopCat.of (spa R.pair.plus)).Sheaf AddCommGrpCat :=
  ⟨integralPresheaf p R, integralPresheaf_isSheaf p R⟩

/-- Multiplication by an integral base element, on the actual integral presheaf. -/
def integralScalar (a : R.pair.plus) : integralSheaf p R ⟶ integralSheaf p R := sorry

theorem integralScalar_apply (a : R.pair.plus) (U : TopologicalSpace.Opens (spa R.pair.plus))
    (s : rationalIntegralSections p R U) (V : {V : RationalOpen p R // V.val ⊆ U}) :
    ((integralScalar p R a).hom.app (op U) s).val.val V =
      (rationalMap p R V.val).toRingHom a.val * s.val.val V := sorry

/-- Almost acyclicity, expressed by the induced scalar endomorphism of cohomology.
The ideal is the ideal of topologically nilpotent elements of the chosen plus ring. -/
theorem integralSheaf_almost_acyclic (q : ℕ) (hq : 0 < q) (a : R.pair.plus)
    (ha : IsTopologicallyNilpotent a.val) :
    Sheaf.H.map (integralScalar p R a) q = 0 := sorry

/-! ### P2/sheafy-cech-acyclicity -/

/- Ordinary and Čech acyclicity are supplied by AdicSpacesPartIII.AdicSpace
`sheafy_structure_acyclic` and `sheafy_isCechAcyclic` on Part II charts,
using the comparisons above. -/

example {X : TauCeti.AdicSpace.{u}}
    (c : TauCetiRoadmap.AdicSpacesPartII.AdicSpace.Chart X)
    [Huber.IsTateRing c.affinoid.ring] (i : ℕ) (hi : 0 < i) :=
  TauCetiRoadmap.AdicSpacesPartIII.AdicSpace.sheafy_structure_acyclic c i hi

-- Check: sections_empty
example : Subsingleton (rationalSections p R ⊥) ∧
    Subsingleton (rationalIntegralSections p R ⊥) := sorry
-- Check: sections_rational_recovery
example (U : TopologicalSpace.Opens (spa R.pair.plus))
    (h : (U : Set _) ∈ spaRationalFamily R.pair.plus) :
    ∃ e : rationalSections p R U ≃+* rationalPair p R ⟨U, h⟩,
      (∀ s, e s = s.val ⟨⟨U, h⟩, Set.Subset.refl _⟩) ∧
