/-- Closure of the image of the tensor of the two power-bounded subrings, before
integral closure. The generators use the supplier's actual tensor inclusions. -/
def tensorIntegralModel : Subring (CompletedTensor A B C) :=
  ((powerBoundedSubring B).map
      ((Pair.completedTensor.tmul A B C).comp Algebra.TensorProduct.includeLeftRingHom) ⊔
    (powerBoundedSubring C).map
      ((Pair.completedTensor.tmul A B C).comp
        (Algebra.TensorProduct.includeRight (R := A) (A := B)).toRingHom)).topologicalClosure

/-- The integral tensor model is almost the power-bounded subring; no exact equality
with the integral closure is asserted. KL II 3.3.13; Bhatt Exercise 9.3.14, p. 112. -/
theorem tensorIntegralModel_almost (ϖ : PseudoUniformizerRoots p A) :
    tensorIntegralModel (A := A) (B := B) (C := C) ≤ powerBoundedSubring (CompletedTensor A B C) ∧
    ∀ n : ℕ, ∀ d ∈ powerBoundedSubring (CompletedTensor A B C),
      algebraMap A (CompletedTensor A B C) (ϖ.root n) * d ∈
        tensorIntegralModel (A := A) (B := B) (C := C) := sorry

