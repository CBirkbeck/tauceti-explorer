/-! ### P0/almost-algebras -/
/-- Relative tensor products are pushouts, computed on almost elements and then almostified. -/
theorem tensor_relative {A B C : Algebra S} (f : A ⟶ B) (g : A ⟶ C) :
    letI := ((elements S).map f).hom.toRingHom.toAlgebra
    letI := ((elements S).map g).hom.toRingHom.toAlgebra
    letI : IsScalarTower V ((elements S).obj A) ((elements S).obj B) := by sorry
    letI : IsScalarTower V ((elements S).obj A) ((elements S).obj C) := by sorry
    Nonempty (pushout f g ≅ (toAlmost S).obj (CommAlgCat.of V
      (((elements S).obj B) ⊗[((elements S).obj A)] ((elements S).obj C)))) := sorry
end TauCetiRoadmap.PerfectoidSpaces.Almost.Algebra
