/-! ### P3/etale-site-of-perfectoid-space -/

/-- The full subcategory of the slice on étale morphisms, ECD 6.3. -/
abbrev smallEtale (X : Perfd p) :=
  ObjectProperty.FullSubcategory (fun Y : Over X ↦ IsEtale p Y.hom)

/-- The finite étale full subcategory of the slice, with all morphisms over the base. -/
abbrev smallFiniteEtale (X : Perfd p) :=
  ObjectProperty.FullSubcategory (fun Y : Over X ↦ IsFiniteEtale p Y.hom)

/-- Covering sieves are precisely those jointly surjective on valuation points. -/
def smallEtaleTopology (X : Perfd p) : GrothendieckTopology (smallEtale p X) where
  sieves U := {S | ∀ x : YonedaAdicSpace.space.obj U.obj.left.obj,
    ∃ (V : smallEtale p X) (f : V ⟶ U), S f ∧
      x ∈ Set.range (YonedaAdicSpace.space.map f.hom.left.hom)}
  top_mem' := by sorry
  pullback_stable' := by sorry
  transitive' := by sorry

/-- The finite site uses the same jointly-surjective covering condition. -/
def smallFiniteEtaleTopology (X : Perfd p) : GrothendieckTopology (smallFiniteEtale p X) where
  sieves U := {S | ∀ x : YonedaAdicSpace.space.obj U.obj.left.obj,
    ∃ (V : smallFiniteEtale p X) (f : V ⟶ U), S f ∧
      x ∈ Set.range (YonedaAdicSpace.space.map f.hom.left.hom)}
  top_mem' := by sorry
  pullback_stable' := by sorry
  transitive' := by sorry

/-- The underlying Yoneda-adic space of a perfectoid space is analytic. -/
theorem isAnalytic_adic (X : Perfd p) : YonedaAdicSpace.IsAnalytic X.obj := sorry

/-- All analytic étale objects over a perfectoid base are already perfectoid. -/
def smallEtaleAdicEquiv (X : Perfd p) :
    smallEtale p X ≌ YonedaAdicSpace.smallEtale X.obj := sorry

def smallFiniteEtaleAdicEquiv (X : Perfd p) :
    smallFiniteEtale p X ≌ YonedaAdicSpace.smallFiniteEtale X.obj := sorry

theorem smallEtaleAdicEquiv_obj (X : Perfd p) (U : smallEtale p X) :
    ((smallEtaleAdicEquiv p X).functor.obj U).left = U.obj.left.obj ∧
    HEq ((smallEtaleAdicEquiv p X).functor.obj U).hom U.obj.hom.hom := sorry

theorem smallFiniteEtaleAdicEquiv_obj (X : Perfd p) (U : smallFiniteEtale p X) :
    ((smallFiniteEtaleAdicEquiv p X).functor.obj U).left = U.obj.left.obj ∧
    HEq ((smallFiniteEtaleAdicEquiv p X).functor.obj U).hom U.obj.hom.hom := sorry

