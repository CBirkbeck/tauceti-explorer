/-! ### Layer 5: Integral comparisons on charts and tails -/
namespace PerfectoidSpace
open Perfectoid
variable (p : ℕ) [Fact p.Prime]

/-- Completing integral global sections agrees with the integral sections of the limit.
The equation also applies to the rational base-change diagram. -/
theorem cofilteredLimit.globalPlusCompletion {I : Type} [SmallCategory I] [IsCofiltered I]
    (X : I ⥤ Perfd p) (hX : ∀ i, IsAffinoidPerfectoid p (X.obj i).obj)
    (t : ∀ i, globalPlus p (X.obj i))
    (ht : ∀ {i j} (a : i ⟶ j), globalPullback p (X.map a) (t j).val = (t i).val)
    (hp : ∀ (i : I) (C : Chart p (X.obj i)), IsPseudoUniformizer ((t i).val.val C))
    (i₀ : I) :
    ∃ e : AdicCompletion (Ideal.span {colimit.ι (plusSectionsDiagram p X) (op i₀) (t i₀)})
      (↥(colimit (plusSectionsDiagram p X))) ≃+* globalPlus p (cofilteredLimit p X hX),
      ∀ (i : I) (x : globalPlus p (X.obj i)),
        (e (algebraMap (↥(colimit (plusSectionsDiagram p X))) _
          (colimit.ι (plusSectionsDiagram p X) (op i) x))).val =
          globalPullback p (cofilteredLimit.π p X hX i) x.val := sorry

/-- A principal-adic map into integral sections is continuous on each affinoid chart. -/
theorem integral_sections_chart_continuous (Y : Perfd p) (tY : globalPlus p Y)
    (htY : ∀ C : Chart p Y, IsPseudoUniformizer (tY.val.val C))
    (A : Type) [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    (t : A) (hA : IsAdic (Ideal.span {t}))
    (f : A →+* globalPlus p Y) (hf : f t = tY) (C : Chart p Y) :
    Continuous (fun x : A ↦ (f x).val.val C) := sorry

/-- After localization the same chart maps are continuous for the specified Tate topology. -/
theorem integral_sections_localized_continuous (Y : Perfd p) (tY : globalPlus p Y)
    (htY : ∀ C : Chart p Y, IsPseudoUniformizer (tY.val.val C))
    (A : Type) [CommRing A] (t : A)
    [TopologicalSpace (Localization.Away t)] [IsTopologicalRing (Localization.Away t)]
    (hbase : (𝓝 (0 : Localization.Away t)).HasBasis (fun n : ℕ ↦ 0 ≤ n)
      (fun n ↦ {x | ∃ a : A, x = algebraMap A (Localization.Away t) (t ^ n * a)}))
    (f : A →+* globalPlus p Y) (hf : f t = tY)
    (g : Localization.Away t →+* globalSections p Y)
    (hg : ∀ a : A, g (algebraMap A _ a) = (f a).val) (C : Chart p Y) :
    Continuous (fun x : Localization.Away t ↦ (g x).val C) := sorry
end PerfectoidSpace

namespace Perfectoid
universe u
variable (p : ℕ) [Fact p.Prime]
/-- A morphism of perfectoid pairs preserves the chosen plus-ring root system. -/
theorem compatible_pseudouniformizer_map (R S : PairCat.{u} p) (f : R ⟶ S)
    (r : ℕ → R.pair.plus) (ht : IsPseudoUniformizer (r 0 : R))
    (hd : r 0 ^ p ∣ (p : R.pair.plus)) (hr : ∀ n, r (n + 1) ^ p = r n) :
    let s : ℕ → S.pair.plus := fun n ↦ ⟨f.toRingHom (r n), f.map_mem_plus _ (r n).property⟩
    IsPseudoUniformizer (s 0 : S) ∧ s 0 ^ p ∣ (p : S.pair.plus) ∧
      ∀ n, s (n + 1) ^ p = s n := sorry
end Perfectoid

/-! ### Layer 5: The punctured Cantor affinoid -/
namespace PerfectoidSpace
open Perfectoid
variable (p : ℕ) [Fact p.Prime]
-- Check: finiteStage_punctured_cantor_space
example (K : AffinoidField p)
    (ϖ : PseudoUniformizerRoots p ((binaryFunctionDiagram p (K.toPairCat p)).obj 0)) :
    let R := K.toPairCat p
    let X := ofPair p (continuousFunctionPair p (ℕ → Bool) R)
    let e := continuousFunctionSpaceHomeomorph p (ℕ → Bool) R
    ∃ U : TopologicalSpace.Opens (underlyingPoints p X),
      (U : Set (underlyingPoints p X)) = {x | ∃ n, (e x).1 n = true} ∧
      (∃ Y : smallEtale p X, Y.obj = Over.mk (restrictι p X U)) ∧
      ¬ QuasiCompact p (restrictι p X U) ∧
      ∀ n : ℕ, ¬ ∃ V : Set (underlyingPoints p (ofPair p ((binaryFunctionDiagram p R).obj n))),
        (U : Set (underlyingPoints p X)) =
          pointMap p ((spaFunctor p).map
            ((completedColimit.ι p (binaryFunctionDiagram p R) 0 ϖ n) ≫
              (binaryFunctionEquiv p R ϖ).hom).op) ⁻¹' V := sorry
end PerfectoidSpace

