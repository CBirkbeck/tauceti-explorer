/-! ### P3/perfectoid-tate-rings-are-strongly-sheafy -/

/-- Berkeley 6.3.2(1), 6.3.3(3), 6.3.4, pp. 47–48: perfectoid Tate rings are strongly sheafy. -/
theorem stronglySheafy (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] : Huber.IsStronglySheafy R := sorry

/-- A perfectoid Yoneda-adic space has a locally strongly sheafy adic representative. -/
theorem locallyStronglySheafy (X : Perfd p) :
    ∃ A : TauCeti.AdicSpace, AdicSpace.IsLocallyStronglySheafy A ∧
      Nonempty (YonedaAdicSpace.ofAdicSpace.obj A ≅ X.obj) := sorry

/-- Sch12 7.3(iii) and 7.10: étale base change from a locally strongly sheafy
adic space is represented by a perfectoid space. -/
theorem perfectoid_etale_baseChange {Y X : TauCeti.AdicSpace}
    (hX : AdicSpace.IsLocallyStronglySheafy X)
    (hY : AdicSpace.IsLocallyStronglySheafy Y) (f : Y ⟶ X)
    (hf : AdicSpace.IsEtaleLocalDescription f) (Z : Perfd p)
    (g : Z.obj ⟶ YonedaAdicSpace.ofAdicSpace.obj X) :
    ∃ (W : Perfd p) (a : W.obj ⟶ YonedaAdicSpace.ofAdicSpace.obj Y) (b : W ⟶ Z),
      IsPullback a b.hom (YonedaAdicSpace.ofAdicSpace.map f) g ∧ IsEtale p b := sorry

/-- The finite étale case has the same adic universal property. -/
theorem perfectoid_finiteEtale_baseChange {Y X : TauCeti.AdicSpace}
    (hX : AdicSpace.IsLocallyStronglySheafy X)
    (hY : AdicSpace.IsLocallyStronglySheafy Y) (f : Y ⟶ X)
    (hf : AdicSpace.IsFiniteEtale f) (Z : Perfd p)
    (g : Z.obj ⟶ YonedaAdicSpace.ofAdicSpace.obj X) :
    ∃ (W : Perfd p) (a : W.obj ⟶ YonedaAdicSpace.ofAdicSpace.obj Y) (b : W ⟶ Z),
      IsPullback a b.hom (YonedaAdicSpace.ofAdicSpace.map f) g ∧ IsFiniteEtale p b := sorry

/-- The ordinary and integral functions agree with A1 on every adic representative;
these ring equivalences commute with pullback. Sch12 7.11–7.13, p. 43. -/
theorem globalSections_adicComparison :
    ∃ E : ∀ (X : Perfd p) (A : TauCeti.AdicSpace)
      (_ : YonedaAdicSpace.ofAdicSpace.obj A ≅ X.obj),
      globalSections p X ≃+* A.obj.toRingPresheafedSpace.presheaf.obj (Opposite.op ⊤),
    (∀ X A e, (globalPlus p X).map (E X A e).toRingHom = AdicSpace.Oplus A ⊤) ∧
    ∀ (X Y : Perfd p) (A B : TauCeti.AdicSpace)
      (eX : YonedaAdicSpace.ofAdicSpace.obj A ≅ X.obj)
      (eY : YonedaAdicSpace.ofAdicSpace.obj B ≅ Y.obj)
      (f : X ⟶ Y) (g : A ⟶ B),
      YonedaAdicSpace.ofAdicSpace.map g ≫ eY.hom = eX.hom ≫ f.hom →
      ∀ s : globalSections p Y,
        E X A eX (globalPullback p f s) =
          (g.hom.c.app (Opposite.op ⊤)).hom (E Y B eY s) := sorry

