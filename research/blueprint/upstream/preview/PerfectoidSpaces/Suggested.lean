/-! ### P3/completed-tensor-plus-ring-not-integrally-closed -/

/-- A nontrivial totally ramified Galois extension gives an integral idempotent
outside the completed tensor of integer rings (Sch12 3.7 and the Galois product formula). -/
theorem completed_tensor_plus_not_integrally_closed
    (p : ℕ) [Fact p.Prime]
    (K L : Type) [NontriviallyNormedField K] [NontriviallyNormedField L]
    [IsUltrametricDist K] [IsUltrametricDist L] [CompleteSpace K] [CompleteSpace L]
    [NormedAlgebra K L] [FiniteDimensional K L] [IsGalois K L]
    [IsPerfectoidTateRing p K] [IsPerfectoidTateRing p L]
    (hne : 1 < Module.finrank K L)
    (hres : ∀ (σ : L ≃ₐ[K] L) (x : powerBoundedSubring L),
      IsTopologicallyNilpotent (σ x.val - x.val))
    (ϖ : powerBoundedSubring K) (hϖ : IsPseudoUniformizer ϖ.val) :
    let R := powerBoundedSubring K
    let S := powerBoundedSubring L
    let f : R →+* S := (algebraMap K L).comp R.subtype |>.codRestrict S (by sorry)
    letI : Algebra R S := f.toAlgebra
    let B := S ⊗[R] S
    let I : Ideal B := Ideal.span {algebraMap R B ϖ}
    let C := AdicCompletion I B
    letI : TopologicalSpace C :=
      (Ideal.span {AdicCompletion.of I B (algebraMap R B ϖ)}).adicTopology
    ∃ φ : C →+* ((L ≃ₐ[K] L) → L),
      Continuous φ ∧
      (∀ (a b : S) (σ : L ≃ₐ[K] L),
        φ (AdicCompletion.of I B (a ⊗ₜ[R] b)) σ = a.val * σ b.val) ∧
      letI := Classical.decEq (L ≃ₐ[K] L)
      let e : (L ≃ₐ[K] L) → L := fun σ ↦ if σ = AlgEquiv.refl then 1 else 0
      IsIntegral φ.range e ∧ e ∉ φ.range := sorry

/-- The tame cubic example exists already in residue characteristic two: take the
completed unramified cyclotomic field and adjoin a cube root of two. -/
theorem tame_cubic_perfectoid_extension :
    ∃ (K L : Subfield ℂ_[2]) (hKL : K ≤ L)
      (_ : IsTateRing K) (_ : IsTateRing L)
      (_ : CompleteSpace K) (_ : CompleteSpace L),
      IsClosed (K : Set ℂ_[2]) ∧ IsClosed (L : Set ℂ_[2]) ∧
      IsPerfectoidTateRing 2 K ∧ IsPerfectoidTateRing 2 L ∧
      letI : Algebra K L := (Subfield.inclusion hKL).toAlgebra
      FiniteDimensional K L ∧ IsGalois K L ∧ Module.finrank K L = 3 ∧
      (∃ a : L, a ^ 3 = 2 ∧ Algebra.adjoin K {a} = ⊤) ∧
      ∀ (σ : L ≃ₐ[K] L) (x : powerBoundedSubring L),
        IsTopologicallyNilpotent (σ x.val - x.val) := sorry

end


/-- The field structure on the original tilt ring, retaining its ring operations. -/
local instance fieldOnTilt (p : ℕ) [Fact p.Prime]
    (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K]
    [CompleteSpace K] [IsPerfectoidField p K] : Field (tilt p K) :=
  (MulEquiv.isField (Field.toIsField (tiltField p K))
    (tiltField.toTilt p K).symm.toMulEquiv).toField

/-! ### P3/fontaine-wintenberger -/

/-- Fontaine–Wintenberger as a continuous isomorphism of the actual absolute Galois groups.
Choices of closures determine the isomorphism up to inner automorphism. -/
def fontaineWintenberger (p : ℕ) [Fact p.Prime]
    (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K]
    [CompleteSpace K] [IsPerfectoidField p K] :
    Field.absoluteGaloisGroup K ≃ₜ* Field.absoluteGaloisGroup (tilt p K) := sorry

/-- A choice of compatible geometric fibres fixes the inner-automorphism ambiguity. -/
def fontaineWintenbergerFiberIso (p : ℕ) [Fact p.Prime]
    (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K]
    [CompleteSpace K] [IsPerfectoidField p K] :
    (FiniteEtale.untilt p K).op ⋙ CommAlgCat.FiniteEtale.fiber K (AlgebraicClosure K) ≅
      CommAlgCat.FiniteEtale.fiber (tilt p K) (AlgebraicClosure (tilt p K)) := sorry

/-- The Galois isomorphism is the one induced by the actual finite-algebra untilt.
Both sides act on a geometric fibre by postcomposition. -/
theorem fontaineWintenberger_fiber_action (p : ℕ) [Fact p.Prime]
    (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K]
    [CompleteSpace K] [IsPerfectoidField p K]
    (g : Field.absoluteGaloisGroup K) (T : CommAlgCat.FiniteEtale.{u} (tilt p K))
    (φ : ((FiniteEtale.untilt p K).obj T) →ₐ[K] AlgebraicClosure K) :
    (fontaineWintenbergerFiberIso p K).hom.app (Opposite.op T) (g.toAlgHom.comp φ) =
      (fontaineWintenberger p K g).toAlgHom.comp
        ((fontaineWintenbergerFiberIso p K).hom.app (Opposite.op T) φ) := sorry

section
variable (p : ℕ) [Fact p.Prime]
attribute [local instance] subfieldPadicComplexTate kummerFieldComplete
-- Check: fontaine_wintenberger_test_kummer_tower
example (r : ℕ → ℂ_[p]) (hzero : r 0 = p) (hroot : ∀ n, r (n + 1) ^ p = r n) :
    letI := kummerField_isPerfectoid p r hzero hroot
    ∃ e : tilt p (Almost.kummerField p r) ≃+* completedPerfectLaurentFp p,
      Continuous e ∧ Continuous e.symm ∧
      (tilt.sharp (e.symm (perfectLaurentRoot p 0))).val = p ∧
      Nonempty (CommAlgCat.FiniteEtale (Almost.kummerField p r) ≌
        CommAlgCat.FiniteEtale (LaurentSeries (ZMod p))) := sorry
-- Check: fontaine_wintenberger_test_p_two_cyclotomic
example (ε : tilt 2 (padicCyclotomic 2))
    (hε : ∀ n, IsPrimitiveRoot (tilt.coeff n ε) (2 ^ n)) :
    ∃ e : tilt 2 (padicCyclotomic 2) ≃+* completedPerfectLaurentFp 2,
      Continuous e ∧ Continuous e.symm ∧ e (ε - 1) = perfectLaurentRoot 2 0 ∧
      tilt.coeff 1 ε = -1 ∧
      Nonempty (CommAlgCat.FiniteEtale (padicCyclotomic 2) ≌
        CommAlgCat.FiniteEtale (LaurentSeries (ZMod 2))) := sorry

end

section TiltingEquivalence

variable (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] [hperfect : IsPerfectoidTateRing p R]

/-- ECD Theorem 6.1(ii), KL Theorem 3.6.21: over any
perfectoid Tate ring the untilting functor `FÉt(R♭) ⥤ FÉt(R)` is an equivalence. -/
instance FiniteEtale.untilt_isEquivalence : (FiniteEtale.untilt p R).IsEquivalence := sorry

/-! ### P3/finite-etale-tilting-equivalence -/

/-- The tilting equivalence `FÉt(R) ≌ FÉt(R♭)`, `S ↦ S♭`,
the inverse of the untilting functor. -/
def finiteEtaleTiltEquiv :
    CommAlgCat.FiniteEtale.{u} R ≌ CommAlgCat.FiniteEtale.{u} (tilt p R) :=
  (FiniteEtale.untilt p R).asEquivalence.symm

-- test fontaine_wintenberger_test_char_p (degenerate)
/- In characteristic `p` the tilt of a perfectoid Tate ring is the ring itself, so untilting is
isomorphic to the identity and the Fontaine–Wintenberger map is the identity. -/
include hperfect in
example [CharP R p] (x : tilt p R) :
    (tilt.equivOfCharP : tilt p R ≃+* R) x = tilt.coeff 0 x ∧
      (tilt.coeff 1 x) ^ p = (tilt.equivOfCharP : tilt p R ≃+* R) x := sorry

-- test finiteEtaleTiltEquiv_test_direction (compatibility)
/- `finiteEtaleTiltEquiv` is the inverse of untilting: its functor composed with `untilt` is
isomorphic to the identity of `FÉt(R)`. -/
example : Nonempty ((finiteEtaleTiltEquiv p R).functor ⋙ FiniteEtale.untilt p R ≅ 𝟭 _) :=
  ⟨(finiteEtaleTiltEquiv p R).unitIso.symm⟩

-- check finiteEtaleTiltEquiv_test_rank_zero
example : Nonempty ((finiteEtaleTiltEquiv p R).functor.obj
    (CommAlgCat.FiniteEtale.of R (Fin 0 → R)) ≅
      CommAlgCat.FiniteEtale.of (tilt p R) (Fin 0 → tilt p R)) := sorry

-- check finiteEtaleTiltEquiv_test_rank_one
example : Nonempty ((finiteEtaleTiltEquiv p R).functor.obj
    (CommAlgCat.FiniteEtale.of R R) ≅
      CommAlgCat.FiniteEtale.of (tilt p R) (tilt p R)) := sorry

-- check finiteEtaleTiltEquiv_test_rank_two
example : Nonempty ((finiteEtaleTiltEquiv p R).functor.obj
    (CommAlgCat.FiniteEtale.of R (Fin 2 → R)) ≅
      CommAlgCat.FiniteEtale.of (tilt p R) (Fin 2 → tilt p R)) := sorry

end TiltingEquivalence

