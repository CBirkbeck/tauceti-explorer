/-- The boundary plus ring: nonnegative monomials have integral coefficients;
negative monomials have topologically nilpotent coefficients. -/
def annulusBoundaryPlus (K : AffinoidField p) (π : PseudoUniformizerRoots p K) :
    Subring (perfectedTateAlgebra.laurent p π Unit) :=
  (Subring.closure {z | ∃ (a : K) (r : pPowerIntegers p),
    z = algebraMap K _ a * perfectedTateAlgebra.laurent.X p π Unit () r ∧
      ((0 ≤ (r : ℚ) ∧ ‖a‖ ≤ 1) ∨ ‖a‖ < 1)}).topologicalClosure

/-- The annulus intersection has the boundary plus ring, not the maximal plus ring. -/
theorem proRationalSubspace.annulusClosure_plus (K : AffinoidField p)
    (π : PseudoUniformizerRoots p K) :
    ∃ e : proRationalPair p (discPair p K π) (annulusSystem p K π) ≃+*
      perfectedTateAlgebra.laurent p π Unit,
      Continuous e ∧ Continuous e.symm ∧
      ((proRationalPair p (discPair p K π) (annulusSystem p K π)).pair.plus).map
        e.toRingHom = annulusBoundaryPlus p K π := sorry
-- Check: annulusBoundaryPlus_positive
example (K : AffinoidField p) (π : PseudoUniformizerRoots p K)
    (r : pPowerIntegers p) (hr : 0 ≤ (r : ℚ)) :
    perfectedTateAlgebra.laurent.X p π Unit () r ∈ annulusBoundaryPlus p K π := sorry
-- Check: annulusBoundaryPlus_small_negative
example (K : AffinoidField p) (π : PseudoUniformizerRoots p K)
    (a : K) (ha : ‖a‖ < 1) (r : pPowerIntegers p) (hr : (r : ℚ) < 0) :
    algebraMap K _ a * perfectedTateAlgebra.laurent.X p π Unit () r ∈
