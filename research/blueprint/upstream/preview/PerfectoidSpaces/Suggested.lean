/-! ### Layer 6: Subpair diagrams and finite-stage assembly -/

namespace KappaSubpairs
variable {p} {R S : PairCat.{0} p} {a : R ⟶ S} {κ : Cardinal.{1}}

def pair (B : KappaSubpairs p a κ) : PairCat.{0} p := Classical.choose B.property.2.2.2

def inclusion (B : KappaSubpairs p a κ) : B.pair ⟶ S :=
  Classical.choose (Classical.choose_spec B.property.2.2.2)

theorem inclusion_spec (B : KappaSubpairs p a κ) :
    Topology.IsClosedEmbedding B.inclusion.toRingHom ∧
    Set.range B.inclusion.toRingHom = B.val ∧
    B.pair.pair.plus = S.pair.plus.comap B.inclusion.toRingHom :=
  Classical.choose_spec (Classical.choose_spec B.property.2.2.2)

def map {B C : KappaSubpairs p a κ} (h : B ≤ C) : B.pair ⟶ C.pair := sorry

theorem map_inclusion {B C : KappaSubpairs p a κ} (h : B ≤ C) :
    map h ≫ C.inclusion = B.inclusion := sorry

def diagram (a : R ⟶ S) (κ : Cardinal.{1}) : (KappaSubpairs p a κ)ᵒᵖ ⥤ Perfd p where
  obj B := ofPair p B.unop.pair
  map f := (spaFunctor p).map (map (leOfHom f.unop)).op
  map_id := by sorry
  map_comp := by sorry

def cone (a : R ⟶ S) (κ : Cardinal.{1}) : Cone (diagram a κ) where
  pt := ofPair p S
  π := { app := fun B ↦ (spaFunctor p).map B.unop.inclusion.op, naturality := by sorry }

def isLimit (a : R ⟶ S) {κ : Cardinal.{1}} (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    (hR : Cardinal.lift.{1} #R < κ) : IsLimit (cone a κ) := sorry

/-- The integral colimit uses the intersections inside S; it is already complete. -/
def plusDiagram (a : R ⟶ S) (κ : Cardinal.{1}) : KappaSubpairs p a κ ⥤ CommRingCat.{0} where
  obj B := CommRingCat.of ↥(B.val ⊓ S.pair.plus)
  map f := CommRingCat.ofHom (Subring.inclusion (inf_le_inf_right _ (leOfHom f)))
  map_id := by sorry
  map_comp := by sorry

def plusCocone (a : R ⟶ S) (κ : Cardinal.{1}) : Cocone (plusDiagram a κ) where
  pt := CommRingCat.of S.pair.plus
  ι := { app := fun _ ↦ CommRingCat.ofHom (Subring.inclusion inf_le_right), naturality := by sorry }

def plusIsColimit (a : R ⟶ S) {κ : Cardinal.{1}} (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    (hR : Cardinal.lift.{1} #R < κ) : IsColimit (plusCocone a κ) := sorry
end KappaSubpairs

/-- The small closed subring construction in the proof of ECD 6.5, p. 29. -/
theorem exists_small_closed_perfectoid_subpair (S : PairCat.{0} p) (A : Set S)
    (ϖ : S) (hϖ : IsPseudoUniformizer ϖ)
    (hp : ∃ a : powerBoundedSubring S, (p : S) = ϖ ^ p * a.val) :
    ∃ (T : PairCat.{0} p) (b : T ⟶ S), Topology.IsClosedEmbedding b.toRingHom ∧
      A ∪ {ϖ, Ring.inverse ϖ} ⊆ Set.range b.toRingHom ∧
      #T ≤ (#A + ℵ₀) ^ ℵ₀ ∧
      T.pair.plus = S.pair.plus.comap b.toRingHom ∧
      powerBoundedSubring T = (powerBoundedSubring S).comap b.toRingHom := sorry

theorem tilt_cardinality (R : PairCat.{0} p) :
    #((PairCat.tiltFunctor p).obj R) ≤ #R ^ ℵ₀ ∧
      #R ≤ #((PairCat.tiltFunctor p).obj R) ^ ℵ₀ * ℵ₀ := sorry

/-- The uniform disjoint-union bound retains the number of components. -/
theorem IsUniformlyKappaSmall.sigma {κ μ : Cardinal.{1}}
    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (hμ : μ < κ)
    {J : Type} (X : J → Perfd p) (hJ : Cardinal.lift.{1} #J < κ)
    (hX : ∀ j, IsKappaSmall p μ (X j)) :
    IsUniformlyKappaSmall p κ (∐ X) := sorry

theorem IsKappaSmall.finite_sigma {κ : Cardinal.{1}}
    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    {J : Type} [Finite J] (X : J → Perfd p) (hX : ∀ j, IsKappaSmall p κ (X j)) :
    IsKappaSmall p κ (∐ X) := sorry

/-- The finite product agrees with the geometric disjoint union. -/
def prodProfinite.finiteIso (X : Perfd p) (S : Profinite.{0}) [Finite S] :
    prodProfinite p X S ≅ ∐ (fun _ : S ↦ X) := sorry

theorem prodProfinite.finiteIso_ι (X : Perfd p) (S : Profinite.{0}) [Finite S] (s : S) :
    Sigma.ι (fun _ : S ↦ X) s ≫ (prodProfinite.finiteIso p X S).inv =
      prodProfinite.pointSection p X S s := sorry

