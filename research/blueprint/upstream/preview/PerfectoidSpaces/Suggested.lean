/-- Internal Hom as a functor in its second argument, GR (2.2.10). -/
def alHomFunctor (M : Module S) : Module S ⥤ Module S where
  obj := alHom S M
  map f := (toAlmost S).map (ModuleCat.ofHom
    { toFun := fun g ↦ g ≫ f
      map_add' := by intros; simp
      map_smul' := by intros; simp })
  map_id := by sorry
  map_comp := by sorry

