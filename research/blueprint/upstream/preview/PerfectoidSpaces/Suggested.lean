/-! ### P0/filtered-principal-union-tilde-flat -/

/-- Condition (A): principal subideals form a directed family (GR (2.1.6)). -/
def IsFilteredPrincipal : Prop :=
  ∀ x ∈ S.ideal, ∀ y ∈ S.ideal, ∃ z ∈ S.ideal, z ∣ x ∧ z ∣ y

/-- Condition (B): every positive power generates the same ideal (GR (2.1.6)). -/
def PowersGenerate : Prop :=
  ∀ k : ℕ, 0 < k → Ideal.span ((fun x : V ↦ x ^ k) '' (S.ideal : Set V)) = S.ideal

/-- The almost-isomorphism predicate on linear maps (GR (2.1.3)). -/
def IsAlmostIso {M N : Type u} [AddCommGroup M] [Module V M]
    [AddCommGroup N] [Module V N] (f : M →ₗ[V] N) : Prop :=
  S.IsAlmostZero (LinearMap.ker f) ∧ S.IsAlmostZero (N ⧸ LinearMap.range f)

/-- Directed principal subideals and idempotence imply condition (B), GR (2.1.6). -/
theorem IsFilteredPrincipal.powersGenerate (h : S.IsFilteredPrincipal) : S.PowersGenerate := sorry

/-- Flatness of the tensor ideal from directed principal subideals, GR Proposition 2.1.7(i).
The input is an ideal, without assuming the desired flatness as part of a setup. -/
theorem flat_tilde_of_filtered_principal (I : Ideal V) (hI : IsIdempotentElem I)
    (hdir : ∀ x ∈ I, ∀ y ∈ I, ∃ z ∈ I, z ∣ x ∧ z ∣ y) :
    Module.Flat V (I ⊗[V] I) := sorry

/-! ### P0/almost-zero-iff-tilde-tensor-zero -/

/-- Tensoring with the tensor ideal detects almost zero modules, GR Remark 2.1.4(i). -/
theorem isAlmostZero_iff_tensor_eq_zero (M : Type u) [AddCommGroup M] [Module V M] :
    S.IsAlmostZero M ↔ Subsingleton (S.tilde ⊗[V] M) := sorry

/-- The ideal itself detects almost zero modules, GR Remark 2.1.4(i). -/
theorem isAlmostZero_iff_ideal_tensor_eq_zero (M : Type u) [AddCommGroup M] [Module V M] :
    S.IsAlmostZero M ↔ Subsingleton (S.ideal ⊗[V] M) := sorry

/-- Tensoring with the tensor ideal detects almost isomorphisms, GR Remark 2.1.4(i). -/
theorem isAlmostIso_iff_tensor_bijective {M N : Type u} [AddCommGroup M] [Module V M]
    [AddCommGroup N] [Module V N] (f : M →ₗ[V] N) :
    S.IsAlmostIso f ↔ Function.Bijective (TensorProduct.map (LinearMap.id : S.tilde →ₗ[V] S.tilde) f) :=
  sorry

/-- The linear-map convention agrees with the Serre morphism property, GR (2.2.2). -/
theorem isAlmostIso_iff_isoModSerre {M N : ModuleCat.{u} V} (f : M ⟶ N) :
    S.IsAlmostIso f.hom ↔ S.almostZero.isoModSerre f := sorry

/-- The root ideal satisfies (A), ECD Definition 3.21. -/
theorem ofCompatibleRoots_isFilteredPrincipal (p : ℕ) (hp : 2 ≤ p) (t : ℕ → V)
    (ht : ∀ n, t (n + 1) ^ p = t n) :
    (ofCompatibleRoots p hp t ht).IsFilteredPrincipal := sorry

/-- A valuation domain has linearly ordered principal ideals, GR Example 2.1.2(i). -/
theorem ofValuationRing_isFilteredPrincipal (O : Type u) [CommRing O] [IsDomain O]
    [ValuationRing O] (h : ¬ (IsLocalRing.maximalIdeal O).FG) :
    (ofValuationRing O h).IsFilteredPrincipal := sorry

/-- Almost zero in the root setup is annihilation by every root, ECD Definition 3.21. -/
theorem ofCompatibleRoots_isAlmostZero_iff (p : ℕ) (hp : 2 ≤ p) (t : ℕ → V)
    (ht : ∀ n, t (n + 1) ^ p = t n) (M : Type u) [AddCommGroup M] [Module V M] :
    (ofCompatibleRoots p hp t ht).IsAlmostZero M ↔ ∀ n (x : M), t n • x = 0 := sorry

/-- Removing finitely many roots does not change their union, ECD Definition 3.21. -/
theorem ofCompatibleRoots_shift (p : ℕ) (hp : 2 ≤ p) (t : ℕ → V)
    (ht : ∀ n, t (n + 1) ^ p = t n) (k : ℕ) :
    ofCompatibleRoots p hp (fun n ↦ t (n + k)) (by intro n; simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using ht (n + k)) =
      ofCompatibleRoots p hp t ht := sorry

/-- Root setups commute with arbitrary scalar extension, GR Remark 2.1.4(ii). -/
theorem ofCompatibleRoots_baseChange (p : ℕ) (hp : 2 ≤ p) (t : ℕ → V)
    (ht : ∀ n, t (n + 1) ^ p = t n) (W : Type u) [CommRing W] [Algebra V W] :
    (ofCompatibleRoots p hp t ht).baseChange W =
      ofCompatibleRoots p hp (fun n ↦ algebraMap V W (t n))
        (by intro n; rw [← map_pow, ht]) := sorry

