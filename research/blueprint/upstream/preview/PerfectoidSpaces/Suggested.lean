/-- Rational neighbourhoods, ordered by inclusion, give the integral stalk. -/
def rationalNeighborhoods (R : PairCat.{0} p) (x : spa R.pair.plus) : RationalSystem p R where
  family := {U | x ∈ U.val}
  nonempty := by sorry
  filtered := by sorry

def RationalSystem.spaceDiagram {R : PairCat.{0} p} (D : RationalSystem p R) : D.family ⥤ Perfd p where
  obj U := ofPair p (rationalPair p R U.val)
  map f := (spaFunctor p).map (rationalRes p R _ _ (leOfHom f)).op
  map_id := by sorry
  map_comp := by sorry

def proRationalSubspace.cone (R : PairCat.{0} p) (D : RationalSystem p R) :
    Cone (D.spaceDiagram p) where
  pt := proRationalSubspace p R D
  π := { app := fun U ↦ (spaFunctor p).map (proRationalStage p R D U).op,
         naturality := by sorry }

def proRationalSubspace.isLimit (R : PairCat.{0} p) (D : RationalSystem p R) :
    IsLimit (proRationalSubspace.cone p R D) := sorry

theorem proRationalSubspace.isPerfectoid (R : PairCat.{0} p) (D : RationalSystem p R) :
    IsPerfectoidTateRing p (proRationalPair p R D) := inferInstance

theorem proRationalSubspace.plus_mod_pow (R : PairCat.{0} p) (D : RationalSystem p R)
    (π : R.pair.plus) (hπ : IsPseudoUniformizer (π : R)) (n : ℕ) :
    Nonempty (((proRationalPair p R D).pair.plus ⧸ Ideal.span
      {(⟨(proRationalMap p R D).toRingHom π,
        (proRationalMap p R D).map_mem_plus π π.property⟩ : (proRationalPair p R D).pair.plus) ^ n}) ≃+*
      (↥(colimit (D.plusDiagram p)) ⧸ Ideal.span {(D.scalar p π) ^ n})) := sorry

theorem residueFieldPoint_eq_proRationalSubspace (R : PairCat.{0} p) (x : spa R.pair.plus) :
    ∃ e : ofPair p ((residueField p (ofPair p R) ((spaSpaceEquiv p R).symm (ULift.up x))).toPairCat p) ≅
      proRationalSubspace p R (rationalNeighborhoods p R x),
      e.hom ≫ proRationalSubspace.ι p R (rationalNeighborhoods p R x) =
        residueFieldPoint p (ofPair p R) ((spaSpaceEquiv p R).symm (ULift.up x)) := sorry

theorem residueFieldPoint_factor (X : Perfd p) (x : (underlyingPoints p) X) (K : AffinoidField p)
    (a : fieldPoints p X K) (ha : fieldPoints.closedPointImage p K a = x) :
    ∃! e : (residueField p X x).toPairCat p ⟶ K.toPairCat p,
      (spaFunctor p).map e.op ≫ residueFieldPoint p X x = a := sorry

