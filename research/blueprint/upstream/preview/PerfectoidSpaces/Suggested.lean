/-! ### Layer 4: Field points and global morphism properties -/
namespace PerfectoidSpace
open Perfectoid TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]

abbrev underlyingPoints (X : Perfd p) := YonedaAdicSpace.space.obj X.obj
abbrev pointMap {X Y : Perfd p} (f : X ⟶ Y) := YonedaAdicSpace.space.map f.hom

/-! ### P4/affinoid-perfectoid-field-points -/

/-- ECD §5: a perfectoid field with a specified open bounded valuation subring. -/
structure AffinoidField where
  carrier : Type
  [normedField : NontriviallyNormedField carrier]
  [ultrametric : IsUltrametricDist carrier]
  [complete : CompleteSpace carrier]
  [perfectoid : IsPerfectoidField p carrier]
  plus : ValuationSubring carrier
  integral : IsRingOfIntegralElements plus.toSubring
attribute [instance] AffinoidField.normedField AffinoidField.ultrametric
  AffinoidField.complete AffinoidField.perfectoid
instance : CoeSort (AffinoidField p) Type := ⟨AffinoidField.carrier⟩

def AffinoidField.toPair (K : AffinoidField p) : Pair K := ⟨K.plus.toSubring, K.integral⟩
def AffinoidField.toPairCat (K : AffinoidField p) : PairCat.{0} p :=
  { carrier := K, pair := K.toPair p }

/-- The maximal plus ring, with the original norm and field structure. -/
def AffinoidField.ofRankOne (K : Type) [NontriviallyNormedField K]
    [IsUltrametricDist K] [CompleteSpace K] [IsPerfectoidField p K] : AffinoidField p where
  carrier := K
  plus := ValuationSubring.ofSubring (powerBoundedSubring K) (by sorry)
  integral := (Pair.powerBounded K).isRingOfIntegralElements

/-- Valuation rings between K⁺ and K° classify all continuous points, ECD §5. -/
def AffinoidField.valuationEquiv (K : AffinoidField p) :
    spa (K.toPair p).plus ≃ {V : ValuationSubring K // K.plus ≤ V ∧
      V.toSubring ≤ powerBoundedSubring K} := sorry

def AffinoidField.closedPoint (K : AffinoidField p) : spa (K.toPair p).plus :=
  (K.valuationEquiv p).symm ⟨K.plus, le_rfl, K.integral.le_powerBoundedSubring⟩

theorem AffinoidField.closedPoint_spec (K : AffinoidField p) :
    ∀ x : spa (K.toPair p).plus, IsClosed ({x} : Set _) ↔ x = K.closedPoint p := sorry

theorem AffinoidField.isOpen_iff (K : AffinoidField p) (U : Set (spa (K.toPair p).plus)) :
    IsOpen U ↔ ∀ x ∈ U, ∃ h : K, h ∈ powerBoundedSubring K ∧
      h ∈ (K.valuationEquiv p x).val ∧
      {y | h ∈ (K.valuationEquiv p y).val} ⊆ U := sorry

/-- An increasing sequence of proper valuation subrings exhausting K° makes the
rank-one point non-open; the reverse-lexicographic rational value group gives this chain. -/
theorem AffinoidField.not_isOpen_rankOnePoint (K : AffinoidField p)
    (W : ℕ → ValuationSubring K) (hW : StrictMono W) (hzero : W 0 = K.plus)
    (hproper : ∀ n, (W n).toSubring < powerBoundedSubring K)
    (hexhaust : ∀ x ∈ powerBoundedSubring K, ∃ n, x ∈ W n)
    (x : spa (K.toPair p).plus)
    (hx : (K.valuationEquiv p x).val.toSubring = powerBoundedSubring K) :
    ¬ IsOpen ({x} : Set (spa (K.toPair p).plus)) := sorry

/-- A characteristic-p perfectoid field with a rank-omega residual valuation.
The valuation has reverse-lexicographic rational value group; its coarsenings
exhaust the norm's valuation ring without reaching it at a finite stage. -/
theorem AffinoidField.exists_infiniteRank :
    ∃ (K : AffinoidField p) (_ : CharP K p)
      (k : Type) (_ : Field k) (_ : PerfectRing k p)
      (ρ : powerBoundedSubring K →+* k)
      (v : Valuation k (WithZero (Multiplicative (Lex (ℕᵒᵈ →₀ ℚ)))))
      (W : ℕ → ValuationSubring K),
      Function.Surjective ρ ∧ Function.Surjective v ∧
      (∀ a, ρ a = 0 ↔ ‖(a : K)‖ < 1) ∧
      (∀ a : powerBoundedSubring K, a.val ∈ K.plus ↔ v (ρ a) ≤ 1) ∧
      StrictMono W ∧ W 0 = K.plus ∧
      (∀ n, (W n).toSubring < powerBoundedSubring K) ∧
      (∀ a ∈ powerBoundedSubring K, ∃ n, a ∈ W n) ∧
      (∀ V : ValuationSubring K, K.plus ≤ V →
        V.toSubring ≤ powerBoundedSubring K →
        V.toSubring = powerBoundedSubring K ∨ ∃ n, V = W n) := sorry

-- Check: AffinoidField.not_isOpen_rankOnePoint_realization
example : ∃ (K : AffinoidField p) (x : spa (K.toPair p).plus),
    (K.valuationEquiv p x).val.toSubring = powerBoundedSubring K ∧
    ¬ IsOpen ({x} : Set (spa (K.toPair p).plus)) := by
  obtain ⟨K, _, k, _, _, ρ, v, W, _, _, _, _, hW, hzero, hproper, hexhaust, _⟩ :=
    AffinoidField.exists_infiniteRank p
  obtain ⟨x, hx⟩ : ∃ x : spa (K.toPair p).plus,
      (K.valuationEquiv p x).val.toSubring = powerBoundedSubring K := by sorry
  exact ⟨K, x, hx, AffinoidField.not_isOpen_rankOnePoint p K W hW hzero hproper hexhaust x hx⟩

-- Check: almost_purity_test_not_etale_integrally
example (ℓ : ℕ) (hℓ : ℓ.Prime) (htame : ¬ ℓ ∣ p * (p - 1)) :
    let K : PairCat.{0} p :=
      { carrier := padicCyclotomic p, pair := Pair.powerBounded (padicCyclotomic p) }
    ∃ (L : AffinoidField p) (f : K ⟶ (AffinoidField.ofRankOne p L).toPairCat p),
      Pair.IsFiniteEtale f ∧
      Almost.Algebra.IsFiniteEtale (almostSetup p K) (Pair.almostMap f) ∧
      letI : Algebra K L := f.toRingHom.toAlgebra
      Module.finrank K L = ℓ ∧
      (∃ a : L, a ^ ℓ = p ∧ Algebra.adjoin K {a} = ⊤) ∧
      let g : powerBoundedSubring K →+* powerBoundedSubring L := f.toRingHom.restrict (powerBoundedSubring K) (powerBoundedSubring L)
        (fun _ hx ↦ map_mem_powerBoundedSubring
          (IsPerfectoidTateRing.isBounded_powerBoundedSubring (p := p))
          f.toRingHom f.continuous_toRingHom hx)
      letI : Algebra (powerBoundedSubring K) (powerBoundedSubring L) := g.toAlgebra
      ¬ Module.Finite (powerBoundedSubring K) (powerBoundedSubring L) ∧
      ¬ Algebra.Etale (powerBoundedSubring K) (powerBoundedSubring L) := by
  sorry

-- Check: etale_site_tilting_test_point
example (K L : AffinoidField p)
    (f : (AffinoidField.ofRankOne p K).toPairCat p ⟶
      (AffinoidField.ofRankOne p L).toPairCat p)
    (hf : YonedaAdicSpace.IsFiniteEtale ((spaFunctor p).map f.op).hom) :
    let R := (AffinoidField.ofRankOne p K).toPairCat p
    let S := (AffinoidField.ofRankOne p L).toPairCat p
    let U : smallEtale p (ofPair p R) := ⟨Over.mk ((spaFunctor p).map f.op), by sorry⟩
    ∃ e : ((etaleTiltFunctor p (ofPair p R)).obj U).obj.left ≅
        ofPair p ((PairCat.tiltFunctor p).obj S),
      ((etaleTiltFunctor p (ofPair p R)).obj U).obj.hom ≫ (tiltSpaIso p R).hom =
        e.hom ≫ (spaFunctor p).map ((PairCat.tiltFunctor p).map f).op := by
  exact ⟨tiltSpaIso p _, tiltSpaIso_naturality p f⟩

/-- Field-valued points are actual morphisms in Perfd. -/
abbrev fieldPoints (X : Perfd p) (K : AffinoidField p) := ofPair p (K.toPairCat p) ⟶ X

def fieldPoints.map {X Y : Perfd p} (f : X ⟶ Y) (K : AffinoidField p) :
    fieldPoints p X K → fieldPoints p Y K := fun a ↦ a ≫ f

def fieldPoints.restrict (X : Perfd p) {K L : AffinoidField p}
    (e : K.toPairCat p ⟶ L.toPairCat p) : fieldPoints p X K → fieldPoints p X L :=
  fun a ↦ (spaFunctor p).map e.op ≫ a

def fieldPoints.closedPointImage {X : Perfd p} (K : AffinoidField p)
    (a : fieldPoints p X K) : (underlyingPoints p) X :=
  (pointMap p) a ((spaSpaceEquiv p (K.toPairCat p)).symm (ULift.up (K.closedPoint p)))

def fieldPoints_affinoidEquiv (R : PairCat.{0} p) (K : AffinoidField p) :
    fieldPoints p (ofPair p R) K ≃ (R ⟶ K.toPairCat p) := sorry

theorem fieldPoints_affinoidEquiv_spa (R : PairCat.{0} p) (K : AffinoidField p)
    (a : R ⟶ K.toPairCat p) :
    (fieldPoints_affinoidEquiv p R K).symm a = (spaFunctor p).map a.op := sorry

-- Check: AffinoidField.subsingleton_spa_ofRankOne
example (K : AffinoidField p) : Unique (spa ((AffinoidField.ofRankOne p K).toPair p).plus) := sorry
-- Check: AffinoidField.toPair_rankOne
example (K : AffinoidField p) :
    ((AffinoidField.ofRankOne p K).toPair p).plus = powerBoundedSubring K := rfl
-- Check: AffinoidField.closedPoint_rankOne
example (K : AffinoidField p) (x : spa ((AffinoidField.ofRankOne p K).toPair p).plus) :
    x = (AffinoidField.ofRankOne p K).closedPoint p := sorry
-- Check: AffinoidField.toPair_proper
example (K : AffinoidField p) (h : K.plus.toSubring < powerBoundedSubring K) :
    (K.toPair p).plus ≠ ((AffinoidField.ofRankOne p K).toPair p).plus := ne_of_lt h
-- Check: AffinoidField.card_spa_eq_two
example (K : AffinoidField p) (h : K.plus.toSubring < powerBoundedSubring K)
    (hcover : ∀ V : ValuationSubring K, K.plus ≤ V → V.toSubring ≤ powerBoundedSubring K →
      V = K.plus ∨ V.toSubring = powerBoundedSubring K) :
    Nat.card (spa (K.toPair p).plus) = 2 := sorry
-- Check: AffinoidField.closedPoint_two
example (K : AffinoidField p) (h : K.plus.toSubring < powerBoundedSubring K) :
    ∃ x : spa (K.toPair p).plus, x ≠ K.closedPoint p ∧ ¬ IsClosed ({x} : Set _) := sorry
-- Check: AffinoidField.fieldPoints_affinoidEquiv_closedPoint
example (R : PairCat.{0} p) (K : AffinoidField p) (a : R ⟶ K.toPairCat p) :
    spaSpaceEquiv p R (fieldPoints.closedPointImage p K
      ((fieldPoints_affinoidEquiv p R K).symm a)) = ULift.up (a.spaComap (K.closedPoint p)) := sorry
-- Check: AffinoidField.no_padic
example (K : AffinoidField p) :
    ¬ ∃ e : K ≃+* ℚ_[p], Continuous e ∧ Continuous e.symm := sorry
-- Check: fieldPoints_quadratic
example (K L : AffinoidField p) [Algebra K L] [FiniteDimensional K L]
    [Algebra.IsSeparable K L] (hd : Module.finrank K L = 2)
    (e : K.toPairCat p ⟶ L.toPairCat p) (he : e.toRingHom = algebraMap K L) :
    ∃ (C : AffinoidField p) (_ : IsAlgClosed C)
      (a b : fieldPoints p (ofPair p (L.toPairCat p)) C), a ≠ b ∧
      fieldPoints.map p ((spaFunctor p).map e.op) C a =
        fieldPoints.map p ((spaFunctor p).map e.op) C b := sorry

-- Check: fieldPoints_map_identity
example (K : AffinoidField p) (t : K) :
    let X := ofPair p (K.toPairCat p)
    (fieldPoints_affinoidEquiv p (K.toPairCat p) K
      (fieldPoints.map p (𝟙 X) K (𝟙 X))).toRingHom t = t := sorry
-- Check: fieldPoints_map_composition
example (R S : PairCat.{0} p) (K : AffinoidField p)
    (f : R ⟶ S) (a : S ⟶ K.toPairCat p) (t : R) :
    (fieldPoints_affinoidEquiv p R K
      (fieldPoints.map p ((spaFunctor p).map f.op) K
        ((fieldPoints_affinoidEquiv p S K).symm a))).toRingHom t =
      a.toRingHom (f.toRingHom t) := sorry
-- Check: fieldPoints_restrict_identity
example (K L : AffinoidField p) (e : K.toPairCat p ⟶ L.toPairCat p) (t : K) :
    let X := ofPair p (K.toPairCat p)
    (fieldPoints_affinoidEquiv p (K.toPairCat p) L
      (fieldPoints.restrict p X e (𝟙 X))).toRingHom t = e.toRingHom t := sorry
-- Check: fieldPoints_restrict_composition
example (K L M : AffinoidField p) (e : K.toPairCat p ⟶ L.toPairCat p)
    (d : L.toPairCat p ⟶ M.toPairCat p) (t : K) :
    let X := ofPair p (K.toPairCat p)
    (fieldPoints_affinoidEquiv p (K.toPairCat p) M
      (fieldPoints.restrict p X d (fieldPoints.restrict p X e (𝟙 X)))).toRingHom t =
      d.toRingHom (e.toRingHom t) := sorry
-- Check: fieldPoints_closedPoint_natural
example {X Y : Perfd p} (f : X ⟶ Y) (K : AffinoidField p) (a : fieldPoints p X K) :
    fieldPoints.closedPointImage p K (fieldPoints.map p f K a) =
      (pointMap p) f (fieldPoints.closedPointImage p K a) := sorry

/-! ### P4/quasicompact-and-quasiseparated-maps -/

def QuasiCompact {Y X : Perfd p} (f : Y ⟶ X) : Prop := IsSpectralMap ((pointMap p) f)
def QuasiSeparated {Y X : Perfd p} (f : Y ⟶ X) : Prop := QuasiCompact p (pullback.diagonal f)
/-! ### P4/perfectoid-immersion -/

def IsImmersion {Y X : Perfd p} (f : Y ⟶ X) : Prop :=
  Mono f ∧ Topology.IsEmbedding ((pointMap p) f) ∧ IsLocallyClosed (Set.range ((pointMap p) f))
def IsOpenImmersion {Y X : Perfd p} (f : Y ⟶ X) : Prop :=
  Mono f ∧ Topology.IsOpenEmbedding ((pointMap p) f)
def IsClosedImmersion {Y X : Perfd p} (f : Y ⟶ X) : Prop :=
  Mono f ∧ Topology.IsClosedEmbedding ((pointMap p) f)
/-! ### P4/separated-perfectoid-map -/

/-- Separatedness for a morphism whose source and target are perfectoid spaces:
its perfectoid diagonal is a closed immersion (ECD Definition 5.10, p. 25).
PerfectoidTowers' `IsAnalyticallySeparated.isSeparated` concludes this predicate
over a perfectoid base; `IsAnalyticallySeparated.closed_diagonal` supplies the
representable diagonal condition over an analytic base (ECD Definition 10.7,
p. 51; HJ Lemma 5.5(1), p. 29). -/
def IsSeparated {Y X : Perfd p} (f : Y ⟶ X) : Prop :=
  IsClosedImmersion p (pullback.diagonal f)

theorem quasiCompact_iff_affinoid {Y X : Perfd p} (f : Y ⟶ X) :
    QuasiCompact p f ↔ ∀ C : Chart p X, IsCompact (((pointMap p) f) ⁻¹' Set.range ((pointMap p) C.map)) := sorry

theorem quasiSeparated_iff_affinoid_inter {Y X : Perfd p} (f : Y ⟶ X) :
    QuasiSeparated p f ↔ ∀ (U : Chart p X) (V W : Chart p Y),
      Set.range ((pointMap p) V.map) ⊆ ((pointMap p) f) ⁻¹' Set.range ((pointMap p) U.map) →
      Set.range ((pointMap p) W.map) ⊆ ((pointMap p) f) ⁻¹' Set.range ((pointMap p) U.map) →
      IsCompact (Set.range ((pointMap p) V.map) ∩ Set.range ((pointMap p) W.map)) := sorry

theorem quasiSeparated_iff_quasiSeparatedSpace {Y X : Perfd p} (f : Y ⟶ X)
    [QuasiSeparatedSpace ((underlyingPoints p) X)] : QuasiSeparated p f ↔ QuasiSeparatedSpace ((underlyingPoints p) Y) := sorry

theorem QuasiCompact.comp {X Y Z : Perfd p} {f : X ⟶ Y} {g : Y ⟶ Z}
    (hf : QuasiCompact p f) (hg : QuasiCompact p g) : QuasiCompact p (f ≫ g) := sorry
 theorem QuasiSeparated.comp {X Y Z : Perfd p} {f : X ⟶ Y} {g : Y ⟶ Z}
    (hf : QuasiSeparated p f) (hg : QuasiSeparated p g) : QuasiSeparated p (f ≫ g) := sorry
 theorem QuasiCompact.baseChange {X Y Z : Perfd p} {f : Y ⟶ X}
    (hf : QuasiCompact p f) (g : Z ⟶ X) : QuasiCompact p (pullback.snd f g) := sorry
 theorem QuasiSeparated.baseChange {X Y Z : Perfd p} {f : Y ⟶ X}
    (hf : QuasiSeparated p f) (g : Z ⟶ X) : QuasiSeparated p (pullback.snd f g) := sorry

theorem isInjection_iff_affinoid_tests {Y X : Perfd p} (f : Y ⟶ X) :
    Mono f ↔ ∀ R : PairCat.{0} p, Function.Injective (fun a : ofPair p R ⟶ Y ↦ a ≫ f) := sorry

theorem isInjection_affinoid_iff {R S : PairCat.{0} p} (f : R ⟶ S) :
    Mono ((spaFunctor p).map f.op) ↔ IsInjection_affinoid p f := sorry

/-! ### P4/maps-of-perfectoid-spaces-are-generalizing -/

theorem isGeneralizing {Y X : Perfd p} (f : Y ⟶ X) : GeneralizingMap ((pointMap p) f) := sorry

/-! ### P4/open-immersion-comparison -/

theorem openImmersion_iff_adic {Y X : Perfd p} (f : Y ⟶ X) :
    IsOpenImmersion p f ↔ YonedaAdicSpace.IsOpenImmersion f.hom.hom := sorry

/-- Open immersions agree on adic representatives; ECD Proposition 5.3 and Definition 5.6. -/
theorem openImmersion_iff_preAdic {Y X : Perfd p} (f : Y ⟶ X)
    {A B : TauCeti.AdicSpace} (g : A ⟶ B)
    (eY : YonedaAdicSpace.ofAdicSpace.obj A ≅ Y.obj)
    (eX : YonedaAdicSpace.ofAdicSpace.obj B ≅ X.obj)
    (h : YonedaAdicSpace.ofAdicSpace.map g ≫ eX.hom = eY.hom ≫ f.hom) :
    IsOpenImmersion p f ↔ TauCeti.PreAdicSpace.IsOpenImmersion g.hom := sorry

/-- Quasi-compactness on adic representatives is the compact-open inverse-image test of R0. -/
theorem quasiCompact_iff_adicCompactOpens {Y X : Perfd p} (f : Y ⟶ X)
    {A B : TauCeti.AdicSpace} (g : A ⟶ B)
    (eY : YonedaAdicSpace.ofAdicSpace.obj A ≅ Y.obj)
    (eX : YonedaAdicSpace.ofAdicSpace.obj B ≅ X.obj)
    (h : YonedaAdicSpace.ofAdicSpace.map g ≫ eX.hom = eY.hom ≫ f.hom) :
    QuasiCompact p f ↔ ∀ U : TopologicalSpace.Opens B.obj,
      IsCompact (U : Set B.obj) → IsCompact (g.hom.base ⁻¹' (U : Set B.obj)) := sorry

theorem IsImmersion.ext {Y Z X : Perfd p} {f : Y ⟶ X} {g : Z ⟶ X}
    (hf : IsImmersion p f) (hg : IsImmersion p g)
    (h : Set.range ((pointMap p) f) = Set.range ((pointMap p) g)) : ∃! e : Y ≅ Z, e.hom ≫ g = f := sorry

theorem IsImmersion.stableUnderGeneralization_range {Y X : Perfd p} {f : Y ⟶ X}
    (hf : IsImmersion p f) (x y : (underlyingPoints p) X) (hy : y ∈ Set.range ((pointMap p) f)) (h : x ⤳ y) :
    x ∈ Set.range ((pointMap p) f) := sorry

theorem IsClosedImmersion.quasiCompact {Y X : Perfd p} {f : Y ⟶ X}
    (hf : IsClosedImmersion p f) : QuasiCompact p f := sorry

/-! ### P4/diagonal-of-perfectoid-map -/

theorem diagonal_isImmersion {Y X : Perfd p} (f : Y ⟶ X) :
    IsImmersion p (pullback.diagonal f) := sorry

/-! ### P4/immersions-separatedness-and-truncatedness -/

theorem isSeparated_iff_isClosed_range_diagonal {Y X : Perfd p} (f : Y ⟶ X) :
    IsSeparated p f ↔ IsClosed (Set.range ((pointMap p) (pullback.diagonal f))) := sorry

/-- On adic representatives, perfectoid separatedness is closedness of the actual diagonal.
ECD Proposition 5.11; R0 adds its local weak finite-type and stably sheafy chart hypotheses. -/
theorem isSeparated_iff_adicDiagonal {Y X : Perfd p} (f : Y ⟶ X)
    {A B : TauCeti.AdicSpace} (g : A ⟶ B) [HasPullback g g]
    (eY : YonedaAdicSpace.ofAdicSpace.obj A ≅ Y.obj)
    (eX : YonedaAdicSpace.ofAdicSpace.obj B ≅ X.obj)
    (h : YonedaAdicSpace.ofAdicSpace.map g ≫ eX.hom = eY.hom ≫ f.hom) :
    IsSeparated p f ↔ IsClosed (Set.range (pullback.diagonal g).hom.base) := sorry

theorem IsSeparated.quasiSeparated {Y X : Perfd p} {f : Y ⟶ X}
    (hf : IsSeparated p f) : QuasiSeparated p f := sorry

theorem IsSeparated.of_affinoid {R S : PairCat.{0} p} (f : ofPair p S ⟶ ofPair p R) :
    IsSeparated p f := sorry

theorem IsSeparated.of_isInjection {Y X : Perfd p} (f : Y ⟶ X) [Mono f] :
    IsSeparated p f := sorry

/-! ### P4/injection-iff-universally-injective -/

theorem isInjection_iff_universally_injective {Y X : Perfd p} (f : Y ⟶ X) :
    Mono f ↔ ∀ (Z : Perfd p) (g : Z ⟶ X), Function.Injective ((pointMap p) (pullback.snd f g)) := sorry

/-! ### P4/injections-base-change-composition -/

/-- The topology on this target is the subspace topology of the product. -/
def injectionPullbackHomeomorph {Y X Z : Perfd p} (f : Y ⟶ X) [Mono f] (g : Z ⟶ X) :
    (underlyingPoints p) (pullback f g) ≃ₜ {q : (underlyingPoints p) Y × (underlyingPoints p) Z // (pointMap p) f q.1 = (pointMap p) g q.2} := sorry

theorem injectionPullbackHomeomorph_apply {Y X Z : Perfd p} (f : Y ⟶ X) [Mono f]
    (g : Z ⟶ X) (z : (underlyingPoints p) (pullback f g)) :
    (injectionPullbackHomeomorph p f g z).val =
      ((pointMap p) (pullback.fst f g) z, (pointMap p) (pullback.snd f g) z) := sorry

/-- ECD Example 5.2, using the P2 completed residue pair on each chart. -/
def residueField (X : Perfd p) (x : (underlyingPoints p) X) : AffinoidField p := sorry

def residueField_chart (X : Perfd p) (C : Chart p X) (x : spa C.ring.pair.plus) :
    residueField p X ((pointMap p) C.map ((spaSpaceEquiv p C.ring).symm (ULift.up x))) ≃+*
      CompletedResidue p C.ring x := sorry

theorem residueField_chart_spec (X : Perfd p) (C : Chart p X) (x : spa C.ring.pair.plus) :
    Continuous (residueField_chart p X C x) ∧ Continuous (residueField_chart p X C x).symm ∧
      ((residueField p X ((pointMap p) C.map ((spaSpaceEquiv p C.ring).symm (ULift.up x)))).toPair p).plus.map
        (residueField_chart p X C x).toRingHom = (residuePair p C.ring x).plus := sorry

/-! ### P4/residue-field-point-injection -/

def residueFieldPoint (X : Perfd p) (x : (underlyingPoints p) X) :
    ofPair p ((residueField p X x).toPairCat p) ⟶ X := sorry

theorem residueFieldPoint_closed (X : Perfd p) (x : (underlyingPoints p) X) :
    fieldPoints.closedPointImage p (residueField p X x) (residueFieldPoint p X x) = x := sorry

theorem residueFieldPoint_range (X : Perfd p) (x : (underlyingPoints p) X) :
    Set.range ((pointMap p) (residueFieldPoint p X x)) = {y | y ⤳ x} := sorry

theorem residueFieldPoint_injection (X : Perfd p) (x : (underlyingPoints p) X) :
    Mono (residueFieldPoint p X x) := sorry

def residueFieldMap {Y X : Perfd p} (f : Y ⟶ X) (y : (underlyingPoints p) Y) :
    (residueField p X ((pointMap p) f y)).toPairCat p ⟶ (residueField p Y y).toPairCat p := sorry

theorem residueFieldPoint_naturality {Y X : Perfd p} (f : Y ⟶ X) (y : (underlyingPoints p) Y) :
    (spaFunctor p).map (residueFieldMap p f y).op ≫ residueFieldPoint p X ((pointMap p) f y) =
      residueFieldPoint p Y y ≫ f := sorry

/-! ### P4/injection-criteria -/

theorem injection_iff_fieldPoints {Y X : Perfd p} (f : Y ⟶ X) :
    Mono f ↔ ∀ K : AffinoidField p, Function.Injective (fieldPoints.map p f K) := sorry

theorem injection_iff_geometricPoints {Y X : Perfd p} (f : Y ⟶ X) :
    Mono f ↔ ∀ K : AffinoidField p, IsAlgClosed K →
      Function.Injective (fieldPoints.map p f K) := sorry

theorem injection_iff_residueFields {Y X : Perfd p} (f : Y ⟶ X) :
    Mono f ↔ Function.Injective ((pointMap p) f) ∧ ∀ y : (underlyingPoints p) Y,
      (∀ z : (underlyingPoints p) Y, z ⤳ y → z = y) →
      Function.Bijective (residueFieldMap p f y).toRingHom := sorry

theorem injection_iff_continuous_lift {Y X : Perfd p} (f : Y ⟶ X) :
    Mono f ↔ Function.Injective ((pointMap p) f) ∧ ∀ (Z : Perfd p) (g : Z ⟶ X)
      (a : C((underlyingPoints p) Z, (underlyingPoints p) Y)), (∀ z, (pointMap p) f (a z) = (pointMap p) g z) →
      ∃! b : Z ⟶ Y, b ≫ f = g ∧ ∀ z, (pointMap p) b z = a z := sorry

/-! ### P4/field-points-of-residually-injective-maps -/

theorem fieldPoints_image {Y X : Perfd p} (f : Y ⟶ X) [Mono f] (K : AffinoidField p) :
    Set.range (fieldPoints.map p f K) =
      {a | fieldPoints.closedPointImage p K a ∈ Set.range ((pointMap p) f)} := sorry

/-! ### P4/qcqs-isomorphism-criterion -/

theorem isIso_iff_fieldPoints {Y X : Perfd p} (f : Y ⟶ X)
    (hqc : QuasiCompact p f) (hqs : QuasiSeparated p f) :
    IsIso f ↔ ∀ K : AffinoidField p, Function.Bijective (fieldPoints.map p f K) := sorry

theorem isIso_iff_geometricPoints {Y X : Perfd p} (f : Y ⟶ X)
    (hqc : QuasiCompact p f) (hqs : QuasiSeparated p f) :
    IsIso f ↔ ∀ K : AffinoidField p, IsAlgClosed K →
      Function.Bijective (fieldPoints.map p f K) := sorry

theorem isIso_iff_residueFields {Y X : Perfd p} (f : Y ⟶ X)
    (hqc : QuasiCompact p f) (hqs : QuasiSeparated p f) :
    IsIso f ↔ Function.Bijective ((pointMap p) f) ∧ ∀ y : (underlyingPoints p) Y,
      (∀ z : (underlyingPoints p) Y, z ⤳ y → z = y) →
      Function.Bijective (residueFieldMap p f y).toRingHom := sorry

/-! ### P4/isomorphism-from-homeomorphism-and-residue-pairs -/

theorem isIso_of_homeomorphism_residuePairs {Y X : Perfd p} (f : Y ⟶ X)
    (e : (underlyingPoints p) Y ≃ₜ (underlyingPoints p) X) (he : ∀ y, e y = (pointMap p) f y)
    (hr : ∀ y, IsIso (residueFieldMap p f y)) : IsIso f := sorry

/-! ### P4/qcqs-with-unique-closed-point-is-a-field-point -/

theorem isIso_residueFieldPoint_of_uniqueClosed (X : Perfd p)
    [CompactSpace ((underlyingPoints p) X)] [QuasiSeparatedSpace ((underlyingPoints p) X)] (x : (underlyingPoints p) X)
    (hx : ∀ y : (underlyingPoints p) X, IsClosed ({y} : Set _) ↔ y = x) :
    IsIso (residueFieldPoint p X x) := sorry

/-! ### P4/algebraically-closed-extension-of-affinoid-field -/

theorem AffinoidField.exists_algebraicallyClosed (K : AffinoidField p) :
    ∃ (C : AffinoidField p) (_ : IsAlgClosed C) (e : K.toPairCat p ⟶ C.toPairCat p),
      (C.toPair p).plus.comap e.toRingHom = (K.toPair p).plus ∧
      ∀ X : Perfd p, Function.Injective (fieldPoints.restrict p X e) := sorry

/-! ### P4/rank-one-residue-field-rigidity -/

theorem AffinoidField.rigidity (K L : AffinoidField p) (e : K.toPairCat p ⟶ L.toPairCat p)
    (h : ∀ (C : AffinoidField p) (_ : IsAlgClosed C) (a b : L →+* C),
      Continuous a → Continuous b → a.comp e.toRingHom = b.comp e.toRingHom → a = b) :
    Function.Bijective e.toRingHom := sorry

/-- The rank-one inclusion keeps the field fixed and enlarges only its plus ring. -/
def AffinoidField.rankOneMap (K : AffinoidField p) :
    K.toPairCat p ⟶ (AffinoidField.ofRankOne p K).toPairCat p :=
  ⟨RingHom.id K, continuous_id, fun _ h ↦ K.integral.le_powerBoundedSubring h⟩

/-! ### P4/valuative-criterion-separatedness -/

theorem valuativeCriterion_separated {Y X : Perfd p} (f : Y ⟶ X) :
    IsSeparated p f ↔ QuasiSeparated p f ∧ ∀ (K : AffinoidField p)
      (a b : fieldPoints p Y K), a ≫ f = b ≫ f →
      (spaFunctor p).map (K.rankOneMap p).op ≫ a =
        (spaFunctor p).map (K.rankOneMap p).op ≫ b → a = b := sorry

/-- The field-valued uniqueness criterion detects closedness of an adic representative's
 diagonal, with quasi-separatedness retained; ECD Proposition 5.11, pp. 25–26. -/
theorem valuativeCriterion_adicDiagonal {Y X : Perfd p} (f : Y ⟶ X)
    {A B : TauCeti.AdicSpace} (g : A ⟶ B) [HasPullback g g]
    (eY : YonedaAdicSpace.ofAdicSpace.obj A ≅ Y.obj)
    (eX : YonedaAdicSpace.ofAdicSpace.obj B ≅ X.obj)
    (h : YonedaAdicSpace.ofAdicSpace.map g ≫ eX.hom = eY.hom ≫ f.hom) :
    IsClosed (Set.range (pullback.diagonal g).hom.base) ↔
      QuasiSeparated p f ∧ ∀ (K : AffinoidField p) (a b : fieldPoints p Y K),
        a ≫ f = b ≫ f →
        (spaFunctor p).map (K.rankOneMap p).op ≫ a =
          (spaFunctor p).map (K.rankOneMap p).op ≫ b → a = b :=
  (isSeparated_iff_adicDiagonal p f g eY eX h).symm.trans
    (valuativeCriterion_separated p f)

/-! ### P4/separated-unique-extension-from-rank-one-locus -/

theorem separated_unique_extension {Y X : Perfd p} (f : Y ⟶ X) (hf : IsSeparated p f)
    (R : PairCat.{0} p) (a b : ofPair p R ⟶ Y)
    (hab : a ≫ f = b ≫ f) :
    let S : PairCat.{0} p := { carrier := R, pair := Pair.powerBounded R }
    let j : R ⟶ S := ⟨RingHom.id R, continuous_id,
      fun _ h ↦ R.pair.isRingOfIntegralElements.le_powerBoundedSubring h⟩
    (spaFunctor p).map j.op ≫ a = (spaFunctor p).map j.op ≫ b → a = b := sorry

