section KappaSmall

variable {R : Type u} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [IsHuberRing R]

/-- The clauses of ECD Definition 4.2 for `X = Spa(R, R⁺)`: (i) `#|X| < κ`, and (ii) `#O_X(U) < κ`,
here for `U = X` (`#R < κ`) and for presentations `U = U(T/s)` with `T` generating the unit
ideal. The completion is Tau Ceti's `PairOfDefinition.completionLocObj`. For a general Huber ring
these are cardinal conditions, not an assertion that the ring equals its global sections.
For perfectoid Tate pairs and uncountable strong limit κ they agree with ECD Definition 4.2.
The predicate itself is defined for every cardinal; the empty spectrum has section ring of size 1. -/
structure IsKappaSmall_affinoid (κ : Cardinal.{u}) (P : Pair R) : Prop where
  /-- Clause (i): `#|Spa(R, R⁺)| < κ`. -/
  card_spa_lt : #(spa P.plus) < κ
  /-- Clause (ii) for `U = X`: `#R < κ`. -/
  card_lt : #R < κ
  /-- Clause (ii) for the rational subsets: `#R⟨T/s⟩ < κ`. -/
  card_rationalLoc_lt : ∀ (D : PairOfDefinition R) (𝔭 : D.Presentation),
    Ideal.span (𝔭.num : Set R) = ⊤ →
      #((D.completionLocObj 𝔭.num 𝔭.den (Localization.Away 𝔭.den)
        𝔭.hasDenominatorPower).obj) < κ

/-- κ-smallness
is monotone in κ (ECD Definition 4.2). -/
theorem IsKappaSmall.mono_affinoid {κ κ' : Cardinal.{u}} (hκκ' : κ ≤ κ') {P : Pair R}
    (h : IsKappaSmall_affinoid κ P) : IsKappaSmall_affinoid κ' P := by
  exact ⟨h.card_spa_lt.trans_le hκκ', h.card_lt.trans_le hκκ',
    fun D 𝔭 h𝔭 ↦ (h.card_rationalLoc_lt D 𝔭 h𝔭).trans_le hκκ'⟩

/-- The empty affinoid has zero points and a one-element section ring
(ECD Definition 4.2, p. 20). -/
theorem isKappaSmall_affinoid_subsingleton_iff [Subsingleton R] (P : Pair R)
    (κ : Cardinal.{u}) : IsKappaSmall_affinoid κ P ↔ 1 < κ := sorry

/-- An affinoid cardinal bound cannot be at most one, even for the zero ring
(ECD Definition 4.2, p. 20). -/
theorem not_isKappaSmall_affinoid_of_le_one (P : Pair R) {κ : Cardinal.{u}}
    (hκ : κ ≤ 1) : ¬ IsKappaSmall_affinoid κ P := by
  intro h
  have hR : (1 : Cardinal.{u}) ≤ #R := Cardinal.one_le_iff_ne_zero.mpr (Cardinal.mk_ne_zero R)
  exact (not_lt_of_ge (hκ.trans hR)) h.card_lt

end KappaSmall

