/-! ### Layer 5: Profinite products -/
namespace Perfectoid
variable (p : ℕ) [Fact p.Prime] {I : Type} [SmallCategory I]
  (S : I ⥤ Profinite.{0}) (R : PairCat.{0} p)

def profiniteFunctionDiagram : Iᵒᵖ ⥤ PairCat.{0} p where
  obj i := continuousFunctionPair p (S.obj i.unop) R
  map a := { toRingHom := by sorry
             continuous_toRingHom := by sorry
             map_mem_plus := by sorry }
  map_id := by sorry
  map_comp := by sorry

theorem profiniteFunctionDiagram_map {i j : Iᵒᵖ} (a : i ⟶ j)
    (f : (profiniteFunctionDiagram p S R).obj i) (s : S.obj j.unop) :
    (show C(S.obj j.unop, R) from ((profiniteFunctionDiagram p S R).map a).toRingHom f) s =
      (show C(S.obj i.unop, R) from f) ((S.map a.unop) s) := sorry

-- Check: profiniteFunctions_empty_stage
example (i : I) [IsEmpty (S.obj i)] : Subsingleton ((profiniteFunctionDiagram p S R).obj (op i)) := sorry
-- Check: profiniteFunctions_singleton_stage
example (i : I) [Unique (S.obj i)] :
    Function.Bijective (fun f : (profiniteFunctionDiagram p S R).obj (op i) ↦
      (show C(S.obj i, R) from f) default) := sorry
-- Check: profiniteFunctions_two_point_stage
example (i : I) (e : S.obj i ≃ₜ Bool) :
    Function.Bijective (fun f : (profiniteFunctionDiagram p S R).obj (op i) ↦
      ((show C(S.obj i, R) from f) (e.symm false),
        (show C(S.obj i, R) from f) (e.symm true))) := sorry
end Perfectoid

