def cyclotomicToricMonomial (i : Fin 2) (n : ℕ) : CyclotomicToricPolynomial p :=
  AddMonoidAlgebra.single (Finsupp.single i
    ⟨(p : ℚ)⁻¹ ^ n, AddSubmonoid.subset_closure ⟨n, rfl⟩⟩) 1

/-- The relation TU=p is imposed before T-adic completion. -/
abbrev CyclotomicToricQuotient : Type := CyclotomicToricPolynomial p ⧸
  Ideal.span {cyclotomicToricMonomial p 0 0 * cyclotomicToricMonomial p 1 0 - p}

def cyclotomicToricParameter : CyclotomicToricQuotient p :=
  Ideal.Quotient.mk _ (cyclotomicToricMonomial p 0 0)

/-- The restricted integral algebra in ECD Example 3.4(iv). -/
abbrev CyclotomicToricIntegral : Type := AdicCompletion (Ideal.span {cyclotomicToricParameter p})
  (CyclotomicToricQuotient p)

def cyclotomicToricCompletedParameter : CyclotomicToricIntegral p :=
  AdicCompletion.of (Ideal.span {cyclotomicToricParameter p}) (CyclotomicToricQuotient p) (cyclotomicToricParameter p)

abbrev CyclotomicToricRing : Type := Localization.Away (cyclotomicToricCompletedParameter p)

instance cyclotomicToricTopology : TopologicalSpace (CyclotomicToricRing p) := sorry
instance cyclotomicToricTopologicalRing : IsTopologicalRing (CyclotomicToricRing p) := sorry
instance cyclotomicToricUniformity : UniformSpace (CyclotomicToricRing p) :=
  IsTopologicalAddGroup.rightUniformSpace _
instance cyclotomicToricUniformAddGroup : IsUniformAddGroup (CyclotomicToricRing p) := sorry
instance cyclotomicToricTate : IsTateRing (CyclotomicToricRing p) := sorry
instance cyclotomicToricComplete : CompleteSpace (CyclotomicToricRing p) := sorry
instance cyclotomicToricSeparated : T2Space (CyclotomicToricRing p) := sorry

/-- Powers of T times the image of the integral completion specify the topology. -/
theorem cyclotomicToricTopology_basis :
    (nhds (0 : CyclotomicToricRing p)).HasBasis (fun _ : ℕ ↦ True)
      (fun n ↦ {x | ∃ y : CyclotomicToricIntegral p,
        x = algebraMap (CyclotomicToricIntegral p) _
          (cyclotomicToricCompletedParameter p ^ n * y)}) := sorry

/-- The two coherent root sequences in the completed Tate ring. -/
def cyclotomicToricRoot (i : Fin 2) (n : ℕ) : CyclotomicToricRing p :=
  algebraMap (CyclotomicToricIntegral p) _
    (AdicCompletion.of (Ideal.span {cyclotomicToricParameter p}) (CyclotomicToricQuotient p)
      (Ideal.Quotient.mk _ (cyclotomicToricMonomial p i n)))

-- Check: cyclotomicToricMonomial_roots; CyclotomicToricPolynomial_roots;
-- Check: CyclotomicToricQuotient_roots; CyclotomicToricIntegral_roots; CyclotomicToricRing_roots;
-- Check: cyclotomicToricParameter_roots; cyclotomicToricCompletedParameter_roots; cyclotomicToricRoot_roots
example (i : Fin 2) (n : ℕ) :
    cyclotomicToricMonomial p i (n + 1) ^ p = cyclotomicToricMonomial p i n ∧
      cyclotomicToricRoot p i (n + 1) ^ p = cyclotomicToricRoot p i n := sorry
-- Check: cyclotomicToricMonomial_relation; CyclotomicToricPolynomial_relation;
-- Check: CyclotomicToricQuotient_relation; CyclotomicToricIntegral_relation; CyclotomicToricRing_relation;
-- Check: cyclotomicToricParameter_relation; cyclotomicToricCompletedParameter_relation; cyclotomicToricRoot_relation
example : cyclotomicToricRoot p 0 0 * cyclotomicToricRoot p 1 0 = p ∧
    IsUnit (cyclotomicToricRoot p 0 0) := sorry
-- Check: cyclotomicToricMonomial_nonfield; CyclotomicToricPolynomial_nonfield;
-- Check: CyclotomicToricQuotient_nonfield; CyclotomicToricIntegral_nonfield; CyclotomicToricRing_nonfield;
-- Check: cyclotomicToricParameter_nonfield; cyclotomicToricCompletedParameter_nonfield; cyclotomicToricRoot_nonfield
example : ¬ IsUnit (p : CyclotomicToricRing p) ∧
    IsPseudoUniformizer (cyclotomicToricRoot p 0 1) := sorry

/-- ECD Example 3.4(iv), p. 15: the completed ring is uniform and perfectoid. -/
instance cyclotomicToricPerfectoid : IsPerfectoidTateRing p (CyclotomicToricRing p) := sorry
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid

