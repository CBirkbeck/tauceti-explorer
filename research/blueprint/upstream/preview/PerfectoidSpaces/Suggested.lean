/-! ### P7: perfectoid-tilde-limit -/
-- Check: isTildeLimit_test_perfectoidTorus
set_option maxHeartbeats 1600000 in
example (K : Type) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [IsPerfectoidField p K] [CharZero K] (ϖ : PseudoUniformizerRoots p K) :
    let S := powerBoundedSubring K
