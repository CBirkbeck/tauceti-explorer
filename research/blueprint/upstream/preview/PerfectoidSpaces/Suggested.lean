/-! ### P4/stalk-of-plus-sheaf-modulo-pseudouniformizer -/

/-- The ring stalk is the filtered colimit of the P2 integral rational sections. -/
abbrev integralStalk (R : PairCat.{0} p) (x : spa R.pair.plus) :=
  ↥(colimit ((rationalNeighborhoods p R x).plusDiagram p))

def integralStalkToResidue (R : PairCat.{0} p) (x : spa R.pair.plus) :
    integralStalk p R x →+* (residuePair p R x).plus := sorry

theorem integralStalkToResidue_scalar (R : PairCat.{0} p) (x : spa R.pair.plus) (a : R.pair.plus) :
    (integralStalkToResidue p R x ((rationalNeighborhoods p R x).scalar p a)).val =
      residueMap p R x a := sorry

theorem integralStalkToResidue_dense (R : PairCat.{0} p) (x : spa R.pair.plus) :
    DenseRange (integralStalkToResidue p R x) := sorry

theorem integralStalkToResidue_kernel (R : PairCat.{0} p) (x : spa R.pair.plus)
    (π : R.pair.plus) (hπ : IsPseudoUniformizer (π : R)) :
    RingHom.ker (integralStalkToResidue p R x) =
      Ideal.span {(rationalNeighborhoods p R x).scalar p π} * RingHom.ker (integralStalkToResidue p R x) := sorry

def integralStalk_mod_equiv (R : PairCat.{0} p) (x : spa R.pair.plus)
    (π : R.pair.plus) (hπ : IsPseudoUniformizer (π : R)) :
    (integralStalk p R x ⧸ Ideal.span {(rationalNeighborhoods p R x).scalar p π}) ≃+*
      ((residuePair p R x).plus ⧸ Ideal.span
        {integralStalkToResidue p R x ((rationalNeighborhoods p R x).scalar p π)}) := sorry

theorem integralStalk_mod_equiv_apply (R : PairCat.{0} p) (x : spa R.pair.plus)
    (π : R.pair.plus) (hπ : IsPseudoUniformizer (π : R)) (a : integralStalk p R x) :
    integralStalk_mod_equiv p R x π hπ (Ideal.Quotient.mk _ a) =
      Ideal.Quotient.mk _ (integralStalkToResidue p R x a) := sorry

