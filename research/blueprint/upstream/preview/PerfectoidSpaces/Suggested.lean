/-! ### Layer 4: The completed integral quotient -/
namespace PerfectoidSpace
open Perfectoid
variable (p : ℕ) [Fact p.Prime]

/-- The completed quotient used in BS22 Remark 7.5; the carrier is the actual adic completion. -/
def completedIntegralQuotient (R : PairCat.{0} p) (I : Ideal R) (π : R.pair.plus)
    (hπ : IsPseudoUniformizer (π : R)) (hp : π ^ p ∣ (p : R.pair.plus)) : SemiperfectoidRing p where
  carrier := AdicCompletion (Ideal.span {Ideal.Quotient.mk (I.comap R.pair.plus.subtype) π})
    (R.pair.plus ⧸ I.comap R.pair.plus.subtype)
  complete := by sorry
  quotient := by sorry

def completedIntegralQuotientMap (R : PairCat.{0} p) (I : Ideal R) (π : R.pair.plus)
    (hπ : IsPseudoUniformizer (π : R)) (hp : π ^ p ∣ (p : R.pair.plus)) :
    R.pair.plus →+* completedIntegralQuotient p R I π hπ hp := by
  change R.pair.plus →+* AdicCompletion
    (Ideal.span {Ideal.Quotient.mk (I.comap R.pair.plus.subtype) π})
    (R.pair.plus ⧸ I.comap R.pair.plus.subtype)
  exact (algebraMap _ _).comp (Ideal.Quotient.mk (I.comap R.pair.plus.subtype))

/-- The perfectoidization followed by inversion is the universal perfectoid Zariski quotient. -/
theorem zariskiClosedPair_from_perfectoidization (R : PairCat.{0} p) (I : Ideal R) (π : R.pair.plus)
    (hπ : IsPseudoUniformizer (π : R)) (hp : π ^ p ∣ (p : R.pair.plus)) :
    let A := completedIntegralQuotient p R I π hπ hp
    let q := (semiperfectoidPerfectoidization.ι p A).comp (completedIntegralQuotientMap p R I π hπ hp)
    ∃ e : Localization.Away (q π) ≃+* zariskiClosedPair p R I,
      (∀ a : R.pair.plus, e (algebraMap (semiperfectoidPerfectoidization p A) _ (q a)) =
        (zariskiClosedMap p R I).toRingHom a) ∧
      (zariskiClosedPair p R I).pair.plus =
        (integralClosure (R.pair.plus.map (zariskiClosedMap p R I).toRingHom)
          (zariskiClosedPair p R I)).toSubring := sorry

