/-- The cospan formula specifies the equivalence, including both transport isomorphisms. -/
theorem homEquiv_symm_mk {i j : J} (x : F.obj ⟨i⟩) (y : F.obj ⟨j⟩)
    (r : HomRepresentative F x y) :
    (homEquiv F x y).symm (Quot.mk _ r) =
      (ιCompIso F r.left).inv.app x ≫ (ι F r.stage).map r.hom ≫
        (ιCompIso F r.right).hom.app y := sorry

