example : let A := (toAlmost (BasicSetup.classical ℚ)).obj (CommAlgCat.of ℚ ℚ)
    Nontrivial ((elements (BasicSetup.classical ℚ)).obj (prod (BasicSetup.classical ℚ) A A)) ∧
    Nontrivial (prod (BasicSetup.classical ℚ) A A ⟶ prod (BasicSetup.classical ℚ) A A) ∧
    IsIso (counitIso (BasicSetup.classical ℚ) (prod (BasicSetup.classical ℚ) A A)).hom := sorry
-- Check: free_empty
example (A : Algebra S) : IsZero ((moduleEquiv S A).functor.obj (free S A PEmpty.{u+1})) := sorry
-- Check: free_one
example (A : Algebra S) : Nonempty ((moduleEquiv S A).functor.obj (free S A PUnit.{u+1}) ≅
    (Almost.toAlmost (S.baseChange ((elements S).obj A))).obj
      (_root_.ModuleCat.of ((elements S).obj A) ((elements S).obj A))) := sorry
-- Check: free_two
example (A : Algebra S) : Nonempty ((moduleEquiv S A).functor.obj (free S A (ULift.{u} (Fin 2))) ≅
    (Almost.toAlmost (S.baseChange ((elements S).obj A))).obj
      (_root_.ModuleCat.of ((elements S).obj A) (Fin 2 → ((elements S).obj A)))) := sorry
-- Check: tensor_unit
example (A : Algebra S) : Nonempty (tensor S A ((toAlmost S).obj (CommAlgCat.of V V)) ≅ A) := sorry
