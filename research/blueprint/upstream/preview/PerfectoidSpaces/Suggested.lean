/-! ### Layer 6: The completed character algebra -/

/-! ### P6/zariski-closed-equals-strongly-zariski-closed -/

/-- The union of the finite p-power root subgroups of Cp. -/
abbrev pPowerRoots : Subgroup ℂ_[p]ˣ := ⨆ n : ℕ, rootsOfUnity (p ^ n) ℂ_[p]

/-- The character associated to a p-power root, independent of its chosen finite level. -/
def pPowerCharacter (z : pPowerRoots p) : C(ℤ_[p], ℂ_[p]) := sorry

theorem pPowerCharacter_apply (z : pPowerRoots p) (n : ℕ)
    (hn : z.val ^ (p ^ n) = 1) (x : ℤ_[p]) :
    pPowerCharacter p z x = (z.val : ℂ_[p]) ^ (PadicInt.toZModPow n x).val := sorry

/-- The c₀ completion for the coefficient maximum norm, with convolution multiplication.
The dense isometric algebra map identifies the completion, independently of a model. -/
structure CharacterCompletion where
  carrier : Type
  [ring : NormedCommRing carrier]
  [algebra : NormedAlgebra ℂ_[p] carrier]
  [complete : CompleteSpace carrier]
  ι : MonoidAlgebra ℂ_[p] (pPowerRoots p) →ₐ[ℂ_[p]] carrier
  coefficient_norm : ∀ f, ‖ι f‖₊ = f.coeff.support.sup (fun z ↦ ‖f.coeff z‖₊)
  dense : DenseRange ι
attribute [instance] CharacterCompletion.ring CharacterCompletion.algebra CharacterCompletion.complete

def characterCompletion : CharacterCompletion p := sorry

namespace CharacterCompletion
variable {p} (A : CharacterCompletion p)

/-- The continuous extension of the character map; ECD §5, p. 24. -/
def fourier : A.carrier →A[ℂ_[p]] C(ℤ_[p], ℂ_[p]) := sorry

theorem fourier_single (z : pPowerRoots p) (c : ℂ_[p]) (x : ℤ_[p]) :
    A.fourier (A.ι (MonoidAlgebra.single z c)) x = c * pPowerCharacter p z x := sorry

theorem fourier_surjective : Function.Surjective A.fourier := sorry

theorem fourier_kernel_nontrivial : ∃ a : A.carrier, a ≠ 0 ∧ A.fourier a = 0 := sorry

