    let I : Ideal B := Ideal.span {LaurentPolynomial.C (ϖ.rootPB 0)}
    let C := AdicCompletion I B
    ∃ (T : FrobeniusTower p) (e : ∀ n, T.ring n ≃+* C),
      (∀ n, e n (T.parameter n) = algebraMap B C (LaurentPolynomial.C (ϖ.rootPB 0))) ∧
      (∀ n a, e (n + 1) (T.transition n ((e n).symm
        (algebraMap B C (LaurentPolynomial.C a)))) = algebraMap B C (LaurentPolynomial.C a)) ∧
      (∀ n k, e (n + 1) (T.transition n ((e n).symm
        (algebraMap B C (LaurentPolynomial.T k)))) = algebraMap B C (LaurentPolynomial.T (p * k))) ∧
      IsTildeLimit p T.toIntegralTower.genericDiagram T.toIntegralTower.genericCone ∧
      ∃ E : T.completed ≃+* perfectedTateAlgebra.laurent p ϖ Unit,
        Continuous E ∧ Continuous E.symm ∧
        ∀ n, E (algebraMap T.completedPlus T.completed (T.toIntegralTower.toCompleted n
          ((e n).symm (algebraMap B C (LaurentPolynomial.T 1))))) =
          perfectedTateAlgebra.laurent.X p ϖ Unit ()
            ⟨(p : ℚ)⁻¹ ^ n, by sorry⟩ := sorry
