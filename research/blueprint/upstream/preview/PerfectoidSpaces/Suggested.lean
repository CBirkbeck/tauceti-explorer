      (ComplexShape.embeddingUpIntLE 0)) ≠ 0 := sorry

/-! ### P0/cotangent-flat-base-change -/

/-- GR 2.5.34–35: Tor-independent pushouts give base change and the direct-sum formula. -/
theorem cotangentComplex_baseChange {A B C : Algebra S} (f : A ⟶ B) (g : A ⟶ C)
    (hTor : ∀ n : ℕ, 0 < n → IsZero
      (Module.tor _ (Algebra.relativeModule S f) (Algebra.relativeModule S g) n)) :
    let L₁ := DerivedCategory.Q.obj
      ((((ModuleCat.extendScalars
        ((Algebra.shriekShriek S).map (pushout.inl f g)).hom.toRingHom).mapHomologicalComplex _).obj
          (cotangentModel S f)).extend (ComplexShape.embeddingUpIntLE 0))
    let L₂ := DerivedCategory.Q.obj
      ((((ModuleCat.extendScalars
        ((Algebra.shriekShriek S).map (pushout.inr f g)).hom.toRingHom).mapHomologicalComplex _).obj
          (cotangentModel S g)).extend (ComplexShape.embeddingUpIntLE 0))
    Nonempty (L₁ ≅ cotangentComplex S (pushout.inr f g)) ∧
      Nonempty (biprod L₁ L₂ ≅ cotangentComplex S (f ≫ pushout.inl f g)) := sorry

/-- GR 2.5.29: derivations are represented in degree zero by the almost cotangent complex. -/
theorem cotangentComplex_ext_zero {A B : Algebra S} (f : A ⟶ B)
    (M : Module (S.baseChange ((Algebra.elements S).obj B))) :
    Nonempty ((almostCotangentComplex S f ⟶
      (DerivedCategory.singleFunctor (Module (S.baseChange ((Algebra.elements S).obj B))) 0).obj M) ≃+
      Algebra.Derivation S f M) := sorry

/-- Degree-zero homology is the relative module of differentials, GR (2.5.28). -/
def cotangentComplex_H0 {A B : Algebra S} (f : A ⟶ B) :
    (almostCotangentModel S f).homology 0 ≅ Algebra.kaehlerDifferential S f := sorry

/-! ### P0/almost-cotangent-comparison-classical -/

/-- The ordinary representative becomes correct after almostification, GR Proposition 8.1.7(ii). -/
def cotangentComplex_toAlmost {A B : Algebra S} (f : A ⟶ B) :
    almostCotangentComplex S f ≅
      letI := ((Algebra.elements S).map f).hom.toAlgebra
      DerivedCategory.Q.obj
        ((((toAlmost (S.baseChange ((Algebra.elements S).obj B))).mapHomologicalComplex _).obj
          (CotangentComplex.model ((Algebra.elements S).obj A) ((Algebra.elements S).obj B))).extend
            (ComplexShape.embeddingUpIntLE 0)) := sorry

/-! ### P0/cotangent-vanishing-weakly-etale -/

/-- Weakly etale maps have vanishing cotangent complex, GR Theorem 2.5.36. -/
theorem cotangentComplex_eq_zero_of_isWeaklyEtale {A B : Algebra S} (f : A ⟶ B)
    (hf : Algebra.IsWeaklyEtale S f) :
    IsZero (cotangentComplex S f) ∧ IsZero (almostCotangentComplex S f) := sorry

/-- The Tor-trivial diagonal criterion, GR Theorem 2.5.36. -/
theorem cotangentComplex_eq_zero_of_tor {A B : Algebra S} (f : A ⟶ B)
    (hbase : ∀ i : ℕ, 0 < i → IsZero
      (Module.tor _ (Algebra.relativeModule S f) (Algebra.relativeModule S f) i))
    (hdiag : ∀ i : ℕ, 0 < i → IsZero
      (Module.tor _ (Algebra.relativeModule S (Algebra.diagonal S f))
        (Algebra.relativeModule S (Algebra.diagonal S f)) i)) :
    IsZero (cotangentComplex S f) ∧ IsZero (almostCotangentComplex S f) := sorry

