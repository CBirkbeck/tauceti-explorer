      ((FrobeniusTower.disc (powerBoundedSubring K) t ht hdiv).genericFibre 0))) := sorry

-- Check strongCompletion_test_universal: composition with the actual canonical map is bijective.
example (X : YonedaAdicSpace) (hX : IsPreperfectoid p X) (Y : Perfd p) :
    Function.Bijective (fun g : Y.obj ⟶ (strongCompletion p X hX).obj ↦
      g ≫ strongCompletion.ι p X hX) := sorry

