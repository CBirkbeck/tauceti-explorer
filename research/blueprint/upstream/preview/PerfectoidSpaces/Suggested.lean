/-! ### P0/almost-cech-and-sheaf-cohomology -/

section Sheaves

variable {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)
  [HasSheafify J (ModuleCat.{u} V)]

/-- Sectionwise almost zero sheaves, GR §3.3, (3.3.1). -/
def almostZeroSheaf : ObjectProperty (_root_.CategoryTheory.Sheaf J (ModuleCat.{u} V)) :=
  fun F ↦ ∀ U, S.IsAlmostZero (F.obj.obj U)

instance almostZeroSheaf_isSerreClass : (almostZeroSheaf S J).IsSerreClass := sorry

/-- The Serre quotient of sheaves of modules, GR §3.3, (3.3.2). -/
abbrev Sheaf := (almostZeroSheaf S J).isoModSerre.Localization

namespace Sheaf

abbrev IsAlmostZero (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V)) : Prop :=
  almostZeroSheaf S J F

abbrev toAlmost : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V) ⥤ Sheaf S J :=
  (almostZeroSheaf S J).isoModSerre.Q

/-- Sections as a module-valued functor. -/
abbrev sections (X : C) : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V) ⥤ ModuleCat.{u} V :=
  sheafToPresheaf J (ModuleCat.{u} V) ⋙ (evaluation Cᵒᵖ (ModuleCat.{u} V)).obj (Opposite.op X)

variable [EnoughInjectives (_root_.CategoryTheory.Sheaf J (ModuleCat.{u} V))]

/-- Derived sections retain the scalar action, rather than forgetting it. -/
def cohomologyModule (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V))
    (n : ℕ) (X : C) : ModuleCat.{u} V := ((sections J X).rightDerived n).obj F

/-- Almost sheaf cohomology is the almostification of derived sections. -/
def almostH (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V))
    (n : ℕ) (X : C) : Module S :=
  (Almost.toAlmost S).obj (cohomologyModule J F n X)

/-- Almost acyclicity concerns positive degrees only. -/
def IsAlmostAcyclic (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V)) (X : C) : Prop :=
  ∀ n : ℕ, 0 < n → IsZero (almostH S J F n X)

/-- Scalar annihilation passes to derived sections, GR §3.3. -/
theorem almostH_eq_zero_of_isAlmostZero
    (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V))
    (hF : IsAlmostZero S J F) (n : ℕ) (X : C) :
    IsZero (almostH S J F n X) := sorry

theorem almostH_localization (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V))
    (n : ℕ) (X : C) (h : IsZero (almostH S J F n X)) (ϖ : V) (hϖ : ϖ ∈ S.ideal) :
    Subsingleton (LocalizedModule (Submonoid.powers ϖ) (cohomologyModule J F n X)) := sorry

/-- Degree zero is sections, fixing the normalization of the derived functor. -/
theorem cohomologyModule_zero (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V)) (X : C) :
    Nonempty (cohomologyModule J F 0 X ≅ F.obj.obj (Opposite.op X)) := sorry

/-- The underlying additive group is Mathlib's Ext-defined sheaf cohomology. -/
theorem cohomologyModule_iso_H'
    [HasSheafify J AddCommGrpCat.{u}]
    [HasExt.{u + 1} (_root_.CategoryTheory.Sheaf J AddCommGrpCat.{u})]
    (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V)) (n : ℕ) (X : C) :
    Nonempty (cohomologyModule J F n X ≃+
      (_root_.CategoryTheory.Sheaf.H'
        ((sheafCompose J (forget₂ (ModuleCat.{u} V) AddCommGrpCat.{u})).obj F) n X)) := sorry

/-- The cohomology functor takes sectionwise almost isomorphisms to almost isomorphisms. -/
theorem almostH_map_isIso {F G : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V)}
    (f : F ⟶ G) (hf : ∀ U, S.IsAlmostIso (f.hom.app U).hom) (n : ℕ) (X : C) :
    IsIso ((Almost.toAlmost S).map (((sections J X).rightDerived n).map f)) := sorry


-- Check: cohomologyModule_injective
example (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V)) [Injective F]
    (n : ℕ) (hn : 0 < n) (X : C) : IsZero (cohomologyModule J F n X) := sorry
-- Check: cohomologyModule_zero_sheaf
example (n : ℕ) (X : C) : IsZero (cohomologyModule (V := V) J 0 n X) := sorry
-- Check: cohomologyModule_sections
example (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V)) (X : C)
    (h : ¬ IsZero (F.obj.obj (Opposite.op X))) :
    ¬ IsZero (cohomologyModule J F 0 X) := sorry

-- Check: almostH_zero_setup
example (hS : S.ideal = ⊥) (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V))
    (n : ℕ) (X : C) : IsZero (almostH S J F n X) := sorry
-- Check: almostH_classical
example (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V)) (n : ℕ) (X : C) :
    IsZero (almostH (BasicSetup.classical V) J F n X) ↔
      IsZero (cohomologyModule J F n X) := sorry
-- Check: almostH_residue
example (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V))
    (hF : ∀ U, ∀ ε ∈ S.ideal, ∀ x : F.obj.obj U, ε • x = 0) (n : ℕ) (X : C) :
    IsZero (almostH S J F n X) := sorry

-- Check: IsAlmostAcyclic_injective
example (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V)) [Injective F] (X : C) :
    IsAlmostAcyclic S J F X := sorry
-- Check: IsAlmostAcyclic_zero_setup
example (hS : S.ideal = ⊥) (F : _root_.CategoryTheory.Sheaf J (ModuleCat.{u} V)) (X : C) :
    IsAlmostAcyclic S J F X := sorry
