example (A : Algebra S) (h : S.ideal = ⊥) :
    IsZero A.X ∧ Subsingleton (homEquiv S A A (𝟙 A)).toRingHom.range ∧
      IsZero (prod S A A).X := sorry
-- Check: counitIso_classical; homEquiv_classical; prod_classical
example (A B : CommAlgCat.{u} V) :
    Nonempty (prod (BasicSetup.classical V)
      ((toAlmost (BasicSetup.classical V)).obj A) ((toAlmost (BasicSetup.classical V)).obj B) ≅
        (toAlmost (BasicSetup.classical V)).obj (CommAlgCat.of V (A × B))) ∧
    Function.Bijective (homEquiv (BasicSetup.classical V)
      ((toAlmost (BasicSetup.classical V)).obj A) ((toAlmost (BasicSetup.classical V)).obj B)) := sorry
