      ((finiteStageQcqsDiagram p X).mapId ⟨Opposite.op i⟩).hom.toNatTrans.app T := sorry


/-! ### P5/finite-stage-descent-of-qcqs-etale-objects -/

/-- ECD 6.4(ii). -/
def finiteStageQcqsEquiv : CategoryTheory.FilteredTwoColimit (finiteStageQcqsDiagram p X) ≌
