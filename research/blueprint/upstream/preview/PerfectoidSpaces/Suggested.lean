-- Check: prodChart_plus_open
-- In the chart topology, an open integral closure would contain t^k u^j for
-- every j at some fixed k. The algebraic tensor already rules this out.
set_option synthInstance.maxHeartbeats 400000 in
set_option maxHeartbeats 1600000 in
example (ϖ : PseudoUniformizerRoots p (completedPerfectLaurentFp p))
    (hϖ : ∀ n, ϖ.root n = perfectLaurentRoot p n) (m : ℕ) (hm : 0 < m) :
    let K := completedPerfectLaurentFp p
    letI : CommRing K := inferInstance
    letI : Algebra ℤ K := Ring.toIntAlgebra K
    letI : Module ℤ K := Algebra.toModule
    let E := _root_.TensorProduct ℤ K K
    letI : CommRing E := Algebra.TensorProduct.instCommRing
    let l : K →+* E := Algebra.TensorProduct.includeLeftRingHom (R := ℤ) (A := K) (B := K)
    let r : K →+* E := (Algebra.TensorProduct.includeRight (R := ℤ) (A := K) (B := K)).toRingHom
    let D : Subring E := (powerBoundedSubring K).map l ⊔ (powerBoundedSubring K).map r
    let u : E := l (ϖ.root 0) ^ m * r (Ring.inverse (ϖ.root 0))
    ∀ k j : ℕ, 0 < j → ¬ IsIntegral D (l (ϖ.root 0) ^ k * u ^ j : E) := sorry
end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
