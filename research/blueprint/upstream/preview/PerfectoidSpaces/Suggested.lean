theorem pullback_primitiveIdeal {P Q : PairCat.{u} p} (hp : (p : Q) = 0)
    (f : P ⟶ Q) (X : MarkedUntilt p P) :
    (pullback hp f X).primitiveIdeal = X.primitiveIdeal.map
      (WittVector.map (f.toRingHom.restrict _ _ f.map_mem_plus)) := sorry

-- Check: marked_zero
