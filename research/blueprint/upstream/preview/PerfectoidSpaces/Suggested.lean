/-- The induced inverse image on sheaves is precomposition with the geometric site tilt. -/
theorem etaleTiltSheafEquiv_inverse_obj (X : Perfd p)
    (F : Sheaf (smallEtaleTopology p ((tiltFunctor p).obj X)) (Type 2)) :
    ((etaleTiltSheafEquiv p X).inverse.obj F).obj =
      (etaleTiltFunctor p X).op ⋙ F.obj := rfl

/-- The quotient comparison sends a local tilted integral section to its sharp. -/
theorem etaleIntegralQuotientTiltIso_sharp (X : Perfd p)
    (a : globalPlus p X) (b : globalPlus p ((tiltFunctor p).obj X))
    (hsharp : globalSharp p X b.val = a.val)
    (hsmall : ∀ C : Chart p X,
      IsPseudoUniformizer (a.val.val C) ∧
      (⟨a.val.val C, a.property C⟩ : C.ring.pair.plus) ^ p ∣ (p : C.ring.pair.plus))
    (U : smallEtale p X) (s : globalPlus p ((tiltFunctor p).obj U.obj.left)) :
    (etaleIntegralQuotientTiltIso p X a b hsharp hsmall).inv.app (Opposite.op U)
      ((cokernel.π (etaleIntegralScalar p ((tiltFunctor p).obj X) b)).hom.app
        (Opposite.op ((etaleTiltFunctor p X).obj U)) s) =
      (cokernel.π (etaleIntegralScalar p X a)).hom.app (Opposite.op U)
        ⟨globalSharp p U.obj.left s.val, globalSharp_plus p U.obj.left s⟩ := sorry

end PerfectoidSpace

