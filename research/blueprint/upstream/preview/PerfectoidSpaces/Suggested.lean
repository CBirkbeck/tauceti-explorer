  (S : I ⥤ Profinite.{0}) (hS : ∀ i, Finite (S.obj i)) (R : PairCat.{0} p)

/-- The finite profinite stages give continuous functions on their actual profinite limit. -/
def cofilteredLimit_prodProfinite (hS : ∀ i, Finite (S.obj i)) (R : PairCat.{0} p) :
    cofilteredLimit p ((profiniteFunctionDiagram p S R).rightOp ⋙ spaFunctor p)
      (fun i ↦ ⟨(profiniteFunctionDiagram p S R).obj (op i), ⟨Iso.refl _⟩⟩) ≅
        ofPair p (continuousFunctionPair p (↥(limit S)) R) := sorry

/-- The topology, not just the point set, is the profinite product topology. -/
def continuousFunctionSpaceHomeomorph (T : Type) [TopologicalSpace T] [CompactSpace T]
    [T2Space T] [TotallyDisconnectedSpace T] (R : PairCat.{0} p) :
    underlyingPoints p (ofPair p (continuousFunctionPair p T R)) ≃ₜ
      T × underlyingPoints p (ofPair p R) := sorry

