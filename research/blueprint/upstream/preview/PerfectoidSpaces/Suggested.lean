/-! ### Layer 5: Integral perfectoidness of the chosen plus ring -/
namespace Perfectoid
universe u
variable (p : ℕ) [Fact p.Prime] {J : Type u} [SmallCategory J] [hJ : IsFiltered J]
  (D : J ⥤ PairCat.{u} p) (j₀ : J) (ϖ : PseudoUniformizerRoots p (D.obj j₀))
/-- Divisibility in the chosen stage plus ring gives integral perfectoidness of the completed plus ring. -/
theorem completedColimit.integralPerfectoid
    (hϖ : (completedColimit.uniformizer p D j₀ ϖ) ^ p ∣ (p : (D.obj j₀).pair.plus)) :
    let t : completedColimitPlus p D j₀ ϖ :=
      ⟨(completedColimit.ι p D j₀ ϖ j₀).toRingHom (completedColimit.uniformizer p D j₀ ϖ),
        (completedColimit.ι p D j₀ ϖ j₀).map_mem_plus _
          (completedColimit.uniformizer p D j₀ ϖ).property⟩
    IsIntegralPerfectoid p (completedColimitPlus p D j₀ ϖ) ∧
      t ∈ nonZeroDivisors (completedColimitPlus p D j₀ ϖ) ∧
      ∃ h : t ^ p ∣ (p : completedColimitPlus p D j₀ ϖ),
        Function.Bijective (frobeniusModPow p t h) := sorry
end Perfectoid

/-! ### Layer 5: Global integral quotients -/
namespace PerfectoidSpace
open Perfectoid
variable (p : ℕ) [Fact p.Prime] {I : Type} [SmallCategory I] [hI : IsCofiltered I]
  (X : I ⥤ Perfd p) (hX : ∀ i, IsAffinoidPerfectoid p (X.obj i).obj)

def globalPlusQuotientDiagram (t : ∀ i, globalPlus p (X.obj i))
    (ht : ∀ {i j} (a : i ⟶ j), globalPullback p (X.map a) (t j).val = (t i).val)
    (n : ℕ) : Iᵒᵖ ⥤ CommRingCat.{1} where
  obj i := CommRingCat.of (globalPlus p (X.obj i.unop) ⧸ Ideal.span {t i.unop ^ n})
  map a := CommRingCat.ofHom (Ideal.Quotient.lift _
    ((Ideal.Quotient.mk _).comp ((plusSectionsDiagram p X).map a).hom) (by sorry))
  map_id := by sorry
  map_comp := by sorry

/-- ECD 6.5 and Bhatt 5.1.1: the specified section supplies the principal ideals. -/
def cofilteredLimit.plusQuotient (t : ∀ i, globalPlus p (X.obj i))
    (ht : ∀ {i j} (a : i ⟶ j), globalPullback p (X.map a) (t j).val = (t i).val)
    (hp : ∀ (i : I) (C : Chart p (X.obj i)), IsPseudoUniformizer ((t i).val.val C))
    (i₀ : I) (n : ℕ) (hn : 0 < n) :
    (↥(colimit (globalPlusQuotientDiagram p X t ht n))) ≃+*
      globalPlus p (cofilteredLimit p X hX) ⧸ Ideal.span {
        (⟨globalPullback p (cofilteredLimit.π p X hX i₀) (t i₀).val,
          globalPullback_plus p (cofilteredLimit.π p X hX i₀) (t i₀)⟩ :
