/-! ### Gauge, quotient and Fontaine interfaces -/
section SupportingInterfaces
variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]

namespace PseudoUniformizerRoots
variable (ϖ : PseudoUniformizerRoots p R) [Fact (IsBounded (powerBoundedSubring R : Set R))]
theorem gauge_mul_le (x y : R) : ϖ.gauge (x * y) ≤ ϖ.gauge x * ϖ.gauge y := sorry
theorem gauge_add_le (x y : R) : ϖ.gauge (x + y) ≤ max (ϖ.gauge x) (ϖ.gauge y) := sorry
theorem gauge_eq_zero_iff (x : R) : ϖ.gauge x = 0 ↔ x = 0 := sorry
theorem gauge_pow (x : R) (n : ℕ) (hn : 0 < n ∨ Nontrivial R) :
    ϖ.gauge (x ^ n) = ϖ.gauge x ^ n := sorry
theorem gauge_zpow_mul (m : ℤ) (n : ℕ) (x : R) :
    ϖ.gauge ((ϖ.zpow m n : R) * x) =
      (2 : NNReal) ^ (-(m : ℝ) / (p : ℝ) ^ n) * ϖ.gauge x := sorry
theorem mem_powerBoundedSubring_iff_gauge_le_one (x : R) :
    x ∈ powerBoundedSubring R ↔ ϖ.gauge x ≤ 1 := sorry
theorem isTopologicallyNilpotent_iff_gauge_lt_one (x : R) :
    IsTopologicallyNilpotent x ↔ ϖ.gauge x < 1 := sorry
theorem hasBasis_nhds_zero :
    (𝓝 (0 : R)).HasBasis (fun n : ℕ ↦ 0 ≤ n)
      (fun n ↦ {x : R | ∃ y : powerBoundedSubring R, x = ϖ.root 0 ^ n * y}) := sorry
/-- Positive root powers generate exactly the topologically nilpotent elements, ECD 3.11. -/
theorem iUnion_zpow_eq :
    (⋃ n : ℕ, {x : R | ∃ y : powerBoundedSubring R, x = ϖ.root n * y}) =
      {x : R | IsTopologicallyNilpotent x} := sorry

end PseudoUniformizerRoots

/-! ### P1/metric-perfectoid-criterion -/

/-- AWS 2.8.3, for the spectral gauge attached to a compatible small unit. -/
theorem metric_perfectoid_criterion [Fact (IsBounded (powerBoundedSubring R : Set R))] (ϖ : PseudoUniformizerRoots p R) :
    IsPerfectoidTateRing p R ↔ ∃ c : NNReal, 0 < c ∧ c < 1 ∧
      ∀ x : R, ∃ y : R, ϖ.gauge (x - y ^ p) ≤ c * ϖ.gauge x := sorry

variable [IsPerfectoidTateRing p R]
include p in
theorem IsPerfectoidTateRing.boundedFact :
    Fact (IsBounded (powerBoundedSubring R : Set R)) :=
  ⟨IsPerfectoidTateRing.isBounded_powerBoundedSubring (p := p)⟩

/-! ### P1/perfectoid-condition-independent-of-pseudouniformizer -/

theorem IsPerfectoidTateRing.frobenius_bijective (ϖ : powerBoundedSubring R)
    (hϖ : IsPseudoUniformizer (ϖ : R)) (hp : ϖ ^ p ∣ (p : powerBoundedSubring R)) :
    Function.Bijective (frobeniusModPow p ϖ hp) := sorry

/-! ### P1/frobenius-surjective-on-plus-ring -/

theorem IsPerfectoidTateRing.frobenius_surjective_plus (P : Pair R) :
    Function.Surjective (fun x : ModP P.plus p ↦ x ^ p) := sorry

theorem tilt.coeff_add (x y : tilt p R) (i : ℕ) :
    Tendsto (fun m ↦ (tilt.coeff (i + m) x + tilt.coeff (i + m) y) ^ p ^ m)
      atTop (𝓝 (tilt.coeff i (x + y))) := sorry
theorem tilt.coeff_zero (n : ℕ) : tilt.coeff n (0 : tilt p R) = 0 := sorry
theorem tilt.coeff_frobeniusEquiv_symm [Nontrivial R] (x : tilt p R) (n : ℕ) :
    tilt.coeff n ((frobeniusEquiv (tilt p R) p).symm x) = tilt.coeff (n + 1) x := sorry
theorem tilt.mem_powerBoundedSubring_iff (x : tilt p R) :
    x ∈ powerBoundedSubring (tilt p R) ↔ ∀ n, tilt.coeff n x ∈ powerBoundedSubring R := sorry
theorem tilt.mem_powerBoundedSubring_iff_sharp (x : tilt p R) :
    x ∈ powerBoundedSubring (tilt p R) ↔ tilt.sharp x ∈ powerBoundedSubring R := sorry
theorem tilt.continuous_sharp : Continuous (tilt.sharp : tilt p R →* R) := sorry
theorem tilt.sharp_eq_zero_iff (x : tilt p R) : tilt.sharp x = 0 ↔ x = 0 := sorry
theorem tilt.sharp_add_sub_mem (x y : powerBoundedSubring (tilt p R)) :
    ∃ a : powerBoundedSubring R,
      tilt.sharp (x.val + y.val) - tilt.sharp x.val - tilt.sharp y.val = p * a.val := sorry
theorem tilt.exists_sharp_sub_mem (x : powerBoundedSubring R) :
    ∃ y : powerBoundedSubring (tilt p R), ∃ a : powerBoundedSubring R,
      x.val - tilt.sharp y.val = p * a.val := sorry

/-! ### P1/inverse-limit-of-integral-elements-along-frobenius -/
/-! ### P1/tilt-comparison-with-mathlib-pretilt -/

/-- BMS 3.2(i): reduction of every coordinate, with the library's nonunit hypothesis. -/
def tilt.integralEquivPreTilt (P : Pair R) [Fact (¬ IsUnit (p : P.plus))]
    [IsAdicComplete (Ideal.span {(p : P.plus)}) P.plus] :
    (Pair.tilt p P).plus ≃+* PreTilt P.plus p := sorry

theorem tilt.integralEquivPreTilt_coeff (P : Pair R) [Fact (¬ IsUnit (p : P.plus))]
    [IsAdicComplete (Ideal.span {(p : P.plus)}) P.plus]
    (x : (Pair.tilt p P).plus) (n : ℕ) :
    ∃ hx : tilt.coeff n x.val ∈ P.plus,
      PreTilt.coeff n (tilt.integralEquivPreTilt p P x) =
        Ideal.Quotient.mk (Ideal.span {(p : P.plus)}) ⟨tilt.coeff n x.val, hx⟩ := sorry

theorem tilt.sharp_eq_untilt (P : Pair R) [Fact (¬ IsUnit (p : P.plus))]
    [IsAdicComplete (Ideal.span {(p : P.plus)}) P.plus] (x : (Pair.tilt p P).plus) :
    ((PreTilt.untilt (tilt.integralEquivPreTilt p P x) : P.plus) : R) = tilt.sharp x.val := sorry

/-! ### P1/fontaine-theta-and-primitive-kernel -/

/-- Fontaine's map, including the unique map for a zero base. -/
def tilt.theta (P : Pair R) : WittVector p (Pair.tilt p P).plus →+* P.plus := sorry

theorem tilt.theta_teichmuller (P : Pair R) (x : (Pair.tilt p P).plus) :
    (tilt.theta p P (WittVector.teichmuller p x) : R) = tilt.sharp x.val := sorry

/-! ### P1/fontaine-theta-comparison-with-mathlib -/

theorem tilt.theta_eq_fontaineTheta (P : Pair R) [Fact (¬ IsUnit (p : P.plus))]
    [IsAdicComplete (Ideal.span {(p : P.plus)}) P.plus] :
    tilt.theta p P = (WittVector.fontaineTheta P.plus p).comp
      (WittVector.map (tilt.integralEquivPreTilt p P).toRingHom) := sorry

theorem tilt.theta_kernel_primitive (P : Pair R) : IsPrimitiveIdeal (RingHom.ker (tilt.theta p P)) := sorry

theorem tilt.theta_surjective (P : Pair R) : Function.Surjective (tilt.theta p P) := sorry

theorem tilt.theta_kernel_charP (P : Pair R) (hp : (p : R) = 0) :
    RingHom.ker (tilt.theta p P) = Ideal.span {(p : WittVector p (Pair.tilt p P).plus)} := sorry

/-- The raw untilt's marking restricts to the plus rings and carries the Fontaine kernel
back to its defining primitive ideal (ECD Theorem 3.17, p. 18). -/
theorem untilt.tiltEquiv_plus_kernel [CharP R p] (P : Pair R)
    (J : Ideal (WittVector p P.plus)) [Fact (IsPrimitiveIdeal J)] :
    ∃ e : (Pair.tilt p (untilt.pair p P J)).plus ≃+* P.plus,
      (∀ x, (e x : R) = untilt.tiltEquiv p P J x.val) ∧
      (RingHom.ker (tilt.theta p (untilt.pair p P J))).map
        (WittVector.map e.toRingHom) = J := sorry

/-! ### P1/sharp-approximation-lemma -/

theorem sharp_approximation (ϖ : PseudoUniformizerRoots p R) (a : R) :
    ∃ y : tilt p R, ϖ.gauge (a - tilt.sharp y) ≤ ϖ.gauge (p : R) * ϖ.gauge a := sorry

theorem sharp_quasi_additive (ϖ : PseudoUniformizerRoots p R) (x y : tilt p R) :
    ϖ.gauge (tilt.sharp (x + y) - tilt.sharp x - tilt.sharp y) ≤
      ϖ.gauge (p : R) * max (ϖ.gauge (tilt.sharp x)) (ϖ.gauge (tilt.sharp y)) := sorry

variable {S : Type*} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
  [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S] [IsPerfectoidTateRing p S]

/-! ### P1/strict-inclusions-under-tilting -/

theorem tilt.strict_inclusion_iff (f : R →+* S) (hf : Continuous f) :
    Topology.IsEmbedding (tilt.map p f hf) ↔ Topology.IsEmbedding f := sorry

theorem tilt.theta_natural (P : Pair R) (Q : Pair S) (f : Pair.Hom P Q) :
    (tilt.theta p Q).comp (WittVector.map
      ((Pair.tiltHom p f).toRingHom.restrict _ _ (Pair.tiltHom p f).map_mem_plus)) =
      (f.toRingHom.restrict _ _ f.map_mem_plus).comp (tilt.theta p P) := sorry

/-! ### P1/theta-kernel-base-change -/

theorem tilt.theta_kernel_base_change (P : Pair R) (Q : Pair S) (f : Pair.Hom P Q) :
    (RingHom.ker (tilt.theta p P)).map (WittVector.map
      ((Pair.tiltHom p f).toRingHom.restrict _ _ (Pair.tiltHom p f).map_mem_plus)) =
        RingHom.ker (tilt.theta p Q) := sorry
end SupportingInterfaces

section IntegralComparison
variable (p : ℕ) [Fact p.Prime] {R : Type*} [CommRing R]
/-! ### P1/integral-perfectoid-comparison -/

/-- BMS Lemma 3.10(ii), the reverse nonzerodivisor criterion. -/
theorem IsIntegralPerfectoid.of_frobenius_mod_pow_bijective
    (π : R) (hπ : π ∈ nonZeroDivisors R) (hp : π ^ p ∣ (p : R))
    [IsAdicComplete (Ideal.span {π}) R] (hF : Function.Bijective (frobeniusModPow p π hp)) :
