/-- Berkeley Example 8.2.2, p. 57: gluing over compact open subsets of S.
The projection, continuous coordinate and universal property fix the construction. -/
def prodLocallyProfinite (X : Perfd p) (S : Type) [TopologicalSpace S]
    [T2Space S] [LocallyCompactSpace S] [TotallyDisconnectedSpace S] : Perfd p := sorry

namespace prodLocallyProfinite
variable (X : Perfd p) (S : Type) [TopologicalSpace S]
  [T2Space S] [LocallyCompactSpace S] [TotallyDisconnectedSpace S]
def fst : prodLocallyProfinite p X S ⟶ X := sorry

def snd : C(underlyingPoints p (prodLocallyProfinite p X S), S) := sorry

def homEquiv (T : Perfd p) : (T ⟶ prodLocallyProfinite p X S) ≃
    (T ⟶ X) × C(underlyingPoints p T, S) := sorry

theorem homEquiv_apply (T : Perfd p) (f : T ⟶ prodLocallyProfinite p X S) :
    homEquiv p X S T f = (f ≫ fst p X S, (snd p X S).comp (pointMap p f).hom) := sorry

def homeomorph : underlyingPoints p (prodLocallyProfinite p X S) ≃ₜ
    underlyingPoints p X × S := sorry

theorem homeomorph_apply (x : underlyingPoints p (prodLocallyProfinite p X S)) :
    homeomorph p X S x = (pointMap p (fst p X S) x, snd p X S x) := sorry

theorem isProEtale : IsProEtale p (fst p X S) := sorry

theorem isAffinoid_iff (hX : IsAffinoidPerfectoid p X.obj)
    [Nonempty (underlyingPoints p X)] :
    IsAffinoidPerfectoid p (prodLocallyProfinite p X S).obj ↔ CompactSpace S := sorry
end prodLocallyProfinite

/-! ### P6/product-with-profinite-set -/

abbrev prodProfinite (X : Perfd p) (S : Profinite.{0}) := prodLocallyProfinite p X S

namespace prodProfinite
variable (X : Perfd p) (S : Profinite.{0})
abbrev fst := prodLocallyProfinite.fst p X S
abbrev snd := prodLocallyProfinite.snd p X S
abbrev homeomorph := prodLocallyProfinite.homeomorph p X S

theorem isAffinoidProEtale (hX : IsAffinoidPerfectoid p X.obj) :
    IsAffinoidProEtale p (fst p X S) := sorry

/-- The finite discrete product projection is étale, ECD §7, p. 32. -/
theorem isEtale [Finite S] : IsEtale p (fst p X S) := sorry

def map {S S' : Profinite.{0}} (a : S ⟶ S') : prodProfinite p X S ⟶ prodProfinite p X S' :=
  (prodLocallyProfinite.homEquiv p X S' _).symm
    (fst p X S, a.hom.hom.comp (snd p X S))

theorem map_fst {S S' : Profinite.{0}} (a : S ⟶ S') :
    map p X a ≫ fst p X S' = fst p X S := sorry

theorem map_id : map p X (𝟙 S) = 𝟙 _ := sorry

theorem map_comp {S₁ S₂ S₃ : Profinite.{0}} (a : S₁ ⟶ S₂) (b : S₂ ⟶ S₃) :
    map p X (a ≫ b) = map p X a ≫ map p X b := sorry

def baseChange {T : Perfd p} (f : T ⟶ X) :
    pullback f (fst p X S) ≅ prodProfinite p T S := sorry

theorem baseChange_fst {T : Perfd p} (f : T ⟶ X) :
    (baseChange p X S f).hom ≫ fst p T S = pullback.fst f (fst p X S) := sorry

def tilt : (tiltFunctor p).obj (prodProfinite p X S) ≅
    prodProfinite p ((tiltFunctor p).obj X) S := sorry

theorem tilt_fst : (tilt p X S).hom ≫ fst p ((tiltFunctor p).obj X) S =
    (tiltFunctor p).map (fst p X S) := sorry

/-- Continuous functions use the given topology of the complete affinoid pair. -/
def sectionsEquiv (R : PairCat.{0} p) :
    globalSections p (prodProfinite p (ofPair p R) S) ≃+* C(S, R) := sorry

def plusEquiv (R : PairCat.{0} p) :
    globalPlus p (prodProfinite p (ofPair p R) S) ≃+* C(S, R.pair.plus) := sorry

theorem sectionsEquiv_constant (R : PairCat.{0} p) (a : globalSections p (ofPair p R)) (s : S) :
    sectionsEquiv p S R (globalPullback p (fst p (ofPair p R) S) a) s =
      globalSectionsAffinoidEquiv p R a := sorry
end prodProfinite

/-- The relative product represents continuous lifts of the map to S₀ (ECD 11.12, p. 58). -/
def fibreProdProfinite (X : Perfd p) {S₀ : Profinite.{0}} (φ : C(underlyingPoints p X, S₀))
    {S : Profinite.{0}} (a : S ⟶ S₀) : Perfd p := sorry

namespace fibreProdProfinite
variable (X : Perfd p) {S₀ S : Profinite.{0}} (φ : C(underlyingPoints p X, S₀)) (a : S ⟶ S₀)
def fst : fibreProdProfinite p X φ a ⟶ X := sorry

def snd : C(underlyingPoints p (fibreProdProfinite p X φ a), S) := sorry

theorem condition (x : underlyingPoints p (fibreProdProfinite p X φ a)) :
    a (snd p X φ a x) = φ (pointMap p (fst p X φ a) x) := sorry

def homEquiv {T : Perfd p} (t : T ⟶ X) :
    (Over.mk t ⟶ Over.mk (fst p X φ a)) ≃
      {b : C(underlyingPoints p T, S) // a.hom.hom.comp b = φ.comp (pointMap p t).hom} := sorry

theorem homEquiv_apply {T : Perfd p} (t : T ⟶ X) (b : Over.mk t ⟶ Over.mk (fst p X φ a)) :
    (homEquiv p X φ a t b).val = (snd p X φ a).comp (pointMap p b.left).hom := sorry

def homeomorph : underlyingPoints p (fibreProdProfinite p X φ a) ≃ₜ
    {z : underlyingPoints p X × S // φ z.1 = a z.2} := sorry

theorem homeomorph_apply (x : underlyingPoints p (fibreProdProfinite p X φ a)) :
    (homeomorph p X φ a x).val = (pointMap p (fst p X φ a) x, snd p X φ a x) := sorry

theorem isAffinoidProEtale (hX : IsAffinoidPerfectoid p X.obj) :
    IsAffinoidProEtale p (fst p X φ a) := sorry

def baseChange {T : Perfd p} (t : T ⟶ X) :
    pullback t (fst p X φ a) ≅ fibreProdProfinite p T (φ.comp (pointMap p t).hom) a := sorry

theorem baseChange_fst {T : Perfd p} (t : T ⟶ X) :
    (baseChange p X φ a t).hom ≫ fst p T (φ.comp (pointMap p t).hom) a =
      pullback.fst t (fst p X φ a) := sorry
end fibreProdProfinite

/-! ### Layer 6: Canonical presentations and finite-stage factorization -/

theorem AffinoidEtale.essentiallySmall (X : Perfd p) (hX : IsAffinoidPerfectoid p X.obj) :
    EssentiallySmall.{0} (AffinoidEtale p X) := sorry

/-! ### P6/affinoid-etale-size-bound -/

/-- ECD 7.10, p. 33: the indicated bound controls rings and points of every stage. -/
theorem affinoidEtale_size_bound (R : PairCat.{0} p) (Y : AffinoidEtale p (ofPair p R)) :
    #(globalSections p Y.obj.left) ≤ Cardinal.lift.{1} ((#R + ℵ₀) ^ ℵ₀) ∧
    #(underlyingPoints p Y.obj.left) ≤ Cardinal.lift.{1} (2 ^ ((#R + ℵ₀) ^ ℵ₀)) := sorry

/-! ### P6/canonical-pro-etale-presentation -/

/-- Arrows point from a factorization to its coarsening; morphisms satisfy t ≫ u = t'. -/
abbrev CanonicalEtaleIndex {Y X : Perfd p} (f : Y ⟶ X) :=
  StructuredArrow (Over.mk f) (ObjectProperty.ι
    (fun T : Over X ↦ IsAffinoidPerfectoid p T.left.obj ∧ IsEtale p T.hom))

theorem canonicalEtaleIndex_essentiallySmall {Y X : Perfd p} (f : Y ⟶ X)
    (hY : IsAffinoidPerfectoid p Y.obj) (hX : IsAffinoidPerfectoid p X.obj) :
    EssentiallySmall.{0} (CanonicalEtaleIndex p f) := sorry

theorem canonicalEtaleIndex_cofiltered {Y X : Perfd p} (f : Y ⟶ X)
    (hY : IsAffinoidPerfectoid p Y.obj) (hX : IsAffinoidPerfectoid p X.obj) :
    IsCofiltered (CanonicalEtaleIndex p f) := sorry

section Canonical
variable {Y X : Perfd p} (f : Y ⟶ X)
  (hY : IsAffinoidPerfectoid p Y.obj) (hX : IsAffinoidPerfectoid p X.obj)
abbrev canonicalSmallIndex : Type := by
  letI := canonicalEtaleIndex_essentiallySmall p f hY hX
  exact SmallModel.{0} (CanonicalEtaleIndex p f)

instance canonicalSmallIndex_category : SmallCategory (canonicalSmallIndex p f hY hX) := by
  letI := canonicalEtaleIndex_essentiallySmall p f hY hX
  exact inferInstanceAs (SmallCategory (SmallModel.{0} (CanonicalEtaleIndex p f)))

instance canonicalSmallIndex_cofiltered : IsCofiltered (canonicalSmallIndex p f hY hX) := sorry

def canonicalSmallEquivalence : CanonicalEtaleIndex p f ≌ canonicalSmallIndex p f hY hX := by
  letI := canonicalEtaleIndex_essentiallySmall p f hY hX
  exact equivSmallModel.{0} (CanonicalEtaleIndex p f)

def canonicalDiagram : canonicalSmallIndex p f hY hX ⥤ Perfd p :=
  (canonicalSmallEquivalence p f hY hX).inverse ⋙
    StructuredArrow.proj _ _ ⋙ ObjectProperty.ι _ ⋙ Over.forget X

def canonicalCone : Cone (canonicalDiagram p f hY hX) := sorry

theorem canonicalCone_pt : (canonicalCone p f hY hX).pt = Y := sorry

theorem canonicalCone_π (i : canonicalSmallIndex p f hY hX) :
    eqToHom (canonicalCone_pt p f hY hX).symm ≫ (canonicalCone p f hY hX).π.app i =
      ((canonicalSmallEquivalence p f hY hX).inverse.obj i).hom.left := sorry

theorem canonicalDiagram_affinoid (i : canonicalSmallIndex p f hY hX) :
    IsAffinoidPerfectoid p ((canonicalDiagram p f hY hX).obj i).obj := sorry

def canonicalMap : Y ⟶ cofilteredLimit p (canonicalDiagram p f hY hX)
    (canonicalDiagram_affinoid p f hY hX) :=
  eqToHom (canonicalCone_pt p f hY hX).symm ≫
    cofilteredLimit.lift p _ _ (canonicalCone p f hY hX)

theorem isAffinoidProEtale_iff_canonical :
    IsAffinoidProEtale p f ↔ IsIso (canonicalMap p f hY hX) := sorry
end Canonical

namespace ProEtalePresentation
variable {p} {Y X : Perfd p} {f : Y ⟶ X} (P : ProEtalePresentation p f)
def canonicalFunctor : P.I ⥤ CanonicalEtaleIndex p f where
  obj i := StructuredArrow.mk (Over.homMk (P.π i) (P.π_comp i))
  map a := StructuredArrow.homMk (P.diagram.map a) (by sorry)
  map_id := by sorry
  map_comp := by sorry

theorem canonicalFunctor_obj (i : P.I) :
    (P.canonicalFunctor.obj i).right = P.diagram.obj i := sorry

theorem canonicalFunctor_map {i j : P.I} (a : i ⟶ j) :
    (P.canonicalFunctor.map a).right = P.diagram.map a := sorry

instance canonicalFunctor_initial : P.canonicalFunctor.Initial := sorry
end ProEtalePresentation

/-! ### P6/maps-to-etale-factor-through-finite-stage -/

/-- ECD 6.4(ii), pp. 27–28: both factorization and eventual equality over X. -/
theorem maps_to_etale_factor {I : Type} [SmallCategory I] [IsCofiltered I]
    (X : Perfd p) (hX : IsAffinoidPerfectoid p X.obj) (D : I ⥤ Over X)
    (hD : ∀ i, IsAffinoidPerfectoid p (D.obj i).left.obj)
    (c : Cone D) (hc : IsLimit c) (T : Over X)
    (hT : IsEtale p T.hom) (hqc : QuasiCompact p T.hom) (hqs : QuasiSeparated p T.hom) :
    (∀ f : c.pt ⟶ T, ∃ (i : I) (g : D.obj i ⟶ T), c.π.app i ≫ g = f) ∧
    (∀ (i : I) (g h : D.obj i ⟶ T), c.π.app i ≫ g = c.π.app i ≫ h →
      ∃ (j : I) (a : j ⟶ i), D.map a ≫ g = D.map a ≫ h) := sorry

/-! ### Layer 6: Pro-object realization and cardinal-bounded presentations -/



section Realization
variable (X : Perfd p) (hX : IsAffinoidPerfectoid p X.obj)
abbrev affinoidEtaleSmall : Type := by
  letI := AffinoidEtale.essentiallySmall p X hX
  exact SmallModel.{0} (AffinoidEtale p X)

instance affinoidEtaleSmall_category : SmallCategory (affinoidEtaleSmall p X hX) := by
  letI := AffinoidEtale.essentiallySmall p X hX
  exact inferInstanceAs (SmallCategory (SmallModel.{0} (AffinoidEtale p X)))

def affinoidEtaleSmallEquivalence : AffinoidEtale p X ≌ affinoidEtaleSmall p X hX := by
  letI := AffinoidEtale.essentiallySmall p X hX
  exact equivSmallModel.{0} (AffinoidEtale p X)

/-! ### P6/pro-etale-pro-category-equivalence -/

/-- ECD Proposition 7.10, p. 33; realization of the small model of the affinoid étale site. -/
def proEtaleEquivalence : (Ind (affinoidEtaleSmall p X hX)ᵒᵖ)ᵒᵖ ≌
    AffinoidProEtale p X := sorry

/-- The realization is fixed by its limit cone on each small cofiltered diagram. -/
def proEtaleEquivalence.cone {I : Type} [SmallCategory I] [IsCofiltered I]
    (D : I ⥤ affinoidEtaleSmall p X hX) :
    Cone (D ⋙ (affinoidEtaleSmallEquivalence p X hX).inverse ⋙ ObjectProperty.ι _) := sorry

theorem proEtaleEquivalence.cone_pt {I : Type} [SmallCategory I] [IsCofiltered I]
    (D : I ⥤ affinoidEtaleSmall p X hX) :
    (proEtaleEquivalence.cone p X hX D).pt =
      ((proEtaleEquivalence p X hX).functor.obj
        (Opposite.op ((Ind.lim Iᵒᵖ).obj D.op))).obj := sorry

def proEtaleEquivalence.isLimit {I : Type} [SmallCategory I] [IsCofiltered I]
    (D : I ⥤ affinoidEtaleSmall p X hX) :
    IsLimit (proEtaleEquivalence.cone p X hX D) := sorry

/-- ECD 7.10's bounded refinement; strong limit is used for the size of the completed rings. -/
def proEtaleKappaEquivalence {κ : Cardinal.{1}} (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    (hsmall : IsKappaSmall p κ X) :
    ProKappa κ (affinoidEtaleSmall p X hX) ≌
      ObjectProperty.FullSubcategory
        (fun Y : AffinoidProEtale p X ↦ IsKappaSmall p κ Y.obj.left) := sorry
end Realization

theorem isKappaSmall_iff_bounded_presentation {Y X : Perfd p} (f : Y ⟶ X)
    (hf : IsAffinoidProEtale p f) {κ : Cardinal.{1}}
    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (hX : IsKappaSmall p κ X) :
    IsKappaSmall p κ Y ↔ ∃ P : ProEtalePresentation p f,
      Cardinal.lift.{1} #(Σ i j : P.I, i ⟶ j) < κ := sorry

/-! ### P6/kappa-small-perfectoid-subpairs -/

/-- P6.4's closed perfectoid subpairs are subrings with their induced topology and plus ring.
Existence of a topologically embedded pair identifies the subring's perfectoid structure. -/
def KappaSubpairs {R S : PairCat.{0} p} (a : R ⟶ S) (κ : Cardinal.{1}) :=
  {B : Subring S // IsClosed (B : Set S) ∧ Set.range a.toRingHom ⊆ B ∧
    Cardinal.lift.{1} #B < κ ∧ ∃ (T : PairCat.{0} p) (b : T ⟶ S),
      Topology.IsClosedEmbedding b.toRingHom ∧ Set.range b.toRingHom = B ∧
      T.pair.plus = S.pair.plus.comap b.toRingHom}

instance kappaSubpairs_partialOrder {R S : PairCat.{0} p} (a : R ⟶ S) (κ : Cardinal.{1}) :
    PartialOrder (KappaSubpairs p a κ) := inferInstanceAs (PartialOrder (Subtype _))

theorem kappaSubpairs_directed {R S : PairCat.{0} p} (a : R ⟶ S) {κ : Cardinal.{1}}
    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (hR : Cardinal.lift.{1} #R < κ) :
    Nonempty (KappaSubpairs p a κ) ∧ Directed (· ≤ ·) (fun B : KappaSubpairs p a κ ↦ B) := sorry

theorem kappaSubpairs_uniform_bound {R S : PairCat.{0} p} (a : R ⟶ S)
    {κ μ : Cardinal.{1}} (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    (hμ₀ : ℵ₀ ≤ μ) (hμ : μ < κ) (hR : Cardinal.lift.{1} #R ≤ μ)
    (F : Set (KappaSubpairs p a κ)) (hF : Cardinal.lift.{1} #F ≤ μ)
    (hB : ∀ B ∈ F, Cardinal.lift.{1} #B.val ≤ μ) :
    ∃ B : KappaSubpairs p a κ, (∀ C ∈ F, C ≤ B) ∧ Cardinal.lift.{1} #B.val ≤ μ ^ ℵ₀ := sorry

theorem kappaSubpairs_union {R S : PairCat.{0} p} (a : R ⟶ S) {κ : Cardinal.{1}}
    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (hR : Cardinal.lift.{1} #R < κ) :
    (⋃ B : KappaSubpairs p a κ, (B.val : Set S)) = Set.univ ∧
    (⋃ B : KappaSubpairs p a κ, (B.val : Set S) ∩ S.pair.plus) = S.pair.plus := sorry

-- Check: kappaSubpairs_top
example {R S : PairCat.{0} p} (a : R ⟶ S) {κ : Cardinal.{1}}
    (hS : Cardinal.lift.{1} #S < κ) : ∃ B : KappaSubpairs p a κ, B.val = ⊤ := sorry
-- Check: kappaSubpairs_empty_family
example (R : PairCat.{0} p) {κ μ : Cardinal.{1}} (hμ : μ < Cardinal.lift.{1} #R) :
    ¬ ∃ B : KappaSubpairs p (𝟙 R) κ, Cardinal.lift.{1} #B.val ≤ μ := sorry
-- Check: kappaSubpairs_two_members
example {R S : PairCat.{0} p} (a : R ⟶ S) {κ : Cardinal.{1}}
    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (hR : Cardinal.lift.{1} #R < κ)
    (B C : KappaSubpairs p a κ) : ∃ D : KappaSubpairs p a κ, B ≤ D ∧ C ≤ D := sorry

