-- Check: gauge_product
example (ϖ ψ : PseudoUniformizerRoots p (ℂ_[p] × ℂ_[p])) (a : ℂ_[p])
    (hϖ : ϖ.root 0 = (a, a)) (hψ : ψ.root 0 = (a, a ^ 2)) :
    (ϖ.gauge (a, 0) : ℝ) = 1 / 2 ∧ (ψ.gauge (a, 0) : ℝ) = 1 / 2 ∧
      (ϖ.gauge (0, a ^ 2) : ℝ) = 1 / 4 ∧ (ψ.gauge (0, a ^ 2) : ℝ) = 1 / 2 ∧
      ¬ ∃ c : ℝ, ∀ x, (ψ.gauge x : ℝ) = (ϖ.gauge x : ℝ) ^ c := sorry

-- Check: roots_padic_empty
example : IsEmpty (PseudoUniformizerRoots p ℚ_[p]) := sorry

-- Check: roots_charP_unique
example (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [CharP R p] [IsPerfectoidTateRing p R] (x : R) :
