/-! ### Layer 4: Characteristic equations for quotient and stalk maps -/
namespace PerfectoidSpace
open Perfectoid TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]

/-- Evaluate through any rational presentation and its canonical comparison with the pair. -/
theorem rationalResidueMap_base (R : PairCat.{0} p) (x : spa R.pair.plus)
    (U : (rationalNeighborhoods p R x).family) (D : PairOfDefinition R)
    (q : D.Presentation) (hq : Ideal.span (q.num : Set R) = ⊤)
    (hU : U.val.val = Subtype.val ⁻¹' rationalSubset R.pair.plus q.num q.den) :
    ((Perfectoid.rationalResidueMap (CAff.of R.pair) D x q
      (by have hx : x ∈ U.val.val := U.property; rw [hU] at hx; exact hx)).comp
        (rationalPair_presentation p R U.val D q hq hU).choose.toRingHom).comp (rationalMap p R U.val).toRingHom =
      residueMap p R x := sorry

/-- Rational integral sections evaluate in the completed residue plus ring. -/
theorem rationalResidueMap_integral (R : PairCat.{0} p) (x : spa R.pair.plus)
    (U : (rationalNeighborhoods p R x).family) (D : PairOfDefinition R)
    (q : D.Presentation) (hq : Ideal.span (q.num : Set R) = ⊤)
    (hU : U.val.val = Subtype.val ⁻¹' rationalSubset R.pair.plus q.num q.den)
    (a : (rationalPair p R U.val).pair.plus) :
    ((Perfectoid.rationalResidueMap (CAff.of R.pair) D x q
      (by have hx : x ∈ U.val.val := U.property; rw [hU] at hx; exact hx)).comp
        (rationalPair_presentation p R U.val D q hq hU).choose.toRingHom) a ∈ (residuePair p R x).plus := sorry

theorem integralStalkToResidue_stage (R : PairCat.{0} p) (x : spa R.pair.plus)
    (U : (rationalNeighborhoods p R x).family) (D : PairOfDefinition R)
    (q : D.Presentation) (hq : Ideal.span (q.num : Set R) = ⊤)
    (hU : U.val.val = Subtype.val ⁻¹' rationalSubset R.pair.plus q.num q.den)
    (a : (rationalPair p R U.val).pair.plus) :
    (integralStalkToResidue p R x
      ((colimit.ι ((rationalNeighborhoods p R x).plusDiagram p) (Opposite.op U)).hom a)).val =
      ((Perfectoid.rationalResidueMap (CAff.of R.pair) D x q
      (by have hx : x ∈ U.val.val := U.property; rw [hU] at hx; exact hx)).comp
        (rationalPair_presentation p R U.val D q hq hU).choose.toRingHom) a := sorry

-- Check: rationalResidue_zero
example (R : PairCat.{0} p) (x : spa R.pair.plus)
    (U : (rationalNeighborhoods p R x).family) (D : PairOfDefinition R)
    (q : D.Presentation) (hq : Ideal.span (q.num : Set R) = ⊤)
    (hU : U.val.val = Subtype.val ⁻¹' rationalSubset R.pair.plus q.num q.den)
    (a : R) (ha : a ≠ 0) (hx : x.val.valuation a = 0) :
    ((Perfectoid.rationalResidueMap (CAff.of R.pair) D x q
      (by have hx : x ∈ U.val.val := U.property; rw [hU] at hx; exact hx)).comp
        (rationalPair_presentation p R U.val D q hq hU).choose.toRingHom)
        ((rationalMap p R U.val).toRingHom a) = 0 := sorry
-- Check: rationalResidue_scalar
example (R : PairCat.{0} p) (x : spa R.pair.plus)
    (U : (rationalNeighborhoods p R x).family) (D : PairOfDefinition R)
    (q : D.Presentation) (hq : Ideal.span (q.num : Set R) = ⊤)
    (hU : U.val.val = Subtype.val ⁻¹' rationalSubset R.pair.plus q.num q.den) (a : R) :
    ((Perfectoid.rationalResidueMap (CAff.of R.pair) D x q
      (by have hx : x ∈ U.val.val := U.property; rw [hU] at hx; exact hx)).comp
        (rationalPair_presentation p R U.val D q hq hU).choose.toRingHom) ((rationalMap p R U.val).toRingHom a) =
      residueMap p R x a := sorry
-- Check: rationalResidue_two_terms
example (R : PairCat.{0} p) (x : spa R.pair.plus)
    (U : (rationalNeighborhoods p R x).family) (D : PairOfDefinition R)
    (q : D.Presentation) (hq : Ideal.span (q.num : Set R) = ⊤)
    (hU : U.val.val = Subtype.val ⁻¹' rationalSubset R.pair.plus q.num q.den) (a b : R) :
    let j := (rationalMap p R U.val).toRingHom
    ((Perfectoid.rationalResidueMap (CAff.of R.pair) D x q
      (by have hx : x ∈ U.val.val := U.property; rw [hU] at hx; exact hx)).comp
        (rationalPair_presentation p R U.val D q hq hU).choose.toRingHom)
        ((j a + j b) * Ring.inverse (j q.den)) =
      (residueMap p R x a + residueMap p R x b) * Ring.inverse (residueMap p R x q.den) := sorry

theorem proRationalSubspace.localization (R : PairCat.{0} p) (D : RationalSystem p R)
    (π : R.pair.plus) (hπ : IsPseudoUniformizer (π : R)) :
