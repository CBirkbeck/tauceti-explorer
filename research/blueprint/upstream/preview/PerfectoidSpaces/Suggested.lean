/-! ### P0/almost-flat-projective-finiteness -/

/-- Flatness is exactness of tensoring, GR Definition 2.4.4. -/
def Flat (M : Module S) : Prop := PreservesFiniteLimits (tensorLeft M)

/-- Faithful flatness also detects zero objects, GR Definition 2.4.4. -/
def FaithfullyFlat (M : Module S) : Prop :=
  Flat S M ∧ ∀ N : Module S, IsZero (M ⊗ N) → IsZero N

/-- Almost projectivity is exactness of internal Hom, GR Definition 2.4.4. -/
def AlmostProjective (M : Module S) : Prop :=
  (alHomFunctor S M).PreservesEpimorphisms

/-- Almost finite projectivity, GR Definition 2.4.4. -/
def AlmostFiniteProjective (M : Module S) : Prop :=
  AlmostProjective S M ∧ AlmostFG S ((elements S).obj M)

/-- Uniform almost finite projectivity with a specified bound. -/
def UniformlyAlmostFiniteProjective (M : Module S) (n : ℕ) : Prop :=
  AlmostProjective S M ∧ UniformlyAlmostFG S ((elements S).obj M) n

/-- Ordinary flatness and projectivity descend to almost modules, GR (2.4.8). -/
theorem flat_toAlmost (N : ModuleCat.{u} V) :
    (_root_.Module.Flat V N → Flat S ((toAlmost S).obj N)) ∧
      (_root_.Module.FaithfullyFlat V N → FaithfullyFlat S ((toAlmost S).obj N)) ∧
      (_root_.Module.Projective V N → AlmostProjective S ((toAlmost S).obj N)) := sorry

-- Check: almostProjective_test_unit_epsilon
example (ε : V) (hε : ε ∈ S.ideal) (hu : IsUnit ε) (N : ModuleCat.{u} V) :
    S.ideal = ⊤ ∧ (AlmostProjective S ((toAlmost S).obj N) ↔
      _root_.Module.Projective V N) := sorry

/-- Finite projectivity can be recognized by flatness and presentation, GR Proposition 2.4.18. -/
theorem almostFiniteProjective_iff (M : Module S) :
    AlmostFiniteProjective S M ↔ Flat S M ∧ AlmostFP S ((elements S).obj M) := sorry

/-- Almost projectivity implies flatness, GR Remark 2.4.12(i). -/
theorem AlmostProjective.flat {M : Module S} (hM : AlmostProjective S M) : Flat S M := sorry

/-- Finite epsilon splittings, GR Lemma 2.4.15. -/
theorem almostProjective_iff_factor (M : Module S) (hM : AlmostFG S ((elements S).obj M)) :
    AlmostProjective S M ↔ ∀ ε ∈ S.ideal, ∃ (n : ℕ)
      (a : M ⟶ (toAlmost S).obj (ModuleCat.of V (Fin n → V)))
      (b : (toAlmost S).obj (ModuleCat.of V (Fin n → V)) ⟶ M), a ≫ b = ε • 𝟙 M := sorry

/-- A fixed bound in the epsilon splitting criterion, GR Remark 2.3.9 and Lemma 2.4.15. -/
theorem uniformlyAlmostFiniteProjective_iff_factor (hS : S.IsFilteredPrincipal)
    (M : Module S) (n : ℕ) : UniformlyAlmostFiniteProjective S M n ↔
    ∀ ε ∈ S.ideal, ∃ (a : M ⟶ (toAlmost S).obj (ModuleCat.of V (Fin n → V)))
      (b : (toAlmost S).obj (ModuleCat.of V (Fin n → V)) ⟶ M), a ≫ b = ε • 𝟙 M := sorry

/-! ### P0/almost-finite-generation-epsilon-criterion -/

/-- The epsilon criterion with finite modules, Scholze Definition/Proposition 4.7(iii). -/
theorem almostFG_iff_epsilon (hS : S.IsFilteredPrincipal) (N : ModuleCat.{u} V) :
    AlmostFG S N ↔ ∀ ε ∈ S.ideal, ∃ (P : ModuleCat.{u} V) (_ : _root_.Module.Finite V P)
      (f : P ⟶ N), (∀ x ∈ LinearMap.ker f.hom, ε • x = 0) ∧
      ∀ x : N, ε • x ∈ LinearMap.range f.hom := sorry

/-- The corresponding presentation criterion, Scholze Definition/Proposition 4.7(iii). -/
theorem almostFP_iff_epsilon (hS : S.IsFilteredPrincipal) (N : ModuleCat.{u} V) :
    AlmostFP S N ↔ ∀ ε ∈ S.ideal, ∃ (P : ModuleCat.{u} V)
      (_ : _root_.Module.FinitePresentation V P) (f : P ⟶ N),
      (∀ x ∈ LinearMap.ker f.hom, ε • x = 0) ∧
      ∀ x : N, ε • x ∈ LinearMap.range f.hom := sorry

