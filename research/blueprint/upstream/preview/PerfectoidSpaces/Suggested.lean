section IntegralPerfectoid

variable (p : ℕ) [Fact p.Prime] (R : Type*) [CommRing R]

/-! ### P1/integral-perfectoid-rings -/

/-- An integral perfectoid ring in the sense of BMS Definition 3.5: an admissible
adic element, surjective Frobenius modulo `p`, and principal Fontaine kernel.
The kernel condition uses Mathlib's Fontaine map whenever `p` is a nonunit. Adic
completeness for an admissible element implies `p`-adic completeness (Stacks 090T).
If `p` is a unit these conditions force the zero ring, whose unique map has principal kernel. -/
class IsIntegralPerfectoid : Prop where
  /-- A complete separated adic presentation with `π^p ∣ p`. -/
  exists_adic_element : ∃ π : R, π ^ p ∣ (p : R) ∧ IsAdicComplete (Ideal.span {π}) R
  /-- Frobenius on `R/p` is surjective. -/
  frobenius_surjective : Function.Surjective (fun x : ModP R p ↦ x ^ p)
  /-- The kernel of the existing Fontaine map is principal. -/
  theta_kernel_principal : ∀ (hp : ¬ IsUnit (p : R))
      (hc : IsAdicComplete (Ideal.span {(p : R)}) R),
    letI : Fact (¬ IsUnit (p : R)) := ⟨hp⟩
    letI := hc
    (RingHom.ker (WittVector.fontaineTheta R p)).IsPrincipal

variable {R}

/-- BMS Lemma 3.10(i), p. 22: for any admissible element, Frobenius between the two
successive power quotients is bijective. Completeness concerns this chosen `π`. -/
theorem IsIntegralPerfectoid.frobenius_mod_pow_bijective [IsIntegralPerfectoid p R]
    (π : R) (hp : π ^ p ∣ (p : R))
    [IsAdicComplete (Ideal.span {π}) R] : Function.Bijective (frobeniusModPow p π hp) := sorry

/-- BMS Lemma 3.9: an admissible adic element can be multiplied by a unit so that
it admits compatible `p`-power roots; no torsion-freeness assumption is imposed. -/
theorem IsIntegralPerfectoid.exists_compatible_roots [IsIntegralPerfectoid p R]
    (π : R) (hp : π ^ p ∣ (p : R)) [IsAdicComplete (Ideal.span {π}) R] :
    ∃ (u : Rˣ) (x : Perfection R p), Perfection.coeffMonoidHom R p 0 x = (u : R) * π := sorry

-- Check: integral_perfect_charP
example [CharP R p] [PerfectRing R p] : IsIntegralPerfectoid p R := sorry

-- Check: integral_zero
example [Subsingleton R] : IsIntegralPerfectoid p R := sorry

-- Check: integral_padic_negative_predicate
example : ¬ IsIntegralPerfectoid p ℤ_[p] := sorry

-- Check: integral_padicComplex
example : IsIntegralPerfectoid p (powerBoundedSubring ℂ_[p]) := sorry

-- Check: integral_adic_element_matters
example [CharP R p] [PerfectRing R p] [Nontrivial R] :
    IsIntegralPerfectoid p R ∧ IsAdicComplete (Ideal.span {(0 : R)}) R ∧
      ¬ IsAdicComplete (Ideal.span {(1 : R)}) R := sorry

end IntegralPerfectoid

/-! ### Complete uniform tilts (AWS Lemma 2.7.1) -/
section UniformTilt
variable (p : ℕ) [Fact p.Prime] (B : Type*) [CommRing B]

/-! ### P1/tilt-of-uniform-tate-ring -/

/-- Compatible multiplicative sequences, with addition specified by `coeff_add`. -/
def uniformTilt := Perfection B p
namespace uniformTilt
instance [TopologicalSpace B] : TopologicalSpace (uniformTilt p B) :=
  inferInstanceAs (TopologicalSpace {f : ℕ → B // ∀ n, f (n + 1) ^ p = f n})
instance [TopologicalSpace B] [T2Space B] : T2Space (uniformTilt p B) :=
  inferInstanceAs (T2Space {f : ℕ → B // ∀ n, f (n + 1) ^ p = f n})
variable [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B]
  [IsTateRing B] [CompleteSpace B] [T2Space B] [Fact (IsBounded (powerBoundedSubring B : Set B))]
  [Fact (IsTopologicallyNilpotent (p : B))]
instance instCommRing (p : ℕ) [Fact p.Prime] (B : Type*) [CommRing B] [UniformSpace B]
    [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B] [CompleteSpace B] [T2Space B]
    [Fact (IsBounded (powerBoundedSubring B : Set B))] [Fact (IsTopologicallyNilpotent (p : B))] :
    CommRing (uniformTilt p B) := sorry
instance : IsTopologicalRing (uniformTilt p B) := sorry
instance : UniformSpace (uniformTilt p B) := IsTopologicalAddGroup.rightUniformSpace _
instance : IsUniformAddGroup (uniformTilt p B) := sorry
instance : CompleteSpace (uniformTilt p B) := sorry
instance [Nontrivial B] : Nontrivial (uniformTilt p B) := sorry
instance [Nontrivial B] : CharP (uniformTilt p B) p := sorry
instance : PerfectRing (uniformTilt p B) p := sorry
instance : NonarchimedeanAddGroup (uniformTilt p B) := sorry
theorem isBounded_powerBoundedSubring :
    IsBounded (powerBoundedSubring (uniformTilt p B) : Set (uniformTilt p B)) := sorry

/-- Coordinate evaluation, using the multiplication of `Perfection`. -/
def coeff (n : ℕ) : uniformTilt p B →* B :=
  { toFun := Perfection.coeffMonoidHom B p n
    map_one' := sorry
    map_mul' := sorry }
/-- Zeroth coordinate of a compatible sequence. -/
abbrev sharp : uniformTilt p B →* B := coeff p B 0
variable {p B}
theorem coeff_zero (n : ℕ) : coeff p B n 0 = 0 := sorry
theorem coeff_add (x y : uniformTilt p B) (i : ℕ) :
    Tendsto (fun m ↦ (coeff p B (i + m) x + coeff p B (i + m) y) ^ p ^ m)
      atTop (𝓝 (coeff p B i (x + y))) := sorry
theorem continuous_sharp : Continuous (sharp p B) := sorry
theorem mem_powerBoundedSubring_iff (x : uniformTilt p B) :
    x ∈ powerBoundedSubring (uniformTilt p B) ↔ sharp p B x ∈ powerBoundedSubring B := sorry

/-- The integral inverse limit, as a subring for the limit addition. -/
def plus (P : Pair B) : Subring (uniformTilt p B) where
  carrier := {x | sharp p B x ∈ P.plus}
  zero_mem' := sorry
  one_mem' := sorry
  add_mem' := sorry
  neg_mem' := sorry
  mul_mem' := sorry

theorem plus_isOpen (P : Pair B) : IsOpen (plus (p := p) P : Set (uniformTilt p B)) := sorry

/-- Reduction on every coordinate (AWS 2.7.1(c), with adic completeness explicit). -/
def plusEquiv (P : Pair B) (I : Ideal P.plus) [IsAdicComplete I P.plus]
    [CharP (P.plus ⧸ I) p] : plus (p := p) P ≃+* Perfection (P.plus ⧸ I) p := sorry

theorem plusEquiv_coeff (P : Pair B) (I : Ideal P.plus) [IsAdicComplete I P.plus]
    [CharP (P.plus ⧸ I) p] (x : plus (p := p) P) (n : ℕ) :
    ∃ hx : uniformTilt.coeff p B n x.val ∈ P.plus,
      Perfection.coeff (P.plus ⧸ I) p n (plusEquiv (p := p) P I x) =
        Ideal.Quotient.mk I ⟨uniformTilt.coeff p B n x.val, hx⟩ := sorry

/-- Fontaine's homomorphism on the integral uniform tilt (AWS Definition 2.7.3). -/
def theta (P : Pair B) : WittVector p (plus (p := p) P) →+* P.plus := sorry
theorem theta_teichmuller (P : Pair B) (x : plus (p := p) P) :
    ((theta (p := p) P (WittVector.teichmuller p x) : P.plus) : B) = sharp p B x := sorry

variable {C : Type*} [CommRing C] [UniformSpace C] [IsUniformAddGroup C]
  [IsTopologicalRing C] [IsTateRing C] [CompleteSpace C] [T2Space C] [Fact (IsBounded (powerBoundedSubring C : Set C))]
  [Fact (IsTopologicallyNilpotent (p : C))]
/-- Apply a continuous map to every coordinate. -/
def map (f : B →+* C) (hf : Continuous f) : uniformTilt p B →+* uniformTilt p C := sorry
theorem coeff_map (f : B →+* C) (hf : Continuous f) (x : uniformTilt p B) (n : ℕ) :
    coeff p C n (map f hf x) = f (coeff p B n x) := sorry
theorem continuous_map (f : B →+* C) (hf : Continuous f) : Continuous (map (p := p) f hf) := sorry

/-- A compatible small unit makes the uniform tilt Tate (AWS 2.7.8). -/
theorem isTateRing_of_sharp (ϖ : PseudoUniformizerRoots p B) :
    ∃ h : IsTateRing (uniformTilt p B),
      letI := h
      IsPerfectoidTateRing p (uniformTilt p B) := sorry

/-- The perfectoid specialization has exactly the same compatible sequences. -/
def equivTilt [IsPerfectoidTateRing p B] : uniformTilt p B ≃+* tilt p B := sorry
theorem equivTilt_coeff [IsPerfectoidTateRing p B] (x : uniformTilt p B) (n : ℕ) :
    tilt.coeff n (equivTilt x) = coeff p B n x := sorry
theorem equivTilt_continuous [IsPerfectoidTateRing p B] :
    Continuous (equivTilt (p := p) (B := B)) ∧ Continuous (equivTilt (p := p) (B := B)).symm := sorry
end uniformTilt
end UniformTilt

