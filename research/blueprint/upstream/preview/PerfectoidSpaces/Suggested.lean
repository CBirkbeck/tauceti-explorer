/-! ### Layer 5: Completed pairs and their characteristic maps -/
namespace Perfectoid
universe u
variable (p : ℕ) [Fact p.Prime] {J : Type u} [SmallCategory J] [hJ : IsFiltered J]
  (D : J ⥤ PairCat.{u} p) (j₀ : J) (ϖ : PseudoUniformizerRoots p (D.obj j₀))

/-! ### P5/completed-colimit-of-perfectoid-pairs -/

/-- The diagram of chosen integral subrings and their restricted transition maps. -/
def plusDiagram : J ⥤ CommRingCat.{u} where
  obj j := CommRingCat.of (D.obj j).pair.plus
  map f := CommRingCat.ofHom ((D.map f).toRingHom.restrict _ _ (D.map f).map_mem_plus)
  map_id := by sorry
  map_comp := by sorry

/-- Closure of the integral images inside the P1 completed Tate ring. -/
def completedColimitPlus : Subring (completedFilteredColimit p D j₀ ϖ) :=
  (Subring.closure (⋃ j, completedFilteredColimit.ι p D j₀ ϖ j ''
    ((D.obj j).pair.plus : Set (D.obj j)))).topologicalClosure

/-! ### P5/completed-colimit-is-perfectoid -/

/-- ECD Proposition 6.5, p. 29: the closure of the chosen integral images is
open, integrally closed in the completed ring, and contained in its power-bounded subring. -/
theorem completedColimitPlus_isRingOfIntegralElements :
    IsRingOfIntegralElements (completedColimitPlus p D j₀ ϖ) := sorry

/-- ECD Proposition 6.5, p. 29: the chosen completed plus ring is bounded. -/
theorem completedColimitPlus_isBounded :
    IsBounded (completedColimitPlus p D j₀ ϖ : Set (completedFilteredColimit p D j₀ ϖ)) := sorry

/-- The completed pair has the closure of the chosen integral images as its plus ring. -/
def completedColimitPair : PairCat.{u} p where
  carrier := completedFilteredColimit p D j₀ ϖ
  pair := ⟨completedColimitPlus p D j₀ ϖ,
    completedColimitPlus_isRingOfIntegralElements p D j₀ ϖ⟩

namespace completedColimit
/-- The canonical map on pairs has the P1 ring homomorphism as its underlying map. -/
def ι (j : J) : D.obj j ⟶ completedColimitPair p D j₀ ϖ where
  toRingHom := completedFilteredColimit.ι p D j₀ ϖ j
  continuous_toRingHom := completedFilteredColimit.continuous_ι p D j₀ ϖ j
  map_mem_plus := by sorry

theorem ι_comp {i j : J} (a : i ⟶ j) : D.map a ≫ ι p D j₀ ϖ j = ι p D j₀ ϖ i := by
  apply Pair.Hom.ext
  exact completedFilteredColimit.ι_naturality p D j₀ ϖ a

/-- Integral roots lie in every ring of integral elements. -/
def uniformizer : (D.obj j₀).pair.plus := ⟨ϖ.root 0, by sorry⟩

/-- Algebraic identification with the completion of the chosen integral colimit. -/
def plusCompletionEquiv :
    AdicCompletion (Ideal.span {colimit.ι (plusDiagram p D) j₀ (uniformizer p D j₀ ϖ)})
      (↥(colimit (plusDiagram p D))) ≃+* completedColimitPlus p D j₀ ϖ := sorry

theorem plusCompletionEquiv_ι (j : J) (x : (D.obj j).pair.plus) :
    (plusCompletionEquiv p D j₀ ϖ
      (AdicCompletion.of _ _ (colimit.ι (plusDiagram p D) j x))).val =
        (ι p D j₀ ϖ j).toRingHom x := sorry

/-- The topology is fixed by powers of the image of the chosen pseudouniformizer. -/
theorem hasBasis_nhds_zero :
    (𝓝 (0 : completedFilteredColimit p D j₀ ϖ)).HasBasis (fun n : ℕ ↦ 0 ≤ n)
      (fun n ↦ {x | ∃ y : completedColimitPlus p D j₀ ϖ,
        x = completedFilteredColimit.ι p D j₀ ϖ j₀ (ϖ.root 0) ^ n * y.val}) := sorry

/-- The pair universal property allows any complete Tate target with bounded plus ring. -/
def lift {S : Type u} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
    [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]
    (Q : Pair S) (hQ : IsBounded (Q.plus : Set S))
    (f : ∀ j, Pair.Hom (D.obj j).pair Q)
    (hf : ∀ {i j} (a : i ⟶ j), (f j).comp (D.map a) = f i) :
    Pair.Hom (completedColimitPair p D j₀ ϖ).pair Q := sorry

theorem lift_comp_ι {S : Type u} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
    [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]
    (Q : Pair S) (hQ : IsBounded (Q.plus : Set S))
    (f : ∀ j, Pair.Hom (D.obj j).pair Q)
    (hf : ∀ {i j} (a : i ⟶ j), (f j).comp (D.map a) = f i) (j : J) :
    (lift p D j₀ ϖ Q hQ f hf).comp (ι p D j₀ ϖ j) = f j := sorry

theorem hom_ext {S : Type u} [CommRing S] [TopologicalSpace S] [IsTopologicalRing S]
    [T2Space S] [IsHuberRing S] (Q : Pair S) (f g : Pair.Hom (completedColimitPair p D j₀ ϖ).pair Q)
    (h : ∀ j, f.comp (ι p D j₀ ϖ j) = g.comp (ι p D j₀ ϖ j)) : f = g := sorry

theorem denseRange_ι :
    Dense (⋃ j, Set.range (fun x : (D.obj j).pair.plus ↦
      (⟨(ι p D j₀ ϖ j).toRingHom x, (ι p D j₀ ϖ j).map_mem_plus x x.property⟩ :
        completedColimitPlus p D j₀ ϖ))) := sorry

/-! ### P5/limit-independence-of-tail-and-choice -/

/-- Final ring reindexing is initial space reindexing. Both source categories are filtered. -/
def equivOfInitial {J' : Type u} [SmallCategory J'] [IsFiltered J']
    (G : J' ⥤ J) [G.Final] (j₁ : J') (ψ : PseudoUniformizerRoots p (D.obj (G.obj j₁))) :
    completedColimitPair p (G ⋙ D) j₁ ψ ≅ completedColimitPair p D j₀ ϖ := sorry

theorem equivOfInitial_ι {J' : Type u} [SmallCategory J'] [IsFiltered J']
    (G : J' ⥤ J) [G.Final] (j₁ : J') (ψ : PseudoUniformizerRoots p (D.obj (G.obj j₁))) (j : J') :
    ι p (G ⋙ D) j₁ ψ j ≫ (equivOfInitial p D j₀ ϖ G j₁ ψ).hom =
      ι p D j₀ ϖ (G.obj j) := sorry

local instance : Fact (Cardinal.aleph.{u} 1).IsRegular := ⟨Cardinal.isRegular_aleph_one⟩
/-- ECD 6.5: the canonical integral completion map is already bijective. -/
theorem colimitEquiv_of_isCardinalFiltered [IsCardinalFiltered J (Cardinal.aleph.{u} 1)] :
    Function.Bijective
      (AdicCompletion.of (Ideal.span {colimit.ι (plusDiagram p D) j₀ (uniformizer p D j₀ ϖ)})
        (↥(colimit (plusDiagram p D)))) := sorry

