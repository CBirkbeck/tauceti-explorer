example (U V : TopologicalSpace.Opens (spa R.pair.plus)) (h : V ≤ U)
    (s t : rationalSections p R U) (W : {W : RationalOpen p R // W.val ⊆ V}) :
    ((rationalPresheaf p R).map (homOfLE h).op (s + t)).val W =
      s.val ⟨W.val, W.property.trans h⟩ + t.val ⟨W.val, W.property.trans h⟩ := rfl
