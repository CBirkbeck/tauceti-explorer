  [∀ j, TopologicalSpace (A j)] [∀ j, IsTopologicalRing (A j)] [∀ j, IsHuberRing (A j)]
  (P : ∀ j, Pair (A j)) (f : ∀ {i j : J}, (i ⟶ j) → Pair.Hom (P i) (P j))
  {R : Type*} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [IsHuberRing R]
  (Q : Pair R) (g : ∀ j, Pair.Hom (P j) Q)

/-- For a filtered
system of Huber pairs `(A_j, A_j⁺)` (the coordinate rings of a cofiltered system of affinoids
`X_j = Spa(A_j, A_j⁺)`) and a compatible cone `g_j : (A_j, A_j⁺) → (R, R⁺)`, the two clauses of
Scholze–Weinstein Definition 2.4.1 for `X = Spa(R, R⁺)` and the cover `U = X`: (a) the map
`|X| → lim_j |X_j|`, `x ↦ (g_j^* x)_j`, is a homeomorphism, i.e. an embedding into `∏_j |X_j|`
with image the compatible families; (b) `⋃_j im(A_j → R)` is dense in `R`. -/
structure IsTildeLimit_affinoid [IsFiltered J] : Prop where
  /-- Identity transition maps. -/
  map_id : ∀ j, (f (𝟙 j)).toRingHom = RingHom.id (A j)
  /-- Composition of transition maps. -/
  map_comp : ∀ {i j k : J} (a : i ⟶ j) (b : j ⟶ k),
    (f (a ≫ b)).toRingHom = (f b).toRingHom.comp (f a).toRingHom
  /-- The cone is compatible: `g_j ∘ f_a = g_i` for `a : i ⟶ j`. -/
  comm : ∀ {i j : J} (a : i ⟶ j), (g j).toRingHom.comp (f a).toRingHom = (g i).toRingHom
  /-- (a) `|X| → ∏_j |X_j|` is an embedding. -/
  isEmbedding : IsEmbedding fun (x : spa Q.plus) (j : J) ↦ (g j).spaComap x
  /-- (a) its image is `lim_j |X_j|`, the compatible families. -/
  range_eq : Set.range (fun (x : spa Q.plus) (j : J) ↦ (g j).spaComap x) =
    {y | ∀ (i j : J) (a : i ⟶ j), (f a).spaComap (y j) = y i}
  /-- (b) the union of the images of the `A_j` is dense in `R`. -/
  dense : Dense (⋃ j, Set.range (g j).toRingHom)

/-! ### P7/tilde-limit-from-completed-colimit -/

/-- `(R, R⁺)` with the cone `g_j` is
the *completed direct limit* of the filtered system `(A_j, A_j⁺)` in the Tate case of
Scholze–Weinstein Proposition 2.4.2: the rings of definition `A_{j,0}` are mapped into one
another, `ϖ ∈ R` is a pseudouniformiser coming from some `A_{j,0}`, the closure `R₀` of the subring
generated by the `g_j(A_{j,0})` is an open ring of definition of `R` with the `ϖ`-adic topology
(`R₀` is the `ϖ`-adic completion of `colim_j A_{j,0}`), `⋃_j g_j(A_j)` is dense in `R`, `R⁺`
is the closure of the integral closure of the subring generated by the `g_j(A_j⁺)`, and an
element of some `A_{j,0}` divisible by `ϖⁿ` in `R₀` is already divisible by `ϖⁿ` at a finite
stage, so that `R₀/ϖⁿ ≅ colim_j A_{j,0}/ϖⁿ`. Also used by
`FrobeniusTower.isCompletedDirectLimit`. -/
structure IsCompletedColimitOfTower [IsFiltered J] (A₀ : ∀ j, Subring (A j)) (ϖ : R) :
    Prop where
  /-- Identity transition maps. -/
  map_id : ∀ j, (f (𝟙 j)).toRingHom = RingHom.id (A j)
  /-- Composition of transition maps. -/
  map_comp : ∀ {i j k : J} (a : i ⟶ j) (b : j ⟶ k),
    (f (a ≫ b)).toRingHom = (f b).toRingHom.comp (f a).toRingHom
  /-- The cone is compatible. -/
  comm : ∀ {i j : J} (a : i ⟶ j), (g j).toRingHom.comp (f a).toRingHom = (g i).toRingHom
  /-- The target is Hausdorff. -/
  t2Space : T2Space R
  /-- The target is complete for its additive-group uniformity. -/
  completeSpace : @CompleteSpace R (IsTopologicalAddGroup.rightUniformSpace R)
  /-- Each specified subring really is a ring of definition. -/
  ringOfDefinition : ∀ j, ∃ D : PairOfDefinition (A j), D.ringOfDefinition = A₀ j
  /-- The rings of definition are mapped into one another. -/
  map_le : ∀ {i j : J} (a : i ⟶ j), (A₀ i).map (f a).toRingHom ≤ A₀ j
  /-- `ϖ` is a pseudouniformiser of `R`. -/
  isPseudoUniformizer : IsPseudoUniformizer ϖ
  /-- `ϖ` comes from a ring of definition at a finite level. -/
  exists_mem : ∃ j, ∃ x ∈ A₀ j, IsPseudoUniformizer x ∧ (g j).toRingHom x = ϖ
  /-- `R₀ = closure of ⟨⋃_j g_j(A_{j,0})⟩` is an open ring of definition with ideal `(ϖ)`. -/
  exists_pairOfDefinition : ∃ (D : PairOfDefinition R) (h : ϖ ∈ D.ringOfDefinition),
    D.ringOfDefinition = (Subring.closure (⋃ j, (g j).toRingHom '' (A₀ j))).topologicalClosure ∧
      D.idealOfDefinition = Ideal.span {⟨ϖ, h⟩}
  /-- `⋃_j g_j(A_j)` is dense in `R`. -/
  dense : Dense (⋃ j, Set.range (g j).toRingHom)
  /-- `R⁺` is the closure of the integral closure of `⟨⋃_j g_j(A_j⁺)⟩`. -/
  plus_eq : Q.plus = (integralClosure (Subring.closure (⋃ j, (g j).toRingHom '' (P j).plus))
    R).toSubring.topologicalClosure
  /-- Finite-stage divisibility (SW Proposition 2.4.2): an element of some `A₀ j` whose image in
  `R` is divisible by `ϖ ^ n` inside the ring of definition `R₀` is already divisible by `ϖ ^ n`
  (the image of `ϖ`) in `A₀ k` for some `k` under `j`; equivalently
  `colim_j A₀ j / ϖ ^ n → R₀ / ϖ ^ n` is injective (surjectivity is `dense`). -/
  exists_dvd_of_dvd : ∀ (n : ℕ) (j j₀ : J) (x : A₀ j) (w : A₀ j₀), (g j₀).toRingHom w = ϖ →
    (∃ y ∈ (Subring.closure (⋃ j, (g j).toRingHom '' (A₀ j))).topologicalClosure,
      (g j).toRingHom x = ϖ ^ n * y) →
    ∃ (k : J) (a : j ⟶ k) (b : j₀ ⟶ k), ∃ z ∈ A₀ k,
      (f a).toRingHom x = ((f b).toRingHom w) ^ n * z

end TildeLimitAffinoid

section TildeLimitTests

open Perfectoid

variable (p : ℕ) [Fact p.Prime]

-- tildeLimit_const: the affinoid predicate also applies to nonanalytic Huber pairs.
example {R : Type*} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
    [IsHuberRing R] (Q : Pair R) :
    IsTildeLimit_affinoid (J := Discrete PUnit) (fun _ ↦ Q) (fun _ ↦ Pair.Hom.id Q) Q
      fun _ ↦ Pair.Hom.id Q := sorry

-- isTildeLimit_test_not_categorical
example : ∃ (Q : Pair (DualNumber ℂ_[p])) (φ : Pair.Hom Q (Pair.powerBounded ℂ_[p])),
    (∀ x, x ∈ Q.plus ↔ TrivSqZeroExt.fst x ∈ powerBoundedSubring ℂ_[p]) ∧
      (∀ x, φ.toRingHom x = TrivSqZeroExt.fst x) ∧
      IsTildeLimit_affinoid (J := Discrete PUnit) (fun _ ↦ Q) (fun _ ↦ Pair.Hom.id Q)
        (Pair.powerBounded ℂ_[p]) (fun _ ↦ φ) ∧ ¬ Function.Injective φ.toRingHom := sorry

-- isTildeLimit_test_density_needed
example (φ : Pair.Hom (Pair.powerBounded ℚ_[p]) (Pair.powerBounded ℂ_[p])) :
    Function.Bijective φ.spaComap ∧
      ¬ IsTildeLimit_affinoid (J := Discrete PUnit) (fun _ ↦ Pair.powerBounded ℚ_[p])
        (fun _ ↦ Pair.Hom.id _) (Pair.powerBounded ℂ_[p]) fun _ ↦ φ := sorry

-- completedColimit_test_const
/- The constant system has completed colimit the pair itself, with `A₀ = R⁺` (open, bounded as
`R` is uniform, closed and integrally closed in `R`). -/
example {R : Type*} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
    [IsTateRing R] [CompleteSpace R] [T2Space R] [IsPerfectoidTateRing p R] (Q : Pair R)
    (ϖ : R) (hϖ : IsPseudoUniformizer ϖ) (hϖQ : ϖ ∈ Q.plus) :
    IsCompletedColimitOfTower (J := Discrete PUnit) (fun _ ↦ Q) (fun _ ↦ Pair.Hom.id Q) Q
      (fun _ ↦ Pair.Hom.id Q) (fun _ ↦ Q.plus) ϖ := sorry


-- tildeLimit_test_malformedDiagram: killing ε cannot be an identity transition.
example : ∃ (Q : Pair (DualNumber ℂ_[p])) (e : Pair.Hom Q Q),
    (∀ x, x ∈ Q.plus ↔ TrivSqZeroExt.fst x ∈ powerBoundedSubring ℂ_[p]) ∧
      (∀ x, e.toRingHom x = ⟨TrivSqZeroExt.fst x, 0⟩) ∧
      ¬ IsTildeLimit_affinoid (J := Discrete PUnit) (fun _ ↦ Q) (fun _ ↦ e) Q
        (fun _ ↦ Pair.Hom.id Q) := sorry

-- completedColimit_test_Qp: perfectoidness is not a completion hypothesis.
example : IsCompletedColimitOfTower (J := Discrete PUnit)
    (fun _ ↦ Pair.powerBounded ℚ_[p]) (fun _ ↦ Pair.Hom.id _) (Pair.powerBounded ℚ_[p])
    (fun _ ↦ Pair.Hom.id _) (fun _ ↦ powerBoundedSubring ℚ_[p]) (p : ℚ_[p]) := sorry

-- completedColimit_test_not_dense: equal point spaces do not determine the completion.
example (φ : Pair.Hom (Pair.powerBounded ℚ_[p]) (Pair.powerBounded ℂ_[p])) :
    ¬ IsCompletedColimitOfTower (J := Discrete PUnit)
      (fun _ ↦ Pair.powerBounded ℚ_[p]) (fun _ ↦ Pair.Hom.id _) (Pair.powerBounded ℂ_[p])
      (fun _ ↦ φ) (fun _ ↦ powerBoundedSubring ℚ_[p]) (p : ℂ_[p]) := sorry

-- completedColimit_test_zeroParameter: zero is not a pseudouniformiser of a nonzero field.
example : ¬ IsCompletedColimitOfTower (J := Discrete PUnit)
    (fun _ ↦ Pair.powerBounded ℚ_[p]) (fun _ ↦ Pair.Hom.id _) (Pair.powerBounded ℚ_[p])
    (fun _ ↦ Pair.Hom.id _) (fun _ ↦ powerBoundedSubring ℚ_[p]) (0 : ℚ_[p]) := sorry

-- tildeLimit_test_dualNumberTwoTerm: the tilde-limit reduction kills the nilpotent term.
example (a b : ℂ_[p]) :
    ∃ (Q : Pair (DualNumber ℂ_[p])) (φ : Pair.Hom Q (Pair.powerBounded ℂ_[p])),
      (∀ x, x ∈ Q.plus ↔ TrivSqZeroExt.fst x ∈ powerBoundedSubring ℂ_[p]) ∧
      (∀ x, φ.toRingHom x = TrivSqZeroExt.fst x) ∧
      IsTildeLimit_affinoid (J := Discrete PUnit) (fun _ ↦ Q) (fun _ ↦ Pair.Hom.id Q)
        (Pair.powerBounded ℂ_[p]) (fun _ ↦ φ) ∧
      (⟨a, b⟩ : DualNumber ℂ_[p]) ^ 2 = ⟨a ^ 2, 2 * a * b⟩ ∧
      φ.toRingHom ((⟨a, b⟩ : DualNumber ℂ_[p]) ^ 2) = a ^ 2 ∧
      φ.toRingHom (⟨0, 1⟩ : DualNumber ℂ_[p]) = 0 ∧
      (⟨0, 1⟩ : DualNumber ℂ_[p]) ≠ 0 := sorry

end TildeLimitTests

section LevelFamilies

variable {G : Type*} [Group G] [TopologicalSpace G]
  {J : Type*} [Category J] [IsCofiltered J]

/-! ### P7/level-cofinality-witness -/

/-- A cofiltered family of compact open subgroups; an arrow points toward the larger subgroup. -/
structure LevelFamily (J : Type*) [Category J] [IsCofiltered J]
    (G : Type*) [Group G] [TopologicalSpace G] where
  level : J → OpenSubgroup G
  compact : ∀ j, IsCompact (level j : Set G)
  map_le : ∀ {i j : J}, (i ⟶ j) → level i ≤ level j

/-- A choice of a level contained in each open subgroup. -/
structure CofinalityWitness (F : LevelFamily J G) where
  levelFor : OpenSubgroup G → J
  le : ∀ U, F.level (levelFor U) ≤ U

/-- A nonidentity element present at every level obstructs a cofinality witness as soon as
some open subgroup excludes it. -/
theorem CofinalityWitness.not_nonempty_of_common_element (F : LevelFamily J G)
    (x : G) (hx : ∀ j, x ∈ F.level j) (U : OpenSubgroup G) (hU : x ∉ U) :
    ¬ Nonempty (CofinalityWitness F) := by
  rintro ⟨w⟩
  exact hU (w.le U (hx (w.levelFor U)))

end LevelFamilies

-- cofinalityWitness_test_discrete: the trivial subgroup is cofinal, even in a nontrivial group.
example : ∃ F : LevelFamily (Discrete PUnit) (Multiplicative (ZMod 2)),
    (∀ j, (F.level j).toSubgroup = ⊥) ∧ Nonempty (CofinalityWitness F) := sorry

-- cofinalityWitness_test_trivialGroup: the whole subgroup of the trivial group is cofinal.
example : ∃ F : LevelFamily (Discrete PUnit) (Multiplicative (ZMod 1)),
    (∀ j, (F.level j).toSubgroup = ⊤) ∧ Nonempty (CofinalityWitness F) := sorry

-- cofinalityWitness_test_twoLevels: an arrow goes from {1} to the whole group.
example : ∃ F : LevelFamily (Fin 2) (Multiplicative (ZMod 2)),
    (F.level 0).toSubgroup = ⊥ ∧ (F.level 1).toSubgroup = ⊤ ∧
      Nonempty (CofinalityWitness F) := sorry

-- cofinalityWitness_test_finiteConst_not: compactness alone does not imply cofinality.
example : ∃ F : LevelFamily (Discrete PUnit) (Multiplicative (ZMod 2)),
    (∀ j, (F.level j).toSubgroup = ⊤) ∧ ¬ Nonempty (CofinalityWitness F) := sorry

end PerfectoidSpace

namespace Perfectoid

/-! ### P7/frobenius-controlled-integral-tower -/

/-- Integral models, with their common regular adic parameter. -/
structure IntegralTower (p : ℕ) where
  ring : ℕ → Type
  [commRing : ∀ n, CommRing (ring n)]
  transition : ∀ n, ring n →+* ring (n + 1)
  parameter : ∀ n, ring n
  parameter_map : ∀ n, transition n (parameter n) = parameter (n + 1)
  regular : ∀ n, parameter n ∈ nonZeroDivisors (ring n)
  complete : ∀ n, IsAdicComplete (Ideal.span {parameter n}) (ring n)
  divides : ∀ n, parameter n ^ p ∣ (p : ring n)

attribute [instance] IntegralTower.commRing

namespace IntegralTower
variable {p : ℕ} (T : IntegralTower p)

abbrev quotient (n k : ℕ) := T.ring n ⧸ Ideal.span {T.parameter n ^ k}

def quotientMap (n k : ℕ) : T.quotient n k →+* T.quotient (n + 1) k :=
  Ideal.quotientMap _ (T.transition n) (by
    refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
    change T.transition n (T.parameter n ^ k) ∈ Ideal.span {T.parameter (n+1) ^ k}
    rw [map_pow, T.parameter_map]
    exact Ideal.subset_span (Set.mem_singleton _))

@[simp] theorem quotientMap_mk (n k : ℕ) (x : T.ring n) :
    T.quotientMap n k (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (T.transition n x) := by
  simp [quotientMap]

/-- The direct system obtained by iterating the consecutive ring maps. -/
def diagram : ℕ ⥤ CommRingCat where
  obj n := CommRingCat.of (T.ring n)
  map f := CommRingCat.ofHom (Nat.leRecOn (leOfHom f) (fun {n} g ↦ (T.transition n).comp g) (RingHom.id _))
  map_id := by sorry
  map_comp := by sorry

@[simp] theorem diagram_step (n : ℕ) :
    (T.diagram.map (homOfLE (Nat.le_succ n))).hom = T.transition n := sorry

abbrev colimitRing := colimit T.diagram
abbrev toColimit (n : ℕ) : T.ring n →+* T.colimitRing := (colimit.ι T.diagram n).hom
abbrev colimitParameter : T.colimitRing := T.toColimit 0 (T.parameter 0)

abbrev completedPlus := AdicCompletion (Ideal.span {T.colimitParameter}) T.colimitRing
abbrev toCompleted (n : ℕ) : T.ring n →+* T.completedPlus :=
  (algebraMap T.colimitRing T.completedPlus).comp (T.toColimit n)
abbrev completedParameter : T.completedPlus := T.toCompleted 0 (T.parameter 0)
abbrev completed := Localization.Away T.completedParameter

/-- The Tate topology has the images of the parameter powers as a basis at zero. -/
instance completedTopology : TopologicalSpace T.completed := sorry
instance completedTopologicalRing : IsTopologicalRing T.completed := sorry
instance completedUniformSpace : UniformSpace T.completed :=
  IsTopologicalAddGroup.rightUniformSpace T.completed
instance completedUniformAddGroup : IsUniformAddGroup T.completed := sorry
instance completedComplete : CompleteSpace T.completed := sorry
instance completedT2 : T2Space T.completed := sorry
instance completedTate : IsTateRing T.completed := sorry

theorem completed_nhds_zero : (𝓝 (0 : T.completed)).HasBasis (fun n : ℕ ↦ 0 ≤ n)
    (fun n ↦ (algebraMap T.completedPlus T.completed) ''
      ((Ideal.span {T.completedParameter} ^ n : Ideal T.completedPlus) : Set T.completedPlus)) := sorry

def completedPair : Pair T.completed where
  plus := (integralClosure T.completedPlus T.completed).toSubring
  isRingOfIntegralElements := by sorry

theorem toCompleted_parameter (n : ℕ) :
    T.toCompleted n (T.parameter n) = T.completedParameter := sorry

theorem toCompleted_transition (n : ℕ) :
    (T.toCompleted (n + 1)).comp (T.transition n) = T.toCompleted n := sorry

theorem completedPlus_torsionFree :
    T.completedParameter ∈ nonZeroDivisors T.completedPlus := sorry

/-- Reduction of the completion is reduction of the algebraic colimit, with the canonical map. -/
def completedPlus_quotient (k : ℕ) (hk : 0 < k) :
    T.completedPlus ⧸ Ideal.span {T.completedParameter ^ k} ≃+*
      T.colimitRing ⧸ Ideal.span {T.colimitParameter ^ k} := sorry

theorem completedPlus_quotient_mk (k : ℕ) (hk : 0 < k) (n : ℕ) (x : T.ring n) :
    T.completedPlus_quotient k hk (Ideal.Quotient.mk _ (T.toCompleted n x)) =
      Ideal.Quotient.mk _ (T.toColimit n x) := sorry

/-- Parameter-preserving compatible maps uniquely extend to the separated adic completion.
Such maps are continuous for the principal adic topologies. -/
theorem completedPlus_lift (B : Type*) [CommRing B] (b : B)
    [IsAdicComplete (Ideal.span {b}) B] (f : ∀ n, T.ring n →+* B)
    (hf : ∀ n, (f (n + 1)).comp (T.transition n) = f n)
    (hb : ∀ n, f n (T.parameter n) = b) :
    ∃! g : T.completedPlus →+* B, ∀ n, g.comp (T.toCompleted n) = f n := sorry

end IntegralTower

/-- Eventual quotient Frobenius lifts, with both squares of P7.5 recorded. -/
structure FrobeniusTower (p : ℕ) [Fact p.Prime] extends IntegralTower p where
  start : ℕ
  lift : ∀ n, start ≤ n → toIntegralTower.quotient (n + 1) 1 ≃+*
    toIntegralTower.quotient n p
  transition_comp_lift : ∀ n (hn : start ≤ n) (x : ring (n + 1)),
    toIntegralTower.quotientMap n p (lift n hn (Ideal.Quotient.mk _ x)) =
      Ideal.Quotient.mk _ (x ^ p)
  lift_comp_transition : ∀ n (hn : start ≤ n) (x : ring (n + 1)),
    lift (n + 1) (Nat.le_trans hn (Nat.le_succ n))
      (Ideal.Quotient.mk _ (transition (n + 1) x)) =
      toIntegralTower.quotientMap n p (lift n hn (Ideal.Quotient.mk _ x))

namespace FrobeniusTower
variable {p : ℕ} [Fact p.Prime]

/-! ### P7/frobenius-tower-completion -/

abbrev completedPlus (T : FrobeniusTower p) := T.toIntegralTower.completedPlus
abbrev completed (T : FrobeniusTower p) := T.toIntegralTower.completed
abbrev completedPair (T : FrobeniusTower p) := T.toIntegralTower.completedPair
abbrev toCompleted (T : FrobeniusTower p) := T.toIntegralTower.toCompleted

theorem completed_isTateRing (T : FrobeniusTower p) :
    IsTateRing T.completed ∧ CompleteSpace T.completed ∧ T2Space T.completed := sorry


def frobMod (T : FrobeniusTower p) (n : ℕ) :
    T.ring n ⧸ Ideal.span {T.parameter n} →+*
      T.ring n ⧸ Ideal.span {T.parameter n ^ p} :=
  frobeniusModPow p (T.parameter n) (T.divides n)

/-- Morphisms preserve the parameter and transitions; quotient lift compatibility is explicit. -/
structure Hom (T U : FrobeniusTower p) where
  map : ∀ n, T.ring n →+* U.ring n
  parameter_map : ∀ n, map n (T.parameter n) = U.parameter n
  comm : ∀ n, (map (n + 1)).comp (T.transition n) = (U.transition n).comp (map n)
  start : ℕ
  lift_comm : ∀ n (_hn : start ≤ n) (hT : T.start ≤ n) (hU : U.start ≤ n) (x : T.ring (n + 1)),
    (Ideal.quotientMap _ (map n) (by
      refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
      change map n (T.parameter n ^ p) ∈ Ideal.span {U.parameter n ^ p}
      rw [map_pow, parameter_map]
      exact Ideal.subset_span (Set.mem_singleton _)))
      (T.lift n hT (Ideal.Quotient.mk _ x)) =
        U.lift n hU (Ideal.Quotient.mk _ (map (n + 1) x))

def Hom.id (T : FrobeniusTower p) : Hom T T where
  map _ := RingHom.id _
  start := 0
  parameter_map _ := rfl
  comm _ := rfl
  lift_comm := by sorry

def Hom.comp {T U V : FrobeniusTower p} (g : Hom U V) (f : Hom T U) : Hom T V where
  map n := (g.map n).comp (f.map n)
  start := max U.start (max f.start g.start)
  parameter_map := by sorry
  comm := by sorry
  lift_comm := by sorry

/-- Shifts use the old stages `n+k`, and retain the marked parameter. -/
def shift (T : FrobeniusTower p) (k : ℕ) : FrobeniusTower p :=
  { ring := fun n ↦ T.ring (n + k)
    transition := fun n ↦ by
      have e : n + 1 + k = (n + k) + 1 := by omega
      exact e.symm ▸ T.transition (n + k)
    parameter := fun n ↦ T.parameter (n + k)
    parameter_map := by sorry
    regular := fun n ↦ T.regular (n + k)
    complete := fun n ↦ T.complete (n + k)
    divides := fun n ↦ T.divides (n + k)
    start := T.start - k
    lift := by sorry
    transition_comp_lift := by sorry
    lift_comp_transition := by sorry }

/-- The constant integral-perfectoid tower; the quotient isomorphism is Frobenius. -/
def constPerfectoid (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] : FrobeniusTower p :=
  { ring := fun _ ↦ S
    commRing := fun _ ↦ inferInstance
    transition := fun _ ↦ RingHom.id S
    parameter := fun _ ↦ π
    parameter_map := fun _ ↦ rfl
    regular := fun _ ↦ hπ
    complete := fun _ ↦ inferInstance
    divides := fun _ ↦ hp
    start := 0
    lift := by sorry
    transition_comp_lift := by sorry
    lift_comp_transition := by sorry }

instance constPerfectoid_algebra (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] (n : ℕ) :
    Algebra S ((constPerfectoid S π hπ hp).ring n) := inferInstanceAs (Algebra S S)

/-- The constant construction recovers the input ring, compatibly with every stage map. -/
def constCompletedEquiv (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] :
    (constPerfectoid S π hπ hp).completedPlus ≃+* S := sorry

theorem constCompletedEquiv_map (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] (n : ℕ) (x : S) :
    constCompletedEquiv S π hπ hp ((constPerfectoid S π hπ hp).toCompleted n x) = x := sorry

/-- The quotient Frobenius on the completed integral model is bijective. -/
theorem completed_frobenius_bijective (T : FrobeniusTower p) :
    ∃ hp : T.toIntegralTower.completedParameter ^ p ∣ (p : T.completedPlus),
      Function.Bijective (frobeniusModPow p T.toIntegralTower.completedParameter hp) := sorry

theorem completed_isPerfectoid (T : FrobeniusTower p) :
    IsPerfectoidTateRing p T.completed := sorry

def completed_map {T U : FrobeniusTower p} (f : Hom T U) :
    T.completedPlus →+* U.completedPlus := sorry

theorem completed_map_stage {T U : FrobeniusTower p} (f : Hom T U) (n : ℕ) (x : T.ring n) :
    completed_map f (T.toCompleted n x) = U.toCompleted n (f.map n x) := sorry

def completed_shift (T : FrobeniusTower p) (k : ℕ) : (T.shift k).completedPlus ≃+* T.completedPlus := sorry

theorem completed_shift_stage (T : FrobeniusTower p) (k n : ℕ) (x : T.ring (n + k)) :
    T.completed_shift k ((T.shift k).toCompleted n x) = T.toCompleted (n + k) x := sorry

-- Check frobeniusTower_test_constPerfectoid: the constant transition fixes 1+pi and quotient Frobenius is bijective.
example (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] :
    (constPerfectoid S π hπ hp).transition 0 (show S from 1 + π) = (show S from 1 + π) ∧
      Function.Bijective ((constPerfectoid S π hπ hp).frobMod 0) := sorry

-- Check frobeniusTower_test_zero: the zero ring is permitted, and every quotient is zero.
example (T : FrobeniusTower p) (h : ∀ n, Subsingleton (T.ring n)) (n k : ℕ) :
    Subsingleton (T.toIntegralTower.quotient n k) := by
  let _ := h n
  infer_instance

-- Check frobeniusTower_test_zeroParameter_not: regularity rejects zero on a nonzero stage.
example (T : FrobeniusTower p) (n : ℕ) [Nontrivial (T.ring n)] : T.parameter n ≠ 0 := by
  exact nonZeroDivisors.ne_zero (T.regular n)

-- Check frobeniusTower_completion_test_const: the canonical completion map is invertible.
example (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] :
    Function.Bijective ((constPerfectoid S π hπ hp).toCompleted 0) := sorry

-- Check frobeniusTower_completion_test_zero: completion and localization of zero remain zero.
example (T : FrobeniusTower p) (h : ∀ n, Subsingleton (T.ring n)) :
    Subsingleton T.completedPlus ∧ Subsingleton T.completed := sorry

-- Check frobeniusTower_completion_test_quotient: powers 1 and 2 preserve the marked parameter.
example (T : FrobeniusTower p) (n : ℕ) :
    T.toIntegralTower.completedPlus_quotient 2 (by decide)
      (Ideal.Quotient.mk _ (T.toCompleted n (T.parameter n))) =
        Ideal.Quotient.mk _ T.toIntegralTower.colimitParameter := sorry

end FrobeniusTower
end Perfectoid
open TauCetiRoadmap.AdicEtaleGeometry
open Perfectoid

namespace AdicSpace
open YonedaAdicSpace

/-- The affinoid point identification is chosen compatibly with every map of pairs. -/
def affinoidPoints (R : CAff) : space.obj (ofSpaY R) ≃ₜ ULift.{1} (spa R.P.plus) := sorry

theorem affinoidPoints_naturality {R S : CAff} (f : R ⟶ S)
    (x : space.obj (ofSpaY S)) :
    affinoidPoints R (space.map (ObjectProperty.homMk (spaYFunctor.map f.op)) x) =
      ULift.up ((show Pair.Hom R.P S.P from f).spaComap ((affinoidPoints S x).down)) := sorry

/-- Honest spaces are locally spectra of sheafy complete affinoid pairs. -/
def IsHonest (X : YonedaAdicSpace) : Prop :=
  ∀ x : space.obj X, ∃ (R : CAff) (u : ofSpaY R ⟶ X),
    YonedaAdicSpace.IsOpenImmersion u.hom ∧ CAff.Sheafy R ∧
      x ∈ Set.range (space.map u)

-- Check: IsHonest_empty
example (X : YonedaAdicSpace) [IsEmpty (space.obj X)] : IsHonest X := by
  intro x
  exact isEmptyElim x

-- Check: IsHonest_sheafy_affinoid
example (R : CAff) (hR : CAff.Sheafy R) : IsHonest (ofSpaY R) := sorry

-- Check: IsHonest_perfectoid
example (p : ℕ) [Fact p.Prime] (X : PerfectoidSpace.Perfd p) : IsHonest X.obj := sorry

/-- Quasicompact and quasiseparated is tested over affinoid open charts of the target. -/
def Qcqs {X Y : YonedaAdicSpace} (f : X ⟶ Y) : Prop :=
  ∀ (R : CAff) (v : ofSpaY R ⟶ Y), YonedaAdicSpace.IsOpenImmersion v.hom →
    IsCompact (space.map f ⁻¹' Set.range (space.map v)) ∧
      QuasiSeparatedSpace (space.map f ⁻¹' Set.range (space.map v))

variable {I : Type} [Category I] [IsCofiltered I]

/-- The image of finite-level affinoid functions in the coordinate ring of an open chart. -/
def chartImage (D : I ⥤ YonedaAdicSpace) (c : Cone D) (R : CAff)
    (u : ofSpaY R ⟶ c.pt) : Set R.A :=
  {r | ∃ (i : I) (B : CAff) (v : ofSpaY B ⟶ D.obj i) (f : B ⟶ R),
    YonedaAdicSpace.IsOpenImmersion v.hom ∧
      (ObjectProperty.homMk (spaYFunctor.map f.op) : ofSpaY R ⟶ ofSpaY B) ≫ v =
        u ≫ c.π.app i ∧ r ∈ Set.range (CAff.toRingHom f)}

/-! ### P7/yoneda-tilde-limit-dense-charts -/

/-- The density condition on a covering by affinoid charts (SW13 Definition 2.4.1). -/
def HasDenseCharts (D : I ⥤ YonedaAdicSpace) (c : Cone D) : Prop :=
  ∀ x : space.obj c.pt, ∃ (R : CAff) (u : ofSpaY R ⟶ c.pt),
    YonedaAdicSpace.IsOpenImmersion u.hom ∧ x ∈ Set.range (space.map u) ∧ Dense (chartImage D c R u)

/-! ### P7/tilde-limit-of-analytic-adic-spaces -/

/-- The analytic, honest Yoneda form of PartIV R5's intrinsic tilde-limit relation.
It additionally records qcqs transitions; `IsTildeLimit.ofAdicSpace_iff` compares
the two predicates under these extra hypotheses. -/
structure IsTildeLimit (D : I ⥤ YonedaAdicSpace) (c : Cone D) : Prop where
  analytic : YonedaAdicSpace.IsAnalytic c.pt
  honest : IsHonest c.pt
  levels_honest : ∀ i, IsHonest (D.obj i)
  levels_analytic : ∀ i, YonedaAdicSpace.IsAnalytic (D.obj i)
  transitions_qcqs : ∀ {i j} (a : i ⟶ j), Qcqs (D.map a)
  isEmbedding : Topology.IsEmbedding (fun x : space.obj c.pt ↦ fun i ↦ space.map (c.π.app i) x)
  range_eq : Set.range (fun x : space.obj c.pt ↦ fun i ↦ space.map (c.π.app i) x) =
    {y | ∀ (i j : I) (a : i ⟶ j), space.map (D.map a) (y i) = y j}
  dense_image : HasDenseCharts D c

/-- Transport of the intrinsic tilde-limit relation along the fully faithful
adic-space embedding. Analyticity and qcqs transitions are additional hypotheses
of the Yoneda form, not conditions on PartIV's predicate.
SW13 Definition 2.4.1, pp. 19–20; PartIV R5.8. -/
theorem IsTildeLimit.ofAdicSpace_iff {J : Type} [SmallCategory J] [IsCofiltered J]
    (D : J ⥤ TauCeti.AdicSpace.{0}) (c : Cone D)
    (hc : YonedaAdicSpace.IsAnalytic (ofAdicSpace.obj c.pt))
    (ha : ∀ j, YonedaAdicSpace.IsAnalytic (ofAdicSpace.obj (D.obj j)))
    (hq : ∀ {i j} (a : i ⟶ j), Qcqs (ofAdicSpace.map (D.map a))) :
    IsTildeLimit (D ⋙ ofAdicSpace) (ofAdicSpace.mapCone c) ↔
      TauCetiRoadmap.AdicSpacesPartIV.AdicSpace.IsTildeLimit D c := sorry

-- Check IsTildeLimit_ofAdicSpace_constant: an analytic identity cone agrees on both carriers.
example (X : TauCeti.AdicSpace.{0})
    (hX : YonedaAdicSpace.IsAnalytic (ofAdicSpace.obj X)) :
    IsTildeLimit (((Functor.const (Discrete PUnit)).obj X) ⋙ ofAdicSpace)
      (ofAdicSpace.mapCone { pt := X, π := 𝟙 _ }) := sorry

-- Check IsTildeLimit_ofAdicSpace_empty: empty honest levels and apex give the same empty limit.
example {J : Type} [SmallCategory J] [IsCofiltered J]
    (D : J ⥤ TauCeti.AdicSpace.{0}) (c : Cone D)
    [IsEmpty c.pt.obj] (hD : ∀ j, IsEmpty (D.obj j).obj) :
    IsTildeLimit (D ⋙ ofAdicSpace) (ofAdicSpace.mapCone c) := sorry

-- Check IsTildeLimit_ofAdicSpace_nonanalytic: the analytic hypothesis cannot be dropped.
example (X : TauCeti.AdicSpace.{0})
    (hX : ¬ YonedaAdicSpace.IsAnalytic (ofAdicSpace.obj X)) :
    TauCetiRoadmap.AdicSpacesPartIV.AdicSpace.IsTildeLimit
      ((Functor.const (Discrete PUnit)).obj X) { pt := X, π := 𝟙 _ } ∧
    ¬ IsTildeLimit (((Functor.const (Discrete PUnit)).obj X) ⋙ ofAdicSpace)
      (ofAdicSpace.mapCone { pt := X, π := 𝟙 _ }) := sorry

/-- The homeomorphism from the cone point to the inverse limit is induced by the cone maps. -/
def IsTildeLimit.homeomorph {D : I ⥤ YonedaAdicSpace} {c : Cone D} (h : IsTildeLimit D c) :
    space.obj c.pt ≃ₜ {y : ∀ i, space.obj (D.obj i) |
      ∀ (i j : I) (a : i ⟶ j), space.map (D.map a) (y i) = y j} := sorry

theorem IsTildeLimit.homeomorph_apply {D : I ⥤ YonedaAdicSpace} {c : Cone D}
    (h : IsTildeLimit D c) (x : space.obj c.pt) (i : I) :
    (h.homeomorph x).val i = space.map (c.π.app i) x := sorry

/-- A single morphism as a cone over a one-object system. -/
def singletonCone {X Y : YonedaAdicSpace} (f : X ⟶ Y) :
    Cone ((Functor.const (Discrete PUnit)).obj Y) where
  pt := X
  π := { app := fun _ ↦ f, naturality := by sorry }

theorem IsTildeLimit.const (X : YonedaAdicSpace) (hX : YonedaAdicSpace.IsAnalytic X) (hh : IsHonest X) :
    IsTildeLimit _ (singletonCone (𝟙 X)) := sorry

theorem IsTildeLimit.ofIso {D : I ⥤ YonedaAdicSpace} {c d : Cone D}
    (h : IsTildeLimit D c) (e : c ≅ d) : IsTildeLimit D d := sorry

theorem IsTildeLimit.reindex {J : Type} [Category J] [IsCofiltered J]
    (u : J ⥤ I) [u.Initial] (D : I ⥤ YonedaAdicSpace) (c : Cone D)
    (ha : ∀ i, YonedaAdicSpace.IsAnalytic (D.obj i)) (hh : ∀ i, IsHonest (D.obj i))
    (hq : ∀ {i j} (a : i ⟶ j), Qcqs (D.map a)) :
    IsTildeLimit (u ⋙ D) (c.whisker u) ↔ IsTildeLimit D c := sorry

-- Check tildeLimit_const: the global constant cone, including nonaffinoid spaces.
example (X : YonedaAdicSpace) (hX : YonedaAdicSpace.IsAnalytic X) (hh : IsHonest X) :
    IsTildeLimit _ (singletonCone (𝟙 X)) := IsTildeLimit.const X hX hh

-- Check tildeLimit_empty: an empty constant system has an empty limit.
example (R : CAff) [Subsingleton R.A] :
    IsTildeLimit _ (singletonCone (𝟙 (ofSpaY R))) := sorry

-- Check tildeLimit_density_needed_global: the one-point topology does not force density.
example (p : ℕ) [Fact p.Prime]
    (f : CAff.of (Pair.powerBounded ℚ_[p]) ⟶ CAff.of (Pair.powerBounded ℂ_[p])) :
    ¬ IsTildeLimit _ (singletonCone
      (ObjectProperty.homMk (spaYFunctor.map f.op) :
        ofSpaY (CAff.of (Pair.powerBounded ℂ_[p])) ⟶
          ofSpaY (CAff.of (Pair.powerBounded ℚ_[p])))) := sorry

end AdicSpace

namespace PerfectoidSpace
open YonedaAdicSpace
variable (p : ℕ) [Fact p.Prime]
variable {I : Type} [Category I] [IsCofiltered I]

/-! ### P7/perfectoid-tilde-limit -/

/-- The perfectoid version uses exactly the analytic predicate, with perfectoid source. -/
def IsTildeLimit (D : I ⥤ YonedaAdicSpace) (c : Cone D) : Prop :=
  IsPerfectoidSpace p c.pt ∧ AdicSpace.IsTildeLimit D c

section AffinoidComparison

variable {J : Type} [SmallCategory J] [IsFiltered J]

/-- The Tate, sheafy affinoid corollary of PartIV R5's completed-affinoid
criterion (SW13 Proposition 2.4.2, p. 20). Restrict to the cofinal tail under a
stage carrying `ϖ`, and use one generator, the image of `ϖ`, at every stage.
The plus-ring hypothesis is exactly the supplier's `hplus`. -/
theorem IsCompletedColimitOfTower.isTildeLimit_affinoid
    (B : J ⥤ CAff) (b : Cocone B)
    (hB : ∀ j, CAff.Sheafy (B.obj j)) (hb : CAff.Sheafy b.pt)
    (B₀ : ∀ j, Subring (B.obj j).A) (ϖ : b.pt.A)
    (h : IsCompletedColimitOfTower (fun j ↦ (B.obj j).P)
      (fun a ↦ B.map a) b.pt.P (fun j ↦ b.ι.app j) B₀ ϖ) :
    IsTildeLimit_affinoid (fun j ↦ (B.obj j).P)
      (fun a ↦ B.map a) b.pt.P (fun j ↦ b.ι.app j) := by
  classical
  obtain ⟨j₀, w, hw, hwϖ, hwmap⟩ := h.exists_mem
  let C : (Under j₀)ᵒᵖ → CAff := fun i ↦ B.obj i.unop.right
  let t : ∀ i : (Under j₀)ᵒᵖ, (C i).A := fun i ↦ (B.map i.unop.hom).toRingHom w
  have ht : ∀ i, t i ∈ B₀ i.unop.right := by sorry
  let D₀ : ∀ i : (Under j₀)ᵒᵖ, PairOfDefinition (C i).A := fun i ↦
    { ringOfDefinition := B₀ i.unop.right
      isOpen_ringOfDefinition := by sorry
      idealOfDefinition := Ideal.span {⟨t i, ht i⟩}
      fg_idealOfDefinition := by sorry
      isAdic_idealOfDefinition := by sorry }
  obtain ⟨E₀, hϖ, hE₀, hEideal⟩ := h.exists_pairOfDefinition
  let F : (Under j₀)ᵒᵖ ⥤ TauCeti.AdicSpace.{0} :=
    { obj := fun i ↦ (C i).adicSpa (hB i.unop.right)
      map := fun {i j} a ↦ CAff.spaHom (B.map a.unop.right)
        (hB j.unop.right) (hB i.unop.right)
      map_id := by sorry
      map_comp := by sorry }
  let c : Cone F :=
    { pt := b.pt.adicSpa hb
      π := { app := fun i ↦ CAff.spaHom (b.ι.app i.unop.right) (hB i.unop.right) hb
             naturality := by sorry } }
  have hc : TauCetiRoadmap.AdicSpacesPartIV.AdicSpace.IsTildeLimit F c := by
    apply TauCetiRoadmap.AdicSpacesPartIV.AdicSpace.IsTildeLimit.completedAffinoid
      F c b.pt hb (Iso.refl _) C (fun i ↦ hB i.unop.right) (fun _ ↦ Iso.refl _)
      (fun i ↦ b.ι.app i.unop.right) (fun a ↦ B.map a.unop.right)
      (D := D₀) (E := E₀) (m := 1)
      (t := fun i _ ↦ ⟨t i, ht i⟩) (v := fun _ ↦ ⟨ϖ, hϖ⟩)
    all_goals sorry
  -- Transport the supplier's point comparison from the cofinal tail; density is already h.dense.
  refine ⟨h.map_id, h.map_comp, h.comm, ?_, ?_, h.dense⟩
  · sorry
  · sorry

/-- The single-affinoid topology and density conditions give the analytic Yoneda
form of the affinoid criterion supplied by AdicSpacesPartIV R5
(`AdicSpace.IsTildeLimit.affinoid`); SW13 Definition 2.4.1, pp. 19–20.
The diagram and cone are induced by the given complete pairs and their maps. -/
theorem IsTildeLimit_affinoid.isTildeLimit
    (B : J ⥤ CAff) (b : Cocone B) [IsTateRing b.pt.A]
    (hB : ∀ j, CAff.Sheafy (B.obj j)) (ha : ∀ j, IsTateRing (B.obj j).A)
    (hb : CAff.Sheafy b.pt)
    (h : IsTildeLimit_affinoid (fun j ↦ (B.obj j).P)
      (fun a ↦ B.map a) b.pt.P (fun j ↦ b.ι.app j)) :
    let S := ObjectProperty.lift IsYonedaAdic spaYFunctor (fun A ↦ isYonedaAdic_spaY A.unop)
    AdicSpace.IsTildeLimit (B.op ⋙ S) (S.mapCone b.op) := sorry

/-- A perfectoid completed colimit is a perfectoid tilde-limit of the given
complete sheafy Tate pairs. This specializes the completed-affinoid criterion
of AdicSpacesPartIV R5 to the Yoneda carrier; SW13 Proposition 2.4.2, p. 20. -/
theorem IsCompletedColimitOfTower.isTildeLimit
    (B : J ⥤ CAff) (b : Cocone B) [IsTateRing b.pt.A]
    [IsPerfectoidTateRing p b.pt.A]
    (hB : ∀ j, CAff.Sheafy (B.obj j)) (ha : ∀ j, IsTateRing (B.obj j).A)
    (B₀ : ∀ j, Subring (B.obj j).A) (ϖ : b.pt.A)
    (h : IsCompletedColimitOfTower (fun j ↦ (B.obj j).P)
      (fun a ↦ B.map a) b.pt.P (fun j ↦ b.ι.app j) B₀ ϖ) :
    let S := ObjectProperty.lift IsYonedaAdic spaYFunctor (fun A ↦ isYonedaAdic_spaY A.unop)
    IsTildeLimit p (B.op ⋙ S) (S.mapCone b.op) := by
  have hb : CAff.Sheafy b.pt := by sorry
  exact ⟨by sorry, IsTildeLimit_affinoid.isTildeLimit B b hB ha hb
    (IsCompletedColimitOfTower.isTildeLimit_affinoid B b hB hb B₀ ϖ h)⟩

-- Check isTildeLimit_affinoid: the same ring maps supply the global cone.
example (B : J ⥤ CAff) (b : Cocone B) [IsTateRing b.pt.A]
    (hB : ∀ j, CAff.Sheafy (B.obj j)) (ha : ∀ j, IsTateRing (B.obj j).A)
    (hb : CAff.Sheafy b.pt)
    (h : IsTildeLimit_affinoid (fun j ↦ (B.obj j).P)
      (fun a ↦ B.map a) b.pt.P (fun j ↦ b.ι.app j)) :
    let S := ObjectProperty.lift IsYonedaAdic spaYFunctor (fun A ↦ isYonedaAdic_spaY A.unop)
    AdicSpace.IsTildeLimit (B.op ⋙ S) (S.mapCone b.op) :=
  IsTildeLimit_affinoid.isTildeLimit B b hB ha hb h

-- Check completedColimit_perfectoid: perfectoidness upgrades the completed cone.
example (B : J ⥤ CAff) (b : Cocone B) [IsTateRing b.pt.A]
    [IsPerfectoidTateRing p b.pt.A]
    (hB : ∀ j, CAff.Sheafy (B.obj j)) (ha : ∀ j, IsTateRing (B.obj j).A)
    (B₀ : ∀ j, Subring (B.obj j).A) (ϖ : b.pt.A)
    (h : IsCompletedColimitOfTower (fun j ↦ (B.obj j).P)
      (fun a ↦ B.map a) b.pt.P (fun j ↦ b.ι.app j) B₀ ϖ) :
    let S := ObjectProperty.lift IsYonedaAdic spaYFunctor (fun A ↦ isYonedaAdic_spaY A.unop)
    IsTildeLimit p (B.op ⋙ S) (S.mapCone b.op) :=
  IsCompletedColimitOfTower.isTildeLimit p B b hB ha B₀ ϖ h

-- Check isTildeLimit_affinoid_Qp: the analytic bridge does not require perfectoidness.
example : AdicSpace.IsTildeLimit _
    (AdicSpace.singletonCone (𝟙 (ofSpaY (CAff.of (Pair.powerBounded ℚ_[p]))))) := sorry

end AffinoidComparison

/-! ### P7/tilde-limit-perfectoid-uniqueness -/

/-- Compatible maps from a perfectoid test space factor uniquely (SW13 2.4.5). -/
theorem IsTildeLimit.lift {D : I ⥤ YonedaAdicSpace} {c : Cone D}
    (h : IsTildeLimit p D c) (Y : Perfd p) (d : Cone D) (hY : d.pt = Y.obj) :
    ∃! g : d.pt ⟶ c.pt, ∀ i, g ≫ c.π.app i = d.π.app i := sorry

/-- Uniform affinoid charts suffice for the completion argument in SW13 2.4.5,
pp. 20–21; the source need not be perfectoid. -/
theorem IsTildeLimit.lift_uniform {D : I ⥤ YonedaAdicSpace} {c : Cone D}
    (h : IsTildeLimit p D c) (d : Cone D)
    (hY : AdicSpace.IsHonest d.pt) (ha : YonedaAdicSpace.IsAnalytic d.pt)
    (hbasis : TopologicalSpace.IsTopologicalBasis
      {U : Set (space.obj d.pt) | ∃ (B : CAff) (u : ofSpaY B ⟶ d.pt),
        CAff.Sheafy B ∧ IsTateRing B.A ∧ IsUniform B.A ∧
        YonedaAdicSpace.IsOpenImmersion u.hom ∧ Set.range (space.map u) = U}) :
    ∃! g : d.pt ⟶ c.pt, ∀ i, g ≫ c.π.app i = d.π.app i := sorry

theorem IsTildeLimit.uniqueIso {D : I ⥤ YonedaAdicSpace} (c d : Cone D)
    (hc : IsTildeLimit p D c) (hd : IsTildeLimit p D d) :
    ∃! e : c.pt ≅ d.pt, ∀ i, e.hom ≫ d.π.app i = c.π.app i := sorry

-- Check isTildeLimit_test_const: identity on a global perfectoid space.
example (X : Perfd p) : IsTildeLimit p _ (AdicSpace.singletonCone (𝟙 X.obj)) := sorry

-- Check isTildeLimit_test_density_needed: this tests the global perfectoid predicate.
example (f : CAff.of (Pair.powerBounded ℚ_[p]) ⟶ CAff.of (Pair.powerBounded ℂ_[p])) :
    ¬ IsTildeLimit p _ (AdicSpace.singletonCone
      (ObjectProperty.homMk (spaYFunctor.map f.op) :
        ofSpaY (CAff.of (Pair.powerBounded ℂ_[p])) ⟶
          ofSpaY (CAff.of (Pair.powerBounded ℚ_[p])))) := sorry

-- Check isTildeLimit_test_empty: the empty perfectoid affinoid is its own tilde-limit.
example (R : Perfectoid.PairCat.{0} p) [Subsingleton R] :
    IsTildeLimit p _ (AdicSpace.singletonCone (𝟙 (ofPair p R).obj)) := sorry

/-! ### P7/good-affinoid-perfectoid -/

/-- A good chart includes a finite-level quasicompact open and the pullback equality.
Density is tested using sections of all later inverse images of that open. -/
structure GoodAffinoid (D : I ⥤ YonedaAdicSpace) (c : Cone D) where
  ring : Perfectoid.PairCat.{0} p
  chart : (ofPair p ring).obj ⟶ c.pt
  open_chart : YonedaAdicSpace.IsOpenImmersion chart.hom
  level : I
  finiteOpen : YonedaAdicSpace
  inclusion : finiteOpen ⟶ D.obj level
  open_inclusion : YonedaAdicSpace.IsOpenImmersion inclusion.hom
  compact : CompactSpace (space.obj finiteOpen)
  preimage_eq : Set.range (space.map chart) =
    space.map (c.π.app level) ⁻¹' Set.range (space.map inclusion)
  denseRange : Dense {r : ring | ∃ (j : I) (a : j ⟶ level)
    (V : YonedaAdicSpace) (v : V ⟶ D.obj j) (u : (ofPair p ring).obj ⟶ V),
    YonedaAdicSpace.IsOpenImmersion v.hom ∧
      Set.range (space.map v) = space.map (D.map a) ⁻¹' Set.range (space.map inclusion) ∧
      u ≫ v = chart ≫ c.π.app j ∧
      ∃ e : CAff.affineLine ⟶ CAff.of ring.pair,
        CAff.toRingHom e (show CAff.AffineLineRing from Polynomial.X) = r ∧
        spaYFunctor.map e.op ∈ Set.range (fun s : globalFunctions V ↦ u.hom ≫ s)}

/-! ### P7/good-affinoid-perfectoid-basis -/

/-- Good charts cover a perfectoid tilde-limit, and this cover detects density. -/
theorem IsTildeLimit.iff_goodCover (D : I ⥤ YonedaAdicSpace) (c : Cone D)
    (hp : IsPerfectoidSpace p c.pt) (ha : ∀ i, YonedaAdicSpace.IsAnalytic (D.obj i))
    (hh : ∀ i, AdicSpace.IsHonest (D.obj i))
    (hq : ∀ {i j} (a : i ⟶ j), AdicSpace.Qcqs (D.map a))
    (ht : Topology.IsEmbedding (fun x : space.obj c.pt ↦ fun i ↦ space.map (c.π.app i) x))
    (hr : Set.range (fun x : space.obj c.pt ↦ fun i ↦ space.map (c.π.app i) x) =
      {y | ∀ (i j : I) (a : i ⟶ j), space.map (D.map a) (y i) = y j}) :
    IsTildeLimit p D c ↔ ∀ x : space.obj c.pt,
      ∃ W : GoodAffinoid p D c, x ∈ Set.range (space.map W.chart) := sorry

-- Check goodAffinoid_test_const: the whole constant affinoid is good at the sole level.
example (R : Perfectoid.PairCat.{0} p) :
    ∃ W : GoodAffinoid p _ (AdicSpace.singletonCone (𝟙 (ofPair p R).obj)),
      W.ring = R ∧ Set.range (space.map W.chart) = Set.univ := sorry

-- Check goodAffinoid_test_empty: the empty chart is allowed even in a nonempty system.
example (D : I ⥤ YonedaAdicSpace) (c : Cone D) (i : I) :
    ∃ W : GoodAffinoid p D c, W.level = i ∧ IsEmpty (space.obj W.finiteOpen) ∧
      Subsingleton W.ring := sorry

-- Check goodAffinoid_test_not_dense: no whole-space good chart exists over constant Q_p.
example (f : CAff.of (Pair.powerBounded ℚ_[p]) ⟶ CAff.of (Pair.powerBounded ℂ_[p])) :
    ¬ ∃ W : GoodAffinoid p _ (AdicSpace.singletonCone
      (ObjectProperty.homMk (spaYFunctor.map f.op) :
        ofSpaY (CAff.of (Pair.powerBounded ℂ_[p])) ⟶
          ofSpaY (CAff.of (Pair.powerBounded ℚ_[p])))),
        Set.range (space.map W.chart) = Set.univ := sorry

end PerfectoidSpace

namespace AdicSpace
open YonedaAdicSpace

/-- Locally noetherian analytic spaces have an open cover by strongly noetherian Tate pairs. -/
def IsLocallyNoetherianAnalytic (X : YonedaAdicSpace) : Prop :=
  ∀ x : space.obj X, ∃ (R : CAff) (u : ofSpaY R ⟶ X),
    YonedaAdicSpace.IsOpenImmersion u.hom ∧ IsTateRing R.A ∧ IsStronglyNoetherian R.A ∧
      x ∈ Set.range (space.map u)

/-- An open immersion identifies the completed residue fields at corresponding points. -/
def residueRestriction {R C : CAff} (g : R ⟶ C) (x : spa R.P.plus) (y : spa C.P.plus)
    (ho : YonedaAdicSpace.IsOpenImmersion (spaYFunctor.map g.op))
    (hy : (show Pair.Hom R.P C.P from g).spaComap y = x) :
    CompletedResidue R x ≃+* CompletedResidue C y := sorry

theorem residueRestriction_map {R C : CAff} (g : R ⟶ C) (x : spa R.P.plus) (y : spa C.P.plus)
    (ho : YonedaAdicSpace.IsOpenImmersion (spaYFunctor.map g.op))
    (hy : (show Pair.Hom R.P C.P from g).spaComap y = x) (a : R.A) :
    residueRestriction g x y ho hy (residueMap R x a) =
      residueMap C y (CAff.toRingHom g a) := sorry

theorem residueRestriction_continuous {R C : CAff} (g : R ⟶ C) (x : spa R.P.plus) (y : spa C.P.plus)
    (ho : YonedaAdicSpace.IsOpenImmersion (spaYFunctor.map g.op))
    (hy : (show Pair.Hom R.P C.P from g).spaComap y = x) :
    Continuous (residueRestriction g x y ho hy) ∧
      Continuous (residueRestriction g x y ho hy).symm := sorry

/-- Finite-level fractions are evaluated after shrinking the source chart around the point.
The canonical open-immersion residue comparison places them in the fixed completed field. -/
def residueImage {I : Type} [Category I] (D : I ⥤ YonedaAdicSpace) (c : Cone D)
    (R : CAff) (u : ofSpaY R ⟶ c.pt) (x : spa R.P.plus) : Set (CompletedResidue R x) :=
  {z | ∃ (C : CAff) (g : R ⟶ C) (y : spa C.P.plus)
    (ho : YonedaAdicSpace.IsOpenImmersion (spaYFunctor.map g.op))
    (hy : (show Pair.Hom R.P C.P from g).spaComap y = x)
    (i : I) (B : CAff) (v : ofSpaY B ⟶ D.obj i) (f : B ⟶ C) (a b : B.A),
    YonedaAdicSpace.IsOpenImmersion v.hom ∧
      (ObjectProperty.homMk (spaYFunctor.map f.op) : ofSpaY C ⟶ ofSpaY B) ≫ v =
        (ObjectProperty.homMk (spaYFunctor.map g.op) : ofSpaY C ⟶ ofSpaY R) ≫ u ≫ c.π.app i ∧
      residueMap C y (CAff.toRingHom f b) ≠ 0 ∧
      z = (residueRestriction g x y ho hy).symm
        (residueMap C y (CAff.toRingHom f a) / residueMap C y (CAff.toRingHom f b))}

end AdicSpace

namespace PerfectoidSpace
open YonedaAdicSpace
variable (p : ℕ) [Fact p.Prime]
variable {I : Type} [Category I] [IsCofiltered I]

/-! ### P7/residue-field-tilde-limit -/

/-- Scholze's pointwise density condition, expressed on affinoid neighbourhoods using
valued residue fields. Numerators and denominators come from a common finite stage. -/
structure IsResidueFieldTildeLimit (D : I ⥤ YonedaAdicSpace) (c : Cone D) : Prop where
  perfectoid : IsPerfectoidSpace p c.pt
  noetherian : ∀ i, AdicSpace.IsLocallyNoetherianAnalytic (D.obj i)
  compact : ∀ i, CompactSpace (space.obj (D.obj i))
  quasiSeparated : ∀ i, QuasiSeparatedSpace (space.obj (D.obj i))
  isEmbedding : Topology.IsEmbedding (fun x : space.obj c.pt ↦ fun i ↦ space.map (c.π.app i) x)
  range_eq : Set.range (fun x : space.obj c.pt ↦ fun i ↦ space.map (c.π.app i) x) =
    {y | ∀ (i j : I) (a : i ⟶ j), space.map (D.map a) (y i) = y j}
  residueField_dense : ∀ y : space.obj c.pt,
    ∃ (R : CAff) (u : ofSpaY R ⟶ c.pt) (x : spa R.P.plus),
      YonedaAdicSpace.IsOpenImmersion u.hom ∧
      space.map u ((AdicSpace.affinoidPoints R).symm (ULift.up x)) = y ∧
      Dense (AdicSpace.residueImage D c R u x)

/-! ### P7/tilde-limit-implies-residue-field-tilde-limit -/

theorem IsResidueFieldTildeLimit.of_isTildeLimit (D : I ⥤ YonedaAdicSpace) (c : Cone D)
    (h : IsTildeLimit p D c)
    (hn : ∀ i, AdicSpace.IsLocallyNoetherianAnalytic (D.obj i))
    (hc : ∀ i, CompactSpace (space.obj (D.obj i)))
    (hs : ∀ i, QuasiSeparatedSpace (space.obj (D.obj i))) :
    IsResidueFieldTildeLimit p D c := sorry

theorem IsResidueFieldTildeLimit.spectralSpace {D : I ⥤ YonedaAdicSpace} {c : Cone D}
    (h : IsResidueFieldTildeLimit p D c) : SpectralSpace (space.obj c.pt) := sorry

-- Check isResidueFieldTildeLimit_test_point: the constant perfectoid field has dense residue map.
example (K : AffinoidField p) :
    IsResidueFieldTildeLimit p _ (AdicSpace.singletonCone (𝟙 (ofPair p (K.toPairCat p)).obj)) := sorry

-- Check isResidueFieldTildeLimit_test_empty: there are no residue conditions on the empty limit.
example (R : Perfectoid.PairCat.{0} p) [Subsingleton R] :
    IsResidueFieldTildeLimit p _ (AdicSpace.singletonCone (𝟙 (ofPair p R).obj)) := sorry

-- Check isResidueFieldTildeLimit_test_not_dense: a closed proper field extension is rejected.
example (f : CAff.of (Pair.powerBounded ℚ_[p]) ⟶ CAff.of (Pair.powerBounded ℂ_[p])) :
    ¬ IsResidueFieldTildeLimit p _ (AdicSpace.singletonCone
      (ObjectProperty.homMk (spaYFunctor.map f.op) :
        ofSpaY (CAff.of (Pair.powerBounded ℂ_[p])) ⟶
          ofSpaY (CAff.of (Pair.powerBounded ℚ_[p])))) := sorry

-- Check isResidueFieldTildeLimit_test_of_tildeLimit: section density implies residue density.
example (D : I ⥤ YonedaAdicSpace) (c : Cone D) (h : IsTildeLimit p D c)
    (hn : ∀ i, AdicSpace.IsLocallyNoetherianAnalytic (D.obj i))
    (hc : ∀ i, CompactSpace (space.obj (D.obj i)))
    (hs : ∀ i, QuasiSeparatedSpace (space.obj (D.obj i))) :
    IsResidueFieldTildeLimit p D c := IsResidueFieldTildeLimit.of_isTildeLimit p D c h hn hc hs

end PerfectoidSpace

namespace PerfectoidSpace
open YonedaAdicSpace

/-- The strong integral completion uses the principal-adic topology on the entire plus ring. -/
abbrev strongPlus (R : CAff) (π : R.P.plus) := AdicCompletion (Ideal.span {π}) R.P.plus
abbrev strongParameter (R : CAff) (π : R.P.plus) : strongPlus R π := algebraMap _ _ π
def strongRing (R : CAff) (π : R.P.plus) (_hπ : IsPseudoUniformizer (π : R.A)) := Localization.Away (strongParameter R π)
instance (R : CAff) (π : R.P.plus) (hπ : IsPseudoUniformizer (π : R.A)) : CommRing (strongRing R π hπ) :=
  inferInstanceAs (CommRing (Localization.Away (strongParameter R π)))
instance (R : CAff) (π : R.P.plus) (hπ : IsPseudoUniformizer (π : R.A)) : Algebra (strongPlus R π) (strongRing R π hπ) :=
  inferInstanceAs (Algebra (strongPlus R π) (Localization.Away (strongParameter R π)))

variable (R : CAff) (π : R.P.plus) (hπ : IsPseudoUniformizer (π : R.A))

instance strongTopology : TopologicalSpace (strongRing R π hπ) := sorry
instance strongTopologicalRing : IsTopologicalRing (strongRing R π hπ) := sorry
instance strongUniformSpace : UniformSpace (strongRing R π hπ) :=
  IsTopologicalAddGroup.rightUniformSpace (strongRing R π hπ)
instance strongUniformAddGroup : IsUniformAddGroup (strongRing R π hπ) := sorry
instance strongTate : IsTateRing (strongRing R π hπ) := sorry
instance strongComplete : CompleteSpace (strongRing R π hπ) := sorry
instance strongT2 : T2Space (strongRing R π hπ) := sorry

/-- The defining topology is fixed by the images of the parameter powers. -/
theorem strong_nhds_zero : (𝓝 (0 : strongRing R π hπ)).HasBasis (fun n : ℕ ↦ 0 ≤ n)
    (fun n ↦ (algebraMap (strongPlus R π) (strongRing R π hπ)) ''
      ((Ideal.span {strongParameter R π} ^ n : Ideal (strongPlus R π)) : Set (strongPlus R π))) := sorry

/-! ### P7/preperfectoid-space -/

/-- The integral ring embeds in its localization; its image is the completed plus ring. -/
def strongCompletionPair : Pair (strongRing R π hπ) where
  plus := (algebraMap (strongPlus R π) (strongRing R π hπ)).range
  isRingOfIntegralElements := by sorry

/-- The canonical map is fixed on every element of the original plus ring. -/
def strongCompletionPair.toCompletion (hπ : IsPseudoUniformizer (π : R.A)) : Pair.Hom R.P (strongCompletionPair R π hπ) := sorry

theorem strongCompletionPair.toCompletion_plus (a : R.P.plus) :
    (strongCompletionPair.toCompletion R π hπ).toRingHom a =
      algebraMap (strongPlus R π) (strongRing R π hπ) (algebraMap R.P.plus (strongPlus R π) a) := sorry

theorem strongCompletionPair_indep (ρ : R.P.plus) (hρ : IsPseudoUniformizer (ρ : R.A)) :
    ∃ e : strongRing R π hπ ≃+* strongRing R ρ hρ,
      Continuous e ∧ Continuous e.symm ∧
      e '' (strongCompletionPair R π hπ).plus = (strongCompletionPair R ρ hρ).plus ∧
      ∀ a : R.A, e ((strongCompletionPair.toCompletion R π hπ).toRingHom a) =
        (strongCompletionPair.toCompletion R ρ hρ).toRingHom a := sorry

variable (p : ℕ) [Fact p.Prime]

/-- Preperfectoid means locally perfectoid after the strong completion of an affinoid pair. -/
def IsPreperfectoid (X : YonedaAdicSpace) : Prop :=
  YonedaAdicSpace.IsAnalytic X ∧ ∀ x : space.obj X,
    ∃ (R : CAff) (u : ofSpaY R ⟶ X) (π : R.P.plus),
      YonedaAdicSpace.IsOpenImmersion u.hom ∧ x ∈ Set.range (space.map u) ∧
      ∃ hπ : IsPseudoUniformizer (π : R.A), Perfectoid.IsPerfectoidTateRing p (strongRing R π hπ)

-- Check: isPreperfectoid_test_overField
example (K : AffinoidField p) [CharZero K] (X : YonedaAdicSpace)
    (f : X ⟶ ofSpaY (CAff.of (Pair.powerBounded K))) :
    IsPreperfectoid p X ↔
      YonedaAdicSpace.IsAnalytic X ∧ ∀ x : space.obj X,
        ∃ (A : CAff) (u : ofSpaY A ⟶ X),
          YonedaAdicSpace.IsOpenImmersion u.hom ∧ x ∈ Set.range (space.map u) ∧
          ∃ hpA : IsPseudoUniformizer ((p : A.P.plus) : A.A),
            IsPerfectoidTateRing p (strongRing A (p : A.P.plus) hpA) ∧
            ∃ (ϖ : A.P.plus) (hϖ : IsPseudoUniformizer (ϖ : A.A)),
              ϖ ^ p ∣ (p : A.P.plus) ∧ (∃ N : ℕ, (p : A.P.plus) ∣ ϖ ^ N) ∧
              (Ideal.span {ϖ}).adicTopology =
                (Ideal.span {(p : A.P.plus)}).adicTopology := sorry

theorem IsPreperfectoid.of_isPerfectoid (X : YonedaAdicSpace)
    (h : IsPerfectoidSpace p X) : IsPreperfectoid p X := sorry

theorem IsPreperfectoid.openSubspace {X Y : YonedaAdicSpace} (f : Y ⟶ X)
    (hf : YonedaAdicSpace.IsOpenImmersion f.hom) (hX : IsPreperfectoid p X) :
    IsPreperfectoid p Y := sorry

/-! ### P7/strong-completion -/

/-- Gluing the strongly completed affinoids gives a perfectoid space. -/
def strongCompletion (X : YonedaAdicSpace) (hX : IsPreperfectoid p X) : Perfd p := sorry

def strongCompletion.ι (X : YonedaAdicSpace) (hX : IsPreperfectoid p X) :
    (strongCompletion p X hX).obj ⟶ X := sorry

def strongCompletion.homeomorph (X : YonedaAdicSpace) (hX : IsPreperfectoid p X) :
    space.obj (strongCompletion p X hX).obj ≃ₜ space.obj X := sorry

theorem strongCompletion.homeomorph_apply (X : YonedaAdicSpace) (hX : IsPreperfectoid p X)
    (x : space.obj (strongCompletion p X hX).obj) :
    strongCompletion.homeomorph p X hX x = space.map (strongCompletion.ι p X hX) x := sorry

theorem strongCompletion.lift (X : YonedaAdicSpace) (hX : IsPreperfectoid p X)
    (Y : Perfd p) (f : Y.obj ⟶ X) :
    ∃! g : Y.obj ⟶ (strongCompletion p X hX).obj, g ≫ strongCompletion.ι p X hX = f := sorry

def strongCompletion.map {X Y : YonedaAdicSpace} (hX : IsPreperfectoid p X)
    (hY : IsPreperfectoid p Y) (f : X ⟶ Y) :
    strongCompletion p X hX ⟶ strongCompletion p Y hY := sorry

theorem strongCompletion.map_ι {X Y : YonedaAdicSpace} (hX : IsPreperfectoid p X)
    (hY : IsPreperfectoid p Y) (f : X ⟶ Y) :
    (strongCompletion.map p hX hY f).hom ≫ strongCompletion.ι p Y hY =
      strongCompletion.ι p X hX ≫ f := sorry

theorem strongCompletion.map_id (X : YonedaAdicSpace) (hX : IsPreperfectoid p X) :
    strongCompletion.map p hX hX (𝟙 X) = 𝟙 _ := sorry

theorem strongCompletion.map_comp {X Y Z : YonedaAdicSpace}
    (hX : IsPreperfectoid p X) (hY : IsPreperfectoid p Y) (hZ : IsPreperfectoid p Z)
    (f : X ⟶ Y) (g : Y ⟶ Z) :
    strongCompletion.map p hX hZ (f ≫ g) =
      strongCompletion.map p hX hY f ≫ strongCompletion.map p hY hZ g := sorry

theorem strongCompletion.of_perfectoid (X : Perfd p) (hX : IsPreperfectoid p X.obj) :
    IsIso (strongCompletion.ι p X.obj hX) := sorry

/-- On an affinoid with perfectoid strong completion, gluing is the ring construction. -/
def strongCompletion.affinoid (hπ : IsPseudoUniformizer (π : R.A))
    (h : Perfectoid.IsPerfectoidTateRing p (strongRing R π hπ)) (hX : IsPreperfectoid p (ofSpaY R)) :
    (strongCompletion p (ofSpaY R) hX).obj ≅ ofSpaY (CAff.of (strongCompletionPair R π hπ)) := sorry

theorem strongCompletion.affinoid_ι
    (h : Perfectoid.IsPerfectoidTateRing p (strongRing R π hπ)) (hX : IsPreperfectoid p (ofSpaY R)) :
    (strongCompletion.affinoid (R := R) (π := π) (p := p) hπ h hX).hom ≫
      (ObjectProperty.homMk (spaYFunctor.map
        (show R ⟶ CAff.of (strongCompletionPair R π hπ) from
          strongCompletionPair.toCompletion R π hπ).op) :
          ofSpaY (CAff.of (strongCompletionPair R π hπ)) ⟶ ofSpaY R) =
      strongCompletion.ι p (ofSpaY R) hX := sorry

-- Check strongCompletionPair_test_perfectoid: the canonical map recovers a complete perfectoid pair.
example (A : Perfectoid.PairCat.{0} p) (t : A.pair.plus)
    (ht : IsPseudoUniformizer (t : A)) :
    Function.Bijective (strongCompletionPair.toCompletion (CAff.of A.pair) t ht).toRingHom := sorry

-- Check strongCompletionPair_test_zero: the empty affinoid still has the zero strong completion.
example [Subsingleton R.A] : Subsingleton (strongPlus R π) ∧ Subsingleton (strongRing R π hπ) := sorry

-- Check strongCompletionPair_test_nonreducedPoint: completion kills precisely the epsilon direction.
example (Q : Pair (DualNumber ℂ_[p]))
    (hQ : ∀ x, x ∈ Q.plus ↔ TrivSqZeroExt.fst x ∈ powerBoundedSubring ℂ_[p])
    (t : Q.plus) (ht : IsPseudoUniformizer (t : DualNumber ℂ_[p])) :
    ∃ e : strongRing (CAff.of Q) t ht ≃+* ℂ_[p],
      ∀ a b : ℂ_[p], e ((strongCompletionPair.toCompletion (CAff.of Q) t ht).toRingHom ⟨a,b⟩) = a := sorry

-- Check isPreperfectoid_test_perfectoid: any global perfectoid space qualifies.
example (X : Perfd p) : IsPreperfectoid p X.obj := IsPreperfectoid.of_isPerfectoid p X.obj X.property

-- Check isPreperfectoid_test_empty: the empty affinoid satisfies the cover condition.
example [Subsingleton R.A] : IsPreperfectoid p (ofSpaY R) := sorry

-- Check isPreperfectoid_test_nonreducedPoint: the nonreduced point has perfectoid strong completion.
example (Q : Pair (DualNumber ℂ_[p]))
    (hQ : ∀ x, x ∈ Q.plus ↔ TrivSqZeroExt.fst x ∈ powerBoundedSubring ℂ_[p]) :
    IsPreperfectoid p (ofSpaY (CAff.of Q)) := sorry

-- Check strongCompletion_test_perfectoid: the global canonical map is an isomorphism.
example (X : Perfd p) (hX : IsPreperfectoid p X.obj) :
    IsIso (strongCompletion.ι p X.obj hX) := strongCompletion.of_perfectoid p X hX

-- Check strongCompletion_test_empty: no points are created by strong completion.
example (X : YonedaAdicSpace) (hX : IsPreperfectoid p X) [IsEmpty (space.obj X)] :
    IsEmpty (space.obj (strongCompletion p X hX).obj) := sorry

-- Check strongCompletion_test_not_iso: nilpotents survive before completion, so the map is not iso.
example (Q : Pair (DualNumber ℂ_[p]))
    (hQ : ∀ x, x ∈ Q.plus ↔ TrivSqZeroExt.fst x ∈ powerBoundedSubring ℂ_[p])
    (hX : IsPreperfectoid p (ofSpaY (CAff.of Q))) :
    ¬ IsIso (strongCompletion.ι p (ofSpaY (CAff.of Q)) hX) := sorry

end PerfectoidSpace

namespace RegularTower

/-! ### P7/regular-cohen-presentations -/

/-- An unramified Cohen coefficient ring, with the residue identification recorded. -/
structure CohenDVR (p : ℕ) (k : Type) [Field k] where
  ring : Type
  [commRing : CommRing ring]
  [domain : IsDomain ring]
  [dvr : IsDiscreteValuationRing ring]
  [charZero : CharZero ring]
  maximal : IsLocalRing.maximalIdeal ring = Ideal.span {(p : ring)}
  complete : IsAdicComplete (IsLocalRing.maximalIdeal ring) ring
  residue : IsLocalRing.ResidueField ring ≃+* k

attribute [instance] CohenDVR.commRing CohenDVR.domain CohenDVR.dvr CohenDVR.charZero

variable (p : ℕ) [Fact p.Prime]

/-- The three regular Cohen presentations used in Cesnavicius, Lemma 5.1, pp. 11–12. -/
theorem cohen_equalCharacteristic (R : Type) [CommRing R] [IsRegularLocalRing R]
    [IsAdicComplete (IsLocalRing.maximalIdeal R) R]
    (q : ℕ) [CharP R q] [CharP (IsLocalRing.ResidueField R) q] :
    ∃ n : ℕ, Nonempty (R ≃+* MvPowerSeries (Fin n) (IsLocalRing.ResidueField R)) := sorry

theorem cohen_unramified (R : Type) [CommRing R] [IsRegularLocalRing R] [CharZero R]
    [CharP (IsLocalRing.ResidueField R) p] [IsAdicComplete (IsLocalRing.maximalIdeal R) R]
    (hp : (p : R) ∉ IsLocalRing.maximalIdeal R ^ 2) :
    ∃ (W : CohenDVR p (IsLocalRing.ResidueField R)) (n : ℕ),
      Nonempty (R ≃+* MvPowerSeries (Fin n) W.ring) := sorry

theorem cohen_ramified (R : Type) [CommRing R] [IsRegularLocalRing R] [CharZero R]
    [CharP (IsLocalRing.ResidueField R) p] [IsAdicComplete (IsLocalRing.maximalIdeal R) R]
    (hp : (p : R) ∈ IsLocalRing.maximalIdeal R ^ 2) :
    ∃ (W : CohenDVR p (IsLocalRing.ResidueField R)) (n : ℕ)
      (f : MvPowerSeries (Fin n) W.ring),
      f ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) W.ring) ^ 2 ∧
      Nonempty (R ≃+* (MvPowerSeries (Fin n) W.ring ⧸ Ideal.span {(p : MvPowerSeries (Fin n) W.ring) - f})) := sorry

/-- Stacks 032C supplies the regular power series rings in both coefficient cases. -/
theorem powerSeries_regular_field (k : Type) [Field k] (n : ℕ) :
    IsRegularLocalRing (MvPowerSeries (Fin n) k) := sorry

theorem powerSeries_regular_cohen (k : Type) [Field k] (W : CohenDVR p k) (n : ℕ) :
    IsRegularLocalRing (MvPowerSeries (Fin n) W.ring) := sorry

/-- Since p-f is a member of a regular system of parameters, its quotient is regular. -/
theorem ramified_quotient_regular (k : Type) [Field k] (W : CohenDVR p k) (n : ℕ)
    (f : MvPowerSeries (Fin n) W.ring)
    (hf : f ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) W.ring) ^ 2) :
    IsRegularLocalRing (MvPowerSeries (Fin n) W.ring ⧸
      Ideal.span {(p : MvPowerSeries (Fin n) W.ring) - f}) := sorry

/-- The regular local domains used in the tower are integrally closed. -/
theorem regular_normal (R : Type) [CommRing R] [IsDomain R] [IsRegularLocalRing R] :
    IsIntegrallyClosed R := sorry

/-- Finite flatness survives coefficient extension of the formal power series presentation. -/
theorem powerSeries_finite_flat (k l : Type) [Field k] [Field l]
    (W : CohenDVR p k) (V : CohenDVR p l)
    (f : W.ring →+* V.ring) [IsLocalHom f]
    (hfin : letI := f.toAlgebra; Module.Finite W.ring V.ring)
    (hflat : letI := f.toAlgebra; Module.Flat W.ring V.ring) (n : ℕ) :
    letI := (MvPowerSeries.map (σ := Fin n) f).toAlgebra
    Module.Finite (MvPowerSeries (Fin n) W.ring) (MvPowerSeries (Fin n) V.ring) ∧
      Module.Flat (MvPowerSeries (Fin n) W.ring) (MvPowerSeries (Fin n) V.ring) := sorry

/-! ### P7/regular-finite-flat-residue-tower -/

/-- The complete regular local inputs admit the finite flat residue-extension system of Ces 5.1. -/
theorem exists_residueTower (R : Type) [CommRing R] [IsRegularLocalRing R]
    [IsAdicComplete (IsLocalRing.maximalIdeal R) R] :
    ∃ (J : Type) (_ : SmallCategory J) (_ : IsFiltered J) (D : J ⥤ CommRingCat)
      (ι : (Functor.const J).obj (CommRingCat.of R) ⟶ D),
      (∀ j, letI : Algebra R (D.obj j) := (ι.app j).hom.toAlgebra
        Module.Finite R (D.obj j) ∧ Module.Flat R (D.obj j) ∧
        IsRegularLocalRing (D.obj j) ∧
        ∃ h : IsLocalRing (D.obj j),
          (IsLocalRing.maximalIdeal R).map (ι.app j).hom = @IsLocalRing.maximalIdeal _ _ h) ∧
      ∃ h : IsRegularLocalRing ↑(colimit D : CommRingCat),
        letI := h
        IsAlgClosed (IsLocalRing.ResidueField ↑(colimit D : CommRingCat)) ∧
          ∀ j, (IsLocalRing.maximalIdeal R).map
            ((colimit.ι D j).hom.comp (ι.app j).hom) =
              IsLocalRing.maximalIdeal ↑(colimit D : CommRingCat) := sorry

/-! ### P7/regular-finite-flat-perfectoid-tower -/

/-- For a perfect residue field the p-adic completion of a finite flat regular tower is perfectoid. -/
theorem exists_perfectoidTower (R : Type) [CommRing R] [IsRegularLocalRing R] [CharZero R]
    [CharP (IsLocalRing.ResidueField R) p] [PerfectRing (IsLocalRing.ResidueField R) p]
    [IsAdicComplete (IsLocalRing.maximalIdeal R) R] :
    ∃ (D : ℕ ⥤ CommRingCat) (ι : (Functor.const ℕ).obj (CommRingCat.of R) ⟶ D),
      (∀ n, letI : Algebra R (D.obj n) := (ι.app n).hom.toAlgebra
        Module.Finite R (D.obj n) ∧ Module.Flat R (D.obj n) ∧ IsRegularLocalRing (D.obj n) ∧
        ∃ e : ℕ, Module.finrank R (D.obj n) = p ^ e) ∧
      IsIntegralPerfectoid p (AdicCompletion (Ideal.span {(p : ↑(colimit D : CommRingCat))}) ↑(colimit D : CommRingCat)) := sorry

-- Check cohen_test_equalChar_zeroVariables: every chosen Cohen presentation of a field has no variables.
example (k : Type) [Field k]
    [IsAdicComplete (IsLocalRing.maximalIdeal k) k]
    (q : ℕ) [CharP k q] [CharP (IsLocalRing.ResidueField k) q] :
    let h := cohen_equalCharacteristic k q
    Classical.choose h = 0 ∧
      Nonempty (k ≃+* MvPowerSeries (Fin 0) (IsLocalRing.ResidueField k)) := sorry

-- Check cohen_test_ramified_two: p-X^2 gives a regular local quotient, including p=2.
example (k : Type) [Field k] (W : CohenDVR p k) :
    IsRegularLocalRing (MvPowerSeries (Fin 1) W.ring ⧸
      Ideal.span {(p : MvPowerSeries (Fin 1) W.ring) - MvPowerSeries.X 0 ^ 2}) := sorry

-- Check cohen_test_parameter_nonunit: a coefficient parameter cannot be inverted in its ring.
example (k : Type) [Field k] (W : CohenDVR p k) : ¬ IsUnit (p : W.ring) := sorry

end RegularTower

namespace Perfectoid
namespace IntegralTower
variable {p : ℕ} (T : IntegralTower p)

abbrev genericRing (n : ℕ) := Localization.Away (T.parameter n)
instance genericTopology (n : ℕ) : TopologicalSpace (T.genericRing n) := sorry
instance genericTopologicalRing (n : ℕ) : IsTopologicalRing (T.genericRing n) := sorry
instance genericUniformSpace (n : ℕ) : UniformSpace (T.genericRing n) :=
  IsTopologicalAddGroup.rightUniformSpace (T.genericRing n)
instance genericUniformAddGroup (n : ℕ) : IsUniformAddGroup (T.genericRing n) := sorry
instance genericTate (n : ℕ) : IsTateRing (T.genericRing n) := sorry
instance genericComplete (n : ℕ) : CompleteSpace (T.genericRing n) := sorry
instance genericT2 (n : ℕ) : T2Space (T.genericRing n) := sorry

theorem generic_nhds_zero (m : ℕ) : (𝓝 (0 : T.genericRing m)).HasBasis (fun n : ℕ ↦ 0 ≤ n)
    (fun n ↦ (algebraMap (T.ring m) (T.genericRing m)) ''
      ((Ideal.span {T.parameter m} ^ n : Ideal (T.ring m)) : Set (T.ring m))) := sorry

def genericFibre (n : ℕ) : Pair (T.genericRing n) where
  plus := (integralClosure (T.ring n) (T.genericRing n)).toSubring
  isRingOfIntegralElements := by sorry

def genericTransition (n : ℕ) : Pair.Hom (T.genericFibre n) (T.genericFibre (n+1)) := sorry

theorem genericTransition_map (n : ℕ) (x : T.ring n) :
    (T.genericTransition n).toRingHom (algebraMap (T.ring n) (T.genericRing n) x) =
      algebraMap (T.ring (n+1)) (T.genericRing (n+1)) (T.transition n x) := sorry

def genericToCompleted (n : ℕ) : Pair.Hom (T.genericFibre n) T.completedPair := sorry

theorem genericToCompleted_map (n : ℕ) (x : T.ring n) :
    (T.genericToCompleted n).toRingHom (algebraMap (T.ring n) (T.genericRing n) x) =
      algebraMap T.completedPlus T.completed (T.toCompleted n x) := sorry

/-- The space diagram is contravariant in the sequence of rings. -/
def genericDiagram (T : IntegralTower p) : ℕᵒᵖ ⥤ YonedaAdicSpace := sorry

theorem genericDiagram_obj (n : ℕ) : T.genericDiagram.obj (Opposite.op n) =
    YonedaAdicSpace.ofSpaY (CAff.of (T.genericFibre n)) := sorry

def genericDiagram_objIso (n : ℕ) : T.genericDiagram.obj (Opposite.op n) ≅
    YonedaAdicSpace.ofSpaY (CAff.of (T.genericFibre n)) := eqToIso (T.genericDiagram_obj n)

theorem genericDiagram_step (n : ℕ) :
    T.genericDiagram.map ((homOfLE (Nat.le_succ n)).op) =
      (T.genericDiagram_objIso (n+1)).hom ≫
        (ObjectProperty.homMk (YonedaAdicSpace.spaYFunctor.map (show CAff.of (T.genericFibre n) ⟶ CAff.of (T.genericFibre (n+1)) from T.genericTransition n).op) :
          YonedaAdicSpace.ofSpaY (CAff.of (T.genericFibre (n+1))) ⟶
            YonedaAdicSpace.ofSpaY (CAff.of (T.genericFibre n))) ≫
        (T.genericDiagram_objIso n).inv := sorry

def genericCone : Cone T.genericDiagram where
  pt := YonedaAdicSpace.ofSpaY (CAff.of T.completedPair)
  π := {
    app := fun n ↦ (ObjectProperty.homMk
      (YonedaAdicSpace.spaYFunctor.map (show CAff.of (T.genericFibre n.unop) ⟶ CAff.of T.completedPair from T.genericToCompleted n.unop).op) :
        YonedaAdicSpace.ofSpaY (CAff.of T.completedPair) ⟶
          YonedaAdicSpace.ofSpaY (CAff.of (T.genericFibre n.unop))) ≫
        (T.genericDiagram_objIso n.unop).inv,
    naturality := by sorry }

end IntegralTower

namespace FrobeniusTower
variable {p : ℕ} [Fact p.Prime]
abbrev genericFibre (T : FrobeniusTower p) := T.toIntegralTower.genericFibre

/-- The algebraic colimit already has bijective quotient Frobenius. -/
theorem frobenius_colimit_bijective (T : FrobeniusTower p) :
    ∃ hp : T.toIntegralTower.colimitParameter ^ p ∣ (p : T.toIntegralTower.colimitRing),
      Function.Bijective (frobeniusModPow p T.toIntegralTower.colimitParameter hp) := sorry

/-! ### P7/frobenius-tower-uniformity-bound -/

/-- The common parameter bounds all power-bounded elements in the completed integral model. -/
theorem uniformity_bound (T : FrobeniusTower p) (x : T.completed)
    (hx : x ∈ powerBoundedSubring T.completed) :
    algebraMap T.completedPlus T.completed T.toIntegralTower.completedParameter * x ∈
      Set.range (algebraMap T.completedPlus T.completed) := sorry

/-! ### P7/perfectoid-frobenius-criterion-for-towers -/

theorem isTildeLimit (T : FrobeniusTower p)
    (hs : ∀ n, CAff.Sheafy (CAff.of (T.genericFibre n)))
    (hq : ∀ {i j} (a : i ⟶ j), AdicSpace.Qcqs (T.toIntegralTower.genericDiagram.map a)) :
    PerfectoidSpace.IsTildeLimit p T.toIntegralTower.genericDiagram T.toIntegralTower.genericCone := sorry

theorem completed_map_id (T : FrobeniusTower p) : completed_map (Hom.id T) = RingHom.id _ := sorry

theorem completed_map_comp {T U V : FrobeniusTower p} (f : Hom T U) (g : Hom U V) :
    completed_map (Hom.comp g f) = (completed_map g).comp (completed_map f) := sorry

/-- The restricted polynomial integral model, with its principal-adic topology. -/
abbrev discIntegral (S : Type) [CommRing S] (π : S) :=
  AdicCompletion (Ideal.span {Polynomial.C π}) (Polynomial S)

abbrev discPolynomial (S : Type) [CommRing S] (π : S) : Polynomial S →+* discIntegral S π :=
  algebraMap _ _

def discPower (p : ℕ) (S : Type) [CommRing S] (π : S) : discIntegral S π →+* discIntegral S π := sorry

theorem discPower_polynomial (S : Type) [CommRing S] (π : S) (f : Polynomial S) :
    discPower (p := p) S π (discPolynomial S π f) =
      discPolynomial S π (Polynomial.eval₂ (Polynomial.C) (Polynomial.X ^ p) f) := sorry

/-- The p-th power transition on the disc, with coefficient Frobenius in its quotient lift. -/
def disc (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] : FrobeniusTower p where
  ring _ := discIntegral S π
  transition _ := discPower (p := p) S π
  parameter _ := discPolynomial S π (Polynomial.C π)
  parameter_map := by sorry
  regular := by sorry
  complete := by sorry
  divides := by sorry
  start := 0
  lift := by sorry
  transition_comp_lift := by sorry
  lift_comp_transition := by sorry

-- Check frobeniusTower_test_twoTerms: quotient Frobenius squares coefficients as well as T.
example (S : Type) [CommRing S] [IsIntegralPerfectoid 2 S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ 2 ∣ (2 : S))
    [IsAdicComplete (Ideal.span {π}) S] (a b : S) (n : ℕ) :
    (disc (p := 2) S π hπ hp).frobMod n
      (Ideal.Quotient.mk (Ideal.span {discPolynomial S π (Polynomial.C π)})
        (discPolynomial S π (Polynomial.C a + Polynomial.C b * Polynomial.X))) =
    Ideal.Quotient.mk (Ideal.span {discPolynomial S π (Polynomial.C π) ^ 2})
      (discPolynomial S π (Polynomial.C (a ^ 2) + Polynomial.C (b ^ 2) * Polynomial.X ^ 2)) := sorry

-- Check frobeniusTower_test_twoTransitions: the disc maps fix coefficients.
example (S : Type) [CommRing S] (π a b : S) :
    discPower 2 S π (discPower 2 S π
      (discPolynomial S π (Polynomial.C a + Polynomial.C b * Polynomial.X))) =
      discPolynomial S π (Polynomial.C a + Polynomial.C b * Polynomial.X ^ 4) := sorry

-- Check frobeniusTower_test_wrongModulus: the marked parameter 2 is rejected at p=2.
example : (((1 + 1 : ZMod 4) ^ 2) ≠ (1 : ZMod 4) ^ 2 + (1 : ZMod 4) ^ 2) ∧
    ¬ ∃ T : IntegralTower 2, ∃ e : T.ring 0 ≃+* ℤ_[2], e (T.parameter 0) = 2 := sorry

-- Check frobeniusTower_test_constDisc_not: T is outside the image of quotient Frobenius.
example (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] (hunit : ¬ IsUnit π) (n : ℕ) :
    Ideal.Quotient.mk (Ideal.span {discPolynomial S π (Polynomial.C π) ^ p})
      (discPolynomial S π Polynomial.X) ∉ Set.range ((disc S π hπ hp).frobMod n) := sorry

-- Check frobeniusTower_test_disc: the tower maps a+bT to a+bT^p.
example (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] (a b : S) (n : ℕ) :
    (disc S π hπ hp).transition n (discPolynomial S π (Polynomial.C a + Polynomial.C b * Polynomial.X)) =
      discPolynomial S π (Polynomial.C a + Polynomial.C b * Polynomial.X ^ p) := sorry

-- Check frobeniusTower_test_constDisc_full_not: the constant restricted-disc system fails the lift axiom.
example (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] (hunit : ¬ IsUnit π) :
    ¬ ∃ T : FrobeniusTower p,
      ∃ e : ∀ n, T.ring n ≃+* discIntegral S π,
        (∀ n, e n (T.parameter n) = discPolynomial S π (Polynomial.C π)) ∧
        ∀ n x, e (n+1) (T.transition n x) = e n x := sorry

/-- Coordinate powers commute with the disc transitions and coefficient-Frobenius lifts. -/
def discPowerHom (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] (k : ℕ) :
    Hom (disc S π hπ hp) (disc S π hπ hp) where
  map _ := discPower k S π
  parameter_map := by sorry
  comm := by sorry
  start := 0
  lift_comm := by sorry

-- Check: discPowerHom_constant
example (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] (a b : S) :
    (discPowerHom S π hπ hp 0).map 0
      (discPolynomial S π (Polynomial.C a + Polynomial.C b * Polynomial.X)) =
        discPolynomial S π (Polynomial.C (a + b)) := sorry

-- Check: discPowerHom_quadratic
example (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] (a b : S) (n : ℕ) :
    (discPowerHom S π hπ hp 2).map n
      (discPolynomial S π (Polynomial.C a + Polynomial.C b * Polynomial.X)) =
        discPolynomial S π (Polynomial.C a + Polynomial.C b * Polynomial.X ^ 2) := sorry

-- Check: discPowerHom_lift_coefficients
example (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] (a b : S) (n : ℕ) :
    let T := disc S π hπ hp
    let f := discPowerHom S π hπ hp 2
    let x := discPolynomial S π (Polynomial.C a + Polynomial.C b * Polynomial.X)
    let y := Ideal.Quotient.mk (Ideal.span {T.parameter n ^ p})
      (discPolynomial S π (Polynomial.C (a ^ p) + Polynomial.C (b ^ p) * Polynomial.X ^ 2))
    (Ideal.quotientMap _ (f.map n) (by
      refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
      change f.map n (T.parameter n ^ p) ∈ Ideal.span {T.parameter n ^ p}
      rw [map_pow, f.parameter_map]
      exact Ideal.subset_span (Set.mem_singleton _)))
        (T.lift n (Nat.zero_le n) (Ideal.Quotient.mk _ x)) = y ∧
      T.lift n (Nat.zero_le n) (Ideal.Quotient.mk _ (f.map (n+1) x)) = y := sorry

-- Check: Hom_disc_lift_forced
example (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S]
    (f : ℕ → (discIntegral S π →+* discIntegral S π))
    (hparam : ∀ n, f n (discPolynomial S π (Polynomial.C π)) =
      discPolynomial S π (Polynomial.C π))
    (hcomm : ∀ n, (f (n+1)).comp (discPower p S π) = (discPower p S π).comp (f n)) :
    let T := disc S π hπ hp
    ∀ n x, (Ideal.quotientMap
      (I := Ideal.span {discPolynomial S π (Polynomial.C π) ^ p})
      (Ideal.span {discPolynomial S π (Polynomial.C π) ^ p}) (f n) (by
        refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
        change f n (discPolynomial S π (Polynomial.C π) ^ p) ∈
          Ideal.span {discPolynomial S π (Polynomial.C π) ^ p}
        rw [map_pow, hparam]
        exact Ideal.subset_span (Set.mem_singleton _)))
      (T.lift n (Nat.zero_le n) (Ideal.Quotient.mk _ x)) =
        T.lift n (Nat.zero_le n) (Ideal.Quotient.mk _ (f (n+1) x)) := sorry

-- Check frobeniusTowerHom_test_identity: identity fixes a marked nonconstant disc polynomial.
example (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] :
    (Hom.id (disc S π hπ hp)).map 0 (discPolynomial S π (1 + Polynomial.X)) =
      discPolynomial S π (1 + Polynomial.X) := rfl

-- Check frobeniusTowerHom_test_zero: all maps into the zero integral tower agree.
example (T U : FrobeniusTower p) (hU : ∀ n, Subsingleton (U.ring n))
    (f g : Hom T U) (n : ℕ) (x : T.ring n) : f.map n x = g.map n x := by
  let _ := hU n
  exact Subsingleton.elim _ _

-- Check frobeniusTowerHom_test_parameter_not: a map killing a nonzero target parameter is rejected.
example (T U : FrobeniusTower p) [Nontrivial (U.ring 0)] (f : Hom T U) :
    f.map 0 (T.parameter 0) ≠ 0 := by
  rw [f.parameter_map]
  exact nonZeroDivisors.ne_zero (U.regular 0)

-- Check genericFibre_test_zero: the zero tower has empty generic fibre.
example (T : FrobeniusTower p) (h : ∀ n, Subsingleton (T.ring n)) (n : ℕ) :
    Subsingleton (T.toIntegralTower.genericRing n) := sorry

-- Check genericFibre_test_parameter_inverse: the marked parameter is invertible, even when p=0.
example (T : FrobeniusTower p) (n : ℕ) :
    IsUnit (algebraMap (T.ring n) (T.toIntegralTower.genericRing n) (T.parameter n)) := sorry

-- Check genericFibre_test_transition_twoTerms: the localization map agrees on 1+pi^2.
example (T : FrobeniusTower p) (n : ℕ) :
    (T.toIntegralTower.genericTransition n).toRingHom
      (algebraMap (T.ring n) (T.toIntegralTower.genericRing n) (1 + T.parameter n ^ 2)) =
        algebraMap (T.ring (n+1)) (T.toIntegralTower.genericRing (n+1)) (1 + T.parameter (n+1) ^ 2) := sorry

end FrobeniusTower
end Perfectoid

namespace PerfectoidSpace

abbrev CompactOpenSubgroup (G : Type) [Group G] [TopologicalSpace G] :=
  {U : OpenSubgroup G // IsCompact (U : Set G)}

variable {G : Type} [Group G] [TopologicalSpace G]
  {J : Type} [Category J] [IsCofiltered J]

def LevelFamily.functor (F : LevelFamily J G) : J ⥤ CompactOpenSubgroup G where
  obj j := ⟨F.level j, F.compact j⟩
  map a := homOfLE (F.map_le a)

theorem CofinalityWitness.initial (F : LevelFamily J G) (w : CofinalityWitness F) :
    F.functor.Initial := sorry

def CofinalityWitness.mono (F F' : LevelFamily J G) (w : CofinalityWitness F)
    (h : ∀ j, F'.level j ≤ F.level j) : CofinalityWitness F' where
  levelFor := w.levelFor
  le U := le_trans (h _) (w.le U)

def CofinalityWitness.ofDecreasing [IsTopologicalGroup G] [T2Space G]
    (F : LevelFamily ℕᵒᵖ G) (h : ⨅ n, (F.level (Opposite.op n)).toSubgroup = ⊥) :
    CofinalityWitness F := sorry

local instance (H : ProfiniteGrp) : IsCofiltered (OpenNormalSubgroup H) := sorry

/-- Open normal subgroups form a cofinal family without a countability assumption. -/
theorem CofinalityWitness.openNormal (H : ProfiniteGrp) :
    ∃ F : LevelFamily (OpenNormalSubgroup H) H,
      Nonempty (CofinalityWitness F) ∧
        ∀ U : OpenNormalSubgroup H, F.level U = U.toOpenSubgroup := sorry

theorem CofinalityWitness.conj [IsTopologicalGroup G] (F : LevelFamily J G)
    (w : CofinalityWitness F) (g : G) :
    ∃ F' : LevelFamily J G, Nonempty (CofinalityWitness F') ∧
      ∀ j x, x ∈ F'.level j ↔ g⁻¹ * x * g ∈ F.level j := sorry

/-- Matrix congruence is measured inside GL_N(Q_p); levels begin at p, not p^0. -/
theorem CofinalityWitness.principalCongruence (p N : ℕ) [Fact p.Prime] :
    ∃ F : LevelFamily ℕᵒᵖ (Matrix.GeneralLinearGroup (Fin N) ℚ_[p]),
      Nonempty (CofinalityWitness F) ∧
      ∀ n g, g ∈ F.level (Opposite.op n) ↔
        ∀ i j, ‖g.val i j - (1 : Matrix (Fin N) (Fin N) ℚ_[p]) i j‖ ≤
          ((p : ℝ) ^ (n+1))⁻¹ := sorry

/-- Closed subgroups of GL_N(Z_p) inherit the principal-congruence neighbourhood basis.
Compactness supplies compact levels, including rank zero and the trivial subgroup. -/
theorem CofinalityWitness.principalCongruence_closed (p N : ℕ) [Fact p.Prime]
    (H : Subgroup (Matrix.GeneralLinearGroup (Fin N) ℤ_[p]))
    (hH : IsClosed (H : Set (Matrix.GeneralLinearGroup (Fin N) ℤ_[p]))) :
    ∃ F : LevelFamily ℕᵒᵖ H,
      Nonempty (CofinalityWitness F) ∧
      ∀ n g, g ∈ F.level (Opposite.op n) ↔
        ∀ i j, ‖g.val.val i j - (1 : Matrix (Fin N) (Fin N) ℤ_[p]) i j‖ ≤
          ((p : ℝ) ^ (n+1))⁻¹ := sorry

-- Check: cofinalityWitness_closed_rankZero
example (p : ℕ) [Fact p.Prime]
    (H : Subgroup (Matrix.GeneralLinearGroup (Fin 0) ℤ_[p]))
    (hH : IsClosed (H : Set (Matrix.GeneralLinearGroup (Fin 0) ℤ_[p]))) :
    ∃ F : LevelFamily ℕᵒᵖ H, Nonempty (CofinalityWitness F) ∧
      ∀ n, (F.level (Opposite.op n)).toSubgroup = ⊤ := sorry

-- Check: cofinalityWitness_closed_trivial
example (p N : ℕ) [Fact p.Prime] :
    ∃ F : LevelFamily ℕᵒᵖ (⊥ : Subgroup (Matrix.GeneralLinearGroup (Fin N) ℤ_[p])),
      Nonempty (CofinalityWitness F) ∧
      ∀ n, (F.level (Opposite.op n)).toSubgroup = ⊤ := sorry

-- Check: cofinalityWitness_closed_scalar
example (p : ℕ) [Fact p.Prime] :
    ∃ F : LevelFamily ℕᵒᵖ (⊤ : Subgroup (Matrix.GeneralLinearGroup (Fin 1) ℤ_[p])),
      Nonempty (CofinalityWitness F) ∧
      ∀ n g, g ∈ F.level (Opposite.op n) ↔
        ‖g.val.val 0 0 - 1‖ ≤ ((p : ℝ) ^ (n+1))⁻¹ := sorry

-- Check cofinalityWitness_test_principalCongruence: the p-adic matrix levels are witnessed.
example (p N : ℕ) [Fact p.Prime] :
    ∃ F : LevelFamily ℕᵒᵖ (Matrix.GeneralLinearGroup (Fin N) ℚ_[p]),
      Nonempty (CofinalityWitness F) ∧
      ∀ n g, g ∈ F.level (Opposite.op n) ↔
        ∀ i j, ‖g.val i j - (1 : Matrix (Fin N) (Fin N) ℚ_[p]) i j‖ ≤
          ((p : ℝ) ^ (n+1))⁻¹ := CofinalityWitness.principalCongruence p N

-- Check cofinalityWitness_test_gamma0_not: the upper unipotent survives all Gamma_0 levels.
example (p : ℕ) [Fact p.Prime]
    (F : LevelFamily ℕᵒᵖ (Matrix.GeneralLinearGroup (Fin 2) ℚ_[p]))
    (hF : ∀ n g, g ∈ F.level (Opposite.op n) ↔
      (∀ i j, ‖g.val i j‖ ≤ 1) ∧ (∀ i j, ‖(g⁻¹).val i j‖ ≤ 1) ∧
        ‖g.val 1 0‖ ≤ ((p : ℝ) ^ (n+1))⁻¹) :
    ¬ Nonempty (CofinalityWitness F) := sorry

-- Check cofinalityWitness_test_const_not: in a Hausdorff locally profinite group a nontrivial constant level fails.
example [IsTopologicalGroup G] [T2Space G]
    (hb : ∀ x : G, x ≠ 1 → ∃ U : OpenSubgroup G, x ∉ U)
    (F : LevelFamily J G) (K : OpenSubgroup G) (hK : K.toSubgroup ≠ ⊥)
    (hF : ∀ j, F.level j = K) : ¬ Nonempty (CofinalityWitness F) := sorry

-- Check cofinalityWitness_test_initial: the subtype of compact open subgroups uses inclusion direction.
example (F : LevelFamily J G) (w : CofinalityWitness F) : F.functor.Initial :=
  CofinalityWitness.initial F w

end PerfectoidSpace

namespace Perfectoid.FrobeniusTower
open scoped TensorProduct
variable {p : ℕ} [Fact p.Prime]
variable (O : Type) [CommRing O] [hO : IsIntegralPerfectoid p O]
  (π : O) (hπ : π ∈ nonZeroDivisors O) (hp : π ^ p ∣ (p : O))
  [hcomplete : IsAdicComplete (Ideal.span {π}) O]
  (T : IntegralTower p) [∀ n, Algebra O (T.ring n)]
  (hparam : ∀ n, algebraMap O (T.ring n) π = T.parameter n)

/-- Scalar extension of the next quotient along the base Frobenius O/pi -> O/pi^p. -/
def relativeTwist (hparam : ∀ n, algebraMap O (T.ring n) π = T.parameter n) (n : ℕ) : CommRingCat := by
  letI : Algebra (O ⧸ Ideal.span {π}) (T.quotient (n+1) 1) :=
    (Ideal.quotientMap _ (algebraMap O (T.ring (n+1))) (by
      refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
      change algebraMap O (T.ring (n+1)) π ∈ Ideal.span {T.parameter (n+1) ^ 1}
      rw [hparam, pow_one]
      exact Ideal.subset_span (Set.mem_singleton _))).toAlgebra
  letI : Algebra (O ⧸ Ideal.span {π}) (O ⧸ Ideal.span {π ^ p}) :=
    (frobeniusModPow p π hp).toAlgebra
  exact CommRingCat.of ((T.quotient (n+1) 1) ⊗[O ⧸ Ideal.span {π}] (O ⧸ Ideal.span {π ^ p}))

/-- x is sent to x tensor 1, with the two scalar structures fixed above. -/
def relativeTwistLeft (hparam : ∀ n, algebraMap O (T.ring n) π = T.parameter n) (n : ℕ) : T.quotient (n+1) 1 →+* relativeTwist O π hp T hparam n := by
  letI : Algebra (O ⧸ Ideal.span {π}) (T.quotient (n+1) 1) :=
    (Ideal.quotientMap _ (algebraMap O (T.ring (n+1))) (by
      refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
      change algebraMap O (T.ring (n+1)) π ∈ Ideal.span {T.parameter (n+1) ^ 1}
      rw [hparam, pow_one]
      exact Ideal.subset_span (Set.mem_singleton _))).toAlgebra
  letI : Algebra (O ⧸ Ideal.span {π}) (O ⧸ Ideal.span {π ^ p}) :=
    (frobeniusModPow p π hp).toAlgebra
  exact Algebra.TensorProduct.includeLeftRingHom

/-- The right scalar inclusion makes the relative presentation O/pi^p-linear. -/
def relativeTwistRight (hparam : ∀ n, algebraMap O (T.ring n) π = T.parameter n) (n : ℕ) :
    (O ⧸ Ideal.span {π ^ p}) →+* relativeTwist O π hp T hparam n := by
  letI : Algebra (O ⧸ Ideal.span {π}) (T.quotient (n+1) 1) :=
    (Ideal.quotientMap _ (algebraMap O (T.ring (n+1))) (by
      refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
      change algebraMap O (T.ring (n+1)) π ∈ Ideal.span {T.parameter (n+1) ^ 1}
      rw [hparam, pow_one]
      exact Ideal.subset_span (Set.mem_singleton _))).toAlgebra
  letI : Algebra (O ⧸ Ideal.span {π}) (O ⧸ Ideal.span {π ^ p}) :=
    (frobeniusModPow p π hp).toAlgebra
  exact Algebra.TensorProduct.includeRight.toRingHom

include hO hπ hcomplete in
theorem relativeTwistLeft_bijective (n : ℕ) :
    Function.Bijective (relativeTwistLeft O π hp T hparam n) := sorry

/-! ### P7/relative-frobenius-tower -/

/-- Scalar-linear relative-Frobenius presentations give the quotient lifts. Flatness and the
marked scalar ensure that the integral models have the source's principal-adic structure. -/
def ofRelativeFrobenius
    [∀ n, Module.Flat O (T.ring n)]
    (hlinear : ∀ n x, T.transition n (algebraMap O (T.ring n) x) =
      algebraMap O (T.ring (n+1)) x)
    (m₀ : ℕ)
    (e : ∀ n, m₀ ≤ n → relativeTwist O π hp T hparam n ≃+* T.quotient n p)
    (he : ∀ n (hn : m₀ ≤ n) (x : T.ring (n+1)),
      T.quotientMap n p (e n hn (relativeTwistLeft O π hp T hparam n (Ideal.Quotient.mk _ x))) =
        Ideal.Quotient.mk _ (x ^ p))
    (hscalar : ∀ n (hn : m₀ ≤ n) (c : O),
      e n hn (relativeTwistRight O π hp T hparam n (Ideal.Quotient.mk _ c)) =
        Ideal.Quotient.mk _ (algebraMap O (T.ring n) c)) :
    FrobeniusTower p where
  toIntegralTower := T
  start := m₀
  lift n hn := (RingEquiv.ofBijective (relativeTwistLeft O π hp T hparam n)
    (relativeTwistLeft_bijective O π hπ hp T hparam n)).trans (e n hn)
  transition_comp_lift := by sorry
  lift_comp_transition := by sorry

-- Check relativeTwist_test_zero: the zero stage has zero Frobenius twist.
example (n : ℕ) [Subsingleton (T.ring (n+1))] :
    Subsingleton (relativeTwist O π hp T hparam n) := sorry

-- Check relativeTwist_test_base: extending the base quotient along its Frobenius gives O/pi^p.
example : Nonempty
    (relativeTwist O π hp (constPerfectoid O π hπ hp).toIntegralTower (fun _ ↦ rfl) 0 ≃+*
      (O ⧸ Ideal.span {π ^ p})) := sorry

-- Check relativeTwist_test_nonzero: with proper parameter ideal, scalar extension does not kill the base.
example (hu : ¬ IsUnit π) :
    Nontrivial (relativeTwist O π hp (constPerfectoid O π hπ hp).toIntegralTower (fun _ ↦ rfl) 0) := sorry

section RelativeConstructorChecks
variable
    [∀ n, Module.Flat O (T.ring n)]
    (hlinear : ∀ n x, T.transition n (algebraMap O (T.ring n) x) =
      algebraMap O (T.ring (n+1)) x)
    (m₀ : ℕ)
    (e : ∀ n, m₀ ≤ n → relativeTwist O π hp T hparam n ≃+* T.quotient n p)
    (he : ∀ n (hn : m₀ ≤ n) (x : T.ring (n+1)),
      T.quotientMap n p (e n hn (relativeTwistLeft O π hp T hparam n (Ideal.Quotient.mk _ x))) =
        Ideal.Quotient.mk _ (x ^ p))
    (hscalar : ∀ n (hn : m₀ ≤ n) (c : O),
      e n hn (relativeTwistRight O π hp T hparam n (Ideal.Quotient.mk _ c)) =
        Ideal.Quotient.mk _ (algebraMap O (T.ring n) c)) 
local notation "F" => ofRelativeFrobenius O π hπ hp T hparam hlinear m₀ e he hscalar

-- Check ofRelativeFrobenius_test_scalar: the two-term scalar is fixed by the constructed transition.
example (n : ℕ) : (F).transition n (algebraMap O (T.ring n) (1 + π)) =
    algebraMap O (T.ring (n+1)) (1 + π) := hlinear n (1 + π)

-- Check ofRelativeFrobenius_test_zero: zero models give zero completed generic fibre.
example (hz : ∀ n, Subsingleton (T.ring n)) : Subsingleton (F).completed := sorry

-- Check ofRelativeFrobenius_test_parameter_not: the constructor cannot kill the parameter in a nonzero stage.
example (n : ℕ) [Nontrivial (T.ring n)] : (F).parameter n ≠ 0 := sorry

-- Check: ofRelativeFrobenius_lift_scalar
example (n : ℕ) (hn : m₀ ≤ n) (c : O) :
    (F).lift n hn (Ideal.Quotient.mk _ (algebraMap O (T.ring (n+1)) c)) =
      Ideal.Quotient.mk (Ideal.span {T.parameter n ^ p})
        (algebraMap O (T.ring n) (c ^ p)) := sorry

-- Check: ofRelativeFrobenius_lift_tensor
example (n : ℕ) (hn : m₀ ≤ n) (x : T.quotient (n+1) 1)
    (c : O ⧸ Ideal.span {π ^ p}) :
    let j := RingEquiv.ofBijective (relativeTwistLeft O π hp T hparam n)
      (relativeTwistLeft_bijective O π hπ hp T hparam n)
    (F).lift n hn (j.symm
      (relativeTwistLeft O π hp T hparam n x * relativeTwistRight O π hp T hparam n c)) =
        e n hn (relativeTwistLeft O π hp T hparam n x) *
          (Ideal.quotientMap _ (algebraMap O (T.ring n)) (by
            refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
            change algebraMap O (T.ring n) (π ^ p) ∈ Ideal.span {T.parameter n ^ p}
            rw [map_pow, hparam]
            exact Ideal.subset_span (Set.mem_singleton _))) c := sorry

-- Check: ofRelativeFrobenius_lift_two_terms
example (n : ℕ) (hn : m₀ ≤ n) (x y : T.ring (n+1)) (a b : T.ring n)
    (hx : e n hn (relativeTwistLeft O π hp T hparam n (Ideal.Quotient.mk _ x)) =
      Ideal.Quotient.mk _ a)
    (hy : e n hn (relativeTwistLeft O π hp T hparam n (Ideal.Quotient.mk _ y)) =
      Ideal.Quotient.mk _ b) (c d : O) :
    (F).lift n hn (Ideal.Quotient.mk _
      (algebraMap O (T.ring (n+1)) c * x + algebraMap O (T.ring (n+1)) d * y)) =
        Ideal.Quotient.mk (Ideal.span {T.parameter n ^ p})
          (algebraMap O (T.ring n) (c ^ p) * a + algebraMap O (T.ring n) (d ^ p) * b) := sorry

end RelativeConstructorChecks

end Perfectoid.FrobeniusTower

namespace Perfectoid.FrobeniusTower
open scoped TensorProduct
variable (p : ℕ) [Fact p.Prime]
  (O : Type) [CommRing O] [CharP O p] [PerfectRing O p]
  (B : Type) [CommRing B] [Algebra O B]

/-! ### P7/perfection-tilde-limit -/

/-- The base twist at stage n uses inverse, not forward, coefficient Frobenius. -/
def inverseFrobeniusIterate : ℕ → (O ≃+* O)
  | 0 => RingEquiv.refl O
  | n+1 => (inverseFrobeniusIterate n).trans (frobeniusEquiv O p).symm

def perfectionStage (p : ℕ) [Fact p.Prime]
    (O : Type) [CommRing O] [CharP O p] [PerfectRing O p]
    (B : Type) [CommRing B] [Algebra O B] (n : ℕ) : CommRingCat := by
  letI : Algebra O O := (inverseFrobeniusIterate p O n).toRingHom.toAlgebra
  letI : Module O O := Algebra.toModule
  exact CommRingCat.of (B ⊗[O] O)

def perfectionTensor (n : ℕ) (b : B) (c : O) : perfectionStage p O B n := by
  letI : Algebra O O := (inverseFrobeniusIterate p O n).toRingHom.toAlgebra
  letI : Module O O := Algebra.toModule
  exact b ⊗ₜ[O] c

def perfectionTransition (n : ℕ) : perfectionStage p O B n →+* perfectionStage p O B (n+1) := sorry

theorem perfectionTransition_tensor (n : ℕ) (b : B) (c : O) :
    perfectionTransition p O B n (perfectionTensor p O B n b c) =
      perfectionTensor p O B (n+1) (b ^ p) c := sorry

-- Check frobeniusTower_test_twistedCoefficient: the left coefficient squares, the right stays fixed.
example : ∃ a : GaloisField 2 3,
    a ^ 3 + a + 1 = 0 ∧ a ^ 8 = a ∧ a ^ 2 ≠ a ^ 4 ∧
    inverseFrobeniusIterate 2 (GaloisField 2 3) 1 a = a ^ 4 ∧
    perfectionTransition 2 (GaloisField 2 3) (Polynomial (GaloisField 2 3)) 0
      (perfectionTensor 2 (GaloisField 2 3) (Polynomial (GaloisField 2 3)) 0
        (Polynomial.C a + Polynomial.X) a) =
      perfectionTensor 2 (GaloisField 2 3) (Polynomial (GaloisField 2 3)) 1
        (Polynomial.C (a ^ 2) + Polynomial.X ^ 2) a := sorry

/-- The characteristic-p relative Frobenius tower of a flat complete integral algebra. -/
def perfection [Module.Flat O B] (t : O) (ht : t ∈ nonZeroDivisors O)
    [IsAdicComplete (Ideal.span {algebraMap O B t}) B] : FrobeniusTower p where
  ring n := perfectionStage p O B n
  transition n := perfectionTransition p O B n
  parameter n := perfectionTensor p O B n 1 t
  parameter_map := by sorry
  regular := by sorry
  complete := by sorry
  divides := by sorry
  start := 0
  lift := by sorry
  transition_comp_lift := by sorry
  lift_comp_transition := by sorry

/-- The quotient lift fixes the left tensor factor and raises the right coefficient to p.
This specifies the base-change lift even when the transition has a nilpotent kernel. -/
theorem perfection_lift_tensor [Module.Flat O B] (t : O) (ht : t ∈ nonZeroDivisors O)
    [IsAdicComplete (Ideal.span {algebraMap O B t}) B] (n : ℕ) (b : B) (c : O) :
    (perfection p O B t ht).lift n (Nat.zero_le n)
      (Ideal.Quotient.mk _ (perfectionTensor p O B (n + 1) b c)) =
        Ideal.Quotient.mk (Ideal.span {(perfection p O B t ht).parameter n ^ p})
          (perfectionTensor p O B n b (c ^ p)) := sorry

-- Check perfection_lift_scalar: at the first step the right coefficient is raised to p.
example [Module.Flat O B] (t : O) (ht : t ∈ nonZeroDivisors O)
    [IsAdicComplete (Ideal.span {algebraMap O B t}) B] (c : O) :
    (perfection p O B t ht).lift 0 (Nat.zero_le 0)
      (Ideal.Quotient.mk _ (perfectionTensor p O B 1 1 c)) =
        Ideal.Quotient.mk (Ideal.span {(perfection p O B t ht).parameter 0 ^ p})
          (perfectionTensor p O B 0 1 (c ^ p)) :=
  perfection_lift_tensor p O B t ht 0 1 c

-- Check perfection_lift_left: at every step the left tensor factor is unchanged.
example [Module.Flat O B] (t : O) (ht : t ∈ nonZeroDivisors O)
    [IsAdicComplete (Ideal.span {algebraMap O B t}) B] (n : ℕ) (b : B) :
    (perfection p O B t ht).lift n (Nat.zero_le n)
      (Ideal.Quotient.mk _ (perfectionTensor p O B (n + 1) b 1)) =
        Ideal.Quotient.mk (Ideal.span {(perfection p O B t ht).parameter n ^ p})
          (perfectionTensor p O B n b 1) := by
  simpa using perfection_lift_tensor p O B t ht n b 1

-- Check perfection_lift_nilpotent: a transition can kill a class retained by the lift.
example [Module.Flat O B] (t : O) (ht : t ∈ nonZeroDivisors O)
    [IsAdicComplete (Ideal.span {algebraMap O B t}) B]
    (ε : B) (hε : ε ^ p = 0)
    (hne : (Ideal.Quotient.mk
      (Ideal.span {(perfection p O B t ht).parameter 0 ^ p})
        (perfectionTensor p O B 0 ε 1)) ≠ 0) :
    (perfection p O B t ht).transition 0 (perfectionTensor p O B 0 ε 1) =
      perfectionTensor p O B 1 0 1 ∧
    (perfection p O B t ht).lift 0 (Nat.zero_le 0)
      (Ideal.Quotient.mk _ (perfectionTensor p O B 1 ε 1)) ≠ 0 := by
  constructor
  · change perfectionTransition p O B 0 _ = _
    rw [perfectionTransition_tensor, hε]
  · simpa only [perfection_lift_tensor, one_pow] using hne

-- Check frobeniusTower_test_relativeFrobenius: the tower sends b tensor c to b^p tensor c.
example [Module.Flat O B] (t : O) (ht : t ∈ nonZeroDivisors O)
    [IsAdicComplete (Ideal.span {algebraMap O B t}) B] (n : ℕ) (b : B) (c : O) :
    (perfection p O B t ht).transition n (perfectionTensor p O B n b c) =
      perfectionTensor p O B (n+1) (b ^ p) c := perfectionTransition_tensor p O B n b c

-- Check perfection_test_parameter: the right scalar t is fixed by every transition.
example [Module.Flat O B] (t : O) (ht : t ∈ nonZeroDivisors O)
    [IsAdicComplete (Ideal.span {algebraMap O B t}) B] (n : ℕ) :
    (perfection p O B t ht).transition n (perfectionTensor p O B n 1 t) =
      perfectionTensor p O B (n+1) 1 t := sorry

-- Check perfection_test_zero: a zero input algebra produces zero at every stage and in the completion.
example [Module.Flat O B] [Subsingleton B] (t : O) (ht : t ∈ nonZeroDivisors O)
    [IsAdicComplete (Ideal.span {algebraMap O B t}) B] :
    (∀ n, Subsingleton ((perfection p O B t ht).ring n)) ∧
      Subsingleton (perfection p O B t ht).completedPlus := sorry

-- Check perfection_test_twoTransitions: after two transitions the left exponent is p^2.
example [Module.Flat O B] (t : O) (ht : t ∈ nonZeroDivisors O)
    [IsAdicComplete (Ideal.span {algebraMap O B t}) B] (b : B) (c : O) :
    (perfection p O B t ht).transition 1
      ((perfection p O B t ht).transition 0 (perfectionTensor p O B 0 b c)) =
        perfectionTensor p O B 2 (b ^ (p ^ 2)) c := sorry

end Perfectoid.FrobeniusTower

namespace PerfectoidSpace
open YonedaAdicSpace
variable (p : ℕ) [Fact p.Prime]

/-- Honesty of X is the hypothesis for the strong-completion tilde-limit assertion. -/
theorem strongCompletion.isTildeLimit (X : YonedaAdicSpace) (hX : IsPreperfectoid p X)
    (hh : AdicSpace.IsHonest X) :
    IsTildeLimit p _ (AdicSpace.singletonCone (strongCompletion.ι p X hX)) := sorry

-- Check: strongCompletion_map_component_swap
example (X : Perfd p)
    (hY : IsPreperfectoid p (prodProfinite p X (Profinite.of Bool)).obj)
    (x : underlyingPoints p X) :
    let Y := prodProfinite p X (Profinite.of Bool)
    let swap : Profinite.of Bool ⟶ Profinite.of Bool :=
      CompHausLike.ofHom _ (⟨Bool.not, by continuity⟩ : C(Bool, Bool))
    let f := strongCompletion.map p hY hY (prodProfinite.map p X swap).hom
    let e := strongCompletion.homeomorph p Y.obj hY
    let z := e.symm (pointMap p (prodProfinite.pointSection p X (Profinite.of Bool) false) x)
    prodProfinite.snd p X (Profinite.of Bool) (e (pointMap p f z)) = true ∧
      pointMap p f z ≠ z := sorry

-- Check strongCompletion_map_test_id: on a perfectoid object the completed identity is the identity.
example (X : Perfd p) (hX : IsPreperfectoid p X.obj) :
    strongCompletion.map p hX hX (𝟙 X.obj) = 𝟙 _ := strongCompletion.map_id p X.obj hX

-- Check strongCompletion_map_test_empty: all maps from the empty completion agree.
example (X Y : YonedaAdicSpace) (hX : IsPreperfectoid p X) (hY : IsPreperfectoid p Y)
    [IsEmpty (space.obj X)] (f g : X ⟶ Y) :
    strongCompletion.map p hX hY f = strongCompletion.map p hX hY g := sorry

-- Check strongCompletion_map_test_nonreduced: completing the canonical reduction gives an isomorphism.
example (Q : Pair (DualNumber ℂ_[p]))
    (hQ : ∀ x, x ∈ Q.plus ↔ TrivSqZeroExt.fst x ∈ powerBoundedSubring ℂ_[p])
    (f : CAff.of Q ⟶ CAff.of (Pair.powerBounded ℂ_[p]))
    (hf : ∀ x, CAff.toRingHom f x = TrivSqZeroExt.fst x)
    (hX : IsPreperfectoid p (ofSpaY (CAff.of (Pair.powerBounded ℂ_[p]))))
    (hY : IsPreperfectoid p (ofSpaY (CAff.of Q))) :
    IsIso (strongCompletion.map p hX hY
      (ObjectProperty.homMk (spaYFunctor.map f.op))) := sorry

end PerfectoidSpace

namespace RegularTower
variable (p : ℕ) [Fact p.Prime]

-- Check cohen_test_parameter_not_square: the coefficient parameter has order exactly one.
example (k : Type) [Field k] (W : CohenDVR p k) :
    (p : W.ring) ∉ IsLocalRing.maximalIdeal W.ring ^ 2 := sorry

-- Check cohen_test_wrong_characteristic: a characteristic-p field cannot be a Cohen DVR coefficient ring.
example (k : Type) [Field k] [CharP k p] (W : CohenDVR p k) : ¬ Nonempty (W.ring ≃+* k) := sorry

end RegularTower

namespace Perfectoid.FrobeniusTower
variable {p : ℕ} [Fact p.Prime]
variable (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
  (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
  [IsAdicComplete (Ideal.span {π}) S]

/-- Completion of the restricted-disc tower is the completed monoid algebra of p-power exponents. -/
def discCompletionEquiv : (disc S π hπ hp).completedPlus ≃+*
    AdicCompletion (Ideal.span {algebraMap S (AddMonoidAlgebra S (pPowerExponents p)) π})
      (AddMonoidAlgebra S (pPowerExponents p)) := sorry

theorem discCompletionEquiv_monomial (n k : ℕ) (a : S) :
    discCompletionEquiv S π hπ hp ((disc S π hπ hp).toCompleted n
      (discPolynomial S π (Polynomial.C a * Polynomial.X ^ k))) =
    algebraMap (AddMonoidAlgebra S (pPowerExponents p)) _
      (AddMonoidAlgebra.single (⟨(k : ℚ) * (p : ℚ)⁻¹ ^ n, by
              simpa only [nsmul_eq_mul] using
                (pPowerExponents p).nsmul_mem
                  (AddSubmonoid.subset_closure (Set.mem_range_self n)) k⟩ : pPowerExponents p) a) := sorry

-- Check: frobeniusTower_test_powerMap
example :
    let T := disc S π hπ hp
    (∀ n, Function.Injective (T.toCompleted n)) ∧
      (∀ n, (T.toCompleted (n + 1)).comp (T.transition n) = T.toCompleted n) ∧
      (∀ (n k : ℕ) (a : S),
        discCompletionEquiv S π hπ hp (T.toCompleted n
          (discPolynomial S π (Polynomial.C a * Polynomial.X ^ k))) =
        algebraMap (AddMonoidAlgebra S (pPowerExponents p)) _
          (AddMonoidAlgebra.single
            (⟨(k : ℚ) * (p : ℚ)⁻¹ ^ n, by
              simpa only [nsmul_eq_mul] using
                (pPowerExponents p).nsmul_mem
                  (AddSubmonoid.subset_closure (Set.mem_range_self n)) k⟩ : pPowerExponents p) a)) := sorry

-- Check frobeniusTower_completion_test_disc: the first root maps to exponent 1/p in the completed monoid algebra.
example : discCompletionEquiv S π hπ hp ((disc S π hπ hp).toCompleted 1
      (discPolynomial S π Polynomial.X)) =
    algebraMap (AddMonoidAlgebra S (pPowerExponents p)) _
      (AddMonoidAlgebra.single (⟨(p : ℚ)⁻¹, by
        exact AddSubmonoid.subset_closure ⟨1, pow_one _⟩⟩ : pPowerExponents p) (1 : S)) := sorry

-- Check frobeniusTower_completion_test_needsCompletion: the convergent root series is in no finite generic stage.
example [Nontrivial S] :
    let T := disc S π hπ hp
    ∃ y : T.completed,
      HasSum (fun n : ℕ ↦
        (algebraMap T.completedPlus T.completed T.toIntegralTower.completedParameter) ^ (n+1) *
          algebraMap T.completedPlus T.completed
            (T.toCompleted (n+1) (discPolynomial S π Polynomial.X))) y ∧
      ∀ m, y ∉ Set.range (T.toIntegralTower.genericToCompleted m).toRingHom := sorry

-- Check completedPair_test_zero: the plus ring of a zero completion is the whole zero ring.
example (T : FrobeniusTower p) (h : ∀ n, Subsingleton (T.ring n)) :
    T.completedPair.plus = ⊤ := sorry

-- Check completedPair_test_inverse_not: the inverse of the topologically nilpotent unit is not integral.
example (T : FrobeniusTower p) [Nontrivial T.completed] :
    Ring.inverse (algebraMap T.completedPlus T.completed T.toIntegralTower.completedParameter) ∉
      T.completedPair.plus := sorry

-- Check completedPair_test_field: the constant valuation-ring tower recovers the perfectoid field pair.
example (t : powerBoundedSubring ℂ_[p])
    (ht : t ∈ nonZeroDivisors (powerBoundedSubring ℂ_[p]))
    (htop : IsPseudoUniformizer (t : ℂ_[p])) (hdiv : t ^ p ∣ (p : powerBoundedSubring ℂ_[p]))
    [IsIntegralPerfectoid p (powerBoundedSubring ℂ_[p])]
    [IsAdicComplete (Ideal.span {t}) (powerBoundedSubring ℂ_[p])] :
    let T := constPerfectoid (powerBoundedSubring ℂ_[p]) t ht hdiv
    ∃ e : T.completed ≃+* ℂ_[p],
      e '' T.completedPair.plus = (powerBoundedSubring ℂ_[p] : Set ℂ_[p]) ∧
      ∀ a : powerBoundedSubring ℂ_[p],
        e (algebraMap T.completedPlus T.completed (T.toCompleted 0 a)) = a.val := sorry

-- Check: completed_map_quadratic_root
example (hu : ¬ IsUnit π) :
    let T := disc S π hπ hp
    let x := T.toCompleted 1 (discPolynomial S π Polynomial.X)
    completed_map (discPowerHom S π hπ hp 2) x = x ^ 2 ∧
      completed_map (discPowerHom S π hπ hp 2) x ≠ x ∧
      discCompletionEquiv S π hπ hp (completed_map (discPowerHom S π hπ hp 2) x) =
        algebraMap (AddMonoidAlgebra S (pPowerExponents p)) _
          (AddMonoidAlgebra.single (⟨2 * (p : ℚ)⁻¹, by
            simpa only [nsmul_eq_mul, Nat.cast_ofNat, pow_one] using
              (pPowerExponents p).nsmul_mem
                (AddSubmonoid.subset_closure (Set.mem_range_self 1)) 2⟩ : pPowerExponents p) (1 : S)) := sorry

-- Check completed_map_test_identity: the completed identity fixes a two-term element.
example (T : FrobeniusTower p) :
    completed_map (Hom.id T) (1 + T.toIntegralTower.completedParameter ^ 2) =
      1 + T.toIntegralTower.completedParameter ^ 2 := by
  rw [completed_map_id]
  rfl

-- Check completed_map_test_zero: a map to a zero tower has zero completed image.
example (T U : FrobeniusTower p) (hU : ∀ n, Subsingleton (U.ring n)) (f : Hom T U)
    (x : T.completedPlus) : completed_map f x = 0 := sorry

-- Check completed_map_test_parameter_not: no completed map kills the regular parameter of a nonzero target.
example (T U : FrobeniusTower p) [Nontrivial U.completedPlus] (f : Hom T U) :
    completed_map f T.toIntegralTower.completedParameter ≠ 0 := sorry

-- Check frobeniusMod_test_twoTerms: the finite-stage quotient map acts on both coefficients and exponents.
example (a b : S) :
    (disc S π hπ hp).frobMod 0
      (Ideal.Quotient.mk _ (discPolynomial S π (Polynomial.C a + Polynomial.C b * Polynomial.X))) =
    Ideal.Quotient.mk (Ideal.span {(discPolynomial S π (Polynomial.C π)) ^ p}) (discPolynomial S π
      (Polynomial.C (a ^ p) + Polynomial.C (b ^ p) * Polynomial.X ^ p)) := sorry

-- Check frobeniusMod_test_zero: quotient Frobenius on a zero stage is bijective.
example (T : FrobeniusTower p) (n : ℕ) [Subsingleton (T.ring n)] :
    Function.Bijective (T.frobMod n) := sorry

-- Check frobeniusMod_test_disc_not: a nonzero residue disc has no p-th root of its coordinate.
example (hu : ¬ IsUnit π) : ¬ Function.Surjective ((disc S π hπ hp).frobMod 0) := sorry

end Perfectoid.FrobeniusTower

namespace PerfectoidSpace
open YonedaAdicSpace
variable (p : ℕ) [Fact p.Prime]

/-! ### P7: tilde-limits-affinoid-criterion -/

-- Check isTildeLimit_test_perfectoidDisc: the completed disc tower is a global perfectoid tilde-limit.
example (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] :
    let T := FrobeniusTower.disc S π hπ hp
    IsTildeLimit p T.toIntegralTower.genericDiagram T.toIntegralTower.genericCone := sorry

-- Check: isTildeLimit_test_topology_needed
example (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] (hu : ¬ IsUnit π) :
    let T := FrobeniusTower.disc S π hπ hp
    let D := T.toIntegralTower.genericDiagram
    let c₀ := T.toIntegralTower.genericCone
    ∃ (E : ℕᵒᵖ ⥤ YonedaAdicSpace) (l r : D ⟶ E),
      (∀ n, Nonempty (IsColimit (BinaryCofan.mk (l.app n) (r.app n)))) ∧
      (∀ n, YonedaAdicSpace.IsOpenImmersion (l.app n).hom ∧
        YonedaAdicSpace.IsOpenImmersion (r.app n).hom) ∧
      (let c : Cone E := { pt := c₀.pt, π := c₀.π ≫ l }
       IsPerfectoidSpace p c.pt ∧
        (∀ n, YonedaAdicSpace.IsAnalytic (E.obj n) ∧ AdicSpace.IsHonest (E.obj n)) ∧
        (∀ {i j} (a : i ⟶ j), AdicSpace.Qcqs (E.map a)) ∧
        AdicSpace.HasDenseCharts E c ∧
        Topology.IsEmbedding (fun x : space.obj c.pt ↦ fun n ↦ space.map (c.π.app n) x) ∧
        (∃ y : ∀ n, space.obj (E.obj n),
          (∀ (i j : ℕᵒᵖ) (a : i ⟶ j), space.map (E.map a) (y i) = y j) ∧
          (∀ n, y n ∈ Set.range (space.map (r.app n))) ∧
          y ∉ Set.range (fun x : space.obj c.pt ↦ fun n ↦ space.map (c.π.app n) x)) ∧
        ¬ IsTildeLimit p E c) := sorry

-- Check isResidueFieldTildeLimit_test_disc: the disc over a perfectoid field also satisfies residue density.
example (K : AffinoidField p) (t : powerBoundedSubring K)
    (ht : t ∈ nonZeroDivisors (powerBoundedSubring K))
    (htop : IsPseudoUniformizer (t : K)) (hdiv : t ^ p ∣ (p : powerBoundedSubring K))
    [IsIntegralPerfectoid p (powerBoundedSubring K)]
    [IsAdicComplete (Ideal.span {t}) (powerBoundedSubring K)] :
    let T := FrobeniusTower.disc (powerBoundedSubring K) t ht hdiv
    IsResidueFieldTildeLimit p T.toIntegralTower.genericDiagram T.toIntegralTower.genericCone := sorry

end PerfectoidSpace

namespace PerfectoidSpace
open YonedaAdicSpace
variable (p : ℕ) [Fact p.Prime]

-- Check goodAffinoid_test_disc: the rational disc |T| <= |pi| descends to level zero.
example (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] :
    let T := FrobeniusTower.disc S π hπ hp
    let R := CAff.of (T.genericFibre 0)
    ∃ W : GoodAffinoid p T.toIntegralTower.genericDiagram T.toIntegralTower.genericCone,
      W.level = Opposite.op 0 ∧
      Set.range (space.map W.chart) =
        (space.map (T.toIntegralTower.genericCone.π.app (Opposite.op 0))) ⁻¹'
          {x | let v := ((AdicSpace.affinoidPoints R)
                    (space.map (T.toIntegralTower.genericDiagram_objIso 0).hom x)).down
               v.val.valuation (algebraMap (T.ring 0) (T.toIntegralTower.genericRing 0)
                    (FrobeniusTower.discPolynomial S π Polynomial.X)) ≤
                 v.val.valuation (algebraMap (T.ring 0) (T.toIntegralTower.genericRing 0)
                    (T.parameter 0))} := sorry

-- Check goodAffinoid_test_ecd_limit: the whole affinoid limit is good at every finite level.
example {J : Type} [SmallCategory J] [IsCofiltered J] (X : J ⥤ Perfd p)
    (hX : ∀ i, IsAffinoidPerfectoid p (X.obj i).obj) (i : J) :
    ∃ W : GoodAffinoid p (X ⋙ ObjectProperty.ι (IsPerfectoidSpace p))
      ((ObjectProperty.ι (IsPerfectoidSpace p)).mapCone (cofilteredLimit.cone p X hX)),
      W.level = i ∧ Set.range (space.map W.chart) = Set.univ ∧
        Set.range (space.map W.inclusion) = Set.univ := sorry

end PerfectoidSpace

namespace PerfectoidSpace
open YonedaAdicSpace
variable (p : ℕ) [Fact p.Prime]
variable {I : Type} [Category I] [hcofiltered : IsCofiltered I]

/-- Images of sections on arbitrary finite-level opens, expressed by open immersions.
For a sheafy `R`, `toGlobalFunctions R` identifies its coordinate ring with its sections.
Huber96 Definition 2.4.2(b), p. 125. -/
def openChartImage (D : I ⥤ YonedaAdicSpace) (c : Cone D) (R : CAff)
    (u : ofSpaY R ⟶ c.pt) : Set R.A :=
  {r | ∃ (i : I) (V : YonedaAdicSpace) (v : V ⟶ D.obj i) (f : ofSpaY R ⟶ V),
    YonedaAdicSpace.IsOpenImmersion v.hom ∧ f ≫ v = u ≫ c.π.app i ∧
      ∃ s : globalFunctions V, globalFunctions.map f s = toGlobalFunctions R r}

-- Check: openChartImage_constant
example (R : CAff) :
    openChartImage _ (AdicSpace.singletonCone (𝟙 (ofSpaY R))) R (𝟙 _) = Set.univ := sorry

-- Check: openChartImage_zero
include hcofiltered in
example (D : I ⥤ YonedaAdicSpace) (c : Cone D) (R : CAff)
    [Subsingleton R.A] (u : ofSpaY R ⟶ c.pt) :
    openChartImage D c R u = {0} := sorry

-- Check: openChartImage_nondense
example (f : CAff.of (Pair.powerBounded ℚ_[p]) ⟶ CAff.of (Pair.powerBounded ℂ_[p])) :
    ¬ Dense (openChartImage _ (AdicSpace.singletonCone
      (ObjectProperty.homMk (spaYFunctor.map f.op) :
        ofSpaY (CAff.of (Pair.powerBounded ℂ_[p])) ⟶
          ofSpaY (CAff.of (Pair.powerBounded ℚ_[p]))))
      (CAff.of (Pair.powerBounded ℂ_[p])) (𝟙 _)) := sorry

include hcofiltered in
/-- Huber's two conditions on qcqs honest analytic spaces, with a perfectoid apex.
The homeomorphism uses the cone projections and the section images range over all opens.
This is the adic-space specialization of Huber96 Definition 2.4.2, p. 125;
the affinoid-open formulation is SW13 Definition 2.4.1, pp. 19–20. -/
theorem IsTildeLimit.toHuber (D : I ⥤ YonedaAdicSpace) (c : Cone D)
    (hX : IsPerfectoidSpace p c.pt)
    (ha : ∀ i, YonedaAdicSpace.IsAnalytic (D.obj i))
    (hh : ∀ i, AdicSpace.IsHonest (D.obj i))
    (hq : ∀ {i j} (a : i ⟶ j), AdicSpace.Qcqs (D.map a))
    [CompactSpace (space.obj c.pt)] [QuasiSeparatedSpace (space.obj c.pt)]
    [∀ i, CompactSpace (space.obj (D.obj i))]
    [∀ i, QuasiSeparatedSpace (space.obj (D.obj i))] :
    IsTildeLimit p D c ↔
      (∃ e : space.obj c.pt ≃ₜ {y : ∀ i, space.obj (D.obj i) |
        ∀ (i j : I) (a : i ⟶ j), space.map (D.map a) (y i) = y j},
        ∀ x i, (e x).val i = space.map (c.π.app i) x) ∧
      ∀ x : space.obj c.pt, ∃ (R : CAff) (u : ofSpaY R ⟶ c.pt),
        CAff.Sheafy R ∧ YonedaAdicSpace.IsOpenImmersion u.hom ∧
          x ∈ Set.range (space.map u) ∧ Dense (openChartImage D c R u) := sorry

include hcofiltered in
/-- Sections from arbitrary finite-level opens are dense on a sheafy affinoid cover.
SW13 Definition 2.4.1, pp. 19–20, compared with Huber96 Definition 2.4.2(b), p. 125. -/
theorem IsTildeLimit.dense {D : I ⥤ YonedaAdicSpace} {c : Cone D}
    (h : IsTildeLimit p D c) :
    ∀ x : space.obj c.pt, ∃ (R : CAff) (u : ofSpaY R ⟶ c.pt),
      CAff.Sheafy R ∧ YonedaAdicSpace.IsOpenImmersion u.hom ∧
        x ∈ Set.range (space.map u) ∧ Dense (openChartImage D c R u) := sorry

-- Check: isTildeLimit_test_huber_compat
include hcofiltered in
example (D : I ⥤ YonedaAdicSpace) (c : Cone D)
    (hX : IsPerfectoidSpace p c.pt)
    (ha : ∀ i, YonedaAdicSpace.IsAnalytic (D.obj i))
    (hh : ∀ i, AdicSpace.IsHonest (D.obj i))
    (hq : ∀ {i j} (a : i ⟶ j), AdicSpace.Qcqs (D.map a))
    [CompactSpace (space.obj c.pt)] [QuasiSeparatedSpace (space.obj c.pt)]
    [∀ i, CompactSpace (space.obj (D.obj i))]
    [∀ i, QuasiSeparatedSpace (space.obj (D.obj i))] :
    IsTildeLimit p D c ↔
      (∃ e : space.obj c.pt ≃ₜ {y : ∀ i, space.obj (D.obj i) |
        ∀ (i j : I) (a : i ⟶ j), space.map (D.map a) (y i) = y j},
        ∀ x i, (e x).val i = space.map (c.π.app i) x) ∧
      ∀ x : space.obj c.pt, ∃ (R : CAff) (u : ofSpaY R ⟶ c.pt),
        CAff.Sheafy R ∧ YonedaAdicSpace.IsOpenImmersion u.hom ∧
          x ∈ Set.range (space.map u) ∧ Dense (openChartImage D c R u) :=
  IsTildeLimit.toHuber p D c hX ha hh hq

theorem IsTildeLimit.const (X : Perfd p) :
    IsTildeLimit p _ (AdicSpace.singletonCone (𝟙 X.obj)) := sorry

theorem IsTildeLimit.ofIso {D : I ⥤ YonedaAdicSpace} {c d : Cone D}
    (h : IsTildeLimit p D c) (e : c ≅ d) : IsTildeLimit p D d := sorry

/-! ### P7/tilde-limit-cofinal-change -/

theorem IsTildeLimit.reindex {J : Type} [Category J] [IsCofiltered J]
    (u : J ⥤ I) [u.Initial] (D : I ⥤ YonedaAdicSpace) (c : Cone D)
    (ha : ∀ i, YonedaAdicSpace.IsAnalytic (D.obj i)) (hh : ∀ i, AdicSpace.IsHonest (D.obj i))
    (hq : ∀ {i j} (a : i ⟶ j), AdicSpace.Qcqs (D.map a)) :
    IsTildeLimit p (u ⋙ D) (c.whisker u) ↔ IsTildeLimit p D c := sorry

/-- A chosen cofinal family computes the same perfectoid tilde-limit when every level
of the full tower is analytic and honest and every transition is qcqs. -/
theorem CofinalityWitness.isTildeLimit_iff
    {G : Type} [Group G] [TopologicalSpace G]
    {J : Type} [Category J] [IsCofiltered J]
    (F : LevelFamily J G) (w : CofinalityWitness F)
    (D : CompactOpenSubgroup G ⥤ YonedaAdicSpace) (c : Cone D)
    [IsCofiltered (CompactOpenSubgroup G)]
    (ha : ∀ K, YonedaAdicSpace.IsAnalytic (D.obj K))
    (hh : ∀ K, AdicSpace.IsHonest (D.obj K))
    (hq : ∀ {K K'} (a : K ⟶ K'), AdicSpace.Qcqs (D.map a)) :
    IsTildeLimit p D c ↔ IsTildeLimit p (F.functor ⋙ D) (c.whisker F.functor) := by
  let : F.functor.Initial := CofinalityWitness.initial F w
  exact (IsTildeLimit.reindex p F.functor D c ha hh hq).symm

-- Check cofinalityWitness_nonanalyticLevel: every level of the full tower must be analytic.
example {G : Type} [Group G] [TopologicalSpace G]
    (D : CompactOpenSubgroup G ⥤ YonedaAdicSpace) (c : Cone D)
    (K : CompactOpenSubgroup G) (hK : ¬ YonedaAdicSpace.IsAnalytic (D.obj K)) :
    ¬ IsTildeLimit p D c := fun h ↦ hK (h.2.levels_analytic K)

-- Check cofinalityWitness_nonhonestLevel: honesty is required outside the chosen family too.
example {G : Type} [Group G] [TopologicalSpace G]
    (D : CompactOpenSubgroup G ⥤ YonedaAdicSpace) (c : Cone D)
    (K : CompactOpenSubgroup G) (hK : ¬ AdicSpace.IsHonest (D.obj K)) :
    ¬ IsTildeLimit p D c := fun h ↦ hK (h.2.levels_honest K)

-- Check cofinalityWitness_nonqcqsTransition: every transition of the full tower must be qcqs.
example {G : Type} [Group G] [TopologicalSpace G]
    (D : CompactOpenSubgroup G ⥤ YonedaAdicSpace) (c : Cone D)
    {K K' : CompactOpenSubgroup G} (a : K ⟶ K') (ha : ¬ AdicSpace.Qcqs (D.map a)) :
    ¬ IsTildeLimit p D c := fun h ↦ ha (h.2.transitions_qcqs a)

/-! ### P7/tilde-limit-base-change-comparison -/

-- AdicSpacesPartIV R5 supplies AdicSpace.IsTildeLimit.baseChange.
-- IsTildeLimit.etale_baseChange below is the perfectoid specialization.

/-! ### P7/tilde-limit-etale-base-change -/

/-- Perfectoidness of an étale pullback, together with the Yoneda transport of
PartIV R5's `IsTildeLimit.baseChange`. Apply that supplier on qcqs charts and
transport by `AdicSpace.IsTildeLimit.ofAdicSpace_iff`; perfectoidness is P3.15.
SW13 Proposition 2.4.3, p. 20; Sch12 Theorem 7.9, pp. 42–43. -/
theorem IsTildeLimit.etale_baseChange {D : I ⥤ YonedaAdicSpace} {c : Cone D}
    (hc : IsTildeLimit p D c) (i : I) {Y : YonedaAdicSpace} (g : Y ⟶ D.obj i)
    (hg : YonedaAdicSpace.IsEtaleLocalDescription g)
    (E : Over i ⥤ YonedaAdicSpace) (a : E ⟶ (Over.forget i ⋙ D))
    (b : E ⟶ (Functor.const (Over i)).obj Y)
    (hsq : ∀ j : Over i, IsPullback (a.app j) (b.app j) (D.map j.hom) g)
    (d : Cone E) (u : d.pt ⟶ c.pt) (v : d.pt ⟶ Y)
    (hlim : IsPullback u v (c.π.app i) g)
    (ha : ∀ j : Over i, d.π.app j ≫ a.app j = u ≫ c.π.app j.left)
    (hb : ∀ j : Over i, d.π.app j ≫ b.app j = v) : IsTildeLimit p E d := sorry

/-! ### P7/tilde-limit-finite-etale-base-change -/

/-- The finite étale case of `IsTildeLimit.etale_baseChange`, using
AdicEtaleGeometry's finite étale predicate. SW13 Proposition 2.4.3, p. 20. -/
theorem IsTildeLimit.finiteEtale_baseChange {D : I ⥤ YonedaAdicSpace} {c : Cone D}
    (hc : IsTildeLimit p D c) (i : I) {Y : YonedaAdicSpace} (g : Y ⟶ D.obj i)
    (hg : YonedaAdicSpace.IsFiniteEtale g)
    (E : Over i ⥤ YonedaAdicSpace) (a : E ⟶ (Over.forget i ⋙ D))
    (b : E ⟶ (Functor.const (Over i)).obj Y)
    (hsq : ∀ j : Over i, IsPullback (a.app j) (b.app j) (D.map j.hom) g)
    (d : Cone E) (u : d.pt ⟶ c.pt) (v : d.pt ⟶ Y)
    (hlim : IsPullback u v (c.π.app i) g)
    (ha : ∀ j : Over i, d.π.app j ≫ a.app j = u ≫ c.π.app j.left)
    (hb : ∀ j : Over i, d.π.app j ≫ b.app j = v) : IsTildeLimit p E d :=
  IsTildeLimit.etale_baseChange p hc i g (by sorry) E a b hsq d u v hlim ha hb

/-! ### P7/tilde-limit-rational-restriction -/

/-- The open-immersion case of `IsTildeLimit.etale_baseChange`, including
empty and rational opens. SW13 Proposition 2.4.3, p. 20. -/
theorem IsTildeLimit.open_baseChange {D : I ⥤ YonedaAdicSpace} {c : Cone D}
    (hc : IsTildeLimit p D c) (i : I) {Y : YonedaAdicSpace} (g : Y ⟶ D.obj i)
    (hg : YonedaAdicSpace.IsOpenImmersion g.hom)
    (E : Over i ⥤ YonedaAdicSpace) (a : E ⟶ (Over.forget i ⋙ D))
    (b : E ⟶ (Functor.const (Over i)).obj Y)
    (hsq : ∀ j : Over i, IsPullback (a.app j) (b.app j) (D.map j.hom) g)
    (d : Cone E) (u : d.pt ⟶ c.pt) (v : d.pt ⟶ Y)
    (hlim : IsPullback u v (c.π.app i) g)
    (ha : ∀ j : Over i, d.π.app j ≫ a.app j = u ≫ c.π.app j.left)
    (hb : ∀ j : Over i, d.π.app j ≫ b.app j = v) : IsTildeLimit p E d :=
  IsTildeLimit.etale_baseChange p hc i g (by sorry) E a b hsq d u v hlim ha hb

/-! ### P7/tilde-limit-gluing -/
/-- Gluing over a cover of one finite stage, Torsion III.3 after Definition III.3.5. -/
theorem exists_tildeLimit_of_open_cover (D : I ⥤ YonedaAdicSpace)
    (ha : ∀ i, YonedaAdicSpace.IsAnalytic (D.obj i))
    (hh : ∀ i, AdicSpace.IsHonest (D.obj i))
    (hq : ∀ {i j} (a : i ⟶ j), AdicSpace.Qcqs (D.map a))
    (i : I) {A : Type} (V : A → YonedaAdicSpace) (v : ∀ a, V a ⟶ D.obj i)
    (ho : ∀ a, YonedaAdicSpace.IsOpenImmersion (v a).hom)
    (hcover : ∀ x : space.obj (D.obj i), ∃ a, x ∈ Set.range (space.map (v a)))
    (E : A → Over i ⥤ YonedaAdicSpace)
    (a : ∀ k, E k ⟶ Over.forget i ⋙ D)
    (b : ∀ k, E k ⟶ (Functor.const (Over i)).obj (V k))
    (hsq : ∀ k (j : Over i), IsPullback ((a k).app j) ((b k).app j)
      (D.map j.hom) (v k))
    (d : ∀ k, Cone (E k)) (hd : ∀ k, IsTildeLimit p (E k) (d k)) :
    ∃ c : Cone D, IsTildeLimit p D c := sorry

/-- Locality uses the pullbacks of both the finite-stage cover and the given cone. -/
theorem isTildeLimit_iff_open_cover (D : I ⥤ YonedaAdicSpace) (c : Cone D)
    (hp : IsPerfectoidSpace p c.pt)
    (ha : ∀ i, YonedaAdicSpace.IsAnalytic (D.obj i))
    (hh : ∀ i, AdicSpace.IsHonest (D.obj i))
    (hq : ∀ {i j} (a : i ⟶ j), AdicSpace.Qcqs (D.map a))
    (i : I) {A : Type} (V : A → YonedaAdicSpace) (v : ∀ a, V a ⟶ D.obj i)
    (ho : ∀ a, YonedaAdicSpace.IsOpenImmersion (v a).hom)
    (hcover : ∀ x : space.obj (D.obj i), ∃ a, x ∈ Set.range (space.map (v a)))
    (E : A → Over i ⥤ YonedaAdicSpace)
    (a : ∀ k, E k ⟶ Over.forget i ⋙ D)
    (b : ∀ k, E k ⟶ (Functor.const (Over i)).obj (V k))
    (hsq : ∀ k (j : Over i), IsPullback ((a k).app j) ((b k).app j)
      (D.map j.hom) (v k))
    (d : ∀ k, Cone (E k)) (u : ∀ k, (d k).pt ⟶ c.pt) (w : ∀ k, (d k).pt ⟶ V k)
    (hlim : ∀ k, IsPullback (u k) (w k) (c.π.app i) (v k))
    (hcomm : ∀ k (j : Over i),
      (d k).π.app j ≫ (a k).app j = u k ≫ c.π.app j.left ∧
      (d k).π.app j ≫ (b k).app j = w k) :
    IsTildeLimit p D c ↔ ∀ k, IsTildeLimit p (E k) (d k) := sorry

/-! ### P7/residue-field-tilde-limit-etale-base-change -/
/-- Sch12 Proposition 7.16: étale pullbacks preserve residue-field tilde-limits. -/
theorem IsResidueFieldTildeLimit.etale_baseChange {D : I ⥤ YonedaAdicSpace} {c : Cone D}
    (hc : IsResidueFieldTildeLimit p D c) (i : I) {Y : YonedaAdicSpace} (g : Y ⟶ D.obj i)
    (hg : YonedaAdicSpace.IsEtaleLocalDescription g)
    (hY : CompactSpace (space.obj Y)) (hqY : QuasiSeparatedSpace (space.obj Y))
    (E : Over i ⥤ YonedaAdicSpace) (a : E ⟶ (Over.forget i ⋙ D))
    (b : E ⟶ (Functor.const (Over i)).obj Y)
    (hsq : ∀ j : Over i, IsPullback (a.app j) (b.app j) (D.map j.hom) g)
    (d : Cone E) (u : d.pt ⟶ c.pt) (v : d.pt ⟶ Y)
    (hlim : IsPullback u v (c.π.app i) g)
    (ha : ∀ j : Over i, d.π.app j ≫ a.app j = u ≫ c.π.app j.left)
    (hb : ∀ j : Over i, d.π.app j ≫ b.app j = v) :
    IsResidueFieldTildeLimit p E d := sorry

/-! ### P7/limit-of-perfectoid-tower -/

/-- ECD 6.5 and BHW 5.11: affinoid inverse images allow the affinoid limits to glue. -/
theorem exists_limit_of_affinoid_transitions {J : Type} [SmallCategory J] [IsCofiltered J]
    (D : J ⥤ Perfd p)
    (ha : ∀ (i j : J) (a : i ⟶ j) (U : TopologicalSpace.Opens (underlyingPoints p (D.obj j))),
      IsAffinoidPerfectoid p (restrict p (D.obj j) U).obj →
        IsAffinoidPerfectoid p (restrict p (D.obj i)
          (U.comap (pointMap p (D.map a)).hom)).obj) :
    ∃ c : Cone D, Nonempty (IsLimit c) ∧ IsTildeLimit p
      (D ⋙ ObjectProperty.ι (IsPerfectoidSpace p))
      ((ObjectProperty.ι (IsPerfectoidSpace p)).mapCone c) := sorry

theorem IsTildeLimit.spectralSpace {D : I ⥤ YonedaAdicSpace} {c : Cone D}
    (h : IsTildeLimit p D c) (hc : ∀ i, CompactSpace (space.obj (D.obj i)))
    (hs : ∀ i, QuasiSeparatedSpace (space.obj (D.obj i))) : SpectralSpace (space.obj c.pt) := sorry

def IsResidueFieldTildeLimit.homeomorph {D : I ⥤ YonedaAdicSpace} {c : Cone D}
    (h : IsResidueFieldTildeLimit p D c) :
    space.obj c.pt ≃ₜ {y : ∀ i, space.obj (D.obj i) |
      ∀ (i j : I) (a : i ⟶ j), space.map (D.map a) (y i) = y j} := sorry

theorem IsResidueFieldTildeLimit.homeomorph_apply {D : I ⥤ YonedaAdicSpace} {c : Cone D}
    (h : IsResidueFieldTildeLimit p D c) (x : space.obj c.pt) (i : I) :
    (h.homeomorph p x).val i = space.map (c.π.app i) x := sorry

/-! ### P7/good-affinoid-raise -/

/-- Raising a good chart changes its finite-level open to the inverse image. -/
def GoodAffinoid.raise {I : Type} [Category I] [IsCofiltered I] {D : I ⥤ YonedaAdicSpace}
    {c : Cone D} (W : GoodAffinoid p D c) (j : I) (a : j ⟶ W.level)
    (hq : AdicSpace.Qcqs (D.map a)) : GoodAffinoid p D c := sorry

theorem GoodAffinoid.raise_spec {D : I ⥤ YonedaAdicSpace} {c : Cone D}
    (W : GoodAffinoid p D c) (j : I) (a : j ⟶ W.level)
    (hq : AdicSpace.Qcqs (D.map a)) :
    ∃ hlevel : (W.raise p j a hq).level = j,
      Set.range (space.map (W.raise p j a hq).chart) = Set.range (space.map W.chart) ∧
      Set.range (space.map ((W.raise p j a hq).inclusion ≫
        eqToHom (congrArg D.obj hlevel))) =
        space.map (D.map a) ⁻¹' Set.range (space.map W.inclusion) := sorry

end PerfectoidSpace

namespace Perfectoid.FrobeniusTower
variable {p : ℕ} [Fact p.Prime]

-- Check shift_test_zero: dropping no stages fixes a two-term completed element.
example (T : FrobeniusTower p) :
    completed_shift T 0 (1 + (T.shift 0).toIntegralTower.completedParameter ^ 2) =
      1 + T.toIntegralTower.completedParameter ^ 2 := sorry

-- Check shift_test_start: dropping past the first valid index makes every remaining lift available.
example (T : FrobeniusTower p) (k : ℕ) (h : T.start ≤ k) : (T.shift k).start = 0 := by
  exact Nat.sub_eq_zero_of_le h

-- Check shift_test_empty: deleting a finite prefix of a zero tower leaves zero completion.
example (T : FrobeniusTower p) (h : ∀ n, Subsingleton (T.ring n)) (k : ℕ) :
    Subsingleton (T.shift k).completed := sorry

end Perfectoid.FrobeniusTower

namespace RegularTower
variable (p : ℕ) [Fact p.Prime]

/-- The integral unramified coefficient extension used in Cesnavicius 5.1, pp. 11–12.
The extension need not be complete; every element belongs to a finite DVR subextension. -/
theorem coefficient_extension (k : Type) [Field k] [CharP k p] (W : CohenDVR p k) :
    ∃ (V : Type) (_ : CommRing V) (_ : IsDomain V) (_ : IsDiscreteValuationRing V)
      (_ : Algebra W.ring V),
      Algebra.IsIntegral W.ring V ∧
      IsLocalRing.maximalIdeal V = Ideal.span {(p : V)} ∧
      Nonempty (IsLocalRing.ResidueField V ≃+* AlgebraicClosure k) ∧
      ∀ v : V, ∃ B : Subalgebra W.ring V,
        v ∈ B ∧ Module.Finite W.ring B ∧ Module.Flat W.ring B ∧
          ∃ h : IsDiscreteValuationRing B,
            @IsLocalRing.maximalIdeal B _ h.toIsLocalRing = Ideal.span {(p : B)} := sorry

/-- Finite coefficient extensions act coefficientwise on power series. -/
def powerSeriesDiagram {J : Type} [SmallCategory J] (D : J ⥤ CommRingCat) (n : ℕ) :
    J ⥤ CommRingCat where
  obj j := CommRingCat.of (MvPowerSeries (Fin n) (D.obj j))
  map f := CommRingCat.ofHom (MvPowerSeries.map (D.map f).hom)
  map_id := by sorry
  map_comp := by sorry

/-- Completion of a filtered union of coefficient fields commutes with finite-variable
power series; the ideal is generated by the variables, not by the zero maximal ideal of k. -/
theorem powerSeries_colimit_field {J : Type} [SmallCategory J] [IsFiltered J]
    (D : J ⥤ CommRingCat) (hfield : ∀ j, IsField (D.obj j))
    (k : Type) [Field k] (ι : (Functor.const J).obj (CommRingCat.of k) ⟶ D)
    (hfin : ∀ j, letI : Algebra k (D.obj j) := (ι.app j).hom.toAlgebra
      Module.Finite k (D.obj j)) (n : ℕ) (j₀ : J) :
    let E := powerSeriesDiagram D n
    let L := (colimit E : CommRingCat)
    let m : Ideal L := Ideal.span (Set.range (fun r : Fin n ↦
      (colimit.ι E j₀).hom (MvPowerSeries.X r)))
    Nonempty (AdicCompletion m L ≃+* MvPowerSeries (Fin n) ↑(colimit D : CommRingCat)) := sorry

/-- In mixed characteristic the completion uses (p, variables); coefficients themselves
must first be completed p-adically. -/
theorem powerSeries_colimit_cohen {J : Type} [SmallCategory J] [IsFiltered J]
    (D : J ⥤ CommRingCat) [∀ j, IsDomain (D.obj j)]
    [∀ j, IsDiscreteValuationRing (D.obj j)]
    (hmax : ∀ j, IsLocalRing.maximalIdeal (D.obj j) = Ideal.span {(p : D.obj j)})
    (hcomplete : ∀ j, IsAdicComplete (Ideal.span {(p : D.obj j)}) (D.obj j))
    (k : Type) [Field k] (W : CohenDVR p k)
    (ι : (Functor.const J).obj (CommRingCat.of W.ring) ⟶ D)
    (hfin : ∀ j, letI : Algebra W.ring (D.obj j) := (ι.app j).hom.toAlgebra
      Module.Finite W.ring (D.obj j) ∧ Module.Flat W.ring (D.obj j)) (n : ℕ) (j₀ : J) :
    let E := powerSeriesDiagram D n
    let L := (colimit E : CommRingCat)
    let V := (colimit D : CommRingCat)
    let m : Ideal L := Ideal.span (insert (p : L) (Set.range (fun r : Fin n ↦
      (colimit.ι E j₀).hom (MvPowerSeries.X r))))
    Nonempty (AdicCompletion m L ≃+*
      MvPowerSeries (Fin n) (AdicCompletion (Ideal.span {(p : V)}) V)) := sorry

/-- The p-power-rank refinement when the residue field is separably closed. -/
theorem exists_residueTower_primePower (R : Type) [CommRing R] [IsRegularLocalRing R]
    [IsAdicComplete (IsLocalRing.maximalIdeal R) R]
    [CharP (IsLocalRing.ResidueField R) p] [IsSepClosed (IsLocalRing.ResidueField R)] :
    ∃ (J : Type) (_ : SmallCategory J) (_ : IsFiltered J) (D : J ⥤ CommRingCat)
      (ι : (Functor.const J).obj (CommRingCat.of R) ⟶ D),
      (∀ j, letI : Algebra R (D.obj j) := (ι.app j).hom.toAlgebra
        Module.Finite R (D.obj j) ∧ Module.Flat R (D.obj j) ∧
        IsRegularLocalRing (D.obj j) ∧ (∃ e : ℕ, Module.finrank R (D.obj j) = p ^ e) ∧
        ∃ h : IsLocalRing (D.obj j),
          (IsLocalRing.maximalIdeal R).map (ι.app j).hom = @IsLocalRing.maximalIdeal _ _ h) ∧
      ∃ h : IsRegularLocalRing ↑(colimit D : CommRingCat),
        letI := h
        IsAlgClosed (IsLocalRing.ResidueField ↑(colimit D : CommRingCat)) ∧
          ∀ j, (IsLocalRing.maximalIdeal R).map
            ((colimit.ι D j).hom.comp (ι.app j).hom) =
              IsLocalRing.maximalIdeal ↑(colimit D : CommRingCat) := sorry

end RegularTower


namespace Perfectoid.IntegralTower
variable {p : ℕ} (T : IntegralTower p)

/-- The map of generic fibres iterates the consecutive transition maps. -/
def genericMap {m n : ℕ} (a : m ⟶ n) : Pair.Hom (T.genericFibre m) (T.genericFibre n) :=
  Nat.leRecOn (leOfHom a) (fun {n} f ↦ (T.genericTransition n).comp f) (Pair.Hom.id _)

/-- The quotient diagram uses the induced transition maps on every parameter-power quotient. -/
def quotientDiagram (k : ℕ) : ℕ ⥤ CommRingCat where
  obj n := CommRingCat.of (T.quotient n k)
  map a := CommRingCat.ofHom
    (Nat.leRecOn (leOfHom a) (fun {n} f ↦ (T.quotientMap n k).comp f) (RingHom.id _))
  map_id := by sorry
  map_comp := by sorry

/-- Quotienting the algebraic colimit agrees with the colimit of the quotient rings. -/
def quotientColimit (k : ℕ) :
    T.colimitRing ⧸ Ideal.span {T.colimitParameter ^ k} ≃+*
      ↑(colimit (T.quotientDiagram k) : CommRingCat) := sorry

theorem quotientColimit_mk (k n : ℕ) (a : T.ring n) :
    T.quotientColimit k (Ideal.Quotient.mk _ (T.toColimit n a)) =
      (colimit.ι (T.quotientDiagram k) n).hom (Ideal.Quotient.mk _ a) := sorry

end Perfectoid.IntegralTower

namespace Perfectoid.FrobeniusTower
variable {p : ℕ} [Fact p.Prime]

/-- The completed pair satisfies `PerfectoidSpace.IsCompletedColimitOfTower`
for the generic-fibre diagram and its canonical maps. -/
theorem isCompletedDirectLimit (T : FrobeniusTower p) :
    PerfectoidSpace.IsCompletedColimitOfTower (J := ℕ)
      (fun n ↦ T.genericFibre n) (fun a ↦ T.toIntegralTower.genericMap a)
      T.completedPair (fun n ↦ T.toIntegralTower.genericToCompleted n)
      (fun n ↦ (algebraMap (T.ring n) (T.toIntegralTower.genericRing n)).range)
      (algebraMap T.completedPlus T.completed T.toIntegralTower.completedParameter) := sorry

/-- Quotients of the completed model are the colimits of the finite-stage quotients. -/
def completedPlus_quotient (T : FrobeniusTower p) (k : ℕ) (hk : 0 < k) :
    T.completedPlus ⧸ Ideal.span {T.toIntegralTower.completedParameter ^ k} ≃+*
      ↑(colimit (T.toIntegralTower.quotientDiagram k) : CommRingCat) :=
  (T.toIntegralTower.completedPlus_quotient k hk).trans (T.toIntegralTower.quotientColimit k)

theorem completedPlus_quotient_stage (T : FrobeniusTower p) (k : ℕ) (hk : 0 < k)
    (n : ℕ) (a : T.ring n) :
    T.completedPlus_quotient k hk (Ideal.Quotient.mk _ (T.toCompleted n a)) =
      (colimit.ι (T.toIntegralTower.quotientDiagram k) n).hom (Ideal.Quotient.mk _ a) := sorry

-- Check completedQuotient_test_zeroPower: exponent zero kills every finite-stage quotient.
example (T : FrobeniusTower p) :
    Subsingleton ↑(colimit (T.toIntegralTower.quotientDiagram 0) : CommRingCat) := sorry

-- Check completedQuotient_test_parameter: the first-power quotient kills the common parameter.
example (T : FrobeniusTower p) :
    T.completedPlus_quotient 1 (by decide)
      (Ideal.Quotient.mk _ T.toIntegralTower.completedParameter) = 0 := sorry

-- Check completedQuotient_test_twoTerms: degree two in the marked parameter vanishes modulo its square.
example (T : FrobeniusTower p) :
    T.completedPlus_quotient 2 (by decide)
      (Ideal.Quotient.mk _ (1 + T.toIntegralTower.completedParameter ^ 2)) = 1 := sorry

-- Check constPerfectoid_test_zero: completion of the actual constant zero tower remains zero.
example (S : Type) [CommRing S] [Subsingleton S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] :
    Subsingleton (constPerfectoid S π hπ hp).completed := sorry

-- Check constPerfectoid_test_lift_twoTerms: the constant quotient lift raises both summands to p-th powers.
example (S : Type) [CommRing S] [IsIntegralPerfectoid p S]
    (π : S) (hπ : π ∈ nonZeroDivisors S) (hp : π ^ p ∣ (p : S))
    [IsAdicComplete (Ideal.span {π}) S] (a b : S) :
    (constPerfectoid S π hπ hp).lift 0 (by change (0 : ℕ) ≤ 0; exact Nat.le_refl 0)
      (Ideal.Quotient.mk _ (show S from a + b)) =
        Ideal.Quotient.mk (Ideal.span {π ^ p}) (a ^ p + b ^ p) := sorry

end Perfectoid.FrobeniusTower

namespace Perfectoid.FrobeniusTower
variable {p : ℕ} [Fact p.Prime]

/-- When the generic fibres are perfectoid, regard the same diagram as a diagram in Perfd. -/
def perfectoidDiagram (T : FrobeniusTower p)
    (hP : ∀ n : ℕᵒᵖ, PerfectoidSpace.IsPerfectoidSpace p
      (T.toIntegralTower.genericDiagram.obj n)) : ℕᵒᵖ ⥤ PerfectoidSpace.Perfd p where
  obj n := ⟨T.toIntegralTower.genericDiagram.obj n, hP n⟩
  map a := ObjectProperty.homMk (T.toIntegralTower.genericDiagram.map a)
  map_id := by sorry
  map_comp := by sorry

-- Check frobeniusTower_completion_test_ecd: the completed generic fibre agrees with the P5 limit,
-- and the comparison is fixed by every projection.
example (T : FrobeniusTower p)
    (hP : ∀ n : ℕᵒᵖ, PerfectoidSpace.IsPerfectoidSpace p
      (T.toIntegralTower.genericDiagram.obj n))
    (hA : ∀ n, PerfectoidSpace.IsAffinoidPerfectoid p ((T.perfectoidDiagram hP).obj n).obj) :
    ∃ e : T.toIntegralTower.genericCone.pt ≅
        (PerfectoidSpace.cofilteredLimit p (T.perfectoidDiagram hP) hA).obj,
      ∀ n, e.hom ≫ (PerfectoidSpace.cofilteredLimit.π p (T.perfectoidDiagram hP) hA n).hom =
        T.toIntegralTower.genericCone.π.app n := sorry

end Perfectoid.FrobeniusTower

namespace PerfectoidSpace
open YonedaAdicSpace
variable (p : ℕ) [Fact p.Prime]

-- Check isPreperfectoid_test_disc_not: the finite ordinary disc is not preperfectoid.
example (K : AffinoidField p) (t : powerBoundedSubring K)
