/-! ### Layer 4: The Gauss completed rational-function field -/
namespace PerfectoidSpace
open Perfectoid
variable (p : ℕ) [Fact p.Prime] (K : AffinoidField p)

/-- The field of rational functions in all compatible p-power roots of one variable. -/
abbrev gaussRationalField := FractionRing (AddMonoidAlgebra K (pPowerExponents p))

/-- The Gauss valuation is fixed by the maximum coefficient norm on the polynomial subring. -/
def gaussRationalValuation : Valuation (gaussRationalField p K) NNReal := sorry

theorem gaussRationalValuation_polynomial (f : AddMonoidAlgebra K (pPowerExponents p)) :
    gaussRationalValuation p K (algebraMap (AddMonoidAlgebra K (pPowerExponents p)) (gaussRationalField p K) f) =
      f.coeff.support.sup (fun e ↦ ‖f.coeff e‖₊) := sorry

abbrev gaussCompletion := UniformSpace.Completion (WithVal (gaussRationalValuation p K))

theorem residueField_gauss_completion (π : PseudoUniformizerRoots p K) :
    ∃ e : CompletedResidue p (discPair p K π) (gaussPoint p K π) ≃+* gaussCompletion p K,
      Continuous e ∧ Continuous e.symm ∧ ∀ a : K,
        e (residueMap p (discPair p K π) (gaussPoint p K π)
          (algebraMap K (perfectedTateAlgebra p π Unit) a)) =
        UniformSpace.Completion.coeRingHom
          (algebraMap (AddMonoidAlgebra K (pPowerExponents p))
            (WithVal (gaussRationalValuation p K)) (AddMonoidAlgebra.single 0 a)) := sorry

-- Check: gaussRational_constant
example (a : K) : gaussRationalValuation p K
    (algebraMap (AddMonoidAlgebra K (pPowerExponents p)) (gaussRationalField p K) (AddMonoidAlgebra.single 0 a)) = ‖a‖₊ := sorry
-- Check: gaussRational_two_terms
example (a b : K) (r s : pPowerExponents p) (hrs : r ≠ s) :
    gaussRationalValuation p K (algebraMap (AddMonoidAlgebra K (pPowerExponents p)) (gaussRationalField p K)
      (AddMonoidAlgebra.single r a + AddMonoidAlgebra.single s b)) = max ‖a‖₊ ‖b‖₊ := sorry
-- Check: gaussRational_inverse_monomial
example (r : pPowerExponents p) :
    gaussRationalValuation p K
      ((algebraMap (AddMonoidAlgebra K (pPowerExponents p)) (gaussRationalField p K) (AddMonoidAlgebra.single r (1 : K)))⁻¹) = 1 := sorry
-- Check: gaussCompletion_nonzero
example : (1 : gaussCompletion p K) ≠ 0 := sorry
-- Check: gaussCompletion_constants
example : Function.Injective
    (fun a : K ↦ (UniformSpace.Completion.coeRingHom
      (algebraMap (AddMonoidAlgebra K (pPowerExponents p))
        (WithVal (gaussRationalValuation p K)) (AddMonoidAlgebra.single 0 a)) : gaussCompletion p K)) := sorry
