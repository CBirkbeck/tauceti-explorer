/-- The sheaf categories are equivalent for the jointly-surjective topologies. -/
def etaleTiltSheafEquiv (X : Perfd p) :
    Sheaf (smallEtaleTopology p X) (Type 2) ≌
      Sheaf (smallEtaleTopology p ((tiltFunctor p).obj X)) (Type 2) := by
  let e := (etaleTiltFunctor p X).asEquivalence
  letI : e.functor.IsDenseSubsite (smallEtaleTopology p X)
      (smallEtaleTopology p ((tiltFunctor p).obj X)) :=
    { functorPushforward_mem_iff := fun {U S} ↦ (etaleTilt_covers p X U S).symm }
  letI : e.symm.inverse.IsDenseSubsite (smallEtaleTopology p X)
      (smallEtaleTopology p ((tiltFunctor p).obj X)) :=
    inferInstanceAs (e.functor.IsDenseSubsite (smallEtaleTopology p X)
      (smallEtaleTopology p ((tiltFunctor p).obj X)))
  exact (e.symm.sheafCongr _ _ (Type 2)).symm

