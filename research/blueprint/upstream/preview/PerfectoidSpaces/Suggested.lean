/-! ### P6/affinoid-etale-finite-stage-assembly -/

-- Essential surjectivity: TauCetiRoadmap.AdicEtaleGeometry.Huber.affinoid_etale_finite_stage_essSurj
example := @TauCetiRoadmap.AdicEtaleGeometry.Huber.affinoid_etale_hom_colimit_bijective

/-- Affinoidness of a qcqs étale finite-stage model is eventually visible (ECD 6.4(iv)). -/
theorem finiteStage_affinoid {I : Type} [SmallCategory I] [IsCofiltered I]
    (D : I ⥤ Perfd p) (hD : ∀ i, IsAffinoidPerfectoid p (D.obj i).obj)
    (i : I) (Z : smallEtale p (D.obj i))
    (hZ : QuasiCompact p Z.obj.hom ∧ QuasiSeparated p Z.obj.hom)
    (hlim : IsAffinoidPerfectoid p
      (((etaleBaseChange p (cofilteredLimit.π p D hD i)).obj Z).obj.left).obj) :
    ∃ (j : I) (a : j ⟶ i), ∀ (k : I) (b : k ⟶ j),
      IsAffinoidPerfectoid p (((etaleBaseChange p (D.map (b ≫ a))).obj Z).obj.left).obj := sorry

/-- ECD 6.4(ii), (iv), pp. 27–28: a qcqs model agrees with a chosen affinoid
model over a common stage and every further stage, in the étale slice. -/
theorem finiteStage_affinoid_model_iso {I : Type} [SmallCategory I] [IsCofiltered I]
    (D : I ⥤ Perfd p) (hD : ∀ i, IsAffinoidPerfectoid p (D.obj i).obj)
    (i l : I) (Z : smallEtale p (D.obj i)) (W : smallEtale p (D.obj l))
    (hZ : QuasiCompact p Z.obj.hom ∧ QuasiSeparated p Z.obj.hom)
    (hW : IsAffinoidPerfectoid p W.obj.left.obj)
    (e : (etaleBaseChange p (cofilteredLimit.π p D hD i)).obj Z ≅
      (etaleBaseChange p (cofilteredLimit.π p D hD l)).obj W) :
    ∃ (j : I) (a : j ⟶ i) (c : j ⟶ l), ∀ (k : I) (b : k ⟶ j),
      IsAffinoidPerfectoid p (((etaleBaseChange p (D.map (b ≫ a))).obj Z).obj.left).obj ∧
      Nonempty ((etaleBaseChange p (D.map (b ≫ a))).obj Z ≅
        (etaleBaseChange p (D.map (b ≫ c))).obj W) := sorry

/-! ### P6/affinoid-etale-relative-finite-stage-models -/

/-- ECD 6.4(iv), pp. 27–28, and 7.11(i), p. 33: affinoid étale models and
all their later pullbacks are affinoid étale over the fixed base, with the specified
structure map. The base itself need not be affinoid. -/
theorem finiteStage_relative {I : Type} [SmallCategory I] [IsCofiltered I]
    (B : Perfd p) (D : I ⥤ Perfd p)
    (hD : ∀ i, IsAffinoidPerfectoid p (D.obj i).obj)
    (g : D ⟶ (Functor.const I).obj B) (hg : ∀ i, IsEtale p (g.app i))
    (i : I) (Y : smallEtale p (D.obj i)) (hY : IsAffinoidPerfectoid p Y.obj.left.obj) :
    (∃ V : AffinoidEtale p B, V.obj = Over.mk (Y.obj.hom ≫ g.app i)) ∧
    ∀ (j : I) (a : j ⟶ i),
      ∃ V : AffinoidEtale p B,
        V.obj = Over.mk (((etaleBaseChange p (D.map a)).obj Y).obj.hom ≫ g.app j) ∧
        ((etaleBaseChange p (D.map a)).obj Y).obj.hom ≫ g.app j =
          pullback.fst Y.obj.hom (D.map a) ≫ Y.obj.hom ≫ g.app i := sorry

-- Check: finiteStage_relative_nonetale
example {B T : Perfd p} (f : T ⟶ B) (hf : ¬ IsEtale p f) :
    ¬ ∃ V : AffinoidEtale p B, V.obj = Over.mk f := by
  rintro ⟨V, hV⟩
  have h : (fun U : Over B ↦ IsEtale p U.hom) V.obj := V.property.2
  rw [hV] at h
  exact hf h

/-- Pointwise base change is surjective; it need not be injective. -/
theorem IsAffinoidProEtale.baseChange_points {Y X X' : Perfd p} (f : Y ⟶ X) (g : X' ⟶ X)
    (hf : IsAffinoidProEtale p f) (hX' : IsAffinoidPerfectoid p X'.obj)
    (y : underlyingPoints p Y) (x' : underlyingPoints p X')
    (h : pointMap p f y = pointMap p g x') :
    ∃ z : underlyingPoints p (pullback f g),
      pointMap p (pullback.fst f g) z = y ∧ pointMap p (pullback.snd f g) z = x' := sorry

