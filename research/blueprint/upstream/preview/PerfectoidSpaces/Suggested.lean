section ZariskiClosedSubspace

variable {R : Type u} [CommRing R] [TopologicalSpace R] (D : PairOfDefinition R)

namespace zariskiClosedSubspace

open scoped Classical

/-- The presentation `({1} ∪ F)/1` of
the rational subset `U_F = {|g| ≤ 1, g ∈ F}` over the pair of definition `D`. -/
def presentation_affinoid (F : Finset R) : D.Presentation where
  num := insert 1 F
  den := 1
  hasDenominatorPower := PairOfDefinition.hasDenominatorPower_of_pow_le_span D (insert 1 F)
    (Localization.Away 1) D.ringOfDefinition.one_mem (N := 0) (by
      change D.idealOfDefinition ^ 0 ≤ Ideal.span {(1 : D.ringOfDefinition)}
      simp)

-- Check presentation_empty: the empty list of inequalities presents the whole spectrum.
example : (presentation_affinoid D ∅).num = {1} ∧
    (presentation_affinoid D ∅).den = 1 := by
  classical
  simp [presentation_affinoid]

-- Check presentation_zero: adjoining the zero inequality adds no condition.
example : (presentation_affinoid D {0}).num = {1, 0} ∧
    (presentation_affinoid D {0}).den = 1 := by
  classical
  exact ⟨rfl, rfl⟩

-- Check presentation_two_terms: both numerators are retained, with denominator one.
example (a b : R) : (presentation_affinoid D {a, b}).num = {1, a, b} ∧
    (presentation_affinoid D {a, b}).den = 1 := by
  classical
  exact ⟨rfl, rfl⟩

-- Check presentation_membership: the finite presentation has the intended valuation meaning.
example (Aplus : Subring R) (F : Finset R) (x : Spv R) :
    x ∈ rationalSubset Aplus (presentation_affinoid D F).num
      (presentation_affinoid D F).den ↔
      x ∈ spa Aplus ∧ ∀ a ∈ F, x.toValuativeRel.vle a 1 := sorry

-- Check presentation_two_term_bounds: 0 and 1 pass, but the inverse uniformizer fails.
example [IsTopologicalRing R] [IsTateRing R] (P : Pair R) (ϖ : Rˣ)
    (hϖ : IsTopologicallyNilpotent (ϖ : R)) :
    rationalSubset P.plus (presentation_affinoid D {0, 1}).num
      (presentation_affinoid D {0, 1}).den = spa P.plus ∧
    rationalSubset P.plus (presentation_affinoid D {0, (↑ϖ⁻¹ : R)}).num
      (presentation_affinoid D {0, (↑ϖ⁻¹ : R)}).den = ∅ := sorry

end zariskiClosedSubspace

end ZariskiClosedSubspace

