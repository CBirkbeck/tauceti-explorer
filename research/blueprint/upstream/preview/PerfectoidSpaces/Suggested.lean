noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open _root_.CategoryTheory _root_.CategoryTheory.Limits TauCeti _root_.TauCeti.Huber
universe u
variable (p : ℕ) [Fact p.Prime] {J : Type u} [SmallCategory J] [IsFiltered J]
/-! ### P1/completed-colimit-of-perfectoid-tate-rings -/
/-- Forget the topology and the plus ring, retaining the actual structural ring maps. -/
def ringDiagram (F : J ⥤ PairCat.{u} p) : J ⥤ CommRingCat.{u} where
  obj j := CommRingCat.of (F.obj j)
  map f := CommRingCat.ofHom (F.map f).toRingHom
  map_id := by sorry
  map_comp := by sorry

/-- Compatible complete nonarchimedean norms, with the specified plus rings as unit balls. -/
structure NormedAffinoidSystem (F : J ⥤ PairCat.{u} p) where
  norm : ∀ j, RingNorm (F.obj j)
  topology : ∀ j, (norm j).toRingSeminorm.toSeminormedRing.toUniformSpace.toTopologicalSpace =
    (inferInstance : TopologicalSpace (F.obj j))
  nonarchimedean : ∀ j x y, norm j (x + y) ≤ max (norm j x) (norm j y)
  unitBall : ∀ j x, x ∈ (F.obj j).pair.plus ↔ norm j x ≤ 1
  submetric : ∀ {i j} (f : i ⟶ j) x, norm j ((F.map f).toRingHom x) ≤ norm i x

variable {p} (F : J ⥤ PairCat.{u} p) (N : NormedAffinoidSystem p F)
/-- The infimum norm is taken over every representative at every stage. -/
def colimitSeminorm : RingSeminorm ↥(colimit (ringDiagram p F)) where
  toFun x := sInf {r : ℝ | ∃ j, ∃ a : F.obj j, colimit.ι (ringDiagram p F) j a = x ∧ r = N.norm j a}
  map_zero' := by sorry
  add_le' := by sorry
  neg' := by sorry
  mul_le' := by sorry

theorem colimitSeminorm_apply (x : ↥(colimit (ringDiagram p F))) :
    colimitSeminorm F N x = sInf {r : ℝ | ∃ j, ∃ a : F.obj j,
      colimit.ι (ringDiagram p F) j a = x ∧ r = N.norm j a} := rfl

/-- Hausdorff completion for the infimum seminorm; a zero seminorm is permitted. -/
def NormedColimit :=
  letI := (colimitSeminorm F N).toSeminormedRing
  UniformSpace.Completion ↥(colimit (ringDiagram p F))
instance : CommRing (NormedColimit F N) := by
  unfold NormedColimit
  letI := (colimitSeminorm F N).toSeminormedRing
  infer_instance
instance : UniformSpace (NormedColimit F N) := by unfold NormedColimit; infer_instance
instance : IsUniformAddGroup (NormedColimit F N) := by unfold NormedColimit; infer_instance
instance : IsTopologicalRing (NormedColimit F N) := by unfold NormedColimit; infer_instance
instance : CompleteSpace (NormedColimit F N) := by unfold NormedColimit; infer_instance
instance : T2Space (NormedColimit F N) := by unfold NormedColimit; infer_instance

/-- Submetric norms with a common multiplicative small unit give the adic completed colimit. -/
theorem completedColimit_test_compatibility_sch12 (j₀ : J) (hj₀ : IsInitial j₀)
    (ϖ : PseudoUniformizerRoots p (F.obj j₀))
    (r : ℝ) (hr : 0 < r ∧ r < 1)
    (hϖ : ∀ j x, N.norm j ((F.map (hj₀.to j)).toRingHom (ϖ.root 0) * x) = r * N.norm j x) :
    ∃ e : NormedColimit F N ≃+* completedFilteredColimit p F j₀ ϖ,
      Continuous e ∧ Continuous e.symm ∧ ∀ j (x : F.obj j),
        e (show NormedColimit F N from
          (letI := (colimitSeminorm F N).toSeminormedRing
           (UniformSpace.Completion.coe' (colimit.ι (ringDiagram p F) j x)))) = completedFilteredColimit.ι p F j₀ ϖ j x := sorry

-- Check: ringDiagram_zero; NormedAffinoidSystem_zero; colimitSeminorm_zero; NormedColimit_zero
example (hz : ∀ j, Subsingleton (F.obj j)) :
    Subsingleton ↥(colimit (ringDiagram p F)) ∧ (∀ x, colimitSeminorm F N x = 0) ∧
      Subsingleton (NormedColimit F N) := sorry
-- Check: ringDiagram_terminal; NormedAffinoidSystem_terminal; colimitSeminorm_terminal; NormedColimit_terminal
example (j : J) (hj : IsTerminal j) :
    (∀ i (x : F.obj i), colimitSeminorm F N (colimit.ι (ringDiagram p F) i x) =
      N.norm j ((F.map (hj.from i)).toRingHom x)) ∧
      Nonempty (NormedColimit F N ≃+* F.obj j) := sorry
-- Check: ringDiagram_killed; NormedAffinoidSystem_killed; colimitSeminorm_killed; NormedColimit_killed
example {i j : J} (f : i ⟶ j) (x : F.obj i) (hx : (F.map f).toRingHom x = 0) :
    colimit.ι (ringDiagram p F) i x = 0 ∧
      colimitSeminorm F N (colimit.ι (ringDiagram p F) i x) = 0 := sorry
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
end

