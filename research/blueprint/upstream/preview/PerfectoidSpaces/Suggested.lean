/-- Evaluation of continuous functions is a continuous map of the chosen pairs. -/
def continuousFunctionEval (T : Type) [TopologicalSpace T] [CompactSpace T]
    [T2Space T] [TotallyDisconnectedSpace T] (R : PairCat.{0} p) (s : T) :
    continuousFunctionPair p T R ⟶ R where
  toRingHom :=
    { toFun := fun f ↦ f s
      map_one' := by sorry
      map_mul' := by sorry
      map_zero' := by sorry
      map_add' := by sorry }
  continuous_toRingHom := by sorry
  map_mem_plus := by sorry

variable {I : Type} [SmallCategory I] (S : I ⥤ Profinite.{0}) (R : PairCat.{0} p)
def profiniteProjectionMap (i : I) :
    (profiniteFunctionDiagram p S R).obj (op i) ⟶ continuousFunctionPair p (↥(limit S)) R where
  toRingHom := by sorry
  continuous_toRingHom := by sorry
  map_mem_plus := by sorry

theorem profiniteProjectionMap_apply (i : I) (f : (profiniteFunctionDiagram p S R).obj (op i))
    (s : ↥(limit S)) :
