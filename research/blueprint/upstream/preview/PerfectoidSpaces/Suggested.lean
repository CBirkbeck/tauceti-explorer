/-! ### Layer 4: Disjoint unions and separated diagonals -/
namespace PerfectoidSpace
open Perfectoid TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]

/-- Disjoint unions are obtained by gluing the disjoint open affinoid charts. -/
instance perfd_hasBinaryCoproducts : HasBinaryCoproducts (Perfd p) := sorry

def sumSpaceEquiv (Y Z : Perfd p) : underlyingPoints p (Y ⨿ Z) ≃ₜ
    (underlyingPoints p Y ⊕ underlyingPoints p Z) := sorry

theorem sumSpaceEquiv_inl (Y Z : Perfd p) (y : underlyingPoints p Y) :
    sumSpaceEquiv p Y Z (pointMap p (coprod.inl : Y ⟶ Y ⨿ Z) y) = Sum.inl y := sorry
 theorem sumSpaceEquiv_inr (Y Z : Perfd p) (z : underlyingPoints p Z) :
    sumSpaceEquiv p Y Z (pointMap p (coprod.inr : Z ⟶ Y ⨿ Z) z) = Sum.inr z := sorry

theorem isSeparated_sum_iff {Y Z X : Perfd p} (f : Y ⟶ X) (g : Z ⟶ X) :
    IsSeparated p (coprod.desc f g) ↔ IsSeparated p f ∧ IsSeparated p g := sorry

/-- The four components are indexed in the order (1,1), (1,2), (2,1), (2,2). -/
def sumPullbackEquiv {Y Z X : Perfd p} (f : Y ⟶ X) (g : Z ⟶ X) :
    underlyingPoints p (pullback (coprod.desc f g) (coprod.desc f g)) ≃ₜ
      ((underlyingPoints p (pullback f f) ⊕ underlyingPoints p (pullback f g)) ⊕
        (underlyingPoints p (pullback g f) ⊕ underlyingPoints p (pullback g g))) := sorry

theorem sumPullbackEquiv_coordinates {Y Z X : Perfd p} (f : Y ⟶ X) (g : Z ⟶ X)
    (z : underlyingPoints p (pullback (coprod.desc f g) (coprod.desc f g))) :
    sumSpaceEquiv p Y Z (pointMap p (pullback.fst (coprod.desc f g) (coprod.desc f g)) z) =
      Sum.elim
        (Sum.elim (fun w ↦ Sum.inl (pointMap p (pullback.fst f f) w))
          (fun w ↦ Sum.inl (pointMap p (pullback.fst f g) w)))
        (Sum.elim (fun w ↦ Sum.inr (pointMap p (pullback.fst g f) w))
          (fun w ↦ Sum.inr (pointMap p (pullback.fst g g) w))) (sumPullbackEquiv p f g z) ∧
    sumSpaceEquiv p Y Z (pointMap p (pullback.snd (coprod.desc f g) (coprod.desc f g)) z) =
      Sum.elim
        (Sum.elim (fun w ↦ Sum.inl (pointMap p (pullback.snd f f) w))
          (fun w ↦ Sum.inr (pointMap p (pullback.snd f g) w)))
        (Sum.elim (fun w ↦ Sum.inl (pointMap p (pullback.snd g f) w))
          (fun w ↦ Sum.inr (pointMap p (pullback.snd g g) w))) (sumPullbackEquiv p f g z) := sorry

-- Check: sum_diagonal_four_components
example {Y Z X : Perfd p} (f : Y ⟶ X) (g : Z ⟶ X) :
    (sumPullbackEquiv p f g) '' Set.range (pointMap p (pullback.diagonal (coprod.desc f g))) =
      (Sum.inl ∘ Sum.inl) '' Set.range (pointMap p (pullback.diagonal f)) ∪
