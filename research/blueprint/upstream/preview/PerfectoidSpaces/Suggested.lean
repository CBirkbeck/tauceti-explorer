/-- Global functions on each étale object, with pullback of functions as restriction. -/
def etaleO (X : Perfd p) : (smallEtale p X)ᵒᵖ ⥤ AddCommGrpCat.{1} where
  obj U := AddCommGrpCat.of (globalSections p U.unop.obj.left)
  map f := AddCommGrpCat.ofHom (globalPullback p f.unop.hom.left).toAddMonoidHom
  map_id := by sorry
  map_comp := by sorry

/-- The integral structure presheaf uses the plus rings on all affinoid charts. -/
def etaleOPlus (X : Perfd p) : (smallEtale p X)ᵒᵖ ⥤ AddCommGrpCat.{1} where
  obj U := AddCommGrpCat.of (globalPlus p U.unop.obj.left)
  map f := AddCommGrpCat.ofHom
    ((globalPullback p f.unop.hom.left).restrict _ _ (fun a ha ↦
      globalPullback_plus p f.unop.hom.left ⟨a, ha⟩)).toAddMonoidHom
  map_id := by sorry
  map_comp := by sorry

theorem etaleO_isSheaf (X : Perfd p) : Presheaf.IsSheaf (smallEtaleTopology p X) (etaleO p X) := sorry

theorem etaleOPlus_isSheaf (X : Perfd p) :
    Presheaf.IsSheaf (smallEtaleTopology p X) (etaleOPlus p X) := sorry

def etaleOSheaf (X : Perfd p) : Sheaf (smallEtaleTopology p X) AddCommGrpCat.{1} :=
  ⟨etaleO p X, etaleO_isSheaf p X⟩

def etaleOPlusSheaf (X : Perfd p) : Sheaf (smallEtaleTopology p X) AddCommGrpCat.{1} :=
  ⟨etaleOPlus p X, etaleOPlus_isSheaf p X⟩

/-- A1's ordinary and integral étale sheaves agree with perfectoid sections under
an equivalence of sites. Sch12 7.11–7.13, p. 43. -/
theorem etaleSheaves_adicComparison (X : Perfd p) :
    ∃ (A : TauCeti.AdicSpace) (hA : AdicSpace.IsLocallyStronglySheafy A)
      (e : smallEtale p X ≌ AdicSpace.smallEtale A),
      Nonempty (YonedaAdicSpace.ofAdicSpace.obj A ≅ X.obj) ∧
      (∀ U : smallEtale p X,
        Nonempty (YonedaAdicSpace.ofAdicSpace.obj (e.functor.obj U).left ≅ U.obj.left.obj)) ∧
      (∀ (U : smallEtale p X) (S : Sieve U),
        S ∈ smallEtaleTopology p X U ↔ S.functorPushforward e.functor ∈
          AdicSpace.smallEtaleTopology A hA (e.functor.obj U)) ∧
      Nonempty (etaleO p X ≅ e.functor.op ⋙ (AdicSpace.structureSheafEtale A hA).obj ⋙
        forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat ⋙
        AddCommGrpCat.uliftFunctor.{1, 0}) ∧
      Nonempty (etaleOPlus p X ≅ e.functor.op ⋙ (AdicSpace.structureSheafPlusEtale A hA).obj ⋙
        forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat ⋙
        AddCommGrpCat.uliftFunctor.{1, 0}) := sorry

/-- Multiplication by a base integral section on the integral étale sheaf. -/
def etaleIntegralScalar (X : Perfd p) (a : globalPlus p X) :
    etaleOPlusSheaf p X ⟶ etaleOPlusSheaf p X := sorry

theorem etaleIntegralScalar_apply (X : Perfd p) (a : globalPlus p X)
    (U : smallEtale p X) (s : globalPlus p U.obj.left) :
    (etaleIntegralScalar p X a).hom.app (Opposite.op U) s =
      (⟨globalPullback p U.obj.hom a.val, globalPullback_plus p U.obj.hom a⟩ :
        globalPlus p U.obj.left) * s := sorry

/-- The affinoid basis supplies sheafification in the universe of the structure sheaves. -/
instance etale_hasSheafify (X : Perfd p) :
    HasSheafify (smallEtaleTopology p X) AddCommGrpCat.{1} := sorry

instance etale_hasExt (X : Perfd p) :
    HasExt.{2} (Sheaf (smallEtaleTopology p X) AddCommGrpCat.{1}) := sorry

/-- O⁺/a is the cokernel in sheaves, so sections are not identified with
pointwise quotients without a cohomological argument. -/
def etaleOPlusQuotient (X : Perfd p) (a : globalPlus p X) :
    Sheaf (smallEtaleTopology p X) AddCommGrpCat.{1} :=
  cokernel (etaleIntegralScalar p X a)

/-- The small-parameter comparison is induced by sharp after quotienting, ECD 6.3. -/
def etaleIntegralQuotientTiltIso (X : Perfd p)
    (a : globalPlus p X) (b : globalPlus p ((tiltFunctor p).obj X))
    (hsharp : globalSharp p X b.val = a.val)
    (hsmall : ∀ C : Chart p X,
      IsPseudoUniformizer (a.val.val C) ∧
      (⟨a.val.val C, a.property C⟩ : C.ring.pair.plus) ^ p ∣ (p : C.ring.pair.plus)) :
    (etaleOPlusQuotient p X a).obj ≅ (etaleTiltFunctor p X).op ⋙
      (etaleOPlusQuotient p ((tiltFunctor p).obj X) b).obj := sorry

/-- Integral quotient cohomology is almost zero in positive degree. -/
theorem etaleOPlusQuotient_almost_acyclic (R : PairCat.{0} p)
    (a : globalPlus p (ofPair p R))
    (ha : IsPseudoUniformizer (globalSectionsAffinoidEquiv p R a.val))
    (q : ℕ) (hq : 0 < q) (ε : globalPlus p (ofPair p R))
    (hε : IsTopologicallyNilpotent (globalSectionsAffinoidEquiv p R ε.val)) :
    Sheaf.H.map (cokernel.map (etaleIntegralScalar p (ofPair p R) a)
      (etaleIntegralScalar p (ofPair p R) a)
      (etaleIntegralScalar p (ofPair p R) ε)
      (etaleIntegralScalar p (ofPair p R) ε) (by sorry)) q = 0 := sorry

