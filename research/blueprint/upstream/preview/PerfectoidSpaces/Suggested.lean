    (hX : IsAffinoidPerfectoid p X.obj) {I : Type} [SmallCategory I] [IsCofiltered I]
    (D : I ⥤ AffinoidProEtale p X) (c : Cone (D ⋙ ObjectProperty.ι _)) (hc : IsLimit c) :
    IsAffinoidProEtale p c.pt.hom := sorry

/-! ### P6/kappa-small-cofiltered-limits -/

/-- The ring and arrow bounds are uniform, including at singular cutoffs. -/
theorem cofilteredLimit_uniform_card {I : Type} [SmallCategory I] [IsCofiltered I]
    (D : I ⥤ Perfd p) (hD : ∀ i, IsAffinoidPerfectoid p (D.obj i).obj)
    {κ μ : Cardinal.{1}} (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    (hμ₀ : ℵ₀ ≤ μ) (hμ : μ < κ)
    (hI : Cardinal.lift.{1} #(Σ i j : I, i ⟶ j) ≤ μ)
    (hR : ∀ i, #(globalSections p (D.obj i)) ≤ μ) :
    #(globalSections p (cofilteredLimit p D hD)) ≤ μ ^ ℵ₀ ∧
      IsUniformlyKappaSmall p κ (cofilteredLimit p D hD) := sorry

namespace ProEtalePresentation
variable {p} {Y X : Perfd p} {f : Y ⟶ X} (P : ProEtalePresentation p f)

/-- The plus-ring quotient comparison of ECD 6.5, p. 29, for a compatible pseudouniformizer. -/
def plusModEquiv (t : ∀ i, globalPlus p (P.spaces.obj i))
    (ht : ∀ {i j} (a : i ⟶ j), globalPullback p (P.spaces.map a) (t j).val = (t i).val)
    (hp : ∀ (i : P.I) (C : Chart p (P.spaces.obj i)), IsPseudoUniformizer ((t i).val.val C))
    (i₀ : P.I) :
    (↥(colimit (globalPlusQuotientDiagram p P.spaces t ht 1))) ≃+*
      globalPlus p Y ⧸ Ideal.span {
        (⟨globalPullback p (P.π i₀) (t i₀).val,
          globalPullback_plus p (P.π i₀) (t i₀)⟩ : globalPlus p Y)} := sorry

theorem plusModEquiv_ι (t : ∀ i, globalPlus p (P.spaces.obj i))
    (ht : ∀ {i j} (a : i ⟶ j), globalPullback p (P.spaces.map a) (t j).val = (t i).val)
    (hp : ∀ (i : P.I) (C : Chart p (P.spaces.obj i)), IsPseudoUniformizer ((t i).val.val C))
    (i₀ i : P.I) (a : globalPlus p (P.spaces.obj i)) :
    P.plusModEquiv t ht hp i₀
      (colimit.ι (globalPlusQuotientDiagram p P.spaces t ht 1) (Opposite.op i)
        (Ideal.Quotient.mk _ a)) =
      Ideal.Quotient.mk _ (⟨globalPullback p (P.π i) a.val,
        globalPullback_plus p (P.π i) a⟩ : globalPlus p Y) := sorry
end ProEtalePresentation

