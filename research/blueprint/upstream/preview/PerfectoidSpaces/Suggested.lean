/-! ### Layer 6: Integral comparisons, size and geometric-point realization -/

instance KappaSmall.essentiallySmall (κ : Cardinal.{1}) :
    EssentiallySmall.{1} (KappaSmall p κ) := sorry

/-- ECD Corollary 3.20, p. 19, restricted using invariance of κ-smallness under tilting. -/
def kappaSmallSliceTilt (κ : Cardinal.{1}) (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    (X : Perfd p) :
    ObjectProperty.FullSubcategory (fun Y : Over X ↦ IsKappaSmall p κ Y.left) ≌
      ObjectProperty.FullSubcategory
        (fun Y : Over ((tiltFunctor p).obj X) ↦ IsKappaSmall p κ Y.left) := by
  let Q : ObjectProperty (Over ((tiltFunctor p).obj X)) :=
    fun Y ↦ IsKappaSmall p κ Y.left
  letI : Q.IsClosedUnderIsomorphisms := ⟨fun e h ↦
    IsKappaSmall.of_iso p ((Over.forget _).mapIso e) h⟩
  exact (sliceTiltFunctor p X).asEquivalence.congrFullSubcategory
    (Q := Q) (by
      funext Y
      exact propext (IsKappaSmall.tilt_iff p hκ hκ₀ Y.left))

/-- Forgetting the size proof recovers the specified slice tilt on each object. -/
theorem kappaSmallSliceTilt_obj (κ : Cardinal.{1}) (hκ : κ.IsStrongLimit)
    (hκ₀ : ℵ₀ < κ) (X : Perfd p)
    (Y : ObjectProperty.FullSubcategory (fun Y : Over X ↦ IsKappaSmall p κ Y.left)) :
    ((kappaSmallSliceTilt p κ hκ hκ₀ X).functor.obj Y).obj =
      (sliceTiltFunctor p X).obj Y.obj := rfl

/-- Forgetting the size proof recovers the specified slice tilt on each commuting triangle. -/
theorem kappaSmallSliceTilt_map (κ : Cardinal.{1}) (hκ : κ.IsStrongLimit)
    (hκ₀ : ℵ₀ < κ) (X : Perfd p)
    {Y Z : ObjectProperty.FullSubcategory (fun Y : Over X ↦ IsKappaSmall p κ Y.left)}
    (f : Y ⟶ Z) :
    ((kappaSmallSliceTilt p κ hκ hκ₀ X).functor.map f).hom =
      (sliceTiltFunctor p X).map f.hom := rfl

-- Check: kappaSmallSliceTilt_object
example (κ : Cardinal.{1}) (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    {Y X : Perfd p} (f : Y ⟶ X) (hY : IsKappaSmall p κ Y) :
    ((kappaSmallSliceTilt p κ hκ hκ₀ X).functor.obj ⟨Over.mk f, hY⟩).obj =
      Over.mk ((tiltFunctor p).map f) := rfl

-- Check: kappaSmallSliceTilt_morphism
example (κ : Cardinal.{1}) (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (X : Perfd p)
    {Y Z : ObjectProperty.FullSubcategory (fun Y : Over X ↦ IsKappaSmall p κ Y.left)}
    (f : Y ⟶ Z) :
    ((kappaSmallSliceTilt p κ hκ hκ₀ X).functor.map f).hom.left =
      (tiltFunctor p).map f.hom.left := rfl

-- Check: kappaSmallSliceTilt_identity
example (κ : Cardinal.{1}) (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ)
    (X : Perfd p) (hX : IsKappaSmall p κ X) :
    ((kappaSmallSliceTilt p κ hκ hκ₀ X).functor.obj ⟨Over.mk (𝟙 X), hX⟩).obj =
      Over.mk (𝟙 ((tiltFunctor p).obj X)) := by
  change Over.mk ((tiltFunctor p).map (𝟙 X)) = _
  rw [(tiltFunctor p).map_id]

