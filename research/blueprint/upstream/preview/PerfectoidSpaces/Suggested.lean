attribute [local instance] MvPolynomial.gradedAlgebra

/-- A quasi-projective scheme has a locally closed immersion into a finite projective space
compatible with its structural map. -/
def QuasiProjectiveOver (A : Type) [CommRing A] (X : Over (Spec (CommRingCat.of A))) : Prop :=
  ∃ (n : ℕ) (i : X.left ⟶ AlgebraicGeometry.Proj
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A)),
    AlgebraicGeometry.IsImmersion i ∧
      i ≫ Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A) ≫
        Spec.map (CommRingCat.ofHom
          (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A 0))) = X.hom

-- Check: QuasiProjectiveOver_affine
example (A B : Type) [CommRing A] [CommRing B] [Algebra A B] [Algebra.FiniteType A B] :
    QuasiProjectiveOver A (Over.mk (Spec.map (CommRingCat.ofHom (algebraMap A B)))) := sorry
-- Check: QuasiProjectiveOver_empty
example (A : Type) [CommRing A] (X : Over (Spec (CommRingCat.of A))) [IsEmpty X.left] :
    QuasiProjectiveOver A X := sorry
-- Check: QuasiProjectiveOver_nonseparated
example (A : Type) [CommRing A] (X : Over (Spec (CommRingCat.of A)))
    (h : ¬ IsSeparated X.hom) : ¬ QuasiProjectiveOver A X := sorry

