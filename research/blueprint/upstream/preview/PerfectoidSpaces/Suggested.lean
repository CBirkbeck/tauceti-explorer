open scoped TensorProduct
universe u
variable {V : Type u} [CommRing V] (S : BasicSetup V)

/-- A flat deformation is a flat upper horizontal map and its specified pushout square. -/
structure FlatDeformation {B B₀ C₀ : Algebra S} (q : B ⟶ B₀) (f : B₀ ⟶ C₀) where
  algebra : Algebra S
  map : B ⟶ algebra
  reduction : algebra ⟶ C₀
  square : IsPushout map q reduction f
  flat : Algebra.IsFlat S map

/-- Isomorphisms of deformations preserve the base map and the reduction. -/
def flatDeformationSetoid {B B₀ C₀ : Algebra S} (q : B ⟶ B₀) (f : B₀ ⟶ C₀) :
    Setoid (FlatDeformation S q f) where
  r E F := ∃ e : E.algebra ≅ F.algebra,
    E.map ≫ e.hom = F.map ∧ e.hom ≫ F.reduction = E.reduction
  iseqv := by sorry

/-! ### P0/almost-deformation-theory -/

/-- GR 3.2.11: obstruction in Ext², a torsor of classes under Ext¹, and Ext⁰ automorphisms. -/
theorem flatDeformation {A B₀ C₀ : Algebra S} (a : A ⟶ B₀)
    (I : Algebra.ModuleCat S B₀) (E : SquareZeroExtension S a I)
    (f : B₀ ⟶ C₀) (hf : Algebra.IsFlat S f) :
    let T := S.baseChange ((Algebra.elements S).obj C₀)
    let N := (Module.baseChange S f).obj ((Algebra.moduleEquiv S B₀).functor.obj I)
    letI : HasDerivedCategory (Module T) := HasDerivedCategory.standard _
    let L := almostCotangentComplex S f
    let J := (DerivedCategory.singleFunctor (Module T) 0).obj N
    ∃ ω : L ⟶ J⟦(2 : ℤ)⟧,
      (ω = 0 ↔ Nonempty (FlatDeformation S E.projection f)) ∧
      (ω = 0 → Nonempty (AddTorsor (L ⟶ J⟦(1 : ℤ)⟧)
        (Quotient (flatDeformationSetoid S E.projection f)))) ∧
      ∀ D : FlatDeformation S E.projection f,
        ∃ e : {g : D.algebra ≅ D.algebra //
          D.map ≫ g.hom = D.map ∧ g.hom ≫ D.reduction = D.reduction} ≃ (L ⟶ J),
          e ⟨Iso.refl _, by simp⟩ = 0 := sorry

/-- Vanishing of the full complex gives existence and uniqueness including automorphisms. -/
theorem flatDeformation_unique {A B₀ C₀ : Algebra S} (a : A ⟶ B₀)
    (I : Algebra.ModuleCat S B₀) (E : SquareZeroExtension S a I)
    (f : B₀ ⟶ C₀) (hf : Algebra.IsFlat S f)
    (hL : IsZero (almostCotangentComplex S f)) :
    Nonempty (FlatDeformation S E.projection f) ∧
      ∀ D F : FlatDeformation S E.projection f,
        ∃! e : D.algebra ≅ F.algebra,
          D.map ≫ e.hom = F.map ∧ e.hom ≫ F.reduction = D.reduction := sorry

-- Check: FlatDeformation_zero; flatDeformationSetoid_zero; deformation_test_zero_ideal
example {B C : Algebra S} (f : B ⟶ C) (hf : Algebra.IsFlat S f) :
    Nonempty (FlatDeformation S (𝟙 B) f) ∧
    (∀ D : FlatDeformation S (𝟙 B) f, IsIso D.reduction) ∧
    Subsingleton (Quotient (flatDeformationSetoid S (𝟙 B) f)) := sorry

-- Check: FlatDeformation_polynomial; flatDeformationSetoid_polynomial; deformation_test_polynomial
example (R B : Type u) [CommRing R] [CommRing B] [_root_.Algebra V R]
    [_root_.Algebra V B] [_root_.Algebra B R] [IsScalarTower V B R]
    (hq : Function.Surjective (algebraMap B R))
    (hJ : (RingHom.ker (algebraMap B R)) ^ 2 = ⊥) :
    let C := BasicSetup.classical V
    let q := (Algebra.toAlmost C).map (CommAlgCat.ofHom (IsScalarTower.toAlgHom V B R))
    let f := (Algebra.toAlmost C).map (CommAlgCat.ofHom (IsScalarTower.toAlgHom V R (Polynomial R)))
    ∃ hM : _root_.Module R (RingHom.ker (algebraMap B R)),
    letI := hM
    (∀ (b : B) (x : RingHom.ker (algebraMap B R)),
      (algebraMap B R b) • x = b • x) ∧
    Nonempty (FlatDeformation C q f) ∧
    Subsingleton (Quotient (flatDeformationSetoid C q f)) ∧
    ∀ D : FlatDeformation C q f,
      Nonempty ({g : D.algebra ≅ D.algebra //
        D.map ≫ g.hom = D.map ∧ g.hom ≫ D.reduction = D.reduction} ≃
          Polynomial R ⊗[R] (RingHom.ker (algebraMap B R))) := by
  -- The quotient action on the square-zero ideal is the action induced by B → R.
  sorry

-- Check: FlatDeformation_nonflat; flatDeformationSetoid_nonflat
example :
    letI : _root_.Algebra (DualNumber ℚ) ℚ := (TrivSqZeroExt.fstHom ℚ ℚ ℚ).toRingHom.toAlgebra
    ¬ _root_.Module.Flat (DualNumber ℚ) ℚ ∧
      _root_.Module.Flat (DualNumber ℚ) (DualNumber ℚ) := sorry

