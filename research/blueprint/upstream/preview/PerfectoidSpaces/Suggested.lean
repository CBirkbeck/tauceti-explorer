    let X : MarkedUntilt p ((PairCat.tiltFunctor p).obj P) := ⟨P, Iso.refl _⟩
    X.primitiveIdeal = Ideal.span {(p : WittVector p (Pair.tilt p P.pair).plus) -
      (WittVector.teichmuller p t)} := sorry
-- Check: marked_frobenius_twist
example :
    let P : PairCat p := { carrier := ℂ_[p], pair := Pair.powerBounded ℂ_[p] }
    let Q := (PairCat.tiltFunctor p).obj P
    letI : CharP Q p := sorry
    let e : Q ≅ Q :=
      { hom := ⟨frobenius Q p, sorry, sorry⟩
        inv := sorry
        hom_inv_id := sorry
        inv_hom_id := sorry }
    let X : MarkedUntilt p Q := ⟨P, Iso.refl _⟩
    let Y : MarkedUntilt p Q := ⟨P, e⟩
    X.primitiveIdeal ≠ Y.primitiveIdeal ∧ IsEmpty (X ≅ Y) := sorry
end MarkedUntilt
end MarkedComparisons

section FieldComparisons
variable (p : ℕ) [Fact p.Prime] (K : Type u) [NontriviallyNormedField K]
  [IsUltrametricDist K] [CompleteSpace K] [IsPerfectoidField p K]
namespace tiltField

theorem integerEquiv_coeff (ϖ : powerBoundedSubring K) (hϖ : IsPseudoUniformizer (ϖ : K))
    (hp : ϖ ∣ (p : powerBoundedSubring K)) (x : powerBoundedSubring (tiltField p K)) (n : ℕ) :
    ∃ hx : tilt.coeff n (toTilt p K x.val) ∈ powerBoundedSubring K,
      Perfection.coeffMonoidHom (powerBoundedSubring K ⧸ Ideal.span {ϖ}) p n
        (integerEquiv p K ϖ hϖ hp x) =
      Ideal.Quotient.mk (Ideal.span {ϖ}) ⟨tilt.coeff n (toTilt p K x.val), hx⟩ := sorry

theorem residueFieldEquiv_sharp (x : powerBoundedSubring (tiltField p K)) :
    ∃ hx : tilt.sharp (toTilt p K x.val) ∈ powerBoundedSubring K,
      residueFieldEquiv p K (Ideal.Quotient.mk _ x) =
        Ideal.Quotient.mk _ ⟨tilt.sharp (toTilt p K x.val), hx⟩ := sorry

/-- The small quotient comparison uses the sharp of the chosen tilted element. -/
def quotEquiv (t : powerBoundedSubring (tiltField p K))
    (ht : 0 < ‖(t : tiltField p K)‖ ∧ ‖(t : tiltField p K)‖ < 1)
    (hp : ‖(p : K)‖ ≤ ‖(t : tiltField p K)‖)
    (hs : tilt.sharp (toTilt p K t.val) ∈ powerBoundedSubring K) :
    powerBoundedSubring (tiltField p K) ⧸ Ideal.span {t} ≃+*
      powerBoundedSubring K ⧸ Ideal.span {(⟨tilt.sharp (toTilt p K t.val), hs⟩ : powerBoundedSubring K)} := sorry

theorem quotEquiv_sharp (t : powerBoundedSubring (tiltField p K))
    (ht : 0 < ‖(t : tiltField p K)‖ ∧ ‖(t : tiltField p K)‖ < 1)
    (hp : ‖(p : K)‖ ≤ ‖(t : tiltField p K)‖)
    (hs : tilt.sharp (toTilt p K t.val) ∈ powerBoundedSubring K)
    (x : powerBoundedSubring (tiltField p K)) :
    ∃ hx : tilt.sharp (toTilt p K x.val) ∈ powerBoundedSubring K,
      quotEquiv p K t ht hp hs (Ideal.Quotient.mk _ x) =
        Ideal.Quotient.mk _ ⟨tilt.sharp (toTilt p K x.val), hx⟩ := sorry

variable {L : Type u} [NontriviallyNormedField L] [IsUltrametricDist L]
  [CompleteSpace L] [IsPerfectoidField p L]
def map (f : K →+* L) (hf : Continuous f) : tiltField p K →+* tiltField p L :=
  ((toTilt p L).symm.toRingHom.comp (tilt.map p f hf)).comp (toTilt p K).toRingHom

theorem map_isEmbedding (f : K →+* L) (hf : Continuous f) :
    Topology.IsEmbedding (map p K f hf) := sorry

theorem map_isometry (f : K →+* L) (hf : Continuous f) (hi : Isometry f) :
    Isometry (map p K f hf) := sorry
end tiltField

-- Check: tiltField_zero_and_one
example : tiltField.toTilt p K (0 : tiltField p K) = 0 ∧
    ‖(0 : tiltField p K)‖ = 0 ∧ ‖(1 : tiltField p K)‖ = 1 := by simp
-- Check: tiltField_map_two_terms
example (x : tiltField p K) :
    tiltField.map p K (RingHom.id K) continuous_id (x + 1) = x + 1 ∧
    tiltField.map p K (RingHom.id K) continuous_id (x ^ 2) = x ^ 2 := sorry
-- Check: tiltField_residue_small
example (x : powerBoundedSubring (tiltField p K)) (hx : ‖(x : tiltField p K)‖ < 1) :
