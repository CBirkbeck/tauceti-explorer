/-! ### Banach fields and the norm on the tilt -/
section BanachFields
/-! ### P1/gelfand-spectrum-banach-ring -/
/-! ### P1/gelfand-spectrum-units-and-maximum-formula -/

/-- An element is a unit iff every bounded multiplicative seminorm is nonzero on it
(KBF Lemma 2.4). -/
theorem gelfandSpectrum_isUnit_iff {A : Type*} [NormedCommRing A] [CompleteSpace A]
    [IsUltrametricDist A] (a : A) :
    IsUnit a ↔ ∀ α : {v : MulRingSeminorm A // ∃ C : ℝ, 0 < C ∧ ∀ x, v x ≤ C * ‖x‖}, α.val a ≠ 0 := sorry

/-! ### P1/uniform-banach-field-over-nondiscrete-field -/

/-- KBF Theorem 3.7. The algebra is only normed as a ring; multiplicativity is the conclusion. -/
theorem UniformBanachField.spectralNorm_mul {F A : Type*} [NontriviallyNormedField F]
    [IsUltrametricDist F] [CompleteSpace F] [NormedCommRing A] [IsUltrametricDist A]
    [CompleteSpace A] [NormedAlgebra F A] (hfield : IsField A)
    (hnd : ∀ ε : ℝ, 1 < ε → ∃ x : F, 1 < ‖x‖ ∧ ‖x‖ < ε)
    (hbounded : ∃ C : ℝ, 0 < C ∧ ∀ x : A, (∃ M : ℝ, ∀ n : ℕ, ‖x ^ n‖ ≤ M) → ‖x‖ ≤ C) (x y : A) :
    smoothingFun (normRingSeminorm A) (x * y) =
      smoothingFun (normRingSeminorm A) x * smoothingFun (normRingSeminorm A) y := sorry

/-! ### P1/perfectoid-ring-field-is-perfectoid-field -/

/-- KBF Theorem 4.2: a multiplicative absolute value inducing the given Tate topology. -/
theorem exists_absoluteValue_of_perfectoid_field (p : ℕ) [Fact p.Prime]
    (A : Type*) [Field A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A]
    [IsTateRing A] [CompleteSpace A] [T2Space A] [IsPerfectoidTateRing p A] :
    ∃ v : AbsoluteValue A ℝ, (∀ x y, v (x + y) ≤ max (v x) (v y)) ∧
      (∃ x, 0 < v x ∧ v x < 1) ∧
      (𝓝 (0 : A)).HasBasis (fun ε : ℝ ↦ 0 < ε) (fun ε ↦ {x | v x < ε}) := sorry
end BanachFields

/-! ### Perfectoid pairs, primitive triples and marked untilts -/
section Categories
variable (p : ℕ) [Fact p.Prime]
/-- Perfectoid Tate pairs, including the zero pair (Berkeley 6.2.11). -/
structure PairCat where
  carrier : Type u
  [commRing : CommRing carrier]
  [uniformSpace : UniformSpace carrier]
  [uniformAddGroup : IsUniformAddGroup carrier]
  [topologicalRing : IsTopologicalRing carrier]
  [tate : IsTateRing carrier]
  [complete : CompleteSpace carrier]
  [hausdorff : T2Space carrier]
  [perfectoid : IsPerfectoidTateRing p carrier]
  pair : Pair carrier
attribute [instance] PairCat.commRing PairCat.uniformSpace PairCat.uniformAddGroup
  PairCat.topologicalRing PairCat.tate PairCat.complete PairCat.hausdorff PairCat.perfectoid
instance : CoeSort (PairCat p) (Type u) := ⟨PairCat.carrier⟩
namespace PairCat
instance : Category (PairCat p) where
  Hom X Y := Pair.Hom X.pair Y.pair
  id X := Pair.Hom.id X.pair
  comp f g := g.comp f
  id_comp := by intros; apply Pair.Hom.ext; rfl
  comp_id := by intros; apply Pair.Hom.ext; rfl
  assoc := by intros; apply Pair.Hom.ext; rfl
/-- Tilting of perfectoid pairs, with coordinatewise action on morphisms. -/
def tiltFunctor : PairCat p ⥤ PairCat p where
  obj X := { carrier := tilt p X, pair := Pair.tilt p X.pair }
  map f := Pair.tiltHom p f
  map_id := sorry
  map_comp := sorry

theorem tilt_p_zero (X : PairCat p) : (p : (tiltFunctor p).obj X) = 0 := sorry
end PairCat

/-- Characteristic `p` means `p = 0`, allowing the zero pair; the ideal is primitive. -/
structure PrimitiveTriple where
  base : PairCat.{u} p
  p_zero : (p : base) = 0
  ideal : Ideal (WittVector p base.pair.plus)
  primitive : IsPrimitiveIdeal ideal
namespace PrimitiveTriple
/-- Pair maps which carry the source primitive ideal into the target primitive ideal. -/
structure Hom (X Y : PrimitiveTriple p) where
  pairHom : X.base ⟶ Y.base
  ideal_le : X.ideal.map (WittVector.map
    (pairHom.toRingHom.restrict _ _ pairHom.map_mem_plus)) ≤ Y.ideal
instance : Category (PrimitiveTriple p) where
  Hom := Hom p
  id X := ⟨𝟙 X.base, sorry⟩
  comp f g := ⟨f.pairHom ≫ g.pairHom, sorry⟩
  id_comp := sorry
  comp_id := sorry
  assoc := sorry
/-- The localized Witt quotient with its quotient-adic topology and image plus ring. -/
def untiltObject (X : PrimitiveTriple p) : PairCat.{u} p := sorry
/-- Identifies the object with the actual localized quotient, also for the zero pair. -/
def untiltCarrierEquiv (X : PrimitiveTriple p) :
    untiltObject p X ≃+* untilt p X.base.pair X.ideal := sorry

theorem untilt_plus (X : PrimitiveTriple p) :
    ((untiltObject p X).pair.plus).map (untiltCarrierEquiv p X).toRingHom =
      untiltPlus p X.base.pair X.ideal := sorry

/-- Reduction of Teichmüller lifts determines the marking. -/
def tiltIso (X : PrimitiveTriple p) : (PairCat.tiltFunctor p).obj (untiltObject p X) ≅ X.base := sorry
end PrimitiveTriple

/-- The triple attached to a pair uses its actual Fontaine kernel. -/
def classificationFunctor : PairCat.{u} p ⥤ PrimitiveTriple.{u} p where
  obj X := { base := (PairCat.tiltFunctor p).obj X
             p_zero := PairCat.tilt_p_zero p X
             ideal := RingHom.ker (tilt.theta p X.pair)
             primitive := tilt.theta_kernel_primitive p X.pair }
  map f := ⟨(PairCat.tiltFunctor p).map f, sorry⟩
  map_id := sorry
  map_comp := sorry
/-- Untilting maps are induced on localized Witt quotients. -/
def primitiveUntiltingFunctor : PrimitiveTriple.{u} p ⥤ PairCat.{u} p where
  obj := PrimitiveTriple.untiltObject p
  map f := sorry
  map_id := sorry
  map_comp := sorry

/-! ### P1/untilts-classified-by-primitive-ideals -/

/-- The unit is Fontaine reduction and the counit is the marking (Berkeley 6.2.11). -/
def classificationEquivalence : PairCat.{u} p ≌ PrimitiveTriple.{u} p where
  functor := classificationFunctor p
  inverse := primitiveUntiltingFunctor p
  unitIso := sorry
  counitIso := sorry
  functor_unitIso_comp := sorry

/-! ### P1/marked-untilt -/

/-- A marking is a pair isomorphism from the tilt, not just an isomorphism of rings. -/
structure MarkedUntilt (P : PairCat.{u} p) where
  untilt : PairCat.{u} p
  marking : (PairCat.tiltFunctor p).obj untilt ≅ P
namespace MarkedUntilt
variable {p} {P : PairCat.{u} p}
/-- A morphism respecting the marking. -/
structure Hom (X Y : MarkedUntilt p P) where
  pairHom : X.untilt ⟶ Y.untilt
  comm : (PairCat.tiltFunctor p).map pairHom ≫ Y.marking.hom = X.marking.hom
instance : Category (MarkedUntilt p P) where
  Hom := Hom
  id X := ⟨𝟙 X.untilt, sorry⟩
  comp f g := ⟨f.pairHom ≫ g.pairHom, sorry⟩
  id_comp := sorry
  comp_id := sorry
  assoc := sorry
/-- Transport the Fontaine kernel through the marking on plus rings. -/
def primitiveIdeal (X : MarkedUntilt p P) : Ideal (WittVector p P.pair.plus) :=
  (RingHom.ker (tilt.theta p X.untilt.pair)).map (WittVector.map
    (X.marking.hom.toRingHom.restrict _ _ X.marking.hom.map_mem_plus))
theorem primitiveIdeal_isPrimitive (X : MarkedUntilt p P) :
    IsPrimitiveIdeal X.primitiveIdeal := sorry
/-- A primitive ideal determines the localized Witt quotient and its canonical marking. -/
def ofPrimitive (hp : (p : P) = 0) (J : Ideal (WittVector p P.pair.plus))
    (hJ : IsPrimitiveIdeal J) : MarkedUntilt p P where
  untilt := PrimitiveTriple.untiltObject p ⟨P, hp, J, hJ⟩
  marking := PrimitiveTriple.tiltIso p ⟨P, hp, J, hJ⟩
theorem primitiveIdeal_ofPrimitive (hp : (p : P) = 0)
    (J : Ideal (WittVector p P.pair.plus)) (hJ : IsPrimitiveIdeal J) :
    (ofPrimitive hp J hJ).primitiveIdeal = J := sorry
/-- The characteristic-p self untilt, with the zeroth-coordinate marking. -/
def self (hp : (p : P) = 0) : MarkedUntilt p P :=
  ⟨P, sorry⟩
theorem self_marking (hp : (p : P) = 0) (x : tilt p P) :
    (self hp).marking.hom.toRingHom x = tilt.sharp x := sorry

def classification (hp : (p : P) = 0) : MarkedUntilt p P ⥤
    Discrete {J : Ideal (WittVector p P.pair.plus) // IsPrimitiveIdeal J} where
  obj X := ⟨⟨X.primitiveIdeal, X.primitiveIdeal_isPrimitive⟩⟩
  map f := sorry
  map_id := sorry
  map_comp := sorry

/-- Classification by ideals is discrete, so its fibers have no marking-preserving automorphisms. -/
theorem classification_isEquivalence (hp : (p : P) = 0) :
    (classification hp).IsEquivalence := sorry

theorem subsingleton_hom (X Y : MarkedUntilt p P) : Subsingleton (X ⟶ Y) := sorry

theorem charP_iff (X : MarkedUntilt p P) :
    (p : X.untilt) = 0 ↔ X.primitiveIdeal = Ideal.span {(p : WittVector p P.pair.plus)} := sorry

/-- Extension of a primitive ideal along the map on plus rings. -/
def pullback {Q : PairCat.{u} p} (hp : (p : Q) = 0) (f : P ⟶ Q)
    (X : MarkedUntilt p P) : MarkedUntilt p Q :=
  ofPrimitive hp (X.primitiveIdeal.map
    (WittVector.map (f.toRingHom.restrict _ _ f.map_mem_plus))) sorry

-- Check: marked_self_kernel
example (hp : (p : P) = 0) :
    (self hp).primitiveIdeal = Ideal.span {(p : WittVector p P.pair.plus)} := sorry
-- Check: marked_automorphism
example (X : MarkedUntilt p P) (f : X ≅ X) : f.hom = 𝟙 X :=
  (subsingleton_hom X X).elim _ _
-- Check: marked_distinct_ideals
example (hp : (p : P) = 0) (I J : Ideal (WittVector p P.pair.plus))
    (hI : IsPrimitiveIdeal I) (hJ : IsPrimitiveIdeal J) (hne : I ≠ J) :
    IsEmpty (ofPrimitive hp I hI ≅ ofPrimitive hp J hJ) := sorry
end MarkedUntilt

-- Check: pair_zero
example (X : PairCat.{u} p) [Subsingleton X] (Y : PairCat.{u} p) :
    Subsingleton (Y ⟶ X) ∧ Nonempty (Y ⟶ X) := sorry
-- Check: pair_tilt_two_coordinates
example (X Y : PairCat.{u} p) (f : X ⟶ Y) (x : tilt p X) :
    tilt.coeff 0 ((PairCat.tiltFunctor p).map f |>.toRingHom x) = f.toRingHom (tilt.coeff 0 x) ∧
    tilt.coeff 1 ((PairCat.tiltFunctor p).map f |>.toRingHom x) = f.toRingHom (tilt.coeff 1 x) := sorry
-- Check: triple_characteristic_p
example (X : PairCat.{u} p) (hp : (p : X) = 0) :
    ((classificationFunctor p).obj X).ideal =
      Ideal.span {(p : WittVector p (Pair.tilt p X.pair).plus)} :=
  tilt.theta_kernel_charP p X.pair hp
-- Check: triple_unit_counit
example (X : PairCat.{u} p) :
    (classificationEquivalence p).functor.map ((classificationEquivalence p).unitIso.hom.app X) ≫
      (classificationEquivalence p).counitIso.hom.app ((classificationFunctor p).obj X) =
        𝟙 ((classificationFunctor p).obj X) := sorry
end Categories

/-! ### The completed monoid algebra of nonnegative p-power exponents -/
section PerfectedTateAlgebra
variable (p : ℕ) [Fact p.Prime]
/-! ### P1/perfected-tate-algebra -/

/-- The nonnegative part of `ℤ[1/p]`, inside `ℚ`. -/
def pPowerExponents : AddSubmonoid ℚ :=
  AddSubmonoid.closure (Set.range (fun n : ℕ ↦ (p : ℚ)⁻¹ ^ n))
-- Check: exponents_first_two
example : (1 : ℚ) ∈ pPowerExponents p ∧ (p : ℚ)⁻¹ ∈ pPowerExponents p ∧
    (p : ℚ) * (p : ℚ)⁻¹ = 1 := sorry
-- Check: exponents_zero
example : (0 : ℚ) ∈ pPowerExponents p ∧ (-1 : ℚ) ∉ pPowerExponents p := sorry
-- Check: exponents_not_thirds
example : (1 / 3 : ℚ) ∉ pPowerExponents 2 := sorry

variable {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R] (ϖ : PseudoUniformizerRoots p R) (σ : Type u)

/-- The integral restricted monoid algebra, completed at the chosen small unit. -/
abbrev perfectedTateIntegral :=
  AdicCompletion (Ideal.span {(algebraMap (powerBoundedSubring R)
    (AddMonoidAlgebra (powerBoundedSubring R) (σ →₀ pPowerExponents p)) (ϖ.rootPB 0))})
    (AddMonoidAlgebra (powerBoundedSubring R) (σ →₀ pPowerExponents p))
/-- Invert the image of the adic element in the separated integral completion. -/
abbrev perfectedTateAlgebra := Localization.Away
  (algebraMap (AddMonoidAlgebra (powerBoundedSubring R) (σ →₀ pPowerExponents p))
    (perfectedTateIntegral p ϖ σ)
    (algebraMap (powerBoundedSubring R)
      (AddMonoidAlgebra (powerBoundedSubring R) (σ →₀ pPowerExponents p)) (ϖ.rootPB 0)))
namespace perfectedTateAlgebra
instance : Algebra R (perfectedTateAlgebra p ϖ σ) := sorry
instance : UniformSpace (perfectedTateAlgebra p ϖ σ) := sorry
instance : IsUniformAddGroup (perfectedTateAlgebra p ϖ σ) := sorry
instance : IsTopologicalRing (perfectedTateAlgebra p ϖ σ) := sorry
instance : IsTateRing (perfectedTateAlgebra p ϖ σ) := sorry
instance : CompleteSpace (perfectedTateAlgebra p ϖ σ) := sorry
instance : T2Space (perfectedTateAlgebra p ϖ σ) := sorry

/-- The image of the actual integral completion. -/
abbrev integralImage : Subring (perfectedTateAlgebra p ϖ σ) :=
  (algebraMap (perfectedTateIntegral p ϖ σ) (perfectedTateAlgebra p ϖ σ)).range

theorem hasBasis_nhds_zero :
    (𝓝 (0 : perfectedTateAlgebra p ϖ σ)).HasBasis (fun n : ℕ ↦ 0 ≤ n)
      (fun n ↦ {x | ∃ y : integralImage p ϖ σ,
        x = algebraMap R (perfectedTateAlgebra p ϖ σ) (ϖ.root 0) ^ n * y.val}) := sorry

/-- The monomial with one exponent supported at `s`. -/
def X (s : σ) (a : pPowerExponents p) : perfectedTateAlgebra p ϖ σ :=
  algebraMap (perfectedTateIntegral p ϖ σ) _
    (algebraMap (AddMonoidAlgebra (powerBoundedSubring R) (σ →₀ pPowerExponents p)) _
      (AddMonoidAlgebra.single (Finsupp.single s a) 1))

instance isPerfectoidTateRing {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] (ϖ : PseudoUniformizerRoots p R) (σ : Type u) :
    IsPerfectoidTateRing p (perfectedTateAlgebra p ϖ σ) := sorry

theorem powerBoundedSubring_eq :
    powerBoundedSubring (perfectedTateAlgebra p ϖ σ) = integralImage p ϖ σ := sorry

theorem X_add (s : σ) (a b : pPowerExponents p) :
    X p ϖ σ s (a + b) = X p ϖ σ s a * X p ϖ σ s b := sorry

variable {p σ}
/-- The root monomial `T_s^(1/p^n)`. -/
def rootX (s : σ) (n : ℕ) : perfectedTateAlgebra p ϖ σ :=
  X p ϖ σ s ⟨(p : ℚ)⁻¹ ^ n, AddSubmonoid.subset_closure ⟨n, rfl⟩⟩
theorem rootX_pow (s : σ) (n : ℕ) : rootX ϖ s (n + 1) ^ p = rootX ϖ s n := sorry

variable {S : Type u} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
  [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]
/-- Evaluation on a family of power-bounded compatible roots into a uniform target. -/
def lift {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] (ϖ : PseudoUniformizerRoots p R) {σ : Type u}
    {S : Type u} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
    [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]
    (f : R →+* S) (hf : Continuous f)
    (hS : IsBounded (powerBoundedSubring S : Set S))
    (t : σ → Perfection (powerBoundedSubring S) p) : perfectedTateAlgebra p ϖ σ →+* S := sorry

theorem lift_spec (f : R →+* S) (hf : Continuous f)
    (hS : IsBounded (powerBoundedSubring S : Set S))
    (t : σ → Perfection (powerBoundedSubring S) p) :
    Continuous (lift ϖ f hf hS t) ∧
    (lift ϖ f hf hS t).comp (algebraMap R _) = f ∧
    ∀ s n, lift ϖ f hf hS t (rootX ϖ s n) =
      (Perfection.coeffMonoidHom (powerBoundedSubring S) p n (t s) : S) := sorry

-- Check: perfectedTateAlgebra.lift_one
theorem lift_one (f : R →+* S) (hf : Continuous f)
    (hS : IsBounded (powerBoundedSubring S : Set S)) (s : σ) (n : ℕ) :
    lift ϖ f hf hS (fun _ ↦ 1) (rootX ϖ s n) = 1 := sorry

theorem hom_ext (f g : perfectedTateAlgebra p ϖ σ →+* S) (hf : Continuous f) (hg : Continuous g)
    (hR : f.comp (algebraMap R _) = g.comp (algebraMap R _))
    (hX : ∀ s n, f (rootX ϖ s n) = g (rootX ϖ s n)) : f = g := sorry

/-- Changing the set of variables by the given function. -/
def mapIndex {σ' : Type u} (g : σ → σ') :
    perfectedTateAlgebra p ϖ σ →ₐ[R] perfectedTateAlgebra p ϖ σ' := sorry

theorem mapIndex_rootX {σ' : Type u} (g : σ → σ') (s : σ) (n : ℕ) :
    mapIndex ϖ g (rootX ϖ s n) = rootX ϖ (g s) n := sorry

/-- The empty monoid algebra is the base ring. -/
def emptyEquiv {R : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] (ϖ : PseudoUniformizerRoots p R) :
    perfectedTateAlgebra p ϖ PEmpty.{u+1} ≃ₐ[R] R := sorry

-- Check: perfected_empty
example : Continuous (emptyEquiv ϖ) ∧ Continuous (emptyEquiv ϖ).symm ∧
    ∀ r, emptyEquiv ϖ (algebraMap R _ r) = r := sorry
-- Check: perfected_two_roots
example (s : σ) : rootX ϖ s 1 ^ p = rootX ϖ s 0 ∧
    rootX ϖ s 2 ^ p = rootX ϖ s 1 := ⟨rootX_pow ϖ s 0, rootX_pow ϖ s 1⟩
-- Check: perfected_infinite_series
example [Nontrivial R] :
    Summable (fun n : ℕ ↦ algebraMap R (perfectedTateAlgebra p ϖ (ULift.{u} ℕ)) (ϖ.root 0 ^ n) * rootX ϖ (ULift.up n) 0) ∧
      ¬ Summable (fun n : ℕ ↦ rootX ϖ (ULift.up.{u} n) 0) := sorry
-- Check: perfected_zero
example [Subsingleton R] : Subsingleton (perfectedTateIntegral p ϖ σ) ∧
    Subsingleton (perfectedTateAlgebra p ϖ σ) := sorry
end perfectedTateAlgebra
end PerfectedTateAlgebra

/-! ### The specified normed presentation of a field tilt -/
section TiltField
variable (p : ℕ) [Fact p.Prime] (K : Type u) [NontriviallyNormedField K]
  [IsUltrametricDist K] [CompleteSpace K] [IsPerfectoidField p K]
/-! ### P1/tilt-of-perfectoid-field -/

/-- The multiplicative inverse limit, with the absolute value pulled back by sharp. -/
def tiltField := tilt p K
namespace tiltField
instance instNontriviallyNormedField (p : ℕ) [Fact p.Prime] (K : Type u)
    [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K] [IsPerfectoidField p K] :
    NontriviallyNormedField (tiltField p K) := sorry
/-- The identity on compatible sequences identifies the ring operations. -/
def toTilt : tiltField p K ≃+* tilt p K := sorry
theorem toTilt_apply (x : tiltField p K) : toTilt p K x = (x : tilt p K) := sorry
instance : IsUltrametricDist (tiltField p K) := sorry
instance : CompleteSpace (tiltField p K) := sorry
instance instIsPerfectoidField : IsPerfectoidField p (tiltField p K) := sorry
instance : CharP (tiltField p K) p := sorry

theorem norm_def (x : tiltField p K) : ‖x‖ = ‖tilt.sharp (toTilt p K x)‖ := sorry
theorem continuous_toTilt : Continuous (toTilt p K) ∧ Continuous (toTilt p K).symm := sorry
theorem valueGroup_eq :
    {r : ℝ | ∃ x : (tiltField p K)ˣ, ‖(x : tiltField p K)‖ = r} =
      {r : ℝ | ∃ x : Kˣ, ‖(x : K)‖ = r} := sorry

def equivSelfOfCharP [CharP K p] : tiltField p K ≃+* K :=
  (toTilt p K).trans tilt.equivOfCharP

theorem isometry_equivSelfOfCharP [CharP K p] : Isometry (equivSelfOfCharP p K) := sorry

/-- The ring of integers as a Frobenius inverse limit, for an admissible small quotient. -/
def integerEquiv (ϖ : powerBoundedSubring K) (hϖ : IsPseudoUniformizer (ϖ : K))
    (hp : ϖ ∣ (p : powerBoundedSubring K)) :
    letI : CharP (powerBoundedSubring K ⧸ Ideal.span {ϖ}) p := sorry
    powerBoundedSubring (tiltField p K) ≃+*
      Perfection (powerBoundedSubring K ⧸ Ideal.span {ϖ}) p := sorry

/-- The residue fields are the quotients by elements of norm strictly less than one. -/
def residueFieldEquiv :
    (powerBoundedSubring (tiltField p K) ⧸
      ({
        carrier := {x | ‖(x : tiltField p K)‖ < 1}
        zero_mem' := sorry
        add_mem' := sorry
        smul_mem' := sorry } : Ideal (powerBoundedSubring (tiltField p K)))) ≃+*
    (powerBoundedSubring K ⧸
      ({
        carrier := {x | ‖(x : K)‖ < 1}
        zero_mem' := sorry
        add_mem' := sorry
        smul_mem' := sorry } : Ideal (powerBoundedSubring K))) := sorry

variable (v : Valuation K NNReal) (hvnorm : ∀ x, v x = ‖x‖₊)
  (hv : v.Integers (powerBoundedSubring K)) [Fact (v p ≠ 1)]
def equivMathlibTilt : tiltField p K ≃+* _root_.Tilt K v (powerBoundedSubring K) hv p := sorry

variable [Fact (¬ IsUnit (p : powerBoundedSubring K))]
  [IsAdicComplete (Ideal.span {(p : powerBoundedSubring K)}) (powerBoundedSubring K)]
theorem preTiltVal_eq (x : PreTilt (powerBoundedSubring K) p) :
    PreTilt.val K v (powerBoundedSubring K) hv p x =
      v ((PreTilt.untilt x : powerBoundedSubring K) : K) := sorry

theorem equivMathlibTilt_integral (P : Pair K) (hP : P.plus = powerBoundedSubring K)
    (x : (Pair.tilt p P).plus) :
    ∃ y : PreTilt (powerBoundedSubring K) p,
      equivMathlibTilt p K v hv ((toTilt p K).symm x.val) =
        ((algebraMap (PreTilt (powerBoundedSubring K) p)
          (FractionRing (PreTilt (powerBoundedSubring K) p)) y) : _root_.Tilt K v (powerBoundedSubring K) hv p) ∧
      ∀ n, ∃ hx : tilt.coeff n x.val ∈ powerBoundedSubring K,
        PreTilt.coeff n y = Ideal.Quotient.mk (Ideal.span {(p : powerBoundedSubring K)})
          ⟨tilt.coeff n x.val, hx⟩ := sorry
end tiltField

-- Check: tiltField_two_powers
example (x : tiltField p K) (hx : tilt.sharp (tiltField.toTilt p K x) = (p : K)) :
    ‖x‖ = ‖(p : K)‖ ∧ ‖x ^ 2‖ = ‖(p : K)‖ ^ 2 := sorry
-- Check: tiltField_charP_isometry
example [CharP K p] (x y : tiltField p K) :
    dist (tiltField.equivSelfOfCharP p K x) (tiltField.equivSelfOfCharP p K y) = dist x y :=
  (tiltField.isometry_equivSelfOfCharP p K).dist_eq x y
-- Check: tiltField_cyclotomic_norm
example (ε : tiltField p (padicCyclotomic p))
    (hε : ∀ n, IsPrimitiveRoot (tilt.coeff n (tiltField.toTilt p (padicCyclotomic p) ε)) (p ^ n)) :
    ‖ε‖ = 1 ∧ ‖ε - 1‖ = ‖(p : padicCyclotomic p)‖ ^ ((p : ℝ) / (p - 1)) := sorry
end TiltField

section SliceTilting
variable (p : ℕ) [Fact p.Prime]
namespace PrimitiveTriple
/-- On integral elements the marking is the Teichmüller reduction map. -/
theorem tiltIso_sharp (X : PrimitiveTriple.{u} p) (x : X.base.pair.plus) :
    untiltCarrierEquiv p X (tilt.sharp ((tiltIso p X).inv.toRingHom x.val)) =
      algebraMap (WittVector p X.base.pair.plus ⧸ X.ideal) _
        (Ideal.Quotient.mk X.ideal (WittVector.teichmuller p x)) := sorry
/-- The plus ring and any of its small units specify the quotient-adic topology. -/
theorem untilt_nhds (X : PrimitiveTriple.{u} p) (t : X.base.pair.plus)
    (ht : IsPseudoUniformizer (t : X.base)) :
    (𝓝 (0 : untiltObject p X)).HasBasis (fun n : ℕ ↦ 0 ≤ n)
      (fun n ↦ {x | ∃ y : (untiltObject p X).pair.plus,
        x = ((untiltCarrierEquiv p X).symm
          (algebraMap (WittVector p X.base.pair.plus ⧸ X.ideal) _
            (Ideal.Quotient.mk X.ideal (WittVector.teichmuller p t)))) ^ n * y.val}) := sorry
end PrimitiveTriple

theorem primitiveUntiltingFunctor_map (X Y : PrimitiveTriple.{u} p) (f : X ⟶ Y)
    (w : WittVector p X.base.pair.plus) :
    (PrimitiveTriple.untiltCarrierEquiv p Y)
      (((primitiveUntiltingFunctor p).map f).toRingHom
        ((PrimitiveTriple.untiltCarrierEquiv p X).symm
          (algebraMap (WittVector p X.base.pair.plus ⧸ X.ideal) _ (Ideal.Quotient.mk X.ideal w)))) =
      algebraMap (WittVector p Y.base.pair.plus ⧸ Y.ideal) _
        (Ideal.Quotient.mk Y.ideal
          (WittVector.map (f.pairHom.toRingHom.restrict _ _ f.pairHom.map_mem_plus) w)) := sorry

theorem classificationEquivalence_counit (X : PrimitiveTriple.{u} p) :
    ((classificationEquivalence p).counitIso.hom.app X).pairHom =
      (PrimitiveTriple.tiltIso p X).hom := sorry

theorem classificationEquivalence_unit (X : PairCat.{u} p)
    (w : WittVector p (Pair.tilt p X.pair).plus) :
    ((classificationEquivalence p).unitIso.inv.app X).toRingHom
      ((PrimitiveTriple.untiltCarrierEquiv p ((classificationFunctor p).obj X)).symm
        (algebraMap (WittVector p ((classificationFunctor p).obj X).base.pair.plus ⧸ ((classificationFunctor p).obj X).ideal) _
          (Ideal.Quotient.mk _ w))) = (tilt.theta p X.pair w : X) := sorry

namespace PairCat
/-! ### P1/tilting-equivalence-and-explicit-tilt -/

/-- Tilting a pair equipped with a map from `R`. -/
def sliceTiltFunctor (R : PairCat.{u} p) : Under R ⥤ Under ((tiltFunctor p).obj R) where
  obj S := Under.mk ((tiltFunctor p).map S.hom)
  map f := Under.homMk ((tiltFunctor p).map f.right) (by sorry)
  map_id := sorry
  map_comp := sorry
/-- Extend the base Fontaine ideal to the target's Witt ring. -/
def sliceTriple (R : PairCat.{u} p) (T : Under ((tiltFunctor p).obj R)) : PrimitiveTriple.{u} p where
  base := T.right
  p_zero := sorry
  ideal := (RingHom.ker (tilt.theta p R.pair)).map
    (WittVector.map (T.hom.toRingHom.restrict _ _ T.hom.map_mem_plus))
  primitive := sorry

def sliceUntiltFunctor (R : PairCat.{u} p) : Under ((tiltFunctor p).obj R) ⥤ Under R where
  obj T := Under.mk (show R ⟶ PrimitiveTriple.untiltObject p (sliceTriple p R T) from sorry)
  map f := sorry
  map_id := sorry
  map_comp := sorry

/-- Berkeley 6.2.7: equivalence on algebras over any perfectoid pair. -/
def sliceTiltingEquivalence (R : PairCat.{u} p) : Under R ≌ Under ((tiltFunctor p).obj R) where
  functor := sliceTiltFunctor p R
  inverse := sliceUntiltFunctor p R
  unitIso := sorry
  counitIso := sorry
  functor_unitIso_comp := sorry

-- Check: slice_base
example (R : PairCat.{u} p) :
    ((sliceTiltFunctor p R).obj (Under.mk (𝟙 R))).hom = 𝟙 ((tiltFunctor p).obj R) := sorry
-- Check: slice_characteristic_p_ideal
example (R : PairCat.{u} p) (hp : (p : R) = 0) (T : Under ((tiltFunctor p).obj R)) :
    (sliceTriple p R T).ideal = Ideal.span {(p : WittVector p T.right.pair.plus)} := sorry
-- Check: slice_zero_target
example (R : PairCat.{u} p) (T : Under ((tiltFunctor p).obj R)) [Subsingleton T.right] :
    Subsingleton (((sliceUntiltFunctor p R).obj T).right) := sorry
end PairCat
end SliceTilting

section UniformTiltInterfaces
variable (p : ℕ) [Fact p.Prime] {B : Type u} [CommRing B] [UniformSpace B]
  [IsUniformAddGroup B] [IsTopologicalRing B] [IsTateRing B] [CompleteSpace B] [T2Space B]
  [Fact (IsBounded (powerBoundedSubring B : Set B))]
  [Fact (IsTopologicallyNilpotent (p : B))]
namespace uniformTilt

theorem map_id : map (p := p) (RingHom.id B) continuous_id = RingHom.id _ := sorry

theorem theta_unique (P : Pair B) (f : WittVector p (plus (p := p) P) →+* P.plus)
    (hf : ∀ x, (f (WittVector.teichmuller p x) : B) = sharp p B x.val) :
    f = theta (p := p) P := sorry

theorem theta_eq_fontaineTheta (P : Pair B) [Fact (¬ IsUnit (p : P.plus))]
    [IsAdicComplete (Ideal.span {(p : P.plus)}) P.plus] :
    theta (p := p) P = (WittVector.fontaineTheta P.plus p).comp
      (WittVector.map (plusEquiv (p := p) P (Ideal.span {(p : P.plus)})).toRingHom) := sorry

variable {C : Type u} [CommRing C] [UniformSpace C] [IsUniformAddGroup C]
  [IsTopologicalRing C] [IsTateRing C] [CompleteSpace C] [T2Space C]
  [Fact (IsBounded (powerBoundedSubring C : Set C))]
  [Fact (IsTopologicallyNilpotent (p : C))]

theorem theta_natural (P : Pair B) (Q : Pair C) (f : Pair.Hom P Q) :
    ∃ h : ∀ x ∈ plus (p := p) P,
      map (p := p) f.toRingHom f.continuous_toRingHom x ∈ plus (p := p) Q,
    (theta (p := p) Q).comp (WittVector.map
      ((map (p := p) f.toRingHom f.continuous_toRingHom).restrict _ _ h)) =
        (f.toRingHom.restrict _ _ f.map_mem_plus).comp (theta (p := p) P) := sorry

variable {D : Type u} [CommRing D] [UniformSpace D] [IsUniformAddGroup D]
  [IsTopologicalRing D] [IsTateRing D] [CompleteSpace D] [T2Space D]
  [Fact (IsBounded (powerBoundedSubring D : Set D))]
  [Fact (IsTopologicallyNilpotent (p : D))]
theorem map_comp (f : B →+* C) (hf : Continuous f) (g : C →+* D) (hg : Continuous g) :
    map (p := p) (g.comp f) (hg.comp hf) =
      (map (p := p) g hg).comp (map (p := p) f hf) := sorry

-- Check: uniform_zero_integral
example [Subsingleton B] (P : Pair B) :
    Subsingleton (uniformTilt p B) ∧ Subsingleton (plus (p := p) P) ∧
      ∀ w, theta (p := p) P w = 0 := sorry
-- Check: uniform_charP_theta
example [CharP B p] [PerfectRing B p] (P : Pair B) :
    RingHom.ker (theta (p := p) P) = Ideal.span {(p : WittVector p (plus (p := p) P))} := sorry
-- Check: uniform_cyclotomic_theta
example (P : Pair (padicCyclotomic p))
    (ε : plus (p := p) P)
    (hε : ∀ n, IsPrimitiveRoot (coeff p (padicCyclotomic p) n ε.val) (p ^ n)) :
    theta (p := p) P (WittVector.teichmuller p ε - 1) = 0 ∧
      ε - 1 ≠ 0 := sorry
-- Check: uniform_map_two_coordinates
example (f : B →+* C) (hf : Continuous f) (x : uniformTilt p B) :
    coeff p C 0 (map (p := p) f hf x) = f (coeff p B 0 x) ∧
    coeff p C 1 (map (p := p) f hf x) = f (coeff p B 1 x) :=
  ⟨coeff_map f hf x 0, coeff_map f hf x 1⟩
end uniformTilt
end UniformTiltInterfaces

section FilteredCompletion
variable (p : ℕ) [Fact p.Prime] {J : Type u} [SmallCategory J] [IsFiltered J]
  (F : J ⥤ PairCat.{u} p)
/-! ### P1/completed-colimit-of-perfectoid-tate-rings -/

/-- The diagram of maximal integral subrings, with the restricted transition maps. -/
def integralDiagram : J ⥤ CommRingCat.{u} where
  obj j := CommRingCat.of (powerBoundedSubring (F.obj j))
  map f := CommRingCat.ofHom ((F.map f).toRingHom.restrict _ _
    (fun x hx ↦ map_mem_powerBoundedSubring (IsPerfectoidTateRing.isBounded_powerBoundedSubring (p := p))
      (F.map f).toRingHom (F.map f).continuous_toRingHom hx))
  map_id := sorry
  map_comp := sorry
variable (j₀ : J) (ϖ : PseudoUniformizerRoots p (F.obj j₀))
/-- Complete the algebraic integral colimit before inverting the chosen element. -/
abbrev filteredIntegralCompletion := AdicCompletion
  (Ideal.span {((colimit.ι (integralDiagram p F) j₀) (ϖ.rootPB 0))})
  (↥(colimit (integralDiagram p F)))
/-- The separated completed filtered colimit of the Tate rings. -/
def completedFilteredColimit := Localization.Away
  (algebraMap (↥(colimit (integralDiagram p F))) (filteredIntegralCompletion p F j₀ ϖ)
    ((colimit.ι (integralDiagram p F) j₀) (ϖ.rootPB 0)))
namespace completedFilteredColimit
instance : CommRing (completedFilteredColimit p F j₀ ϖ) := by
  unfold completedFilteredColimit
  infer_instance
instance : Algebra (filteredIntegralCompletion p F j₀ ϖ) (completedFilteredColimit p F j₀ ϖ) := by
  unfold completedFilteredColimit
  infer_instance
instance : UniformSpace (completedFilteredColimit p F j₀ ϖ) := sorry
instance : IsUniformAddGroup (completedFilteredColimit p F j₀ ϖ) := sorry
instance : IsTopologicalRing (completedFilteredColimit p F j₀ ϖ) := sorry
/-- ECD Proposition 6.5, p. 29: the localized integral completion is a Tate ring. -/
theorem isTateRing : IsTateRing (completedFilteredColimit p F j₀ ϖ) := sorry
instance : IsTateRing (completedFilteredColimit p F j₀ ϖ) := isTateRing p F j₀ ϖ
instance : CompleteSpace (completedFilteredColimit p F j₀ ϖ) := sorry
instance : T2Space (completedFilteredColimit p F j₀ ϖ) := sorry
/-- ECD Proposition 6.5, p. 29: perfectoidness of the localized integral completion. -/
theorem isPerfectoidTateRing :
    IsPerfectoidTateRing p (completedFilteredColimit p F j₀ ϖ) := sorry
instance : IsPerfectoidTateRing p (completedFilteredColimit p F j₀ ϖ) :=
  isPerfectoidTateRing p F j₀ ϖ

/-- The structural map is the extension of the map on the integral colimit. -/
def ι (j : J) : F.obj j →+* completedFilteredColimit p F j₀ ϖ := sorry

theorem ι_integral (j : J) (x : powerBoundedSubring (F.obj j)) :
    ι p F j₀ ϖ j x.val =
      algebraMap (filteredIntegralCompletion p F j₀ ϖ) _
        (algebraMap (↥(colimit (integralDiagram p F))) _ ((colimit.ι (integralDiagram p F) j) x)) := sorry

theorem continuous_ι (j : J) : Continuous (ι p F j₀ ϖ j) := sorry

theorem hasBasis_nhds_zero :
    (𝓝 (0 : completedFilteredColimit p F j₀ ϖ)).HasBasis (fun n : ℕ ↦ 0 ≤ n)
      (fun n ↦ {x | ∃ y : filteredIntegralCompletion p F j₀ ϖ,
        x = (ι p F j₀ ϖ j₀ (ϖ.root 0)) ^ n * algebraMap _ _ y}) := sorry

theorem ι_naturality {i j : J} (a : i ⟶ j) :
    (ι p F j₀ ϖ j).comp (F.map a).toRingHom = ι p F j₀ ϖ i := sorry

theorem denseRange : Dense (⋃ j, Set.range (ι p F j₀ ϖ j)) := sorry

variable {S : Type u} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
  [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]
/-- Factor a compatible continuous family into a complete uniform Tate ring. -/
def lift {S : Type u} [CommRing S] [UniformSpace S] [IsUniformAddGroup S]
    [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]
    (hS : IsBounded (powerBoundedSubring S : Set S)) (f : ∀ j, F.obj j →+* S)
    (hf : ∀ j, Continuous (f j))
    (hnat : ∀ {i j} (a : i ⟶ j), (f j).comp (F.map a).toRingHom = f i) :
    completedFilteredColimit p F j₀ ϖ →+* S := sorry

theorem lift_spec (hS : IsBounded (powerBoundedSubring S : Set S)) (f : ∀ j, F.obj j →+* S)
    (hf : ∀ j, Continuous (f j))
    (hnat : ∀ {i j} (a : i ⟶ j), (f j).comp (F.map a).toRingHom = f i) :
    Continuous (lift p F j₀ ϖ hS f hf hnat) ∧
      ∀ j, (lift p F j₀ ϖ hS f hf hnat).comp (ι p F j₀ ϖ j) = f j := sorry

theorem hom_ext (f g : completedFilteredColimit p F j₀ ϖ →+* S)
    (hf : Continuous f) (hg : Continuous g)
    (h : ∀ j, f.comp (ι p F j₀ ϖ j) = g.comp (ι p F j₀ ϖ j)) : f = g := sorry

theorem ringOfDefinition_almostEq :
    (algebraMap (filteredIntegralCompletion p F j₀ ϖ) _).range ≤
      powerBoundedSubring (completedFilteredColimit p F j₀ ϖ) ∧
    ∀ n (x : powerBoundedSubring (completedFilteredColimit p F j₀ ϖ)),
      ι p F j₀ ϖ j₀ (ϖ.root n) * x.val ∈
        (algebraMap (filteredIntegralCompletion p F j₀ ϖ) _).range := sorry

/-- Any terminal stage already has the completed colimit topology. -/
def terminalEquiv (j : J) (hj : IsTerminal j) :
    completedFilteredColimit p F j₀ ϖ ≃+* F.obj j := sorry

theorem terminalEquiv_spec (j : J) (hj : IsTerminal j) :
    Continuous (terminalEquiv p F j₀ ϖ j hj) ∧
    Continuous (terminalEquiv p F j₀ ϖ j hj).symm ∧
    (terminalEquiv p F j₀ ϖ j hj).toRingHom.comp (ι p F j₀ ϖ j) = RingHom.id _ := sorry

-- Check: filtered_terminal
example (j : J) (hj : IsTerminal j) (x : F.obj j) :
    terminalEquiv p F j₀ ϖ j hj (ι p F j₀ ϖ j (x + 1)) = x + 1 := sorry
-- Check: filtered_zero_terminal
example (j : J) (hj : IsTerminal j) [Subsingleton (F.obj j)] :
    Subsingleton (completedFilteredColimit p F j₀ ϖ) := sorry
-- Check: filtered_two_roots
example :
    ι p F j₀ ϖ j₀ (ϖ.root 1) ^ p = ι p F j₀ ϖ j₀ (ϖ.root 0) ∧
    ι p F j₀ ϖ j₀ (ϖ.root 2) ^ p = ι p F j₀ ϖ j₀ (ϖ.root 1) := sorry
end completedFilteredColimit
end FilteredCompletion

section TiltedRoots
variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R]
