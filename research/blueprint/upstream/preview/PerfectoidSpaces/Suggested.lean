/-! ### P3/finite-etale-completed-direct-limit -/

/-- Berkeley Theorem 7.4.8, p. 54: finite étale algebras over a topologically
henselian Tate ring are unchanged by separated completion. -/
theorem finiteEtale_completion_tate (A : Type u) [CommRing A] [UniformSpace A]
    [IsUniformAddGroup A] [IsTopologicalRing A] [IsTateRing A]
    (A₀ : Subring A) (hopen : IsOpen (A₀ : Set A))
    (t : A₀) (ht : IsPseudoUniformizer (t : A))
    (htop : IsAdic (Ideal.span {t})) [HenselianRing A₀ (Ideal.span {t})] :
    letI := (UniformSpace.Completion.coeRingHom : A →+* UniformSpace.Completion A).toAlgebra
    (CommAlgCat.FiniteEtale.baseChange.{u} A (UniformSpace.Completion A)).IsEquivalence := sorry

/-- Berkeley Theorem 7.4.8 and its corollary, p. 54; Sch12 7.5(i), pp. 40–41:
completion preserves finite étale algebras over a filtered colimit of complete Tate
rings. The neighbourhood basis fixes the colimit topology; the colimit need not be
separated and neither transition maps nor completion maps need be injective. -/
theorem finiteEtale_completedColimit {J : Type u} [SmallCategory J] [IsFiltered J]
    (D : J ⥤ CommRingCat.{u})
    [∀ j, UniformSpace (D.obj j)] [∀ j, IsUniformAddGroup (D.obj j)]
    [∀ j, IsTopologicalRing (D.obj j)] [∀ j, IsTateRing (D.obj j)]
    [∀ j, CompleteSpace (D.obj j)] [∀ j, T2Space (D.obj j)]
    (P : ∀ j, Pair (D.obj j))
    (f : ∀ {i j}, (i ⟶ j) → Pair.Hom (P i) (P j))
    (hf : ∀ {i j} (a : i ⟶ j), (f a).toRingHom = (D.map a).hom)
    (A₀ : ∀ j, Subring (D.obj j))
    (hopen : ∀ j, IsOpen (A₀ j : Set (D.obj j)))
    (hplus : ∀ j, A₀ j ≤ (P j).plus)
    (hmap : ∀ {i j} (a : i ⟶ j) (x : D.obj i), x ∈ A₀ i → D.map a x ∈ A₀ j)
    (t : ∀ j, A₀ j) (ht : ∀ j, IsPseudoUniformizer (t j : D.obj j))
    (htop : ∀ j, IsAdic (Ideal.span {t j}))
    (htmap : ∀ {i j} (a : i ⟶ j), D.map a (t i) = (t j : D.obj j)) (j₀ : J)
    [UniformSpace (↥(colimit D))] [IsUniformAddGroup (↥(colimit D))]
    [IsTopologicalRing (↥(colimit D))]
    (hnhds :
      let L₀ : Subring (↥(colimit D)) :=
        Subring.closure (⋃ j, (colimit.ι D j).hom '' (A₀ j : Set (D.obj j)))
      (𝓝 (0 : ↥(colimit D))).HasBasis (fun n : ℕ ↦ 0 ≤ n)
        (fun n ↦ {x | ∃ y : L₀, x = ((colimit.ι D j₀).hom (t j₀)) ^ n * y.val})) :
    letI := (UniformSpace.Completion.coeRingHom :
      ↥(colimit D) →+* UniformSpace.Completion (↥(colimit D))).toAlgebra
    (CommAlgCat.FiniteEtale.baseChange.{u} (↥(colimit D))
      (UniformSpace.Completion (↥(colimit D)))).IsEquivalence := sorry

-- Check: finiteEtale_completion_tate_complete
example (A : Type u) [CommRing A] [UniformSpace A] [IsUniformAddGroup A]
    [IsTopologicalRing A] [IsTateRing A] [CompleteSpace A] [T2Space A] :
    letI := (UniformSpace.Completion.coeRingHom : A →+* UniformSpace.Completion A).toAlgebra
    (CommAlgCat.FiniteEtale.baseChange.{u} A (UniformSpace.Completion A)).IsEquivalence := sorry

-- Check: finiteEtale_completion_tate_zero
example (A : Type u) [CommRing A] [UniformSpace A] [IsUniformAddGroup A]
    [IsTopologicalRing A] [Subsingleton A] :
    letI := (UniformSpace.Completion.coeRingHom : A →+* UniformSpace.Completion A).toAlgebra
    (CommAlgCat.FiniteEtale.baseChange.{u} A (UniformSpace.Completion A)).IsEquivalence := sorry

/- The torsor-tower specialization is
`AdicEtaleGeometry.FiniteEtaleTorsorTower.completion_finiteEtale_equivalence`. -/
example := @finiteEtale_completedColimit

/-! ### Layer 3: Geometric finite étale maps and the small site -/
namespace Perfectoid
open TauCetiRoadmap.AdicEtaleGeometry
variable {p : ℕ} [Fact p.Prime]

/-- Finite étale affinoid pair map, including its natural topology and integral closure. -/
def Pair.IsFiniteEtale {R S : PairCat p} (f : R ⟶ S) : Prop :=
  letI := f.toRingHom.toAlgebra
  Module.Finite R S ∧ Algebra.Etale R S ∧ IsModuleTopology R S ∧
    S.pair.plus = (integralClosure (R.pair.plus.map f.toRingHom) S).toSubring

/-- The integral algebra map used in almost purity, over the source's almost setup. -/
def Pair.almostMap {R S : PairCat p} (f : R ⟶ S) :
    (Almost.Algebra.toAlmost (almostSetup p R)).obj
        (CommAlgCat.of (powerBoundedSubring R) (powerBoundedSubring R)) ⟶
      (Almost.Algebra.toAlmost (almostSetup p R)).obj
        (letI := (f.toRingHom.restrict (powerBoundedSubring R) (powerBoundedSubring S)
          (fun _ hx ↦ map_mem_powerBoundedSubring
            (IsPerfectoidTateRing.isBounded_powerBoundedSubring (p := p))
            f.toRingHom f.continuous_toRingHom hx)).toAlgebra
         CommAlgCat.of (powerBoundedSubring R) (powerBoundedSubring S)) := by
  let g := f.toRingHom.restrict (powerBoundedSubring R) (powerBoundedSubring S)
    (fun _ hx ↦ map_mem_powerBoundedSubring
            (IsPerfectoidTateRing.isBounded_powerBoundedSubring (p := p))
            f.toRingHom f.continuous_toRingHom hx)
  letI := g.toAlgebra
  exact (Almost.Algebra.toAlmost (almostSetup p R)).map
    (CommAlgCat.ofHom (Algebra.ofId (powerBoundedSubring R) (powerBoundedSubring S)))

/-! ### P3/strongly-etale-morphisms-and-base-change -/

/-- Scholze Definition 7.2: the finite étale condition with almost finite étale unit balls. -/
def Pair.IsStronglyFiniteEtale {R S : PairCat p} (f : R ⟶ S) : Prop :=
  Pair.IsFiniteEtale f ∧ Almost.Algebra.IsFiniteEtale (almostSetup p R) (Pair.almostMap f)

/-! ### P3/integral-closure-almost-finite-etale -/

/-- The trace of multiplication on a finite projective algebra (GR 4.1.7).
Its value is fixed by any finite free retraction in `trace_retraction`. -/
def FiniteEtale.trace (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    [Module.Finite R S] [Algebra.Etale R S] : S →ₗ[R] R := sorry

/-- A finite free retraction computes the projective trace, independently of the retraction. -/
theorem FiniteEtale.trace_retraction (R S : Type u) [CommRing R] [CommRing S]
    [Algebra R S] [Module.Finite R S] [Algebra.Etale R S]
    (n : ℕ) (a : S →ₗ[R] (Fin n → R)) (b : (Fin n → R) →ₗ[R] S)
    (hab : b.comp a = LinearMap.id) (x : S) :
    FiniteEtale.trace R S x = ∑ i, a (x * b (Pi.single i 1)) i := sorry

/-- Over a finite free algebra the projective trace agrees with Mathlib's trace. -/
theorem FiniteEtale.trace_eq_of_free (R S : Type u) [CommRing R] [CommRing S]
    [Algebra R S] [Module.Finite R S] [Algebra.Etale R S] [Module.Free R S] :
    FiniteEtale.trace R S = Algebra.trace R S := sorry

-- Check: FiniteEtale.trace_zero
example (R : Type u) [CommRing R] (x : Fin 0 → R) :
    FiniteEtale.trace R (Fin 0 → R) x = 0 := sorry
-- Check: FiniteEtale.trace_one
example (R : Type u) [CommRing R] (x : R) : FiniteEtale.trace R R x = x := sorry
-- Check: FiniteEtale.trace_two
example (R : Type u) [CommRing R] (x : Fin 2 → R) :
    FiniteEtale.trace R (Fin 2 → R) x = x 0 + x 1 := sorry

-- Check: FiniteEtale.trace_nonconstant_rank
example (K : Type u) [Field K] (x : K) :
    letI := (RingHom.fst K K).toAlgebra
    letI : Module.Finite (K × K) K := by sorry
    letI : Algebra.Etale (K × K) K := by sorry
    FiniteEtale.trace (K × K) K x = (x, 0) ∧ ¬ Module.Free (K × K) K := sorry
-- Check: integral_trace_zero_not_faithful
example (R : Type u) [CommRing R] [Nontrivial R] :
    ¬ Module.FaithfullyFlat R (Fin 0 → R) := sorry
-- Check: integral_trace_characteristic_two
example (R : Type u) [CommRing R] [CharP R 2] :
    FiniteEtale.trace R (Fin 2 → R) 1 = 0 ∧
      FiniteEtale.trace R (Fin 2 → R) (Pi.single 0 1) = 1 := sorry

/-- ECD 6.1 and Sch12 5.23: the power-bounded ring is the integral closure. -/
theorem Pair.integralClosure_powerBounded {R S : PairCat p} (f : R ⟶ S)
    (hf : Pair.IsFiniteEtale f) :
    powerBoundedSubring S =
      (integralClosure ((powerBoundedSubring R).map f.toRingHom) S).toSubring ∧
    (∀ s : S, IsTopologicallyNilpotent s → s ∈ S.pair.plus) ∧
    S.pair.plus ≤ powerBoundedSubring S ∧
    ∀ ε : R, IsTopologicallyNilpotent ε → ∀ s ∈ powerBoundedSubring S,
      f.toRingHom ε * s ∈ S.pair.plus := sorry

/-- Sch12 5.23 and 7.9(iii): uniform epsilon factorizations on the honest unit balls. -/
theorem Pair.integralClosure_uniformlyAlmostFiniteProjective {R S : PairCat p}
    (f : R ⟶ S) (hf : Pair.IsFiniteEtale f) :
    let g := f.toRingHom.restrict (powerBoundedSubring R) (powerBoundedSubring S)
      (fun _ hx ↦ map_mem_powerBoundedSubring
        (IsPerfectoidTateRing.isBounded_powerBoundedSubring (p := p))
        f.toRingHom f.continuous_toRingHom hx)
    letI := g.toAlgebra
    ∃ n : ℕ, ∀ ε : powerBoundedSubring R, ε ∈ (almostSetup p R).ideal →
      ∃ (a : powerBoundedSubring S →ₗ[powerBoundedSubring R] (Fin n → powerBoundedSubring R))
        (b : (Fin n → powerBoundedSubring R) →ₗ[powerBoundedSubring R] powerBoundedSubring S),
        b.comp a = ε • LinearMap.id := sorry

/-- GR 4.1.14: the integral trace pairing is an almost isomorphism.
The displayed pairing fixes the comparison with the rational projective trace. -/
theorem Pair.integralClosure_trace {R S : PairCat p} (f : R ⟶ S)
    (hf : Pair.IsFiniteEtale f) :
    letI := f.toRingHom.toAlgebra
    letI : Module.Finite R S := hf.1
    letI : Algebra.Etale R S := hf.2.1
    let g := f.toRingHom.restrict (powerBoundedSubring R) (powerBoundedSubring S)
      (fun _ hx ↦ map_mem_powerBoundedSubring
        (IsPerfectoidTateRing.isBounded_powerBoundedSubring (p := p))
        f.toRingHom f.continuous_toRingHom hx)
    letI := g.toAlgebra
    (∀ s ∈ powerBoundedSubring S, FiniteEtale.trace R S s ∈ powerBoundedSubring R) ∧
    ∃ τ : powerBoundedSubring S →ₗ[powerBoundedSubring R]
        (powerBoundedSubring S →ₗ[powerBoundedSubring R] powerBoundedSubring R),
      (∀ s t, (τ s t).val = FiniteEtale.trace R S (s.val * t.val)) ∧
      (almostSetup p R).IsAlmostIso τ := sorry

/-- Sch12 7.9 and GR 4.1.14: faithful flatness gives trace lifts and epsilon splittings. -/
theorem Pair.integralClosure_faithfullyFlat {R S : PairCat p} (f : R ⟶ S)
    (hf : Pair.IsFiniteEtale f)
    (hfaith : letI := f.toRingHom.toAlgebra; Module.FaithfullyFlat R S) :
    letI := f.toRingHom.toAlgebra
    letI : Module.Finite R S := hf.1
    letI : Algebra.Etale R S := hf.2.1
    let g := f.toRingHom.restrict (powerBoundedSubring R) (powerBoundedSubring S)
      (fun _ hx ↦ map_mem_powerBoundedSubring
        (IsPerfectoidTateRing.isBounded_powerBoundedSubring (p := p))
        f.toRingHom f.continuous_toRingHom hx)
    letI := g.toAlgebra
    Almost.Algebra.IsFaithfullyFlat (almostSetup p R) (Pair.almostMap f) ∧
    (∀ ε : R, IsTopologicallyNilpotent ε →
      ∃ s : S, IsTopologicallyNilpotent s ∧ FiniteEtale.trace R S s = ε) ∧
    ∀ ε : powerBoundedSubring R, ε ∈ (almostSetup p R).ideal →
      ∃ r : powerBoundedSubring S →ₗ[powerBoundedSubring R] powerBoundedSubring R,
        ∀ a : powerBoundedSubring R, r (g a) = ε * a := sorry

/-- Sch12 7.9: the almost algebra of integral elements in a finite étale pair is finite étale. -/
theorem Pair.integralClosure_almostFiniteEtale {R S : PairCat p} (f : R ⟶ S)
    (hf : Pair.IsFiniteEtale f) :
    Almost.Algebra.IsFiniteEtale (almostSetup p R) (Pair.almostMap f) := sorry

