/-!
# PerfectoidSpaces: representative target signatures

The README is the definitive specification. These are suggested forms for a subset of
its targets and Checks, not an exhaustive checklist.

Almost algebra is relative to an idempotent ideal with flat square. Perfectoid Tate rings
are complete Hausdorff uniform Tate rings with the specified Frobenius condition. The global
space category uses analytic charts, and the affinoid constructions retain their integral rings.

* A perfectoid Tate ring (`Perfectoid.IsPerfectoidTateRing p R`) is ECD Definition 3.1 with real
  fields over Tau Ceti's `IsTateRing`: a complete Hausdorff uniform Tate ring with a
  pseudo-uniformiser `ϖ ∈ R°` such that `ϖ ^ p ∣ p` in `R°` and Frobenius `R°/ϖ → R°/ϖ^p` is
  bijective. No base field is fixed. Tilts are built on Mathlib's `Perfection`, Fontaine's `θ`
  on `WittVector.fontaineTheta`, and the comparisons with Mathlib's `PreTilt` and `PreTilt.untilt`
  are stated.
* Almost mathematics is relative to an explicit basic setup `Almost.BasicSetup V` (an idempotent
  ideal `m` with `m ⊗_V m` flat, GR §2.1), a structure rather than a class. The almost module
  category is Mathlib's Serre-class localisation of `ModuleCat V` at the almost isomorphisms.
* Huber pairs, rational subsets and completed localisation are Tau Ceti's (`Huber.Pair`,
  `ValuationSpectrum.spa`, `rationalSubset`, `PairOfDefinition.completionLocObj`); statements
  about `𝒪_X(U)` are made per presentation.
* The carriers of AdicSpacesPartII Layer R0 that the signatures need (adic ring maps, completed
  tensor products of Huber pairs, the spectral topology and the uniformisation, finite morphisms
  of Huber pairs) are imported from that roadmap's `Suggested.lean`, through AdicEtaleGeometry's,
  and applied explicitly (`Pair.uniformization S` rather than `S.uniformization`).
* Perfectoid spaces use the full subcategory `PerfectoidSpace.Perfd` of `YonedaAdicSpace`,
  with charts from perfectoid Tate pairs. The affinoid comparisons specify the relationship
  with Tau Ceti's adic spectra, including the integral structure sheaves.
-/

/-! ## Layer 0: Almost mathematics over a basic setup -/
noncomputable section

namespace TauCetiRoadmap.PerfectoidSpaces

open TauCeti TauCetiRoadmap.AdicSpacesPartII.Huber

universe u

open _root_.CategoryTheory Limits MonoidalCategory TensorProduct
open ZeroObject

namespace Almost

/-! ### P0/almost-basic-setup -/

/-- A *basic setup* `(V, m)`: an ideal `m` of `V` with
`m * m = m` (Gabber–Ramero's basic setup, GR (2.1.1)) such that `m̃ = m ⊗_V m` is flat (GR's
standing assumption from (2.5.14) on). Data, not a class: one ring carries several setups. -/
structure BasicSetup (V : Type u) [CommRing V] where
  /-- The ideal `m`. -/
  ideal : Ideal V
  /-- `m * m = m`, in the semiring `Ideal V`. -/
  isIdempotentElem : IsIdempotentElem ideal
  /-- `m̃ = m ⊗_V m` is a flat `V`-module. -/
  flat_tilde : Module.Flat V (ideal ⊗[V] ideal)

namespace BasicSetup

variable {V : Type u} [CommRing V] (S : BasicSetup V)

/-- The `V`-module `m̃ := m ⊗_V m` (GR (2.1.1)). -/
abbrev tilde : Type u := S.ideal ⊗[V] S.ideal

/-- The multiplication map `m̃ → V`, `x ⊗ y ↦ xy`, whose image is
`m · m = m` (GR (2.1.1)). -/
def tildeMul : S.tilde →ₗ[V] V :=
  TensorProduct.lift ((LinearMap.mul V V).compl₁₂ S.ideal.subtype S.ideal.subtype)

/-- A `V`-module `M` is *almost zero* if `m · M = 0`
(GR (2.1.3)). -/
def IsAlmostZero (M : Type*) [AddCommGroup M] [Module V M] : Prop :=
  ∀ ε ∈ S.ideal, ∀ x : M, ε • x = 0

/-- The almost zero `V`-modules, as an object property of
`ModuleCat V` (GR (2.2.2)). -/
def almostZero : ObjectProperty (ModuleCat.{u} V) := fun M ↦ S.IsAlmostZero M

/-- The classical setup `(V, V)`, the "classical limit" of
GR Example 2.1.2(ii). -/
def classical (V : Type u) [CommRing V] : BasicSetup V where
  ideal := ⊤
  isIdempotentElem := sorry
  flat_tilde := sorry

/-- For the classical setup, almost zero means zero
(GR Example 2.1.2(ii)). -/
theorem isAlmostZero_classical_iff (M : Type*) [AddCommGroup M] [Module V M] :
    (classical V).IsAlmostZero M ↔ Subsingleton M := sorry

/-! ### P0/basic-setup-base-change -/

/-- The base change `(W, m·W)` of a setup along `V → W`
(GR Remark 2.1.4(ii)). -/
def baseChange (W : Type*) [CommRing W] [Algebra V W] : BasicSetup W where
  ideal := S.ideal.map (algebraMap V W)
  isIdempotentElem := sorry
  flat_tilde := sorry

-- Check: test_classical
example (M : Type u) [AddCommGroup M] [Module V M] :
    (classical V).ideal = ⊤ ∧ ((classical V).IsAlmostZero M ↔ Subsingleton M) := sorry

-- Check: test_zero_ideal
example : ∃ S : BasicSetup V, S.ideal = ⊥ ∧
    ∀ (M : Type u) [AddCommGroup M] [Module V M], S.IsAlmostZero M := sorry

-- Check: test_not_dvr
example (p : ℕ) [Fact p.Prime] : ¬ IsIdempotentElem (IsLocalRing.maximalIdeal ℤ_[p]) := sorry

/-! ### P0/root-ideal-basic-setup -/

/-- The *root setup* of a sequence `ϖ` with
`ϖ (n + 1) ^ p = ϖ n`, `p ≥ 2`: the ideal `m = ⋃ ϖ_n V` (Bhatt Example 4.1.3, p. 18;
cf. ECD Definition 3.21, p. 19). -/
def ofCompatibleRoots (p : ℕ) (hp : 2 ≤ p) (ϖ : ℕ → V) (hϖ : ∀ n, ϖ (n + 1) ^ p = ϖ n) :
    BasicSetup V where
  ideal := Ideal.span (Set.range ϖ)
  isIdempotentElem := sorry
  flat_tilde := sorry

section roots

open scoped Pointwise

variable (p : ℕ) (hp : 2 ≤ p) (ϖ : ℕ → V) (hϖ : ∀ n, ϖ (n + 1) ^ p = ϖ n)

/-- The ideal of the root setup (Bhatt Example 4.1.3, p. 18;
cf. ECD Definition 3.21, p. 19). -/
@[simp] theorem ofCompatibleRoots_ideal :
    (ofCompatibleRoots p hp ϖ hϖ).ideal = Ideal.span (Set.range ϖ) := rfl

/-- `x ∈ m` iff some `ϖ_n` divides `x`, `m` being
the increasing union of the `ϖ_n V` (Bhatt Example 4.1.3). -/
theorem mem_ofCompatibleRoots_ideal (x : V) :
    x ∈ (ofCompatibleRoots p hp ϖ hϖ).ideal ↔ ∃ n, ϖ n ∣ x := sorry

/-- Every `ϖ_n` lies in the ideal of the root setup. -/
@[simp] theorem ofCompatibleRoots_mem (n : ℕ) : ϖ n ∈ (ofCompatibleRoots p hp ϖ hϖ).ideal :=
  sorry

end roots

-- Check: roots_test_quotients
example (p : ℕ) (hp : 2 ≤ p) (t : ℕ → V) (ht : ∀ n, t (n + 1) ^ p = t n)
    (hnz : t 1 ∉ Ideal.span {t 0}) :
    ¬ (ofCompatibleRoots p hp t ht).IsAlmostZero (V ⧸ Ideal.span {t 0}) ∧
      (ofCompatibleRoots p hp t ht).IsAlmostZero (V ⧸ (ofCompatibleRoots p hp t ht).ideal) :=
  sorry

-- Check: ofCompatibleRoots_test_perfect_polynomial
example (p : ℕ) [Fact p.Prime] :
    let R := PerfectClosure (Polynomial (ZMod p)) p
    ∃ t : ℕ → R, t 0 = PerfectClosure.of (Polynomial (ZMod p)) p Polynomial.X ∧
      ∃ ht : ∀ n, t (n + 1) ^ p = t n,
        let S := ofCompatibleRoots p (by exact (Fact.out : p.Prime).two_le) t ht
        ¬ S.IsAlmostZero (R ⧸ Ideal.span {t 0}) ∧
        S.IsAlmostZero (R ⧸ S.ideal) ∧ Nonempty ((R ⧸ S.ideal) ≃+* ZMod p) := sorry

-- Check: roots_test_unit
example (p : ℕ) (hp : 2 ≤ p) :
    ofCompatibleRoots p hp (fun _ ↦ (1 : V)) (fun _ ↦ one_pow p) = classical V := sorry

-- Check: roots_test_zero
example (p : ℕ) (hp : 2 ≤ p) :
    (ofCompatibleRoots p hp (fun _ ↦ (0 : V)) (fun _ ↦ zero_pow (by omega : p ≠ 0))).ideal =
      ⊥ := sorry

/- `ϖ 0 = 0` alone does not force the zero setup: if `ϖ 1 ≠ 0` the ideal is nonzero. -/
-- Check: roots_test_nilpotent
example (p : ℕ) (hp : 2 ≤ p) (ϖ : ℕ → V) (hϖ : ∀ n, ϖ (n + 1) ^ p = ϖ n) (h0 : ϖ 0 = 0)
    (h1 : ϖ 1 ≠ 0) : (ofCompatibleRoots p hp ϖ hϖ).ideal ≠ ⊥ := sorry

/- For `ϖ 0` a unit the root ideal is `⊤`, not the maximal ideal. -/
-- Check: roots_test_unit_initial
example (p : ℕ) (hp : 2 ≤ p) (ϖ : ℕ → V) (hϖ : ∀ n, ϖ (n + 1) ^ p = ϖ n)
    (hu : IsUnit (ϖ 0)) : (ofCompatibleRoots p hp ϖ hϖ).ideal = ⊤ := sorry

-- Check: roots_test_no_roots
example (p : ℕ) [Fact p.Prime] :
    ¬ IsIdempotentElem (Ideal.span {(Polynomial.X : Polynomial (ZMod p))}) := sorry

/- `(t) ⊆ 𝔽_p[t]` is principal but its squares generate `(t²) ≠ (t)`: "(A) implies (B)" needs
`m * m = m`. -/
-- Check: test_powers_need_idempotent
example (p : ℕ) [Fact p.Prime] :
    Ideal.span {(Polynomial.X : Polynomial (ZMod p)) ^ 2} ≠
      Ideal.span {(Polynomial.X : Polynomial (ZMod p))} := sorry

/-! ### P0/valuation-ring-basic-setup -/

/-- The setup `(O, 𝔪)` of a valuation domain whose
maximal ideal is not finitely generated (GR Example 2.1.2(i), Sch12 Lemma 4.2, ECD Example
3.22(i)). -/
def ofValuationRing (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) : BasicSetup O where
  ideal := IsLocalRing.maximalIdeal O
  isIdempotentElem := sorry
  flat_tilde := sorry

theorem ofValuationRing_ideal (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) :
    (ofValuationRing O h).ideal = IsLocalRing.maximalIdeal O := rfl

theorem ofValuationRing_isAlmostZero_iff (O : Type u) [CommRing O] [IsDomain O]
    [ValuationRing O] (h : ¬ (IsLocalRing.maximalIdeal O).FG)
    (M : Type*) [AddCommGroup M] [Module O M] :
    (ofValuationRing O h).IsAlmostZero M ↔
      ∀ ε ∈ IsLocalRing.maximalIdeal O, ∀ x : M, ε • x = 0 := Iff.rfl

theorem ofValuationRing_isAlmostZero_residueField (O : Type u) [CommRing O] [IsDomain O]
    [ValuationRing O] (h : ¬ (IsLocalRing.maximalIdeal O).FG) :
    (ofValuationRing O h).IsAlmostZero (IsLocalRing.ResidueField O) := sorry

theorem ofValuationRing_flat_ideal (O : Type u) [CommRing O] [IsDomain O]
    [ValuationRing O] (h : ¬ (IsLocalRing.maximalIdeal O).FG) :
    Module.Flat O (ofValuationRing O h).ideal := sorry

/-- The value group of Cp has no least positive value, GR Example 2.1.2(i). -/
theorem padicComplex_maximalIdeal_not_fg (p : ℕ) [Fact p.Prime] :
    ¬ (IsLocalRing.maximalIdeal (PadicComplexInt p)).FG := sorry

-- Check: ofValuationRing_test_Cp
example (p : ℕ) [Fact p.Prime] :
    let V := PadicComplexInt p
    let S := ofValuationRing V (padicComplex_maximalIdeal_not_fg p)
    S.IsAlmostZero (IsLocalRing.ResidueField V) ∧
      ¬ S.IsAlmostZero (V ⧸ Ideal.span {(p : V)}) := sorry

-- Check: test_valuation_ring
example (p : ℕ) [Fact p.Prime] (r : PadicComplexInt p) (hr : r ^ p = p) :
    let V := PadicComplexInt p
    let S := ofValuationRing V (padicComplex_maximalIdeal_not_fg p)
    S.IsAlmostZero (IsLocalRing.ResidueField V) ∧
      r • (1 : V ⧸ Ideal.span {(p : V)}) ≠ 0 := sorry

/-- For a valuation domain `O` that is not a field, the maximal ideal is idempotent iff it is
not finitely generated (GR Example 2.1.2(i)). The hypothesis `𝔪 ≠ ⊥` is needed: for a field,
`⊥` is idempotent and finitely generated. -/
theorem isIdempotentElem_maximalIdeal_iff (O : Type u) [CommRing O] [IsDomain O]
    [ValuationRing O] (h : IsLocalRing.maximalIdeal O ≠ ⊥) :
    IsIdempotentElem (IsLocalRing.maximalIdeal O) ↔ ¬ (IsLocalRing.maximalIdeal O).FG := sorry

/-- The setup of a valuation domain is the root setup of a sequence `ϖ` of compatible `p`-power
roots of a nonzero element of the maximal ideal, when every element of the maximal ideal is
divisible by some `ϖ n` (the rank-one case, ECD Example 3.22(i)). -/
theorem ofValuationRing_eq_ofCompatibleRoots (O : Type u) [CommRing O] [IsDomain O]
    [ValuationRing O] (h : ¬ (IsLocalRing.maximalIdeal O).FG) (p : ℕ) (hp : 2 ≤ p) (ϖ : ℕ → O)
    (hϖ : ∀ n, ϖ (n + 1) ^ p = ϖ n) (h0 : ϖ 0 ≠ 0) (hm : ϖ 0 ∈ IsLocalRing.maximalIdeal O)
    (hrank : ∀ x ∈ IsLocalRing.maximalIdeal O, ∃ n, ϖ n ∣ x) :
    ofValuationRing O h = ofCompatibleRoots p hp ϖ hϖ := sorry

/- For a field the maximal ideal `⊥` is idempotent and finitely generated: the equivalence
`isIdempotentElem_maximalIdeal_iff` fails without `𝔪 ≠ ⊥`. -/
-- Check: valuation_test_field
example (K : Type u) [Field K] :
    IsIdempotentElem (IsLocalRing.maximalIdeal K) ∧ (IsLocalRing.maximalIdeal K).FG := sorry

/- A discrete valuation ring has `𝔪 ≠ ⊥`, finitely generated and not idempotent. -/
-- Check: valuation_test_dvr
example (p : ℕ) [Fact p.Prime] :
    IsLocalRing.maximalIdeal ℤ_[p] ≠ ⊥ ∧ (IsLocalRing.maximalIdeal ℤ_[p]).FG ∧
      ¬ IsIdempotentElem (IsLocalRing.maximalIdeal ℤ_[p]) := sorry

-- Check: ofValuationRing_test_roots
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
    (h : ¬ (IsLocalRing.maximalIdeal O).FG) (p : ℕ) (hp : 2 ≤ p)
    (t : ℕ → O) (ht : ∀ n, t (n + 1) ^ p = t n)
    (h0 : t 0 ≠ 0) (hm : t 0 ∈ IsLocalRing.maximalIdeal O)
    (hc : ∀ x ∈ IsLocalRing.maximalIdeal O, ∃ n, t n ∣ x) :
    (ofValuationRing O h).ideal = (ofCompatibleRoots p hp t ht).ideal := sorry

-- Check: ofCompatibleRoots_test_valuation
example (O : Type u) [CommRing O] [IsDomain O] [ValuationRing O]
