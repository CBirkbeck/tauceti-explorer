/-! ### P7/preperfectoid-closed-subspaces -/

/-- SW13 Proposition 2.3.7, p. 18: affinoid quotient charts preserve preperfectoidness. The chart square
specifies the closed subspace, including its quotient ring and integral structure. -/
theorem IsPreperfectoid.closedSubspace {X Y : YonedaAdicSpace} (f : Y ⟶ X)
    (hX : IsPreperfectoid p X) (hY : YonedaAdicSpace.IsAnalytic Y)
    (hcharts : ∀ x : space.obj X, ∃ (A B : CAff) (hA : A.Sheafy) (hB : B.Sheafy)
      (a : ofSpaY A ⟶ X) (b : ofSpaY B ⟶ Y) (q : A ⟶ B),
      YonedaAdicSpace.IsOpenImmersion a.hom ∧ x ∈ Set.range (space.map a) ∧
      YonedaAdicSpace.IsOpenImmersion b.hom ∧ Function.Surjective q.toRingHom ∧
      Topology.IsQuotientMap q.toRingHom ∧
      B.P.plus = (integralClosure (A.P.plus.map q.toRingHom) B.A).toSubring ∧
      IsPullback (ObjectProperty.homMk (spaYFunctor.map q.op)) b a f) :
    IsPreperfectoid p Y := sorry
end PerfectoidSpace
