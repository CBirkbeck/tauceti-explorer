theorem localizedCompletionMap_spec {R : Type} [CommRing R] (t : R) (I : Ideal R) :
    (Localization.awayMap (completionMap t I) t).comp (algebraMap R (Localization.Away t)) =
      (algebraMap _ (Localization.Away (completionMap t I t))).comp (completionMap t I) := sorry

