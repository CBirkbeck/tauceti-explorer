variable (p : ℕ) [Fact p.Prime]
/-- Rational subsets of the completed perfectoid pair descend, including their denominators. -/
theorem cofilteredLimit.rational_descent {J : Type} [SmallCategory J] [IsFiltered J]
    (D : J ⥤ PairCat.{0} p) (j₀ : J) (ϖ : PseudoUniformizerRoots p (D.obj j₀))
    (U : RationalOpen p (completedColimitPair p D j₀ ϖ)) :
    ∃ (j : J) (V : RationalOpen p (D.obj j)),
      U.val = (completedColimit.ι p D j₀ ϖ j).spaComap ⁻¹' V.val := sorry

/-- The distinguished element is fixed, so the algebraic extension is unique. -/
theorem integral_sections_completion_extension (Y : Perfd p) (tY : globalPlus p Y)
    (htY : ∀ C : Chart p Y, IsPseudoUniformizer (tY.val.val C))
    (A : Type) [CommRing A] (t : A) (f : A →+* globalPlus p Y) (hf : f t = tY) :
    ∃! g : AdicCompletion (Ideal.span {t}) A →+* globalPlus p Y,
      g.comp (algebraMap A (AdicCompletion (Ideal.span {t}) A)) = f := sorry
