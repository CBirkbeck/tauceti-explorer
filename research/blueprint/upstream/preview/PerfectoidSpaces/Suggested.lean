section Approximation

variable {R : Type u} [CommRing R] {ι σ : Type*} [Fintype ι] [Fintype σ]

open scoped Classical in
/-- Elkik's Jacobian ideal
`H = Σ_α Δ_α · ((f_α) : J)` of the presentation `R[X_ι] ⧸ J`, `J = (f_s)_{s ∈ σ}`: for a finite
set `α` of equations, `Δ_α` is generated by the `|α| × |α|` minors of the Jacobian matrix
`(∂f_s/∂X_i)_{s ∈ α}` and `(f_α) : J` is the colon ideal (Elkik §0; GR 5.4.5; it lies in
`H_R(F, J) = Ann Ext¹(L_{S/R}, J/J²)` by GR Lemma 5.4.6). -/
def jacobianIdeal (f : σ → MvPolynomial ι R) : Ideal (MvPolynomial ι R) :=
  ⨆ α : Finset σ,
    Ideal.span (Set.range fun g : α ↪ ι ↦
        (Matrix.of fun s t : α ↦ MvPolynomial.pderiv (g t) (f s)).det) *
      Submodule.colon (Ideal.span (f '' (α : Set σ))) (Set.range f)

-- test elkik_test_no_equations (degenerate)
/- With no equations the only term of `jacobianIdeal` is `α = ∅`, whose determinant factor is
`span {1}` (the `0 × 0` determinant) and whose colon factor is `(⊥ : ⊥)`, the whole ring; so
`H = ⊤` and every point is a solution. -/
example : jacobianIdeal (R := R) (ι := ι) (fun s : PEmpty ↦ s.elim) = ⊤ := sorry

-- test elkik_test_etale_equation (computation)
/- For the single equation `f = X² − 7` in one variable over `ℤ`, the `α = ∅` term is
`Ann(f) = 0` and the `α = {f}` term is `(f') · ((f) : (f)) = (2X)`, so `H_B = (2X)`. -/
example :
    jacobianIdeal (R := ℤ) (ι := Fin 1)
        (fun _ : Fin 1 ↦ (MvPolynomial.X 0 : MvPolynomial (Fin 1) ℤ) ^ 2 - MvPolynomial.C 7) =
      Ideal.span {(2 : MvPolynomial (Fin 1) ℤ) * MvPolynomial.X 0} := sorry

-- check elkik_test_derivative_valuation
/- For `f_m = X^{p^m} - 1`, evaluation of the Jacobian ideal at `1` is `(p^m)`.
This constrains the admissible `h`: over a p-adic DVR one needs `h ≥ m`. -/
example (p m : ℕ) [Fact p.Prime] :
    (jacobianIdeal (R := ℤ) (ι := Fin 1)
        (fun _ : Fin 1 ↦ (MvPolynomial.X 0 : MvPolynomial (Fin 1) ℤ) ^ (p ^ m) - 1)).map
      (MvPolynomial.eval fun _ : Fin 1 ↦ (1 : ℤ)) = Ideal.span {((p : ℤ) ^ m)} := sorry

/-! ### P3/henselian-smooth-lifting -/

/-- Sections of a smooth algebra over the closed fibre of a henselian pair lift.
Stacks, Tag 0H74; no noetherian hypothesis is needed. -/
theorem henselian_smooth_lifting (A : Type u) [CommRing A]
    (I : Ideal A) [HenselianRing A I]
    (B : Type u) [CommRing B] [Algebra A B] [Algebra.Smooth A B]
    (ε₀ : B →ₐ[A] A ⧸ I) :
    ∃ ε : B →ₐ[A] A, ∀ b, Ideal.Quotient.mk I (ε b) = ε₀ b := sorry

/-! ### P3/elkik-noetherian-henselian-approximation -/

/-- Elkik II, Théorème 2, printed p. 560 (Numdam PDF p. 9): for fixed henselian
noetherian `(R,I)` and `h`, the bounds precede the finite polynomial presentation. -/
theorem elkik_henselian_approximation (R : Type u) [CommRing R] [IsNoetherianRing R]
    (I : Ideal R) [HenselianRing R I] (h : ℕ) :
    ∃ n₀ r : ℕ, ∀ (N q : ℕ) (f : Fin q → MvPolynomial (Fin N) R)
      (n : ℕ) (a₀ : Fin N → R), n₀ ≤ n →
      (Ideal.span (Set.range f)).map (MvPolynomial.eval a₀) ≤ I ^ n →
      I ^ h ≤ (jacobianIdeal f).map (MvPolynomial.eval a₀) →
      ∃ a : Fin N → R, (∀ i, a i - a₀ i ∈ I ^ (n - r)) ∧
        ∀ j, MvPolynomial.eval a (f j) = 0 := sorry

/-- Elkik II, Théorème 2 bis, printed p. 560: approximation of a completed section
through a specified smooth open away from the ideal of completion. The tensor product
`Bhat = B ⊗[A] Ahat` is scalar extension, not the adic completion of `B`. -/
theorem elkik_section_approximation (A : Type u) [CommRing A] [IsNoetherianRing A]
    (I : Ideal A) [HenselianRing A I]
    (B : Type u) [CommRing B] [Algebra A B] [Algebra.FiniteType A B]
    (V : (AlgebraicGeometry.Spec (CommRingCat.of B)).Opens)
    (hV : AlgebraicGeometry.Smooth (V.ι ≫ AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap A B)))) (n : ℕ) :
    let Ahat := AdicCompletion I A
    let Bhat := B ⊗[A] Ahat
    let ιB : B →+* Bhat := Algebra.TensorProduct.includeLeftRingHom
    let iotaAhat : Ahat →+* Bhat := Algebra.TensorProduct.includeRight.toRingHom
    ∀ (epsHat : Bhat →+* Ahat), epsHat.comp iotaAhat = RingHom.id Ahat →
      (∀ x : PrimeSpectrum Ahat, ¬ I.map (algebraMap A Ahat) ≤ x.asIdeal →
        PrimeSpectrum.comap ιB (PrimeSpectrum.comap epsHat x) ∈ V) →
      ∃ ε : B →ₐ[A] A,
        (∀ b, Ideal.Quotient.mk (I ^ n) (ε b) = AdicCompletion.evalₐ I n (epsHat (ιB b))) ∧
        ∀ x : PrimeSpectrum A, ¬ I ≤ x.asIdeal →
          PrimeSpectrum.comap ε.toRingHom x ∈ V := sorry

-- Check: elkik_section_zero_ideal
example (A : Type u) [CommRing A] (B : Type u) [CommRing B] [Algebra A B]
    (epsHat : B →ₐ[A] AdicCompletion (⊥ : Ideal A) A) :
    ∃ ε : B →ₐ[A] A, ∀ b, algebraMap A (AdicCompletion (⊥ : Ideal A) A) (ε b) = epsHat b :=
  sorry

-- Check: elkik_section_zero_precision
example (A : Type u) [CommRing A] (I : Ideal A) (a : A) (â : AdicCompletion I A) :
    Ideal.Quotient.mk (I ^ 0) a = AdicCompletion.evalₐ I 0 â := by
  have : Subsingleton (A ⧸ I ^ 0) := by simp
  exact Subsingleton.elim _ _

-- Check: elkik_section_empty_open
example (A : Type u) [CommRing A] (I : Ideal A)
    (x : PrimeSpectrum (AdicCompletion I A))
    (hx : ¬ I.map (algebraMap A (AdicCompletion I A)) ≤ x.asIdeal) :
    ¬ (∀ y : PrimeSpectrum (AdicCompletion I A),
      ¬ I.map (algebraMap A (AdicCompletion I A)) ≤ y.asIdeal → y ∈ (∅ : Set _)) := by
  intro h
  exact h x hx

/-! ### P3/approximate-solutions-over-complete-rings -/

/-- GR Lemma 5.4.8: a Jacobian bound improves an approximate solution quadratically. -/
theorem approximateSolution_improve (R : Type u) [CommRing R] (t : R)
    (ht : t ∈ nonZeroDivisors R) (I : Ideal R) (N q h n : ℕ)
    (f : Fin q → MvPolynomial (Fin N) R) (a : Fin N → R)
    (hn : 2 * h < n)
    (hjac : t ^ h ∈ (jacobianIdeal f).map (MvPolynomial.eval a))
    (happrox : ∀ j, MvPolynomial.eval a (f j) ∈ Ideal.span {t} ^ n * I) :
    ∃ b : Fin N → R,
      (∀ i, b i - a i ∈ Ideal.span {t} ^ (n - h) * I) ∧
      ∀ j, MvPolynomial.eval b (f j) ∈ (Ideal.span {t} ^ (n - h) * I) ^ 2 := sorry

/-- Iterating GR Lemma 5.4.8 in the complete ring gives a true solution. -/
theorem approximateSolution_complete (R : Type u) [CommRing R] (t : R)
    (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [IsAdicComplete (Ideal.span {t} * I) R] (N q h n : ℕ)
    (f : Fin q → MvPolynomial (Fin N) R) (a : Fin N → R)
    (hn : 2 * h < n)
    (hjac : t ^ h ∈ (jacobianIdeal f).map (MvPolynomial.eval a))
    (happrox : ∀ j, MvPolynomial.eval a (f j) ∈ Ideal.span {t} ^ n * I) :
    ∃ b : Fin N → R,
      (∀ i, b i - a i ∈ Ideal.span {t} ^ (n - h) * I) ∧
      ∀ j, MvPolynomial.eval b (f j) = 0 := sorry

/-! ### P3/henselian-approximate-solutions -/

/-- GR Proposition 5.4.13 does not require a noetherian ring. -/
theorem approximateSolution_henselian (R : Type u) [CommRing R] (t : R)
    (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [HenselianRing R (Ideal.span {t} * I)] (N q h n : ℕ)
    (f : Fin q → MvPolynomial (Fin N) R) (a : Fin N → R)
    (hn : 2 * h < n)
    (hjac : t ^ h ∈ (jacobianIdeal f).map (MvPolynomial.eval a))
    (happrox : ∀ j, MvPolynomial.eval a (f j) ∈ Ideal.span {t} ^ n * I) :
    ∃ b : Fin N → R,
      (∀ i, b i - a i ∈ Ideal.span {t} ^ (n - h) * I) ∧
      ∀ j, MvPolynomial.eval b (f j) = 0 := sorry

-- Check: elkik_test_etale_equation_lifting
/- GR Proposition 5.4.13, p. 119, with h = 0 and I = ⊤: a unit derivative gives
an exact root of X² − 7 without losing t-adic precision. -/
example (R : Type u) [CommRing R] (t : R) (ht : t ∈ nonZeroDivisors R)
    [HenselianRing R (Ideal.span {t})] (n : ℕ) (hn : 0 < n) (a₀ : R)
    (hunit : IsUnit (2 * a₀)) (happrox : a₀ ^ 2 - 7 ∈ Ideal.span {t} ^ n) :
    ∃ a : R, a - a₀ ∈ Ideal.span {t} ^ n ∧ a ^ 2 = 7 := by
  let f : Fin 1 → MvPolynomial (Fin 1) R :=
    fun _ ↦ MvPolynomial.X 0 ^ 2 - MvPolynomial.C 7
  have hderiv : 2 * a₀ ∈ (jacobianIdeal f).map (MvPolynomial.eval fun _ ↦ a₀) := by
    sorry
  have htop := Ideal.eq_top_of_isUnit_mem _ hderiv hunit
  let : HenselianRing R (Ideal.span {t} * ⊤) := by
    simpa using (inferInstance : HenselianRing R (Ideal.span {t}))
  obtain ⟨a, hcongr, hroot⟩ := approximateSolution_henselian R t ht ⊤ 1 1 0 n f
    (fun _ ↦ a₀) (by simpa using hn) (by simp [htop])
    (by intro j; simpa [f] using happrox)
  refine ⟨a 0, ?_, ?_⟩
  · simpa using hcongr 0
  · have hz : a 0 ^ 2 - 7 = 0 := by simpa [f] using hroot 0
    exact sub_eq_zero.mp hz

-- check elkik_test_characteristic_two
/- The two terms X² and -1 give a zero derivative in characteristic two;
`X² - 1 = (X - 1)²` is a non-étale equation. -/
example : jacobianIdeal (R := ZMod 2) (ι := Fin 1)
    (fun _ : Fin 1 ↦ (MvPolynomial.X 0 : MvPolynomial (Fin 1) (ZMod 2)) ^ 2 - 1) = ⊥ :=
  sorry

-- check elkik_test_unit_ideal
example : jacobianIdeal (R := ℤ) (ι := Fin 1)
    (fun _ : Fin 1 ↦ (1 : MvPolynomial (Fin 1) ℤ)) = ⊥ := sorry

end Approximation

/-! ### Layer 3: Section topologies and algebra-structure moduli -/
namespace HenselianApproximation
variable {R : Type u} [CommRing R]

/-- GR 5.4.10: open sets are unions of cosets of the ideals t^n I. -/
@[instance_reducible]
def ringTopology (t : R) (I : Ideal R) : TopologicalSpace R :=
  TopologicalSpace.generateFrom {U | ∃ (a : R) (n : ℕ),
    U = {x | x - a ∈ Ideal.span {t} ^ n * I}}

/-- On the localization the basic neighborhoods are images of t^n I, not their
extensions as ideals of R[1/t] (GR 5.4.10(ii)). -/
@[instance_reducible]
def localizedTopology (t : R) (I : Ideal R) : TopologicalSpace (Localization.Away t) :=
  TopologicalSpace.generateFrom {U | ∃ (a : Localization.Away t) (n : ℕ),
    U = {x | ∃ b ∈ Ideal.span {t} ^ n * I, x - a = algebraMap R _ b}}

/-! ### P3/smooth-sections-dense-over-henselian-pairs -/

/-- The affine section topology of GR 5.4.15, on the actual polynomial solution set. -/
@[instance_reducible]
def sectionTopology (t : R) (I : Ideal R) (N q : ℕ)
    (f : Fin q → MvPolynomial (Fin N) (Localization.Away t)) :
    TopologicalSpace {a : Fin N → Localization.Away t | ∀ j, MvPolynomial.eval a (f j) = 0} :=
  letI := localizedTopology t I
  inferInstance

theorem ringTopology_nhds (t : R) (I : Ideal R) (a : R) :
    @nhds R (ringTopology t I) a =
      ⨅ n : ℕ, Filter.principal {x | x - a ∈ Ideal.span {t} ^ n * I} := sorry

theorem localizedTopology_nhds (t : R) (I : Ideal R) (a : Localization.Away t) :
    @nhds _ (localizedTopology t I) a =
      ⨅ n : ℕ, Filter.principal {x | ∃ b ∈ Ideal.span {t} ^ n * I,
        x - a = algebraMap R _ b} := sorry

-- Check: topology_zero_ideal
example (t : R) : ringTopology t (⊥ : Ideal R) = ⊥ := sorry
-- Check: topology_unit_parameter
example (I : Ideal R) : ringTopology 1 I =
    TopologicalSpace.induced (Ideal.Quotient.mk I) ⊥ := sorry
-- Check: topology_adic_agreement
example (t : R) : ringTopology t (⊤ : Ideal R) = (Ideal.span {t}).adicTopology := sorry
-- Check: localized_zero_ideal
example (t : R) : localizedTopology t (⊥ : Ideal R) = ⊥ := sorry
-- Check: localized_unit_total_ideal
example : localizedTopology (1 : R) (⊤ : Ideal R) = ⊤ := sorry
-- Check: localized_integer_three
example : @IsOpen (Localization.Away (3 : ℤ)) (localizedTopology 3 ⊤)
    (Set.range (algebraMap ℤ (Localization.Away (3 : ℤ)))) ∧
    ¬ @IsOpen (Localization.Away (3 : ℤ)) (localizedTopology 3 ⊤) {0} := sorry
-- Check: sections_zero_ideal
example (t : R) (N q : ℕ) (f : Fin q → MvPolynomial (Fin N) (Localization.Away t)) :
    sectionTopology t ⊥ N q f = ⊥ := sorry
-- Check: sections_unit_total_ideal
example (N q : ℕ) (f : Fin q → MvPolynomial (Fin N) (Localization.Away (1 : R))) :
    sectionTopology 1 ⊤ N q f = ⊤ := sorry
-- Check: sections_affine_line_not_discrete
example : sectionTopology (3 : ℤ) ⊤ 1 0 (fun i ↦ Fin.elim0 i) ≠ ⊥ := sorry

/-- The separated (t,I)-completion as the compatible residue sequences. -/
def completion (t : R) (I : Ideal R) : Subring (∀ n : ℕ, R ⧸ (Ideal.span {t} ^ n * I)) where
  carrier := {x | ∀ n, Ideal.Quotient.factor (by sorry :
    Ideal.span {t} ^ (n + 1) * I ≤ Ideal.span {t} ^ n * I) (x (n + 1)) = x n}
  zero_mem' := by sorry
  one_mem' := by sorry
  add_mem' := by sorry
  mul_mem' := by sorry
  neg_mem' := by sorry

-- Check: completion_unit_parameter
example (I : Ideal R) : Nonempty (completion (1 : R) I ≃+* (R ⧸ I)) := sorry
-- Check: completion_zero_ideal
example (t : R) : Nonempty (completion t (⊥ : Ideal R) ≃+* R) := sorry
-- Check: completion_integer_three
example : Nonempty (completion (3 : ℤ) ⊤ ≃+* ℤ_[3]) := sorry

/-- The completion map sends an element to all its residue classes. -/
def completionMap (t : R) (I : Ideal R) : R →+* completion t I where
  toFun a := ⟨fun n => Ideal.Quotient.mk _ a, by sorry⟩
  map_zero' := by sorry
  map_one' := by sorry
  map_add' := by sorry
  map_mul' := by sorry

theorem completionMap_apply (t : R) (I : Ideal R) (a : R) (n : ℕ) :
    (completionMap t I a).val n = Ideal.Quotient.mk (Ideal.span {t} ^ n * I) a := rfl

-- Check: completionMap_zero_ideal
example (t : R) : Function.Bijective (completionMap t (⊥ : Ideal R)) := sorry
-- Check: completionMap_unit_parameter
example (I : Ideal R) : RingHom.ker (completionMap (1 : R) I) = I := sorry
-- Check: completionMap_integer_three
example : Function.Injective (completionMap (3 : ℤ) ⊤) ∧
    ¬ Function.Surjective (completionMap (3 : ℤ) ⊤) := sorry

/-! ### P3/henselian-finite-etale-approximation -/

/-- GR 5.4.54: base change along the actual map to the localized completion. -/
theorem finiteEtale_completion (t : R) (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [HenselianRing R (Ideal.span {t} * I)] :
    letI := (Localization.awayMap (completionMap t I) t).toAlgebra
    (CommAlgCat.FiniteEtale.baseChange.{u} (Localization.Away t)
      (Localization.Away (completionMap t I t))).IsEquivalence := sorry

/-! ### P3/finite-etale-under-completed-perfection -/
/-- Sch12 Lemma 7.5(ii), on an integral ring of definition completed at a regular parameter. -/
theorem finiteEtale_completedPerfection (p : ℕ) [Fact p.Prime] [CharP R p]
    (t : R) (ht : t ∈ nonZeroDivisors R) [IsAdicComplete (Ideal.span {t}) R] :
    let P := PerfectClosure R p
    let tP := PerfectClosure.of R p t
    let C := AdicCompletion (Ideal.span {tP}) P
    let f : R →+* C := (algebraMap P C).comp (PerfectClosure.of R p)
    letI := (Localization.awayMap f t).toAlgebra
    (CommAlgCat.FiniteEtale.baseChange.{u} (Localization.Away t)
      (Localization.Away (f t))).IsEquivalence := sorry

/-! ### P3/projective-modules-over-henselian-completion -/

/-- GR 5.4.42, essential surjectivity on finite projective modules. -/
theorem projective_completion_essSurj (t : R) (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [HenselianRing R (Ideal.span {t} * I)]
    (N : ModuleCat.{u} (Localization.Away (completionMap t I t)))
    [Module.Finite (Localization.Away (completionMap t I t)) N]
    [Module.Projective (Localization.Away (completionMap t I t)) N] :
    ∃ M : ModuleCat.{u} (Localization.Away t),
      Module.Finite (Localization.Away t) M ∧ Module.Projective (Localization.Away t) M ∧
      Nonempty ((ModuleCat.extendScalars (Localization.awayMap (completionMap t I) t)).obj M ≅ N) := sorry

/-- GR 5.4.42, injectivity on isomorphism classes; no claim of full faithfulness. -/
theorem projective_completion_iso_iff (t : R) (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [HenselianRing R (Ideal.span {t} * I)]
    (M N : ModuleCat.{u} (Localization.Away t))
    [Module.Finite (Localization.Away t) M] [Module.Projective (Localization.Away t) M]
    [Module.Finite (Localization.Away t) N] [Module.Projective (Localization.Away t) N] :
    Nonempty ((ModuleCat.extendScalars (Localization.awayMap (completionMap t I) t)).obj M ≅
      (ModuleCat.extendScalars (Localization.awayMap (completionMap t I) t)).obj N) ↔
      Nonempty (M ≅ N) := sorry

end HenselianApproximation

