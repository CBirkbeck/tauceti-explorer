    ∃ (I : Type 1) (V : I → smallEtale p X) (f : ∀ i, V i ⟶ U),
      (∀ i, IsAffinoidPerfectoid p (V i).obj.left.obj ∧
        YonedaAdicSpace.IsOpenImmersion (f i).hom.left.hom.hom) ∧
