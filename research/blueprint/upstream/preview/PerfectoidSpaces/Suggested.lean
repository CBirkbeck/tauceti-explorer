    [IsTateRing A] [CompleteSpace A] [T2Space A] [IsPerfectoidTateRing p A] (P : Pair A)
    {κ : Cardinal.{u}} (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) :
    IsKappaSmall_affinoid κ P ↔ #A < κ := sorry
end isKappaSmall_affinoid_iff

section not_isKappaSmall_Cp_aleph0
variable (p : ℕ) [Fact p.Prime]
example : ¬ IsKappaSmall_affinoid ℵ₀ (Pair.powerBounded ℂ_[p]) := sorry
end not_isKappaSmall_Cp_aleph0

section isKappaSmall_empty_aleph0
example {R : Type u} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [IsHuberRing R]
    [Subsingleton R] (P : Pair R) : IsKappaSmall_affinoid ℵ₀ P :=
  (isKappaSmall_affinoid_subsingleton_iff P ℵ₀).mpr Cardinal.one_lt_aleph0
