      (Ideal.Quotient.mk (Ideal.span {t}))).map e.toRingHom =
      (almostSetupPlus p R R.pair).ideal.map (Ideal.Quotient.mk
        (Ideal.span {(⟨tilt.sharp t.val, hs⟩ : R.pair.plus)})) := sorry

/-- Addition of exponents for a fixed compatible root. -/
theorem PseudoUniformizerRoots.zpow_add (R : Type*) [CommRing R] [UniformSpace R]
    [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    (ϖ : PseudoUniformizerRoots p R) (a b : ℤ) (n : ℕ) :
    ϖ.zpow (a + b) n = ϖ.zpow a n * ϖ.zpow b n := sorry

theorem PseudoUniformizerRoots.zpow_mul_p (R : Type*) [CommRing R] [UniformSpace R]
    [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    (ϖ : PseudoUniformizerRoots p R) (m : ℤ) (n : ℕ) :
