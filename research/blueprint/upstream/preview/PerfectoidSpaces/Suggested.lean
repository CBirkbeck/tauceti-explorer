      (proRationalMap p R D).map_mem_plus π π.property⟩ : (proRationalPair p R D).pair.plus)
      (proRationalPair p R D) := sorry

theorem isSeparated_eq_diagonal :
    (fun _ _ f ↦ IsSeparated p f : MorphismProperty (Perfd p)) =
      MorphismProperty.diagonal (fun _ _ f ↦ IsClosedImmersion p f : MorphismProperty (Perfd p)) := rfl

theorem proRationalSubspace.proconstructible (R : PairCat.{0} p) (D : RationalSystem p R) :
    @IsClosed (spa R.pair.plus) (constructibleTopology (spa R.pair.plus)) (D.intersection p) := sorry

