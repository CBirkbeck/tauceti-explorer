/-- The qcqs subcategory is stable under geometric pullback. -/
def qcqsEtaleBaseChange {X Y : Perfd p} (f : Y ⟶ X) : qcqsEtale p X ⥤ qcqsEtale p Y where
  obj U := ⟨(etaleBaseChange p f).obj U.obj, by sorry⟩
  map g := ObjectProperty.homMk ((etaleBaseChange p f).map g.hom)
  map_id := by sorry
  map_comp := by sorry

