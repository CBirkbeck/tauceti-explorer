/-! ### P2/fibre-products-over-analytic-base -/
theorem pullbackOverAnalyticIsoPullback {X Y Z : Perfd p} (hZ : YonedaAdicSpace.IsAnalytic Z.obj)
    (f : X ⟶ Z) (g : Y ⟶ Z) :
    ∃ e : pullbackOverAnalytic p hZ f.hom g.hom ≅ pullback f g,
      e.hom ≫ pullback.fst f g = pullbackOverAnalytic.fst p hZ f.hom g.hom ∧
      e.hom ≫ pullback.snd f g = pullbackOverAnalytic.snd p hZ f.hom g.hom := sorry

theorem pullbackOverAnalyticSpaIso (A : CAff) [IsTateRing A.A]
    (B C : PairCat.{0} p) (f : Pair.Hom A.P B.pair) (g : Pair.Hom A.P C.pair) :
    letI := f.toRingHom.toAlgebra
    letI := g.toRingHom.toAlgebra
    letI : IsAdicHom (algebraMap A.A B) := by sorry
    letI : IsAdicHom (algebraMap A.A C) := by sorry
    let T := Pair.uniformCompletedTensor A.P B.pair C.pair f.map_mem_plus g.map_mem_plus
    let a : ofSpaY (CAff.of T) ⟶ ofSpaY (CAff.of B.pair) :=
      ObjectProperty.homMk (spaYFunctor.map (CAff.ofHom
        (Pair.uniformCompletedTensor.inl A.P B.pair C.pair f.map_mem_plus g.map_mem_plus)).op)
    let b : ofSpaY (CAff.of T) ⟶ ofSpaY (CAff.of C.pair) :=
      ObjectProperty.homMk (spaYFunctor.map (CAff.ofHom
        (Pair.uniformCompletedTensor.inr A.P B.pair C.pair f.map_mem_plus g.map_mem_plus)).op)
    let f' : ofSpaY (CAff.of B.pair) ⟶ ofSpaY A :=
      ObjectProperty.homMk (spaYFunctor.map (CAff.ofHom f).op)
    let g' : ofSpaY (CAff.of C.pair) ⟶ ofSpaY A :=
      ObjectProperty.homMk (spaYFunctor.map (CAff.ofHom g).op)
    IsAffinoidPerfectoid p (ofSpaY (CAff.of T)) ∧ a ≫ f' = b ≫ g' ∧
      ∀ (W : Perfd p) (u : W.obj ⟶ ofSpaY (CAff.of B.pair))
        (v : W.obj ⟶ ofSpaY (CAff.of C.pair)), u ≫ f' = v ≫ g' →
        ∃! w : W.obj ⟶ ofSpaY (CAff.of T), w ≫ a = u ∧ w ≫ b = v := sorry

theorem pullbackOverAnalyticRestrictIso {X Y : Perfd p} {Z Z' : YonedaAdicSpace}
    (hZ : YonedaAdicSpace.IsAnalytic Z) (hZ' : YonedaAdicSpace.IsAnalytic Z')
    (i : Z' ⟶ Z) (hi : YonedaAdicSpace.IsOpenImmersion i.hom)
    (f : X.obj ⟶ Z) (g : Y.obj ⟶ Z)
    (U : TopologicalSpace.Opens (space.obj X.obj))
    (V : TopologicalSpace.Opens (space.obj Y.obj))
    (a : (restrict p X U).obj ⟶ Z') (b : (restrict p Y V).obj ⟶ Z')
    (ha : a ≫ i = (restrictι p X U).hom ≫ f)
    (hb : b ≫ i = (restrictι p Y V).hom ≫ g) :
    let W := TopologicalSpace.Opens.comap
        (space.map (pullbackOverAnalytic.fst p hZ f g).hom).hom U ⊓
      TopologicalSpace.Opens.comap (space.map (pullbackOverAnalytic.snd p hZ f g).hom).hom V
    Nonempty (restrict p (pullbackOverAnalytic p hZ f g) W ≅ pullbackOverAnalytic p hZ' a b) := sorry

/-- The analytic diagonal is the universal lift of the two identity maps. -/
def diagonalOverAnalytic {X : Perfd p} {Z : YonedaAdicSpace}
    (hZ : YonedaAdicSpace.IsAnalytic Z) (f : X.obj ⟶ Z) : X ⟶ pullbackOverAnalytic p hZ f f :=
  pullbackOverAnalytic.lift p hZ f f X (𝟙 X) (𝟙 X) (by simp)
theorem diagonalOverAnalytic_fst_snd {X : Perfd p} {Z : YonedaAdicSpace}
    (hZ : YonedaAdicSpace.IsAnalytic Z) (f : X.obj ⟶ Z) :
    diagonalOverAnalytic p hZ f ≫ pullbackOverAnalytic.fst p hZ f f = 𝟙 X ∧
    diagonalOverAnalytic p hZ f ≫ pullbackOverAnalytic.snd p hZ f f = 𝟙 X := sorry
-- Check: diagonalOverAnalytic_identity
example (X : Perfd p) (hX : YonedaAdicSpace.IsAnalytic X.obj) :
    IsIso (diagonalOverAnalytic p hX (𝟙 X.obj)) := sorry
-- Check: diagonalOverAnalytic_empty
example (X : Perfd p) [IsEmpty (underlyingPoints p X)]
    (Z : YonedaAdicSpace) (hZ : YonedaAdicSpace.IsAnalytic Z) (f : X.obj ⟶ Z) :
    IsIso (diagonalOverAnalytic p hZ f) := sorry
-- Check: diagonalOverAnalytic_two
example (K : PairCat.{0} p) [Nontrivial K]
    (hK : YonedaAdicSpace.IsAnalytic (ofPair p K).obj) :
    ¬ IsIso (diagonalOverAnalytic p hK (coprod.desc (𝟙 (ofPair p K)) (𝟙 (ofPair p K))).hom) := sorry
end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
end

