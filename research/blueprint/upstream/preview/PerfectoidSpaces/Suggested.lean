/-! ### Layer 6: Large fields and disjoint-union controls -/

/-- The Gauss completion of K(T_j^(1/p^∞)): coefficient maximum on each finite
polynomial level and density of the field they generate determine the valued extension.
The finite-level norm equation includes algebraic independence. -/
structure GaussPerfectoidField (K : AffinoidField p) (J : Type) where
  field : AffinoidField p
  plus_eq : field.plus.toSubring = powerBoundedSubring field
  scalar : K →+* field
  scalar_norm : ∀ a, ‖scalar a‖ = ‖a‖
  root : J → ℕ → field
  root_pow : ∀ j n, root j (n + 1) ^ p = root j n
  polynomial_norm : ∀ (n : ℕ) (f : MvPolynomial J K),
    ‖MvPolynomial.eval₂Hom scalar (fun j ↦ root j n) f‖₊ =
      f.support.sup (fun m ↦ ‖f.coeff m‖₊)
  dense : Dense ((Subfield.closure (Set.range scalar ∪
    Set.range (fun jn : J × ℕ ↦ root jn.1 jn.2))) : Set field)

/-- The completed Gauss extension used in P6.1–P6.4's cardinal examples. -/
def gaussPerfectoidField (K : AffinoidField p) (J : Type) : GaussPerfectoidField p K J := sorry

theorem gaussPerfectoidField_card (K : AffinoidField p) (J : Type) :
    #J ≤ #(gaussPerfectoidField p K J).field ∧
    #(gaussPerfectoidField p K J).field ≤ (#K + #J + ℵ₀) ^ ℵ₀ := sorry

