theorem proRationalSubspace.almost_plus (R : PairCat.{0} p) (D : RationalSystem p R)
    (π : PseudoUniformizerRoots p R) (n : ℕ)
    (s : powerBoundedSubring (proRationalPair p R D)) :
    ∃ a : (proRationalPair p R D).pair.plus,
      a.val = (proRationalMap p R D).toRingHom (π.root n) * s := sorry

/-- The affine diagonal is multiplication on the P2 tensor pair. -/
def diagonalMultiplication {R S : PairCat.{0} p} (f : R ⟶ S) :
    PairCat.tensorPair p R S S f f ⟶ S := sorry

theorem diagonalMultiplication_inclusions {R S : PairCat.{0} p} (f : R ⟶ S) :
    PairCat.tensorInl p R S S f f ≫ diagonalMultiplication p f = 𝟙 S ∧
      PairCat.tensorInr p R S S f f ≫ diagonalMultiplication p f = 𝟙 S := sorry

