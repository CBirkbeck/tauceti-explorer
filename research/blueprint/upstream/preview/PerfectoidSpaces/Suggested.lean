example :
    letI : AddCommGroup (ZMod 3) := (ZMod.commRing 3).toAddCommGroup
    ∃ E : SquareZeroExtension ℤ (ZMod 3) (ModuleCat.of (ZMod 3) (ZMod 3)),
    Nonempty (E.presentation.Ring ≃+* ZMod 9) ∧
    extensionClass _ (Quotient.mk _ E) ≠ 0 := sorry

/-- Stacks 08S3 and 08RB: the zero class consists exactly of split extensions. -/
theorem extOne (M : ModuleCat.{u} T) :
    Function.Bijective (extensionClass (R := R) M) ∧
      ∀ E : SquareZeroExtension R T M,
        extensionClass M (Quotient.mk _ E) = 0 ↔
          ∃ s : T →ₐ[R] E.presentation.Ring,
            ∀ x, algebraMap E.presentation.Ring T (s x) = x := sorry

/-- Stacks 08S3: a lift is obstructed in Ext¹; differences of lifts are derivations. -/
theorem liftMorphism (B : Type u) [CommRing B] [Algebra R B]
    (f : T →ₐ[R] B) (M : ModuleCat.{u} B) (E : SquareZeroExtension R B M) :
    letI : Algebra T B := f.toAlgebra
    letI : Module T M := Module.compHom M f.toRingHom
    letI : Module R M := Module.compHom M (algebraMap R B)
    let obstruction := morphismObstruction B f M E
    (obstruction = 0 ↔ ∃ g : T →ₐ[R] E.presentation.Ring,
        ∀ x, algebraMap E.presentation.Ring B (g x) = f x) ∧
      ∀ (g : T →ₐ[R] E.presentation.Ring)
        (hg : ∀ x, algebraMap E.presentation.Ring B (g x) = f x),
        ∃ e : {h : T →ₐ[R] E.presentation.Ring //
          ∀ x, algebraMap E.presentation.Ring B (h x) = f x} ≃ _root_.Derivation R T M,
          ∀ h x, h.val x - g x = E.inclusion (e h x) := sorry

-- Check: SquareZeroExtension_zero; extensionSetoid_zero; Exal_zero
example (E F : SquareZeroExtension R T (0 : ModuleCat.{u} T)) :
    Function.Bijective (algebraMap E.presentation.Ring T) ∧
      (extensionSetoid R T _).r E F ∧ Subsingleton (Exal R T (0 : ModuleCat.{u} T)) := sorry
-- Check: SquareZeroExtension_dual; extensionSetoid_dual; Exal_dual
example : ∃ E : SquareZeroExtension ℚ ℚ (ModuleCat.of ℚ ℚ),
    Nonempty (E.presentation.Ring ≃ₐ[ℚ] DualNumber ℚ) ∧
    E.inclusion 1 ≠ 0 ∧ E.inclusion 1 * E.inclusion 1 = 0 ∧
    Subsingleton (Exal ℚ ℚ (ModuleCat.of ℚ ℚ)) := sorry
-- Check: SquareZeroExtension_nonsplit; extensionSetoid_nonsplit; Exal_nonsplit
example :
    letI : AddCommGroup (ZMod 2) := (ZMod.commRing 2).toAddCommGroup
    ∃ E : SquareZeroExtension.{0} ℤ (ZMod 2) (ModuleCat.of (ZMod 2) (ZMod 2)),
    Nonempty (E.presentation.Ring ≃+* ZMod 4) ∧
    (¬ ∃ s : ZMod 2 →ₐ[ℤ] E.presentation.Ring,
      ∀ x, algebraMap E.presentation.Ring (ZMod 2) (s x) = x) ∧
    Nontrivial (Exal.{0} ℤ (ZMod 2) (ModuleCat.of (ZMod 2) (ZMod 2))) := sorry

