    (cofilteredLimit.pairIso p D i₀ π).hom ≫
      (spaFunctor p).map (completedColimit.ι p D i₀ π (op i)).op =
    cofilteredLimit.π p (D.rightOp ⋙ spaFunctor p)
      (fun i ↦ ⟨D.obj (op i), ⟨Iso.refl _⟩⟩) i := sorry

