noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
open _root_.CategoryTheory _root_.CategoryTheory.Limits Opposite
open TauCetiRoadmap.AdicEtaleGeometry
open YonedaAdicSpace
variable (p : ℕ) [Fact p.Prime]

/-! ### P7/tilde-limit-qcqs-etale-finite-stage-descent -/

/-- Sch12 7.17: the qcqs full subcategory of A1's small étale site. -/
abbrev analyticQcqsEtale (X : YonedaAdicSpace) := ObjectProperty.FullSubcategory
  (fun U : YonedaAdicSpace.smallEtale X ↦ AdicSpace.Qcqs U.hom)

-- Check: analyticQcqsEtale_suppliedEtale
example {X : YonedaAdicSpace} (U : analyticQcqsEtale X) :
    YonedaAdicSpace.IsEtaleLocalDescription U.obj.hom := U.obj.prop
-- Check: analyticQcqsEtale_nonqcqs
example {X : YonedaAdicSpace} (U : YonedaAdicSpace.smallEtale X)
    (hU : ¬ AdicSpace.Qcqs U.hom) :
    ¬ ∃ V : analyticQcqsEtale X, V.obj = U := by
  rintro ⟨V, rfl⟩
  exact hU V.property
-- Check: analyticQcqsEtale_fullHom
example {X : YonedaAdicSpace} (U V : analyticQcqsEtale X) (g : U.obj ⟶ V.obj) :
    ∃ f : U ⟶ V, f.hom = g := ⟨ObjectProperty.homMk g, rfl⟩

/-- Étale base change exists over analytic Yoneda-adic spaces. -/
def analyticEtalePullback {Y X : YonedaAdicSpace} (f : Y ⟶ X) (hY : YonedaAdicSpace.IsAnalytic Y) :
    analyticQcqsEtale X ⥤ analyticQcqsEtale Y := sorry

-- Check: analyticEtalePullback_suppliedEtale
example {Y X : YonedaAdicSpace} (f : Y ⟶ X) (hY : YonedaAdicSpace.IsAnalytic Y)
    (U : analyticQcqsEtale X) :
    YonedaAdicSpace.IsEtaleLocalDescription ((analyticEtalePullback f hY).obj U).obj.hom :=
  ((analyticEtalePullback f hY).obj U).obj.prop

theorem analyticEtalePullback_spec {Y X : YonedaAdicSpace} (f : Y ⟶ X) (hY : YonedaAdicSpace.IsAnalytic Y)
    (U : analyticQcqsEtale X) :
    ∃ a : ((analyticEtalePullback f hY).obj U).obj.toComma.left ⟶ U.obj.toComma.left,
      IsPullback ((analyticEtalePullback f hY).obj U).obj.toComma.hom a f U.obj.toComma.hom := sorry

theorem analyticEtalePullback_map {Y X : YonedaAdicSpace} (f : Y ⟶ X) (hY : YonedaAdicSpace.IsAnalytic Y)
    {U V : analyticQcqsEtale X} (g : U ⟶ V) :
    ∃ (a : ((analyticEtalePullback f hY).obj U).obj.toComma.left ⟶ U.obj.toComma.left)
      (b : ((analyticEtalePullback f hY).obj V).obj.toComma.left ⟶ V.obj.toComma.left),
      IsPullback ((analyticEtalePullback f hY).obj U).obj.toComma.hom a f U.obj.toComma.hom ∧
      IsPullback ((analyticEtalePullback f hY).obj V).obj.toComma.hom b f V.obj.toComma.hom ∧
      ((analyticEtalePullback f hY).map g).hom.hom.left ≫ b = a ≫ g.hom.hom.left := sorry

-- Check: analyticQcqsEtale_identity; analyticEtalePullback_identity
example (X : YonedaAdicSpace) (hX : YonedaAdicSpace.IsAnalytic X) (U : analyticQcqsEtale X) :
    Nonempty (((analyticEtalePullback (𝟙 X) hX).obj U) ≅ U) := sorry
-- Check: analyticQcqsEtale_empty; analyticEtalePullback_empty
example {Y X : YonedaAdicSpace} (f : Y ⟶ X) (hY : YonedaAdicSpace.IsAnalytic Y)
    (U : analyticQcqsEtale X) [IsEmpty (space.obj U.obj.toComma.left)] :
    IsEmpty (space.obj ((analyticEtalePullback f hY).obj U).obj.toComma.left) := sorry
-- Check: analyticQcqsEtale_split; analyticEtalePullback_split
example {Y X : YonedaAdicSpace} (f : Y ⟶ X) (hY : YonedaAdicSpace.IsAnalytic Y)
    (U : analyticQcqsEtale X) (e : U.obj.toComma.left ≅ X)
    (he : e.hom = U.obj.toComma.hom) :
    IsIso ((analyticEtalePullback f hY).obj U).obj.toComma.hom := sorry

/-- Geometric pullback has a natural family of cartesian projections to the original objects. -/
theorem analyticEtalePullbackProjection_exists {Y X : YonedaAdicSpace}
    (f : Y ⟶ X) (hY : YonedaAdicSpace.IsAnalytic Y) :
    ∃ a : ∀ U : analyticQcqsEtale X,
        ((analyticEtalePullback f hY).obj U).obj.toComma.left ⟶ U.obj.toComma.left,
      (∀ U, IsPullback ((analyticEtalePullback f hY).obj U).obj.toComma.hom
        (a U) f U.obj.toComma.hom) ∧
      ∀ (U V : analyticQcqsEtale X) (g : U ⟶ V),
        ((analyticEtalePullback f hY).map g).hom.hom.left ≫ a V = a U ≫ g.hom.hom.left := sorry

/-- A fixed natural family of cartesian projections for analytic étale pullback. -/
def analyticEtalePullbackProjection {Y X : YonedaAdicSpace}
    (f : Y ⟶ X) (hY : YonedaAdicSpace.IsAnalytic Y) (U : analyticQcqsEtale X) :
    ((analyticEtalePullback f hY).obj U).obj.toComma.left ⟶ U.obj.toComma.left :=
  (analyticEtalePullbackProjection_exists f hY).choose U

theorem analyticEtalePullbackProjection_isPullback {Y X : YonedaAdicSpace}
    (f : Y ⟶ X) (hY : YonedaAdicSpace.IsAnalytic Y) (U : analyticQcqsEtale X) :
    IsPullback ((analyticEtalePullback f hY).obj U).obj.toComma.hom
      (analyticEtalePullbackProjection f hY U) f U.obj.toComma.hom :=
  (analyticEtalePullbackProjection_exists f hY).choose_spec.1 U

theorem analyticEtalePullbackProjection_naturality {Y X : YonedaAdicSpace}
    (f : Y ⟶ X) (hY : YonedaAdicSpace.IsAnalytic Y) {U V : analyticQcqsEtale X} (g : U ⟶ V) :
    ((analyticEtalePullback f hY).map g).hom.hom.left ≫ analyticEtalePullbackProjection f hY V =
      analyticEtalePullbackProjection f hY U ≫ g.hom.hom.left :=
  (analyticEtalePullbackProjection_exists f hY).choose_spec.2 U V g

-- Check: analyticEtalePullbackProjection_square
example {Y X : YonedaAdicSpace} (f : Y ⟶ X) (hY : YonedaAdicSpace.IsAnalytic Y) (U : analyticQcqsEtale X) :
    ((analyticEtalePullback f hY).obj U).obj.toComma.hom ≫ f =
      analyticEtalePullbackProjection f hY U ≫ U.obj.toComma.hom :=
  (analyticEtalePullbackProjection_isPullback f hY U).w
-- Check: analyticEtalePullbackProjection_empty
example {Y X : YonedaAdicSpace} (f : Y ⟶ X) (hY : YonedaAdicSpace.IsAnalytic Y) (U : analyticQcqsEtale X)
    [IsEmpty (space.obj U.obj.toComma.left)] :
    IsEmpty (space.obj ((analyticEtalePullback f hY).obj U).obj.toComma.left) :=
  Function.isEmpty (space.map (analyticEtalePullbackProjection f hY U))
-- Check: analyticEtalePullbackProjection_isomorphism
example {Y X : YonedaAdicSpace} (f : Y ⟶ X) [IsIso f] (hY : YonedaAdicSpace.IsAnalytic Y)
    (U : analyticQcqsEtale X) : IsIso (analyticEtalePullbackProjection f hY U) := sorry

/-- The identity pullback comparison is uniquely fixed by the cartesian projection. -/
theorem analyticEtalePullbackIdIso_exists (X : YonedaAdicSpace) (hX : YonedaAdicSpace.IsAnalytic X) :
    ∃! e : analyticEtalePullback (𝟙 X) hX ≅ 𝟭 _,
      ∀ U, (e.hom.app U).hom.hom.left = analyticEtalePullbackProjection (𝟙 X) hX U := sorry

/-- The identity comparison preserves the chosen pullback projection. -/
def analyticEtalePullbackIdIso (X : YonedaAdicSpace) (hX : YonedaAdicSpace.IsAnalytic X) :
    analyticEtalePullback (𝟙 X) hX ≅ 𝟭 _ :=
  (analyticEtalePullbackIdIso_exists X hX).exists.choose

theorem analyticEtalePullbackIdIso_projection (X : YonedaAdicSpace) (hX : YonedaAdicSpace.IsAnalytic X)
    (U : analyticQcqsEtale X) :
    ((analyticEtalePullbackIdIso X hX).hom.app U).hom.hom.left =
      analyticEtalePullbackProjection (𝟙 X) hX U :=
  (analyticEtalePullbackIdIso_exists X hX).exists.choose_spec U

-- Check: analyticEtalePullbackIdIso_projection
example (X : YonedaAdicSpace) (hX : YonedaAdicSpace.IsAnalytic X) (U : analyticQcqsEtale X) :
    ((analyticEtalePullbackIdIso X hX).hom.app U).hom.hom.left =
      analyticEtalePullbackProjection (𝟙 X) hX U := analyticEtalePullbackIdIso_projection X hX U
-- Check: analyticEtalePullbackIdIso_empty
example (X : YonedaAdicSpace) (hX : YonedaAdicSpace.IsAnalytic X) (U : analyticQcqsEtale X)
    [IsEmpty (space.obj U.obj.toComma.left)] :
    IsEmpty (space.obj ((analyticEtalePullback (𝟙 X) hX).obj U).obj.toComma.left) :=
  Function.isEmpty (space.map (analyticEtalePullbackProjection (𝟙 X) hX U))
-- Check: analyticEtalePullbackIdIso_not_twisted
example (X : YonedaAdicSpace) (hX : YonedaAdicSpace.IsAnalytic X) (U : analyticQcqsEtale X)
    (a : (analyticEtalePullback (𝟙 X) hX).obj U ⟶ U)
    (ha : a.hom.hom.left ≠ analyticEtalePullbackProjection (𝟙 X) hX U) :
    a ≠ (analyticEtalePullbackIdIso X hX).hom.app U := by
  intro e
  apply ha
  rw [e, analyticEtalePullbackIdIso_projection]

/-- Iterated pullback has a unique comparison preserving its two geometric projections. -/
theorem analyticEtalePullbackCompIso_exists {Z Y X : YonedaAdicSpace}
    (f : Y ⟶ X) (g : Z ⟶ Y) (hY : YonedaAdicSpace.IsAnalytic Y) (hZ : YonedaAdicSpace.IsAnalytic Z) :
    ∃! e : analyticEtalePullback (g ≫ f) hZ ≅
        analyticEtalePullback f hY ⋙ analyticEtalePullback g hZ,
      ∀ U, (e.inv.app U).hom.hom.left ≫ analyticEtalePullbackProjection (g ≫ f) hZ U =
        analyticEtalePullbackProjection g hZ ((analyticEtalePullback f hY).obj U) ≫
          analyticEtalePullbackProjection f hY U := sorry

/-- The canonical comparison from a direct pullback to an iterated pullback. -/
def analyticEtalePullbackCompIso {Z Y X : YonedaAdicSpace}
    (f : Y ⟶ X) (g : Z ⟶ Y) (hY : YonedaAdicSpace.IsAnalytic Y) (hZ : YonedaAdicSpace.IsAnalytic Z) :
    analyticEtalePullback (g ≫ f) hZ ≅ analyticEtalePullback f hY ⋙ analyticEtalePullback g hZ :=
  (analyticEtalePullbackCompIso_exists f g hY hZ).exists.choose

theorem analyticEtalePullbackCompIso_projection {Z Y X : YonedaAdicSpace}
    (f : Y ⟶ X) (g : Z ⟶ Y) (hY : YonedaAdicSpace.IsAnalytic Y) (hZ : YonedaAdicSpace.IsAnalytic Z) (U : analyticQcqsEtale X) :
    ((analyticEtalePullbackCompIso f g hY hZ).inv.app U).hom.hom.left ≫
        analyticEtalePullbackProjection (g ≫ f) hZ U =
      analyticEtalePullbackProjection g hZ ((analyticEtalePullback f hY).obj U) ≫
        analyticEtalePullbackProjection f hY U :=
  (analyticEtalePullbackCompIso_exists f g hY hZ).exists.choose_spec U

-- Check: analyticEtalePullbackCompIso_projection
example {Z Y X : YonedaAdicSpace} (f : Y ⟶ X) (g : Z ⟶ Y)
    (hY : YonedaAdicSpace.IsAnalytic Y) (hZ : YonedaAdicSpace.IsAnalytic Z) (U : analyticQcqsEtale X) :
    ((analyticEtalePullbackCompIso f g hY hZ).inv.app U).hom.hom.left ≫
        analyticEtalePullbackProjection (g ≫ f) hZ U =
      analyticEtalePullbackProjection g hZ ((analyticEtalePullback f hY).obj U) ≫
        analyticEtalePullbackProjection f hY U := analyticEtalePullbackCompIso_projection f g hY hZ U
-- Check: analyticEtalePullbackCompIso_empty
example {Z Y X : YonedaAdicSpace} (f : Y ⟶ X) (g : Z ⟶ Y)
    (hY : YonedaAdicSpace.IsAnalytic Y) (hZ : YonedaAdicSpace.IsAnalytic Z) (U : analyticQcqsEtale X)
    [IsEmpty (space.obj U.obj.toComma.left)] :
    IsEmpty (space.obj ((analyticEtalePullback f hY ⋙ analyticEtalePullback g hZ).obj U).obj.toComma.left) :=
  Function.isEmpty (space.map
    (((analyticEtalePullbackCompIso f g hY hZ).inv.app U).hom.hom.left ≫
      analyticEtalePullbackProjection (g ≫ f) hZ U))
-- Check: analyticEtalePullbackCompIso_not_twisted
example {Z Y X : YonedaAdicSpace} (f : Y ⟶ X) (g : Z ⟶ Y)
    (hY : YonedaAdicSpace.IsAnalytic Y) (hZ : YonedaAdicSpace.IsAnalytic Z) (U : analyticQcqsEtale X)
    (a : (analyticEtalePullback f hY ⋙ analyticEtalePullback g hZ).obj U ⟶
      (analyticEtalePullback (g ≫ f) hZ).obj U)
    (ha : a.hom.hom.left ≫ analyticEtalePullbackProjection (g ≫ f) hZ U ≠
      analyticEtalePullbackProjection g hZ ((analyticEtalePullback f hY).obj U) ≫
        analyticEtalePullbackProjection f hY U) :
    a ≠ (analyticEtalePullbackCompIso f g hY hZ).inv.app U := by
  intro e
  apply ha
  rw [e, analyticEtalePullbackCompIso_projection]

variable {I : Type} [SmallCategory I] [IsCofiltered I]
  (D : I ⥤ YonedaAdicSpace) (c : Cone D) (h : IsResidueFieldTildeLimit p D c)

omit [IsCofiltered I] in
/-- A noetherian analytic finite stage is analytic on the Yoneda carrier. -/
theorem IsResidueFieldTildeLimit.level_isAnalytic
    (h : IsResidueFieldTildeLimit p D c) (i : I) :
    YonedaAdicSpace.IsAnalytic (D.obj i) := by
  intro x
  obtain ⟨R, u, hu, ht, _, hx⟩ := h.noetherian i x
  exact ⟨R, u.hom, hu, ht, hx⟩

/-- The finite-stage pseudofunctor uses geometric pullback, Sch12 7.17. -/
def residueEtaleDiagram (h : IsResidueFieldTildeLimit p D c) :
    Pseudofunctor (LocallyDiscrete Iᵒᵖ) Cat.{1, 2} :=
  pseudofunctorOfIsLocallyDiscrete
    (fun i ↦ Cat.of (analyticQcqsEtale (D.obj i.as.unop)))
    (fun a ↦ (analyticEtalePullback (D.map a.as.unop) (h.level_isAnalytic p D c _)).toCatHom)
    (fun i ↦ Cat.Hom.isoMk (by
      change analyticEtalePullback (D.map (𝟙 i.as.unop)) _ ≅ _
      rw [D.map_id]
      exact analyticEtalePullbackIdIso (D.obj i.as.unop) (h.level_isAnalytic p D c _)))
    (fun a b ↦ Cat.Hom.isoMk (by
      change analyticEtalePullback (D.map (b.as.unop ≫ a.as.unop)) _ ≅ _
      rw [D.map_comp]
      exact analyticEtalePullbackCompIso
        (D.map a.as.unop) (D.map b.as.unop)
        (h.level_isAnalytic p D c _) (h.level_isAnalytic p D c _)))
    (by sorry) (by sorry) (by sorry)

/-- The identity comparison is the geometric projection over the stage's identity map. -/
theorem residueEtaleDiagram_mapId_hom_app (i : I) (U : analyticQcqsEtale (D.obj i)) :
    (((residueEtaleDiagram p D c h).mapId ⟨op i⟩).hom.toNatTrans.app U).hom.hom.left =
      analyticEtalePullbackProjection (D.map (𝟙 i)) (h.level_isAnalytic p D c i) U := sorry

/-- The direct-to-iterated comparison preserves the projection to the original étale object. -/
theorem residueEtaleDiagram_mapComp_hom_app {i j k : I} (a : j ⟶ i) (b : k ⟶ j)
    (U : analyticQcqsEtale (D.obj i)) :
    (((residueEtaleDiagram p D c h).mapComp a.op.toLoc b.op.toLoc).hom.toNatTrans.app U).hom.hom.left ≫
        analyticEtalePullbackProjection (D.map b) (h.level_isAnalytic p D c k)
          ((analyticEtalePullback (D.map a) (h.level_isAnalytic p D c j)).obj U) ≫
        analyticEtalePullbackProjection (D.map a) (h.level_isAnalytic p D c j) U =
      analyticEtalePullbackProjection (D.map (b ≫ a)) (h.level_isAnalytic p D c k) U := sorry

-- Check: residueEtaleDiagram_identity_projection
example (i : I) (U : analyticQcqsEtale (D.obj i)) :
    (((residueEtaleDiagram p D c h).mapId ⟨op i⟩).hom.toNatTrans.app U).hom.hom.left =
      analyticEtalePullbackProjection (D.map (𝟙 i)) (h.level_isAnalytic p D c i) U :=
  residueEtaleDiagram_mapId_hom_app p D c h i U
-- Check: residueEtaleDiagram_two_steps
example {i j k : I} (a : j ⟶ i) (b : k ⟶ j) (U : analyticQcqsEtale (D.obj i)) :
    (((residueEtaleDiagram p D c h).mapComp a.op.toLoc b.op.toLoc).hom.toNatTrans.app U).hom.hom.left ≫
        analyticEtalePullbackProjection (D.map b) (h.level_isAnalytic p D c k)
          ((analyticEtalePullback (D.map a) (h.level_isAnalytic p D c j)).obj U) ≫
        analyticEtalePullbackProjection (D.map a) (h.level_isAnalytic p D c j) U =
      analyticEtalePullbackProjection (D.map (b ≫ a)) (h.level_isAnalytic p D c k) U :=
  residueEtaleDiagram_mapComp_hom_app p D c h a b U
-- Check: residueEtaleDiagram_nontrivial_automorphism
example (i : I) (U : analyticQcqsEtale (D.obj i)) (σ : U ≅ U) (hσ : σ.hom ≠ 𝟙 U) :
    ((residueEtaleDiagram p D c h).mapId ⟨op i⟩).hom.toNatTrans.app U ≫ σ.hom ≠
      ((residueEtaleDiagram p D c h).mapId ⟨op i⟩).hom.toNatTrans.app U := by
  let e := (Cat.Hom.toNatIso ((residueEtaleDiagram p D c h).mapId ⟨op i⟩)).app U
  change e.hom ≫ σ.hom ≠ e.hom
  intro he
  apply hσ
  apply (cancel_epi e.hom).1
  exact he.trans (Category.comp_id e.hom).symm

/-- The comparison from the filtered category of qcqs étale finite-stage objects. -/
def residueEtaleComparison :
    CategoryTheory.FilteredTwoColimit (residueEtaleDiagram p D c h) ⥤
      qcqsEtale p ⟨c.pt, h.perfectoid⟩ := sorry

theorem residueEtaleComparison_spec (i : I) (U : analyticQcqsEtale (D.obj i)) :
    let V := (residueEtaleComparison p D c h).obj
      ((CategoryTheory.FilteredTwoColimit.ι (residueEtaleDiagram p D c h) (op i)).obj U)
    ∃ a : V.obj.obj.left.obj ⟶ U.obj.toComma.left,
      IsPullback V.obj.obj.hom.hom a (c.π.app i) U.obj.toComma.hom := sorry

theorem residueEtaleComparison_isEquivalence :
    (residueEtaleComparison p D c h).IsEquivalence := sorry

/-- Finite étale objects are exactly the objects represented by finite étale stages. -/
theorem residueEtaleComparison_finite (U : qcqsEtale p ⟨c.pt, h.perfectoid⟩) :
    IsFiniteEtale p U.obj.obj.hom ↔ ∃ (i : I) (V : analyticQcqsEtale (D.obj i)),
      YonedaAdicSpace.IsFiniteEtale V.obj.toComma.hom ∧ Nonempty
        ((residueEtaleComparison p D c h).obj
          ((CategoryTheory.FilteredTwoColimit.ι (residueEtaleDiagram p D c h) (op i)).obj V) ≅ U) := sorry

-- Check: residueEtaleComparison_suppliedFiniteEtale
example (U : qcqsEtale p ⟨c.pt, h.perfectoid⟩) :
    YonedaAdicSpace.IsFiniteEtale U.obj.obj.hom.hom ↔
      ∃ (i : I) (V : analyticQcqsEtale (D.obj i)),
        YonedaAdicSpace.IsFiniteEtale V.obj.hom ∧ Nonempty
          ((residueEtaleComparison p D c h).obj
            ((CategoryTheory.FilteredTwoColimit.ι (residueEtaleDiagram p D c h) (op i)).obj V) ≅ U) :=
  residueEtaleComparison_finite p D c h U

/-- A finite family covers at the limit exactly when it covers at some later stage. -/
theorem residueEtaleComparison_cover (i : I) (U : analyticQcqsEtale (D.obj i))
    (n : ℕ) (V : Fin n → analyticQcqsEtale (D.obj i)) (f : ∀ k, V k ⟶ U) :
    let F := CategoryTheory.FilteredTwoColimit.ι (residueEtaleDiagram p D c h) (op i) ⋙
      residueEtaleComparison p D c h
    (∀ x : space.obj (F.obj U).obj.obj.left.obj,
      ∃ k, x ∈ Set.range (pointMap p (F.map (f k)).hom.hom.left)) ↔
    ∃ (j : I) (a : j ⟶ i),
      let B := analyticEtalePullback (D.map a) (h.level_isAnalytic p D c _)
      ∀ x : space.obj (B.obj U).obj.toComma.left,
        ∃ k, x ∈ Set.range (space.map (B.map (f k)).hom.hom.left) := sorry

-- Check: residueEtaleDiagram_identity; residueEtaleComparison_identity
example (i : I) (U : analyticQcqsEtale (D.obj i)) :
    (residueEtaleComparison p D c h).map
      ((CategoryTheory.FilteredTwoColimit.ι (residueEtaleDiagram p D c h) (op i)).map (𝟙 U)) = 𝟙 _ := by sorry
-- Check: residueEtaleDiagram_empty; residueEtaleComparison_empty
example (i : I) (U : analyticQcqsEtale (D.obj i)) [IsEmpty (space.obj U.obj.toComma.left)] :
    IsEmpty (space.obj ((residueEtaleComparison p D c h).obj
      ((CategoryTheory.FilteredTwoColimit.ι (residueEtaleDiagram p D c h) (op i)).obj U)).obj.obj.left.obj) := sorry
-- Check: residueEtaleDiagram_sections; residueEtaleComparison_sections
example (i : I) (U V : analyticQcqsEtale (D.obj i)) (f g : U ⟶ V)
    (he : (residueEtaleComparison p D c h).map
      ((CategoryTheory.FilteredTwoColimit.ι (residueEtaleDiagram p D c h) (op i)).map f) =
      (residueEtaleComparison p D c h).map
      ((CategoryTheory.FilteredTwoColimit.ι (residueEtaleDiagram p D c h) (op i)).map g)) :
    ∃ (j : I) (a : j ⟶ i),
      (analyticEtalePullback (D.map a) (h.level_isAnalytic p D c _)).map f =
        (analyticEtalePullback (D.map a) (h.level_isAnalytic p D c _)).map g := sorry

end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
end

noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
open _root_.CategoryTheory _root_.CategoryTheory.Limits Opposite
open TauCetiRoadmap.AdicEtaleGeometry YonedaAdicSpace
variable (p : ℕ) [Fact p.Prime] {I : Type} [SmallCategory I] [IsCofiltered I]
  (D : I ⥤ YonedaAdicSpace) (c : Cone D) (h : IsResidueFieldTildeLimit p D c)

/-! ### P7/tilde-limits-and-etale-topos-comparison -/

/-- Finite covering families represented at one common stage generate the limit site. -/
def residueEtalePrecoverage : Precoverage
    (CategoryTheory.FilteredTwoColimit (residueEtaleDiagram p D c h)) where
  coverings U := {S | ∃ (i : I) (V : analyticQcqsEtale (D.obj i)) (n : ℕ)
    (W : Fin n → analyticQcqsEtale (D.obj i)) (f : ∀ k, W k ⟶ V),
    let ι := CategoryTheory.FilteredTwoColimit.ι (residueEtaleDiagram p D c h) (op i)
    ∃ e : ι.obj V ≅ U,
      S = Presieve.ofArrows (fun k ↦ ι.obj (W k)) (fun k ↦ ι.map (f k) ≫ e.hom) ∧
      ∀ x : space.obj V.obj.toComma.left, ∃ k, x ∈ Set.range (space.map (f k).hom.hom.left)}

def residueEtaleTopology : GrothendieckTopology
    (CategoryTheory.FilteredTwoColimit (residueEtaleDiagram p D c h)) :=
  (residueEtalePrecoverage p D c h).toGrothendieck

omit [IsCofiltered I] in
theorem residueEtaleTopology_eq : residueEtaleTopology p D c h =
    (residueEtalePrecoverage p D c h).toGrothendieck := rfl

/-- Sch12 7.17: the étale topos is the topos on the finite-stage colimit site.
The displayed presheaf isomorphism fixes the comparison on every finite-stage object. -/
theorem residueEtaleTopos :
    ∃ e : Sheaf (smallEtaleTopology p ⟨c.pt, h.perfectoid⟩) (Type 2) ≌
      Sheaf (residueEtaleTopology p D c h) (Type 2),
    ∀ F, Nonempty ((e.functor.obj F).obj ≅
      ((residueEtaleComparison p D c h) ⋙ ObjectProperty.ι
        (fun U : smallEtale p ⟨c.pt, h.perfectoid⟩ ↦
          TauCetiRoadmap.AdicSpacesPartII.AdicSpace.QuasiCompact ((toAdicSpace p).map U.obj.hom) ∧
              TauCetiRoadmap.AdicSpacesPartII.AdicSpace.QuasiCompact
                ((toAdicSpace p).map (pullback.diagonal U.obj.hom)))).op ⋙ F.obj) := sorry

-- Check: residueEtalePrecoverage_identity; residueEtaleTopology_identity
example (i : I) (V : analyticQcqsEtale (D.obj i)) :
    let U := (CategoryTheory.FilteredTwoColimit.ι (residueEtaleDiagram p D c h) (op i)).obj V
    Presieve.singleton (𝟙 U) ∈ (residueEtalePrecoverage p D c h).coverings U ∧
      Sieve.generate (Presieve.singleton (𝟙 U)) ∈ residueEtaleTopology p D c h U := sorry
-- Check: residueEtalePrecoverage_empty; residueEtaleTopology_empty
example (i : I) (V : analyticQcqsEtale (D.obj i)) [IsEmpty (space.obj V.obj.toComma.left)] :
    let U := (CategoryTheory.FilteredTwoColimit.ι (residueEtaleDiagram p D c h) (op i)).obj V
    (⊥ : Presieve U) ∈ (residueEtalePrecoverage p D c h).coverings U ∧
      (⊥ : Sieve U) ∈ residueEtaleTopology p D c h U := sorry
-- Check: residueEtalePrecoverage_nonempty; residueEtaleTopology_nonempty
example (U : CategoryTheory.FilteredTwoColimit (residueEtaleDiagram p D c h))
    [Nonempty (space.obj ((residueEtaleComparison p D c h).obj U).obj.obj.left.obj)] :
    (⊥ : Presieve U) ∉ (residueEtalePrecoverage p D c h).coverings U ∧
      (⊥ : Sieve U) ∉ residueEtaleTopology p D c h U := sorry

end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
end

noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
open _root_.CategoryTheory _root_.CategoryTheory.Limits Opposite
open TauCetiRoadmap.AdicEtaleGeometry YonedaAdicSpace
open _root_.TauCeti _root_.TauCeti.Huber _root_.TauCeti.ValuationSpectrum
variable (p : ℕ) [Fact p.Prime] {I : Type} [SmallCategory I] [IsCofiltered I]
  (D : I ⥤ YonedaAdicSpace) (c : Cone D) (h : IsResidueFieldTildeLimit p D c)

/-! ### P7/etale-cohomology-along-residue-field-towers -/

/-! Cohomology of a residue-field tilde-limit, Sch12 Corollary 7.18, p. 44. -/

section ResidueEtaleCohomology

set_option quotPrecheck false
open scoped ZeroObject

local notation "J" i => YonedaAdicSpace.smallEtaleTopology (D.obj i)
  (IsResidueFieldTildeLimit.level_isAnalytic p D c h i)
local notation "K" => smallEtaleTopology p ⟨c.pt, h.perfectoid⟩
local notation "ι₀" i => ObjectProperty.ι
  (fun U : YonedaAdicSpace.smallEtale (D.obj i) ↦ AdicSpace.Qcqs U.hom)
local notation "ιX" => ObjectProperty.ι
  (fun U : smallEtale p ⟨c.pt, h.perfectoid⟩ ↦
    TauCetiRoadmap.AdicSpacesPartII.AdicSpace.QuasiCompact ((toAdicSpace p).map U.obj.hom) ∧
      TauCetiRoadmap.AdicSpacesPartII.AdicSpace.QuasiCompact
        ((toAdicSpace p).map (pullback.diagonal U.obj.hom)))

/-- Inverse image of abelian sheaves along a transition of the noetherian system.
Its universal property is restriction along geometric base change on the qcqs basis. -/
def residueEtaleSheafPullback {i j : I} (a : j ⟶ i) :
    Sheaf (J i) AddCommGrpCat.{2} ⥤ Sheaf (J j) AddCommGrpCat.{2} := sorry

/-- The inverse image is characterized by a Hom equivalence natural in both sheaves. -/
theorem residueEtaleSheafPullback_universal {i j : I} (a : j ⟶ i) :
    ∃ e : ∀ (F : Sheaf (J i) AddCommGrpCat.{2}) (G : Sheaf (J j) AddCommGrpCat.{2}),
      ((residueEtaleSheafPullback p D c h a).obj F ⟶ G) ≃
        ((ι₀ i).op ⋙ F.obj ⟶
          (analyticEtalePullback (D.map a)
            (IsResidueFieldTildeLimit.level_isAnalytic p D c h j) ⋙ ι₀ j).op ⋙ G.obj),
      (∀ F G G' (u : G ⟶ G') v,
        e F G' (v ≫ u) = e F G v ≫ Functor.whiskerLeft _ u.hom) ∧
      ∀ F F' (u : F' ⟶ F) G v,
        e F' G ((residueEtaleSheafPullback p D c h a).map u ≫ v) =
          Functor.whiskerLeft (ι₀ i).op u.hom ≫ e F G v := sorry

/-- Inverse image of finite-stage coefficients on the perfectoid small étale site. -/
def residueEtaleLimitSheaf (i : I) :
    Sheaf (J i) AddCommGrpCat.{2} ⥤ Sheaf K AddCommGrpCat.{2} := sorry

/-- The limit inverse image is adjoint to restriction along the specified comparison. -/
theorem residueEtaleLimitSheaf_universal (i : I) :
    ∃ e : ∀ (F : Sheaf (J i) AddCommGrpCat.{2}) (G : Sheaf K AddCommGrpCat.{2}),
      ((residueEtaleLimitSheaf p D c h i).obj F ⟶ G) ≃
        ((ι₀ i).op ⋙ F.obj ⟶
          (CategoryTheory.FilteredTwoColimit.ι (residueEtaleDiagram p D c h) (op i) ⋙
            residueEtaleComparison p D c h ⋙ ιX).op ⋙ G.obj),
      (∀ F G G' (u : G ⟶ G') v,
        e F G' (v ≫ u) = e F G v ≫ Functor.whiskerLeft _ u.hom) ∧
      ∀ F F' (u : F' ⟶ F) G v,
        e F' G ((residueEtaleLimitSheaf p D c h i).map u ≫ v) =
          Functor.whiskerLeft (ι₀ i).op u.hom ≫ e F G v := sorry

-- Check: residueEtaleSheafPullback_identity
example (i : I) : Nonempty (residueEtaleSheafPullback p D c h (𝟙 i) ≅ 𝟭 _) := sorry
-- Check: residueEtaleSheafPullback_zero
example {i j : I} (a : j ⟶ i) :
    IsZero ((residueEtaleSheafPullback p D c h a).obj 0) := sorry
-- Check: residueEtaleSheafPullback_constant
example {i j : I} (a : j ⟶ i) (A : AddCommGrpCat.{2}) :
    Nonempty ((residueEtaleSheafPullback p D c h a).obj ((constantSheaf (J i) _).obj A) ≅
      (constantSheaf (J j) _).obj A) := sorry
-- Check: residueEtaleLimitSheaf_zero
example (i : I) : IsZero ((residueEtaleLimitSheaf p D c h i).obj 0) := sorry
-- Check: residueEtaleLimitSheaf_constant
example (i : I) (A : AddCommGrpCat.{2}) :
    Nonempty ((residueEtaleLimitSheaf p D c h i).obj ((constantSheaf (J i) _).obj A) ≅
      (constantSheaf K _).obj A) := sorry
-- Check: residueEtaleLimitSheaf_transition
example {i j : I} (a : j ⟶ i) :
    Nonempty (residueEtaleSheafPullback p D c h a ⋙ residueEtaleLimitSheaf p D c h j ≅
      residueEtaleLimitSheaf p D c h i) := sorry

attribute [local instance] HasExt.standard

/-- The filtered cohomology diagram has the pullback of the fixed coefficient sheaf
at each arrow into the initial stage. Its arrows are the maps on Ext induced by the
exact inverse-image functors, using the composition comparisons of their adjunctions. -/
def residueEtaleCohomologyDiagram (i : I) (F : Sheaf (J i) AddCommGrpCat.{2}) (n : ℕ) :
    (Over i)ᵒᵖ ⥤ AddCommGrpCat.{3} where
  obj a := AddCommGrpCat.of
    (Sheaf.H.{3} ((residueEtaleSheafPullback p D c h a.unop.hom).obj F) n)
  map := sorry
  map_id := sorry
  map_comp := sorry

/-- The cohomology cocone is induced by pullback along the projections from the
perfectoid limit. Its maps use the same adjunction comparisons as the stage diagram. -/
def residueEtaleCohomologyCocone (i : I) (F : Sheaf (J i) AddCommGrpCat.{2}) (n : ℕ) :
    Cocone (residueEtaleCohomologyDiagram p D c h i F n) where
  pt := AddCommGrpCat.of (Sheaf.H.{3} ((residueEtaleLimitSheaf p D c h i).obj F) n)
  ι := sorry

/-- Transition maps are the maps on Ext induced by exact inverse image, followed
by the natural comparison with pullback from the initial stage. The comparisons are
independent of the coefficient sheaf and the cohomological degree. -/
theorem residueEtaleCohomologyDiagram_map (i : I) (a b : Over i) (f : a ⟶ b) :
    let L := residueEtaleSheafPullback p D c h f.left
    ∃ (ha : L.Additive) (hl : PreservesFiniteLimits L) (hc : PreservesFiniteColimits L),
    letI := ha
    letI := hl
    letI := hc
    ∃ (e : residueEtaleSheafPullback p D c h b.hom ⋙ L ≅
        residueEtaleSheafPullback p D c h a.hom)
      (z : (constantSheaf (J a.left) AddCommGrpCat.{2}).obj
          (AddCommGrpCat.of (ULift.{2} ℤ)) ≅
        L.obj ((constantSheaf (J b.left) AddCommGrpCat.{2}).obj
          (AddCommGrpCat.of (ULift.{2} ℤ)))),
    ∀ (F : Sheaf (J i) AddCommGrpCat.{2}) (n : ℕ)
      (x : Sheaf.H.{3} ((residueEtaleSheafPullback p D c h b.hom).obj F) n),
      (residueEtaleCohomologyDiagram p D c h i F n).map f.op x =
        ((Abelian.Ext.mk₀ z.hom).comp (x.mapExactFunctor L) (zero_add n)).comp
          (Abelian.Ext.mk₀ (e.hom.app F)) (add_zero n) := sorry

/-- Each map to limit cohomology is induced on Ext by the exact geometric inverse
image to the perfectoid site, with the natural coefficient comparison. -/
theorem residueEtaleCohomologyCocone_map (i : I) (a : Over i) :
    let L := residueEtaleLimitSheaf p D c h a.left
    ∃ (ha : L.Additive) (hl : PreservesFiniteLimits L) (hc : PreservesFiniteColimits L),
    letI := ha
    letI := hl
    letI := hc
    ∃ (e : residueEtaleSheafPullback p D c h a.hom ⋙ L ≅
        residueEtaleLimitSheaf p D c h i)
      (z : (constantSheaf K AddCommGrpCat.{2}).obj
          (AddCommGrpCat.of (ULift.{2} ℤ)) ≅
        L.obj ((constantSheaf (J a.left) AddCommGrpCat.{2}).obj
          (AddCommGrpCat.of (ULift.{2} ℤ)))),
    ∀ (F : Sheaf (J i) AddCommGrpCat.{2}) (n : ℕ)
      (x : Sheaf.H.{3} ((residueEtaleSheafPullback p D c h a.hom).obj F) n),
      (residueEtaleCohomologyCocone p D c h i F n).ι.app (op a) x =
        ((Abelian.Ext.mk₀ z.hom).comp (x.mapExactFunctor L) (zero_add n)).comp
          (Abelian.Ext.mk₀ (e.hom.app F)) (add_zero n) := sorry

/-- Sch12 Corollary 7.18: cohomology of pulled-back abelian coefficients commutes
with this filtered limit of étale topoi, in every nonnegative degree. -/
theorem residueEtaleCohomologyColimit (i : I) (F : Sheaf (J i) AddCommGrpCat.{2}) (n : ℕ) :
    Nonempty (IsColimit (residueEtaleCohomologyCocone p D c h i F n)) := sorry

/-- The colimit comparison is an isomorphism of abelian groups. -/
theorem residueEtaleCohomologyColimit_isIso
    (i : I) (F : Sheaf (J i) AddCommGrpCat.{2}) (n : ℕ) :
    IsIso (colimit.desc (residueEtaleCohomologyDiagram p D c h i F n)
      (residueEtaleCohomologyCocone p D c h i F n)) := sorry

-- Check: residueEtaleCohomologyDiagram_identity
example (i : I) (F : Sheaf (J i) AddCommGrpCat.{2}) (n : ℕ) (a : (Over i)ᵒᵖ) :
    (residueEtaleCohomologyDiagram p D c h i F n).map (𝟙 a) = 𝟙 _ :=
  (residueEtaleCohomologyDiagram p D c h i F n).map_id a
-- Check: residueEtaleCohomologyDiagram_zero
example (i : I) (n : ℕ) (a : (Over i)ᵒᵖ) :
    IsZero ((residueEtaleCohomologyDiagram p D c h i 0 n).obj a) := sorry
-- Check: residueEtaleCohomologyDiagram_degreeZero
example (i : I) (F : Sheaf (J i) AddCommGrpCat.{2}) (a : Over i)
    (T : YonedaAdicSpace.smallEtale (D.obj a.left)) (hT : IsTerminal T) :
    Nonempty (((residueEtaleCohomologyDiagram p D c h i F 0).obj (op a)) ≃+
      ((residueEtaleSheafPullback p D c h a.hom).obj F).obj.obj (op T)) :=
  ⟨Sheaf.H.equiv₀ _ hT⟩
-- Check: residueEtaleCohomologyCocone_zero
example (i : I) (n : ℕ) :
    IsZero (residueEtaleCohomologyCocone p D c h i 0 n).pt := sorry
-- Check: residueEtaleCohomologyCocone_degreeZero
example (i : I) (F : Sheaf (J i) AddCommGrpCat.{2})
    (T : smallEtale p ⟨c.pt, h.perfectoid⟩) (hT : IsTerminal T) :
    Nonempty ((residueEtaleCohomologyCocone p D c h i F 0).pt ≃+
      ((residueEtaleLimitSheaf p D c h i).obj F).obj.obj (op T)) :=
  ⟨Sheaf.H.equiv₀ _ hT⟩
-- Check: residueEtaleCohomologyCocone_degreeOne
example (i : I) (F : Sheaf (J i) AddCommGrpCat.{2}) :
    Function.Bijective (colimit.desc (residueEtaleCohomologyDiagram p D c h i F 1)
      (residueEtaleCohomologyCocone p D c h i F 1)) := sorry

end ResidueEtaleCohomology

-- Check: residueEtaleDiagram_suppliedCover
example (i : I) (U : analyticQcqsEtale (D.obj i)) (S : Sieve U.obj) :
    S ∈ YonedaAdicSpace.smallEtaleTopology (D.obj i)
      (IsResidueFieldTildeLimit.level_isAnalytic p D c h i) U.obj ↔
    ∀ x : space.obj U.obj.left,
      ∃ (V : YonedaAdicSpace.smallEtale (D.obj i)) (f : V ⟶ U.obj),
        S f ∧ x ∈ Set.range (space.map f.left) := Iff.rfl

/-! ### P7/etale-topos-invariance-under-inseparable-towers -/

/-- Sch12 7.19: homeomorphic transitions with purely inseparable completed residue
extensions leave the étale topos unchanged. The equation fixes direct image on qcqs objects. -/
theorem inseparable_tower_etale_topos
    (hhomeo : ∀ {i j} (a : i ⟶ j), ∃ e : space.obj (D.obj i) ≃ₜ space.obj (D.obj j),
      ∀ x, e x = space.map (D.map a) x)
    (hres : ∀ {i j} (a : i ⟶ j) (R C : CAff)
      (u : ofSpaY R ⟶ D.obj j) (v : ofSpaY C ⟶ D.obj i) (g : R ⟶ C),
      YonedaAdicSpace.IsOpenImmersion u.hom → YonedaAdicSpace.IsOpenImmersion v.hom →
      (ObjectProperty.homMk (spaYFunctor.map g.op) : ofSpaY C ⟶ ofSpaY R) ≫ u = v ≫ D.map a →
      ∀ y : spa C.P.plus,
        let x := (show Pair.Hom R.P C.P from g).spaComap y
        ∃ φ : AdicSpace.CompletedResidue R x →+* AdicSpace.CompletedResidue C y,
          Continuous φ ∧
          (∀ r, φ (AdicSpace.residueMap R x r) = AdicSpace.residueMap C y (CAff.toRingHom g r)) ∧
          letI := φ.toAlgebra
          IsPurelyInseparable (AdicSpace.CompletedResidue R x) (AdicSpace.CompletedResidue C y))
    (i : I) (A : Type 3) [Category.{2} A] [HasLimitsOfSize.{2, 2} A] :
    ∃ e : Sheaf (YonedaAdicSpace.smallEtaleTopology (D.obj i) (IsResidueFieldTildeLimit.level_isAnalytic p D c h i)) A ≌
      Sheaf (smallEtaleTopology p ⟨c.pt, h.perfectoid⟩) A,
    ∀ F, Nonempty
      ((ObjectProperty.ι (fun U : YonedaAdicSpace.smallEtale (D.obj i) ↦ AdicSpace.Qcqs U.hom)).op ⋙
          (e.inverse.obj F).obj ≅
        ((CategoryTheory.FilteredTwoColimit.ι (residueEtaleDiagram p D c h) (op i) ⋙
          residueEtaleComparison p D c h) ⋙ ObjectProperty.ι
            (fun U : smallEtale p ⟨c.pt, h.perfectoid⟩ ↦
              TauCetiRoadmap.AdicSpacesPartII.AdicSpace.QuasiCompact ((toAdicSpace p).map U.obj.hom) ∧
              TauCetiRoadmap.AdicSpacesPartII.AdicSpace.QuasiCompact
                ((toAdicSpace p).map (pullback.diagonal U.obj.hom)))).op ⋙ F.obj) := sorry

end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
end

noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid.FrobeniusTower
open _root_.TauCeti _root_.TauCeti.Huber
variable {p : ℕ} [Fact p.Prime]

/-! ### P7/frobenius-tower-tilt -/

/-- Compatible quotient Frobenius data determine a unique topological pair isomorphism.
Its reduction is the colimit of `β`, evaluated on integral compatible root sequences;
every root sequence of a unit multiple of the marked parameter maps to a unit multiple
of the characteristic-p parameter. Torsion, proof of Corollary III.2.19, p. 43;
BMS Lemmas 3.9–3.10, pp. 22–23. -/
theorem completed_tilt (A S : FrobeniusTower p) [∀ n, CharP (S.ring n) p]
    (m : ℕ) (hA : A.start ≤ m) (hS : S.start ≤ m)
    (α : ∀ n, m ≤ n → A.toIntegralTower.quotient n p ≃+* S.toIntegralTower.quotient n p)
    (hα : ∀ n (hn : m ≤ n) (x : A.toIntegralTower.quotient n p),
      α (n + 1) (Nat.le_trans hn (Nat.le_succ n)) (A.toIntegralTower.quotientMap n p x) =
        S.toIntegralTower.quotientMap n p (α n hn x))
    (β : ∀ n, m ≤ n → A.toIntegralTower.quotient n 1 ≃+* S.toIntegralTower.quotient n 1)
    (hβ : ∀ n (hn : m ≤ n) (x : A.ring n),
      β n hn (Ideal.Quotient.mk _ x) =
        Ideal.Quotient.factor (by
          apply Ideal.span_singleton_le_span_singleton.mpr
          exact pow_dvd_pow _ (Nat.Prime.one_le Fact.out) :
          Ideal.span {S.parameter n ^ p} ≤ Ideal.span {S.parameter n ^ 1}) (α n hn (Ideal.Quotient.mk _ x)))
    (hlift : ∀ n (hn : m ≤ n) (x : A.toIntegralTower.quotient (n + 1) 1),
      α n hn (A.lift n (Nat.le_trans hA hn) x) =
        S.lift n (Nat.le_trans hS hn) (β (n + 1) (Nat.le_trans hn (Nat.le_succ n)) x)) :
    letI : IsPerfectoidTateRing p A.completed := A.completed_isPerfectoid
    letI : IsPerfectoidTateRing p S.completed := S.completed_isPerfectoid
    let iA := algebraMap A.completedPlus A.completed
    let iS := algebraMap S.completedPlus S.completed
    let jA : Perfection A.completedPlus p → tilt p A.completed :=
      fun x ↦ Perfection.mapMonoidHom p iA.toMonoidHom x
    let qA := Ideal.Quotient.mk (Ideal.span {A.toIntegralTower.completedParameter})
    let qS := Ideal.Quotient.mk (Ideal.span {S.toIntegralTower.completedParameter})
    PerfectRing S.completed p ∧
      ∃! e : tilt p A.completed ≃+* S.completed,
        Continuous e ∧ Continuous e.symm ∧
          (Pair.tilt p A.completedPair).plus.map e.toRingHom = S.completedPair.plus ∧
          ∃ c : (A.completedPlus ⧸ Ideal.span {A.toIntegralTower.completedParameter}) ≃+*
              (S.completedPlus ⧸ Ideal.span {S.toIntegralTower.completedParameter}),
            (∀ n (hn : m ≤ n) (a : A.ring n) (b : S.ring n),
              β n hn (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ b →
                c (qA (A.toCompleted n a)) = qS (S.toCompleted n b)) ∧
            (∀ x : Perfection A.completedPlus p, ∃ y : S.completedPlus,
              e (jA x) = iS y ∧
                c (qA (Perfection.coeffMonoidHom A.completedPlus p 0 x)) = qS y) ∧
            (∀ (ϖflat : Perfection A.completedPlus p) (u : A.completedPlusˣ),
              Perfection.coeffMonoidHom A.completedPlus p 0 ϖflat =
                A.toIntegralTower.completedParameter * (u : A.completedPlus) →
              ∃ v : S.completedPlusˣ,
                e (jA ϖflat) = iS (S.toIntegralTower.completedParameter *
                  (v : S.completedPlus))) := sorry

-- Check: completed_tilt_identity_reduction
example (S : FrobeniusTower p) [∀ n, CharP (S.ring n) p] :
    letI : IsPerfectoidTateRing p S.completed := S.completed_isPerfectoid
    letI : CharP S.completed p := by sorry
    ∀ x : Perfection S.completedPlus p,
      tilt.equivOfCharP
        (show tilt p S.completed from
          Perfection.mapMonoidHom p
            (algebraMap S.completedPlus S.completed).toMonoidHom x) =
        algebraMap S.completedPlus S.completed
          (Perfection.coeffMonoidHom S.completedPlus p 0 x) := sorry

-- Check: completed_tilt_zero_reduction
example (A S : FrobeniusTower p) [Subsingleton A.completedPlus] [Subsingleton S.completedPlus] :
    ∃! c : (A.completedPlus ⧸ Ideal.span {A.toIntegralTower.completedParameter}) ≃+*
        (S.completedPlus ⧸ Ideal.span {S.toIntegralTower.completedParameter}),
      ∀ (a : A.completedPlus) (b : S.completedPlus),
        c (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ b := sorry

-- Check: completed_tilt_swap_reduction
example :
    (RingEquiv.prodComm (R := ZMod 2) (S := ZMod 2)) (1, 0) = (0, 1) ∧
      (RingEquiv.prodComm (R := ZMod 2) (S := ZMod 2)) (1, 0) ≠
        (RingEquiv.refl (ZMod 2 × ZMod 2)) (1, 0) := by
  decide

end TauCetiRoadmap.PerfectoidSpaces.Perfectoid.FrobeniusTower
end

noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
open _root_.CategoryTheory _root_.CategoryTheory.Limits Opposite
open _root_.TauCeti _root_.TauCeti.Huber Perfectoid
open TauCetiRoadmap.AdicEtaleGeometry YonedaAdicSpace
variable (p : ℕ) [Fact p.Prime] {I : Type} [SmallCategory I] [IsCofiltered I]
    {D : I ⥤ YonedaAdicSpace} {c : Cone D}

/-! ### P7/good-affinoid-homeomorph -/

/-- Restricting the limit homeomorphism to the inverse image of the finite-level open.
The larger compatible family contains the same data as the family on I/W.level. -/
theorem GoodAffinoid.homeomorph (W : GoodAffinoid p D c) (h : IsTildeLimit p D c) :
    ∃ e : underlyingPoints p (ofPair p W.ring) ≃ₜ
      {y : ∀ i, space.obj (D.obj i) |
        (∀ (i j : I) (a : i ⟶ j), space.map (D.map a) (y i) = y j) ∧
        y W.level ∈ Set.range (space.map W.inclusion)},
      ∀ x i, (e x).val i = space.map (W.chart ≫ c.π.app i) x := sorry

/-! ### P7/good-affinoid-perfectoid-basis -/

/-- Rational localization of a good chart is good after a finite increase of level,
with exactly the original rational restriction as its chart in the limit. -/
theorem GoodAffinoid.rationalSubset (W : GoodAffinoid p D c) (h : IsTildeLimit p D c)
    (U : RationalOpen p W.ring) :
    ∃ (W' : GoodAffinoid p D c) (a : W'.level ⟶ W.level),
      Set.range (space.map W'.chart) = Set.range (space.map
        (((spaFunctor p).map (rationalMap p W.ring U).op).hom ≫ W.chart)) ∧
      Set.range (space.map W'.inclusion) ⊆
        space.map (D.map a) ⁻¹' Set.range (space.map W.inclusion) := sorry

end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
end

noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
