section isKappaSmall_mono_equal
example {R : Type u} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R] [IsHuberRing R]
    (P : Pair R) {κ κ' : Cardinal.{u}} (hκ : κ ≤ κ')
    (h : IsKappaSmall_affinoid κ P) :
    IsKappaSmall_affinoid κ' P ∧ ¬ IsKappaSmall_affinoid #R P := by
  exact ⟨IsKappaSmall.mono_affinoid hκ h, fun hR ↦ (lt_irrefl #R) hR.card_lt⟩
end isKappaSmall_mono_equal


