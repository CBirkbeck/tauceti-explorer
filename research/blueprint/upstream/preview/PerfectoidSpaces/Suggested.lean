/-- The full subcategory of `ModuleCat A` on finitely presented modules. -/
abbrev fpModules (A : CommRingCat.{u}) := ObjectProperty.FullSubcategory
  (fun M : ModuleCat.{u} A ↦ Module.FinitePresentation A M)

def fpModules.baseChange {A B : CommRingCat.{u}} (f : A ⟶ B) : fpModules A ⥤ fpModules B where
  obj M := ⟨(ModuleCat.extendScalars f.hom).obj M.obj, by sorry⟩
  map g := ObjectProperty.homMk ((ModuleCat.extendScalars f.hom).map g.hom)
  map_id := by sorry
  map_comp := by sorry

def fpModuleDiagram (D : J ⥤ CommRingCat.{u}) : Pseudofunctor (LocallyDiscrete J) Cat.{u, u+1} where
  obj j := Cat.of (fpModules (D.obj j.as))
  map a := (fpModules.baseChange (D.map a.as)).toCatHom
  map₂ := by sorry
  map₂_id := by sorry
  map₂_comp := by sorry
  mapId := by sorry
  mapComp := by sorry
  map₂_whisker_left := by sorry
  map₂_whisker_right := by sorry
  map₂_associator := by sorry
  map₂_left_unitor := by sorry
  map₂_right_unitor := by sorry

/-- Stacks 05N7, including the natural base-change functors. -/
def fpModuleColimitEquiv (D : J ⥤ CommRingCat.{u}) :
    FilteredTwoColimit (fpModuleDiagram D) ≌ fpModules (colimit D) := sorry

def fpModuleColimitEquiv_ι (D : J ⥤ CommRingCat.{u}) (j : J) :
    FilteredTwoColimit.ι (fpModuleDiagram D) j ⋙ (fpModuleColimitEquiv D).functor ≅
      fpModules.baseChange (colimit.ι D j) := sorry

-- Check: filteredTwoColimit_test_finitelyPresentedModules
example (D : J ⥤ CommRingCat.{u}) :
    ∃ e : FilteredTwoColimit (fpModuleDiagram D) ≌ fpModules (colimit D),
      ∀ j, Nonempty (FilteredTwoColimit.ι (fpModuleDiagram D) j ⋙ e.functor ≅
        fpModules.baseChange (colimit.ι D j)) :=
  ⟨fpModuleColimitEquiv D, fun j ↦ ⟨fpModuleColimitEquiv_ι D j⟩⟩
