namespace Algebra

/-- The target of an algebra map as an almost module over its source's almost elements. -/
def relativeModule {A B : Algebra S} (f : A ⟶ B) : Module (S.baseChange ((elements S).obj A)) :=
  letI := ((elements S).map f).hom.toAlgebra
  (Almost.toAlmost _).obj (_root_.ModuleCat.of ((elements S).obj A) ((elements S).obj B))

/-! ### P0/almost-finite-projective-and-finite-etale-algebras -/

/-- Flatness of an almost algebra map means flatness of its underlying relative module. -/
def IsFlat {A B : Algebra S} (f : A ⟶ B) : Prop := Module.Flat _ (relativeModule S f)
def IsFaithfullyFlat {A B : Algebra S} (f : A ⟶ B) : Prop := Module.FaithfullyFlat _ (relativeModule S f)
def IsAlmostProjective {A B : Algebra S} (f : A ⟶ B) : Prop := Module.AlmostProjective _ (relativeModule S f)
def IsAlmostFinite {A B : Algebra S} (f : A ⟶ B) : Prop :=
  Module.AlmostFG (S.baseChange ((elements S).obj A)) ((Module.elements _).obj (relativeModule S f))

/-- Relative tensor product is the pushout of almost algebras. -/
instance : HasPushouts (Algebra S) := sorry

/-- Multiplication out of the diagonal tensor product. -/
def diagonal {A B : Algebra S} (f : A ⟶ B) : pushout f f ⟶ B :=
  pushout.desc (𝟙 B) (𝟙 B) (by simp)

/-- Weak unramifiedness and unramifiedness are flatness and almost projectivity of the diagonal. -/
def IsWeaklyUnramified {A B : Algebra S} (f : A ⟶ B) : Prop := IsFlat S (diagonal S f)
def IsUnramified {A B : Algebra S} (f : A ⟶ B) : Prop := IsAlmostProjective S (diagonal S f)
def IsWeaklyEtale {A B : Algebra S} (f : A ⟶ B) : Prop := IsFlat S f ∧ IsWeaklyUnramified S f
def IsEtale {A B : Algebra S} (f : A ⟶ B) : Prop := IsFlat S f ∧ IsUnramified S f

/-- Finite etaleness includes almost finite presentation, GR (3.2.27). -/
def IsFiniteEtale {A B : Algebra S} (f : A ⟶ B) : Prop :=
  IsEtale S f ∧ Module.AlmostFP (S.baseChange ((elements S).obj A)) ((Module.elements _).obj (relativeModule S f))

/-- The category of finite etale algebras over an almost algebra. -/
abbrev FiniteEtale (A : Algebra S) :=
  ObjectProperty.FullSubcategory (fun B : Under A => IsFiniteEtale S B.hom)

/-- The diagonal ideal is computed on the ring of almost elements of the almost pushout. -/
def diagonalIdeal {A B : Algebra S} (f : A ⟶ B) : Ideal ((elements S).obj (pushout f f)) :=
  RingHom.ker (((elements S).map (diagonal S f)).hom.toRingHom)

/-! ### P0/unramified-idempotent-characterisation -/

theorem isUnramified_iff_exists_idempotent {A B : Algebra S} (f : A ⟶ B) :
    IsUnramified S f ↔ ∃ e : (elements S).obj (pushout f f),
      e * e = e ∧ ((elements S).map (diagonal S f)).hom e = 1 ∧
      ∀ x ∈ diagonalIdeal S f, x * e = 0 := sorry

/-- The diagonal idempotent is unique, GR Proposition 3.1.4 and Remark 3.1.8, p. 40. -/
theorem diagonalIdempotent_unique {A B : Algebra S} (f : A ⟶ B)
    (e e' : (elements S).obj (pushout f f))
    (he : e * e = e ∧ ((elements S).map (diagonal S f)).hom e = 1 ∧
      ∀ x ∈ diagonalIdeal S f, x * e = 0)
    (he' : e' * e' = e' ∧ ((elements S).map (diagonal S f)).hom e' = 1 ∧
      ∀ x ∈ diagonalIdeal S f, x * e' = 0) : e = e' := sorry

/-- The product splitting on almost elements, GR Corollary 3.1.9, p. 40.
The first factor has inherited multiplication and unit `1 - e`; the displayed formula
also fixes scalar multiplication by the diagonal algebra on both factors. -/
theorem diagonalIdempotent_split {A B : Algebra S} (f : A ⟶ B)
    (e : (elements S).obj (pushout f f))
    (he : e * e = e ∧ ((elements S).map (diagonal S f)).hom e = 1 ∧
      ∀ x ∈ diagonalIdeal S f, x * e = 0) :
    ∃ E : (elements S).obj (pushout f f) ≃+*
        (diagonalIdeal S f × (elements S).obj B),
      ∀ x, ((E x).1 : (elements S).obj (pushout f f)) = (1 - e) * x ∧
        (E x).2 = ((elements S).map (diagonal S f)).hom x := sorry

theorem IsFiniteEtale.almostFiniteProjective {A B : Algebra S} {f : A ⟶ B}
    (h : IsFiniteEtale S f) : Module.AlmostFiniteProjective _ (relativeModule S f) := sorry

/-! ### P0/etale-morphisms-stability -/

theorem IsEtale.comp {A B C : Algebra S} {f : A ⟶ B} {g : B ⟶ C}
    (hf : IsEtale S f) (hg : IsEtale S g) : IsEtale S (f ≫ g) := sorry

theorem IsEtale.baseChange {A B C : Algebra S} {f : A ⟶ B} (hf : IsEtale S f) (g : A ⟶ C) :
    IsEtale S (pushout.inr f g) := sorry

theorem IsFiniteEtale.comp {A B C : Algebra S} {f : A ⟶ B} {g : B ⟶ C}
    (hf : IsFiniteEtale S f) (hg : IsFiniteEtale S g) : IsFiniteEtale S (f ≫ g) := sorry

theorem IsFiniteEtale.baseChange {A B C : Algebra S} {f : A ⟶ B}
    (hf : IsFiniteEtale S f) (g : A ⟶ C) : IsFiniteEtale S (pushout.inr f g) := sorry

/-! ### P0/lower-shriek-shriek-faithful-flatness -/

/-- Faithful flatness survives and is detected by lower shriek-shriek, GR Remark 3.1.3(ii). -/
theorem shriekShriek_faithfullyFlat_iff {A B : Algebra S} (f : A ⟶ B) :
    IsFaithfullyFlat S f ↔
      letI := ((shriekShriek S).map f).hom.toAlgebra
      _root_.Module.FaithfullyFlat ((shriekShriek S).obj A) ((shriekShriek S).obj B) := sorry

-- Check: shriekShriek_test_not_flat
example [IsDomain V] [ValuationRing V] (hV : ¬ (IsLocalRing.maximalIdeal V).FG) :
    let S := BasicSetup.ofValuationRing V hV
    let f := (toAlmost S).map (CommAlgCat.ofHom (AlgHom.fst V V V))
    IsFlat S f ∧
      (letI := ((shriekShriek S).map f).hom.toAlgebra
       ¬ _root_.Module.Flat ((shriekShriek S).obj ((toAlmost S).obj (CommAlgCat.of V (V × V))))
         ((shriekShriek S).obj ((toAlmost S).obj (CommAlgCat.of V V)))) := sorry

-- Check: algebraPredicates_test_identity
example (A : Algebra S) : IsFaithfullyFlat S (𝟙 A) ∧ IsAlmostProjective S (𝟙 A) ∧
    IsAlmostFinite S (𝟙 A) ∧ IsFiniteEtale S (𝟙 A) ∧ IsWeaklyEtale S (𝟙 A) := sorry
-- Check: algebraPredicates_test_zero
example (A : Algebra S) (f : A ⟶ (toAlmost S).obj (CommAlgCat.of V (V ⧸ (⊤ : Ideal V)))) :
    IsFlat S f ∧ IsAlmostProjective S f ∧ IsAlmostFinite S f ∧ IsFiniteEtale S f ∧
    IsWeaklyEtale S f ∧ (IsFaithfullyFlat S f ↔ IsZero A.X) := sorry
-- Check: algebraPredicates_test_dual_numbers
example : let f := (toAlmost (BasicSetup.classical ℚ)).map (CommAlgCat.ofHom (Algebra.ofId ℚ (TrivSqZeroExt ℚ ℚ)));
    IsFaithfullyFlat (BasicSetup.classical ℚ) f ∧ IsAlmostProjective (BasicSetup.classical ℚ) f ∧
    IsAlmostFinite (BasicSetup.classical ℚ) f ∧ ¬ IsUnramified (BasicSetup.classical ℚ) f ∧
    ¬ IsWeaklyUnramified (BasicSetup.classical ℚ) f ∧ ¬ IsFiniteEtale (BasicSetup.classical ℚ) f := sorry
