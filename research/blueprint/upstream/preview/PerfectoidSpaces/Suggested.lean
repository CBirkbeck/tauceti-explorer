/-- Inversion after taking almost elements, GR Corollary 5.2.15. -/
def invert (ε : V) (_hε : ε ∈ S.ideal) : Module S ⥤ ModuleCat.{u} (Localization.Away ε) :=
  Module.elements S ⋙ ModuleCat.extendScalars (algebraMap V (Localization.Away ε))

