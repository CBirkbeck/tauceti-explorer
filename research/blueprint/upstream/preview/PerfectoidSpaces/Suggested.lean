variable (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
  [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R]
/-! ### P1/perfectoid-almost-setup -/
/-- The almost ideal on any ring of integral elements is the inverse image of `R°°`. -/
def almostSetupPlus (P : Pair R) : Almost.BasicSetup P.plus where
  ideal := (almostSetup p R).ideal.comap
    (Subring.inclusion (show P.plus ≤ powerBoundedSubring R from by sorry))
  isIdempotentElem := sorry
  flat_tilde := sorry

theorem almostSetupPlus_mem (P : Pair R) (x : P.plus) :
    x ∈ (almostSetupPlus p R P).ideal ↔ IsTopologicallyNilpotent (x : R) := sorry

theorem almostSetup_ideal : (almostSetup p R).ideal = topologicallyNilpotentIdeal R := rfl

theorem isAlmostZero_iff_forall_pseudoUniformizer (M : Type*) [AddCommGroup M]
    [Module (powerBoundedSubring R) M] :
    (almostSetup p R).IsAlmostZero M ↔
      ∀ ϖ : powerBoundedSubring R, IsPseudoUniformizer (ϖ : R) → ∀ x : M, ϖ • x = 0 := sorry

theorem isAlmostZero_iff_forall_root (ϖ : PseudoUniformizerRoots p R)
    (M : Type*) [AddCommGroup M] [Module (powerBoundedSubring R) M] :
    (almostSetup p R).IsAlmostZero M ↔ ∀ n (x : M), ϖ.rootPB n • x = 0 := sorry

/-- Every topologically nilpotent scalar carries a power-bounded element into the plus ring. -/
theorem isAlmostZero_powerBounded_quotient_plus (P : Pair R)
    (ε : P.plus) (hε : ε ∈ (almostSetupPlus p R P).ideal)
    (x : powerBoundedSubring R) : (ε : R) * (x : R) ∈ P.plus := sorry

/-- Restriction from `R°` to `R⁺` induces the equivalence of almost categories. -/
def almostModuleEquivPlus (P : Pair R) :
    Almost.Module (almostSetup p R) ≌ Almost.Module (almostSetupPlus p R P) := sorry

theorem almostModuleEquivPlus_restrict (P : Pair R) :
    Nonempty (Almost.toAlmost (almostSetup p R) ⋙ (almostModuleEquivPlus p R P).functor ≅
      ModuleCat.restrictScalars (Subring.inclusion
        (show P.plus ≤ powerBoundedSubring R from by sorry)) ⋙
          Almost.toAlmost (almostSetupPlus p R P)) := sorry

-- Check: almostSetupPlus_zero; almostModuleEquivPlus_zero
example [Subsingleton R] (P : Pair R) (M : Almost.Module (almostSetup p R)) :
    (almostSetupPlus p R P).ideal = ⊥ ∧
      IsZero ((almostModuleEquivPlus p R P).functor.obj M) := sorry
-- Check: almostSetupPlus_full; almostModuleEquivPlus_full
example : (almostSetupPlus p R (Pair.powerBounded R)).ideal = (almostSetup p R).ideal ∧
    Nonempty ((almostModuleEquivPlus p R (Pair.powerBounded R)).functor ≅ 𝟭 _) := sorry
-- Check: almostSetupPlus_proper; almostModuleEquivPlus_proper; almostModuleEquivPlus_test
example (P : Pair R) (hP : P.plus < powerBoundedSubring R) :
    (∃ x : powerBoundedSubring R, (x : R) ∉ P.plus) ∧
      (∀ ε : P.plus, ε ∈ (almostSetupPlus p R P).ideal →
        ∀ x : powerBoundedSubring R, (ε : R) * (x : R) ∈ P.plus) ∧
      (almostModuleEquivPlus p R P).functor.IsEquivalence := sorry

/-! ### P3/almost-finite-etale-equivalence -/

/-- Sch12 7.9, p. 42, and change of basic setup: extension from R⁺ to R°.
The inverse is restriction, fixed on almost elements, scalars, and every arrow. -/
theorem almostFiniteEtale_equivPlus (P : Pair R) :
    ∃ E : Almost.Algebra.FiniteEtale (almostSetupPlus p R P)
        ((Almost.Algebra.toAlmost (almostSetupPlus p R P)).obj (CommAlgCat.of P.plus P.plus)) ≌
          AlmostFiniteEtale p R,
      ∃ e : ∀ A : AlmostFiniteEtale p R,
        (Almost.Algebra.elements (almostSetupPlus p R P)).obj (E.inverse.obj A).obj.right ≃+*
          (Almost.Algebra.elements (almostSetup p R)).obj A.obj.right,
        (∀ (A : AlmostFiniteEtale p R) (a : P.plus),
          e A (algebraMap P.plus _ a) = algebraMap (powerBoundedSubring R) _
            ⟨a.val, P.isRingOfIntegralElements.le_powerBoundedSubring a.property⟩) ∧
        (∀ {A B : AlmostFiniteEtale p R} (f : A ⟶ B)
          (x : (Almost.Algebra.elements (almostSetupPlus p R P)).obj (E.inverse.obj A).obj.right),
          e B (((Almost.Algebra.elements (almostSetupPlus p R P)).map
            (E.inverse.map f).hom.right).hom x) =
          ((Almost.Algebra.elements (almostSetup p R)).map f.hom.right).hom (e A x)) := sorry

/-- Sch12 diagram after 5.22, pp. 28–29, and 7.9, p. 42: reduction, sharp
transport, deformation, and inversion compose to the specified tilting equivalence.
The middle transport is fixed on rings of almost elements and on their scalar actions. -/
theorem finiteEtaleTiltEquiv_sixCategories
    (ϖ : PseudoUniformizerRoots p R) (ϖb : PseudoUniformizerRoots p (tilt p R))
    (hsharp : tilt.sharp (ϖb.root 0) = ϖ.root 0)
    (hdiv : (ϖ.rootPB 0) ^ p ∣ (p : powerBoundedSubring R)) :
    let V := powerBoundedSubring R
    let Vb := powerBoundedSubring (tilt p R)
    let SR := almostSetup p R
    let ST := almostSetup p (tilt p R)
    let QR := (Almost.Algebra.toAlmost SR).obj
      (CommAlgCat.of V (V ⧸ Ideal.span {ϖ.rootPB 0}))
    let QT := (Almost.Algebra.toAlmost ST).obj
      (CommAlgCat.of Vb (Vb ⧸ Ideal.span {ϖb.rootPB 0}))
    let redR := Almost.Algebra.finiteEtaleBaseChange SR
      ((Almost.Algebra.toAlmost SR).map
        (CommAlgCat.ofHom (Algebra.ofId V (V ⧸ Ideal.span {ϖ.rootPB 0}))))
    let redT := Almost.Algebra.finiteEtaleBaseChange ST
      ((Almost.Algebra.toAlmost ST).map
        (CommAlgCat.ofHom (Algebra.ofId Vb (Vb ⧸ Ideal.span {ϖb.rootPB 0}))))
    ∃ hR : redR.IsEquivalence, ∃ hT : redT.IsEquivalence,
      letI := hR
      letI := hT
      ∃ E : Almost.Algebra.FiniteEtale ST QT ≌ Almost.Algebra.FiniteEtale SR QR,
        ∃ e : ∀ A : Almost.Algebra.FiniteEtale ST QT,
          (Almost.Algebra.elements SR).obj (E.functor.obj A).obj.right ≃+*
            (Almost.Algebra.elements ST).obj A.obj.right,
          (∀ (A : Almost.Algebra.FiniteEtale ST QT) (x : Vb),
            e A (algebraMap V _ ⟨tilt.sharp x.val,
              (tilt.mem_powerBoundedSubring_iff_sharp p (R := R) x.val).mp x.property⟩) =
              algebraMap Vb _ x) ∧
          (∀ {A B : Almost.Algebra.FiniteEtale ST QT} (f : A ⟶ B)
            (x : (Almost.Algebra.elements SR).obj (E.functor.obj A).obj.right),
            e B (((Almost.Algebra.elements SR).map (E.functor.map f).hom.right).hom x) =
              ((Almost.Algebra.elements ST).map f.hom.right).hom (e A x)) ∧
          Nonempty ((almostInversion p R ϖ).asEquivalence.inverse ⋙ redR ⋙ E.inverse ⋙
            redT.asEquivalence.inverse ⋙ almostInversion p (tilt p R) ϖb ≅
              (finiteEtaleTiltEquiv p R).functor) := sorry

theorem almostSetup_ringEquiv (S : Type*) [CommRing S] [UniformSpace S]
    [IsUniformAddGroup S] [IsTopologicalRing S] [IsTateRing S] [CompleteSpace S] [T2Space S]
    [IsPerfectoidTateRing p S] (e : R ≃+* S) (he : Continuous e) (hi : Continuous e.symm) :
    ∃ e₀ : powerBoundedSubring R ≃+* powerBoundedSubring S,
      (∀ x, (e₀ x : S) = e (x : R)) ∧
        (almostSetup p R).ideal.map e₀.toRingHom = (almostSetup p S).ideal := sorry

omit [IsPerfectoidTateRing p R] in
-- Check: not_idempotent_padic
