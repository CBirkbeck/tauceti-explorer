    (x : space.obj X.obj) (y : space.obj Y.obj) (h : space.map f x = space.map g y) :
    ∃ z : underlyingPoints p (pullbackOverAnalytic p hZ f g),
      pointMap p (pullbackOverAnalytic.fst p hZ f g) z = x ∧
      pointMap p (pullbackOverAnalytic.snd p hZ f g) z = y := sorry

