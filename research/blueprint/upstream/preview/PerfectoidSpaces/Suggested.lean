namespace Module

/-- Evaluation with the module before its dual. -/
def dualPairing (P : Module S) : P ⊗ dual S P ⟶ 𝟙_ (Module S) :=
  (β_ P (dual S P)).hom ≫ evaluation S P _

/-! ### P0/rank-decomposition-of-finite-projective -/

/-- Rank factors as orthogonal idempotent summands of the tensor unit.
The top exterior power on each summand is invertible, GR Proposition 4.3.27. -/
structure RankDecomposition (P : Module S) (r : ℕ) where
  projector : Fin r → (𝟙_ (Module S) ⟶ 𝟙_ (Module S))
  idempotent : ∀ i, projector i ≫ projector i = projector i
  orthogonal : ∀ i j, i ≠ j → projector i ≫ projector j = 0
  total : ∑ i, projector i = 𝟙 _
  vanish : ∀ i, IsZero (exteriorPower S (i.val + 1) P ⊗ image (projector i))
  invertible : ∀ i, IsIso
    ((dualPairing S (exteriorPower S i.val P) ▷ image (projector i)) ≫
      (λ_ (image (projector i))).hom)

/-- Rank decomposition of an almost finite projective module with vanishing exterior power,
GR §4.3, Proposition 4.3.27, with the finiteness hypothesis of Definition 4.3.9. -/
def rankDecomposition (P : Module S) (r : ℕ) (hP : AlmostFiniteProjective S P)
    (hr : IsZero (exteriorPower S r P)) : RankDecomposition S P r := sorry

/-- Uniqueness is equality of the orthogonal idempotents. -/
theorem rankDecomposition_unique (P : Module S) (r : ℕ)
    (D E : RankDecomposition S P r) : D.projector = E.projector := sorry

local instance : HasFiniteBiproducts (Module S) := Abelian.hasFiniteBiproducts

/-- The orthogonal factors really decompose the base, not just its underlying set. -/
def RankDecomposition.unitIso {P : Module S} {r : ℕ} (D : RankDecomposition S P r) :
    𝟙_ (Module S) ≅ ⨁ (fun i : Fin r => image (D.projector i)) := sorry

