example (K : AffinoidField p) : IsIso (residueFieldPoint p (ofPair p (K.toPairCat p))
    ((spaSpaceEquiv p (K.toPairCat p)).symm (ULift.up (K.closedPoint p)))) := sorry
-- Check: residueFieldPoint_rankOne_range
example (X : Perfd p) (x : (underlyingPoints p) X) (hx : ∀ y : (underlyingPoints p) X, y ⤳ x → y = x) :
    Set.range ((pointMap p) (residueFieldPoint p X x)) = {x} := sorry
-- Check: residueFieldPoint_nonlocallyclosed
example (X : Perfd p) (x : (underlyingPoints p) X) (hx : ∀ y : (underlyingPoints p) X, y ⤳ x → y = x)
    (hn : ¬ IsLocallyClosed ({x} : Set ((underlyingPoints p) X))) :
    ¬ IsImmersion p (residueFieldPoint p X x) := sorry

/-! ### P4/zariski-closed-immersion -/

/-- A zero locus consists of valuation points whose support contains the ideal. -/
def zeroLocus (R : PairCat.{0} p) (I : Ideal R) : Set ((underlyingPoints p) (ofPair p R)) :=
  {x | I ≤ ((spaSpaceEquiv p R x).down.val).supp}

def IsZariskiClosed (R : PairCat.{0} p) (Z : Set ((underlyingPoints p) (ofPair p R))) : Prop :=
  ∃ I : Ideal R, Z = zeroLocus p R I

def IsZariskiClosedImmersion (R : PairCat.{0} p) {Y : Perfd p}
    (f : Y ⟶ ofPair p R) : Prop :=
  IsClosedImmersion p f ∧ IsZariskiClosed p R (Set.range ((pointMap p) f))

/-! ### P4/strongly-zariski-closed-immersion -/

def IsStronglyZariskiClosed (R : PairCat.{0} p) {Y : Perfd p}
    (f : Y ⟶ ofPair p R) : Prop :=
  ∃ (S : PairCat.{0} p) (e : Y ≅ ofPair p S) (a : R ⟶ S),
    e.hom ≫ (spaFunctor p).map a.op = f ∧ IsStronglyZariskiClosed_affinoid a

theorem isClosed_zeroLocus (R : PairCat.{0} p) (I : Ideal R) :
    IsClosed (zeroLocus p R I) := sorry
 theorem zeroLocus_sup (R : PairCat.{0} p) (I J : Ideal R) :
    zeroLocus p R (I ⊔ J) = zeroLocus p R I ∩ zeroLocus p R J := sorry
 theorem zeroLocus_mul (R : PairCat.{0} p) (I J : Ideal R) :
    zeroLocus p R (I * J) = zeroLocus p R I ∪ zeroLocus p R J := sorry
 theorem zeroLocus_inf (R : PairCat.{0} p) (I J : Ideal R) :
    zeroLocus p R (I ⊓ J) = zeroLocus p R I ∪ zeroLocus p R J := sorry
 theorem zeroLocus_closure (R : PairCat.{0} p) (I : Ideal R) :
    zeroLocus p R I.closure = zeroLocus p R I := sorry
 theorem zeroLocus_radical (R : PairCat.{0} p) (I : Ideal R) :
    zeroLocus p R I.radical = zeroLocus p R I := sorry
 theorem zeroLocus_eq_iInter_rational (R : PairCat.{0} p) (I : Ideal R) :
    zeroLocus p R I = {x | ∀ a ∈ I,
      ((spaSpaceEquiv p R x).down.val).toValuativeRel.vle a 1} := sorry
 theorem stableUnderGeneralization_zeroLocus (R : PairCat.{0} p) (I : Ideal R)
    (x y : (underlyingPoints p) (ofPair p R)) (hx : x ∈ zeroLocus p R I) (h : y ⤳ x) :
    y ∈ zeroLocus p R I := sorry

theorem stronglyZariskiClosed_iff_zariskiClosed (R : PairCat.{0} p) {Y : Perfd p}
    (f : Y ⟶ ofPair p R) :
    IsStronglyZariskiClosed p R f ↔ IsZariskiClosedImmersion p R f := sorry

/-! ### P4/zariski-closed-is-strongly-zariski-closed -/

/-- ECD Theorem 5.8, p. 25: a Zariski closed immersion into an affinoid is strongly Zariski closed. -/
theorem zariskiClosed_isStronglyZariskiClosed (R : PairCat.{0} p) {Y : Perfd p}
    (f : Y ⟶ ofPair p R) (hf : IsZariskiClosedImmersion p R f) :
    IsStronglyZariskiClosed p R f :=
  (stronglyZariskiClosed_iff_zariskiClosed p R f).2 hf

/-! ### P4/strongly-zariski-closed-is-zariski-closed -/

/-- ECD following Definition 5.7, p. 24: a surjective perfectoid quotient is Zariski closed. -/
theorem stronglyZariskiClosed_isZariskiClosed (R : PairCat.{0} p) {Y : Perfd p}
    (f : Y ⟶ ofPair p R) (hf : IsStronglyZariskiClosed p R f) :
    IsZariskiClosedImmersion p R f :=
  (stronglyZariskiClosed_iff_zariskiClosed p R f).1 hf

theorem stronglyZariskiClosed_affinoid_iff {R S : PairCat.{0} p} (a : R ⟶ S) :
    IsStronglyZariskiClosed p R ((spaFunctor p).map a.op) ↔
      IsStronglyZariskiClosed_affinoid a := sorry

theorem stronglyZariskiClosed_isClosed_ker {R S : PairCat.{0} p} (a : R ⟶ S)
    (ha : IsStronglyZariskiClosed_affinoid a) : IsClosed (RingHom.ker a.toRingHom : Set R) := sorry

/-! ### P4/universal-perfectoid-zariski-closed -/

/-- The universal perfectoid quotient; its universal property fixes its ring and plus ring. -/
def zariskiClosedPair (R : PairCat.{0} p) (I : Ideal R) : PairCat.{0} p := sorry
 def zariskiClosedMap (R : PairCat.{0} p) (I : Ideal R) : R ⟶ zariskiClosedPair p R I := sorry
 def zariskiClosedSubspace (R : PairCat.{0} p) (I : Ideal R) : Perfd p :=
  ofPair p (zariskiClosedPair p R I)
 def zariskiClosedSubspace.ι (R : PairCat.{0} p) (I : Ideal R) :
    zariskiClosedSubspace p R I ⟶ ofPair p R := (spaFunctor p).map (zariskiClosedMap p R I).op

 theorem zariskiClosedPair_universal (R : PairCat.{0} p) (I : Ideal R)
    (S : PairCat.{0} p) (f : R ⟶ S) :
    I ≤ RingHom.ker f.toRingHom ↔ ∃! g : zariskiClosedPair p R I ⟶ S,
      zariskiClosedMap p R I ≫ g = f := sorry
 theorem zariskiClosedSubspace.range_ι (R : PairCat.{0} p) (I : Ideal R) :
    Topology.IsEmbedding ((pointMap p) (zariskiClosedSubspace.ι p R I)) ∧
      Set.range ((pointMap p) (zariskiClosedSubspace.ι p R I)) = zeroLocus p R I := sorry
 theorem zariskiClosedSubspace.lift (R : PairCat.{0} p) (I : Ideal R)
    (Y : Perfd p) (f : Y ⟶ ofPair p R) (h : Set.range ((pointMap p) f) ⊆ zeroLocus p R I) :
    ∃! g : Y ⟶ zariskiClosedSubspace p R I, g ≫ zariskiClosedSubspace.ι p R I = f := sorry
 theorem zariskiClosedSubspace.isZariskiClosedImmersion (R : PairCat.{0} p) (I : Ideal R) :
    IsZariskiClosedImmersion p R (zariskiClosedSubspace.ι p R I) := sorry
 theorem zariskiClosedSubspace.surjective (R : PairCat.{0} p) (I : Ideal R) :
    IsStronglyZariskiClosed_affinoid (zariskiClosedMap p R I) := sorry
 theorem zariskiClosedSubspace.denseRange (R : PairCat.{0} p) (I : Ideal R) :
    DenseRange (zariskiClosedMap p R I).toRingHom := sorry
 theorem zariskiClosedSubspace.ker_eq (R : PairCat.{0} p) (I : Ideal R) (a : R) :
    a ∈ RingHom.ker (zariskiClosedMap p R I).toRingHom ↔
      ∀ x ∈ zeroLocus p R I, a ∈ ((spaSpaceEquiv p R x).down.val).supp := sorry
 theorem zariskiClosedSubspace.congr (R : PairCat.{0} p) (I J : Ideal R)
    (h : zeroLocus p R I = zeroLocus p R J) :
    ∃! e : zariskiClosedSubspace p R I ≅ zariskiClosedSubspace p R J,
      e.hom ≫ zariskiClosedSubspace.ι p R J = zariskiClosedSubspace.ι p R I := sorry
/-! ### P4/zariski-closed-immersion-is-universal -/

 theorem zariskiClosedSubspace.universal (R : PairCat.{0} p) (I : Ideal R)
    {Y : Perfd p} (f : Y ⟶ ofPair p R) (hf : IsClosedImmersion p f)
    (hr : Set.range ((pointMap p) f) = zeroLocus p R I) :
    ∃! e : Y ≅ zariskiClosedSubspace p R I, e.hom ≫ zariskiClosedSubspace.ι p R I = f := sorry
/-! ### P4/zariski-closed-base-change -/

 theorem zariskiClosedSubspace.baseChange {R S : PairCat.{0} p} (f : R ⟶ S) (I : Ideal R) :
    ∃ e : pullback (zariskiClosedSubspace.ι p R I) ((spaFunctor p).map f.op) ≅
      zariskiClosedSubspace p S (I.map f.toRingHom),
      e.hom ≫ zariskiClosedSubspace.ι p S (I.map f.toRingHom) =
        pullback.snd (zariskiClosedSubspace.ι p R I) ((spaFunctor p).map f.op) := sorry

