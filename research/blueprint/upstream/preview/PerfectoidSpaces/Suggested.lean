    (hκ₁ : Cardinal.aleph.{0} 1 < κ) (hL : #L < κ)
    (J : (Cardinal.aleph.{0} 1).ord.ToType → Type)
    (hJ : ∀ i, ℵ₀ ≤ #(J i) ∧ #(J i) < κ)
    (hcofinal : ∀ μ < κ, ∃ i, μ < #(J i)) :
    ∃ π : ∀ i, PseudoUniformizerRoots p (gaussPerfectoidField p L (J i)).field,
      ¬ IsKappaSmall p (Cardinal.lift.{1} κ)
        (∐ fun i ↦ ofPair p (discPair p (gaussPerfectoidField p L (J i)).field (π i))) := by
  obtain ⟨π, _, _, _, _, h⟩ :=
    not_isKappaSmall_gaussDisc_sigma p L hκ hcf hκ₁ hL J hJ hcofinal
  exact ⟨π, h⟩

/-- The self-fibre product of a small union of Gauss field points can have at least κ points.
This tests the finite-product claim in ECD Proposition 4.4, p. 20. -/
theorem not_isKappaSmall_gaussField_fibreProduct
    (L : AffinoidField p) [CharP L p] {κ : Cardinal.{0}}
    (hκ : κ.IsStrongLimit) (hcf : κ.ord.cof = Cardinal.aleph.{0} 1)
    (hκ₁ : Cardinal.aleph.{0} 1 < κ) (hL : #L < κ)
    (J : (Cardinal.aleph.{0} 1).ord.ToType → Type)
    (hJ : ∀ i, ℵ₀ ≤ #(J i) ∧ #(J i) < κ)
    (hcofinal : ∀ μ < κ, ∃ i, μ < #(J i)) :
    let B := (AffinoidField.ofRankOne p L).toPairCat p
    let K := fun i ↦ gaussPerfectoidField p L (J i)
    ∃ s : ∀ i, B ⟶ (K i).field.toPairCat p,
      (∀ i, (s i).toRingHom = (K i).scalar) ∧
      let X := ∐ fun i ↦ ofPair p ((K i).field.toPairCat p)
      let f : X ⟶ ofPair p B := Sigma.desc (fun i ↦ (spaFunctor p).map (s i).op)
      IsKappaSmall p (Cardinal.lift.{1} κ) X ∧
      Cardinal.lift.{1} κ ≤ #(underlyingPoints p (pullback f f)) ∧
      ¬ IsKappaSmall p (Cardinal.lift.{1} κ) (pullback f f) := sorry

-- Check: not_isKappaSmall_gaussField_fibreProduct
example (L : AffinoidField p) [CharP L p] {κ : Cardinal.{0}}
    (hκ : κ.IsStrongLimit) (hcf : κ.ord.cof = Cardinal.aleph.{0} 1)
    (hκ₁ : Cardinal.aleph.{0} 1 < κ) (hL : #L < κ)
    (J : (Cardinal.aleph.{0} 1).ord.ToType → Type)
    (hJ : ∀ i, ℵ₀ ≤ #(J i) ∧ #(J i) < κ)
    (hcofinal : ∀ μ < κ, ∃ i, μ < #(J i)) :
    let X := ∐ fun i ↦ ofPair p ((gaussPerfectoidField p L (J i)).field.toPairCat p)
    ∃ f : X ⟶ ofPair p ((AffinoidField.ofRankOne p L).toPairCat p),
      IsKappaSmall p (Cardinal.lift.{1} κ) X ∧
      ¬ IsKappaSmall p (Cardinal.lift.{1} κ) (pullback f f) := by
  obtain ⟨s, _, hX, _, h⟩ :=
    not_isKappaSmall_gaussField_fibreProduct p L hκ hcf hκ₁ hL J hJ hcofinal
  exact ⟨Sigma.desc (fun i ↦ (spaFunctor p).map (s i).op), hX, h⟩

/-- Nested variable sets give an ω₁-chain of Gauss fields with small stages and a large limit.
ECD Proposition 6.4, p. 27, requires a common bound on the stages. -/
theorem not_isKappaSmall_gaussField_cofilteredLimit
    (L : AffinoidField p) [CharP L p] {κ : Cardinal.{0}}
    (hκ : κ.IsStrongLimit) (hcf : κ.ord.cof = Cardinal.aleph.{0} 1)
    (hκ₁ : Cardinal.aleph.{0} 1 < κ) (hL : #L < κ)
    {V : Type} (S : (Cardinal.aleph.{0} 1).ord.ToType → Set V) (hS : Monotone S)
    (hcard : ∀ i, ℵ₀ ≤ #(S i) ∧ #(S i) < κ)
    (hcofinal : ∀ μ < κ, ∃ i, μ < #(S i)) :
    let I := (Cardinal.aleph.{0} 1).ord.ToType
    let K := fun i ↦ gaussPerfectoidField p L (S i)
    ∃ (D : I ⥤ PairCat.{0} p) (e : ∀ i, D.obj i ≅ (K i).field.toPairCat p),
      (∀ (i j : I) (a : i ⟶ j),
        let f := (e i).inv ≫ D.map a ≫ (e j).hom
        (∀ c : L, f.toRingHom ((K i).scalar c) = (K j).scalar c) ∧
        (∀ (v : S i) (n : ℕ), f.toRingHom ((K i).root v n) =
          (K j).root ⟨v.val, hS (leOfHom a) v.property⟩ n)) ∧
      ∃ hI : IsCofiltered Iᵒᵖ,
        letI := hI
        ∃ hD : ∀ i, IsAffinoidPerfectoid p ((D.op ⋙ spaFunctor p).obj i).obj,
        Cardinal.lift.{1} #(Σ i : Iᵒᵖ, Σ j : Iᵒᵖ, (i ⟶ j)) < Cardinal.lift.{1} κ ∧
        (∀ i, IsKappaSmall p (Cardinal.lift.{1} κ) ((D.op ⋙ spaFunctor p).obj i)) ∧
        Cardinal.lift.{1} κ ≤
          #(globalSections p (cofilteredLimit p (D.op ⋙ spaFunctor p) hD)) ∧
        ¬ IsKappaSmall p (Cardinal.lift.{1} κ)
          (cofilteredLimit p (D.op ⋙ spaFunctor p) hD) := sorry

-- Check: not_isKappaSmall_gaussField_cofilteredLimit
example (L : AffinoidField p) [CharP L p] {κ : Cardinal.{0}}
    (hκ : κ.IsStrongLimit) (hcf : κ.ord.cof = Cardinal.aleph.{0} 1)
    (hκ₁ : Cardinal.aleph.{0} 1 < κ) (hL : #L < κ)
    {V : Type} (S : (Cardinal.aleph.{0} 1).ord.ToType → Set V) (hS : Monotone S)
    (hcard : ∀ i, ℵ₀ ≤ #(S i) ∧ #(S i) < κ)
    (hcofinal : ∀ μ < κ, ∃ i, μ < #(S i)) :
    ∃ (D : (Cardinal.aleph.{0} 1).ord.ToType ⥤ PairCat.{0} p)
      (hI : IsCofiltered ((Cardinal.aleph.{0} 1).ord.ToType)ᵒᵖ),
      letI := hI
      ∃ hD : ∀ i, IsAffinoidPerfectoid p ((D.op ⋙ spaFunctor p).obj i).obj,
      (∀ i, IsKappaSmall p (Cardinal.lift.{1} κ) ((D.op ⋙ spaFunctor p).obj i)) ∧
      ¬ IsKappaSmall p (Cardinal.lift.{1} κ)
        (cofilteredLimit p (D.op ⋙ spaFunctor p) hD) := by
  obtain ⟨D, _, _, hI, hD, _, hsmall, _, hlarge⟩ :=
    not_isKappaSmall_gaussField_cofilteredLimit p L hκ hcf hκ₁ hL S hS hcard hcofinal
  exact ⟨D, hI, hD, hsmall, hlarge⟩

/-- The section at a point of S is fixed by the two coordinates of the product. -/
def prodProfinite.pointSection (X : Perfd p) (S : Profinite.{0}) (s : S) :
    X ⟶ prodProfinite p X S :=
  (prodLocallyProfinite.homEquiv p X S X).symm (𝟙 X, ContinuousMap.const _ s)

