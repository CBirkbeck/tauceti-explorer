    (a : (elements S).obj A) :
    ((invert S ε hε).map f).hom
      (show (invert S ε hε).obj A from algebraMap ((elements S).obj A)
        (Localization.Away (algebraMap V ((elements S).obj A) ε)) a) =
      (show (invert S ε hε).obj B from algebraMap ((elements S).obj B)
        (Localization.Away (algebraMap V ((elements S).obj B) ε)) (((elements S).map f).hom a)) := sorry
-- Check: invert_zero
