/-- The comparison between the two adjoints is multiplication by the tensor ideal. -/
def shriekToElements : shriek S ⟶ elements S :=
  (shriekIsoTensor S).hom ≫
    { app := fun M ↦ ModuleCat.ofHom (S.tildeAct ((elements S).obj M))
      naturality := by intros; sorry }

/-- On evaluated pure tensors the comparison is scalar multiplication by the tensor ideal,
GR (2.2.9), (2.2.20). -/
theorem shriekToElements_apply (M : Module S) (t : S.tilde)
    (f : ModuleCat.of V S.tilde ⟶ (shriek S).obj M) :
    (shriekToElements S).app M (f t) = S.tildeMul t • f := by
  rw [← shriekIsoTensor_inv_apply S M t f]
  change S.tildeAct ((elements S).obj M)
    (((shriekIsoTensor S).inv.app M ≫ (shriekIsoTensor S).hom.app M) (t ⊗ₜ[V] f)) = _
  rw [Iso.inv_hom_id_app]
  rfl

