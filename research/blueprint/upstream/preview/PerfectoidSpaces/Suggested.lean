variable (C : RankTwoGeometricPoint p)

def generizationPairMap : C.field.toPairCat p ⟶
    (AffinoidField.ofRankOne p C.field).toPairCat p :=
  ⟨RingHom.id _, continuous_id, C.field.integral.le_powerBoundedSubring⟩

theorem generization_rational : ∃ U : RationalOpen p (C.field.toPairCat p),
    ∃ e : rationalPair p (C.field.toPairCat p) U ≅
      (AffinoidField.ofRankOne p C.field).toPairCat p,
      rationalMap p (C.field.toPairCat p) U ≫ e.hom = C.generizationPairMap p := sorry
end RankTwoGeometricPoint

