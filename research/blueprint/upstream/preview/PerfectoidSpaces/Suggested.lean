/-- ECD proof of Lemma 11.4, p. 55: arbitrary analytic bases use uniform tensor charts.
The cone is universal against every perfectoid test space. -/
theorem pullback_over_analytic (Z : YAdic) (hZ : YonedaAdicSpace.IsAnalytic Z)
    (X Y : Perfd p) (f : X.obj ⟶ Z) (g : Y.obj ⟶ Z) :
    ∃ (W : Perfd p) (a : W.obj ⟶ X.obj) (b : W.obj ⟶ Y.obj)
      (h : a ≫ f = b ≫ g), ∀ (T : Perfd p) (u : T.obj ⟶ X.obj) (v : T.obj ⟶ Y.obj),
      u ≫ f = v ≫ g → ∃! w : T.obj ⟶ W.obj, w ≫ a = u ∧ w ≫ b = v := sorry

/-- Affinoid factors over an analytic affinoid base have an affinoid perfectoid pullback. -/
theorem pullbackOverAnalytic.isAffinoidPerfectoid (A : CAff) [IsTateRing A.A]
    (R S : PairCat.{0} p) (f : (ofPair p R).obj ⟶ YonedaAdicSpace.ofSpaY A)
    (g : (ofPair p S).obj ⟶ YonedaAdicSpace.ofSpaY A) :
    ∃ (T : PairCat.{0} p) (a : (ofPair p T).obj ⟶ (ofPair p R).obj)
      (b : (ofPair p T).obj ⟶ (ofPair p S).obj),
      a ≫ f = b ≫ g ∧ ∀ (W : Perfd p) (u : W.obj ⟶ (ofPair p R).obj)
        (v : W.obj ⟶ (ofPair p S).obj), u ≫ f = v ≫ g →
        ∃! w : W.obj ⟶ (ofPair p T).obj, w ≫ a = u ∧ w ≫ b = v := sorry

/-- The inclusion into adic spaces preserves the actual pullback square. -/
