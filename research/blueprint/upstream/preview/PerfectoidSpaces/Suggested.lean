/-! ### Layer 2: The field-based convention -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
open TauCeti Huber Perfectoid CategoryTheory TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]
variable (K : Type) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  [IsPerfectoidField p K]

/-! ### P2/perfectoid-spaces-over-a-perfectoid-field-comparison -/

/-- Wedhorn Remark 7.15(2), p. 60: the integral closure of the prime subring together
with the topologically nilpotent elements. No maximal-plus convention is imposed. -/
def fieldMinimalPlus : Subring K :=
  (integralClosure (Subring.closure {x : K | IsTopologicallyNilpotent x}) K).toSubring

def fieldBasePair : PairCat.{0} p :=
  { carrier := K, pair := { plus := fieldMinimalPlus K, isRingOfIntegralElements := by sorry } }

/-! ### P1/continuous-valuations-under-tilting -/

/-- For a complete ultrametric perfectoid field, tilting identifies continuous valuations
of every rank up to equivalence. The minimal-plus pair imposes no further boundedness
condition, and the forward map pulls valuations back along sharp
(Sch12 Proposition 3.6, p. 17, and Corollary 6.7(iii), pp. 34–35). -/
theorem continuousValuations_tilt :
    ∃ e : ValuationSpectrum.spa (fieldMinimalPlus K) ≃ₜ
      ValuationSpectrum.spa (Pair.tilt p (fieldBasePair p K).pair).plus,
      ⇑e = spaTilt p (fieldBasePair p K).pair :=
  ⟨spaTiltHomeomorph p (fieldBasePair p K).pair,
    coe_spaTiltHomeomorph p (fieldBasePair p K).pair⟩

/-- Scholze's continuous K-algebra convention on all affinoid charts. The product
subspace topology on compatible sections makes continuity equivalent to chartwise continuity. -/
structure FieldSpace where
  space : Perfd p
  scalar : K →+* globalSections p space
  continuous_scalar : Continuous scalar

namespace FieldSpace
structure Hom (X Y : FieldSpace p K) where
  map : X.space ⟶ Y.space
  scalar_eq : (globalPullback p map).comp Y.scalar = X.scalar

instance : Category (FieldSpace p K) where
  Hom X Y := Hom p K X Y
  id X := ⟨𝟙 _, by sorry⟩
  comp f g := ⟨f.map ≫ g.map, by sorry⟩
  id_comp := by sorry
  comp_id := by sorry
  assoc := by sorry
end FieldSpace

/-- Sch12 Definitions 2.6(ii), 6.15, and Wedhorn Proposition 8.25: the scalar convention
is represented by the minimal-plus base, not necessarily by the maximal-plus base. -/
def fieldSpaceEquivalence : FieldSpace p K ≌ Over (ofPair p (fieldBasePair p K)) := sorry

theorem fieldSpaceEquivalence_space (X : FieldSpace p K) :
    ((fieldSpaceEquivalence p K).functor.obj X).left = X.space := sorry

/-- The base arrow recovers exactly the specified K-action on compatible sections. -/
theorem fieldSpaceEquivalence_scalar (X : FieldSpace p K) :
    ∃ e : ((fieldSpaceEquivalence p K).functor.obj X).left ≅ X.space,
      (globalPullback p e.inv).comp
        ((globalPullback p ((fieldSpaceEquivalence p K).functor.obj X).hom).comp
          (globalSectionsAffinoidEquiv p (fieldBasePair p K)).symm.toRingHom) = X.scalar := sorry

/-- Factoring the scalar map through a maximal-plus base is the additional integral condition. -/
theorem fieldSpace_maximalPlus_criterion (X : FieldSpace p K) :
    (∀ a ∈ powerBoundedSubring K, X.scalar a ∈ globalPlus p X.space) ↔
    ∃ f : X.space ⟶ ofPair p ({ carrier := K, pair := Pair.powerBounded K } : PairCat.{0} p),
      (globalPullback p f).comp
        (globalSectionsAffinoidEquiv p ({ carrier := K, pair := Pair.powerBounded K } : PairCat.{0} p)).symm.toRingHom =
          X.scalar := sorry

-- Check: field_minimal_topologically_nilpotent
example (a : K) (ha : IsTopologicallyNilpotent a) : a ∈ fieldMinimalPlus K := sorry
-- Check: field_minimal_inverse_parameter
example (ϖ : PseudoUniformizerRoots p K) : (ϖ.zpow (-1) 0 : K) ∉ fieldMinimalPlus K := sorry
-- Check: field_minimal_cyclotomic
example : fieldMinimalPlus (padicCyclotomic p) = powerBoundedSubring (padicCyclotomic p) := sorry
-- Check: field_minimal_cp
example : fieldMinimalPlus ℂ_[p] = powerBoundedSubring ℂ_[p] := sorry
-- Check: field_category_empty
example (X : FieldSpace p K) [IsEmpty (YonedaAdicSpace.space.obj X.space.obj)] :
    IsEmpty (YonedaAdicSpace.space.obj ((fieldSpaceEquivalence p K).functor.obj X).left.obj) := sorry
-- Check: field_category_scalar_two_terms
example (X : FieldSpace p K) (a b : K) : X.scalar (a + b) = X.scalar a + X.scalar b :=
  X.scalar.map_add a b
-- Check: field_category_recovers_object
example (X : FieldSpace p K) : Nonempty
    ((fieldSpaceEquivalence p K).inverse.obj ((fieldSpaceEquivalence p K).functor.obj X) ≅ X) :=
  ⟨((fieldSpaceEquivalence p K).unitIso.app X).symm⟩
end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
end

/-! ### Layer 2: Absolute-product charts -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
open TauCeti Huber Perfectoid CategoryTheory CategoryTheory.Limits TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime] (A B : PairCat.{0} p)
  (ϖ : PseudoUniformizerRoots p A) (ψ : PseudoUniformizerRoots p B)

/-- The representing pair for two maps with the two bounding ratios integral.
This is Berkeley 8.3.5's annular chart, with both ratios included in the plus ring.
The universal property tests all complete Tate pairs, not only perfectoid targets. -/
structure ProductChart (m n : ℕ) where
  ring : PairCat.{0} p
  left : A ⟶ ring
  right : B ⟶ ring
  p_zero : (p : ring) = 0
  left_bound : left.toRingHom (ϖ.root 0) ^ m * Ring.inverse (right.toRingHom (ψ.root 0)) ∈ ring.pair.plus
  right_bound : right.toRingHom (ψ.root 0) ^ n * Ring.inverse (left.toRingHom (ϖ.root 0)) ∈ ring.pair.plus
  universal : ∀ (S : CAff) (_ : IsTateRing S.A) (f : Pair.Hom A.pair S.P) (g : Pair.Hom B.pair S.P),
    (f.toRingHom (ϖ.root 0) ^ m * Ring.inverse (g.toRingHom (ψ.root 0)) ∈ S.P.plus ∧
      g.toRingHom (ψ.root 0) ^ n * Ring.inverse (f.toRingHom (ϖ.root 0)) ∈ S.P.plus) ↔
      ∃! h : Pair.Hom ring.pair S.P, h.comp left = f ∧ h.comp right = g

/-- Complete the tensor chart of Berkeley 8.3.5, pp. 61–62. Zero exponents give the
empty chart; positive exponents are the charts used in the product covering. -/
def prodChart (hA : (p : A) = 0) (hB : (p : B) = 0) (m n : ℕ) : ProductChart p A B ϖ ψ m n := sorry

open scoped Classical in
/-- Berkeley Lemma 8.3.5, proof, printed pp. 61–62: increasing the exponents
enlarges the chart. The reverse ring map fixes both factors and localizes at the
two smaller-exponent ratios, with denominator one. -/
theorem prodChart_isRationalSubset (hA : (p : A) = 0) (hB : (p : B) = 0)
    (m n m' n' : ℕ) (hm : m ≤ m') (hn : n ≤ n') :
    let C := prodChart p A B ϖ ψ hA hB m n
    let D := prodChart p A B ϖ ψ hA hB m' n'
    let u := D.left.toRingHom (ϖ.root 0) ^ m * Ring.inverse (D.right.toRingHom (ψ.root 0))
    let v := D.right.toRingHom (ψ.root 0) ^ n * Ring.inverse (D.left.toRingHom (ϖ.root 0))
    ∃ f : D.ring ⟶ C.ring,
      D.left ≫ f = C.left ∧ D.right ≫ f = C.right ∧
      CAff.IsRationalLocalization (CAff.ofHom f) {1, u, v} 1 ∧
      Topology.IsOpenEmbedding f.spaComap ∧
      Set.range f.spaComap =
        {x | x.val.valuation u ≤ 1 ∧ x.val.valuation v ≤ 1} := sorry

-- Check: product_chart_zero_exponent
example (hA : (p : A) = 0) (hB : (p : B) = 0) (n : ℕ) :
    Subsingleton (prodChart p A B ϖ ψ hA hB 0 n).ring := sorry
-- Check: product_chart_empty_factor
example (hA : (p : A) = 0) (hB : (p : B) = 0) [Subsingleton A] (m n : ℕ) :
    Subsingleton (prodChart p A B ϖ ψ hA hB m n).ring := sorry
-- Check: product_chart_diagonal
example (hA : (p : A) = 0) :
    ∃ f : (prodChart p A A ϖ ϖ hA hA 1 1).ring ⟶ A,
      (prodChart p A A ϖ ϖ hA hA 1 1).left ≫ f = 𝟙 A ∧
      (prodChart p A A ϖ ϖ hA hA 1 1).right ≫ f = 𝟙 A := sorry
-- Check: product_chart_diagonal_ratios
example (hA : (p : A) = 0) (f : (prodChart p A A ϖ ϖ hA hA 1 1).ring ⟶ A)
    (hleft : (prodChart p A A ϖ ϖ hA hA 1 1).left ≫ f = 𝟙 A)
    (hright : (prodChart p A A ϖ ϖ hA hA 1 1).right ≫ f = 𝟙 A) :
    f.toRingHom ((prodChart p A A ϖ ϖ hA hA 1 1).left.toRingHom (ϖ.root 0) *
      Ring.inverse ((prodChart p A A ϖ ϖ hA hA 1 1).right.toRingHom (ϖ.root 0))) = 1 := sorry

/-- The characteristic-p affinoid object, including the empty spectrum. -/
def charPOfPair (R : PairCat.{0} p) (hR : (p : R) = 0) : Perf p := ⟨ofPair p R, by sorry⟩

def prodChartMap (hA : (p : A) = 0) (hB : (p : B) = 0) (m n : ℕ) :
    ofPair p (prodChart p A B ϖ ψ hA hB m n).ring ⟶
      (Limits.prod (charPOfPair p A hA) (charPOfPair p B hB)).obj := sorry

theorem prodChartMap_projections (hA : (p : A) = 0) (hB : (p : B) = 0) (m n : ℕ) :
    prodChartMap p A B ϖ ψ hA hB m n ≫ (Limits.prod.fst (X := charPOfPair p A hA) (Y := charPOfPair p B hB)).hom =
      (spaFunctor p).map (prodChart p A B ϖ ψ hA hB m n).left.op ∧
    prodChartMap p A B ϖ ψ hA hB m n ≫ (Limits.prod.snd (X := charPOfPair p A hA) (Y := charPOfPair p B hB)).hom =
      (spaFunctor p).map (prodChart p A B ϖ ψ hA hB m n).right.op := sorry

theorem prodChartMap_open (hA : (p : A) = 0) (hB : (p : B) = 0) (m n : ℕ) :
    YonedaAdicSpace.IsOpenImmersion (prodChartMap p A B ϖ ψ hA hB m n).hom.hom := sorry

theorem prodChartMap_cover (hA : (p : A) = 0) (hB : (p : B) = 0)
    (x : YonedaAdicSpace.space.obj (Limits.prod (charPOfPair p A hA) (charPOfPair p B hB)).obj.obj) :
    ∃ m n : ℕ, 0 < m ∧ 0 < n ∧
      x ∈ Set.range (YonedaAdicSpace.space.map (prodChartMap p A B ϖ ψ hA hB m n).hom) := sorry

theorem perf_no_terminal : ¬ HasTerminal (Perf p) := sorry
end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
end

/-! ### Layer 2: Rational equivalence and global affine mapping property -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open CategoryTheory TauCeti Huber
variable (p : ℕ) [Fact p.Prime] (R : PairCat.{0} p)
/-- ECD 3.12 and 3.18: the equivalence of rational-open posets, with their actual inclusions. -/
def rationalOrderIso : RationalOpen p R ≃o RationalOpen p ((PairCat.tiltFunctor p).obj R) := sorry

theorem rationalOrderIso_apply (U : RationalOpen p R) :
    rationalOrderIso p R U = tiltRationalOpen p R U := sorry

-- Check: rational_order_empty
example (U : RationalOpen p R) (h : U.val = ∅) : (rationalOrderIso p R U).val = ∅ := sorry
-- Check: rational_order_whole
example (U : RationalOpen p R) (h : U.val = Set.univ) :
    (rationalOrderIso p R U).val = Set.univ := sorry
-- Check: rational_order_disjoint
example (U V : RationalOpen p R) :
    Disjoint ((rationalOrderIso p R U).val) ((rationalOrderIso p R V).val) ↔
      Disjoint U.val V.val := sorry
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid

namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
open TauCeti Huber Perfectoid CategoryTheory CategoryTheory.Limits TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]
/-- Continuous plus-preserving maps into global functions; global functions need not be Huber. -/
abbrev GlobalPairMap (R : PairCat.{0} p) (Y : Perfd p) :=
  {f : R →+* globalSections p Y // Continuous f ∧ ∀ a ∈ R.pair.plus, f a ∈ globalPlus p Y}

/-- Wedhorn 8.25, p. 80, specialized to perfectoid test spaces. -/
def spaHomEquiv (R : PairCat.{0} p) (Y : Perfd p) : (Y ⟶ ofPair p R) ≃ GlobalPairMap p R Y := sorry

theorem spaHomEquiv_apply (R : PairCat.{0} p) (Y : Perfd p) (f : Y ⟶ ofPair p R) :
    (spaHomEquiv p R Y f).val =
      (globalPullback p f).comp (globalSectionsAffinoidEquiv p R).symm.toRingHom := sorry

-- Check: affine_mapping_empty
example (R : PairCat.{0} p) (Y : Perfd p) [IsEmpty (YonedaAdicSpace.space.obj Y.obj)] :
    Unique (GlobalPairMap p R Y) := sorry
-- Check: affine_mapping_recovers_pair
example (R S : PairCat.{0} p) : Nonempty (GlobalPairMap p R (ofPair p S) ≃ (R ⟶ S)) := sorry
-- Check: affine_mapping_inverse_parameter
example (R : PairCat.{0} p) (Y : Perfd p) (f : GlobalPairMap p R Y)
    (ϖ : PseudoUniformizerRoots p R) (C : Chart p Y) [Nontrivial C.ring] :
    (f.val (ϖ.zpow (-1) 0 : R)).val C ∉ C.ring.pair.plus := sorry

/-- The characteristic is checked on any open, including the empty open. -/
theorem inCharP_iff_global (X : Perfd p) : InCharP p X ↔ (p : globalSections p X) = 0 := sorry

theorem characteristic_p_open_functions (X : Perf p)
    (U : TopologicalSpace.Opens (YonedaAdicSpace.space.obj X.obj.obj)) :
    (p : globalSections p (restrict p X.obj U)) = 0 ∧
      Function.Bijective (fun s : globalSections p (restrict p X.obj U) ↦ s ^ p) := sorry

/-- Nested open restrictions are identified by the inclusions, not merely abstractly isomorphic. -/
theorem restrict_nested (X : Perfd p)
    (U V : TopologicalSpace.Opens (YonedaAdicSpace.space.obj X.obj)) (h : V ≤ U) :
    ∃! f : restrict p X V ⟶ restrict p X U, f ≫ restrictι p X U = restrictι p X V := sorry

/-- The completed tensor cone is universal among all Yoneda-adic spaces. -/
theorem tensor_affinoid_pullback (A B C : PairCat.{0} p) (f : A ⟶ B) (g : A ⟶ C) :
    ∃ h : ((spaFunctor p).map (PairCat.tensorInl p A B C f g).op).hom ≫
        ((spaFunctor p).map f.op).hom =
      ((spaFunctor p).map (PairCat.tensorInr p A B C f g).op).hom ≫
        ((spaFunctor p).map g.op).hom,
      Nonempty (IsLimit (PullbackCone.mk
        ((spaFunctor p).map (PairCat.tensorInl p A B C f g).op).hom
        ((spaFunctor p).map (PairCat.tensorInr p A B C f g).op).hom h)) := sorry

-- Check: chart_identity_sections
example (R : PairCat.{0} p) (a : R) :
    ((globalSectionsAffinoidEquiv p R).symm a).val (identityChart p R) = a := sorry
-- Check: chart_empty_ring
example (X : Perfd p) (C : Chart p X) [IsEmpty (YonedaAdicSpace.space.obj X.obj)] :
    Subsingleton C.ring := sorry
-- Check: chart_parameter_nonzero
example (X : Perfd p) (C : Chart p X) [Nontrivial C.ring]
    (ϖ : PseudoUniformizerRoots p C.ring) :
    ϖ.root 0 ≠ 0 ∧ (ϖ.root 0) ^ 2 ≠ ϖ.root 0 := sorry

-- Check: characteristic_p_affine_empty
example (R : PairCat.{0} p) (hR : (p : R) = 0) [Subsingleton R] :
    IsEmpty (YonedaAdicSpace.space.obj (charPOfPair p R hR).obj.obj) := sorry
-- Check: characteristic_p_affine_roots
example (R : PairCat.{0} p) (hR : (p : R) = 0) :
    Function.Bijective (fun s : globalSections p (charPOfPair p R hR).obj ↦ s ^ p) := sorry
-- Check: characteristic_p_affine_agreement
example (R : PairCat.{0} p) (_hR : (p : R) = 0) (a : R) :
    globalSectionsAffinoidEquiv p R ((globalSectionsAffinoidEquiv p R).symm a) = a :=
  (globalSectionsAffinoidEquiv p R).apply_symm_apply a
end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
end

/-! ### Layer 2: Cartan's criterion modulo an idempotent ideal -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open CategoryTheory Opposite
variable (V : Type) [CommRing V] (m : Ideal V) (X : TopCat)
/-! ### P2/cech-to-sheaf-cohomology-on-rational-basis -/

/-- A scalar action on an abelian sheaf is a sheaf of V-modules. The conclusion uses
Mathlib's cohomology on each basis open. Stacks 20.11.9 gives the ordinary case;
the Serre-class dimension-shifting argument gives the idempotent-ideal variant. -/
theorem almost_cartan (hm : m * m = m) (F : TopCat.Sheaf AddCommGrpCat X)
    (scalar : V →+* End F) (B : Set (TopologicalSpace.Opens X))
    (hbasis : TopologicalSpace.IsTopologicalBasis ((fun U : TopologicalSpace.Opens X ↦ (U : Set X)) '' B))
    (hcompact : ∀ U ∈ B, IsCompact (U : Set X))
    (hinter : ∀ U ∈ B, ∀ W ∈ B, U ⊓ W ∈ B)
    (hcech : ∀ U ∈ B, ∀ (n : ℕ) (W : Fin n → TopologicalSpace.Opens X),
      (∀ i, W i ∈ B) → iSup W = U → ∀ q : ℕ, 0 < q → ∀ a ∈ m,
        HomologicalComplex.homologyMap ((cechComplexFunctor W).map (scalar a).hom) q = 0) :
    ∀ U ∈ B, ∀ q : ℕ, 0 < q → ∀ a ∈ m,
      ((Sheaf.cohomologyPresheafFunctor _ q).map (scalar a)).app (op U) = 0 := sorry

-- Check: cartan_zero_scalar
example (F : TopCat.Sheaf AddCommGrpCat X) (scalar : V →+* End F) : scalar 0 = 0 := map_zero scalar
-- Check: cartan_unit_scalar
example (F : TopCat.Sheaf AddCommGrpCat X) (scalar : V →+* End F) : scalar 1 = 𝟙 F := map_one scalar
-- Check: cartan_two_term_additivity
example (F : TopCat.Sheaf AddCommGrpCat X) (scalar : V →+* End F) (a b : V) :
    scalar (a + b) = scalar a + scalar b := map_add scalar a b
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
end

/-! ### Layer 2: Coherent finite-subset models -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open TauCeti Huber CategoryTheory CategoryTheory.Limits ValuationSpectrum
variable (p : ℕ) [Fact p.Prime]
variable (K : Type) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  [IsPerfectoidField p K] [CharP K p]
variable (R : PairCat.{0} p) [Algebra K R]
local instance : DecidableEq R.pair.plus := Classical.decEq _

/-! ### P2/completed-direct-limits-of-p-finite-affinoids -/

/-- Sch12 Lemma 6.13: the source at I is the reduced affinoid generated by I,
with its affinoid quotient topology; the stage is its completed perfection.
The source embeds algebraically in R, but need not have the subspace topology from R. -/
structure PFiniteSystem where
  diagram : Finset R.pair.plus ⥤ PairCat.{0} p
  scalar : ∀ I, K →+* diagram.obj I
  scalar_continuous : ∀ I, Continuous (scalar I)
  scalar_plus : ∀ I, ∀ a ∈ powerBoundedSubring K, scalar I a ∈ (diagram.obj I).pair.plus
  scalar_naturality : ∀ I J (h : I ≤ J),
    (diagram.map (homOfLE h)).toRingHom.comp (scalar I) = scalar J
  model : ∀ I, let _ := (scalar I).toAlgebra; PFiniteModel p K (diagram.obj I)
  ι : diagram ⟶ (Functor.const _).obj R
  scalar_ι : ∀ I, (ι.app I).toRingHom.comp (scalar I) = algebraMap K R
  generator : ∀ I : Finset R.pair.plus, let _ := (scalar I).toAlgebra; I → (model I).source.P.plus
  generator_image : ∀ (I : Finset R.pair.plus) (a : I), let _ := (scalar I).toAlgebra;
    (ι.app I).toRingHom ((model I).map (generator I a).val) = a.val.val
  source_dense : ∀ I : Finset R.pair.plus, let _ := (scalar I).toAlgebra; DenseRange
    (MvPolynomial.eval₂ (model I).scalar (fun a : I ↦ (generator I a).val))
  source_injective : ∀ I : Finset R.pair.plus, let _ := (scalar I).toAlgebra; Function.Injective ((ι.app I).toRingHom.comp (model I).map)

/-- The system exists for every integral K-algebra action; no finite-type hypothesis on R. -/
def pfiniteSystem (K : Type) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
    [IsPerfectoidField p K] [CharP K p] (R : PairCat.{0} p) [Algebra K R]
    (hc : Continuous (algebraMap K R))
    (hplus : ∀ a ∈ powerBoundedSubring K, algebraMap K R a ∈ R.pair.plus) :
    PFiniteSystem p K R := sorry

/-- Completion of the filtered colimit in complete perfectoid pairs. -/
theorem pfiniteSystem_isColimit (S : PFiniteSystem p K R) :
    Nonempty (IsColimit (Cocone.mk R S.ι)) := sorry

/-- The modulo-ϖ^n colimit: surjectivity and eventual vanishing give both halves
of the ring-colimit comparison, expressed without choosing quotient-ring transports. -/
theorem pfiniteSystem_mod (S : PFiniteSystem p K R) (ϖ : PseudoUniformizerRoots p K) (n : ℕ) :
    (∀ a : R.pair.plus, ∃ I, ∃ s ∈ (S.diagram.obj I).pair.plus, ∃ b ∈ R.pair.plus,
      ((show S.diagram.obj I ⟶ R from S.ι.app I).toRingHom s) - a.val = algebraMap K R (ϖ.root 0 ^ n) * b) ∧
    (∀ I, ∀ s ∈ (S.diagram.obj I).pair.plus,
      (∃ b ∈ R.pair.plus, ((S.ι.app I).toRingHom s : R) = algebraMap K R (ϖ.root 0 ^ n) * b) →
      ∃ J, ∃ h : I ≤ J, ∃ b ∈ (S.diagram.obj J).pair.plus,
        (S.diagram.map (homOfLE h)).toRingHom s = S.scalar J (ϖ.root 0 ^ n) * b) := sorry

/-- Valuation points are the topological inverse limit of the finite stages. -/
theorem pfiniteSystem_topologicalLimit (S : PFiniteSystem p K R) :
    ∃ e : spa R.pair.plus ≃ₜ
      {x : ∀ I, spa (S.diagram.obj I).pair.plus |
        ∀ I J (h : I ≤ J), (S.diagram.map (homOfLE h)).spaComap (x J) = x I},
      ∀ x I, (e x).val I = (S.ι.app I).spaComap x := sorry

/-- Every rational subset is pulled back from one finite stage. -/
theorem pfiniteSystem_rational_descent (S : PFiniteSystem p K R) (U : RationalOpen p R) :
    ∃ I, ∃ V : RationalOpen p (S.diagram.obj I),
      U.val = (S.ι.app I).spaComap ⁻¹' V.val := sorry

/-- A quasi-compact open containing the limiting image contains the image from some stage. -/
theorem pfiniteSystem_eventual_image (S : PFiniteSystem p K R) (I : Finset R.pair.plus)
    (U : TopologicalSpace.Opens (spa (S.diagram.obj I).pair.plus))
    (hU : IsCompact (U : Set (spa (S.diagram.obj I).pair.plus))) (himage : Set.range (S.ι.app I).spaComap ⊆ (U : Set (spa (S.diagram.obj I).pair.plus))) :
    ∃ J, ∃ h : I ≤ J, Set.range (S.diagram.map (homOfLE h)).spaComap ⊆ (U : Set (spa (S.diagram.obj I).pair.plus)) := sorry

/-- Rational localization commutes with the completed filtered colimit, with both
transition maps and the limiting structure maps fixed over the original stages. -/
theorem pfiniteSystem_rational_colimit (S : PFiniteSystem p K R)
    (I : Finset R.pair.plus) (V : RationalOpen p (S.diagram.obj I))
    (U : RationalOpen p R) (hU : U.val = (S.ι.app I).spaComap ⁻¹' V.val) :
    ∃ F : {J : Finset R.pair.plus // I ≤ J} ⥤ PairCat.{0} p,
      ∃ Q : ∀ J : {J : Finset R.pair.plus // I ≤ J}, RationalOpen p (S.diagram.obj J.val),
      (∀ J, (Q J).val = (S.diagram.map (homOfLE J.property)).spaComap ⁻¹' V.val) ∧
      ∃ e : ∀ J, F.obj J ≅ rationalPair p (S.diagram.obj J.val) (Q J),
      ∃ η : F ⟶ (Functor.const _).obj (rationalPair p R U),
        (∀ J, rationalMap p (S.diagram.obj J.val) (Q J) ≫ (e J).inv ≫ η.app J =
          S.ι.app J.val ≫ rationalMap p R U) ∧
        (∀ J L (h : J ≤ L),
          rationalMap p (S.diagram.obj J.val) (Q J) ≫ (e J).inv ≫ F.map (homOfLE h) =
            S.diagram.map (homOfLE h) ≫ rationalMap p (S.diagram.obj L.val) (Q L) ≫ (e L).inv) ∧
        Nonempty (IsColimit (Cocone.mk (rationalPair p R U) η)) := sorry

-- Check: pfinite_system_empty
example [Nontrivial R] (S : PFiniteSystem p K R) : Function.Bijective (S.scalar ∅) := sorry
-- Check: pfinite_system_singleton
example (S : PFiniteSystem p K R) (a : R.pair.plus) :
    ∃ s ∈ (S.diagram.obj {a}).pair.plus, (S.ι.app {a}).toRingHom s = a.val := sorry
-- Check: pfinite_system_two_generators
example (S : PFiniteSystem p K R) (a b : R.pair.plus) :
    ∃ s t : (S.diagram.obj {a, b}).pair.plus,
      (S.ι.app {a, b}).toRingHom (s.val + t.val) = a.val + b.val ∧
      (S.ι.app {a, b}).toRingHom (s.val * t.val) = a.val * b.val := sorry

/-! ### P2/p-finite-acyclicity-from-tate -/

/-- The p-finite source comparison is the map of valuations induced by the model embedding. -/
theorem pfiniteModel_spa_homeomorph (T : PFiniteModel p K R) :
    ∃ e : spa R.pair.plus ≃ₜ spa T.source.P.plus,
      ∀ x : spa R.pair.plus, ∀ a b : T.source.A,
        (e x).val.toValuativeRel.vle a b ↔ x.val.toValuativeRel.vle (T.map a) (T.map b) := sorry

/-- Perfecting a p-finite source identifies its rational subsets. -/
theorem pfiniteModel_rational_correspondence (T : PFiniteModel p K R)
    (f : Pair.Hom T.source.P R.pair) (hf : f.toRingHom = T.map) :
    ∀ U : Set (spa T.source.P.plus), U ∈ spaRationalFamily T.source.P.plus ↔
      f.spaComap ⁻¹' U ∈ spaRationalFamily R.pair.plus := sorry
/-- The completed perfection has almost acyclic integral sections on every rational cover. -/
theorem pfiniteModel_almost_acyclic (T : PFiniteModel p K R)
    (q : ℕ) (hq : 0 < q) (a : R.pair.plus) (ha : IsTopologicallyNilpotent a.val) :
    Sheaf.H.map (integralScalar p R a) q = 0 ∧
    ∀ (n : ℕ) (U : Fin n → TopologicalSpace.Opens (spa R.pair.plus)),
      (∀ i, (U i : Set _) ∈ spaRationalFamily R.pair.plus) → iSup U = ⊤ →
      HomologicalComplex.homologyMap
        ((cechComplexFunctor U).map (integralScalar p R a).hom) q = 0 := sorry

end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
end

/-! ### Layer 2: Root-adjoined integral rational models -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open TauCeti Huber ValuationSpectrum CategoryTheory
variable (p : ℕ) [Fact p.Prime] (R : PairCat.{0} p) (U : RationalOpen p R)
variable {n : ℕ} (f : Fin n → ℕ → R.pair.plus) (g : ℕ → R.pair.plus)

/-! ### P2/almost-integral-model-of-untilted-rational-localization -/

/-- The algebraic root-adjoined model inside the actual completed rational localization.
For sharp presentations the sequences are the sharps of the successive Frobenius roots. -/
def rawRootModel : Subring (rationalPair p R U) :=
  (R.pair.plus.map (rationalMap p R U).toRingHom) ⊔
    Subring.closure (Set.range (fun im : Fin n × ℕ ↦
      (rationalMap p R U).toRingHom (f im.1 im.2).val *
        Ring.inverse ((rationalMap p R U).toRingHom (g im.2).val)))

/-- Completion of the root-adjoined integral model, with its embedding in the rational ring. -/
def rootIntegralModel : Subring (rationalPair p R U) := (rawRootModel p R U f g).topologicalClosure

/-- Evaluation of the polynomial presentation, including every root variable. -/
def rootModelEval : MvPolynomial (Fin n × ℕ) R.pair.plus →+* rationalPair p R U :=
  MvPolynomial.eval₂Hom ((rationalMap p R U).toRingHom.comp R.pair.plus.subtype)
    (fun im ↦ (rationalMap p R U).toRingHom (f im.1 im.2).val *
      Ring.inverse ((rationalMap p R U).toRingHom (g im.2).val))

/-- Both the root relations and the rational relations are imposed. -/
def rootModelRelations : Ideal (MvPolynomial (Fin n × ℕ) R.pair.plus) :=
  Ideal.span ((Set.range (fun im : Fin n × ℕ ↦
      MvPolynomial.X (im.1, im.2 + 1) ^ p - MvPolynomial.X im)) ∪
    Set.range (fun im : Fin n × ℕ ↦
      MvPolynomial.C (g im.2) * MvPolynomial.X im - MvPolynomial.C (f im.1 im.2)))

local instance : DecidableEq R := Classical.decEq R

variable (hf : ∀ i m, (f i (m + 1)).val ^ p = (f i m).val)
  (hg : ∀ m, (g (m + 1)).val ^ p = (g m).val)
  (hspan : Ideal.span (Set.range (fun i ↦ (f i 0).val)) = ⊤)
  (hU : U.val = Subtype.val ⁻¹' rationalSubset R.pair.plus
    (Finset.univ.image (fun i ↦ (f i 0).val)) (g 0).val)
  (ϖ : PseudoUniformizerRoots p R)
  (hϖ : ∀ k, ϖ.root k ∈ R.pair.plus)

include hf hg hspan hU hϖ

/-- Sch12 6.4 and ECD 3.18: the model is almost the integral localization.
Root-scaled containment is the actual almost-isomorphism assertion. -/
theorem rootIntegralModel_almost :
    rootIntegralModel p R U f g ≤ (rationalPair p R U).pair.plus ∧
    ∀ k, ∀ a ∈ powerBoundedSubring (rationalPair p R U),
      (rationalMap p R U).toRingHom (ϖ.root k) * a ∈ rootIntegralModel p R U f g := sorry

/-- Inverting the parameter recovers every element, and the integral model is parameter-torsion-free. -/
theorem rootIntegralModel_invert :
    (∀ a : rationalPair p R U, ∃ N : ℕ, a * (rationalMap p R U).toRingHom (ϖ.root 0) ^ N ∈
      rootIntegralModel p R U f g) ∧
    Function.Injective (fun a : rootIntegralModel p R U f g ↦
      (rationalMap p R U).toRingHom (ϖ.root 0) * a.val) := sorry

/-- The closure agrees with the separated adic completion, fixing the algebraic model. -/
theorem rootIntegralModel_completion :
    ∃ h : (rationalMap p R U).toRingHom (ϖ.root 0) ∈ rawRootModel p R U f g,
      ∃ e : AdicCompletion (Ideal.span {(⟨(rationalMap p R U).toRingHom (ϖ.root 0), h⟩ : rawRootModel p R U f g)})
        (rawRootModel p R U f g) ≃+* rootIntegralModel p R U f g,
        ∀ a : rawRootModel p R U f g,
          (e (algebraMap (rawRootModel p R U f g) _ a)).val = a.val := sorry

/-- Frobenius modulo the two parameters is almost surjective and almost injective.
The divisibility condition is in the power-bounded base ring. -/
theorem rootIntegralModel_frobenius (hdiv : (ϖ.rootPB 0) ^ p ∣ (p : powerBoundedSubring R)) :
    (∀ a ∈ rootIntegralModel p R U f g, ∀ k, ∃ b ∈ rootIntegralModel p R U f g,
      ∃ c ∈ rootIntegralModel p R U f g,
        (rationalMap p R U).toRingHom (ϖ.root k) * a - b ^ p =
          (rationalMap p R U).toRingHom (ϖ.root 0) * c) ∧
    (∀ b ∈ rootIntegralModel p R U f g,
      (∃ c ∈ rootIntegralModel p R U f g, b ^ p = (rationalMap p R U).toRingHom (ϖ.root 0) * c) →
      ∀ k, ∃ c ∈ rootIntegralModel p R U f g,
        (rationalMap p R U).toRingHom (ϖ.root k) * b =
          (rationalMap p R U).toRingHom (ϖ.root 1) * c) := sorry

/-- Sch12 Lemma 6.4(i), pp. 31–33: the presentation over a perfectoid field,
with the parameter and every almost annihilator coming from that field. -/
theorem rootIntegralModel_presentation (K : Type) [NontriviallyNormedField K]
    [IsUltrametricDist K] [CompleteSpace K] [IsPerfectoidField p K] [Algebra K R]
    (hcont : Continuous (algebraMap K R))
    (hplus : ∀ a ∈ powerBoundedSubring K, algebraMap K R a ∈ R.pair.plus)
    (ϖK : PseudoUniformizerRoots p K)
    (hscalar : ∀ k, algebraMap K R (ϖK.root k) = ϖ.root k) :
    (∀ a ∈ rootIntegralModel p R U f g, ∃ P : MvPolynomial (Fin n × ℕ) R.pair.plus,
      ∃ c ∈ rootIntegralModel p R U f g,
        a - rootModelEval p R U f g P = (rationalMap p R U).toRingHom (ϖ.root 0) * c) ∧
    (∀ P : MvPolynomial (Fin n × ℕ) R.pair.plus,
      (∃ c ∈ rootIntegralModel p R U f g,
        rootModelEval p R U f g P = (rationalMap p R U).toRingHom (ϖ.root 0) * c) →
      ∀ k, MvPolynomial.C (⟨ϖ.root k, hϖ k⟩ : R.pair.plus) * P ∈
        rootModelRelations p R f g ⊔ Ideal.span {MvPolynomial.C (⟨ϖ.root 0, hϖ 0⟩ : R.pair.plus)}) := sorry

/-- In characteristic p both integral models and the actual plus localization are perfect. -/
theorem rootIntegralModel_charP (hp : (p : R) = 0) :
    Function.Bijective (fun a : rootIntegralModel p R U f g ↦ a ^ p) ∧
      Function.Bijective (fun a : (rationalPair p R U).pair.plus ↦ a ^ p) := sorry

/-- Sch12 proof of Lemma 6.4(i), p. 31: the algebraic kernel over a
characteristic-p perfectoid field, before completion or reduction. -/
theorem rawRootModel_kernel_charP (K : Type) [NontriviallyNormedField K]
    [IsUltrametricDist K] [CompleteSpace K] [IsPerfectoidField p K] [Algebra K R]
    (hcont : Continuous (algebraMap K R))
    (hplus : ∀ a ∈ powerBoundedSubring K, algebraMap K R a ∈ R.pair.plus)
    (ϖK : PseudoUniformizerRoots p K)
    (hscalar : ∀ k, algebraMap K R (ϖK.root k) = ϖ.root k)
    [CharP K p] (hp : (p : R) = 0) :
    ∀ P : MvPolynomial (Fin n × ℕ) R.pair.plus, rootModelEval p R U f g P = 0 →
      ∀ k, MvPolynomial.C (⟨ϖ.root k, hϖ k⟩ : R.pair.plus) * P ∈ rootModelRelations p R f g := sorry

-- Check: root_model_empty
example (h : U.val = ∅) : rootIntegralModel p R U f g = ⊤ ∧ rawRootModel p R U f g = ⊤ := sorry
-- Check: root_model_unit_presentation
example (h : U.val = Set.univ) :
    rootIntegralModel p R U (fun _ : Fin 1 ↦ fun _ ↦ 1) (fun _ ↦ 1) =
      R.pair.plus.map (rationalMap p R U).toRingHom ∧
    rawRootModel p R U (fun _ : Fin 1 ↦ fun _ ↦ 1) (fun _ ↦ 1) =
      R.pair.plus.map (rationalMap p R U).toRingHom := sorry
-- Check: root_model_nonintegral_parameter
example [Nontrivial (rationalPair p R U)] :
    (rationalMap p R U).toRingHom (ϖ.zpow (-1) 0 : R) ∉ rootIntegralModel p R U f g ∧
    (rationalMap p R U).toRingHom (ϖ.zpow (-1) 0 : R) ∉ rawRootModel p R U f g := sorry
omit hf hg hspan hU hϖ in
-- Check: root_model_eval_constants
example (a : R.pair.plus) : rootModelEval p R U f g (MvPolynomial.C a) =
    (rationalMap p R U).toRingHom a.val := by simp [rootModelEval]
omit hf hg hspan hU hϖ in
-- Check: root_model_eval_two_variables
example (i : Fin n) : rootModelEval p R U f g
    (MvPolynomial.X (i, 0) + MvPolynomial.X (i, 1)) =
      (rationalMap p R U).toRingHom (f i 0).val * Ring.inverse ((rationalMap p R U).toRingHom (g 0).val) +
      (rationalMap p R U).toRingHom (f i 1).val * Ring.inverse ((rationalMap p R U).toRingHom (g 1).val) := by
  simp [rootModelEval]
omit hf hg hspan hU hϖ in
-- Check: root_model_eval_empty
example (h : U.val = ∅) (P : MvPolynomial (Fin n × ℕ) R.pair.plus) :
    rootModelEval p R U f g P = 0 := sorry
omit hf hg hspan hU hϖ in
-- Check: root_relations_unit
example : MvPolynomial.X ((0 : Fin 1), 0) - 1 ∈
    rootModelRelations p R (fun _ : Fin 1 ↦ fun _ ↦ 1) (fun _ ↦ 1) := sorry
omit hf hg hspan hU hϖ in
-- Check: root_relations_empty_denominator
example : rootModelRelations p R (fun _ : Fin 1 ↦ fun _ ↦ 1) (fun _ ↦ 0) = ⊤ := sorry
omit hf hg hspan hU hϖ in
-- Check: root_relations_no_spurious_constant
example [Nontrivial R] : (1 : MvPolynomial (Fin 1 × ℕ) R.pair.plus) ∉
    rootModelRelations p R (fun _ : Fin 1 ↦ fun _ ↦ 1) (fun _ ↦ 1) := sorry
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
end

/-! ### Layer 2: The plus tensor comparison -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid.PairCat
open TauCeti Huber CategoryTheory TensorProduct
variable (p : ℕ) [Fact p.Prime] (A B C : PairCat.{0} p) (f : A ⟶ B) (g : A ⟶ C)

/-! ### P2/completed-tensor-plus-ring-almost-formula -/

/-- Closed image of the integral tensor, before taking integral closure. -/
def tensorPlusModel : Subring (tensorPair p A B C f g) :=
  ((B.pair.plus.map (tensorInl p A B C f g).toRingHom) ⊔
    (C.pair.plus.map (tensorInr p A B C f g).toRingHom)).topologicalClosure

/-- KL II 3.3.13 and Bhatt 9.3.14: almost equality, for the chosen plus rings. -/
theorem tensorPlusModel_almost (ϖ : PseudoUniformizerRoots p A) :
    tensorPlusModel p A B C f g ≤ (tensorPair p A B C f g).pair.plus ∧
    ∀ k, ∀ a ∈ (tensorPair p A B C f g).pair.plus,
      (tensorInl p A B C f g).toRingHom (f.toRingHom (ϖ.root k)) * a ∈
        tensorPlusModel p A B C f g := sorry

/-- The parameter-power torsion in the algebraic integral tensor is almost zero.
The two integral algebra structures are the restrictions of the specified pair maps. -/
theorem integral_tensor_torsion (ϖ : PseudoUniformizerRoots p A)
    (hϖ : ∀ k, ϖ.root k ∈ A.pair.plus) :
    let fplus : A.pair.plus →+* B.pair.plus :=
      (f.toRingHom.comp A.pair.plus.subtype).codRestrict B.pair.plus (fun a ↦ f.map_mem_plus a.val a.property)
    let gplus : A.pair.plus →+* C.pair.plus :=
      (g.toRingHom.comp A.pair.plus.subtype).codRestrict C.pair.plus (fun a ↦ g.map_mem_plus a.val a.property)
    let _ := fplus.toAlgebra
    let _ := gplus.toAlgebra
    ∀ x : B.pair.plus ⊗[A.pair.plus] C.pair.plus,
      (∃ N : ℕ, (⟨ϖ.root 0, hϖ 0⟩ : A.pair.plus) ^ N • x = 0) →
      ∀ k, (⟨ϖ.root k, hϖ k⟩ : A.pair.plus) • x = 0 := sorry

-- Check: tensor_plus_model_zero
example [Subsingleton B] : tensorPlusModel p A B C f g = ⊤ := sorry
-- Check: tensor_plus_model_identity
example : tensorPlusModel p A B A f (𝟙 A) =
    B.pair.plus.map (tensorInl p A B A f (𝟙 A)).toRingHom := sorry
-- Check: tensor_plus_model_inverse_parameter
example [Nontrivial (tensorPair p A B C f g)] (ϖ : PseudoUniformizerRoots p A) :
    (tensorInl p A B C f g).toRingHom (f.toRingHom (ϖ.zpow (-1) 0 : A)) ∉
      tensorPlusModel p A B C f g := sorry
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid.PairCat
end

/-! ### Layer 2: Canonical characteristic-p identification -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
open TauCeti Huber Perfectoid CategoryTheory TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]
/-- The characteristic-p isomorphism is the inverse of sharp on functions. -/
theorem tiltCharPIso_sharp (X : Perf p) (s : globalSections p X.obj) :
    globalSharp p X.obj (globalPullback p (tiltCharPIso p X).hom s) = s := sorry

-- Check: perfectoid_cp_point
example : Unique (YonedaAdicSpace.space.obj
    (ofPair p ({ carrier := ℂ_[p], pair := Pair.powerBounded ℂ_[p] } : PairCat.{0} p)).obj) := sorry
-- Check: characteristic_p_sharp_two_terms
example (X : Perf p) (s t : globalSections p X.obj) :
    globalSharp p X.obj (globalPullback p (tiltCharPIso p X).hom (s + t)) = s + t :=
  tiltCharPIso_sharp p X (s + t)
end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
end

/-! ### Layer 2: Integral Čech complexes over a stably uniform Tate pair -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open TauCeti Huber ValuationSpectrum CategoryTheory Opposite
open TauCetiRoadmap.AdicEtaleGeometry
variable (A : CAff) [IsTateRing A.A]

/-! ### P2/integral-cech-cohomology-bounded-torsion -/

/-- An integral structure sheaf with its actual completed-localization coordinates.
The Boolean selects the chosen plus rings or the power-bounded rings. Restriction maps
are fixed by every continuous localization map commuting with the base maps. -/
structure RationalTateSheaf (usePB : Bool) where
  sheaf : (TopCat.of (spa A.P.plus)).Sheaf AddCommGrpCat
  scalar : A.P.plus →+* End sheaf
  coordinate : ∀ (U : TopologicalSpace.Opens (spa A.P.plus)) (D : PairOfDefinition A.A)
    (q : D.Presentation), Ideal.span (q.num : Set A.A) = ⊤ →
      (U : Set (spa A.P.plus)) = Subtype.val ⁻¹' rationalSubset A.P.plus q.num q.den →
        sheaf.obj.obj (op U) ≃+
          ↥(if usePB then powerBoundedSubring (RationalLoc q) else (RationalLoc.pair q A.P).plus : Subring (RationalLoc q))
  scalar_coordinate : ∀ U D q h hU a s,
    (coordinate U D q h hU ((scalar a).hom.app (op U) s)).val =
      (RationalLoc.structureMap q A.P).toRingHom a.val * (coordinate U D q h hU s).val
  restriction_coordinate : ∀ U V D E q r hq hr hU hV (hVU : V ≤ U)
    (φ : Pair.Hom (RationalLoc.pair q A.P) (RationalLoc.pair r A.P)),
    φ.comp (RationalLoc.structureMap q A.P) = RationalLoc.structureMap r A.P →
      ∀ s : sheaf.obj.obj (op U),
        (coordinate V E r hr hV (sheaf.obj.map (homOfLE hVU).op s)).val =
          φ.toRingHom (coordinate U D q hq hU s).val

/-- Stable uniformity supplies the sheaf and its localization coordinates.
KL II 3.3.19–20; the structure-presheaf construction belongs to AdicSpaces. -/
def rationalTateSheaf
    (hA : ∀ (D : PairOfDefinition A.A) (q : D.Presentation),
      Ideal.span (q.num : Set A.A) = ⊤ →
        IsBounded (powerBoundedSubring (RationalLoc q) : Set (RationalLoc q)))
    (usePB : Bool) : RationalTateSheaf A usePB := sorry

/-- The bounded-torsion consequence of the strict Banach Čech complex.
Sch12 proof of 6.10(iii), p. 36, with the stably uniform Tate-ring acyclicity
input of KL I 2.4.23. No perfectoid or noetherian hypothesis is imposed. -/
theorem integral_cech_bounded_torsion
    (hA : ∀ (D : PairOfDefinition A.A) (q : D.Presentation),
      Ideal.span (q.num : Set A.A) = ⊤ →
        IsBounded (powerBoundedSubring (RationalLoc q) : Set (RationalLoc q)))
    (ϖ : A.P.plus) (hϖ : IsPseudoUniformizer ϖ.val)
    (Splus : RationalTateSheaf A false) (Spb : RationalTateSheaf A true)
    (V : TopologicalSpace.Opens (spa A.P.plus)) (hV : (V : Set (spa A.P.plus)) ∈ spaRationalFamily A.P.plus)
    (n : ℕ) (U : Fin n → TopologicalSpace.Opens (spa A.P.plus))
    (hU : ∀ i, (U i : Set (spa A.P.plus)) ∈ spaRationalFamily A.P.plus) (hcover : iSup U = V) :
    ∃ N : ℕ, ∀ q : ℕ, 0 < q →
      HomologicalComplex.homologyMap ((cechComplexFunctor U).map (Splus.scalar (ϖ ^ N)).hom) q = 0 ∧
      HomologicalComplex.homologyMap ((cechComplexFunctor U).map (Spb.scalar (ϖ ^ N)).hom) q = 0 := sorry

-- Check: general_integral_sections_empty
example (usePB : Bool) (S : RationalTateSheaf A usePB) :
    Subsingleton (S.sheaf.obj.obj (op ⊥)) := sorry
-- Check: general_integral_sections_whole
example (S : RationalTateSheaf A false) :
    Nonempty (S.sheaf.obj.obj (op ⊤) ≃+ A.P.plus) := sorry
-- Check: general_integral_parameter_torsionfree
