/-! ### Layer 6: The rank-two geometric-point boundary -/

/-- An algebraically closed complete rank-one valued field with a rank-two plus ring.
The only valuation overrings inside the norm unit ball are the plus ring and that unit ball. -/
structure RankTwoGeometricPoint where
  field : AffinoidField p
  [algebraicallyClosed : IsAlgClosed field]
  proper : field.plus.toSubring ≠ powerBoundedSubring field
  overrings : ∀ V : ValuationSubring field, field.plus ≤ V →
    V.toSubring ≤ powerBoundedSubring field →
      V = field.plus ∨ V.toSubring = powerBoundedSubring field
attribute [instance] RankTwoGeometricPoint.algebraicallyClosed

/-- Compose the norm valuation with a nontrivial rank-one residue valuation;
completion of an algebraic closure of a one-variable Gauss field supplies such a field. -/
def rankTwoGeometricPoint : RankTwoGeometricPoint p := sorry

