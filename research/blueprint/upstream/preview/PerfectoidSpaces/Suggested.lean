    let K : PairCat.{0} p := ⟨completedPerfectLaurentFp p, Pair.powerBounded _⟩
    let D : PairCat.{0} p := ⟨perfectedTateAlgebra p ϖ Unit, Pair.powerBounded _⟩
    let X := charPOfPair p K (by sorry)
    ∃ U : TopologicalSpace.Opens (space.obj (ofPair p D).obj),
      (∀ x, x ∈ U ↔ ∃ m n : ℕ, 0 < m ∧ 0 < n ∧
        let v := (spaSpaceEquiv p D x).down.val.valuation
        v (algebraMap K D (ϖ.root 0)) ^ m ≤ v (perfectedTateAlgebra.rootX ϖ () 0) ∧
        v (perfectedTateAlgebra.rootX ϖ () 0) ^ n ≤ v (algebraMap K D (ϖ.root 0))) ∧
      Nonempty ((Limits.prod X X).obj ≅ restrict p (ofPair p D) U) ∧
