variable (R) in
/-! ### P2/rational-localization-in-characteristic-p -/

/-- A perfectoid Tate ring of characteristic `p`
has uniform completed rational localizations (KL I Proposition 3.1.7).
This establishes the rational-localization criterion for stable uniformity for perfectoid rings. -/
theorem isStablyUniform_of_charP [CharP R p] :
    TauCeti.Huber.IsStablyUniform R := sorry

