example :
    let S := BasicSetup.classical ℚ
    let f := (Algebra.toAlmost S).map (CommAlgCat.ofHom (Algebra.ofId ℚ (Polynomial ℚ)))
    DerivedCategory.Q.map (HomologicalComplex.extendMap (cotangentTransitivityFirst S f (𝟙 _))
      (ComplexShape.embeddingUpIntLE 0)) ≠ 0 := sorry
-- Check: cotangentTransitivitySecond_identity
example {A C : Algebra S} (g : A ⟶ C) : IsIso (cotangentTransitivitySecond S (𝟙 A) g) := sorry
-- Check: cotangentTransitivitySecond_zero_target
