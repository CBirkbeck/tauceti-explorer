namespace Module

/-- Evaluation is the counit of the specified tensor/internal-Hom adjunction. -/
def evaluation (M N : Module S) : alHom S M N ⊗ M ⟶ N :=
  ((tensorAlHomAdj S M).homEquiv _ _).symm (𝟙 _)

/-! ### P0/tensor-hom-comparison-almost-projective -/

/-- Tensor/internal-Hom comparison, GR Lemma 2.4.29. -/
def tensorHomComparison (E F N : Module S) :
    E ⊗ alHom S F N ⟶ alHom S F (E ⊗ N) :=
  (tensorAlHomAdj S F).homEquiv _ _
    ((α_ E (alHom S F N) F).hom ≫ (E ◁ evaluation S F N))

theorem tensorHomComparison_isIso (E F N : Module S)
    (h : AlmostFiniteProjective S E ∨ AlmostFiniteProjective S F ∨
      (Flat S E ∧ AlmostFP S ((elements S).obj F)) ∨
      (AlmostProjective S F ∧ AlmostFP S ((elements S).obj E)) ∨
      (AlmostProjective S E ∧ AlmostFG S ((elements S).obj F))) :
    IsIso (tensorHomComparison S E F N) := sorry

theorem tensorHomComparison_mono (E F N : Module S)
    (h : (Flat S E ∧ AlmostFG S ((elements S).obj F)) ∨ AlmostProjective S E) :
    Mono (tensorHomComparison S E F N) := sorry

theorem tensorHomComparison_epi (E F N : Module S)
    (hF : AlmostProjective S F) (hE : AlmostFG S ((elements S).obj E)) :
    Epi (tensorHomComparison S E F N) := sorry

/-! ### P0/almost-dual-and-trace -/

/-- The dual and its evaluation into the tensor unit. -/
abbrev dual (M : Module S) := alHom S M (𝟙_ (Module S))

/-- The rank-one endomorphism map, fixed by currying evaluation. -/
def dualTensorHom (P : Module S) : P ⊗ dual S P ⟶ alHom S P P :=
  tensorHomComparison S P P (𝟙_ (Module S)) ≫ (alHomFunctor S P).map (ρ_ P).hom

/-- The rank-one endomorphism map is invertible for almost finite projectives. -/
def dualTensorHomIso (P : Module S) (hP : AlmostFiniteProjective S P) :
    P ⊗ dual S P ≅ alHom S P P := @asIso _ _ _ _ (dualTensorHom S P) (by sorry)

/-- Trace is evaluation after the inverse rank-one map, GR Definition 4.1.1. -/
def trace (P : Module S) (hP : AlmostFiniteProjective S P) :
    alHom S P P ⟶ 𝟙_ (Module S) :=
  (dualTensorHomIso S P hP).inv ≫ (β_ P (dual S P)).hom ≫ evaluation S P _

/-- Trace of an actual endomorphism, as an almost element of the base. -/
def traceElement (P : Module S) (hP : AlmostFiniteProjective S P) (f : P ⟶ P) :
    𝟙_ (Module S) ⟶ 𝟙_ (Module S) :=
  (tensorAlHomAdj S P).homEquiv _ _ ((λ_ P).hom ≫ f) ≫ trace S P hP

/-- Additivity of the trace on endomorphisms follows from GR Definition 4.1.1. -/
theorem trace_additive (P : Module S) (hP : AlmostFiniteProjective S P)
    (f g : P ⟶ P) : traceElement S P hP (f + g) =
      traceElement S P hP f + traceElement S P hP g := sorry

/-- Multiplicativity of trace on tensor products, GR Lemma 4.1.3, pp. 72–73. -/
theorem trace_tensor (P Q : Module S) (hP : AlmostFiniteProjective S P)
    (hQ : AlmostFiniteProjective S Q) (f : P ⟶ P) (g : Q ⟶ Q) :
    ∃ hPQ : AlmostFiniteProjective S (P ⊗ Q),
      traceElement S (P ⊗ Q) hPQ (f ⊗ₘ g) =
        traceElement S P hP f ≫ traceElement S Q hQ g := sorry

/-- Almost finite projectives are reflexive, GR Lemma 2.4.31(ii). -/
theorem isReflexive (P : Module S) (hP : AlmostFiniteProjective S P) :
    Nonempty (P ≅ dual S (dual S P)) := sorry

theorem trace_comp_comm (P Q : Module S) (hP : AlmostFiniteProjective S P)
    (hQ : AlmostFiniteProjective S Q) (f : P ⟶ Q) (g : Q ⟶ P) :
    traceElement S P hP (f ≫ g) = traceElement S Q hQ (g ≫ f) := sorry

/-- Exterior powers are the almostified ordinary exterior powers of almost elements. -/
def exteriorPower (n : ℕ) (M : Module S) : Module S :=
  (toAlmost S).obj (ModuleCat.of V (⋀[V]^n ((elements S).obj M)))

theorem exteriorPower_vanish (M : Module S) (n : ℕ)
    (hM : UniformlyAlmostFiniteProjective S M n) : IsZero (exteriorPower S (n + 1) M) := sorry

