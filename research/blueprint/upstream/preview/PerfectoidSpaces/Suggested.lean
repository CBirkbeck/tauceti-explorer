/-! ### Layer 2: Rational subsets and their restriction maps -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open TauCeti Huber ValuationSpectrum CategoryTheory
variable (p : ℕ) [Fact p.Prime] (R : PairCat.{0} p)

/-! ### P2/perfectoid-pair-rational-restriction -/

/-- Rational opens as subsets of the actual valuation spectrum. -/
abbrev RationalOpen := {U : Set (spa R.pair.plus) // U ∈ spaRationalFamily R.pair.plus}

/-- The completed pair on a rational subset, independent of its presentation.
Its map and localization universal property are given below. -/
def rationalPair (U : RationalOpen p R) : PairCat.{0} p := sorry

def rationalMap (U : RationalOpen p R) : R ⟶ rationalPair p R U := sorry

theorem rationalPair_universal (U : RationalOpen p R) (S : PairCat.{0} p) (f : R ⟶ S) :
    Set.range f.spaComap ⊆ U.val ↔
      ∃! g : rationalPair p R U ⟶ S, rationalMap p R U ≫ g = f := sorry

theorem rationalMap_image (U : RationalOpen p R) :
    Set.range (rationalMap p R U).spaComap = U.val := sorry

/-- A comparison with the pinned completed-presentation carrier, including topology,
plus subring, and the base map. -/
theorem rationalPair_presentation (U : RationalOpen p R) (D : PairOfDefinition R)
    (q : D.Presentation) (h : Ideal.span (q.num : Set R) = ⊤)
    (hU : U.val = Subtype.val ⁻¹' rationalSubset R.pair.plus q.num q.den) :
    ∃ e : rationalPair p R U ≃+* RationalLoc q,
      Continuous e ∧ Continuous e.symm ∧
      (rationalPair p R U).pair.plus.map e.toRingHom = (RationalLoc.pair q R.pair).plus ∧
      e.toRingHom.comp (rationalMap p R U).toRingHom =
        (RationalLoc.structureMap q R.pair).toRingHom := sorry

/-- Restriction for an inclusion of rational subsets. -/
def rationalRes (U V : RationalOpen p R) (h : V.val ⊆ U.val) :
    rationalPair p R U ⟶ rationalPair p R V := sorry

theorem rationalRes_base (U V : RationalOpen p R) (h : V.val ⊆ U.val) :
    rationalMap p R U ≫ rationalRes p R U V h = rationalMap p R V := sorry

theorem rationalRes_unique (U V : RationalOpen p R) (h : V.val ⊆ U.val)
    (f : rationalPair p R U ⟶ rationalPair p R V)
    (hf : rationalMap p R U ≫ f = rationalMap p R V) : f = rationalRes p R U V h := sorry

/-- The functor of rational pairs is contravariant in inclusion of subsets. -/
def rationalPairFunctor : (RationalOpen p R)ᵒᵖ ⥤ PairCat.{0} p where
  obj U := rationalPair p R U.unop
  map f := rationalRes p R _ _ (leOfHom f.unop)
  map_id := by sorry
  map_comp := by sorry

theorem rationalPairFunctor_map {U V : (RationalOpen p R)ᵒᵖ} (f : U ⟶ V) :
    (rationalPairFunctor p R).map f = rationalRes p R U.unop V.unop (leOfHom f.unop) := rfl

/-- The restriction is itself a rational localization, Sch12 Theorem 6.3. -/
theorem rationalPairFunctor.isRationalLocalization_map
    (U V : RationalOpen p R) (h : V.val ⊆ U.val) :
    ∃ (T : Finset (rationalPair p R U)) (t : rationalPair p R U),
      TauCetiRoadmap.AdicEtaleGeometry.CAff.IsRationalLocalization
        (TauCetiRoadmap.AdicEtaleGeometry.CAff.ofHom (rationalRes p R U V h)) T t := sorry

/-- The plus ring is detected by all points, Wedhorn Proposition 7.52(1). -/
theorem rationalPairFunctor.mem_plus_iff (U : RationalOpen p R) (a : rationalPair p R U) :
    a ∈ (rationalPair p R U).pair.plus ↔
      ∀ x : spa (rationalPair p R U).pair.plus, x.val.valuation a ≤ 1 := sorry

/-- The integral and power-bounded rational sections differ by an almost zero quotient. -/
theorem rationalPairFunctor.isAlmostZero_powerBounded_quot_plus
    (U : RationalOpen p R) (ϖ : PseudoUniformizerRoots p R)
    (a : powerBoundedSubring (rationalPair p R U)) (n : ℕ) :
    (rationalMap p R U).toRingHom (ϖ.root n) * a.val ∈ (rationalPair p R U).pair.plus := sorry

-- Check: rationalPairFunctor_whole
example (U : RationalOpen p R) (hU : U.val = Set.univ) :
    Nonempty ((rationalPairFunctor p R).obj (Opposite.op U) ≅ R) := sorry
-- Check: rationalPairFunctor_empty
example (U : RationalOpen p R) (hU : U.val = ∅) :
    Subsingleton ((rationalPairFunctor p R).obj (Opposite.op U)) := sorry
-- Check: rationalPairFunctor_proper
example (U : RationalOpen p R) (hU : U.val ≠ Set.univ) :
    ¬ Function.Surjective (rationalMap p R U).spaComap := sorry

/-- The tilted rational subset uses the named valuation homeomorphism. -/
def tiltRationalOpen (U : RationalOpen p R) :
    RationalOpen p ((PairCat.tiltFunctor p).obj R) :=
  ⟨PerfectoidSpace.spaTilt p R.pair '' U.val,
    (PerfectoidSpace.isRational_image_spaTilt_iff p R.pair U.val).mp U.property⟩

def rationalTiltIso (U : RationalOpen p R) :
    (PairCat.tiltFunctor p).obj (rationalPair p R U) ≅
      rationalPair p ((PairCat.tiltFunctor p).obj R) (tiltRationalOpen p R U) := sorry

theorem rationalTiltIso_base (U : RationalOpen p R) :
    (PairCat.tiltFunctor p).map (rationalMap p R U) ≫ (rationalTiltIso p R U).hom =
      rationalMap p ((PairCat.tiltFunctor p).obj R) (tiltRationalOpen p R U) := sorry

theorem rationalTiltIso_restriction (U V : RationalOpen p R) (h : V.val ⊆ U.val) :
    (PairCat.tiltFunctor p).map (rationalRes p R U V h) ≫ (rationalTiltIso p R V).hom =
      (rationalTiltIso p R U).hom ≫
        rationalRes p ((PairCat.tiltFunctor p).obj R)
          (tiltRationalOpen p R U) (tiltRationalOpen p R V) (Set.image_mono h) := sorry

theorem rationalPairFunctor.spaTilt_comm (U : RationalOpen p R)
    (x : spa (rationalPair p R U).pair.plus) :
    PerfectoidSpace.spaTilt p R.pair ((rationalMap p R U).spaComap x) =
      (((PairCat.tiltFunctor p).map (rationalMap p R U)).spaComap)
        (PerfectoidSpace.spaTilt p (rationalPair p R U).pair x) := sorry

-- Check: rational_subset_whole
example (U : RationalOpen p R) (hU : U.val = Set.univ) : IsIso (rationalMap p R U) := sorry
-- Check: rational_subset_empty
example (U : RationalOpen p R) (hU : U.val = ∅) : Subsingleton (rationalPair p R U) := sorry
-- Check: rational_subset_proper
example (U : RationalOpen p R) (hU : U.val ≠ Set.univ) : ¬ IsIso (rationalMap p R U) := sorry
-- Check: rational_restriction_identity
example (U : RationalOpen p R) : rationalRes p R U U (Set.Subset.refl _) = 𝟙 _ := sorry
-- Check: rational_restriction_composition
example (U V W : RationalOpen p R) (hVU : V.val ⊆ U.val) (hWV : W.val ⊆ V.val) :
    rationalRes p R U V hVU ≫ rationalRes p R V W hWV =
      rationalRes p R U W (hWV.trans hVU) := sorry
-- Check: rational_restriction_empty
example (U V : RationalOpen p R) (h : V.val ⊆ U.val) (hV : V.val = ∅)
    (a : rationalPair p R U) : (rationalRes p R U V h).toRingHom a = 0 := sorry
-- Check: rational_tilt_empty
example (U : RationalOpen p R) (h : U.val = ∅) : (tiltRationalOpen p R U).val = ∅ := by
  change PerfectoidSpace.spaTilt p R.pair '' U.val = ∅
  rw [h, Set.image_empty]
-- Check: rational_tilt_whole
example (U : RationalOpen p R) (h : U.val = Set.univ) :
    (tiltRationalOpen p R U).val = Set.univ := sorry
-- Check: rational_tilt_injective
example (U V : RationalOpen p R) : tiltRationalOpen p R U = tiltRationalOpen p R V ↔ U = V := sorry
-- Check: rational_tilt_zero_one
example (U : RationalOpen p R) :
    (rationalTiltIso p R U).hom.toRingHom 0 = 0 ∧
      (rationalTiltIso p R U).hom.toRingHom 1 = 1 := ⟨map_zero _, map_one _⟩
-- Check: rational_tilt_empty_ring
example (U : RationalOpen p R) (h : U.val = ∅)
    (a : (PairCat.tiltFunctor p).obj (rationalPair p R U)) :
    (rationalTiltIso p R U).hom.toRingHom a = 0 := sorry
-- Check: rational_tilt_base_coordinate
example (U : RationalOpen p R) (a : (PairCat.tiltFunctor p).obj R) :
    (rationalTiltIso p R U).hom.toRingHom
      (((PairCat.tiltFunctor p).map (rationalMap p R U)).toRingHom a) =
    (rationalMap p ((PairCat.tiltFunctor p).obj R) (tiltRationalOpen p R U)).toRingHom a := sorry
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
end

