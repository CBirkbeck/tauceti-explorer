variable {V : Type u} [CommRing V] (S : BasicSetup V)

/-! ### P0/almost-isomorphisms-are-monoidal -/

/-- The almost isomorphisms form a monoidal morphism property of
`ModuleCat V` (GR (2.2.5)). -/
instance isoModSerre_isMonoidal : S.almostZero.isoModSerre.IsMonoidal := sorry

/-! ### P0/almost-modules-over-perfectoid-base -/

/-- The Serre quotient, equipped with its localized tensor product (GR (2.2.2), (2.2.11)). -/
abbrev Module : Type (u + 1) :=
  LocalizedMonoidal S.almostZero.isoModSerre.Q' S.almostZero.isoModSerre
    (Iso.refl (S.almostZero.isoModSerre.Q'.obj (𝟙_ (ModuleCat.{u} V))))

/-- Almostification is the monoidal Serre-localization functor. -/
abbrev toAlmost : ModuleCat.{u} V ⥤ Module S :=
  Localization.Monoidal.toMonoidalCategory S.almostZero.isoModSerre.Q'
    S.almostZero.isoModSerre (Iso.refl _)

namespace Module

instance : Preadditive (Module S) := inferInstanceAs (Preadditive S.Firm)
instance : Linear V (Module S) := inferInstanceAs (Linear V S.Firm)
instance instAbelian : Abelian (Module S) := inferInstanceAs (Abelian S.Firm)

/-- The comparison with the firm model of the quotient, GR Proposition 2.2.21. -/
def firmEquiv : Module S ≌ S.Firm := CategoryTheory.Equivalence.refl

/-! ### P0/almost-hom-and-adjoints -/

/-- Almost elements, using the closed firm representative, GR Proposition 2.2.13. -/
def elements : Module S ⥤ ModuleCat.{u} V := (firmEquiv S).functor ⋙ S.closure

/-- The left adjoint, using the underlying firm representative, GR Proposition 2.2.21. -/
def shriek : Module S ⥤ ModuleCat.{u} V := (firmEquiv S).functor ⋙ BasicSetup.Firm.ι S

/-- Almostification is left adjoint to almost elements, GR Proposition 2.2.13. -/
def adjElements : toAlmost S ⊣ elements S := sorry

/-- The firm representative is left adjoint to almostification, GR Proposition 2.2.21. -/
def adjShriek : shriek S ⊣ toAlmost S := sorry

/-- The classical quotient recovers modules, GR Example 2.1.2(ii). -/
def classicalEquiv : ModuleCat.{u} V ≌ Module (BasicSetup.classical V) where
  functor := toAlmost (BasicSetup.classical V)
  inverse := elements (BasicSetup.classical V)
  unitIso := sorry
  counitIso := sorry

/-! ### P0/almost-tensor-and-internal-hom -/

/-- Almostified Hom, GR (2.2.10). -/
def alHom (M N : Module S) : Module S :=
  (toAlmost S).obj (ModuleCat.of V (M ⟶ N))

/-! ### P0/almost-hom-formula -/

/-- The Hom formula is linear over the original base ring, GR (2.2.4). -/
def homLinearEquiv (M N : ModuleCat.{u} V) :
    ((toAlmost S).obj M ⟶ (toAlmost S).obj N) ≃ₗ[V] (S.tilde ⊗[V] M →ₗ[V] N) := sorry

/-- The Hom formula sends an almost map to its representative after the canonical
almost isomorphism `m̃ ⊗ M → M`, GR (2.2.4), p. 12. -/
theorem homLinearEquiv_apply (M N : ModuleCat.{u} V)
    (f : (toAlmost S).obj M ⟶ (toAlmost S).obj N) :
    (toAlmost S).map (ModuleCat.ofHom (X := S.tilde ⊗[V] M) (homLinearEquiv S M N f)) =
      (toAlmost S).map (ModuleCat.ofHom (X := S.tilde ⊗[V] M) (S.tildeAct M)) ≫ f := sorry

/-- An almost-module morphism annihilated by the setup ideal is zero,
GR (2.2.4), p. 12. -/
theorem hom_eq_zero_of_ideal_smul {M N : Module S} (f : M ⟶ N)
    (hf : ∀ ε ∈ S.ideal, ε • f = 0) : f = 0 := sorry

/-- Naturality in both ordinary module variables, GR (2.2.4), p. 12. -/
theorem homLinearEquiv_natural {M M' N N' : ModuleCat.{u} V}
    (a : M' ⟶ M) (b : N ⟶ N')
    (f : (toAlmost S).obj M ⟶ (toAlmost S).obj N) :
    homLinearEquiv S M' N' ((toAlmost S).map a ≫ f ≫ (toAlmost S).map b) =
      b.hom.comp ((homLinearEquiv S M N f).comp
        (TensorProduct.map (LinearMap.id : S.tilde →ₗ[V] S.tilde) a.hom)) := sorry

