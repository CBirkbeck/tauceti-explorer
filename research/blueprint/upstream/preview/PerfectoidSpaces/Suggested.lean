/-! ### P1/integral-perfectoid-rings -/
-- Check: isIntegralPerfectoid_completed_radical
example (r : ℕ → ℂ_[p]) (hzero : r 0 = p) (hroot : ∀ n, r (n + 1) ^ p = r n) :
    let O := (PadicComplexInt p).comap (Almost.kummerField p r).subtype
    IsIntegralPerfectoid p O ∧
      ∃ π : O, π.val.val = r 1 ∧ π ^ p = p ∧ IsAdicComplete (Ideal.span {π}) O := sorry

/-! ### P1/completed-colimit-of-perfectoid-tate-rings -/
-- Check: completedFilteredColimit_nonPerfectoid_tower
