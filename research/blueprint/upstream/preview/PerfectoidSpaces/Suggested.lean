/-! ### P0/adic-almost-projective-modules -/

/-- Compatible modules over A/I^(n+1); transition isomorphisms are scalar extension,
not isomorphisms of the underlying A-modules. -/
structure AdicModule where
  obj : ∀ n : ℕ, Module (S.baseChange ((Algebra.elements S).obj
    ((Algebra.adicSystem S A I).obj (op n))))
  transition : ∀ n : ℕ,
    (baseChange S ((Algebra.adicSystem S A I).map (homOfLE (Nat.le_succ n)).op)).obj
      (obj (n + 1)) ≅ obj n

namespace AdicModule
variable {S A I}
structure Hom (M N : AdicModule S A I) where
  app : ∀ n, M.obj n ⟶ N.obj n
  comm : ∀ n,
    (baseChange S ((Algebra.adicSystem S A I).map (homOfLE (Nat.le_succ n)).op)).map
      (app (n + 1)) ≫ (N.transition n).hom = (M.transition n).hom ≫ app n

instance : Category (AdicModule S A I) where
  Hom := Hom
  id M := ⟨fun _ ↦ 𝟙 _, by sorry⟩
  comp f g := ⟨fun n ↦ f.app n ≫ g.app n, by sorry⟩
  id_comp := by sorry
  comp_id := by sorry
  assoc := by sorry

/-- Evaluation retains the actual module over the nth quotient. -/
def evaluation (n : ℕ) : AdicModule S A I ⥤
    Module (S.baseChange ((Algebra.elements S).obj ((Algebra.adicSystem S A I).obj (op n)))) where
  obj M := M.obj n
  map f := f.app n

end AdicModule

/-- Adic reduction of a module, with its canonical adjacent base-change isomorphisms. -/
def adicReduction : Module (S.baseChange ((Algebra.elements S).obj A)) ⥤ AdicModule S A I where
  obj M :=
    { obj := fun n ↦ (baseChange S (Algebra.quotientMap S A (I ^ (n + 1)))).obj M
      transition := by sorry }
  map f := ⟨fun n ↦ (baseChange S (Algebra.quotientMap S A (I ^ (n + 1)))).map f, by sorry⟩
  map_id := by sorry
  map_comp := by sorry

theorem adicReduction_evaluation (n : ℕ) :
    adicReduction S A I ⋙ AdicModule.evaluation n =
      baseChange S (Algebra.quotientMap S A (I ^ (n + 1))) := rfl

/-- GR 5.3.24: reduction is an equivalence on almost finite projective modules. -/
theorem adic_almost_projective_equivalence
    (ht : Algebra.IsTight S A I) (hc : Algebra.IsAdicComplete S A I) :
    ∃ e : (ObjectProperty.FullSubcategory
      (AlmostFiniteProjective (S.baseChange ((Algebra.elements S).obj A)))) ≌
      ObjectProperty.FullSubcategory (fun M : AdicModule S A I ↦ ∀ n,
        AlmostFiniteProjective (S.baseChange ((Algebra.elements S).obj
          ((Algebra.adicSystem S A I).obj (op n)))) (M.obj n)),
      Nonempty (ObjectProperty.ι _ ⋙ adicReduction S A I ≅ e.functor ⋙ ObjectProperty.ι _) := sorry

/-- GR 5.3.24 and Claim 5.3.25: finite generation at level zero suffices for a
compatible system to come from an almost finitely generated module. -/
theorem adic_almost_finitely_generated
    (ht : Algebra.IsTight S A I) (hc : Algebra.IsAdicComplete S A I)
    (D : AdicModule S A I)
    (hD : AlmostFG (S.baseChange ((Algebra.elements S).obj
      ((Algebra.adicSystem S A I).obj (op 0)))) ((elements _).obj (D.obj 0))) :
    ∃ M : Module (S.baseChange ((Algebra.elements S).obj A)),
      AlmostFG (S.baseChange ((Algebra.elements S).obj A)) ((elements _).obj M) ∧ Nonempty ((adicReduction S A I).obj M ≅ D) := sorry

-- Check: AdicModule_zero_ideal; adicReduction_zero_ideal; evaluation_zero_ideal
example : (adicReduction S A ⊥).IsEquivalence := sorry
