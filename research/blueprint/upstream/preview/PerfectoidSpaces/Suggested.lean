theorem cofilteredLimit_prodProfinite_π {I : Type} [SmallCategory I] [IsCofiltered I]
    (S : I ⥤ Profinite.{0}) (hS : ∀ i, Finite (S.obj i)) (R : PairCat.{0} p) (i : I) :
