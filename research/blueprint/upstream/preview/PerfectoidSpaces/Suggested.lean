noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.CotangentComplex
open _root_.CategoryTheory _root_.CategoryTheory.Limits Opposite ZeroObject
open scoped Simplicial TensorProduct
universe u
local instance (f : Arrow CommRingCat.{u}) : Algebra f.left f.right := f.hom.hom.toAlgebra

/-- The polynomial resolution of a ring arrow, with its given scalar map. -/
def arrowResolution (f : Arrow CommRingCat.{u}) : PolynomialResolution f.left f.right :=
  letI := f.hom.hom.toAlgebra
  resolution f.left f.right

/-- Underlying rings in the standard resolution. -/
def resolutionRings (f : Arrow CommRingCat.{u}) : SimplicialObject CommRingCat.{u} :=
  (arrowResolution f).augmentation.left ⋙ forget₂ (CommAlgCat.{u} f.left) CommRingCat

/-- Functoriality of the standard free resolution for a commutative square. -/
def resolutionRingMap {f g : Arrow CommRingCat.{u}} (a : f ⟶ g) :
    resolutionRings f ⟶ resolutionRings g := sorry

theorem resolutionRingMap_augmentation {f g : Arrow CommRingCat.{u}} (a : f ⟶ g)
    (n : ℕ) (x : (arrowResolution f).ring n) :
    ((arrowResolution g).augmentation.hom.app (op ⦋n⦌) ≫ (arrowResolution g).target.hom).hom
      ((resolutionRingMap a).app (op ⦋n⦌) x) =
    a.right.hom (((arrowResolution f).augmentation.hom.app (op ⦋n⦌) ≫
      (arrowResolution f).target.hom).hom x) := sorry

theorem resolutionRingMap_scalars {f g : Arrow CommRingCat.{u}} (a : f ⟶ g)
    (n : ℕ) (r : f.left) :
    (resolutionRingMap a).app (op ⦋n⦌) (algebraMap f.left ((arrowResolution f).ring n) r) =
      algebraMap g.left ((arrowResolution g).ring n) (a.left.hom r) := sorry

-- Check: resolutionRingMap_identity
example (f : Arrow CommRingCat.{u}) : resolutionRingMap (𝟙 f) = 𝟙 _ := sorry
-- Check: resolutionRingMap_composition
example {f g h : Arrow CommRingCat.{u}} (a : f ⟶ g) (b : g ⟶ h) :
    resolutionRingMap (a ≫ b) = resolutionRingMap a ≫ resolutionRingMap b := sorry
-- Check: resolutionRingMap_zero_target
example {f g : Arrow CommRingCat.{u}} (a : f ⟶ g) [Subsingleton g.right]
    (n : ℕ) (x : (arrowResolution f).ring n) :
    ((arrowResolution g).augmentation.hom.app (op ⦋n⦌) ≫ (arrowResolution g).target.hom).hom
      ((resolutionRingMap a).app (op ⦋n⦌) x) = 0 := sorry

/-- Forget only the scalars, retaining every term and differential of the cotangent model. -/
def arrowModel (f : Arrow CommRingCat.{u}) : ChainComplex AddCommGrpCat.{u} ℕ :=
  ((forget₂ (ModuleCat.{u} f.right) AddCommGrpCat).mapHomologicalComplex _).obj
    (arrowResolution f).complex

/-- The map of cotangent complexes induced by a square of rings. -/
def arrowModelMap {f g : Arrow CommRingCat.{u}} (a : f ⟶ g) : arrowModel f ⟶ arrowModel g := sorry

/-- This equation on generators determines the map in each degree. -/
theorem arrowModelMap_tmul {f g : Arrow CommRingCat.{u}} (a : f ⟶ g)
    (n : ℕ) (t : f.right) (x : (arrowResolution f).ring n) :
    ((arrowResolution g).termIso n).hom.hom
      ((arrowModelMap a).f n (((arrowResolution f).termIso n).inv.hom
        (t ⊗ₜ[(arrowResolution f).ring n] KaehlerDifferential.D f.left ((arrowResolution f).ring n) x))) =
      a.right.hom t ⊗ₜ[(arrowResolution g).ring n]
        KaehlerDifferential.D g.left ((arrowResolution g).ring n)
          ((resolutionRingMap a).app (op ⦋n⦌) x) := sorry

/-- The canonical scalar extension sends c ⊗ x to c times the functorial image of x. -/
theorem transitivityFirst_tmul (A B C : Type u) [CommRing A] [CommRing B] [CommRing C]
    [Algebra A B] [Algebra B C] [Algebra A C] [IsScalarTower A B C]
    (n : ℕ) (c : C) (x : (model A B).X n) :
    let f := Arrow.mk (CommRingCat.ofHom (algebraMap A B))
    let g := Arrow.mk (CommRingCat.ofHom (algebraMap A C))
    let a : f ⟶ g := Arrow.homMk (𝟙 _) (CommRingCat.ofHom (algebraMap B C)) (by sorry)
    (transitivityFirst A B C).f n (c ⊗ₜ[B] x) =
      c • (show (model A C).X n from (arrowModelMap a).f n x) := sorry

/-- Changing the base A → B and fixing C gives exactly the functorial chain map. -/
theorem transitivitySecond_apply (A B C : Type u) [CommRing A] [CommRing B] [CommRing C]
    [Algebra A B] [Algebra B C] [Algebra A C] [IsScalarTower A B C]
    (n : ℕ) (x : (model A C).X n) :
    let f := Arrow.mk (CommRingCat.ofHom (algebraMap A C))
    let g := Arrow.mk (CommRingCat.ofHom (algebraMap B C))
    let b : f ⟶ g := Arrow.homMk (CommRingCat.ofHom (algebraMap A B)) (𝟙 _) (by sorry)
    (transitivitySecond A B C).f n x = (arrowModelMap b).f n x := sorry

/-- Functorial cotangent chains of ring maps, with additive carriers. -/
def arrowFunctor : Arrow CommRingCat.{u} ⥤ ChainComplex AddCommGrpCat.{u} ℕ where
  obj := arrowModel
  map := arrowModelMap
  map_id := by sorry
  map_comp := by sorry

-- Check: arrowFunctor_identity; arrowModel_identity; arrowModelMap_identity;
-- Check: arrowResolution_identity; resolutionRings_identity
example (R : CommRingCat.{u}) (n : ℕ) : IsZero ((arrowFunctor.obj (Arrow.mk (𝟙 R))).homology n) := sorry
-- Check: arrowFunctor_polynomial; arrowModel_polynomial; arrowModelMap_polynomial;
-- Check: arrowResolution_polynomial; resolutionRings_polynomial
example (R : CommRingCat.{u}) (n : ℕ) (hn : 0 < n) :
    IsZero ((arrowFunctor.obj (Arrow.mk (CommRingCat.ofHom (algebraMap R (Polynomial R))))).homology n) := sorry
-- Check: arrowFunctor_regular_quotient; arrowModel_regular_quotient; arrowModelMap_regular_quotient;
-- Check: arrowResolution_regular_quotient; resolutionRings_regular_quotient
example : ¬ IsZero ((arrowFunctor.obj (Arrow.mk (CommRingCat.ofHom (Int.castRingHom (ZMod 2))))).homology 1) := sorry

/-- Stacks 08S9: filtered colimits commute with the full cotangent model, including its
canonical transition maps. Colimits of arrows are computed on both rings. -/
theorem filteredColimit {I : Type u} [SmallCategory I] [IsFiltered I]
    (F : I ⥤ Arrow CommRingCat.{u}) (c : Cocone F) (hc : IsColimit c) :
    Nonempty (IsColimit (arrowFunctor.mapCocone c)) := sorry

/-- Total chains of the simplicial cotangent complexes. Both indices are homological. -/
def diagonalModel (F : SimplicialObject (Arrow CommRingCat.{u})) : ChainComplex AddCommGrpCat.{u} ℕ :=
  HomologicalComplex₂.total ((AlgebraicTopology.alternatingFaceMapComplex _).obj (F ⋙ arrowFunctor)) (ComplexShape.down ℕ)

-- Check: diagonalModel_constant
example (f : Arrow CommRingCat.{u}) :
    ∃ q : diagonalModel ((Functor.const _).obj f) ⟶ arrowModel f, QuasiIso q := sorry
-- Check: diagonalModel_identity
example (R : SimplicialObject CommRingCat.{u})
    (F : SimplicialObject (Arrow CommRingCat.{u}))
    (h : ∀ n, F.obj n = Arrow.mk (𝟙 (R.obj n))) (i : ℕ) :
    IsZero ((diagonalModel F).homology i) := sorry
-- Check: diagonalModel_regular_quotient
example : ¬ IsZero ((diagonalModel ((Functor.const _).obj
    (Arrow.mk (CommRingCat.ofHom (Int.castRingHom (ZMod 2)))))).homology 1) := sorry

/-- Illusie II 1.2.6.2: the first-quadrant spectral sequence and its finite filtration
on the abutment. The page differentials have bidegree (-r,r-1). -/
theorem diagonalComparison (F : SimplicialObject (Arrow CommRingCat.{u})) :
    ∃ E : SpectralSequence AddCommGrpCat.{u}
        (fun r : ℤ ↦ ComplexShape.spectralSequenceNat (-r, r - 1)) 1,
      (∀ i j : ℕ, Nonempty ((E.page 1 (by omega)).X (i,j) ≅ ((arrowFunctor.obj (F.obj (op ⦋i⦌))).homology j))) ∧
      ∀ n : ℕ, ∃ filtration : Fin (n + 2) → AddSubgroup ((diagonalModel F).homology n),
        Monotone filtration ∧ filtration 0 = ⊥ ∧ filtration (Fin.last (n + 1)) = ⊤ ∧
        ∀ i : Fin (n + 1), Nonempty
          (AddCommGrpCat.of ((filtration i.succ) ⧸
            (filtration i.castSucc).comap (filtration i.succ).subtype) ≅
              (E.page (n + 2) (by omega)).X (i.val, n - i.val)) := sorry

/-- For resolutions of both rings the augmentation induces the cotangent comparison.
The extra degeneracies are on underlying sets, so this applies to free resolutions. -/
theorem diagonalComparison_resolution (F : SimplicialObject.Augmented (Arrow CommRingCat.{u}))
    (hleft : SimplicialObject.Augmented.ExtraDegeneracy
      (((SimplicialObject.Augmented.whiskering _ _).obj
        (Arrow.leftFunc ⋙ forget CommRingCat)).obj F))
    (hright : SimplicialObject.Augmented.ExtraDegeneracy
      (((SimplicialObject.Augmented.whiskering _ _).obj
        (Arrow.rightFunc ⋙ forget CommRingCat)).obj F)) :
    ∃ q : diagonalModel F.left ⟶ arrowModel F.right, QuasiIso q := sorry

end TauCetiRoadmap.PerfectoidSpaces.CotangentComplex
end
noncomputable section
set_option backward.isDefEq.respectTransparency false
namespace TauCetiRoadmap.PerfectoidSpaces.Almost
open _root_.CategoryTheory _root_.CategoryTheory.Limits Opposite ZeroObject
open scoped Simplicial TensorProduct
universe u
variable {V : Type u} [CommRing V] (S : BasicSetup V)

/-- The cotangent model with its base V-action retained. -/
def cotangentBaseModel (f : Arrow (Algebra S)) : ChainComplex (ModuleCat.{u} V) ℕ :=
  ((ModuleCat.restrictScalars (algebraMap V ((Algebra.shriekShriek S).obj f.right))).mapHomologicalComplex _).obj
    (cotangentModel S f.hom)

/-- Functoriality of the exactified, lower-shriek-shriek construction. -/
def cotangentBaseMap {f g : Arrow (Algebra S)} (a : f ⟶ g) :
    cotangentBaseModel S f ⟶ cotangentBaseModel S g := sorry

/-- The scalar-extended polynomial differential generators specify this map. -/
theorem cotangentBaseMap_tmul {f g : Arrow (Algebra S)} (a : f ⟶ g) (n : ℕ) :
    let A := (Algebra.shriekShriek S).obj ((Algebra.exactification S).obj f.left)
    let B := (Algebra.shriekShriek S).obj ((Algebra.exactification S).obj f.right)
    let A' := (Algebra.shriekShriek S).obj ((Algebra.exactification S).obj g.left)
    let B' := (Algebra.shriekShriek S).obj ((Algebra.exactification S).obj g.right)
    let f₀ := CommRingCat.ofHom (((Algebra.shriekShriek S).map ((Algebra.exactification S).map f.hom)).hom.toRingHom)
    let g₀ := CommRingCat.ofHom (((Algebra.shriekShriek S).map ((Algebra.exactification S).map g.hom)).hom.toRingHom)
    letI : _root_.Algebra (Arrow.mk f₀).left (Arrow.mk f₀).right := f₀.hom.toAlgebra
    letI : _root_.Algebra (Arrow.mk g₀).left (Arrow.mk g₀).right := g₀.hom.toAlgebra
    let a₀ : Arrow.mk f₀ ⟶ Arrow.mk g₀ :=
      Arrow.homMk
        (CommRingCat.ofHom (((Algebra.shriekShriek S).map ((Algebra.exactification S).map a.left)).hom.toRingHom))
        (CommRingCat.ofHom (((Algebra.shriekShriek S).map ((Algebra.exactification S).map a.right)).hom.toRingHom)) (by sorry)
    letI : _root_.Algebra B ((Algebra.shriekShriek S).obj f.right) := ((Algebra.shriekShriek S).map ((Algebra.exactificationπ S).app f.right)).hom.toAlgebra
    letI : _root_.Algebra B' ((Algebra.shriekShriek S).obj g.right) := ((Algebra.shriekShriek S).map ((Algebra.exactificationπ S).app g.right)).hom.toAlgebra
    letI : _root_.Module B ((CotangentComplex.arrowModel (Arrow.mk f₀)).X n) :=
      inferInstanceAs (_root_.Module B ((CotangentComplex.arrowResolution (Arrow.mk f₀)).complex.X n))
    letI : _root_.Module B' ((CotangentComplex.arrowModel (Arrow.mk g₀)).X n) :=
      inferInstanceAs (_root_.Module B' ((CotangentComplex.arrowResolution (Arrow.mk g₀)).complex.X n))
    ∀ (b : (Algebra.shriekShriek S).obj f.right)
      (x : (CotangentComplex.arrowModel (Arrow.mk f₀)).X n),
      (cotangentBaseMap S a).f n (b ⊗ₜ[B] x) =
        ((Algebra.shriekShriek S).map a.right).hom b ⊗ₜ[B']
          (CotangentComplex.arrowModelMap a₀).f n x := sorry

/-- Scalar extension of the exactified functorial map determines the first arrow. -/
theorem cotangentTransitivityFirst_tmul {A B C : Algebra S} (f : A ⟶ B) (g : B ⟶ C)
    (n : ℕ) (c : (Algebra.shriekShriek S).obj C) (x : (cotangentModel S f).X n) :
    let a : Arrow.mk f ⟶ Arrow.mk (f ≫ g) := Arrow.homMk (𝟙 A) g (by simp)
    (cotangentTransitivityFirst S f g).f n (c ⊗ₜ[(Algebra.shriekShriek S).obj B] x) =
      c • (show (cotangentModel S (f ≫ g)).X n from (cotangentBaseMap S a).f n x) := sorry

/-- The second arrow is the map induced by changing the base and fixing the target. -/
theorem cotangentTransitivitySecond_apply {A B C : Algebra S} (f : A ⟶ B) (g : B ⟶ C)
    (n : ℕ) (x : (cotangentModel S (f ≫ g)).X n) :
    let b : Arrow.mk (f ≫ g) ⟶ Arrow.mk g := Arrow.homMk f (𝟙 C) (by simp)
    (cotangentTransitivitySecond S f g).f n x = (cotangentBaseMap S b).f n x := sorry

/-- Underlying V-linear cotangent chains of almost algebra maps. -/
def cotangentBaseFunctor : Arrow (Algebra S) ⥤ ChainComplex (ModuleCat.{u} V) ℕ where
  obj := cotangentBaseModel S
  map := cotangentBaseMap S
  map_id := by sorry
  map_comp := by sorry

-- Check: cotangentBaseFunctor_identity; cotangentBaseModel_identity; cotangentBaseMap_identity
example (A : Algebra S) (n : ℕ) :
    IsZero ((cotangentBaseFunctor S).obj (Arrow.mk (𝟙 A)) |>.homology n) ∧
    cotangentBaseMap S (𝟙 (Arrow.mk (𝟙 A))) = 𝟙 _ := sorry
-- Check: cotangentBaseFunctor_classical; cotangentBaseModel_classical; cotangentBaseMap_composition
example (R T : CommAlgCat.{u} V) (f : R ⟶ T)
    {a b c : Arrow (Algebra S)} (h : a ⟶ b) (k : b ⟶ c) :
    letI := f.hom.toAlgebra
    (∀ n, Nonempty (((cotangentBaseFunctor (BasicSetup.classical V)).obj
      (Arrow.mk ((Algebra.toAlmost (BasicSetup.classical V)).map f))).homology n ≅
        (ModuleCat.restrictScalars (algebraMap V T)).obj ((CotangentComplex.model R T).homology n))) ∧
    cotangentBaseMap S (h ≫ k) = cotangentBaseMap S h ≫ cotangentBaseMap S k := sorry
-- Check: cotangentBaseFunctor_regular_quotient; cotangentBaseModel_regular_quotient; cotangentBaseMap_zero
example :
    let S := BasicSetup.classical ℤ
    let f := (Algebra.toAlmost S).map (CommAlgCat.ofHom (Algebra.ofId ℤ (ZMod 2)))
    ¬ IsZero (((cotangentBaseFunctor S).obj (Arrow.mk f)).homology 1) ∧
      cotangentBaseMap S (𝟙 (Arrow.mk f)) ≠ 0 := sorry

/-- GR 2.5.33: the canonical map from the filtered colimit is a quasi-isomorphism.
Restriction of scalars to V is conservative and filtered colimits are exact here. -/
theorem cotangentComplex_colim {I : Type u} [SmallCategory I] [IsFiltered I]
    (F : I ⥤ Arrow (Algebra S)) (c : Cocone F) (hc : IsColimit c) :
    QuasiIso (colimit.desc (F ⋙ cotangentBaseFunctor S) ((cotangentBaseFunctor S).mapCocone c)) := sorry

end TauCetiRoadmap.PerfectoidSpaces.Almost
end
