/-- Adding the base factor produces an exact almost algebra, GR (2.5.15). -/
def exactification : Algebra S ⥤ Algebra S where
  obj A := prod ((toAlmost S).obj (CommAlgCat.of V V)) A
  map f := prod.map (𝟙 _) f
  map_id := by intros; simp
  map_comp := by intros; simp

/-- Projection from the exact algebra to the original algebra. -/
def exactificationπ : exactification S ⟶ 𝟭 (Algebra S) where
  app _ := prod.snd
  naturality := by intros; simp [exactification]

theorem exactification_isExact (A : Algebra S) : IsExact S ((exactification S).obj A) := sorry

/-- A product with the base algebra is exact, GR Proposition 2.2.27. -/
theorem isExact_prod (B : Algebra S) :
    IsExact S (((toAlmost S).obj (CommAlgCat.of V V)) ⨯ B) := sorry

