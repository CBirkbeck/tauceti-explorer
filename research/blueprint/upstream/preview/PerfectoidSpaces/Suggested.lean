noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open _root_.TauCeti _root_.TauCeti.Huber
open scoped Topology
variable (p : ℕ) [Fact p.Prime]
/-- The polynomial algebra on all nonnegative p-power exponents over F_p. -/
abbrev PerfectLaurentPolynomial := AddMonoidAlgebra (ZMod p) (pPowerExponents p)
def perfectLaurentMonomial (n : ℕ) : PerfectLaurentPolynomial p :=
  AddMonoidAlgebra.single ⟨(p : ℚ)⁻¹ ^ n, AddSubmonoid.subset_closure ⟨n, rfl⟩⟩ 1
abbrev PerfectLaurentIntegral := AdicCompletion (Ideal.span {perfectLaurentMonomial p 0})
  (PerfectLaurentPolynomial p)
def perfectLaurentParameter : PerfectLaurentIntegral p :=
  AdicCompletion.of (Ideal.span {perfectLaurentMonomial p 0}) (PerfectLaurentPolynomial p)
    (perfectLaurentMonomial p 0)
/-- Complete F_p[t^(1/p^∞)] at t and then invert t. -/
abbrev completedPerfectLaurentFp := Localization.Away (perfectLaurentParameter p)
def perfectLaurentRoot (n : ℕ) : completedPerfectLaurentFp p :=
  algebraMap (PerfectLaurentIntegral p) _
    (AdicCompletion.of (Ideal.span {perfectLaurentMonomial p 0}) (PerfectLaurentPolynomial p)
      (perfectLaurentMonomial p n))
instance perfectLaurentTopology : TopologicalSpace (completedPerfectLaurentFp p) := sorry
instance perfectLaurentTopologicalRing : IsTopologicalRing (completedPerfectLaurentFp p) := sorry
instance perfectLaurentUniformity : UniformSpace (completedPerfectLaurentFp p) :=
  IsTopologicalAddGroup.rightUniformSpace _
instance perfectLaurentUniformAddGroup : IsUniformAddGroup (completedPerfectLaurentFp p) := sorry
instance perfectLaurentTate : IsTateRing (completedPerfectLaurentFp p) := sorry
instance perfectLaurentComplete : CompleteSpace (completedPerfectLaurentFp p) := sorry
instance perfectLaurentSeparated : T2Space (completedPerfectLaurentFp p) := sorry
instance perfectLaurentPerfectoid : IsPerfectoidTateRing p (completedPerfectLaurentFp p) := sorry
instance perfectLaurentCharP : CharP (completedPerfectLaurentFp p) p := sorry

theorem perfectLaurentTopology_basis :
    (nhds (0 : completedPerfectLaurentFp p)).HasBasis (fun _ : ℕ ↦ True)
      (fun n ↦ {x | ∃ y : PerfectLaurentIntegral p,
        x = algebraMap (PerfectLaurentIntegral p) _ (perfectLaurentParameter p ^ n * y)}) := sorry

