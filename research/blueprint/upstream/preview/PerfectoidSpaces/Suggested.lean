/-! ### Layer 4: Integral perfectoidization -/
namespace PerfectoidSpace
open Perfectoid
open scoped TensorProduct
variable (p : ℕ) [Fact p.Prime]

/-- The telescope test for derived p-completeness of a discrete ring:
RHom(ℤ[1/p], A) vanishes precisely when this difference operator is bijective. -/
def DerivedPComplete (A : Type u) [CommRing A] : Prop :=
  Function.Bijective (fun x : ℕ → A ↦ fun n ↦ x n - (p : A) * x (n + 1))

/-- BS22 §7.1: a derived p-complete quotient of an integral perfectoid ring. -/
structure SemiperfectoidRing where
  carrier : Type u
  [commRing : CommRing carrier]
  complete : DerivedPComplete p carrier
  quotient : ∃ (R : Type u) (_ : CommRing R) (_ : IsIntegralPerfectoid p R)
    (f : R →+* carrier), Function.Surjective f
attribute [instance] SemiperfectoidRing.commRing
instance : CoeSort (SemiperfectoidRing p) (Type u) := ⟨SemiperfectoidRing.carrier⟩

/-- The universal integral perfectoid ring of BS22 Corollary 7.3. -/
def semiperfectoidPerfectoidization (A : SemiperfectoidRing p) : CommRingCat.{u} := sorry
 def semiperfectoidPerfectoidization.ι (A : SemiperfectoidRing p) :
    A →+* semiperfectoidPerfectoidization p A := sorry
 instance semiperfectoidPerfectoidization.perfectoid (A : SemiperfectoidRing p) :
    IsIntegralPerfectoid p (semiperfectoidPerfectoidization p A) := sorry
 instance semiperfectoidPerfectoidization.algebra (A : SemiperfectoidRing p) :
    Algebra A (semiperfectoidPerfectoidization p A) :=
  (semiperfectoidPerfectoidization.ι p A).toAlgebra
 theorem semiperfectoidPerfectoidization_universal (A : SemiperfectoidRing p)
    (B : Type u) [CommRing B] [IsIntegralPerfectoid p B] (f : A →+* B) :
    ∃! g : semiperfectoidPerfectoidization p A →+* B,
      g.comp (semiperfectoidPerfectoidization.ι p A) = f := sorry
 theorem semiperfectoidPerfectoidization_surjective (A : SemiperfectoidRing p) :
    Function.Surjective (semiperfectoidPerfectoidization.ι p A) := sorry
 theorem semiperfectoidPerfectoidization_kernel (A : SemiperfectoidRing p) (a : A) :
    semiperfectoidPerfectoidization.ι p A a = 0 ↔
      ∀ (B : Type u) [CommRing B] [IsIntegralPerfectoid p B] (f : A →+* B), f a = 0 := sorry
 theorem semiperfectoidPerfectoidization_tensor (A : SemiperfectoidRing p)
    (B : Type u) [CommRing B] [IsIntegralPerfectoid p B] [Algebra A B] :
    ∃ e : (semiperfectoidPerfectoidization p A ⊗[A] B) ≃+* B,
      ∀ b : B, e (1 ⊗ₜ[A] b) = b := sorry

