section PerfectedLaurent
variable (p : ℕ) [Fact p.Prime] {R : Type u} [CommRing R] [UniformSpace R]
  [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
  [IsPerfectoidTateRing p R] (ϖ : PseudoUniformizerRoots p R) (σ : Type u)
/-- The additive group of rational p-power exponents. -/
def pPowerIntegers : AddSubgroup ℚ :=
  AddSubgroup.closure (Set.range (fun n : ℕ ↦ (p : ℚ)⁻¹ ^ n))
-- Check: laurent_exponents_signed
example : (-1 : ℚ) ∈ pPowerIntegers p ∧ (1 : ℚ) ∈ pPowerIntegers p := sorry
-- Check: laurent_exponents_root
example : (p : ℚ)⁻¹ ∈ pPowerIntegers p ∧ (p : ℚ) * (p : ℚ)⁻¹ = 1 := sorry
-- Check: laurent_exponents_not_thirds
example : (1 / 3 : ℚ) ∉ pPowerIntegers 2 := sorry

namespace perfectedTateAlgebra
/-- Complete the group algebra with exponent group `ℤ[1/p]`. -/
abbrev laurentIntegral := AdicCompletion
  (Ideal.span {(algebraMap (powerBoundedSubring R)
    (AddMonoidAlgebra (powerBoundedSubring R) (σ →₀ pPowerIntegers p)) (ϖ.rootPB 0))})
  (AddMonoidAlgebra (powerBoundedSubring R) (σ →₀ pPowerIntegers p))
/-- The completed Laurent algebra, obtained by inverting the base pseudo-uniformizer. -/
abbrev laurent := Localization.Away
  (algebraMap (AddMonoidAlgebra (powerBoundedSubring R) (σ →₀ pPowerIntegers p))
    (laurentIntegral p ϖ σ)
    (algebraMap (powerBoundedSubring R)
      (AddMonoidAlgebra (powerBoundedSubring R) (σ →₀ pPowerIntegers p)) (ϖ.rootPB 0)))
namespace laurent
instance : Algebra R (laurent p ϖ σ) := sorry
instance : UniformSpace (laurent p ϖ σ) := sorry
instance : IsUniformAddGroup (laurent p ϖ σ) := sorry
instance : IsTopologicalRing (laurent p ϖ σ) := sorry
instance : IsTateRing (laurent p ϖ σ) := sorry
instance : CompleteSpace (laurent p ϖ σ) := sorry
instance : T2Space (laurent p ϖ σ) := sorry
instance instIsPerfectoidTateRing {R : Type u} [CommRing R] [UniformSpace R]
    [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] (ϖ : PseudoUniformizerRoots p R) (σ : Type u) :
    IsPerfectoidTateRing p (laurent p ϖ σ) := sorry

def X (s : σ) (a : pPowerIntegers p) : laurent p ϖ σ :=
  algebraMap (laurentIntegral p ϖ σ) _
    (algebraMap (AddMonoidAlgebra (powerBoundedSubring R) (σ →₀ pPowerIntegers p)) _
      (AddMonoidAlgebra.single (Finsupp.single s a) 1))

theorem hasBasis_nhds_zero : (𝓝 (0 : laurent p ϖ σ)).HasBasis (fun n : ℕ ↦ 0 ≤ n)
    (fun n ↦ {x | ∃ y : laurentIntegral p ϖ σ,
      x = algebraMap R _ (ϖ.root 0) ^ n * algebraMap _ _ y}) := sorry

theorem algebraMap_integral (x : powerBoundedSubring R) :
    algebraMap R (laurent p ϖ σ) x.val =
      algebraMap (laurentIntegral p ϖ σ) _
        (algebraMap (AddMonoidAlgebra (powerBoundedSubring R) (σ →₀ pPowerIntegers p)) _
          (algebraMap (powerBoundedSubring R) _ x)) := sorry

-- Check: laurent_inverse_monomial
example (s : σ) : X p ϖ σ s ⟨1, AddSubgroup.subset_closure ⟨0, by simp⟩⟩ * X p ϖ σ s ⟨-1, by sorry⟩ = 1 ∧
    X p ϖ σ s ⟨-1, by sorry⟩ ∈ powerBoundedSubring (laurent p ϖ σ) := sorry
-- Check: laurent_empty
example : ∃ e : laurent p ϖ PEmpty.{u+1} ≃ₐ[R] R,
    Continuous e ∧ Continuous e.symm := sorry
-- Check: laurent_zero
example [Subsingleton R] : Subsingleton (laurentIntegral p ϖ σ) ∧
    Subsingleton (laurent p ϖ σ) := sorry
-- Check: laurent_two_roots
example (s : σ) :
    X p ϖ σ s ⟨(p : ℚ)⁻¹, AddSubgroup.subset_closure ⟨1, by simp⟩⟩ ^ p = X p ϖ σ s ⟨1, AddSubgroup.subset_closure ⟨0, by simp⟩⟩ ∧
    X p ϖ σ s ⟨(p : ℚ)⁻¹ ^ 2, AddSubgroup.subset_closure ⟨2, rfl⟩⟩ ^ p =
      X p ϖ σ s ⟨(p : ℚ)⁻¹, AddSubgroup.subset_closure ⟨1, by simp⟩⟩ := sorry
end laurent

theorem algebraMap_integral (x : powerBoundedSubring R) :
    algebraMap R (perfectedTateAlgebra p ϖ σ) x.val =
      algebraMap (perfectedTateIntegral p ϖ σ) _
        (algebraMap (AddMonoidAlgebra (powerBoundedSubring R) (σ →₀ pPowerExponents p)) _
          (algebraMap (powerBoundedSubring R) _ x)) := sorry
end perfectedTateAlgebra
end PerfectedLaurent

section MarkedComparisons
variable (p : ℕ) [Fact p.Prime]
namespace MarkedUntilt
/-- Enlarging the plus ring changes the integral model, not the marked untilt classification. -/
def plusEquiv (P : PairCat.{u} p) (hp : (p : P) = 0) :
