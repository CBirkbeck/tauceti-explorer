    (∀ n, ¬ IsPerfectoidTateRing p ((Subfield.closure {r n}).topologicalClosure)) ∧
    ∃ hK : IsPerfectoidTateRing p (Almost.kummerField p r),
    letI := hK
    ∃ e : tilt p (Almost.kummerField p r) ≃+* completedPerfectLaurentFp p,
      Continuous e ∧ Continuous e.symm := sorry

/-! ### P1/untilt-tilt-identification -/
-- Check: untilt_pflat
example (r : ℕ → ℂ_[p]) (hzero : r 0 = p) (hroot : ∀ n, r (n + 1) ^ p = r n)
    (ht : perfectLaurentRoot p 0 ∈ powerBoundedSubring (completedPerfectLaurentFp p)) :
    let P := Pair.powerBounded (completedPerfectLaurentFp p)
    let t : P.plus := ⟨perfectLaurentRoot p 0, ht⟩
    let J := Ideal.span {(p : WittVector p P.plus) - WittVector.teichmuller p t}
    IsPrimitiveIdeal J ∧
      ∃ hJ : Fact (IsPrimitiveIdeal J),
        letI := hJ
        ∃ e : untilt p P J ≃+* Almost.kummerField p r,
          Continuous e ∧ Continuous e.symm ∧
          (e (untilt.sharp p P J (perfectLaurentRoot p 0))).val = p := sorry

/-! ### P2/rational-localization-of-perfectoid-affinoids -/
/-- A continuous extension of a map of Huber pairs preserves the completed plus ring
when the denominator is invertible and the numerator fractions lie in the target plus ring
(Wedhorn §8.1, p. 74, the integral universal property preceding Lemma 8.1). -/
theorem rationalLocalization.lift_mem_plus {R S : Type*} [CommRing R] [UniformSpace R]
    [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R]
    [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S]
    [IsTateRing S] [CompleteSpace S] [T2Space S]
    (P : Pair R) (Q : Pair S) {D : PairOfDefinition R} (d : D.Presentation)
    (f : Pair.Hom P Q) (hd : IsUnit (f.toRingHom d.den))
    (hnum : ∀ x ∈ d.num, f.toRingHom x * ↑hd.unit⁻¹ ∈ Q.plus)
    (g : RationalLoc d →+* S) (hg : Continuous g)
    (hcomp : g.comp (D.toCompletionLoc d.num d.den (Localization.Away d.den)
      d.hasDenominatorPower) = f.toRingHom) :
    ∀ x ∈ (RationalLoc.pair d P).plus, g x ∈ Q.plus := sorry

end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
