example : let f := (toAlmost S).map (CommAlgCat.ofHom (Algebra.ofId V (V × V)));
    IsFaithfullyFlat S f ∧ IsAlmostProjective S f ∧ IsAlmostFinite S f ∧ IsFiniteEtale S f ∧
    IsWeaklyEtale S f := sorry

open scoped MonObj

/-- The relative algebra over the setup on the source's ring of almost elements. -/
def relativeAlgebra {A B : Algebra S} (f : A ⟶ B) :
    Algebra (S.baseChange ((elements S).obj A)) :=
  letI := ((elements S).map f).hom.toAlgebra
  (toAlmost _).obj (CommAlgCat.of ((elements S).obj A) ((elements S).obj B))

/-- The relative algebra and relative module use the same almostification. -/
def relativeAlgebraUnderlying {A B : Algebra S} (f : A ⟶ B) :
    (relativeAlgebra S f).X ≅ relativeModule S f :=
  letI := ((elements S).map f).hom.toAlgebra
  (toAlmostUnderlying _).app (CommAlgCat.of ((elements S).obj A) ((elements S).obj B))

/-- Multiplication transported from the relative commutative monoid object. -/
def relativeMul {A B : Algebra S} (f : A ⟶ B) :
    relativeModule S f ⊗ relativeModule S f ⟶ relativeModule S f :=
  ((relativeAlgebraUnderlying S f).inv ⊗ₘ (relativeAlgebraUnderlying S f).inv) ≫
    μ[(relativeAlgebra S f).X] ≫ (relativeAlgebraUnderlying S f).hom

/-- The algebra trace is the module trace of the multiplication operator, GR (4.1.7). -/
def trace {A B : Algebra S} (f : A ⟶ B)
    (h : Module.AlmostFiniteProjective _ (relativeModule S f)) :
    relativeModule S f ⟶ 𝟙_ (Module (S.baseChange ((elements S).obj A))) :=
  (Module.tensorAlHomAdj _ (relativeModule S f)).homEquiv _ _ (relativeMul S f) ≫
    Module.trace _ (relativeModule S f) h

/-- The bilinear trace form, GR (4.1.12). -/
def traceForm {A B : Algebra S} (f : A ⟶ B)
    (h : Module.AlmostFiniteProjective _ (relativeModule S f)) :
    relativeModule S f ⊗ relativeModule S f ⟶
      𝟙_ (Module (S.baseChange ((elements S).obj A))) := relativeMul S f ≫ trace S f h

/-- The trace pairing as a map to the dual. -/
def traceFormDual {A B : Algebra S} (f : A ⟶ B)
    (h : Module.AlmostFiniteProjective _ (relativeModule S f)) :
    relativeModule S f ⟶ Module.dual _ (relativeModule S f) :=
  (Module.tensorAlHomAdj _ (relativeModule S f)).homEquiv _ _ (traceForm S f h)

def IsPerfectTraceForm {A B : Algebra S} (f : A ⟶ B)
    (h : Module.AlmostFiniteProjective _ (relativeModule S f)) : Prop := IsIso (traceFormDual S f h)

/-! ### P0/trace-form-criterion -/

/-- The trace-form criterion for almost finite projective algebras, GR Theorem 4.1.14. -/
theorem isEtale_iff_isPerfectTraceForm {A B : Algebra S} (f : A ⟶ B)
    (h : Module.AlmostFiniteProjective _ (relativeModule S f)) :
    IsEtale S f ↔ IsPerfectTraceForm S f h := sorry

/-- For an almost finitely presented algebra, flatness and a perfect trace pairing
characterize finite etaleness, GR Proposition 2.4.18, p. 26, and Theorem 4.1.14, p. 75. -/
theorem isFiniteEtale_iff_flat_perfectTraceForm {A B : Algebra S} (f : A ⟶ B)
    (hfp : Module.AlmostFP (S.baseChange ((elements S).obj A))
      ((Module.elements _).obj (relativeModule S f))) :
    IsFiniteEtale S f ↔ ∃ hflat : IsFlat S f,
      IsPerfectTraceForm S f
        ((Module.almostFiniteProjective_iff _ _).mpr ⟨hflat, hfp⟩) := sorry

/-- The diagonal element maps to the coevaluation under `1 ⊗ τ`, GR Remark 4.1.17,
p. 76. Multiplication to one and the balancing equation characterize the diagonal
idempotent in the relative tensor carrier. -/
theorem diagonalIdempotent_trace {A B : Algebra S} (f : A ⟶ B)
    (h : Module.AlmostFiniteProjective _ (relativeModule S f))
    (e : 𝟙_ (Module (S.baseChange ((elements S).obj A))) ⟶
      relativeModule S f ⊗ relativeModule S f)
    (he : e ≫ relativeMul S f =
      η[(relativeAlgebra S f).X] ≫ (relativeAlgebraUnderlying S f).hom)
    (hbal : (ρ_ (relativeModule S f)).inv ≫ (𝟙 _ ⊗ₘ e) ≫
        (α_ _ _ _).inv ≫ (relativeMul S f ▷ relativeModule S f) =
      (λ_ (relativeModule S f)).inv ≫ (e ⊗ₘ 𝟙 _) ≫
        (α_ _ _ _).hom ≫ (relativeModule S f ◁ relativeMul S f)) :
    e ≫ (relativeModule S f ◁ traceFormDual S f h) =
      (Module.tensorAlHomAdj _ (relativeModule S f)).homEquiv _ _
        (λ_ (relativeModule S f)).hom ≫
      (Module.dualTensorHomIso _ (relativeModule S f) h).inv := sorry

/-- The algebra trace on almost elements, characterized by its almostification. -/
def traceElements {A B : Algebra S} (f : A ⟶ B)
    (h : Module.AlmostFiniteProjective _ (relativeModule S f)) :
    letI := ((elements S).map f).hom.toAlgebra
    ((elements S).obj B) →ₗ[((elements S).obj A)] ((elements S).obj A) := sorry

/-- Almostifying the map on elements gives the specified categorical trace, GR (4.1.7). -/
theorem traceElements_spec {A B : Algebra S} (f : A ⟶ B)
    (h : Module.AlmostFiniteProjective _ (relativeModule S f)) :
    letI := ((elements S).map f).hom.toAlgebra
    (Almost.toAlmost _).map (_root_.ModuleCat.ofHom (traceElements S f h)) =
      trace S f h ≫ (Functor.Monoidal.εIso (Almost.toAlmost (S.baseChange ((elements S).obj A)))).hom := sorry

/-- Trace commutes with scalar extension, on generators of the almost pushout, GR Proposition 4.1.8(ii). -/
theorem trace_baseChange {A B C : Algebra S} (f : A ⟶ B) (g : A ⟶ C)
    (h : Module.AlmostFiniteProjective _ (relativeModule S f))
    (h' : Module.AlmostFiniteProjective _ (relativeModule S (pushout.inr f g)))
    (b : (elements S).obj B) (c : (elements S).obj C) :
    traceElements S (pushout.inr f g) h'
      (((elements S).map (pushout.inl f g)).hom b * ((elements S).map (pushout.inr f g)).hom c) =
      ((elements S).map g).hom (traceElements S f h b) * c := sorry

/-- Trace is transitive for almost finite projective towers, GR Proposition 4.1.8(iii). -/
theorem trace_trans {A B C : Algebra S} (f : A ⟶ B) (g : B ⟶ C)
    (hf : Module.AlmostFiniteProjective _ (relativeModule S f))
    (hg : Module.AlmostFiniteProjective _ (relativeModule S g))
    (hfg : Module.AlmostFiniteProjective _ (relativeModule S (f ≫ g))) (c : (elements S).obj C) :
    traceElements S (f ≫ g) hfg c = traceElements S f hf (traceElements S g hg c) := sorry

/-- The trace along an algebra isomorphism is its inverse. -/
theorem trace_of_iso {A B : Algebra S} (f : A ⟶ B) [IsIso f]
    (h : Module.AlmostFiniteProjective _ (relativeModule S f)) (b : (elements S).obj B) :
    traceElements S f h b = ((elements S).map (inv f)).hom b := sorry

/-- The dual trace comparison evaluated on two pure tensors, GR Lemma 4.1.13. -/
theorem traceFormDual_baseChange {A B C : Algebra S} (f : A ⟶ B) (g : A ⟶ C)
    (h : Module.AlmostFiniteProjective _ (relativeModule S f))
    (h' : Module.AlmostFiniteProjective _ (relativeModule S (pushout.inr f g)))
    (b b' : (elements S).obj B) (c c' : (elements S).obj C) :
    traceElements S (pushout.inr f g) h'
      ((((elements S).map (pushout.inl f g)).hom b * ((elements S).map (pushout.inr f g)).hom c) *
       (((elements S).map (pushout.inl f g)).hom b' * ((elements S).map (pushout.inr f g)).hom c')) =
      c * c' * ((elements S).map g).hom (traceElements S f h (b * b')) := sorry

-- Check: traceElements_identity
example (A : Algebra S) (h : Module.AlmostFiniteProjective _ (relativeModule S (𝟙 A)))
    (a : (elements S).obj A) : traceElements S (𝟙 A) h a = a := sorry
-- Check: traceElements_zero
example {A B : Algebra S} (f : A ⟶ B) (hB : IsZero B.X)
    (h : Module.AlmostFiniteProjective _ (relativeModule S f)) : traceElements S f h = 0 := sorry
-- Check: traceElements_product
example (h : Module.AlmostFiniteProjective _ (relativeModule S
    ((toAlmost S).map (CommAlgCat.ofHom (Algebra.ofId V (V × V)))))) (a b : V) :
    traceElements S ((toAlmost S).map (CommAlgCat.ofHom (Algebra.ofId V (V × V)))) h
      (((adj S).unit.app (CommAlgCat.of V (V × V))).hom (a,b)) =
      (((adj S).unit.app (CommAlgCat.of V V)).hom (a+b)) := sorry

-- Check: traceForm_test_product
example (R : Type u) [CommRing R] [_root_.Algebra V R] :
    let T := S.baseChange R
    let f := (toAlmost T).map (CommAlgCat.ofHom (Algebra.ofId R (R × R)))
    ∃ h : Module.AlmostFiniteProjective _ (relativeModule T f),
      IsPerfectTraceForm T f h ∧ IsEtale T f ∧
      ∀ x y : R × R,
        traceElements T f h (((adj T).unit.app (CommAlgCat.of R (R × R))).hom (x * y)) =
          ((adj T).unit.app (CommAlgCat.of R R)).hom (x.1 * y.1 + x.2 * y.2) := sorry

-- Check: traceForm_test_product_diagonal
example (R : Type u) [CommRing R] :
    let e : (R × R) ⊗[R] (R × R) :=
      (1, 0) ⊗ₜ[R] (1, 0) + (0, 1) ⊗ₜ[R] (0, 1)
    IsIdempotentElem e ∧ Algebra.TensorProduct.lmul' R e = 1 ∧
      ∀ x ∈ RingHom.ker (Algebra.TensorProduct.lmul' R (S := R × R)).toRingHom,
        x * e = 0 := sorry

-- Check: traceForm_test_dual_numbers
example (R : Type u) [CommRing R] [_root_.Algebra V R]
    (hne : ¬ IsZero (𝟙_ (Module (S.baseChange R)))) :
    let T := S.baseChange R
    let f := (toAlmost T).map (CommAlgCat.ofHom (Algebra.ofId R (DualNumber R)))
    ∃ h : Module.AlmostFiniteProjective _ (relativeModule T f),
      ¬ IsPerfectTraceForm T f h ∧ ¬ IsUnramified T f ∧
      ∀ x y : DualNumber R,
        traceElements T f h (((adj T).unit.app (CommAlgCat.of R (DualNumber R))).hom (x * y)) =
          ((adj T).unit.app (CommAlgCat.of R R)).hom ((2 : R) * x.fst * y.fst) := sorry

-- Check: trace_test_self_product_dual_numbers
example (R : Type u) [CommRing R] [_root_.Algebra V R] :
    let T := S.baseChange R
    let A := (toAlmost T).obj (CommAlgCat.of R R)
    (∃ h : Module.AlmostFiniteProjective _ (relativeModule T (𝟙 A)),
      IsPerfectTraceForm T (𝟙 A) h ∧ ∀ a, traceElements T (𝟙 A) h a = a) ∧
    (let f := (toAlmost T).map (CommAlgCat.ofHom (Algebra.ofId R (R × R)))
     ∃ h : Module.AlmostFiniteProjective _ (relativeModule T f),
       IsPerfectTraceForm T f h ∧ ∀ x : R × R,
         traceElements T f h (((adj T).unit.app (CommAlgCat.of R (R × R))).hom x) =
           ((adj T).unit.app (CommAlgCat.of R R)).hom (x.1 + x.2)) ∧
    (let f := (toAlmost T).map (CommAlgCat.ofHom (Algebra.ofId R (DualNumber R)))
     ∃ h : Module.AlmostFiniteProjective _ (relativeModule T f),
       (IsPerfectTraceForm T f h ↔ IsZero A.X) ∧ ∀ x : DualNumber R,
         traceElements T f h (((adj T).unit.app (CommAlgCat.of R (DualNumber R))).hom x) =
           ((adj T).unit.app (CommAlgCat.of R R)).hom ((2 : R) * x.fst)) := sorry

-- Check: algebraTrace_test_zero
example (A : Algebra S) (f : A ⟶ (toAlmost S).obj (CommAlgCat.of V (V ⧸ (⊤ : Ideal V))))
    (h : Module.AlmostFiniteProjective _ (relativeModule S f)) :
    trace S f h = 0 ∧ traceForm S f h = 0 ∧ IsPerfectTraceForm S f h := sorry
-- Check: algebraTrace_test_product
example (h : Module.AlmostFiniteProjective _ (relativeModule S
    ((toAlmost S).map (CommAlgCat.ofHom (Algebra.ofId V (V × V)))))) :
    IsPerfectTraceForm S ((toAlmost S).map (CommAlgCat.ofHom (Algebra.ofId V (V × V)))) h ∧
    (trace S ((toAlmost S).map (CommAlgCat.ofHom (Algebra.ofId V (V × V)))) h = 0 ↔
      IsZero (𝟙_ (Module S))) := sorry
-- Check: algebraTrace_test_dual_numbers
example (h : Module.AlmostFiniteProjective _ (relativeModule (BasicSetup.classical ℚ)
    ((toAlmost (BasicSetup.classical ℚ)).map (CommAlgCat.ofHom (Algebra.ofId ℚ (TrivSqZeroExt ℚ ℚ)))))) :
    ¬ IsPerfectTraceForm (BasicSetup.classical ℚ)
      ((toAlmost (BasicSetup.classical ℚ)).map (CommAlgCat.ofHom (Algebra.ofId ℚ (TrivSqZeroExt ℚ ℚ)))) h ∧
    traceForm (BasicSetup.classical ℚ)
      ((toAlmost (BasicSetup.classical ℚ)).map (CommAlgCat.ofHom (Algebra.ofId ℚ (TrivSqZeroExt ℚ ℚ)))) h ≠ 0 := sorry

/-! ### P0/finite-etale-localizes -/

/-- Ordinary finite étale algebras almostify to finite étale algebras, Bhatt Construction 4.3.3. -/
theorem isFiniteEtale_toAlmost (R T : Type u) [CommRing R] [CommRing T]
    [_root_.Algebra V R] [_root_.Algebra V T] [_root_.Algebra R T] [IsScalarTower V R T]
    [_root_.Algebra.Etale R T] [_root_.Module.Finite R T] :
    IsFiniteEtale S ((toAlmost S).map (CommAlgCat.ofHom (IsScalarTower.toAlgHom V R T))) := sorry

-- Check: finiteEtale_test_classical
example (R T : Type u) [CommRing R] [CommRing T] [_root_.Algebra V R] [_root_.Algebra V T]
    [_root_.Algebra R T] [IsScalarTower V R T] :
    IsFiniteEtale (BasicSetup.classical V)
      ((toAlmost (BasicSetup.classical V)).map (CommAlgCat.ofHom (IsScalarTower.toAlgHom V R T))) ↔
      _root_.Algebra.Etale R T ∧ _root_.Module.Finite R T := sorry

/-- Inverting a member of the almost ideal turns a finite étale almost map into
an ordinary finite étale map (GR 3.4.44 and base change). -/
theorem isFiniteEtale_away (R T : Type u) [CommRing R] [CommRing T]
    [_root_.Algebra V R] [_root_.Algebra V T] (f : R →ₐ[V] T)
    (hf : IsFiniteEtale S ((toAlmost S).map (CommAlgCat.ofHom f)))
    (ϖ : V) (hϖ : ϖ ∈ S.ideal) :
    let Rϖ := Localization.Away (algebraMap V R ϖ)
    let Tϖ := Localization.Away (f (algebraMap V R ϖ))
    letI := (IsLocalization.Away.map Rϖ Tϖ f.toRingHom (algebraMap V R ϖ)).toAlgebra
    _root_.Algebra.Etale Rϖ Tϖ ∧ _root_.Module.Finite Rϖ Tϖ := sorry

end Algebra

namespace Module

/-! ### P0/almost-flatness-tor-criterion -/

/-- Ordinary Tor is the left derived tensor functor, GR (2.4.10). -/
def ordinaryTor (M N : ModuleCat.{u} V) (i : ℕ) : ModuleCat.{u} V :=
  ((tensorLeft M).leftDerived i).obj N

local instance (M : ModuleCat.{u} V) : (ihom M).Additive where
  map_add := by intros; rfl

/-- Ordinary module-valued Ext is the right derived internal Hom functor. -/
def ordinaryExt (M N : ModuleCat.{u} V) (i : ℕ) : ModuleCat.{u} V :=
  ((ihom M).rightDerived i).obj N

/-- Almost Tor, computed on the modules of almost elements. -/
def tor (M N : Module S) (i : ℕ) : Module S :=
  (toAlmost S).obj (ordinaryTor ((elements S).obj M) ((elements S).obj N) i)

/-- Almost Ext, computed on almost elements and then almostified. -/
def alExt (M N : Module S) (i : ℕ) : Module S :=
  (toAlmost S).obj (ordinaryExt ((elements S).obj M) ((elements S).obj N) i)

/-- Comparison with any honest representatives, GR (2.4.10). -/
def tor_toAlmost (M N : ModuleCat.{u} V) (i : ℕ) :
    tor S ((toAlmost S).obj M) ((toAlmost S).obj N) i ≅
      (toAlmost S).obj (ordinaryTor M N i) := sorry

def alExt_toAlmost (M N : ModuleCat.{u} V) (i : ℕ) :
    alExt S ((toAlmost S).obj M) ((toAlmost S).obj N) i ≅
      (toAlmost S).obj (ordinaryExt M N i) := sorry

theorem flat_iff_tor (M : Module S) : Flat S M ↔
    ∀ (N : Module S) (i : ℕ), 0 < i → IsZero (tor S M N i) := sorry

theorem almostProjective_iff_alExt (M : Module S) : AlmostProjective S M ↔
    ∀ (N : Module S) (i : ℕ), 0 < i → IsZero (alExt S M N i) := sorry

-- Check: derived_test_degree_zero
example (M N : Module S) : Nonempty (tor S M N 0 ≅ M ⊗ N) ∧
    Nonempty (alExt S M N 0 ≅ alHom S M N) := sorry
-- Check: derived_test_free
example (r i : ℕ) (hi : 0 < i) (N : Module S) :
    IsZero (tor S ((toAlmost S).obj (ModuleCat.of V (Fin r → V))) N i) ∧
    IsZero (alExt S ((toAlmost S).obj (ModuleCat.of V (Fin r → V))) N i) := sorry
-- Check: derived_test_torsion
example : Nonempty (ordinaryTor (ModuleCat.of ℤ (ZMod 2)) (ModuleCat.of ℤ (ZMod 2)) 1 ≅
    ModuleCat.of ℤ (ZMod 2)) ∧ Nonempty (ordinaryExt (ModuleCat.of ℤ (ZMod 2)) (ModuleCat.of ℤ ℤ) 1 ≅
    ModuleCat.of ℤ (ZMod 2)) ∧
    ¬ IsZero (tor (BasicSetup.classical ℤ)
      ((toAlmost (BasicSetup.classical ℤ)).obj (ModuleCat.of ℤ (ZMod 2)))
      ((toAlmost (BasicSetup.classical ℤ)).obj (ModuleCat.of ℤ (ZMod 2))) 1) ∧
    ¬ IsZero (alExt (BasicSetup.classical ℤ)
      ((toAlmost (BasicSetup.classical ℤ)).obj (ModuleCat.of ℤ (ZMod 2)))
      ((toAlmost (BasicSetup.classical ℤ)).obj (ModuleCat.of ℤ ℤ)) 1) := sorry

end Module

namespace Module

/-! ### P0/almost-zero-limits-and-colimits -/

/-- A countable inverse system of modules, with transition from n+1 to n. -/
structure Tower where
  obj : ℕ → ModuleCat.{u} V
  transition : ∀ n, obj (n + 1) ⟶ obj n

namespace Tower

/-- The product difference map; its kernel and cokernel compute lim and lim¹. -/
def difference (N : Tower (V := V)) : (∀ n, N.obj n) →ₗ[V] (∀ n, N.obj n) where
  toFun x n := x n - (N.transition n).hom (x (n + 1))
  map_add' := by intros; ext; simp; abel
  map_smul' := by intros; ext; simp [smul_sub]

abbrev limit (N : Tower (V := V)) := LinearMap.ker N.difference
abbrev lim1 (N : Tower (V := V)) := (∀ n, N.obj n) ⧸ LinearMap.range N.difference

/-- Products and both derived limits preserve almost-zero modules, GR Lemma 2.4.2. -/
theorem almostZero_limits (N : Tower (V := V)) (hN : ∀ n, S.IsAlmostZero (N.obj n)) :
    S.IsAlmostZero (∀ n, N.obj n) ∧ S.IsAlmostZero N.limit ∧ S.IsAlmostZero N.lim1 := sorry

-- Check: tower_test_zero_maps
example (M : ModuleCat.{u} V) :
    let N : Tower (V := V) := ⟨fun _ => M, fun _ => 0⟩
    N.difference = LinearMap.id ∧ Subsingleton N.limit ∧ Subsingleton N.lim1 := sorry
-- Check: tower_test_identity_maps
example (M : ModuleCat.{u} V) :
    let N : Tower (V := V) := ⟨fun _ => M, fun _ => 𝟙 M⟩
    Nonempty (N.limit ≃ₗ[V] M) ∧ Subsingleton N.lim1 := sorry
-- Check: tower_test_polynomial
example (k : Type u) [Field k] :
    let N : Tower (V := k) := ⟨fun _ => ModuleCat.of k (Polynomial k),
      fun _ => ModuleCat.ofHom ((LinearMap.mul k (Polynomial k)) Polynomial.X)⟩
    Subsingleton N.limit ∧ ¬ Subsingleton N.lim1 := sorry
-- Check: tower_test_sign
example :
    let N : Tower (V := ℤ) := ⟨fun _ => ModuleCat.of ℤ ℤ,
      fun _ => ModuleCat.ofHom (2 • LinearMap.id)⟩
    N.difference (fun n => (n : ℤ) + 1) 0 = -3 := rfl

end Tower
end Module

namespace Algebra

/-- Quotients use ordinary ideals of the ring of almost elements as representatives. -/
def quotient (A : Algebra S) (I : _root_.Ideal ((elements S).obj A)) : Algebra S :=
  (toAlmost S).obj (CommAlgCat.of V (((elements S).obj A) ⧸ I))

/-- The map to a quotient, with its canonical almostified representative. -/
def quotientMap (A : Algebra S) (I : _root_.Ideal ((elements S).obj A)) : A ⟶ quotient S A I :=
  (asIso ((adj S).counit.app A)).inv ≫
    (toAlmost S).map (CommAlgCat.ofHom (_root_.Ideal.Quotient.mkₐ V I))

/-! ### P0/tight-ideal -/

/-- Tightness of the represented almost ideal, GR Definition 5.1.5.
The last clause expresses inclusion after almostification, not honest ideal inclusion. -/
def IsTight (A : Algebra S) (I : _root_.Ideal ((elements S).obj A)) : Prop :=
  ∃ m₀ : _root_.Ideal V, m₀ ≤ S.ideal ∧ m₀.FG ∧ ∃ n : ℕ,
    ∀ x ∈ I ^ n, ∀ ε ∈ S.ideal,
      ε • x ∈ m₀.map (algebraMap V ((elements S).obj A))

/-- Nilpotence is required only after almostification. -/
def IsNilpotentIdeal (A : Algebra S) (I : _root_.Ideal ((elements S).obj A)) : Prop :=
  ∃ n : ℕ, 0 < n ∧ ∀ x ∈ I ^ n, ∀ ε ∈ S.ideal, ε • x = 0

/-- Etale algebras, with no finite-presentation condition, GR Theorem 3.2.18. -/
abbrev Etale (A : Algebra S) :=
  ObjectProperty.FullSubcategory (fun B : Under A => IsEtale S B.hom)

/-- Base change in the category of finite etale almost algebras. -/
def finiteEtaleBaseChange {A B : Algebra S} (f : A ⟶ B) : FiniteEtale S A ⥤ FiniteEtale S B where
  obj C := ⟨Under.mk (pushout.inr C.obj.hom f), IsFiniteEtale.baseChange S C.property f⟩
  map := sorry
  map_id := sorry
  map_comp := sorry

/-- Underlying base change is the pushout functor, including its action on morphisms. -/
def finiteEtaleBaseChangeUnderlying {A B : Algebra S} (f : A ⟶ B) :
    finiteEtaleBaseChange S f ⋙ ObjectProperty.ι _ ≅
      ObjectProperty.ι _ ⋙ Under.pushout f := sorry

/-- Base change without the finiteness restriction. -/
def etaleBaseChange {A B : Algebra S} (f : A ⟶ B) : Etale S A ⥤ Etale S B where
  obj C := ⟨Under.mk (pushout.inr C.obj.hom f), IsEtale.baseChange S C.property f⟩
  map := sorry
  map_id := sorry
  map_comp := sorry

def etaleBaseChangeUnderlying {A B : Algebra S} (f : A ⟶ B) :
    etaleBaseChange S f ⋙ ObjectProperty.ι _ ≅ ObjectProperty.ι _ ⋙ Under.pushout f := sorry

/-! ### P0/nilpotent-lifting-of-etale-almost-algebras -/

/-- Nilpotent reduction is an equivalence for etale almost algebras, GR Theorem 3.2.18. -/
def nilpotentEtaleEquiv (A : Algebra S) (I : _root_.Ideal ((elements S).obj A))
    (hI : IsNilpotentIdeal S A I) : Etale S A ≌ Etale S (quotient S A I) where
  functor := etaleBaseChange S (quotientMap S A I)
  inverse := sorry
  unitIso := sorry
  counitIso := sorry

/-- On objects, nilpotent reduction is the indicated pushout. -/
def nilpotentEtaleEquiv_obj (A : Algebra S) (I : _root_.Ideal ((elements S).obj A))
    (hI : IsNilpotentIdeal S A I) (B : Etale S A) :
    ((nilpotentEtaleEquiv S A I hI).functor.obj B).obj.right ≅
      pushout B.obj.hom (quotientMap S A I) := sorry

/-- The adic quotient diagram, with n indexing I^(n+1). -/
def adicSystem (A : Algebra S) (I : _root_.Ideal ((elements S).obj A)) : ℕᵒᵖ ⥤ Algebra S where
  obj n := quotient S A (I ^ (n.unop + 1))
  map := sorry
  map_id := sorry
  map_comp := sorry

/-- All transition maps commute with the quotient maps from A. -/
theorem adicSystem_map (A : Algebra S) (I : _root_.Ideal ((elements S).obj A))
    {m n : ℕᵒᵖ} (f : m ⟶ n) :
    quotientMap S A (I ^ (m.unop + 1)) ≫ (adicSystem S A I).map f =
      quotientMap S A (I ^ (n.unop + 1)) := sorry

instance : HasLimitsOfShape ℕᵒᵖ (Algebra S) := sorry

/-- The canonical comparison to the adic limit. -/
def adicMap (A : Algebra S) (I : _root_.Ideal ((elements S).obj A)) :
    A ⟶ limit (adicSystem S A I) :=
  limit.lift (adicSystem S A I)
    { pt := A
      π :=
        { app := fun n => quotientMap S A (I ^ (n.unop + 1))
          naturality := by
            intro m n f
            exact (Category.id_comp _).trans (adicSystem_map S A I f).symm } }

/-- Completeness of the almost algebra, rather than of an arbitrarily chosen representative. -/
def IsAdicComplete (A : Algebra S) (I : _root_.Ideal ((elements S).obj A)) : Prop :=
  IsIso (adicMap S A I)

/-! ### P0/finite-etale-lifting-along-complete-flat-almost-algebras -/

/-- Tight complete reduction of finite etale almost algebras, GR Theorem 5.3.27. -/
theorem finiteEtaleBaseChange_isEquivalence (A : Algebra S)
    (I : _root_.Ideal ((elements S).obj A)) (hI : IsTight S A I) (hA : IsAdicComplete S A I) :
    (finiteEtaleBaseChange S (quotientMap S A I)).IsEquivalence := sorry

