      eqToHom (congrArg (fun f ↦ (Over.pullback f).obj T.obj.obj) (X.map_comp b a)) ≫
        (Over.pullbackComp (X.map b) (X.map a)).hom.app T.obj.obj := sorry

-- Check: finiteStageQcqsDiagram_identity_projection
example (i : I) (T : qcqsEtale p (X.obj i)) :
