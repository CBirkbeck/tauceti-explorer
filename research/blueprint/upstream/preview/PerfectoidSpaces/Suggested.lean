/-- The chartwise unit defines the unique algebraic extension to localized global sections. -/
theorem integral_sections_localization_extension (Y : Perfd p) (tY : globalPlus p Y)
    (htY : ∀ C : Chart p Y, IsPseudoUniformizer (tY.val.val C))
    (A : Type) [CommRing A] (t : A) (f : A →+* globalPlus p Y) (hf : f t = tY) :
    ∃! g : Localization.Away t →+* globalSections p Y,
      ∀ a : A, g (algebraMap A _ a) = (f a).val := sorry

/-- A finite cover by quasicompact opens descends as a cover at one common stage. -/
theorem cofilteredLimit.finite_qcOpen_cover {I : Type} [SmallCategory I] [IsCofiltered I]
    (X : I ⥤ Perfd p) (hX : ∀ i, IsAffinoidPerfectoid p (X.obj i).obj) (n : ℕ)
    (U : Fin n → TopologicalSpace.Opens (underlyingPoints p (cofilteredLimit p X hX)))
    (hU : ∀ k, IsCompact (U k : Set (underlyingPoints p (cofilteredLimit p X hX))))
    (hcover : (⋃ k, (U k : Set (underlyingPoints p (cofilteredLimit p X hX)))) = Set.univ) :
    ∃ (i : I) (V : Fin n → TopologicalSpace.Opens (underlyingPoints p (X.obj i))),
      (∀ k, IsCompact (V k : Set (underlyingPoints p (X.obj i)))) ∧
      (∀ k, (U k : Set (underlyingPoints p (cofilteredLimit p X hX))) =
        pointMap p (cofilteredLimit.π p X hX i) ⁻¹' (V k : Set (underlyingPoints p (X.obj i)))) ∧
      (⋃ k, (V k : Set (underlyingPoints p (X.obj i)))) = Set.univ := sorry
end PerfectoidSpace

