      YonedaAdicSpace.IsOpenImmersion i.hom.hom →
      ∃ (S : PairCat.{0} p) (a : R ⟶ S) (j : ofPair p S ⟶ Y),
        Pair.IsFiniteEtale a ∧ IsPullback j ((spaFunctor p).map a.op) f i := sorry

