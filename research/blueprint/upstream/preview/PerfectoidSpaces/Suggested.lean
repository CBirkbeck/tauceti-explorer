-- Check: perfected_tilt_two_roots
example (s : σ) :
    Perfectoid.tilt.sharp ((tiltEquiv p ϖ σ).symm (rootX (ϖ.tilt p) s 0)) = rootX ϖ s 0 ∧
    Perfectoid.tilt.coeff 1 ((tiltEquiv p ϖ σ).symm (rootX (ϖ.tilt p) s 0)) = rootX ϖ s 1 := sorry
end perfectedTateAlgebra
end TiltedRoots

section ColimitTilting
variable (p : ℕ) [Fact p.Prime] {J : Type u} [SmallCategory J] [IsFiltered J]
  (F : J ⥤ PairCat.{u} p) (j₀ : J) (ϖ : PseudoUniformizerRoots p (F.obj j₀))
namespace completedFilteredColimit
local instance tiltedColimitCommRing : CommRing
    (completedFilteredColimit p (F ⋙ PairCat.tiltFunctor p) j₀ (ϖ.tilt p)) :=
  completedFilteredColimit.instCommRing p (F ⋙ PairCat.tiltFunctor p) j₀ (ϖ.tilt p)
local instance tiltedColimitUniformSpace : UniformSpace
    (completedFilteredColimit p (F ⋙ PairCat.tiltFunctor p) j₀ (ϖ.tilt p)) :=
  completedFilteredColimit.instUniformSpace p (F ⋙ PairCat.tiltFunctor p) j₀ (ϖ.tilt p)
/-- The map on tilts is induced by the structural maps of the completed colimit. -/
def tiltEquiv : tilt p (completedFilteredColimit p F j₀ ϖ) ≃+*
    completedFilteredColimit p (F ⋙ PairCat.tiltFunctor p) j₀ (ϖ.tilt p) := sorry

set_option maxHeartbeats 800000 in
theorem tiltEquiv_spec : Continuous (tiltEquiv p F j₀ ϖ) ∧
    Continuous (tiltEquiv p F j₀ ϖ).symm ∧
    ∀ j, (tiltEquiv p F j₀ ϖ).toRingHom.comp
      (tilt.map p (ι p F j₀ ϖ j) (continuous_ι p F j₀ ϖ j)) =
        ι p (F ⋙ PairCat.tiltFunctor p) j₀ (ϖ.tilt p) j := sorry

/-- Final changes of indexing category and choices of small units give the same ring. -/
def equivOfChoice {J' : Type u} [SmallCategory J'] [IsFiltered J']
    (G : J' ⥤ J) [G.Final] (j₁ : J') (ψ : PseudoUniformizerRoots p (F.obj (G.obj j₁))) :
    completedFilteredColimit p (G ⋙ F) j₁ ψ ≃+* completedFilteredColimit p F j₀ ϖ := sorry

theorem equivOfChoice_spec {J' : Type u} [SmallCategory J'] [IsFiltered J']
    (G : J' ⥤ J) [G.Final] (j₁ : J') (ψ : PseudoUniformizerRoots p (F.obj (G.obj j₁))) :
    Continuous (equivOfChoice p F j₀ ϖ G j₁ ψ) ∧
    Continuous (equivOfChoice p F j₀ ϖ G j₁ ψ).symm ∧
    ∀ j, (equivOfChoice p F j₀ ϖ G j₁ ψ).toRingHom.comp (ι p (G ⋙ F) j₁ ψ j) =
      ι p F j₀ ϖ (G.obj j) := sorry
end completedFilteredColimit
