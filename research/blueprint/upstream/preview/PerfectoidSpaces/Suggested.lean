/-! ### P3/finite-etale-morphism-of-perfectoid-spaces -/

/-- `YonedaAdicSpace.IsFiniteEtale` restricted to perfectoid spaces. -/
abbrev IsFiniteEtale {Y X : Perfd p} (f : Y ⟶ X) : Prop :=
  YonedaAdicSpace.IsFiniteEtale f.hom

/-! ### P3/etale-morphism-of-perfectoid-spaces -/

/-- `YonedaAdicSpace.IsEtaleLocalDescription` restricted to perfectoid spaces. -/
abbrev IsEtale {Y X : Perfd p} (f : Y ⟶ X) : Prop :=
  YonedaAdicSpace.IsEtaleLocalDescription f.hom

/-- Strong finite étaleness on an open affinoid covering of the target. -/
def IsStronglyFiniteEtale {Y X : Perfd p} (f : Y ⟶ X) : Prop :=
  ∀ x : YonedaAdicSpace.space.obj X.obj,
    ∃ (R S : PairCat.{0} p) (a : R ⟶ S) (i : ofPair p R ⟶ X) (j : ofPair p S ⟶ Y),
      YonedaAdicSpace.IsOpenImmersion i.hom.hom ∧
      x ∈ Set.range (YonedaAdicSpace.space.map i.hom) ∧
      Pair.IsStronglyFiniteEtale a ∧ IsPullback j ((spaFunctor p).map a.op) f i

/-- Strong étaleness is local factorization through a strongly finite étale map. -/
def IsStronglyEtale {Y X : Perfd p} (f : Y ⟶ X) : Prop :=
  ∀ y : YonedaAdicSpace.space.obj Y.obj,
    ∃ (V W U : Perfd p) (v : V ⟶ Y) (a : V ⟶ W) (b : W ⟶ U) (i : U ⟶ X),
      YonedaAdicSpace.IsOpenImmersion v.hom.hom ∧
      y ∈ Set.range (YonedaAdicSpace.space.map v.hom) ∧
      YonedaAdicSpace.IsOpenImmersion a.hom.hom ∧ IsStronglyFiniteEtale p b ∧
      YonedaAdicSpace.IsOpenImmersion i.hom.hom ∧ v ≫ f = a ≫ b ≫ i

/-- Almost purity identifies the two finite classes, Sch12 Proposition 7.10. -/
theorem finiteEtale_iff_strong {Y X : Perfd p} (f : Y ⟶ X) :
    IsFiniteEtale p f ↔ IsStronglyFiniteEtale p f := sorry

/-! ### P3/etale-is-strongly-etale -/

theorem etale_iff_strong {Y X : Perfd p} (f : Y ⟶ X) :
    IsEtale p f ↔ IsStronglyEtale p f := sorry

theorem IsEtale.of_isOpenImmersion {Y X : Perfd p} (f : Y ⟶ X)
    (h : YonedaAdicSpace.IsOpenImmersion f.hom.hom) : IsEtale p f := sorry

/-- The identity is étale, as an open immersion (Sch12, Definition 7.1, p. 39). -/
theorem IsEtale.id (X : Perfd p) : IsEtale p (𝟙 X) := by
  apply IsEtale.of_isOpenImmersion
  change YonedaAdicSpace.IsOpenImmersion (𝟙 X.obj.obj)
  intro R g
  refine ⟨Set.univ, isOpen_univ, inferInstance, ?_⟩
  intro S φ
  constructor
  · intro _
    exact Set.subset_univ _
  · intro _
    let q := pullback.snd (𝟙 X.obj.obj) g
    refine ⟨(inv q).hom.app (Opposite.op (Opposite.op S)) (YonedaAdicSpace.spaYSection φ), ?_⟩
    change ((inv q ≫ q).hom.app (Opposite.op (Opposite.op S))) _ = _
    simp

