/-! ### P2: products-in-perf -/
/-- Berkeley 8.3.5: the absolute product lies over the discrete prime-field spectrum. -/
theorem prod_isPullback_spaFp (X Y : Perf p) (F : CAff)
    [DiscreteTopology F.A] (e : F.A ≃+* ZMod p) (hF : F.P.plus = ⊤) :
    ∃ (a : X.obj.obj ⟶ ofSpaY F) (b : Y.obj.obj ⟶ ofSpaY F),
      IsPullback (prod.fst (X := X) (Y := Y)).hom.hom
        (prod.snd (X := X) (Y := Y)).hom.hom a b := sorry

-- Check: prod_isPullback_spaFp
set_option maxHeartbeats 1600000 in
example (X Y : Perf p) (F : CAff)
    [DiscreteTopology F.A] (e : F.A ≃+* ZMod p) (hF : F.P.plus = ⊤) :
    ∃ (a : X.obj.obj ⟶ ofSpaY F) (b : Y.obj.obj ⟶ ofSpaY F),
      IsPullback (prod.fst (X := X) (Y := Y)).hom.hom
        (prod.snd (X := X) (Y := Y)).hom.hom a b :=
  prod_isPullback_spaFp p X Y F e hF

/-- Berkeley 8.3.5: the product of two completed perfect Laurent fields is the
punctured open disc, expressed as the union of its rational annuli. -/
theorem prodPerfectoidFieldsIso
    (ϖ : PseudoUniformizerRoots p (completedPerfectLaurentFp p))
    (hϖ : ∀ n, ϖ.root n = perfectLaurentRoot p n) :
    let K : PairCat.{0} p := ⟨completedPerfectLaurentFp p, Pair.powerBounded _⟩
    let D : PairCat.{0} p := ⟨perfectedTateAlgebra p ϖ Unit, Pair.powerBounded _⟩
    let X := charPOfPair p K (by sorry)
    ∃ U : TopologicalSpace.Opens (space.obj (ofPair p D).obj),
      (∀ x, x ∈ U ↔ ∃ m n : ℕ, 0 < m ∧ 0 < n ∧
        let v := (spaSpaceEquiv p D x).down.val.valuation
        v (algebraMap K D (ϖ.root 0)) ^ m ≤ v (perfectedTateAlgebra.rootX ϖ () 0) ∧
        v (perfectedTateAlgebra.rootX ϖ () 0) ^ n ≤ v (algebraMap K D (ϖ.root 0))) ∧
      Nonempty ((Limits.prod X X).obj ≅ restrict p (ofPair p D) U) ∧
      ¬ CompactSpace (underlyingPoints p (Limits.prod X X).obj) := sorry

