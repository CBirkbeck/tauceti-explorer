-- Check: untilt_unit_ideal
example (R : Type*) [CommRing R] [UniformSpace R] [IsUniformAddGroup R]
    [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R] (P : Pair R) :
    Subsingleton (untilt p P ⊤) ∧ untiltPlus p P ⊤ = ⊤ ∧
