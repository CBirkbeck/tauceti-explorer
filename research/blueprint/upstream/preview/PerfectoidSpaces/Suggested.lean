theorem smallEtaleAdicEquiv_covers (X : Perfd p) (U : smallEtale p X) (S : Sieve U) :
    S ∈ smallEtaleTopology p X U ↔ S.functorPushforward (smallEtaleAdicEquiv p X).functor ∈
      YonedaAdicSpace.smallEtaleTopology X.obj (isAnalytic_adic p X)
        ((smallEtaleAdicEquiv p X).functor.obj U) := sorry

