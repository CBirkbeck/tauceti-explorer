open CategoryTheory.Pretriangulated

/-- Scalar-linear functoriality for the square (A → B) → (A → C).
Its value on scalar-extended chains is specified by `transitivityFirst_tmul`. -/
def transitivityFirst (A B C : Type u) [CommRing A] [CommRing B] [CommRing C]
    [Algebra A B] [Algebra B C] [Algebra A C] [IsScalarTower A B C] :
    ((ModuleCat.extendScalars (algebraMap B C)).mapHomologicalComplex _).obj (model A B) ⟶
      model A C := sorry

/-- Functoriality for the square (A → C) → (B → C), retaining C-linearity.
Its underlying additive map is specified by `transitivitySecond_apply`. -/
def transitivitySecond (A B C : Type u) [CommRing A] [CommRing B] [CommRing C]
    [Algebra A B] [Algebra B C] [Algebra A C] [IsScalarTower A B C] :
    model A C ⟶ model B C := sorry

/-- The first two arrows are induced by the specified squares of ring maps. -/
theorem transitivityTriangle (A B C : Type u) [CommRing A] [CommRing B] [CommRing C]
    [Algebra A B] [Algebra B C] [Algebra A C] [IsScalarTower A B C] :
    let L := DerivedCategory.Q.obj
      ((((ModuleCat.extendScalars (algebraMap B C)).mapHomologicalComplex _).obj
        (model A B)).extend (ComplexShape.embeddingUpIntLE 0))
    let a := DerivedCategory.Q.map
      (HomologicalComplex.extendMap (transitivityFirst A B C) (ComplexShape.embeddingUpIntLE 0))
    let b := DerivedCategory.Q.map
      (HomologicalComplex.extendMap (transitivitySecond A B C) (ComplexShape.embeddingUpIntLE 0))
    ∃ d : object B C ⟶ L⟦(1 : ℤ)⟧,
      Triangle.mk a b d ∈ distTriang (DerivedCategory (ModuleCat.{u} C)) := sorry

