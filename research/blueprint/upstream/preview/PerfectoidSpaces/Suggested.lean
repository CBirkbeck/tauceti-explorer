/-- Characteristic-p rational localization, including the empty localization. -/
theorem rationalLocalization.perfect_of_charP (hp : (p : R) = 0)
    (D : PairOfDefinition R) (q : D.Presentation) (h : Ideal.span (q.num : Set R) = ⊤) :
    (p : RationalLoc q) = 0 ∧ Function.Bijective (fun x : RationalLoc q ↦ x ^ p) ∧
      IsBounded (powerBoundedSubring (RationalLoc q) : Set (RationalLoc q)) := sorry
-- Check: localization_charp_zero
example (hp : (p : R) = 0) (D : PairOfDefinition R) (q : D.Presentation)
    (h : Ideal.span (q.num : Set R) = ⊤) (hden : q.den = 0) :
    (p : RationalLoc q) = 0 ∧ Subsingleton (RationalLoc q) := sorry
-- Check: sections_charp_roots
example (hp : (p : R) = 0) (U : TopologicalSpace.Opens (spa R.pair.plus)) :
    Function.Bijective (fun x : rationalSections p R U ↦ x ^ p) := sorry
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
open TauCeti Huber Perfectoid TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]
/-! ### P2/characteristic-p-affinoid-perfectoid-criterion -/

/-- Mihara's characteristic-p affinoid criterion, Bhatt Exercise 9.3.12, p. 111.
The sheafy hypothesis is the rational-cover sheaf condition on every rational localization. -/
theorem affinoid_charP_criterion (R : CAff) [IsTateRing R.A] (hp : (p : R.A) = 0)
    (hs : ∀ (R' : CAff) (f : R ⟶ R') (T : Finset R.A) (s : R.A),
      CAff.IsRationalLocalization f T s →
      ∀ (n : ℕ) (T' : Fin n → Finset R'.A) (s' : Fin n → R'.A),
        CAff.IsRationalCovering R' T' s' →
          CategoryTheory.Presieve.IsSheafFor CAff.O (CAff.rationalCover R' T' s')) :
    IsPerfectoidSpace p (YonedaAdicSpace.ofSpaY R) →
      IsPerfectoidTateRing p R.A ∧ Function.Bijective (fun x : R.A ↦ x ^ p) ∧
        IsAffinoidPerfectoid p (YonedaAdicSpace.ofSpaY R) := sorry
end TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
end

/-! ### Layer 2: Global sections and the multiplicative sharp map -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace
open TauCeti Huber Perfectoid CategoryTheory TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]

/-- An open perfectoid affinoid chart, retaining its map into the space. -/
structure Chart (X : Perfd p) where
  ring : PairCat.{0} p
  map : ofPair p ring ⟶ X
  isOpen : YonedaAdicSpace.IsOpenImmersion map.hom.hom

/-- Global sections as compatible functions on all open perfectoid affinoid charts. -/
def globalSections (X : Perfd p) : Subring (∀ C : Chart p X, C.ring) where
  carrier := {s | ∀ (C D : Chart p X) (g : C.ring ⟶ D.ring),
    (spaFunctor p).map g.op ≫ C.map = D.map → g.toRingHom (s C) = s D}
  zero_mem' := by sorry
  one_mem' := by sorry
  add_mem' := by sorry
  neg_mem' := by sorry
  mul_mem' := by sorry

def globalPlus (X : Perfd p) : Subring (globalSections p X) where
  carrier := {s | ∀ C, s.val C ∈ C.ring.pair.plus}
  zero_mem' := by sorry
  one_mem' := by sorry
  add_mem' := by sorry
  neg_mem' := by sorry
  mul_mem' := by sorry

def identityChart (R : PairCat.{0} p) : Chart p (ofPair p R) :=
  ⟨R, 𝟙 _, by sorry⟩

/-- Gluing functions agrees with recovering a complete affinoid pair. -/
def globalSectionsAffinoidEquiv (R : PairCat.{0} p) : globalSections p (ofPair p R) ≃+* R := sorry

theorem globalSectionsAffinoidEquiv_spec (R : PairCat.{0} p) :
    (∀ s, globalSectionsAffinoidEquiv p R s = s.val (identityChart p R)) ∧
    (globalPlus p (ofPair p R)).map (globalSectionsAffinoidEquiv p R).toRingHom = R.pair.plus := sorry

/-- A presentation by a perfectoid affinoid equips its global sections with a perfectoid
Tate structure for the topology of uniform convergence on all affinoid charts. -/
theorem IsAffinoidPerfectoid.isPerfectoidTateRing_sections (X : Perfd p)
    (hX : IsAffinoidPerfectoid p X.obj) :
    ∃ hT : IsTateRing (globalSections p X),
      ∃ hC : CompleteSpace (globalSections p X),
        letI := hT
        letI := hC
        IsPerfectoidTateRing p (globalSections p X) := sorry

/-- Pullback of functions, fixed on chart maps by the following equation. -/
def globalPullback {X Y : Perfd p} (f : X ⟶ Y) : globalSections p Y →+* globalSections p X := sorry

theorem globalPullback_chart {X Y : Perfd p} (f : X ⟶ Y) (C : Chart p X) (D : Chart p Y)
    (g : D.ring ⟶ C.ring) (h : (spaFunctor p).map g.op ≫ D.map = C.map ≫ f)
    (s : globalSections p Y) : (globalPullback p f s).val C = g.toRingHom (s.val D) := sorry

theorem globalPullback_plus {X Y : Perfd p} (f : X ⟶ Y) (s : globalPlus p Y) :
    globalPullback p f s.val ∈ globalPlus p X := sorry

/-- Tilt the chart and its specified inclusion. -/
def tiltChart (X : Perfd p) (C : Chart p X) : Chart p ((tiltFunctor p).obj X) where
  ring := (PairCat.tiltFunctor p).obj C.ring
  map := (tiltSpaIso p C.ring).inv ≫ (tiltFunctor p).map C.map
  isOpen := sorry

/-- The sharp morphism is multiplicative, preserves zero, and is defined on all opens
by applying this construction to `restrict X U`. It is not a ring morphism. -/
def globalSharp (X : Perfd p) : globalSections p ((tiltFunctor p).obj X) →*₀ globalSections p X := sorry

theorem globalSharp_chart (X : Perfd p) (s : globalSections p ((tiltFunctor p).obj X))
    (C : Chart p X) : (globalSharp p X s).val C = tilt.sharp (s.val (tiltChart p X C)) := sorry

theorem globalSharp_naturality {X Y : Perfd p} (f : X ⟶ Y)
    (s : globalSections p ((tiltFunctor p).obj Y)) :
    globalPullback p f (globalSharp p Y s) =
      globalSharp p X (globalPullback p ((tiltFunctor p).map f) s) := sorry

theorem globalSharp_plus (X : Perfd p) (s : globalPlus p ((tiltFunctor p).obj X)) :
    globalSharp p X s.val ∈ globalPlus p X := sorry

-- Check: global_sections_empty
example (X : Perfd p) [IsEmpty (YonedaAdicSpace.space.obj X.obj)] :
    Subsingleton (globalSections p X) ∧ globalPlus p X = ⊤ := sorry
-- Check: global_sections_affinoid
example (R : PairCat.{0} p) : Nonempty (globalSections p (ofPair p R) ≃+* R) :=
  ⟨globalSectionsAffinoidEquiv p R⟩
-- Check: global_plus_inverse_parameter
example (R : PairCat.{0} p) [Nontrivial R] (ϖ : PseudoUniformizerRoots p R) :
    (globalSectionsAffinoidEquiv p R).symm (ϖ.zpow (-1) 0 : R) ∉ globalPlus p (ofPair p R) := sorry
-- Check: global_plus_two_integral_terms
example (R : PairCat.{0} p) (a b : R.pair.plus) :
    (globalSectionsAffinoidEquiv p R).symm (a.val + b.val) ∈ globalPlus p (ofPair p R) := sorry
-- Check: global_sharp_zero_one
example (X : Perfd p) : globalSharp p X 0 = 0 ∧ globalSharp p X 1 = 1 :=
  ⟨map_zero _, map_one _⟩
-- Check: global_sharp_two_factors
example (X : Perfd p) (s t : globalSections p ((tiltFunctor p).obj X)) :
    globalSharp p X (s * t) = globalSharp p X s * globalSharp p X t := map_mul _ _ _
-- Check: global_sharp_nonadditive
example (R : PairCat.{0} 2) [CharZero R] :
    globalSharp 2 (ofPair 2 R) (1 + 1) ≠
      globalSharp 2 (ofPair 2 R) 1 + globalSharp 2 (ofPair 2 R) 1 := sorry
-- Check: global_pullback_identity
example (X : Perfd p) : globalPullback p (𝟙 X) = RingHom.id _ := sorry
-- Check: global_pullback_composition
example {X Y Z : Perfd p} (f : X ⟶ Y) (g : Y ⟶ Z) :
    globalPullback p (f ≫ g) = (globalPullback p f).comp (globalPullback p g) := sorry
-- Check: global_pullback_affine_two_terms
example {R S : PairCat.{0} p} (f : R ⟶ S) (a b : R) :
    globalSectionsAffinoidEquiv p S
      (globalPullback p ((spaFunctor p).map f.op)
        ((globalSectionsAffinoidEquiv p R).symm (a + b))) = f.toRingHom a + f.toRingHom b := sorry
