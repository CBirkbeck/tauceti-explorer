      Localization.awayMap (completionMap (0 : R) I) 0 a = 0 := sorry
-- Check: localizedCompletionMap_one
example {R : Type} [CommRing R] [Nontrivial R] :
    Nontrivial (Localization.Away (1 : R)) ∧
      Localization.awayMap (completionMap (1 : R) ⊤) 1 1 = 0 := sorry
-- Check: localizedCompletionMap_inverse
example :
    let f := Localization.awayMap (completionMap (3 : ℤ) ⊤) 3
    Function.Injective f ∧ ¬ Function.Surjective f ∧
      ∃ e : Localization.Away (completionMap (3 : ℤ) ⊤ 3) ≃+* ℚ_[3],
        (∀ a : ℤ, e (f (algebraMap ℤ (Localization.Away (3 : ℤ)) a)) = a) ∧
        e (f (IsLocalization.Away.invSelf (3 : ℤ))) = (3 : ℚ_[3])⁻¹ := sorry
-- Check: localizedCompletionMap_zero_ideal
example {R : Type} [CommRing R] (t : R) :
    Function.Bijective (Localization.awayMap (completionMap t (⊥ : Ideal R)) t) := sorry

/-- GR 5.4.15–19, pp. 120–121: glue the evaluation topologies on all affine opens
of the base change. Thus sections are actual morphisms over the specified scalar map. -/
@[instance_reducible]
def QuasiProjectiveOver.sectionTopology {A R : Type} [CommRing A] [CommRing R]
    (t : R) (I : Ideal R) (X : Over (Spec (CommRingCat.of A)))
    (φ : A →+* Localization.Away t) :
    TopologicalSpace (Over.mk (Spec.map (CommRingCat.ofHom φ)) ⟶ X) := by
  letI := localizedTopology t I
  let B := Spec (CommRingCat.of (Localization.Away t))
  let Y := pullback X.hom (Spec.map (CommRingCat.ofHom φ))
  exact ⨆ (U : Y.Opens) (_ : IsAffineOpen U),
    TopologicalSpace.coinduced
      (fun σ : Over.mk (𝟙 B) ⟶ Over.mk (U.ι ≫ pullback.snd _ _) =>
        (Over.homMk (σ.left ≫ U.ι ≫ pullback.fst _ _) (by sorry) : Over.mk (Spec.map (CommRingCat.ofHom φ)) ⟶ X))
      (TopologicalSpace.induced
        (fun σ : Over.mk (𝟙 B) ⟶ Over.mk (U.ι ≫ pullback.snd _ _) =>
          fun a : Γ(U, ⊤) => (Scheme.ΓSpecIso (CommRingCat.of (Localization.Away t))).hom
            (σ.left.appTop a)) inferInstance)

/-- GR 5.4.16(i): any chosen closed affine immersion computes the section topology. -/
theorem sections_affineTopology {R : Type} [CommRing R] (t : R)
    (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [HenselianRing R (Ideal.span {t} * I)]
    (X : Over (Spec (CommRingCat.of (Localization.Away t)))) (N : ℕ)
    (j : X ⟶ Over.mk (Spec.map (CommRingCat.ofHom
      (algebraMap (Localization.Away t) (MvPolynomial (Fin N) (Localization.Away t))))))
    [IsClosedImmersion j.left] :
    letI := localizedTopology t I
    QuasiProjectiveOver.sectionTopology t I X (RingHom.id _) =
      TopologicalSpace.induced
        (fun σ : Over.mk (Spec.map (CommRingCat.ofHom (RingHom.id (Localization.Away t)))) ⟶ X =>
          fun k : Fin N => Spec.homEquivRingHom (σ.left ≫ j.left) (MvPolynomial.X k))
        inferInstance := sorry

/-- GR 5.4.15–16: a polynomial presentation recovers the solution-set topology. -/
theorem sections_presentationTopology {R : Type} [CommRing R] (t : R)
    (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [HenselianRing R (Ideal.span {t} * I)]
    (X : Over (Spec (CommRingCat.of (Localization.Away t)))) (N q : ℕ)
    (f : Fin q → MvPolynomial (Fin N) (Localization.Away t))
    (j : X ⟶ Over.mk (Spec.map (CommRingCat.ofHom
      (algebraMap (Localization.Away t) (MvPolynomial (Fin N) (Localization.Away t))))))
    [IsClosedImmersion j.left]
    (e : (Over.mk (Spec.map (CommRingCat.ofHom (RingHom.id (Localization.Away t)))) ⟶ X) ≃
      {a : Fin N → Localization.Away t | ∀ k, MvPolynomial.eval a (f k) = 0})
    (he : ∀ σ k, (e σ).val k = Spec.homEquivRingHom (σ.left ≫ j.left) (MvPolynomial.X k)) :
    QuasiProjectiveOver.sectionTopology t I X (RingHom.id _) =
      TopologicalSpace.induced e (sectionTopology t I N q f) := sorry

/-- GR 5.4.16–19: a chosen immersion, in particular into projective space, induces
this topology. Hence two choices of immersion give the same topology on sections. -/
theorem sections_immersionTopology {R : Type} [CommRing R] (t : R)
    (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [HenselianRing R (Ideal.span {t} * I)]
    (X Y : Over (Spec (CommRingCat.of (Localization.Away t))))
    (hX : QuasiProjectiveOver (Localization.Away t) X)
    (hY : QuasiProjectiveOver (Localization.Away t) Y)
    (j : X ⟶ Y) [IsImmersion j.left] :
    QuasiProjectiveOver.sectionTopology t I X (RingHom.id _) =
      TopologicalSpace.induced (fun σ => σ ≫ j)
        (QuasiProjectiveOver.sectionTopology t I Y (RingHom.id _)) := sorry

/-- GR 5.4.17, pp. 120–121: each section lies in an affine open of its scheme. -/
theorem sections_affine_neighborhood {A : Type} [CommRing A]
    (X : Over (Spec (CommRingCat.of A))) (hX : QuasiProjectiveOver A X)
    (σ : Over.mk (𝟙 (Spec (CommRingCat.of A))) ⟶ X) :
    ∃ (U : X.left.Opens), IsAffineOpen U ∧
      ∃ τ : Spec (CommRingCat.of A) ⟶ U, τ ≫ U.ι = σ.left := sorry

/-- GR 5.4.30(i), pp. 122–123: scheme morphisms act continuously on sections. -/
theorem sections_map_continuous {R : Type} [CommRing R] (t : R)
    (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [HenselianRing R (Ideal.span {t} * I)]
    (X Y : Over (Spec (CommRingCat.of (Localization.Away t))))
    (hX : QuasiProjectiveOver (Localization.Away t) X)
    (hY : QuasiProjectiveOver (Localization.Away t) Y) (φ : X ⟶ Y) :
    @Continuous _ _ (QuasiProjectiveOver.sectionTopology t I X (RingHom.id _))
      (QuasiProjectiveOver.sectionTopology t I Y (RingHom.id _)) (fun σ => σ ≫ φ) := sorry

/-- GR 5.4.30(ii), p. 123: smooth morphisms act openly on sections. -/
theorem sections_map_isOpenMap {R : Type} [CommRing R] (t : R)
    (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [HenselianRing R (Ideal.span {t} * I)]
    (X Y : Over (Spec (CommRingCat.of (Localization.Away t))))
    (hX : QuasiProjectiveOver (Localization.Away t) X)
    (hY : QuasiProjectiveOver (Localization.Away t) Y) (φ : X ⟶ Y) [Smooth φ.left] :
    @IsOpenMap _ _ (QuasiProjectiveOver.sectionTopology t I X (RingHom.id _))
      (QuasiProjectiveOver.sectionTopology t I Y (RingHom.id _)) (fun σ => σ ≫ φ) := sorry

/-- GR 5.4.21, pp. 121–122: smooth sections are dense after completion.
The completed ideal is the kernel of the zeroth residue projection, namely the closure of I. -/
theorem sections_denseRange {R : Type} [CommRing R] (t : R)
    (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [HenselianRing R (Ideal.span {t} * I)]
    (X : Over (Spec (CommRingCat.of (Localization.Away t))))
    (hX : QuasiProjectiveOver (Localization.Away t) X) [Smooth X.hom] :
    let J := RingHom.ker ((Pi.evalRingHom (fun n : ℕ => R ⧸ (Ideal.span {t} ^ n * I)) 0).comp
      (completion t I).subtype)
    letI := QuasiProjectiveOver.sectionTopology (completionMap t I t) J X
      (Localization.awayMap (completionMap t I) t)
    DenseRange (fun σ : Over.mk
      (Spec.map (CommRingCat.ofHom (RingHom.id (Localization.Away t)))) ⟶ X =>
      (Over.homMk (Spec.map (CommRingCat.ofHom (Localization.awayMap (completionMap t I) t)) ≫ σ.left)
        (by rw [Category.assoc, σ.w]; simp) :
        Over.mk (Spec.map (CommRingCat.ofHom (Localization.awayMap (completionMap t I) t))) ⟶ X)) := sorry

set_option maxHeartbeats 800000 in
/-- GR 5.4.15–19: scalar extension to the separated completion is continuous. -/
theorem sections_completion_continuous {R : Type} [CommRing R] (t : R)
    (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [HenselianRing R (Ideal.span {t} * I)]
    (X : Over (Spec (CommRingCat.of (Localization.Away t))))
    (hX : QuasiProjectiveOver (Localization.Away t) X) :
    let J := RingHom.ker ((Pi.evalRingHom (fun n : ℕ => R ⧸ (Ideal.span {t} ^ n * I)) 0).comp
      (completion t I).subtype)
    @Continuous _ _ (QuasiProjectiveOver.sectionTopology t I X (RingHom.id _))
      (QuasiProjectiveOver.sectionTopology (completionMap t I t) J X (Localization.awayMap (completionMap t I) t))
      (fun σ => (Over.homMk
        (Spec.map (CommRingCat.ofHom (Localization.awayMap (completionMap t I) t)) ≫ σ.left)
        (by rw [Category.assoc, σ.w]; simp) :
        Over.mk (Spec.map (CommRingCat.ofHom (Localization.awayMap (completionMap t I) t))) ⟶ X)) := sorry

-- Check: QuasiProjectiveOver.sectionTopology_zero_ideal
example {R : Type} [CommRing R] (t : R)
    (X : Over (Spec (CommRingCat.of (Localization.Away t))))
    (hX : QuasiProjectiveOver (Localization.Away t) X) :
    QuasiProjectiveOver.sectionTopology t ⊥ X (RingHom.id _) = ⊥ := sorry
-- Check: QuasiProjectiveOver.sectionTopology_empty
example {R : Type} [CommRing R] (t : R) (I : Ideal R)
    (X : Over (Spec (CommRingCat.of (Localization.Away t)))) [IsEmpty X.left] :
    QuasiProjectiveOver.sectionTopology t I X (RingHom.id _) = ⊥ := sorry
-- Check: QuasiProjectiveOver.sectionTopology_affine_line
example {R : Type} [CommRing R] (t : R) (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [HenselianRing R (Ideal.span {t} * I)] :
    let X := Over.mk (Spec.map (CommRingCat.ofHom
      (algebraMap (Localization.Away t) (MvPolynomial (Fin 1) (Localization.Away t)))))
    QuasiProjectiveOver.sectionTopology t I X (RingHom.id _) =
      TopologicalSpace.induced
        (fun σ : Over.mk (Spec.map (CommRingCat.ofHom (RingHom.id (Localization.Away t)))) ⟶ X =>
          Spec.homEquivRingHom σ.left (MvPolynomial.X 0)) (localizedTopology t I) := sorry

set_option maxHeartbeats 1600000 in
/-- GR 5.4.38: connected components of a smooth groupoid are unchanged by henselian
completion. The point groupoids are tied to their object and arrow schemes at both rings;
existence of arrows, and compatibility of scalar extension on objects, fix the orbit map. -/
theorem groupoid_orbits_completion (R : Type) [CommRing R] (t : R)
    (ht : t ∈ nonZeroDivisors R) (I : Ideal R)
    [HenselianRing R (Ideal.span {t} * I)]
    (B : Type) [CommRing B]
    (e : B ≃+* Localization.Away (completionMap t I t))
    (φ : Localization.Away t →+* B)
    (hφ : φ = e.symm.toRingHom.comp (Localization.awayMap (completionMap t I) t))
    (X₀ X₁ : Over (Spec (CommRingCat.of (Localization.Away t))))
    (s r : X₁ ⟶ X₀)
    (h₀ : QuasiProjectiveOver (Localization.Away t) X₀)
    (h₁ : QuasiProjectiveOver (Localization.Away t) X₁)
    (hsmooth : Smooth X₀.hom)
    (hpair : Smooth (pullback.lift (f := X₀.hom) (g := X₀.hom) s.left r.left
      (s.w.trans r.w.symm)))
    (C D : Type) [Groupoid C] [Groupoid D] (F : C ⥤ D)
    (e₀ : C ≃ (Over.mk (𝟙 (Spec (CommRingCat.of (Localization.Away t)))) ⟶ X₀))
    (e₁ : D ≃ (Over.mk (Spec.map (CommRingCat.ofHom
      φ)) ⟶ X₀))
    (ha : ∀ a b : C, Nonempty (a ⟶ b) ↔ ∃ z :
      Over.mk (𝟙 (Spec (CommRingCat.of (Localization.Away t)))) ⟶ X₁,
        z ≫ s = e₀ a ∧ z ≫ r = e₀ b)
    (hb : ∀ a b : D, Nonempty (a ⟶ b) ↔ ∃ z :
      Over.mk (Spec.map (CommRingCat.ofHom
        φ)) ⟶ X₁,
        z ≫ s = e₁ a ∧ z ≫ r = e₁ b)
    (hF : ∀ a : C, (e₁ (F.obj a)).left =
      Spec.map (CommRingCat.ofHom φ) ≫ (e₀ a).left) :
    Function.Bijective F.mapConnectedComponents := sorry

end HenselianApproximation
end


namespace AlgebraStructureModuli
variable (A : Type u) [CommRing A] (P : Type u) [AddCommGroup P] [Module A P]

/-! ### P3/etale-algebra-structure-schemes -/

/-- The multiplication and unit equations of GR 5.4.43. Addition and scalars are fixed. -/
structure Law where
  mul : P →ₗ[A] P →ₗ[A] P
  one : P
  assoc : ∀ x y z, mul (mul x y) z = mul x (mul y z)
  comm : ∀ x y, mul x y = mul y x
  unit : ∀ x, mul one x = x

/-- The ring on the fixed module described by a law. -/
def Law.Ring (_m : Law A P) := P
instance (m : Law A P) : CommRing m.Ring := by sorry
instance (m : Law A P) : Algebra A m.Ring := by sorry

theorem Law.operations (m : Law A P) (x y : P) :
    (show m.Ring from x) + (show m.Ring from y) = (show m.Ring from x + y) ∧
    (show m.Ring from x) * (show m.Ring from y) = (show m.Ring from m.mul x y) ∧
    (1 : m.Ring) = m.one ∧ ∀ a : A, algebraMap A m.Ring a = a • m.one := sorry

/-- Ordinary algebras supply points of the algebra-structure functor. -/
def ofAlgebra (B : Type u) [CommRing B] [Algebra A B] : Law A B where
  mul := LinearMap.mul A B
  one := 1
  assoc := mul_assoc
  comm := mul_comm
  unit := one_mul

/-- Étale laws form the discriminant-open subfunctor. -/
abbrev EtaleLaw := {m : Law A P // Algebra.Etale A m.Ring}

/-- GR 5.4.45: the coordinate algebra of X_P represents laws on B ⊗ P.
Naturality is encoded by representability of the functor, not by a choice of a basis. -/
def lawFunctor : CommAlgCat.{u} A ⥤ Type u where
  obj B := Law B (B ⊗[A] P)
  map := by sorry
  map_id := by sorry
  map_comp := by sorry

/-- Scalar extension carries the multiplication and unit by tensoring. -/
theorem lawFunctor_map (B C : CommAlgCat.{u} A) (f : B ⟶ C)
    (m : Law B (B ⊗[A] P)) (x y : P) :
    ((lawFunctor A P).map f m).one =
      TensorProduct.map f.hom.toLinearMap (LinearMap.id : P →ₗ[A] P) m.one ∧
    ((lawFunctor A P).map f m).mul (1 ⊗ₜ x) (1 ⊗ₜ y) =
      TensorProduct.map f.hom.toLinearMap (LinearMap.id : P →ₗ[A] P)
        (m.mul (1 ⊗ₜ x) (1 ⊗ₜ y)) := sorry

/-- An affine representing algebra, with its natural identification of points. -/
structure Model (F : CommAlgCat.{u} A ⥤ Type u) where
  coordinates : CommAlgCat.{u} A
  finitePresentation : Algebra.FinitePresentation A coordinates
  points : coyoneda.obj (Opposite.op coordinates) ≅ F

/-- The affine scheme X_P of all laws, GR 5.4.45. -/
def X [Module.Finite A P] [Module.Projective A P] : Model A (lawFunctor A P) := sorry

-- Check: laws_rank_zero
example : Subsingleton (Law A (Fin 0 → A)) := sorry
-- Check: laws_rank_one
example : Nonempty (Law A A ≃ Aˣ) := sorry
-- Check: laws_split_rank_two
example (x y : A × A) : (ofAlgebra A (A × A)).mul x y = (x.1 * y.1, x.2 * y.2) := rfl
-- Check: etale_laws_rank_zero
example : Subsingleton (EtaleLaw A (Fin 0 → A)) ∧ Nonempty (EtaleLaw A (Fin 0 → A)) := sorry
-- Check: etale_laws_rank_one
example : Nonempty (EtaleLaw A A ≃ Aˣ) := sorry
-- Check: etale_laws_dual_numbers
example [Nontrivial A] : ¬ Algebra.Etale A (ofAlgebra A (DualNumber A)).Ring := sorry
-- Check: X_rank_zero
example : Nonempty ((X A (Fin 0 → A)).coordinates ≅ CommAlgCat.of A A) := sorry
-- Check: X_rank_one
example (B : CommAlgCat.{u} A) :
    Nonempty (((X A A).coordinates ⟶ B) ≃ Bˣ) := sorry
-- Check: X_rank_two_distinct
example [Nontrivial A] : ∃ f g : (X A (A × A)).coordinates ⟶ CommAlgCat.of A A,
    f ≠ g ∧ ((X A (A × A)).points.hom.app _ f).one =
      ((X A (A × A)).points.hom.app _ g).one := sorry

/-- GR 5.4.46: the affine open representing the étale laws. -/
def etaleLawFunctor : CommAlgCat.{u} A ⥤ Type u where
  obj B := EtaleLaw B (B ⊗[A] P)
  map := by sorry
  map_id := by sorry
  map_comp := by sorry

def U [Module.Finite A P] [Module.Projective A P] : Model A (etaleLawFunctor A P) := sorry

/-- The module automorphism functor of GR 5.4.48, not algebra automorphisms. -/
def autFunctor : CommAlgCat.{u} A ⥤ Type u where
  obj B := (B ⊗[A] P) ≃ₗ[B] (B ⊗[A] P)
  map := by sorry
  map_id := by sorry
  map_comp := by sorry

def Aut [Module.Finite A P] [Module.Projective A P] : Model A (autFunctor A P) := sorry

-- Check: U_rank_zero
example : Nonempty ((U A (Fin 0 → A)).coordinates ≅ CommAlgCat.of A A) := sorry
-- Check: U_rank_one
example (B : CommAlgCat.{u} A) : Nonempty (((U A A).coordinates ⟶ B) ≃ Bˣ) := sorry
-- Check: U_split_rank_two
example (B : CommAlgCat.{u} A) : ∃ f : (U A (A × A)).coordinates ⟶ B,
    ((U A (A × A)).points.hom.app B f).val = ofAlgebra B (B ⊗[A] (A × A)) := sorry
-- Check: Aut_rank_zero
example (B : CommAlgCat.{u} A) : Unique ((Aut A (Fin 0 → A)).coordinates ⟶ B) := sorry
-- Check: Aut_rank_one
example (B : CommAlgCat.{u} A) : Nonempty (((Aut A A).coordinates ⟶ B) ≃ Bˣ) := sorry
-- Check: Aut_rank_two
example (B : CommAlgCat.{u} A) :
    Nonempty (((Aut A (Fin 2 → A)).coordinates ⟶ B) ≃ (Matrix (Fin 2) (Fin 2) B)ˣ) := sorry

/-- Transport of a law by a change of basis: g is an algebra isomorphism from m to g·m. -/
def changeBasis (g : P ≃ₗ[A] P) (m : Law A P) : Law A P where
  mul := by sorry
  one := g m.one
  assoc := by sorry
  comm := by sorry
  unit := by sorry

theorem changeBasis_mul (g : P ≃ₗ[A] P) (m : Law A P) (x y : P) :
    (changeBasis A P g m).mul x y = g (m.mul (g.symm x) (g.symm y)) := sorry

/-- Naturality of the étale subfunctor under extension of scalars. -/
def etaleToLaw : etaleLawFunctor A P ⟶ lawFunctor A P where
  app B := ↾fun m => m.val
  naturality := by sorry

/-- The affine open U_P → X_P, given contravariantly on coordinates. -/
def openCoordinates [Module.Finite A P] [Module.Projective A P] :
    (X A P).coordinates ⟶ (U A P).coordinates := sorry

theorem openCoordinates_points [Module.Finite A P] [Module.Projective A P]
    (B : CommAlgCat.{u} A) (f : (U A P).coordinates ⟶ B) :
    (X A P).points.hom.app B (openCoordinates A P ≫ f) =
      ((U A P).points.hom.app B f).val := sorry

theorem U_smooth [Module.Finite A P] [Module.Projective A P] :
    Algebra.Smooth A (U A P).coordinates := sorry

theorem U_openImmersion [Module.Finite A P] [Module.Projective A P] :
    AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (openCoordinates A P).hom.toRingHom)) := sorry

-- Check: change_basis_identity
example (m : Law A P) : changeBasis A P (LinearEquiv.refl A P) m = m := sorry
-- Check: change_basis_unit
example (g : P ≃ₗ[A] P) (m : Law A P) : (changeBasis A P g m).one = g m.one := rfl
-- Check: change_basis_rank_one_scale
example (u : Aˣ) : ∃ m : Law A A, m.one = (u : A) ∧
    ∀ x y, m.mul x y = (↑(u⁻¹) : A) * x * y := sorry

/-- Scalar extension of module automorphisms is fixed on pure tensors. -/
theorem autFunctor_map_tmul {B C : CommAlgCat.{u} A} (f : B ⟶ C)
    (g : B ⊗[A] P ≃ₗ[B] B ⊗[A] P) (b : B) (x : P) :
    (show C ⊗[A] P ≃ₗ[C] C ⊗[A] P from (autFunctor A P).map f g)
      (f.hom b ⊗ₜ[A] x) =
      TensorProduct.map f.hom.toLinearMap LinearMap.id (g (b ⊗ₜ[A] x)) := sorry

/-- Coordinate map for (g,m) ↦ (g·m,m), GR 5.4.51–53. -/
def actionGraph [Module.Finite A P] [Module.Projective A P] :
    ((U A P).coordinates ⊗[A] (U A P).coordinates) →ₐ[A]
      ((Aut A P).coordinates ⊗[A] (U A P).coordinates) := sorry

theorem actionGraph_points [Module.Finite A P] [Module.Projective A P]
    (B : CommAlgCat.{u} A) (g : (Aut A P).coordinates ⟶ B) (m : (U A P).coordinates ⟶ B) :
    let ev := Algebra.TensorProduct.lift g.hom m.hom (fun _ _ => Commute.all _ _)
    let left := CommAlgCat.ofHom ((ev.comp (actionGraph A P)).comp
      (Algebra.TensorProduct.includeLeft : (U A P).coordinates →ₐ[A]
        (U A P).coordinates ⊗[A] (U A P).coordinates))
    let right := CommAlgCat.ofHom ((ev.comp (actionGraph A P)).comp
      (Algebra.TensorProduct.includeRight : (U A P).coordinates →ₐ[A]
        (U A P).coordinates ⊗[A] (U A P).coordinates))
    ((U A P).points.hom.app B left).val =
      changeBasis B (B ⊗[A] P) ((Aut A P).points.hom.app B g)
        ((U A P).points.hom.app B m).val ∧ right = m := sorry

theorem actionGraph_etale [Module.Finite A P] [Module.Projective A P] :
    letI := (actionGraph A P).toRingHom.toAlgebra
    Algebra.Etale ((U A P).coordinates ⊗[A] (U A P).coordinates)
      ((Aut A P).coordinates ⊗[A] (U A P).coordinates) := sorry

-- Check: change_basis_swap_product
example (x y : A × A) :
    (changeBasis A (A × A) (LinearEquiv.prodComm A A A)
      (ofAlgebra A (A × A))).mul x y = (x.1 * y.1, x.2 * y.2) := sorry
-- Check: change_basis_negate
example (x y : A) :
    (changeBasis A A (LinearEquiv.neg A) (ofAlgebra A A)).mul x y = -(x * y) ∧
    (changeBasis A A (LinearEquiv.neg A) (ofAlgebra A A)).one = -1 := sorry

end AlgebraStructureModuli

section FiniteEtaleUniform

/-! ### P3/finite-etale-affinoid-algebra -/

example := @TauCetiRoadmap.AdicEtaleGeometry.Huber.Pair.finiteEtale

/-! ### P3/finite-etale-covers-in-characteristic-p -/

/-- Sch12 5.23 and GR 3.5.28: the characteristic-p finite algebra is itself perfectoid. -/
theorem finiteEtale_charP_perfectoid (p : ℕ) [Fact p.Prime] (A B : Type u)
    [CommRing A] [UniformSpace A] [IsUniformAddGroup A] [IsTopologicalRing A]
    [IsTateRing A] [CompleteSpace A] [T2Space A] [Perfectoid.IsPerfectoidTateRing p A]
    [CommRing B] [UniformSpace B] [IsUniformAddGroup B] [IsTopologicalRing B]
