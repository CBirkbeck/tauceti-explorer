/-! ### P0/almost-algebras -/

/-- Almost algebras are commutative monoid objects, GR (2.2.5). -/
abbrev Algebra := CommMon (Module S)

namespace Algebra

open scoped MonObj

/-- The algebra of almost elements, GR Proposition 2.2.13 and (2.2.5). -/
def elements : Algebra S ⥤ CommAlgCat.{u} V := sorry

/-- The underlying module is the module of almost elements. -/
def elementsUnderlying : elements S ⋙ (forget₂ (CommAlgCat V) (AlgCat V) ⋙ forget₂ (AlgCat V) (ModuleCat V)) ≅
    CommMon.forget (Module S) ⋙ Module.elements S := sorry

/-- Almost elements as maps from the tensor unit. -/
def elementsHomEquiv (A : Algebra S) :
    (elements S).obj A ≃ₗ[V] (𝟙_ (Module S) ⟶ A.X) := sorry

/-- The algebra unit is the unit of the monoid object. -/
theorem elementsHomEquiv_one (A : Algebra S) : elementsHomEquiv S A 1 = η[A.X] := sorry

/-- Multiplication of almost elements is induced by the monoid multiplication. -/
theorem elementsHomEquiv_mul (A : Algebra S) (x y : (elements S).obj A) :
    elementsHomEquiv S A (x * y) = (λ_ (𝟙_ (Module S))).inv ≫
      (elementsHomEquiv S A x ⊗ₘ elementsHomEquiv S A y) ≫ μ[A.X] := sorry

/-- Almostification of ordinary algebras, GR (2.2.5). -/
def toAlmost : CommAlgCat.{u} V ⥤ Algebra S := sorry

/-- The underlying almost module of an almostified algebra. -/
def toAlmostUnderlying : toAlmost S ⋙ CommMon.forget (Module S) ≅
    (forget₂ (CommAlgCat V) (AlgCat V) ⋙ forget₂ (AlgCat V) (ModuleCat V)) ⋙ Almost.toAlmost S := sorry

/-- Algebra almostification and almost elements are adjoint, GR Proposition 2.2.13. -/
def adj : toAlmost S ⊣ elements S := sorry

/-- Almost elements recover the algebra after almostification. -/
instance counit_isIso : IsIso (adj S).counit := sorry

/-- Modules over an almost algebra use Mathlib's module objects. -/
abbrev ModuleCat (A : Algebra S) := CategoryTheory.Mod (Module S) A.X

/-! ### P0/change-of-basic-setup -/

/-- Scalar change identifies module objects with the quotient over the ring of almost elements. -/
def moduleEquiv (A : Algebra S) : ModuleCat S A ≌
    Module (S.baseChange ((elements S).obj A)) := sorry

/-- Forgetting the module action agrees naturally with taking almost elements over
`A_*`, restricting to `V`, and almostifying; GR Remark 2.2.12 and Proposition 2.2.13, p. 14. -/
theorem moduleEquiv_functor_forget (A : Algebra S) :
    Nonempty ((moduleEquiv S A).functor ⋙
      Module.elements (S.baseChange ((elements S).obj A)) ⋙
      _root_.ModuleCat.restrictScalars (algebraMap V ((elements S).obj A)) ⋙
      Almost.toAlmost S ≅ CategoryTheory.Mod.forget (D := Module S) A.X) := sorry

