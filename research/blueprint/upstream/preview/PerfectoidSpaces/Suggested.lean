/-! ### P6/pro-object-flattening -/

/-- Flattening is the limit of the cofiltered diagram of pro-objects presenting the input.
The carrier uses Mathlib's Ind completion and categorical opposites. -/
def proFlatten (C : Type u) [Category.{v} C] :
    (Ind ((Ind Cᵒᵖ)ᵒᵖ)ᵒᵖ)ᵒᵖ ⥤ (Ind Cᵒᵖ)ᵒᵖ where
  obj X := limit (Ind.presentation X.unop).F.leftOp
  map := by sorry
  map_id := by sorry
  map_comp := by sorry

/-- The constant pro-object functor is left adjoint to flattening. This specifies the
maps of the limit functor as well as its objects. -/
theorem proFlatten_adjunction (C : Type u) [Category.{v} C] :
    Nonempty ((Ind.yoneda (C := ((Ind Cᵒᵖ)ᵒᵖ)ᵒᵖ)).rightOp ⊣ proFlatten C) := sorry

/-- The unit and counit of the flattening adjunction recover the identity on each
constant pro-object and each flattened object (ECD, proof of Lemma 7.11(i), p. 33). -/
theorem proFlatten_obj (C : Type u) [Category.{v} C]
    (X : (Ind Cᵒᵖ)ᵒᵖ) (Y : (Ind ((Ind Cᵒᵖ)ᵒᵖ)ᵒᵖ)ᵒᵖ) :
    let δ := (Ind.yoneda (C := ((Ind Cᵒᵖ)ᵒᵖ)ᵒᵖ)).rightOp
    let a := (proFlatten_adjunction C).some
    (δ.map (a.unit.app X) ≫ a.counit.app (δ.obj X) = 𝟙 (δ.obj X)) ∧
      (a.unit.app ((proFlatten C).obj Y) ≫ (proFlatten C).map (a.counit.app Y) =
        𝟙 ((proFlatten C).obj Y)) := by
  exact ⟨(proFlatten_adjunction C).some.left_triangle_components X,
    (proFlatten_adjunction C).some.right_triangle_components Y⟩

-- Check: proFlatten_constant
example (C : Type u) [Category.{v} C] (X : (Ind Cᵒᵖ)ᵒᵖ) :
    Nonempty ((proFlatten C).obj (op (Ind.yoneda.obj (op X))) ≅ X) := sorry
-- Check: proFlatten_empty
example : let E : (Ind FintypeCatᵒᵖ)ᵒᵖ := op (Ind.yoneda.obj (op (FintypeCat.of Empty)))
    Unique ((proFlatten FintypeCat).obj (op (Ind.yoneda.obj (op E))) ⟶ E) := sorry
-- Check: proFlatten_two
example : let B : (Ind FintypeCatᵒᵖ)ᵒᵖ := op (Ind.yoneda.obj (op (FintypeCat.of (Fin 2))))
    Nat.card ((proFlatten FintypeCat).obj (op (Ind.yoneda.obj (op B))) ⟶ B) = 4 := sorry


end TauCetiRoadmap.PerfectoidSpaces
end


