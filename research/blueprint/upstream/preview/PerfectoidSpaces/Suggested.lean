local instance (R : Type u) [CommRing R] : HasDerivedCategory (ModuleCat.{u} R) :=
  HasDerivedCategory.standard _
local instance (T : BasicSetup V) : HasDerivedCategory (Module T) := HasDerivedCategory.standard _

/-! ### P0/almost-cotangent-complex -/

/-- GR's cotangent construction uses lower shriek-shriek of the exactified map,
then extends coefficients along the projection to B_!!. -/
def cotangentModel {A B : Algebra S} (f : A ⟶ B) :
    ChainComplex (ModuleCat.{u} ((Algebra.shriekShriek S).obj B)) ℕ :=
  letI := ((Algebra.shriekShriek S).map ((Algebra.exactification S).map f)).hom.toAlgebra
  ((ModuleCat.extendScalars
    (((Algebra.shriekShriek S).map ((Algebra.exactificationπ S).app B)).hom.toRingHom)).mapHomologicalComplex _).obj
      (CotangentComplex.model ((Algebra.shriekShriek S).obj ((Algebra.exactification S).obj A))
        ((Algebra.shriekShriek S).obj ((Algebra.exactification S).obj B)))

/-- The unalmostified complex over B_!!, GR Definition 2.5.20. -/
def cotangentComplex {A B : Algebra S} (f : A ⟶ B) :
    DerivedCategory (ModuleCat.{u} ((Algebra.shriekShriek S).obj B)) :=
  DerivedCategory.Q.obj ((cotangentModel S f).extend (ComplexShape.embeddingUpIntLE 0))

/-- Almostification uses B_* as the coefficient ring for the equivalent category of B-modules. -/
def almostCotangentModel {A B : Algebra S} (f : A ⟶ B) :
    ChainComplex (Module (S.baseChange ((Algebra.elements S).obj B))) ℕ :=
  (((ModuleCat.extendScalars (((Algebra.shriekShriekToElements S).app B).hom.toRingHom)) ⋙
    toAlmost (S.baseChange ((Algebra.elements S).obj B))).mapHomologicalComplex _).obj (cotangentModel S f)

/-- The almost cotangent complex in the derived category of B-modules. -/
def almostCotangentComplex {A B : Algebra S} (f : A ⟶ B) :
    DerivedCategory (Module (S.baseChange ((Algebra.elements S).obj B))) :=
  DerivedCategory.Q.obj ((almostCotangentModel S f).extend (ComplexShape.embeddingUpIntLE 0))

/-! ### P0/cotangent-transitivity -/

/-- Functoriality for (A → B) → (A → C), after extension to C_!!.
The chain formula is `cotangentTransitivityFirst_tmul`. -/
def cotangentTransitivityFirst {A B C : Algebra S} (f : A ⟶ B) (g : B ⟶ C) :
    ((ModuleCat.extendScalars ((Algebra.shriekShriek S).map g).hom.toRingHom).mapHomologicalComplex _).obj
      (cotangentModel S f) ⟶ cotangentModel S (f ≫ g) := sorry

/-- Functoriality for (A → C) → (B → C), over C_!!.
The chain formula is `cotangentTransitivitySecond_apply`. -/
def cotangentTransitivitySecond {A B C : Algebra S} (f : A ⟶ B) (g : B ⟶ C) :
    cotangentModel S (f ≫ g) ⟶ cotangentModel S g := sorry

open CategoryTheory.Pretriangulated in
/-- GR 2.5.32: the first two arrows are the functorial maps of the exactified model. -/
theorem cotangentComplex_transitivity {A B C : Algebra S} (f : A ⟶ B) (g : B ⟶ C) :
    let L := DerivedCategory.Q.obj
      ((((ModuleCat.extendScalars ((Algebra.shriekShriek S).map g).hom.toRingHom).mapHomologicalComplex _).obj (cotangentModel S f)).extend
          (ComplexShape.embeddingUpIntLE 0))
    let a := DerivedCategory.Q.map
      (HomologicalComplex.extendMap (cotangentTransitivityFirst S f g) (ComplexShape.embeddingUpIntLE 0))
    let b := DerivedCategory.Q.map
      (HomologicalComplex.extendMap (cotangentTransitivitySecond S f g) (ComplexShape.embeddingUpIntLE 0))
    ∃ d : cotangentComplex S g ⟶ L⟦(1 : ℤ)⟧,
      Triangle.mk a b d ∈ distTriang
        (DerivedCategory (ModuleCat.{u} ((Algebra.shriekShriek S).obj C))) := sorry

-- Check: cotangentTransitivityFirst_identity
example {A B : Algebra S} (f : A ⟶ B) : IsIso (cotangentTransitivityFirst S f (𝟙 B)) := sorry
-- Check: cotangentTransitivityFirst_zero_source
example {A C : Algebra S} (g : A ⟶ C) :
    DerivedCategory.Q.map (HomologicalComplex.extendMap (cotangentTransitivityFirst S (𝟙 A) g)
      (ComplexShape.embeddingUpIntLE 0)) = 0 := sorry
