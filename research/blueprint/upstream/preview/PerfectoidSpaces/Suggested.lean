  [Fact (IsTopologicallyNilpotent (p : B))]
namespace uniformTilt

/-! ### P1/spectral-norm-under-sharp -/

/-- The gauge is fixed by the entire compatible root system in the uniform tilt. -/
theorem gauge_sharp (ϖ : PseudoUniformizerRoots p B) [IsTateRing (uniformTilt p B)]
    (ψ : PseudoUniformizerRoots p (uniformTilt p B))
    (hψ : ∀ n m, coeff p B m (ψ.root n) = ϖ.root (n + m)) (x : uniformTilt p B) :
    ψ.gauge x = ϖ.gauge (sharp p B x) := sorry

variable [IsPerfectoidTateRing p B]
theorem equivTilt_plus (P : Pair B) :
    (plus (p := p) P).map (equivTilt (p := p) (B := B)).toRingHom = (Pair.tilt p P).plus := sorry

theorem equivTilt_theta (P : Pair B) :
    ∃ h : ∀ x ∈ plus (p := p) P, equivTilt x ∈ (Pair.tilt p P).plus,
      theta (p := p) P = (tilt.theta p P).comp
        (WittVector.map ((equivTilt (p := p) (B := B)).toRingHom.restrict _ _ h)) := sorry

