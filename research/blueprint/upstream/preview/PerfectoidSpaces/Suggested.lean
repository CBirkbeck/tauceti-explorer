namespace Algebra

/-- Almost elements of an ideal are its saturation by the almost ideal. -/
def idealElements (A : Algebra S) (I : _root_.Ideal ((elements S).obj A)) :
    _root_.Ideal ((elements S).obj A) where
  carrier := {x | ∀ ε ∈ S.ideal, ε • x ∈ I}
  zero_mem' := by simp
  add_mem' := by intros; sorry
  smul_mem' := by intros; sorry

theorem mem_idealElements (A : Algebra S) (I : _root_.Ideal ((elements S).obj A))
    (x : (elements S).obj A) :
    x ∈ idealElements S A I ↔ ∀ ε ∈ S.ideal, ε • x ∈ I := Iff.rfl

/-- The almost Jacobson radical, represented by a saturated ideal, GR Definition 5.1.1. -/
def jacobson (A : Algebra S) : _root_.Ideal ((elements S).obj A) :=
  idealElements S A (_root_.Ideal.jacobson ⊥)

/-- Henselianity of an almost pair, GR Definition 5.1.8. -/
def IsHenselianPair (A : Algebra S) (I : _root_.Ideal ((elements S).obj A)) : Prop :=
  I ≤ jacobson S A ∧ HenselianRing ((elements S).obj A)
    ((S.ideal.map (algebraMap V ((elements S).obj A))) * idealElements S A I)

/-- A scalar in the almost ideal generates a tight ideal, GR Definition 5.1.5. -/
theorem isTight_span (A : Algebra S) (ϖ : V) (hϖ : ϖ ∈ S.ideal) :
    IsTight S A (_root_.Ideal.span {algebraMap V ((elements S).obj A) ϖ}) := sorry

/-- Comparison of radicals on honest representatives, GR Lemma 5.1.2. -/
theorem le_jacobson_toAlmost_iff (R : CommAlgCat.{u} V) (J : _root_.Ideal R) :
    J.map (((adj S).unit.app R).hom.toRingHom) ≤ jacobson S ((toAlmost S).obj R) ↔
      S.ideal.map (algebraMap V R) * J ≤ _root_.Ideal.jacobson ⊥ := sorry

/-- Henselianity can be tested on any honest representative, GR Lemma 5.1.10. -/
theorem isHenselianPair_toAlmost_iff (R : CommAlgCat.{u} V) (J : _root_.Ideal R) :
    IsHenselianPair S ((toAlmost S).obj R) (J.map (((adj S).unit.app R).hom.toRingHom)) ↔
      HenselianRing R (S.ideal.map (algebraMap V R) * J) := sorry

/-- Complete almost pairs are henselian, GR Remark 5.3.7. -/
theorem isHenselianPair_of_isAdicComplete (A : Algebra S)
    (I : _root_.Ideal ((elements S).obj A)) (hA : IsAdicComplete S A I) :
    IsHenselianPair S A I := sorry

/-- Tight ideals in the almost radical have honest elements in the honest radical,
and henselianity then holds for that ideal of elements, GR Corollary 5.1.16. -/
theorem Ideal.IsTight.elements_le_jacobson (A : Algebra S)
    (I : _root_.Ideal ((elements S).obj A)) (hI : IsTight S A I) (hJ : I ≤ jacobson S A) :
    idealElements S A I ≤ _root_.Ideal.jacobson ⊥ ∧
      (IsHenselianPair S A I → HenselianRing ((elements S).obj A) (idealElements S A I)) := sorry

