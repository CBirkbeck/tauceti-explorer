/-! ### P3/etale-descent-perfectoid -/

/-- Finite étaleness is local for jointly-surjective étale covers of the target. -/
theorem finiteEtale_descent {Y X : Perfd p} (f : Y ⟶ X)
    (ι : Type 1) (U : ι → smallEtale p X)
    (hcover : ∀ x : YonedaAdicSpace.space.obj X.obj, ∃ i,
      x ∈ Set.range (YonedaAdicSpace.space.map (U i).obj.hom.hom))
    (hf : ∀ i, IsFiniteEtale p (pullback.snd f (U i).obj.hom)) : IsFiniteEtale p f := sorry

/-- Étaleness can be checked on any open cover of the source, using the analytic
étale predicate on perfectoid spaces (KL I, Definition 8.2.16, p. 162). -/
theorem etale_iff_openCover_source {Y X : Perfd p} (f : Y ⟶ X)
    {ι : Type*} (U : ι → TopologicalSpace.Opens (YonedaAdicSpace.space.obj Y.obj))
    (hcover : ∀ y : YonedaAdicSpace.space.obj Y.obj, ∃ i, y ∈ U i) :
    YonedaAdicSpace.IsEtaleLocalDescription f.hom ↔
      ∀ i, YonedaAdicSpace.IsEtaleLocalDescription ((restrictι p Y (U i)) ≫ f).hom := sorry

/-- Étaleness can be checked after pullback to any open cover of the target
(KL I, Definition 8.2.16 and 8.2.17(c), p. 162). -/
theorem etale_iff_openCover_target {Y X : Perfd p} (f : Y ⟶ X)
    {ι : Type*} (U : ι → TopologicalSpace.Opens (YonedaAdicSpace.space.obj X.obj))
    (hcover : ∀ x : YonedaAdicSpace.space.obj X.obj, ∃ i, x ∈ U i) :
    YonedaAdicSpace.IsEtaleLocalDescription f.hom ↔
      ∀ i, YonedaAdicSpace.IsEtaleLocalDescription
        (pullback.snd f (restrictι p X (U i))).hom := sorry

