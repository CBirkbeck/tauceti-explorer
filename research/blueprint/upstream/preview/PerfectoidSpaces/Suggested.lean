    (hκ : κ.IsStrongLimit) (hκ₀ : ℵ₀ < κ) (hsmall : IsKappaSmall p κ X)
    (hM : κ ≤ Cardinal.lift.{1} #M) :
    ∃ (Y : Perfd p) (f : Y ⟶ X) (Q : ProEtalePresentation p f)
