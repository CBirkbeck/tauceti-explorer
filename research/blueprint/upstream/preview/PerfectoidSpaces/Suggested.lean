/-! ### Layer 6: Computed transitions in the Hom diagrams -/

/-- The two-sheet trivial étale cover, as an object of the supplied slice. -/
def twoPointEtale (X : Perfd p) (hX : IsAffinoidPerfectoid p X.obj) : AffinoidEtale p X :=
  ⟨Over.mk (prodProfinite.fst p X (Profinite.of (Fin 2))),
        (prodProfinite.isAffinoidProEtale p X (Profinite.of (Fin 2)) hX).some.source_affinoid,
        prodProfinite.isEtale p X (Profinite.of (Fin 2))⟩

/-- The transition 0 → 1 is the constant-zero endomorphism, not the identity. -/
def twoPointTransition (X : Perfd p) (hX : IsAffinoidPerfectoid p X.obj) :
    Fin 2 ⥤ AffinoidEtale p X where
  obj _ := twoPointEtale p X hX
  map {i j} _ := if i = j then 𝟙 _ else
    ObjectProperty.homMk (Over.homMk
      (prodProfinite.map p X (CompHausLike.ofHom _ (ContinuousMap.const (Fin 2) (0 : Fin 2))))
      (prodProfinite.map_fst p X _))
  map_id := by sorry
  map_comp := by sorry

/-- The initial stage is the limit of 0 → 1, with legs identity and constant zero. -/
def twoPointPresentation (X : Perfd p) (hX : IsAffinoidPerfectoid p X.obj) :
    ProEtalePresentation p (prodProfinite.fst p X (Profinite.of (Fin 2))) where
  source_affinoid :=
    (prodProfinite.isAffinoidProEtale p X (Profinite.of (Fin 2)) hX).some.source_affinoid
  target_affinoid := hX
  I := Fin 2
  category := inferInstance
  cofiltered := inferInstance
  diagram := twoPointTransition p X hX
  cone := {
    pt := Over.mk (prodProfinite.fst p X (Profinite.of (Fin 2)))
    π := { app := fun j ↦ ((twoPointTransition p X hX).map (homOfLE (show (0 : Fin 2) ≤ j from by omega))).hom
           naturality := by sorry } }
  point_eq := rfl
  isLimit := by sorry

-- Check: isAffinoidProEtale_scholze2013_constant_zero_transition
example (X : Perfd p) (hX : IsAffinoidPerfectoid p X.obj) :
