/-! ### Layer 6: The finite character transform and Hom variance -/

/-- Restriction of the Fourier map to the cyclic group algebra at level n.
Coefficients are sent to constants and [a] to b ↦ ζ^(a*b); this fixes the character convention. -/
def finiteFourier (n : ℕ) (ζ : ℂ_[p]) (hζ : IsPrimitiveRoot ζ (p ^ n)) :
    AddMonoidAlgebra ℂ_[p] (ZMod (p ^ n)) →+* (ZMod (p ^ n) → ℂ_[p]) where
  toFun f b := f.coeff.sum (fun a c ↦ c * ζ ^ (a.val * b.val))
  map_one' := by sorry
  map_mul' := by sorry
  map_zero' := by sorry
  map_add' := by sorry

theorem finiteFourier_single (n : ℕ) (ζ : ℂ_[p]) (hζ : IsPrimitiveRoot ζ (p ^ n))
    (a b : ZMod (p ^ n)) (c : ℂ_[p]) :
    finiteFourier p n ζ hζ (AddMonoidAlgebra.single a c) b = c * ζ ^ (a.val * b.val) := sorry

namespace Checks

/- The finite-support division uses the coordinate of the perfected unit annulus. -/
section division_by_T_sub_one
example (π : PseudoUniformizerRoots p ℂ_[p]) :
    let K := AffinoidField.ofRankOne p ℂ_[p]
    let R := rationalPair p (discPair p K π) (unitAnnulus p K π)
    let T := (rationalMap p (discPair p K π) (unitAnnulus p K π)).toRingHom
      (perfectedTateAlgebra.rootX π () 0)
    let c : ℤ → ℂ_[p] := fun a ↦ if a = 0 then -1 else if a = 2 then 1 else 0
    let d : ℤ → ℂ_[p] := fun a ↦ ∑' k : ℕ, c (a + (k : ℤ) + 1)
    let C : ℂ_[p] →+* R := (rationalMap p (discPair p K π) (unitAnnulus p K π)).toRingHom.comp
      (algebraMap ℂ_[p] (perfectedTateAlgebra p π PUnit))
    d 0 = 1 ∧ d 1 = 1 ∧ (T - 1) * (C (d 0) + C (d 1) * T) =
      C (c 0) + C (c 2) * T ^ 2 := by
  sorry
end division_by_T_sub_one

section two_character_sum
example (hζ : IsPrimitiveRoot (-1 : ℂ_[2]) (2 ^ 1)) :
    let f : AddMonoidAlgebra ℂ_[2] (ZMod (2 ^ 1)) :=
      AddMonoidAlgebra.single 0 1 + AddMonoidAlgebra.single 1 1
    f.coeff.support.sup (fun a ↦ ‖f.coeff a‖₊) = 1 ∧
      finiteFourier 2 1 (-1) hζ f 0 = 2 ∧ finiteFourier 2 1 (-1) hζ f 1 = 0 ∧
      ‖finiteFourier 2 1 (-1) hζ f‖ = (1 / 2 : ℝ) := sorry
end two_character_sum

end Checks

