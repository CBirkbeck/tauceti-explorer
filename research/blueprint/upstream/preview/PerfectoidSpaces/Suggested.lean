      (proEtaleKappaEquivalence p X hX hκ hκ₀ hsmall).functor ⋙ ObjectProperty.ι _ := sorry

/-! ### Layer 6: Rational shrinking and simultaneous finite-stage models -/

/-- Rational refinements are taken inside specified affine charts and prescribed opens. -/
theorem isProEtale_iff_exists_rational {Y X : Perfd p} (f : Y ⟶ X) :
    IsProEtale p f ↔ ∀ (C : Chart p Y) (D : Chart p X)
      (y : underlyingPoints p (ofPair p C.ring))
      (x : underlyingPoints p (ofPair p D.ring))
      (hxy : pointMap p (C.map ≫ f) y = pointMap p D.map x)
      (V : TopologicalSpace.Opens (underlyingPoints p Y))
      (U : TopologicalSpace.Opens (underlyingPoints p X)),
      pointMap p C.map y ∈ V → pointMap p D.map x ∈ U →
      ∃ (RV : RationalOpen p C.ring) (RU : RationalOpen p D.ring)
        (a : ofPair p (rationalPair p C.ring RV) ⟶ ofPair p (rationalPair p D.ring RU)),
        let v := (spaFunctor p).map (rationalMap p C.ring RV).op
        let u := (spaFunctor p).map (rationalMap p D.ring RU).op
        y ∈ Set.range (pointMap p v) ∧ x ∈ Set.range (pointMap p u) ∧
        Set.range (pointMap p (v ≫ C.map)) ⊆ V ∧
        Set.range (pointMap p (u ≫ D.map)) ⊆ U ∧
        v ≫ C.map ≫ f = a ≫ u ≫ D.map ∧ IsAffinoidProEtale p a := sorry

/-- A finite-stage model of a stage of Z/Y over a stage of Y/X, including its
base-change identification. -/
structure CompositionModel {Z Y X : Perfd p} {g : Z ⟶ Y} {f : Y ⟶ X}
    (P : ProEtalePresentation p f) (Q : ProEtalePresentation p g) where
  i : P.I
  j : Q.I
  W : AffinoidEtale p (P.spaces.obj i)
  comparison : Over.mk (pullback.snd W.obj.hom (P.π i)) ≅ (Q.diagram.obj j).obj

namespace CompositionModel
variable {p} {Z Y X : Perfd p} {g : Z ⟶ Y} {f : Y ⟶ X}
  {P : ProEtalePresentation p f} {Q : ProEtalePresentation p g}

/-- Refinement commutes with both indexing arrows and with the finite-stage identification. -/
structure Hom (M N : CompositionModel p P Q) where
  base : M.i ⟶ N.i
  stage : M.j ⟶ N.j
  map : M.W.obj.left ⟶ N.W.obj.left
  base_comm : map ≫ N.W.obj.hom = M.W.obj.hom ≫ P.spaces.map base
  stage_comm : M.comparison.inv.left ≫ pullback.fst M.W.obj.hom (P.π M.i) ≫ map =
    (Q.diagram.map stage).hom.left ≫ N.comparison.inv.left ≫
      pullback.fst N.W.obj.hom (P.π N.i)

instance : Category (CompositionModel p P Q) where
  Hom := Hom
  id M := ⟨𝟙 _, 𝟙 _, 𝟙 _, by simp, by simp⟩
  comp a b := ⟨a.base ≫ b.base, a.stage ≫ b.stage, a.map ≫ b.map, by sorry, by sorry⟩
  id_comp := by sorry
  comp_id := by sorry
  assoc := by sorry

/-- Projection to the affine étale X-space underlying each model. -/
def diagram (P : ProEtalePresentation p f) (Q : ProEtalePresentation p g) :
    CompositionModel p P Q ⥤ AffinoidEtale p X where
  obj M := ⟨Over.mk (M.W.obj.hom ≫ (P.diagram.obj M.i).obj.hom), by sorry⟩
  map a := ObjectProperty.homMk (Over.homMk a.map (by sorry))
  map_id := by sorry
  map_comp := by sorry

/-- The cone leg is the stage map Z → Z_j followed by its model identification. -/
def cone (P : ProEtalePresentation p f) (Q : ProEtalePresentation p g) :
    Cone (diagram P Q ⋙ ObjectProperty.ι _) where
  pt := Over.mk (g ≫ f)
  π := {
    app := fun M ↦ Over.homMk
      (Q.π M.j ≫ M.comparison.inv.left ≫ pullback.fst M.W.obj.hom (P.π M.i)) (by sorry)
    naturality := by sorry }

theorem cofiltered (P : ProEtalePresentation p f) (Q : ProEtalePresentation p g) :
    IsCofiltered (CompositionModel p P Q) := sorry

theorem essentiallySmall (P : ProEtalePresentation p f) (Q : ProEtalePresentation p g) :
    EssentiallySmall.{0} (CompositionModel p P Q) := sorry

def isLimit (P : ProEtalePresentation p f) (Q : ProEtalePresentation p g) :
    IsLimit (cone P Q) := sorry

