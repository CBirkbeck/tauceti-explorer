namespace RegularTower
variable (p : ℕ) [Fact p.Prime]
section CohenColimit
variable {J : Type} [SmallCategory J] [IsFiltered J]
    (D : J ⥤ CommRingCat) [∀ j, IsDomain (D.obj j)]
    [∀ j, IsDiscreteValuationRing (D.obj j)]
    (hmax : ∀ j, IsLocalRing.maximalIdeal (D.obj j) = Ideal.span {(p : D.obj j)})
    (hcomplete : ∀ j, IsAdicComplete (Ideal.span {(p : D.obj j)}) (D.obj j))
    (k : Type) [Field k] (W : CohenDVR p k)
    (ι : (Functor.const J).obj (CommRingCat.of W.ring) ⟶ D)
    (hfin : ∀ j, letI : Algebra W.ring (D.obj j) := (ι.app j).hom.toAlgebra
      Module.Finite W.ring (D.obj j) ∧ Module.Flat W.ring (D.obj j)) (n : ℕ) (j₀ : J)

include hmax hcomplete hfin in
/-- The coefficient-extension power-series colimit is regular before completion. -/
theorem powerSeries_colimit_regular :
    IsRegularLocalRing ↑(colimit (powerSeriesDiagram D n) : CommRingCat) := sorry

include hmax hcomplete hfin in
/-- In the ramified presentation, quotient and maximal-adic completion give the same
p-f relation over the completed coefficient DVR (Cesnavicius 5.1, pp. 11–12). -/
theorem ramified_colimit_completion
    (f : MvPowerSeries (Fin n) (D.obj j₀))
    (hf : f ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) (D.obj j₀)) ^ 2) :
    let E := powerSeriesDiagram D n
    let L := (colimit E : CommRingCat)
    let V := (colimit D : CommRingCat)
    let Vhat := AdicCompletion (Ideal.span {(p : V)}) V
    let q : Ideal L := Ideal.span {(p : L) - (colimit.ι E j₀).hom f}
    let m : Ideal L := Ideal.span (insert (p : L) (Set.range (fun r : Fin n ↦
      (colimit.ι E j₀).hom (MvPowerSeries.X r))))
    let fhat := MvPowerSeries.map
      ((algebraMap V Vhat).comp (colimit.ι D j₀).hom) f
    IsRegularLocalRing (L ⧸ q) ∧
      Nonempty (AdicCompletion (m.map (Ideal.Quotient.mk q)) (L ⧸ q) ≃+*
        (MvPowerSeries (Fin n) Vhat ⧸
          Ideal.span {(p : MvPowerSeries (Fin n) Vhat) - fhat})) := sorry

end CohenColimit
end RegularTower

