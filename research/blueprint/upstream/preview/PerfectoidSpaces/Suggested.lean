section RootsTests

variable (p : ℕ) [Fact p.Prime]

-- Check: gauge_padic_formula
example (ϖ : PseudoUniformizerRoots p ℂ_[p]) (hϖ : ϖ.root 0 ^ p = p)
    (x : ℂ_[p]) (hx : x ≠ 0) :
    (ϖ.gauge x : ℝ) = 2 ^ ((p : ℝ) * Real.logb p ‖x‖) := sorry

