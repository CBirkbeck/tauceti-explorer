section Field

variable (p : ℕ) [Fact p.Prime] (K : Type*) [NontriviallyNormedField K] [IsUltrametricDist K]
  [CompleteSpace K]

/-! ### P1/perfectoid-field-definition -/

/-- A *perfectoid field* (ECD Definition 3.6) is a
nonarchimedean field — complete for a nontrivial nonarchimedean absolute value defining its
topology — which is a perfectoid Tate ring (for the Tate structure
`isTateRing_of_nontriviallyNormedField`). Equivalently (ECD Proposition 3.8, Sch12
Definition 3.1): not discretely valued, `‖p‖ < 1`, Frobenius surjective on `K° ⧸ p`
(`IsPerfectoidField.iff`). The parent projection `IsPerfectoidField.toIsPerfectoidTateRing` is the
coercion to perfectoid Tate rings (an instance). -/
class IsPerfectoidField : Prop extends IsPerfectoidTateRing p K

variable {K}

/-! ### P1/perfectoid-field-characterisation -/

/-- ECD Proposition 3.8: `K` is perfectoid iff
its value group is not discrete (it accumulates at `1`), `‖p‖ < 1`, and Frobenius is surjective
on `K° ⧸ p`. -/
theorem IsPerfectoidField.iff :
    IsPerfectoidField p K ↔ (∀ ε : ℝ, 1 < ε → ∃ x : K, 1 < ‖x‖ ∧ ‖x‖ < ε) ∧ ‖(p : K)‖ < 1 ∧
      Function.Surjective fun x : ModP (powerBoundedSubring K) p ↦ x ^ p := sorry

/-- ECD Definition 3.6 on a field with its given complete nontrivial norm. -/
theorem IsPerfectoidField.of_isPerfectoidTateRing_of_isField
    [IsPerfectoidTateRing p K] : IsPerfectoidField p K := ⟨⟩

/-- In characteristic `p`, a perfectoid field
is a complete perfect nonarchimedean field. -/
theorem IsPerfectoidField.iff_perfectRing [CharP K p] : IsPerfectoidField p K ↔ PerfectRing K p :=
  sorry

/-- `ℂ_p` is a perfectoid field. -/
instance isPerfectoidField_padicComplex : IsPerfectoidField p ℂ_[p] := sorry

-- Check: map_id_test
example : tilt.map p (RingHom.id ℂ_[p]) continuous_id = RingHom.id (tilt p ℂ_[p]) := sorry


/-- The completed cyclotomic extension `ℚ_p^cycl` is a perfectoid field. -/
instance padicCyclotomic.instIsPerfectoidField : IsPerfectoidField p (padicCyclotomic p) := sorry

end Field

section AinfCompatibility

namespace tilt

variable (p : ℕ) [Fact p.Prime] (F : Type*) [NontriviallyNormedField F]
  [IsUltrametricDist F] [CompleteSpace F] [CharP F p] [IsPerfectoidField p F]

/-- Witt vectors of the integral tilt identify with `A_inf = W(𝒪_F)` by the
restriction of `equivOfCharP` to integral elements (ECD Lemmas 3.10–3.11). -/
def ainfEquiv : WittVector p (Pair.tilt p (Pair.powerBounded F)).plus ≃+*
    WittVector p (NormedField.valuation (K := F)).integer :=
  RingEquiv.ofBijective
    (WittVector.map ((equivOfCharP : tilt p F ≃+* F).toRingHom.restrict
      (Pair.tilt p (Pair.powerBounded F)).plus
      (NormedField.valuation (K := F)).integer (by sorry))) (by sorry)

/-- The comparison applies the characteristic-p tilt equivalence to each Witt coordinate. -/
theorem ainfEquiv_coeff (w : WittVector p (Pair.tilt p (Pair.powerBounded F)).plus)
    (n : ℕ) :
    (((ainfEquiv p F w).coeff n : (NormedField.valuation (K := F)).integer) : F) =
      equivOfCharP (w.coeff n : tilt p F) := rfl

/-- Corresponding integral parameters give corresponding powers of the two-generator ideals. -/
theorem ainfEquiv_map_ideal (t : (Pair.tilt p (Pair.powerBounded F)).plus)
    (ϖ : (NormedField.valuation (K := F)).integer)
    (hϖ : equivOfCharP (t : tilt p F) = (ϖ : F)) (n : ℕ) :
    ((Ideal.span {(p : WittVector p (Pair.tilt p (Pair.powerBounded F)).plus),
      WittVector.teichmuller p t}) ^ n).map (ainfEquiv p F).toRingHom =
        (Ideal.span {(p : WittVector p (NormedField.valuation (K := F)).integer),
          WittVector.teichmuller p ϖ}) ^ n := sorry

/-- The comparison and its inverse are continuous for the corresponding `(p,[ϖ])`-adic
 topologies, including the degenerate parameters zero and one. -/
theorem ainfEquiv_continuous (t : (Pair.tilt p (Pair.powerBounded F)).plus)
    (ϖ : (NormedField.valuation (K := F)).integer)
    (hϖ : equivOfCharP (t : tilt p F) = (ϖ : F)) :
    letI : TopologicalSpace (WittVector p (Pair.tilt p (Pair.powerBounded F)).plus) :=
      (Ideal.span {(p : WittVector p (Pair.tilt p (Pair.powerBounded F)).plus),
        WittVector.teichmuller p t}).adicTopology
    letI : TopologicalSpace (WittVector p (NormedField.valuation (K := F)).integer) :=
      (Ideal.span {(p : WittVector p (NormedField.valuation (K := F)).integer),
        WittVector.teichmuller p ϖ}).adicTopology
    Continuous (ainfEquiv p F) ∧ Continuous (ainfEquiv p F).symm := sorry

-- Check: ainfEquiv_teichmuller
example (t : (Pair.tilt p (Pair.powerBounded F)).plus)
    (ϖ : (NormedField.valuation (K := F)).integer)
    (hϖ : equivOfCharP (t : tilt p F) = (ϖ : F)) :
    ainfEquiv p F (WittVector.teichmuller p t) = WittVector.teichmuller p ϖ := sorry

-- Check: ainfEquiv_prime_nonzero
example : ainfEquiv p F p = p ∧
    (p : WittVector p (NormedField.valuation (K := F)).integer) ≠ 0 ∧
    (ainfEquiv p F p).coeff 0 = 0 := sorry

-- Check: ainfEquiv_zero_parameter
example :
    letI : TopologicalSpace (WittVector p (Pair.tilt p (Pair.powerBounded F)).plus) :=
      (Ideal.span {(p : WittVector p (Pair.tilt p (Pair.powerBounded F)).plus)}).adicTopology
    letI : TopologicalSpace (WittVector p (NormedField.valuation (K := F)).integer) :=
      (Ideal.span {(p : WittVector p (NormedField.valuation (K := F)).integer)}).adicTopology
    Continuous (ainfEquiv p F) ∧ Continuous (ainfEquiv p F).symm := sorry

end tilt

end AinfCompatibility

