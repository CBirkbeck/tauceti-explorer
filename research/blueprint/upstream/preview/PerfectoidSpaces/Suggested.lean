/-! ### Layer 4: Local quotient charts and open gluing -/
namespace PerfectoidSpace
open Perfectoid TauCetiRoadmap.AdicEtaleGeometry
variable (p : ℕ) [Fact p.Prime]

/-! ### P4/adicspaces-closed-immersion-comparison -/

/-- The adic closed-immersion condition on a perfectoid morphism: each affinoid
base restriction is an affinoid quotient with its quotient topology and quotient plus ring. -/
def IsAdicClosedImmersion {Y X : Perfd p} (f : Y ⟶ X) : Prop :=
  ∀ C : Chart p X, ∃ (S : PairCat.{0} p)
    (e : pullback f C.map ≅ ofPair p S) (a : C.ring ⟶ S),
      e.hom ≫ (spaFunctor p).map a.op = pullback.snd f C.map ∧
      ∃ q : (C.ring ⧸ RingHom.ker a.toRingHom) ≃+* S,
        Continuous q ∧ Continuous q.symm ∧
        q.toRingHom.comp (Ideal.Quotient.mk _) = a.toRingHom ∧
        (C.ring.pair.quotient (RingHom.ker a.toRingHom)).plus.map q.toRingHom = S.pair.plus

/-- Adic closed immersions on perfectoid spaces agree with the local quotient-chart
condition of AdicSpacesPartII R0 on any adic representative. ECD Definitions 5.6–5.7
and Theorem 5.8 distinguish this from a merely topological closed immersion. -/
theorem isAdicClosedImmersion_iff_adicCharts {Y X : Perfd p} (f : Y ⟶ X)
    {A B : TauCeti.AdicSpace} (g : A ⟶ B)
    (eY : YonedaAdicSpace.ofAdicSpace.obj A ≅ Y.obj)
    (eX : YonedaAdicSpace.ofAdicSpace.obj B ≅ X.obj)
    (h : YonedaAdicSpace.ofAdicSpace.map g ≫ eX.hom = eY.hom ≫ f.hom) :
    IsAdicClosedImmersion p f ↔ ∀ y : B.obj,
      ∃ (C : TauCetiRoadmap.AdicSpacesPartII.AdicSpace.Chart B)
        (D : TauCetiRoadmap.AdicSpacesPartII.AdicSpace.Chart A)
        (a : TauCeti.Huber.Pair.Hom C.affinoid.pair D.affinoid.pair),
        y ∈ Set.range C.ι.hom.base ∧
        D.ι ≫ g = TauCetiRoadmap.AdicSpacesPartII.AdicSpace.Affinoid.map a ≫ C.ι ∧
        Set.range D.ι.hom.base = g.hom.base ⁻¹' Set.range C.ι.hom.base ∧
        IsOpenQuotientMap a.toRingHom ∧
        D.affinoid.pair.plus = (integralClosure
          (C.affinoid.pair.plus.map a.toRingHom) D.affinoid.ring).toSubring := sorry

theorem isAdicClosedImmersion_iff_locally_strong {Y X : Perfd p} (f : Y ⟶ X) :
    IsAdicClosedImmersion p f ↔ ∀ C : Chart p X,
      IsStronglyZariskiClosed p C.ring (pullback.snd f C.map) := sorry

/-! ### P4/closed-immersion-vs-zariski-closed -/

theorem IsAdicClosedImmersion.isClosedImmersion {Y X : Perfd p} (f : Y ⟶ X)
    (hf : IsAdicClosedImmersion p f) : IsClosedImmersion p f := sorry

theorem isAdicClosedImmersion_iff_strong (R : PairCat.{0} p) {Y : Perfd p}
