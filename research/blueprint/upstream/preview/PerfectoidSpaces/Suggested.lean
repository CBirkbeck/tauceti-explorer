/-- The global cone agrees with the explicitly completed pair. -/
def cofilteredLimit.pairIso (D : Iᵒᵖ ⥤ PairCat.{0} p)
    (i₀ : Iᵒᵖ) (π : PseudoUniformizerRoots p (D.obj i₀)) :
    cofilteredLimit p (D.rightOp ⋙ spaFunctor p)
      (fun i ↦ ⟨D.obj (op i), ⟨Iso.refl _⟩⟩) ≅
        ofPair p (completedColimitPair p D i₀ π) := sorry

theorem cofilteredLimit.pairIso_π (D : Iᵒᵖ ⥤ PairCat.{0} p)
