    (hv : IsOpenImmersion p v) (hu : IsOpenImmersion p u)
    (hV : IsAffinoidPerfectoid p V.obj) (hU : IsAffinoidPerfectoid p U.obj)
    (hw : v ≫ f = g ≫ u) (hf : IsAffinoidProEtale p f) : IsAffinoidProEtale p g := sorry

