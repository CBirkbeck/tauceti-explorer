/- The naive model `R°⟨T/ϖ⟩` (no `p`-power roots, `root m = id`) is not almost equal to
`O_X(U)°` for `U = {|T| ≤ |ϖ|}`: `x = (T/ϖ)^{1/p} ∈ O_X(U)°` has `ϖ^{1/p} x = T^{1/p} ∈ R°⟨T/ϖ⟩`
but `ϖ^{1/p²} x ∉ R°⟨T/ϖ⟩`, and for every `k ≥ 1` the element `(T/ϖ)^{1 − 1/pⁿ}` with
`1 − 1/pⁿ > 1/p^k` has `ϖ^{1/p^k} (T/ϖ)^{1 − 1/pⁿ} ∉ R°⟨T/ϖ⟩`. -/

namespace Perfectoid

/-! ### P2/perfectoid-stably-uniform-and-sheafy -/

/-- Perfectoid Tate rings are stably uniform, independently of the plus ring
(KL II Corollary 3.3.19, p. 65). -/
theorem isStablyUniform_core (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R]
    [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] : TauCeti.Huber.IsStablyUniform R := sorry

/-- Stable uniformity of the ring underlying a perfectoid Tate pair
(KL II Corollary 3.3.19, p. 65). -/
instance PairCat.isStablyUniform {p : ℕ} [Fact p.Prime] (R : PairCat.{u} p) :
    TauCeti.Huber.IsStablyUniform R := isStablyUniform_core p R

/-- Sheafiness of the presentation-limit structure presheaf for every integral subring
(ECD Theorem 3.18, p. 18; KL II Corollary 3.3.19, p. 65). -/
theorem isSheafyRing (p : ℕ) [Fact p.Prime] (R : Type u) [CommRing R] [UniformSpace R]
    [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    [IsPerfectoidTateRing p R] : TauCeti.Huber.IsSheafyRing R := sorry

end Perfectoid

