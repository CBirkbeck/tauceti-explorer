/-! ### P4/surjective-perfectoid-map-almost-surjective-on-plus-rings -/

/-- AWS 2.8.5: the image of each root times an integral element lifts integrally. -/
theorem surjective_almostSurjective_plus {R S : PairCat.{0} p} (f : R ⟶ S)
    (hf : Function.Surjective f.toRingHom) (π : PseudoUniformizerRoots p R)
    (n : ℕ) (s : S.pair.plus) :
    ∃ r : R.pair.plus, f.toRingHom r = f.toRingHom (π.root n) * s := sorry

theorem stronglyZariskiClosed_iff_almostSurjective {R S : PairCat.{0} p} (f : R ⟶ S)
    (π : PseudoUniformizerRoots p R) :
    IsStronglyZariskiClosed_affinoid f ↔
      (∀ n (s : S.pair.plus), ∃ r : R.pair.plus,
        f.toRingHom r = f.toRingHom (π.root n) * s) ∧
      S.pair.plus = (integralClosure (R.pair.plus.map f.toRingHom) S).toSubring := sorry

