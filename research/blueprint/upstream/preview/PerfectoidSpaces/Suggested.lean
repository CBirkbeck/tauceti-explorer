open scoped MonoidalCategory
universe u
variable {V : Type u} [CommRing V] (S : BasicSetup V)

/-- GR 3.2.16: the lifting obstruction respects both the specified kernel map and the base. -/
theorem liftMorphism {A B₀ C₁ C₂ : Algebra S} (a : A ⟶ B₀)
    (I : Algebra.ModuleCat S B₀) (E : SquareZeroExtension S a I)
    (f₁ : B₀ ⟶ C₁) (f₂ : B₀ ⟶ C₂) (g : C₁ ⟶ C₂) (hg : f₁ ≫ g = f₂)
    (J₁ : Algebra.ModuleCat S C₁) (J₂ : Algebra.ModuleCat S C₂)
    (D₁ : SquareZeroExtension S (E.projection ≫ f₁) J₁)
    (D₂ : SquareZeroExtension S (E.projection ≫ f₂) J₂)
    (u₁ : I.X ⟶ J₁.X) (u₂ : I.X ⟶ J₂.X)
    (hu₁ : E.inclusion ≫ D₁.base.hom.hom = u₁ ≫ D₁.inclusion)
    (hu₂ : E.inclusion ≫ D₂.base.hom.hom = u₂ ≫ D₂.inclusion)
    (v : J₁ ⟶ (_root_.CategoryTheory.Mod.comap (D := Module S) g.hom.hom).obj J₂)
    (hu : u₁ ≫ v.hom = u₂) :
    let T := S.baseChange ((Algebra.elements S).obj C₁)
    let N := (Algebra.moduleEquiv S C₁).functor.obj
      ((_root_.CategoryTheory.Mod.comap (D := Module S) g.hom.hom).obj J₂)
    letI : HasDerivedCategory (Module T) := HasDerivedCategory.standard _
    let L := almostCotangentComplex S f₁
    let J := (DerivedCategory.singleFunctor (Module T) 0).obj N
    let lifts := {h : D₁.algebra ⟶ D₂.algebra //
      D₁.base ≫ h = D₂.base ∧ h ≫ D₂.projection = D₁.projection ≫ g ∧
        D₁.inclusion ≫ h.hom.hom = v.hom ≫ D₂.inclusion}
    ∃ ω : L ⟶ J⟦(1 : ℤ)⟧,
      (ω = 0 ↔ Nonempty lifts) ∧
      (ω = 0 → Nonempty (AddTorsor (L ⟶ J) lifts)) ∧
      (IsZero L → Nonempty lifts ∧ Subsingleton lifts) := sorry

end TauCetiRoadmap.PerfectoidSpaces.Almost
end

