/-! ### P4/strongly-zariski-closed-criterion -/

/-- Closed ideals with perfectoid quotient, expressed without choosing a quotient norm.
The surjective map is automatically open, so its quotient has precisely the quotient topology. -/
def PerfectoidQuotientIdeal (R : PairCat.{0} p) :=
  {I : Ideal R // IsClosed (I : Set R) ∧ ∃ (S : PairCat.{0} p) (f : R ⟶ S),
    Function.Surjective f.toRingHom ∧ RingHom.ker f.toRingHom = I}

/-- In the perfect characteristic-p tilt, a perfect ideal is stable under taking pth roots. -/
def ClosedPerfectTiltIdeal (R : PairCat.{0} p) :=
  {J : Ideal (tilt p R) // IsClosed (J : Set (tilt p R)) ∧ ∀ a, a ^ p ∈ J → a ∈ J}

def tiltIdealEquiv (R : PairCat.{0} p) : PerfectoidQuotientIdeal p R ≃ ClosedPerfectTiltIdeal p R := sorry

theorem tiltIdealEquiv_kernel {R S : PairCat.{0} p} (f : R ⟶ S)
    (hf : Function.Surjective f.toRingHom) (I : PerfectoidQuotientIdeal p R)
    (hI : I.val = RingHom.ker f.toRingHom) :
    (tiltIdealEquiv p R I).val = RingHom.ker ((PairCat.tiltFunctor p).map f).toRingHom := sorry

theorem tiltIdealEquiv_symm (R : PairCat.{0} p) (J : ClosedPerfectTiltIdeal p R) :
    ((tiltIdealEquiv p R).symm J).val =
      (Ideal.span (tilt.sharp '' (J.val : Set (tilt p R)))).closure := sorry

