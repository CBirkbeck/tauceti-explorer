namespace ProEtalePresentation
variable {p} {Y X Z : Perfd p} {f : Y ⟶ X} {g : Z ⟶ X}
  (P : ProEtalePresentation p f) (Q : ProEtalePresentation p g)
/-- Contravariance in the source index: arrows are precomposed before taking the colimit. -/
def homStage (j : Q.I) : P.Iᵒᵖ ⥤ Type 1 where
  obj i := (P.diagram.obj i.unop).obj ⟶ (Q.diagram.obj j).obj
  map a := TypeCat.ofHom fun h ↦ (P.diagram.map a.unop).hom ≫ h
  map_id := by sorry
  map_comp := by sorry

/-- Covariance in the target index; the outer operation is a limit. -/
def homDiagram : Q.I ⥤ Type 1 where
  obj j := colimit (P.homStage Q j)
  map a := colimMap {
    app := fun _ ↦ TypeCat.ofHom (fun h ↦ h ≫ (Q.diagram.map a).hom)
    naturality := by sorry }
  map_id := by sorry
  map_comp := by sorry

/-- ECD 7.10, p. 33 and Berkeley 8.2.4, pp. 57–58. -/
def homEquiv : (Over.mk f ⟶ Over.mk g) ≃ limit (P.homDiagram Q) := sorry

theorem homEquiv_stage (h : Over.mk f ⟶ Over.mk g) (j : Q.I) (i : P.I)
    (a : (P.diagram.obj i).obj ⟶ (Q.diagram.obj j).obj)
    (ha : P.π i ≫ a.left = h.left ≫ Q.π j) :
    limit.π (P.homDiagram Q) j (P.homEquiv Q h) =
      colimit.ι (P.homStage Q j) (Opposite.op i) a := sorry
end ProEtalePresentation

