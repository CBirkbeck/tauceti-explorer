attribute [local instance] subfieldPadicComplexTate
local instance (K : Subfield ℂ_[p]) : CompleteSpace K.topologicalClosure := sorry
attribute [local instance] kummerFieldComplete
local instance : IsTateRing (LaurentSeries (ZMod p)) := sorry
/-! ### P1/perfectoid-field-characterisation -/
theorem perfectLaurent_isField : IsField (completedPerfectLaurentFp p) := sorry
