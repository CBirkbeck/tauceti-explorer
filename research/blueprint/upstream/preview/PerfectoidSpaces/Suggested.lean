      (Ideal.Quotient.mk _ (algebraMap K (tateSeries 2 K) (π.root 0 ^ a)) : ordinaryAnnulus p K π a) := sorry
-- Check: ordinaryAnnulus_nonzero
example (a : ℕ) : (1 : ordinaryAnnulus p K π a) ≠ 0 := sorry
-- Check: ordinaryAnnulus_no_coordinate_root
example [CharP K p] (a : ℕ) (ha : 0 < a) :
    ¬ ∃ x : ordinaryAnnulus p K π a, x ^ p = Ideal.Quotient.mk _ (tateSeries.X 2 K 0) := sorry
