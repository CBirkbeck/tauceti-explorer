-- Check: tiltIdeal_zero
example (R : PairCat.{0} p) (I : PerfectoidQuotientIdeal p R) (hI : I.val = ⊥) :
    (tiltIdealEquiv p R I).val = ⊥ := sorry
-- Check: tiltIdeal_unit
example (R : PairCat.{0} p) (I : PerfectoidQuotientIdeal p R) (hI : I.val = ⊤) :
