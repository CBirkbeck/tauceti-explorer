/-! ### Layer 5: Computed transport in constant diagrams -/
namespace CategoryTheory.FilteredTwoColimit
universe v u w
variable {J : Type u} [SmallCategory J] [hJ : IsFiltered J]

theorem equivConst_ι_coherence (C : Type w) [Category.{v} C]
    {i j : J} (a : i ⟶ j) (c : C) :
    let F := ((Functor.const J).obj (Cat.of C)).toPseudofunctor'
    (equivConst_ι C j).inv.app c ≫ (equivConst (J := J) C).functor.map ((ιCompIso F a).hom.app c) ≫
      (equivConst_ι C i).hom.app c = 𝟙 c := sorry

-- Check: transport_empty_unique
example {i j : J} (a : i ⟶ j) :
    let F := ((Functor.const J).obj (Cat.of (Discrete PEmpty.{u+1}))).toPseudofunctor'
    ∀ α : (F.map ⟨a⟩).toFunctor ⋙ ι F j ≅ ι F i, α = ιCompIso F a := sorry
-- Check: transport_bool_false
example {i j : J} (a : i ⟶ j) :
    let C := Discrete Bool
    let F := ((Functor.const J).obj (Cat.of C)).toPseudofunctor'
    (equivConst_ι C j).inv.app (Discrete.mk false) ≫
      (equivConst (J := J) C).functor.map ((ιCompIso F a).hom.app (Discrete.mk false)) ≫
      (equivConst_ι C i).hom.app (Discrete.mk false) = 𝟙 (Discrete.mk false) := sorry
-- Check: transport_automorphisms
example {i j : J} (a : i ⟶ j) :
    let C := SingleObj (Equiv.Perm Bool)
    let c := SingleObj.star (Equiv.Perm Bool)
    let F := ((Functor.const J).obj (Cat.of C)).toPseudofunctor'
    (equivConst_ι C j).inv.app c ≫
      (equivConst (J := J) C).functor.map ((ιCompIso F a).hom.app c) ≫
      (equivConst_ι C i).hom.app c = 𝟙 c := sorry
end CategoryTheory.FilteredTwoColimit

