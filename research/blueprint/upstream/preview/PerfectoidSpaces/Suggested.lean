/-! ### Layer 2: Completed residue fields -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open TauCeti Huber ValuationSpectrum UniformSpace
variable (p : ℕ) [Fact p.Prime] (R : PairCat.{0} p)

/-! ### P2/completed-residue-fields -/

/-- The completion uses the supplier's residue valuation, including at higher-rank points. -/
abbrev CompletedResidue (x : spa R.pair.plus) :=
  Completion (WithVal (residueFieldValuation x.val))

/-- The canonical evaluation into the completed residue field. -/
def residueMap (x : spa R.pair.plus) : R →+* CompletedResidue p R x :=
  Completion.coeRingHom.comp (algebraMap R (WithVal (residueFieldValuation x.val)))

instance completedResidue_tate (x : spa R.pair.plus) : IsTateRing (CompletedResidue p R x) := sorry

/-- AWS Corollary 2.5.7, pp. 60–61, without a perfectoid base field. -/
instance completedResidue_perfectoid (x : spa R.pair.plus) :
    IsPerfectoidTateRing p (CompletedResidue p R x) := sorry

theorem residueMap_continuous (x : spa R.pair.plus) : Continuous (residueMap p R x) := sorry

/-- The positive subring is the closure of the original valuation ring, retaining
higher-rank information rather than replacing it by all power-bounded elements. -/
def residuePlus (x : spa R.pair.plus) : Subring (CompletedResidue p R x) :=
  ((Valued.v : Valuation (WithVal (residueFieldValuation x.val)) _).valuationSubring.toSubring.map
    Completion.coeRingHom).topologicalClosure

def residuePair (x : spa R.pair.plus) : Pair (CompletedResidue p R x) where
  plus := residuePlus p R x
  isRingOfIntegralElements := sorry

def residueTiltEquiv (x : spa R.pair.plus) :
    tilt p (CompletedResidue p R x) ≃+*
      CompletedResidue p ((PairCat.tiltFunctor p).obj R) (PerfectoidSpace.spaTilt p R.pair x) := sorry

theorem residueTiltEquiv_spec (x : spa R.pair.plus) :
    let _ := completedResidue_tate p ((PairCat.tiltFunctor p).obj R) (PerfectoidSpace.spaTilt p R.pair x)
    Continuous (residueTiltEquiv p R x) ∧ Continuous (residueTiltEquiv p R x).symm ∧
      (Pair.tilt p (residuePair p R x)).plus.map (residueTiltEquiv p R x).toRingHom =
        (residuePair p ((PairCat.tiltFunctor p).obj R) (PerfectoidSpace.spaTilt p R.pair x)).plus ∧
      ∀ a : tilt p R,
        residueTiltEquiv p R x ((tilt.map p (residueMap p R x) (residueMap_continuous p R x)) a) =
          residueMap p ((PairCat.tiltFunctor p).obj R) (PerfectoidSpace.spaTilt p R.pair x) a := sorry

-- Check: residue_zero_one
example (x : spa R.pair.plus) : residueMap p R x 0 = 0 ∧ residueMap p R x 1 = 1 :=
  ⟨map_zero _, map_one _⟩
-- Check: residue_support
example (x : spa R.pair.plus) (a : R) : residueMap p R x a = 0 ↔ a ∈ x.val.supp := sorry
-- Check: residue_field_recovery
example (hfield : IsField R) (x : spa R.pair.plus) :
    ∃ e : CompletedResidue p R x ≃+* R, Continuous e ∧ Continuous e.symm ∧
      e.toRingHom.comp (residueMap p R x) = RingHom.id R := sorry
-- Check: residue_integral_image
example (x : spa R.pair.plus) (a : R.pair.plus) : residueMap p R x a.val ∈ residuePlus p R x := sorry
-- Check: residue_inverse_parameter_nonmember
example (x : spa R.pair.plus) (ϖ : PseudoUniformizerRoots p R) :
    residueMap p R x (ϖ.zpow (-1) 0 : R) ∉ residuePlus p R x := sorry
-- Check: residue_integral_two_terms
example (x : spa R.pair.plus) (a b : R.pair.plus) :
    residueMap p R x (a.val + b.val) ∈ residuePlus p R x := sorry
-- Check: residue_tilt_zero_one
example (x : spa R.pair.plus) : residueTiltEquiv p R x 0 = 0 ∧ residueTiltEquiv p R x 1 = 1 :=
  ⟨map_zero _, map_one _⟩
-- Check: residue_tilt_injective
example (x : spa R.pair.plus) (a : tilt p (CompletedResidue p R x)) :
    residueTiltEquiv p R x a = 0 ↔ a = 0 := by
  exact (residueTiltEquiv p R x).map_eq_zero_iff
-- Check: residue_tilt_inverse_parameter
example (x : spa R.pair.plus) (ϖ : PseudoUniformizerRoots p R) :
    residueTiltEquiv p R x ((tilt.map p (residueMap p R x) (residueMap_continuous p R x)) ϖ.toTilt) =
      residueMap p ((PairCat.tiltFunctor p).obj R) (PerfectoidSpace.spaTilt p R.pair x) ϖ.toTilt := sorry
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
end

/-! ### Layer 2: Almost lifting for complete modules -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open TauCeti Huber
variable {V M N : Type*} [CommRing V] [AddCommGroup M] [AddCommGroup N]
  [Module V M] [Module V N]

/-! ### P2/almost-exactness-from-reduction-mod-pseudouniformizer -/

/-- The kernel form of the complete lifting argument. The reduction hypothesis is
written without choosing quotient-module identifications. -/
theorem almost_lift_kernel (m : Ideal V) (hm : m * m = m) (ϖ : V)
    [IsHausdorff (Ideal.span {ϖ}) M] (f : M →ₗ[V] N)
    (hN : ∀ y : N, ϖ • y = 0 → y = 0)
    (hmod : ∀ x : M, (∃ y : N, f x = ϖ • y) →
      ∀ ε ∈ m, ∃ z : M, ε • x = ϖ • z) :
    ∀ x : M, f x = 0 → ∀ ε ∈ m, ε • x = 0 := sorry

/-- Almost surjectivity modulo `ϖ` lifts for an idempotent ideal when the source is
`ϖ`-adically complete and the target is separated. Iterate `mN ⊆ f(M) + ϖ·mN`,
sum the corrections in `M`, and use separation of `N`. -/
theorem almost_lift_cokernel (m : Ideal V) (hm : m * m = m) (ϖ : V)
    [IsAdicComplete (Ideal.span {ϖ}) M] [IsHausdorff (Ideal.span {ϖ}) N]
    (f : M →ₗ[V] N)
    (hmod : ∀ y : N, ∀ ε ∈ m, ∃ (x : M) (z : N), ε • y = f x + ϖ • z) :
    ∀ y : N, ∀ ε ∈ m, ∃ x : M, ε • y = f x := sorry

-- Check: almost_lifting_zero_ideal
example (ϖ : V) (f : M →ₗ[V] N) (y : N) :
    ∀ ε ∈ (⊥ : Ideal V), ∃ (x : M) (z : N), ε • y = f x + ϖ • z := by
  intro ε hε
  have h : ε = 0 := hε
  subst ε
  exact ⟨0, 0, by simp⟩
-- Check: almost_lifting_identity
example (ϖ : V) (m : Ideal V) (y : M) (ε : V) (_hε : ε ∈ m) :
    ∃ (x z : M), ε • y = (LinearMap.id : M →ₗ[V] M) x + ϖ • z :=
  ⟨ε • y, 0, by simp⟩
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
end

/-! ### Layer 2: Reduction of complexes -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid
open CategoryTheory
variable {V : Type} [CommRing V]

/-- Termwise reduction modulo a principal ideal, then restriction of scalars to V. -/
def complexMod (ϖ : V) (C : CochainComplex (ModuleCat.{0} V) ℤ) :
    CochainComplex (ModuleCat.{0} V) ℤ :=
  ((ModuleCat.extendScalars (Ideal.Quotient.mk (Ideal.span {ϖ})) ⋙
    ModuleCat.restrictScalars (Ideal.Quotient.mk (Ideal.span {ϖ}))).mapHomologicalComplex
      (ComplexShape.up ℤ)).obj C

/-- Complete torsion-free lifting, with a general idempotent almost ideal.
Stacks 15.88.1(2),(3),(5) and 15.89 supply the derived-limit argument;
Sch12 proof of Proposition 6.14, p. 38, is the perfectoid application. -/
theorem almost_complex_reduction_iff (m : Ideal V) (hm : m * m = m)
    (ϖ : V) (C : CochainComplex (ModuleCat.{0} V) ℤ)
    (hbounded : ∃ a b : ℤ, ∀ q, q < a ∨ b < q → Subsingleton (C.X q))
    (hcomplete : ∀ q, IsAdicComplete (Ideal.span {ϖ}) (C.X q))
    (htorsion : ∀ q, ∀ x : C.X q, ϖ • x = 0 → x = 0) :
    (∀ q, ∀ ε ∈ m, ∀ x : C.homology q, ε • x = 0) ↔
      (∀ q, ∀ ε ∈ m, ∀ x : (complexMod ϖ C).homology q, ε • x = 0) := sorry

-- Check: reduction_unit
example (C : CochainComplex (ModuleCat.{0} V) ℤ) (q : ℤ) :
    Subsingleton ((complexMod (1 : V) C).X q) := sorry
-- Check: reduction_zero
example (C : CochainComplex (ModuleCat.{0} V) ℤ) : Nonempty (complexMod 0 C ≅ C) := sorry
-- Check: reduction_characteristic_two
example (C : CochainComplex (ModuleCat.{0} ℤ) ℤ) (q : ℤ)
    (x : (complexMod (2 : ℤ) C).X q) : (2 : ℤ) • x = 0 := sorry
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid
end

/-! ### Layer 2: Tensor pairs and their tilted pushouts -/
noncomputable section
namespace TauCetiRoadmap.PerfectoidSpaces.Perfectoid.PairCat
open TauCeti Huber TauCetiRoadmap.AdicSpacesPartII.Huber CategoryTheory CategoryTheory.Limits
variable (p : ℕ) [Fact p.Prime] (A B C : PairCat.{0} p) (f : A ⟶ B) (g : A ⟶ C)

/-- The actual completed tensor pair, with the algebra structures determined by f and g. -/
def tensorPair : PairCat.{0} p :=
  let _ := f.toRingHom.toAlgebra
  let _ := g.toRingHom.toAlgebra
  let _ : IsAdicHom (algebraMap A B) := by sorry
  let _ : IsAdicHom (algebraMap A C) := by sorry
  { carrier := CompletedTensor A B C
    pair := Pair.completedTensor A.pair B.pair C.pair f.map_mem_plus g.map_mem_plus }

def tensorInl : B ⟶ tensorPair p A B C f g := sorry
def tensorInr : C ⟶ tensorPair p A B C f g := sorry

theorem tensorInclusions_commute : f ≫ tensorInl p A B C f g = g ≫ tensorInr p A B C f g := sorry

/-- Both inclusions are the supplier's b ↦ b⊗1 and c ↦ 1⊗c, not arbitrary pushout maps. -/
theorem tensorInclusions_spec :
    let _ := f.toRingHom.toAlgebra
    let _ := g.toRingHom.toAlgebra
    (∀ b, (tensorInl p A B C f g).toRingHom b =
      Pair.completedTensor.tmul A B C (TensorProduct.tmul A b (1 : C))) ∧
    (∀ c, (tensorInr p A B C f g).toRingHom c =
      Pair.completedTensor.tmul A B C (TensorProduct.tmul A (1 : B) c)) := sorry

/-! ### P2/perfectoid-fibre-product-universal-property -/

theorem tensorPair_isPushout : Nonempty (IsColimit
    (PushoutCocone.mk (tensorInl p A B C f g) (tensorInr p A B C f g)
      (tensorInclusions_commute p A B C f g))) := sorry

/-- KL II Theorem 3.3.13(a): tilting the completed tensor pair. -/
def tensorTiltIso : (tiltFunctor p).obj (tensorPair p A B C f g) ≅
    tensorPair p ((tiltFunctor p).obj A) ((tiltFunctor p).obj B) ((tiltFunctor p).obj C)
      ((tiltFunctor p).map f) ((tiltFunctor p).map g) := sorry

theorem tensorTiltIso_inclusions :
    (tiltFunctor p).map (tensorInl p A B C f g) ≫ (tensorTiltIso p A B C f g).hom =
      tensorInl p ((tiltFunctor p).obj A) ((tiltFunctor p).obj B) ((tiltFunctor p).obj C)
        ((tiltFunctor p).map f) ((tiltFunctor p).map g) ∧
    (tiltFunctor p).map (tensorInr p A B C f g) ≫ (tensorTiltIso p A B C f g).hom =
      tensorInr p ((tiltFunctor p).obj A) ((tiltFunctor p).obj B) ((tiltFunctor p).obj C)
        ((tiltFunctor p).map f) ((tiltFunctor p).map g) := sorry

-- Check: tensor_pair_zero
example [Subsingleton B] : Subsingleton (tensorPair p A B C f g) := sorry
-- Check: tensor_pair_identity
example : IsIso (tensorInl p A B A f (𝟙 A)) := sorry
-- Check: tensor_pair_two_inclusions
example (a : A) :
    (tensorInl p A B C f g).toRingHom (f.toRingHom a) =
      (tensorInr p A B C f g).toRingHom (g.toRingHom a) := sorry
-- Check: tensor_tilt_zero
example [Subsingleton B] (a : (tiltFunctor p).obj (tensorPair p A B C f g)) :
    (tensorTiltIso p A B C f g).hom.toRingHom a = 0 := sorry
-- Check: tensor_tilt_two_constants
example : (tensorTiltIso p A B C f g).hom.toRingHom 0 = 0 ∧
    (tensorTiltIso p A B C f g).hom.toRingHom 1 = 1 := ⟨map_zero _, map_one _⟩
-- Check: tensor_tilt_left_coordinate
example (b : (tiltFunctor p).obj B) :
    (tensorTiltIso p A B C f g).hom.toRingHom
      (((tiltFunctor p).map (tensorInl p A B C f g)).toRingHom b) =
      (tensorInl p ((tiltFunctor p).obj A) ((tiltFunctor p).obj B) ((tiltFunctor p).obj C)
        ((tiltFunctor p).map f) ((tiltFunctor p).map g)).toRingHom b := sorry
end TauCetiRoadmap.PerfectoidSpaces.Perfectoid.PairCat
end

