ategories"},{"source":"DiamondSixOperations:S5","target":"VStackSheavesAndLisseCategories:VS0","sourceTitle":"Examples: the ball, quotients and analytic smooth maps","targetTitle":"Artin v-stacks and eligible operations","sourceRoadmap":"DiamondSixOperations","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"DiamondsAndVStacks:D6","target":"VStackSheavesAndLisseCategories:VS0","sourceTitle":"Analytic adic spaces as diamonds","targetTitle":"Artin v-stacks and eligible operations","sourceRoadmap":"DiamondsAndVStacks","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"EnhancedDerivedSheaves:E5:abstract","target":"VStackSheavesAndLisseCategories:VS0","sourceTitle":"Monoidal stable categorical baseline","targetTitle":"Artin v-stacks and eligible operations","sourceRoadmap":"EnhancedDerivedSheaves","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"DiamondSixOperations:S4","target":"VStackSheavesAndLisseCategories:VS1","sourceTitle":"Cohomological smoothness with the revised descent hypotheses","targetTitle":"ULA, Jacobian criterion and localization","sourceRoadmap":"DiamondSixOperations","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"DiamondSixOperations:S5","target":"VStackSheavesAndLisseCategories:VS1","sourceTitle":"Examples: the ball, quotients and analytic smooth maps","targetTitle":"ULA, Jacobian criterion and localization","sourceRoadmap":"DiamondSixOperations","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"RelativeFarguesFontaine:RF2","target":"VStackSheavesAndLisseCategories:VS1","sourceTitle":"Untilts, divisors and local de Rham rings","targetTitle":"ULA, Jacobian criterion and localization","sourceRoadmap":"RelativeFarguesFontaine","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"RelativeFarguesFontaine:RF3","target":"VStackSheavesAndLisseCategories:VS1","sourceTitle":"Line bundles and the graded algebra","targetTitle":"ULA, Jacobian criterion and localization","sourceRoadmap":"RelativeFarguesFontaine","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"VStackSheavesAndLisseCategories:VS0","target":"VStackSheavesAndLisseCategories:VS1","sourceTitle":"Artin v-stacks and eligible operations","targetTitle":"ULA, Jacobian criterion and localization","sourceRoadmap":"VStackSheavesAndLisseCategories","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"VectorBundlesAndIsocrystals:VB1","target":"VStackSheavesAndLisseCategories:VS1","sourceTitle":"Vector bundles, descent and cohomology","targetTitle":"ULA, Jacobian criterion and localization","sourceRoadmap":"VectorBundlesAndIsocrystals","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"VectorBundlesAndIsocrystals:VB3:general-BC","target":"VStackSheavesAndLisseCategories:VS1","sourceTitle":"General bundles after classification","targetTitle":"ULA, Jacobian criterion and localization","sourceRoadmap":"VectorBundlesAndIsocrystals","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"VectorBundlesAndIsocrystals:VB4","target":"VStackSheavesAndLisseCategories:VS1","sourceTitle":"Families and HN strata","targetTitle":"ULA, Jacobian criterion and localization","sourceRoadmap":"VectorBundlesAndIsocrystals","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"DiamondSixOperations:S0","target":"VStackSheavesAndLisseCategories:VS2","sourceTitle":"Compactifiable morphisms","targetTitle":"Condensed and solid foundations","sourceRoadmap":"DiamondSixOperations","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"DiamondSixOperations:S1","target":"VStackSheavesAndLisseCategories:VS2","sourceTitle":"Quasicompact proper-support pushforward and the dimension estimate","targetTitle":"Condensed and solid foundations","sourceRoadmap":"DiamondSixOperations","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"DiamondSixOperations:S2","target":"VStackSheavesAndLisseCategories:VS2","sourceTitle":"Non-quasicompact maps and small v-stacks","targetTitle":"Condensed and solid foundations","sourceRoadmap":"DiamondSixOperations","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"DiamondSixOperations:S3","target":"VStackSheavesAndLisseCategories:VS2","sourceTitle":"Exceptional inverse image and the formal identities","targetTitle":"Condensed and solid foundations","sourceRoadmap":"DiamondSixOperations","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"DiamondsAndVStacks:D6","target":"VStackSheavesAndLisseCategories:VS2","sourceTitle":"Analytic adic spaces as diamonds","targetTitle":"Condensed and solid foundations","sourceRoadmap":"DiamondsAndVStacks","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"EnhancedDerivedSheaves:E4","target":"VStackSheavesAndLisseCategories:VS2","sourceTitle":"Derived adic completion","targetTitle":"Condensed and solid foundations","sourceRoadmap":"EnhancedDerivedSheaves","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"EnhancedDerivedSheaves:E5:abstract","target":"VStackSheavesAndLisseCategories:VS2","sourceTitle":"Monoidal stable categorical baseline","targetTitle":"Condensed and solid foundations","sourceRoadmap":"EnhancedDerivedSheaves","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"EnhancedDerivedSheaves:E5:presentability","target":"VStackSheavesAndLisseCategories:VS2","sourceTitle":"Ind-completion and extensions","targetTitle":"Condensed and solid foundations","sourceRoadmap":"EnhancedDerivedSheaves","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"AdicCoefficientsAndComparisons:L0","target":"VStackSheavesAndLisseCategories:VS3","sourceTitle":"Adic coefficients","targetTitle":"Lisse categories and coefficients","sourceRoadmap":"AdicCoefficientsAndComparisons","targetRoadmap":"VStackSheavesAndLisseCategories"},{"source":"AdicCoefficientsAndComparisons:L1","target":"VStackSheavesAndLisseCategories:VS3","sourceTitle":"The scheme-to-v-sheaf constructions","targetTitle":"Lisse categories and coefficients","sourceRoadmap":"Adi