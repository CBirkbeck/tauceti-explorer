def noetherianShriek (f : Y ⟶ X) [IsNoetherian X] [IsNoetherian Y] [IsSeparated f]
    [LocallyOfFiniteType f] : SchemeEtale Y Λ ⥤ SchemeEtale X Λ := sorry

end SchemeEtale

end Interfaces

/-! ## Core constructions of this roadmap

The central definitions of Layers L0 and L1, on which the API, tests and theorems below are
stated. Constructions are `sorry`; the definitions of the full subcategories are actual
definitions. -/

section Core

variable {p : ℕ}

/-! ### L0: the adic étale category -/

/-- The object property of `L0/derived-I-complete-etale-category`: derived `I`-complete objects
of `D(Y_v, Λ)` whose derived reduction modulo `I` is étale. -/
def adicProperty (Y : SmallVStack.{u} p) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) :
    ObjectProperty (VDerived Y Λ) :=
  fun A => IsDerivedComplete I A ∧ IsEtale ((VDerived.reduce Y I).obj A)

/-- `L0/derived-I-complete-etale-category`: the adic étale category `D_ét(Y, Λ)` of ECD
Definition 26.1, as the full subcategory of `D(Y_v, Λ)` on `adicProperty`. -/
abbrev AdicEtale (Y : SmallVStack.{u} p) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) :
    Type (u + 1) :=
  (adicProperty Y I).FullSubcategory

namespace AdicEtale

variable {Y : SmallVStack.{u} p} {Λ : Type u} [CommRing Λ] {I : Ideal Λ}

/-- `AdicEtale.forget`: the fully faithful inclusion into `D(Y_v, Λ)`. -/
abbrev forget (Y : SmallVStack.{u} p) (I : Ideal Λ) : AdicEtale Y I ⥤ VDerived Y Λ :=
  (adicProperty Y I).ι

/-- `AdicEtale.tensor`: the completed derived tensor product `A ⊗̂ B = Comp_I (A ⊗ᴸ_Λ B)`, with
unit the completed constant object `Comp_I Λ`. -/
instance tensor : MonoidalCategory (AdicEtale Y I) := sorry

instance : SymmetricCategory (AdicEtale Y I) := sorry

/-- The internal `RHom`, right adjoint of the completed tensor product. -/
instance monoidalClosed : MonoidalClosed (AdicEtale Y I) := sorry

instance : Preadditive (AdicEtale Y I) := sorry
instance : HasZeroObject (AdicEtale Y I) := sorry
instance : HasFiniteBiproducts (AdicEtale Y I) := sorry
instance : HasShift (AdicEtale Y I) ℤ := sorry

/-- The completed constant object `Λ̂ = Comp_I Λ = Rlimₙ Λ/Iⁿ`, the tensor unit. -/
abbrev completedUnit (Y : SmallVStack.{u} p) (I : Ideal Λ) : AdicEtale Y I := 𝟙_ (AdicEtale Y I)

end AdicEtale

/-! ### L0: the six operations on adic coefficients -/

namespace AdicSix

variable {Y Y' : SmallVStack.{u} p} {Λ : Type u} [CommRing Λ] {I : Ideal Λ}

/-- `AdicSix.pullback`: `f*`, by restriction, for every map of small v-stacks. -/
def pullback (f : Y' ⟶ Y) : AdicEtale Y I ⥤ AdicEtale Y' I := sorry

/-- `Rf_*`, the right adjoint of `f*`. -/
def pushforward (f : Y' ⟶ Y) : AdicEtale Y' I ⥤ AdicEtale Y I := sorry

/-- `Rf_!` of a support-eligible map, built levelwise on the tower `(Λ/Iⁿ)ₙ`. -/
def support (f : Y' ⟶ Y) (hf : SupportData f) : AdicEtale Y' I ⥤ AdicEtale Y I := sorry

/-- `Rf^!`, the right adjoint of `Rf_!`. -/
def upperShriek (f : Y' ⟶ Y) (hf : SupportData f) : AdicEtale Y I ⥤ AdicEtale Y' I := sorry

end AdicSix

/-! ### L1: schemes as v-sheaves -/

/-- Schemes of characteristic `p`: `p = 0` in the global sections. Morphisms are all scheme
morphisms. -/
def IsCharPScheme (p : ℕ) : ObjectProperty Scheme.{u} := fun X => ((p : ℕ) : Γ(X, ⊤)) = 0

/-- The category of schemes of characteristic `p`. -/
abbrev CharPScheme (p : ℕ) : Type (u + 1) := (IsCharPScheme.{u} p).FullSubcategory

/-- `Spec R` for a ring of characteristic `p`. -/
def CharPScheme.spec (p : ℕ) (R : Type u) [CommRing R] [CharP R p] : CharPScheme.{u} p :=
  ⟨Spec (CommRingCat.of R), sorry⟩

/-- `SchemeDiamond.charP` (`L1/char-p-scheme-diamond-and-comparison-functor`): the small
v-sheaf `X◇` of a characteristic-`p` scheme, `S ↦ Hom(S, Xᵃᵈ)`, where `Spec R` has the adic
avatar `Spa(R, R⁺)` with `R` discrete and `R⁺` the integral closure of `𝔽_p`. -/
def SchemeDiamond.charP (p : ℕ) [Fact p.Prime] : CharPScheme.{u} p ⥤ SmallVSheaf.{u} p := sorry

/-- `X◇` as a small v-stack. -/
abbrev SchemeDiamond.charPStack (p : ℕ) [Fact p.Prime] (X : CharPScheme.{u} p) :
    SmallVStack.{u} p :=
  (SmallVSheaf.toStack p).obj ((SchemeDiamond.charP p).obj X)

/-- `O`-schemes locally of finite type. -/
def IsLFTOver (O : Type u) [CommRing O] : ObjectProperty (Over (Spec (CommRingCat.of O))) :=
  fun X => LocallyOfFiniteType X.hom

/-- Schemes locally of finite type over `Spec O`. -/
abbrev LFTScheme (O : Type u) [CommRing O] : Type (u + 1) := (IsLFTOver O).FullSubcategory

/-- `SchemeDiamond.overDVR` (`L1/mixed-characteristic-scheme-diamond`): for `X` locally of finite
type over a complete discrete valuation ring `O`, `X◇(S)` is the set of untilts `S♯` over
`Spa(O, O)` with a map `S♯ → X` of locally ringed spaces over `Spec O`. The values are small
v-sheaves over `Spd(O, O)`; they need not be diamonds. -/
def SchemeDiamond.overDVR (p : ℕ) [Fact p.Prime] (O : Type u) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O] :
    LFTScheme O ⥤ Over (spd p O ⊤) := sorry

/-- `X◇` of an `O`-scheme as a small v-stack. -/
abbrev SchemeDiamond.overDVRStack (p : ℕ) [Fact p.Prime] (O : Type u) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O]
    (X : LFTScheme O) : SmallVStack.{u} p :=
  (SmallVSheaf.toStack p).obj ((SchemeDiamond.overDVR p O).obj X).left

/-! ### L1: the scheme adic category and the comparison functors -/

/-- The object property of `L1/scheme-adic-category`: derived `I`-complete objects of
`D(X_proét, Λ)` whose reduction modulo `I` lies in the left-completed étale image. -/
def schemeAdicProperty (X : Scheme.{u}) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) :
    ObjectProperty (ProEtDerived X Λ) :=
  fun A => IsIso ((ProEtDerived.completionUnit X I).app A) ∧
    (SchemeEtale.toProEt X (Λ ⧸ I)).essImage ((ProEtDerived.reduce X I).obj A)

/-- `L1/scheme-adic-category`: the adic étale category `D_ét(X, Λ)` of a scheme. -/
abbrev SchemeAdic (X : Scheme.{u}) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) : Type (u + 1) :=
  (schemeAdicProperty X I).FullSubcategory

instance (X : Scheme.{u}) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) :
    MonoidalCategory (SchemeAdic X I) := sorry

namespace SchemeComparison

variable (p : ℕ) [Fact p.Prime]

/-- `SchemeComparison.pullback` (`L1/comparison-pullback`), discrete coefficients: `c_X^*` for
`c_X : X◇_v → X_ét`, on the left-completed étale category. -/
def pullback (X : CharPScheme.{u} p) (Λ : Type u) [CommRing Λ] :
    SchemeEtale X.obj Λ ⥤ DEtale (SchemeDiamond.charPStack p X) Λ := sorry

/-- `Rc_{X*}`, the right adjoint of `c_X^*`. -/
def pushforward (X : CharPScheme.{u} p) (Λ : Type u) [CommRing Λ] :
    DEtale (SchemeDiamond.charPStack p X) Λ ⥤ SchemeEtale X.obj Λ := sorry

/-- `c_X^* ⊣ Rc_{X*}`. -/
def adj (X : CharPScheme.{u} p) (Λ : Type u) [CommRing Λ] :
    pullback p X Λ ⊣ pushforward p X Λ := sorry

/-- Adic coefficients: the completed pullback `c_X^*` for `c_X : X◇_v → X_proét`, from the scheme
adic category. -/
def pullbackAdic (X : CharPScheme.{u} p) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) :
    SchemeAdic X.obj I ⥤ AdicEtale (SchemeDiamond.charPStack p X) I := sorry

/-- `Rc_{X*}` on adic coefficients. -/
def pushforwardAdic (X : CharPScheme.{u} p) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) :
    AdicEtale (SchemeDiamond.charPStack p X) I ⥤ SchemeAdic X.obj I := sorry

/-- `c_X^* ⊣ Rc_{X*}` on adic coefficients. -/
def adjAdic (X : CharPScheme.{u} p) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) :
    pullbackAdic p X I ⊣ pushforwardAdic p X I := sorry

variable (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] [TopologicalSpace O]
  [IsCompleteDVRBase p O]

/-- The comparison `c_X^*` for a scheme locally of finite type over `O`, discrete coefficients. -/
def pullbackDVR (X : LFTScheme O) (Λ : Type u) [CommRing Λ] :
    SchemeEtale X.obj.left Λ ⥤ DEtale (SchemeDiamond.overDVRStack p O X) Λ := sorry

/-- `Rc_{X*}` over `O`. -/
def pushforwardDVR (X : LFTScheme O) (Λ : Type u) [CommRing Λ] :
    DEtale (SchemeDiamond.overDVRStack p O X) Λ ⥤ SchemeEtale X.obj.left Λ := sorry

/-- `c_X^* ⊣ Rc_{X*}` over `O`. -/
def adjDVR (X : LFTScheme O) (Λ : Type u) [CommRing Λ] :
    pullbackDVR p O X Λ ⊣ pushforwardDVR p O X Λ := sorry

/-- The comparison over `O` with adic coefficients. -/
def pullbackAdicDVR (X : LFTScheme O) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) :
    SchemeAdic X.obj.left I ⥤ AdicEtale (SchemeDiamond.overDVRStack p O X) I := sorry

end SchemeComparison

/-! ### L2: proper-support direct image over qcqs bases -/

namespace SchemeSupport

/-- `SchemeSupport.extend` (`L2/scheme-support-extension`): the proper-support direct image
`Rf_! = Rp_* j_!` of a separated finite-type map of qcqs schemes, for any compactification
`f = p ∘ j`, extending the classical noetherian carrier. The coefficient ring is killed by an
integer invertible on the schemes (that hypothesis is carried by the theorems). -/
def extend {X Y : Scheme.{u}} (f : Y ⟶ X) [CompactSpace X] [QuasiSeparatedSpace X]
    [IsSeparated f] [LocallyOfFiniteType f] [QuasiCompact f] (Λ : Type u) [CommRing Λ] :
    SchemeEtale Y Λ ⥤ SchemeEtale X Λ := sorry

/-- The adic form of `extend` on the scheme adic categories
(`L2/coefficient-and-unbounded-extension`). -/
def extendAdic {X Y : Scheme.{u}} (f : Y ⟶ X) [CompactSpace X] [QuasiSeparatedSpace X]
    [IsSeparated f] [LocallyOfFiniteType f] [QuasiCompact f] {Λ : Type u} [CommRing Λ]
    (I : Ideal Λ) : SchemeAdic Y I ⥤ SchemeAdic X I := sorry

end SchemeSupport

end Core

/-! ## Layer L0: adic coefficients (ECD §26)

The adic étale category `AdicEtale Y I` and the six operations `AdicSix.*` are declared in the
core section; here are their API, the coefficient reconstruction, the completed tensor product
and colimits, the reduction principle, the adic forms of the theorems of the introduction of
ECD, and rational lattice coefficients. -/

section L0

variable {p : ℕ}

-- Binary biproducts `A ⊞ B` from the finite biproducts of the stand-in categories.
attribute [local instance] hasBinaryBiproducts_of_finite_biproducts

/-! #### Interfaces used here -/

/-- The homotopy category of the enhanced limit `limₙ D_ét(Y, Λ/Iⁿ)` of the discrete étale
categories, with transition functors the derived base changes along `Λ/Iⁿ⁺¹ → Λ/Iⁿ`: compatible
towers with all their higher coherences, not the inverse limit of the homotopy categories.
Owner: `EnhancedDerivedSheaves:E4/compatible-coefficient-systems`. -/
def AdicTower (Y : SmallVStack.{u} p) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) : Type (u + 1) :=
  sorry

instance (Y : SmallVStack.{u} p) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) :
    Category.{u} (AdicTower Y I) := sorry

/-- Evaluation of a compatible tower at the level `n`.
Owner: `EnhancedDerivedSheaves:E4/compatible-coefficient-systems`. -/
def AdicTower.eval (Y : SmallVStack.{u} p) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) (n : ℕ) :
    AdicTower Y I ⥤ DEtale Y (Λ ⧸ I ^ n) := sorry

/-- The colimit, in the presentable stable enhancement of `D(Y_v, Λ)`, of a sequence of objects
and maps (such a sequence lifts to the enhancement), as a cocone in the homotopy category, where
it is only a weak colimit. Owner: `EnhancedDerivedSheaves:E1/presentability-and-derived-tensor`;
its completion is `EnhancedDerivedSheaves:E4/completed-colimits`. -/
def VDerived.seqColimit {Y : SmallVStack.{u} p} {Λ : Type u} [CommRing Λ]
    (F : ℕ ⥤ VDerived Y Λ) : Cocone F := sorry

/-- The `n`-th cohomology sheaf of an object of `D_ét(Y, Λ)`, placed in degree zero, for the
standard t-structure. Owner: `DiamondEtaleCohomology:C2`. -/
def DEtale.cohomologySheaf {Y : SmallVStack.{u} p} {Λ : Type u} [CommRing Λ] (n : ℤ) :
    DEtale Y Λ ⥤ DEtale Y Λ := sorry

/-- An object of `D_ét(Y, Λ)` is bounded below if its cohomology sheaves vanish in all
sufficiently negative degrees. -/
def DEtale.IsBoundedBelow {Y : SmallVStack.{u} p} {Λ : Type u} [CommRing Λ] (A : DEtale Y Λ) :
    Prop :=
  ∃ N : ℤ, ∀ n < N, IsZero ((DEtale.cohomologySheaf n).obj A)

/-- The data witnessing that a map of small v-stacks is proper, representable in spatial diamonds
and of finite `dim.trg`, so that its proper-support direct image is its direct image
(ECD §22). Owner: `DiamondSixOperations:S0`. -/
def ProperData {Y' Y : SmallVStack.{u} p} (f : Y' ⟶ Y) : Type u := sorry

/-- Such proper maps are support-eligible. Owner: `DiamondSixOperations:S0`. -/
def ProperData.supportData {Y' Y : SmallVStack.{u} p} {f : Y' ⟶ Y} (h : ProperData f) :
    SupportData f := sorry

/-- The data witnessing that a map of small v-stacks is quasicompact and quasiseparated (the
maps of ECD Proposition 17.6). Owner: `DiamondsAndVStacks:D4`. -/
def QcqsData {Y' Y : SmallVStack.{u} p} (f : Y' ⟶ Y) : Type u := sorry

/-- The map `Spd C' → Spd C` induced by an isometric embedding `C → C'` of complete algebraically
closed nonarchimedean fields of characteristic `p`: the change of algebraically closed base field
of ECD Theorem 19.5. Owner: `DiamondEtaleCohomology:C6`. -/
def geomPointChange {C C' : Type u} [NontriviallyNormedField C] [IsUltrametricDist C]
    [CompleteSpace C] [IsAlgClosed C] [CharP C p] [NontriviallyNormedField C']
    [IsUltrametricDist C'] [CompleteSpace C'] [IsAlgClosed C'] [CharP C' p]
    (φ : C →+* C') (hφ : Isometry φ) : geomPoint p C' ⟶ geomPoint p C := sorry

/-- The homotopy category of the bounded constructible `ℓ`-adic category `D_cons(X, ℤ_ℓ)` of
Bhatt–Scholze §6.5 (derived `ℓ`-complete objects of `D(X_proét, ℤ_ℓ)` whose reduction modulo `ℓ`
is constructible): the integral lattices. Owner: `SchemeAndStackFoundations:SF.2` with
`EnhancedDerivedSheaves:E1/enhanced-derived-category`. -/
def SchemeConstructibleAdic (X : Scheme.{u}) (ℓ : ℕ) [Fact ℓ.Prime] : Type (u + 1) := sorry

section SchemeConstructibleAdicInstances
variable (X : Scheme.{u}) (ℓ : ℕ) [Fact ℓ.Prime]
instance : Category.{u} (SchemeConstructibleAdic X ℓ) := sorry
instance : Preadditive (SchemeConstructibleAdic X ℓ) := sorry
instance : Linear ℤ_[ℓ] (SchemeConstructibleAdic X ℓ) := sorry
instance : HasZeroObject (SchemeConstructibleAdic X ℓ) := sorry
end SchemeConstructibleAdicInstances

/-- The rank-one lattice: the constant object `ℤ_ℓ` of `D_cons(X, ℤ_ℓ)`.
Owner: `SchemeAndStackFoundations:SF.2`. -/
def SchemeConstructibleAdic.unit (X : Scheme.{u}) (ℓ : ℕ) [Fact ℓ.Prime] :
    SchemeConstructibleAdic X ℓ := sorry

/-- The homotopy category of the constructible `ℚ_ℓ`-category `D_cons(X, ℚ_ℓ)` of Bhatt–Scholze
§6.8. Owner: `SchemeAndStackFoundations:SF.2`. -/
def SchemeConstructibleRational (X : Scheme.{u}) (ℓ : ℕ) [Fact ℓ.Prime] : Type (u + 1) := sorry

instance (X : Scheme.{u}) (ℓ : ℕ) [Fact ℓ.Prime] :
    Category.{u} (SchemeConstructibleRational X ℓ) := sorry

/-- Rationalisation `A ↦ A ⊗ ℚ_ℓ` of an integral lattice.
Owner: `SchemeAndStackFoundations:SF.2`. -/
def SchemeConstructibleAdic.rationalise (X : Scheme.{u}) (ℓ : ℕ) [Fact ℓ.Prime] :
    SchemeConstructibleAdic X ℓ ⥤ SchemeConstructibleRational X ℓ := sorry

/-! #### Notation: `ℓ`-adic coefficients and geometric points -/

namespace EllAdic

/-- The ideal `(ℓ)` of `ℤ_ℓ`. -/
abbrev ideal (ℓ : ℕ) [Fact ℓ.Prime] : Ideal ℤ_[ℓ] := Ideal.span {(ℓ : ℤ_[ℓ])}

/-- The constant object of `D(Y_v, ℤ_ℓ)` on a `ℤ_ℓ`-module `M`, in degree zero. -/
abbrev const (Y : SmallVStack.{0} p) (ℓ : ℕ) [Fact ℓ.Prime] (M : Type) [AddCommGroup M]
    [Module ℤ_[ℓ] M] : VDerived Y ℤ_[ℓ] :=
  (VDerived.const Y ℤ_[ℓ]).obj (ModuleCat.of ℤ_[ℓ] M)

/-- The geometric point `Spd C` as a small v-stack. -/
abbrev point (p : ℕ) (C : Type u) [NontriviallyNormedField C] [IsUltrametricDist C]
    [CompleteSpace C] [IsAlgClosed C] [CharP C p] : SmallVStack.{u} p :=
  (SmallVSheaf.toStack p).obj (geomPoint p C)

end EllAdic

/-! ### L0/derived-I-complete-etale-category: Adic étale derived category

The category is `AdicEtale Y I` (core): the full subcategory of `D(Y_v, Λ)` on `adicProperty`
(ECD Definition 26.1). -/

namespace AdicEtale

variable {Y : SmallVStack.{u} p} {Λ : Type u} [CommRing Λ] {I : Ideal Λ}

/-- `AdicEtale.ofComplete`: the adic object given by a derived `I`-complete object of
`D(Y_v, Λ)` whose derived reduction modulo `I` is étale. -/
def ofComplete (A : VDerived Y Λ) (hA : IsDerivedComplete I A)
    (hE : IsEtale ((VDerived.reduce Y I).obj A)) : AdicEtale Y I :=
  ⟨A, hA, hE⟩

@[simp]
theorem forget_obj_ofComplete (A : VDerived Y Λ) (hA : IsDerivedComplete I A)
    (hE : IsEtale ((VDerived.reduce Y I).obj A)) :
    (forget Y I).obj (ofComplete A hA hE) = A :=
  rfl

-- API AdicEtale.forget: declared in core.
/-- `AdicEtale.forget` is fully faithful. -/
def forgetFullyFaithful (Y : SmallVStack.{u} p) (I : Ideal Λ) : (forget Y I).FullyFaithful :=
  ObjectProperty.fullyFaithfulι _

theorem forget_full_faithful : (forget Y I).Full ∧ (forget Y I).Faithful :=
  ⟨inferInstance, inferInstance⟩

/-- `AdicEtale.mem_iff`: an object of `D(Y_v, Λ)` is (isomorphic to) an adic object exactly when
it is derived `I`-complete and its derived reduction modulo `I` is étale. -/
theorem mem_iff (A : VDerived Y Λ) :
    (forget Y I).essImage A ↔ IsDerivedComplete I A ∧ IsEtale ((VDerived.reduce Y I).obj A) := by
  constructor
  · rintro ⟨B, ⟨e⟩⟩
    obtain ⟨hB, hE⟩ := B.property
    refine ⟨?_, ?_⟩
    · have h := (VDerived.completionUnit Y I).naturality e.hom
      have hA : (VDerived.completionUnit Y I).app A = e.inv ≫
          (VDerived.completionUnit Y I).app ((forget Y I).obj B) ≫
            (VDerived.completion Y I).map e.hom := by
        rw [← h]
        simp
      have : IsIso ((VDerived.completionUnit Y I).app ((forget Y I).obj B)) := hB
      unfold IsDerivedComplete
      rw [hA]
      infer_instance
    · obtain ⟨M, ⟨e'⟩⟩ := hE
      exact ⟨M, ⟨e' ≪≫ (VDerived.reduce Y I).mapIso e⟩⟩
  · rintro ⟨hA, hE⟩
    exact ⟨⟨A, hA, hE⟩, ⟨Iso.refl _⟩⟩

/-- `AdicEtale.reduce`: for `n ≥ 1` the derived reduction modulo `Iⁿ` of an adic object is étale
(by the finite filtration of `Λ/Iⁿ` with graded pieces free over `Λ/I`). -/
theorem reduce [Fact p.Prime] (hI : IsAdicCoefficientPair p I) (A : AdicEtale Y I) {n : ℕ}
    (hn : 1 ≤ n) : IsEtale ((VDerived.reduce Y (I ^ n)).obj A.obj) :=
  sorry

/-- The reduction functor `A ↦ A ⊗ᴸ_Λ Λ/Iⁿ` from adic coefficients to the discrete étale
category `D_ét(Y, Λ/Iⁿ)`: the derived reduction, which is étale by `AdicEtale.reduce`, regarded
in `D_ét` through its fully faithful inclusion. -/
def reduction (Y : SmallVStack.{u} p) (I : Ideal Λ) (n : ℕ) :
    AdicEtale Y I ⥤ DEtale Y (Λ ⧸ I ^ n) := sorry

/-- The contract of `AdicEtale.reduction`: followed by the inclusion of `D_ét(Y, Λ/Iⁿ)`, it is
the derived reduction of the underlying object. -/
theorem reduction_toV [Fact p.Prime] (hI : IsAdicCoefficientPair p I) {n : ℕ} (hn : 1 ≤ n) :
    Nonempty (reduction Y I n ⋙ DEtale.toV Y (Λ ⧸ I ^ n) ≅
      forget Y I ⋙ VDerived.reduce Y (I ^ n)) :=
  sorry

/-- `AdicEtale.ext`: morphisms of adic objects are equal iff they are equal in `D(Y_v, Λ)`. -/
theorem ext {A B : AdicEtale Y I} {f g : A ⟶ B} :
    f = g ↔ (forget Y I).map f = (forget Y I).map g :=
  ⟨fun h => h ▸ rfl, fun h => (forget Y I).map_injective h⟩

/-- `AdicEtale.discrete_zeroIdeal`: for `I = 0` and `Λ` killed by an integer prime to `p`, the
adic objects are exactly the objects of `D_ét(Y, Λ)` inside `D(Y_v, Λ)`. -/
theorem discrete_zeroIdeal [Fact p.Prime] (hΛ : IsPrimeToPTorsion p Λ) (A : VDerived Y Λ) :
    adicProperty Y (⊥ : Ideal Λ) A ↔ IsEtale A :=
  sorry

/-- The same identification as an equivalence of categories commuting with the inclusions into
`D(Y_v, Λ)`. -/
theorem discrete_zeroIdeal_equiv [Fact p.Prime] (hΛ : IsPrimeToPTorsion p Λ) :
    ∃ e : AdicEtale Y (⊥ : Ideal Λ) ≌ DEtale Y Λ,
      Nonempty (e.functor ⋙ DEtale.toV Y Λ ≅ forget Y (⊥ : Ideal Λ)) :=
  sorry

end AdicEtale

section DefinitionTests

variable (ℓ : ℕ) [Fact ℓ.Prime] (C : Type) [NontriviallyNormedField C] [IsUltrametricDist C]
  [CompleteSpace C] [IsAlgClosed C] [CharP C p]

