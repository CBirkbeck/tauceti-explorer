/-! ### L0/six-operations-for-adic-coefficients: Six adic operations

`AdicSix.pullback`, `AdicSix.pushforward`, `AdicSix.support` and `AdicSix.upperShriek` are
declared in core; the completed tensor product and internal `RHom` are those of
`L0/completed-tensor-and-colimits`. -/

namespace AdicSix

variable {Y Y' Y'' : SmallVStack.{u} p} {Λ : Type u} [CommRing Λ] {I : Ideal Λ}

-- API AdicSix.pullback: declared in core.
/-- The contract of `AdicSix.pullback`: `f*` is restriction of the underlying object of
`D(Y_v, Λ)`. -/
theorem pullback_forget (f : Y' ⟶ Y) :
    Nonempty (AdicSix.pullback (I := I) f ⋙ AdicEtale.forget Y' I ≅
      AdicEtale.forget Y I ⋙ VDerived.pullback f) :=
  sorry

/-- Functoriality of `f*` for identities: `(𝟙 Y)* ≅ 𝟭`. -/
def pullbackId (Y : SmallVStack.{u} p) (I : Ideal Λ) :
    AdicSix.pullback (I := I) (𝟙 Y) ≅ 𝟭 (AdicEtale Y I) := sorry

/-- Functoriality of `f*` for composition: `(f ≫ g)* ≅ g* ⋙ f*`. -/
def pullbackComp (f : Y'' ⟶ Y') (g : Y' ⟶ Y) :
    AdicSix.pullback (I := I) (f ≫ g) ≅ AdicSix.pullback g ⋙ AdicSix.pullback f := sorry

/-- `AdicSix.pushAdjunction`: `f* ⊣ Rf_*`. -/
def pushAdjunction (f : Y' ⟶ Y) : AdicSix.pullback (I := I) f ⊣ AdicSix.pushforward f := sorry

-- API AdicSix.support: declared in core.
/-- For an open immersion `j`, `Rj_!` is extension by zero: it is left adjoint to `j*`, and
`j* Rj_! ≅ 𝟭`. -/
theorem support_openImmersion [Fact p.Prime] (hI : IsAdicCoefficientPair p I)
    {U : SmallVStack.{u} p} (j : U ⟶ Y) (hj : OpenImmersionData j) :
    Nonempty (AdicSix.support (I := I) j hj.supportData ⊣ AdicSix.pullback j) ∧
      Nonempty (AdicSix.support (I := I) j hj.supportData ⋙ AdicSix.pullback j ≅ 𝟭 _) :=
  sorry

/-- For a proper map representable in spatial diamonds of finite `dim.trg`, `Rf_! ≅ Rf_*`. -/
theorem support_proper [Fact p.Prime] (hI : IsAdicCoefficientPair p I) (f : Y' ⟶ Y)
    (hf : ProperData f) :
    Nonempty (AdicSix.support (I := I) f hf.supportData ≅ AdicSix.pushforward f) :=
  sorry

/-- `AdicSix.shriekAdjunction`: `Rf_! ⊣ Rf^!`. -/
def shriekAdjunction (f : Y' ⟶ Y) (hf : SupportData f) :
    AdicSix.support (I := I) f hf ⊣ AdicSix.upperShriek f hf := sorry

/-- `AdicSix.reduce` (ECD Remark 26.3): the operations commute with reduction modulo `Iⁿ`. There
are isomorphisms `f* ∘ red ≅ red ∘ f*` and `Rf_! ∘ red ≅ red ∘ Rf_!` with the discrete
operations whose mates, the canonical comparisons `red ∘ Rf_* → Rf_* ∘ red` and
`red ∘ Rf^! → Rf^! ∘ red`, are isomorphisms. (For `⊗̂` and `RHom` see `AdicEtale.tensor_reduce`
and `AdicEtale.internalHom_reduce`.) -/
theorem reduce [Fact p.Prime] (hI : IsAdicCoefficientPair p I) {n : ℕ} (hn : 1 ≤ n)
    (f : Y' ⟶ Y) :
    (∃ α : AdicEtale.reduction Y I n ⋙ DEtale.pullback f ≅
        AdicSix.pullback f ⋙ AdicEtale.reduction Y' I n,
      IsIso (mateEquiv (pushAdjunction f) (DEtale.pullbackAdj f)
        (TwoSquare.mk _ _ _ _ α.hom)).natTrans) ∧
    ∀ hf : SupportData f,
      ∃ β : AdicEtale.reduction Y' I n ⋙ DEtale.shriek f hf ≅
          AdicSix.support f hf ⋙ AdicEtale.reduction Y I n,
        IsIso (mateEquiv (shriekAdjunction f hf) (DEtale.shriekAdj f hf)
          (TwoSquare.mk _ _ _ _ β.hom)).natTrans :=
  sorry

/-- `AdicSix.baseChange`: base change `g* Rf_! ≅ Rf'_! g'*` for a cartesian square of small
v-stacks with `f` (hence `f'`) support-eligible, obtained levelwise from the discrete statement
(ECD 22.19). The other base-change and projection formulas are in
`L0/adic-forms-of-introduction-theorems`. -/
theorem baseChange [Fact p.Prime] (hI : IsAdicCoefficientPair p I) {X X' : SmallVStack.{u} p}
    {f : Y' ⟶ Y} {g : X ⟶ Y} {f' : X' ⟶ X} {g' : X' ⟶ Y'} (sq : IsPullback g' f' f g)
    (hf : SupportData f) (hf' : SupportData f') :
    Nonempty (AdicSix.support (I := I) f hf ⋙ AdicSix.pullback g ≅
      AdicSix.pullback g' ⋙ AdicSix.support f' hf') :=
  sorry

end AdicSix

/- Test `AdicSix.identity` (degenerate): for the identity map all four functors are the identity
up to isomorphism, and the units and counits of both adjunctions are isomorphisms. -/
example [Fact p.Prime] (Y : SmallVStack.{u} p) {Λ : Type u} [CommRing Λ] (I : Ideal Λ)
    (hI : IsAdicCoefficientPair p I) (h : SupportData (𝟙 Y)) :
    Nonempty (AdicSix.pullback (I := I) (𝟙 Y) ≅ 𝟭 _) ∧
      Nonempty (AdicSix.pushforward (I := I) (𝟙 Y) ≅ 𝟭 _) ∧
      Nonempty (AdicSix.support (I := I) (𝟙 Y) h ≅ 𝟭 _) ∧
      Nonempty (AdicSix.upperShriek (I := I) (𝟙 Y) h ≅ 𝟭 _) ∧
      IsIso (AdicSix.pushAdjunction (I := I) (𝟙 Y)).unit ∧
      IsIso (AdicSix.pushAdjunction (I := I) (𝟙 Y)).counit ∧
      IsIso (AdicSix.shriekAdjunction (I := I) (𝟙 Y) h).unit ∧
      IsIso (AdicSix.shriekAdjunction (I := I) (𝟙 Y) h).counit :=
  sorry

/- Test `AdicSix.empty_open` (degenerate): extension by zero from an empty open sends every adic
object to zero. -/
example [Fact p.Prime] {U Y : SmallVStack.{u} p} {Λ : Type u} [CommRing Λ] (I : Ideal Λ)
    (hI : IsAdicCoefficientPair p I) (j : U ⟶ Y) (hj : OpenImmersionData j) (hU : IsInitial U)
    (A : AdicEtale U I) :
    IsZero ((AdicSix.support j hj.supportData).obj A) :=
  sorry

section SixTests

variable (ℓ : ℕ) [Fact ℓ.Prime] (C : Type) [NontriviallyNormedField C] [IsUltrametricDist C]
  [CompleteSpace C] [IsAlgClosed C] [CharP C p]

/- Test `AdicSix.open_boundary` (non-example): for an open immersion `j : U → Y` and a geometric
point of `Y` not meeting `U`, the stalk of `Rj_! Λ̂` there is zero; for some such configuration
the stalk of `Rj_* Λ̂` is nonzero. -/
example [Fact p.Prime] (hℓ : ℓ ≠ p) :
    (∀ {U Y : SmallVStack.{0} p} (j : U ⟶ Y) (hj : OpenImmersionData j)
        (x : EllAdic.point p C ⟶ Y), IsInitial (Limits.pullback x j) →
      IsZero ((AdicSix.pullback x).obj ((AdicSix.support j hj.supportData).obj
        (AdicEtale.completedUnit U (EllAdic.ideal ℓ))))) ∧
    ∃ (U Y : SmallVStack.{0} p) (j : U ⟶ Y) (_ : OpenImmersionData j)
        (x : EllAdic.point p C ⟶ Y), Nonempty (IsInitial (Limits.pullback x j)) ∧
      ¬ IsZero ((AdicSix.pullback x).obj ((AdicSix.pushforward j).obj
        (AdicEtale.completedUnit U (EllAdic.ideal ℓ)))) :=
  sorry

/- Test `AdicSix.proper` (computation): for the fold map from two copies of a geometric point to
one, `Rf_! Λ̂` and `Rf_* Λ̂` are both `Λ̂ ⊞ Λ̂`. -/
example [Fact p.Prime] (hℓ : ℓ ≠ p)
    (hf : ProperData (coprod.desc (𝟙 (EllAdic.point p C)) (𝟙 (EllAdic.point p C)))) :
    Nonempty ((AdicSix.support _ hf.supportData).obj
        (AdicEtale.completedUnit (EllAdic.point p C ⨿ EllAdic.point p C) (EllAdic.ideal ℓ)) ≅
      AdicEtale.completedUnit (EllAdic.point p C) (EllAdic.ideal ℓ) ⊞
        AdicEtale.completedUnit (EllAdic.point p C) (EllAdic.ideal ℓ)) ∧
    Nonempty ((AdicSix.pushforward (coprod.desc (𝟙 (EllAdic.point p C))
          (𝟙 (EllAdic.point p C)))).obj
        (AdicEtale.completedUnit (EllAdic.point p C ⨿ EllAdic.point p C) (EllAdic.ideal ℓ)) ≅
      AdicEtale.completedUnit (EllAdic.point p C) (EllAdic.ideal ℓ) ⊞
        AdicEtale.completedUnit (EllAdic.point p C) (EllAdic.ideal ℓ)) :=
  sorry

end SixTests

/-! ### L0/reduction-detects-equivalences: Derived reduction detects equivalences -/

section Reduction

variable {Y Y' : SmallVStack.{u} p} {Λ : Type u} [CommRing Λ] {I : Ideal Λ}

/-- `L0/reduction-detects-equivalences` (ECD Remark 26.3): a map between derived `I`-complete
objects of `D(Y_v, Λ)` is an isomorphism iff its derived reduction modulo `I` is (derived
Nakayama on the cone). -/
theorem isIso_iff_isIso_reduce [Fact p.Prime] (hI : IsAdicCoefficientPair p I)
    {A B : VDerived Y Λ} (hA : IsDerivedComplete I A) (hB : IsDerivedComplete I B)
    (φ : A ⟶ B) :
    IsIso φ ↔ IsIso ((VDerived.reduce Y I).map φ) :=
  sorry

/-- `L0/reduction-detects-equivalences` (ECD Remark 26.3), for adic objects: a map is an
isomorphism iff its reduction to `D_ét(Y, Λ/Iⁿ)` is, for any fixed `n ≥ 1`. -/
theorem isIso_iff_isIso_reduction [Fact p.Prime] (hI : IsAdicCoefficientPair p I) {n : ℕ}
    (hn : 1 ≤ n) {A B : AdicEtale Y I} (φ : A ⟶ B) :
    IsIso φ ↔ IsIso ((AdicEtale.reduction Y I n).map φ) :=
  sorry

/-- `L0/reduction-detects-equivalences` (ECD Remark 26.3), for operations: let `F, G` be functors
of adic objects which reduce modulo `Iⁿ` (`n ≥ 1`) to functors `Fₙ, Gₙ` of the discrete étale
categories, and let `τ : F ⟶ G` reduce to `τₙ : Fₙ ⟶ Gₙ`. Then `τ` is an isomorphism iff `τₙ`
is an isomorphism on reductions of adic objects. The six operations, `⊗̂` and `RHom` come with
such reductions by `AdicSix.reduce`, `AdicEtale.tensor_reduce` and
`AdicEtale.internalHom_reduce`. The other half of the target, that exact `Λ`-linear operations
with coherent scalar-change data have such reductions (including right adjoints), is a statement
about the enhancements and is in the README; here the reductions are inputs. -/
theorem natTrans_isIso_iff_reduction [Fact p.Prime] (hI : IsAdicCoefficientPair p I) {n : ℕ}
    (hn : 1 ≤ n) {F G : AdicEtale Y' I ⥤ AdicEtale Y I}
    {Fn Gn : DEtale Y' (Λ ⧸ I ^ n) ⥤ DEtale Y (Λ ⧸ I ^ n)}
    (eF : F ⋙ AdicEtale.reduction Y I n ≅ AdicEtale.reduction Y' I n ⋙ Fn)
    (eG : G ⋙ AdicEtale.reduction Y I n ≅ AdicEtale.reduction Y' I n ⋙ Gn)
    (τ : F ⟶ G) (τn : Fn ⟶ Gn)
    (hτ : Functor.whiskerRight τ (AdicEtale.reduction Y I n) ≫ eG.hom =
      eF.hom ≫ Functor.whiskerLeft (AdicEtale.reduction Y' I n) τn) :
    IsIso τ ↔ IsIso (Functor.whiskerLeft (AdicEtale.reduction Y' I n) τn) :=
  sorry

end Reduction

/-! ### L0/adic-forms-of-introduction-theorems: Adic forms of ECD Theorems 1.8–1.10 and 1.13

Each statement is that a natural transformation between composites of the adic operations is an
isomorphism; the canonical transformations are not named here, only the existence of a natural
isomorphism (or an isomorphism) is stated. The completed tensor product and internal `RHom` are
the closed symmetric monoidal structure of `AdicEtale` (core). -/

section IntroTheorems

variable {X Y : SmallVStack.{u} p} {Λ : Type u} [CommRing Λ] {I : Ideal Λ}

/-- `L0/adic-forms-of-introduction-theorems` (adic ECD Theorem 1.8(i)): `f*` is monoidal for the
completed tensor product, `f*(A ⊗̂ B) ≅ f*A ⊗̂ f*B`, naturally in `A` and `B`. -/
theorem adicPullbackTensor [Fact p.Prime] (hI : IsAdicCoefficientPair p I) (f : Y ⟶ X) :
    Nonempty (MonoidalCategory.tensor (AdicEtale X I) ⋙ AdicSix.pullback f ≅
      (AdicSix.pullback f).prod (AdicSix.pullback f) ⋙ MonoidalCategory.tensor (AdicEtale Y I)) :=
  sorry

/-- `L0/adic-forms-of-introduction-theorems` (adic ECD Theorem 1.8(ii)):
`Rf_* RHom(f*A, B) ≅ RHom(A, Rf_* B)`, naturally in `B`. -/
theorem adicPushforwardInternalHom [Fact p.Prime] (hI : IsAdicCoefficientPair p I) (f : Y ⟶ X)
    (A : AdicEtale X I) :
    Nonempty (ihom ((AdicSix.pullback f).obj A) ⋙ AdicSix.pushforward f ≅
      AdicSix.pushforward f ⋙ ihom A) :=
  sorry

/-- `L0/adic-forms-of-introduction-theorems` (adic ECD Theorem 1.8(iii), projection formula, with
`A` on the source and `B` on the target): `Rf_!(A ⊗̂ f*B) ≅ Rf_!A ⊗̂ B`, naturally in `B`. -/
theorem adicProjectionFormula [Fact p.Prime] (hI : IsAdicCoefficientPair p I) (f : Y ⟶ X)
    (hf : SupportData f) (A : AdicEtale Y I) :
    Nonempty (AdicSix.pullback f ⋙ tensorLeft A ⋙ AdicSix.support f hf ≅
      tensorLeft ((AdicSix.support f hf).obj A)) :=
  sorry

/-- `L0/adic-forms-of-introduction-theorems` (adic ECD Theorem 1.8(iv)):
`RHom(Rf_!A, B) ≅ Rf_* RHom(A, Rf^!B)`, naturally in `B`. -/
theorem adicShriekInternalHom [Fact p.Prime] (hI : IsAdicCoefficientPair p I) (f : Y ⟶ X)
    (hf : SupportData f) (A : AdicEtale Y I) :
    Nonempty (ihom ((AdicSix.support f hf).obj A) ≅
      AdicSix.upperShriek f hf ⋙ ihom A ⋙ AdicSix.pushforward f) :=
  sorry

/-- `L0/adic-forms-of-introduction-theorems` (adic ECD Theorem 1.8(v)):
`Rf^! RHom(A, B) ≅ RHom(f*A, Rf^!B)`, naturally in `B`. -/
theorem adicUpperShriekInternalHom [Fact p.Prime] (hI : IsAdicCoefficientPair p I) (f : Y ⟶ X)
    (hf : SupportData f) (A : AdicEtale X I) :
    Nonempty (ihom A ⋙ AdicSix.upperShriek f hf ≅
      AdicSix.upperShriek f hf ⋙ ihom ((AdicSix.pullback f).obj A)) :=
  sorry

/-- `L0/adic-forms-of-introduction-theorems` (adic ECD Theorem 1.9(i)): for a cartesian square
with `f` quasicompact and quasiseparated, `g* Rf_* A ≅ Rf'_* g'* A` for every adic `A` whose
reduction modulo `I` is bounded below. -/
theorem adicBaseChange [Fact p.Prime] (hI : IsAdicCoefficientPair p I)
    {X' Y' : SmallVStack.{u} p} {f : Y ⟶ X} {g : X' ⟶ X} {f' : Y' ⟶ X'} {g' : Y' ⟶ Y}
    (sq : IsPullback g' f' f g) (hf : QcqsData f) (A : AdicEtale Y I)
    (hA : DEtale.IsBoundedBelow ((AdicEtale.reduction Y I 1).obj A)) :
    Nonempty ((AdicSix.pullback g).obj ((AdicSix.pushforward f).obj A) ≅
      (AdicSix.pushforward f').obj ((AdicSix.pullback g').obj A)) :=
  sorry

/-- `L0/adic-forms-of-introduction-theorems` (adic ECD Theorem 1.9(ii)): for a cartesian square
with `f` support-eligible, `g* Rf_! ≅ Rf'_! g'*`. -/
theorem adicBaseChange_support [Fact p.Prime] (hI : IsAdicCoefficientPair p I)
    {X' Y' : SmallVStack.{u} p} {f : Y ⟶ X} {g : X' ⟶ X} {f' : Y' ⟶ X'} {g' : Y' ⟶ Y}
    (sq : IsPullback g' f' f g) (hf : SupportData f) (hf' : SupportData f') :
    Nonempty (AdicSix.support (I := I) f hf ⋙ AdicSix.pullback g ≅
      AdicSix.pullback g' ⋙ AdicSix.support f' hf') :=
  AdicSix.baseChange hI sq hf hf'

/-- `L0/adic-forms-of-introduction-theorems` (adic ECD Theorem 1.9(iii)): for a cartesian square
with `g` support-eligible, `Rg^! Rf_* ≅ Rf'_* Rg'^!`. -/
theorem adicBaseChange_upperShriek [Fact p.Prime] (hI : IsAdicCoefficientPair p I)
    {X' Y' : SmallVStack.{u} p} {f : Y ⟶ X} {g : X' ⟶ X} {f' : Y' ⟶ X'} {g' : Y' ⟶ Y}
    (sq : IsPullback g' f' f g) (hg : SupportData g) (hg' : SupportData g') :
    Nonempty (AdicSix.pushforward (I := I) f ⋙ AdicSix.upperShriek g hg ≅
      AdicSix.upperShriek g' hg' ⋙ AdicSix.pushforward f') :=
  sorry

-- The v-local form of the dualizing object (v-locally isomorphic to `Λ̂[n]` with `n` locally
-- constant) needs v-covers and locally constant functions on small v-stacks; it is stated here
-- as invertibility of `Rf^!Λ̂`.
/-- `L0/adic-forms-of-introduction-theorems` (adic ECD Theorem 1.10(i),(ii)): if `Λ/I` is killed
by a power of a prime `ℓ ≠ p` and `f` is `ℓ`-cohomologically smooth, then
`Rf^!A ≅ f*A ⊗̂ Rf^!Λ̂` naturally in `A`, the dualizing object `Rf^!Λ̂` is invertible, and
`f* RHom(A, B) ≅ RHom(f*A, f*B)` naturally in `B`. -/
theorem adicSmoothUpperShriek [Fact p.Prime] (hI : IsAdicCoefficientPair p I) (ℓ : ℕ)
    [Fact ℓ.Prime] (hℓ : ℓ ≠ p) (hΛ : ∃ k : ℕ, (ℓ : Λ) ^ k ∈ I) (f : Y ⟶ X)
    (hs : CohSmoothData ℓ f) (hf : SupportData f) :
    Nonempty (AdicSix.upperShriek f hf ≅
        AdicSix.pullback f ⋙
          tensorRight ((AdicSix.upperShriek f hf).obj (AdicEtale.completedUnit X I))) ∧
      (∃ L : AdicEtale Y I,
        Nonempty ((AdicSix.upperShriek f hf).obj (AdicEtale.completedUnit X I) ⊗ L ≅
          AdicEtale.completedUnit Y I)) ∧
      ∀ A : AdicEtale X I,
        Nonempty (ihom A ⋙ AdicSix.pullback f ≅
          AdicSix.pullback f ⋙ ihom ((AdicSix.pullback f).obj A)) :=
  sorry

/-- `L0/adic-forms-of-introduction-theorems` (adic ECD Theorem 1.10(iii)): for a cartesian
square with `f` `ℓ`-cohomologically smooth (`Λ/I` killed by a power of `ℓ ≠ p`), smooth base change
`f* Rg_* ≅ Rg'_* f'*` and `g'* Rf^! ≅ Rf'^! g*`. -/
theorem adicSmoothBaseChange [Fact p.Prime] (hI : IsAdicCoefficientPair p I) (ℓ : ℕ)
    [Fact ℓ.Prime] (hℓ : ℓ ≠ p) (hΛ : ∃ k : ℕ, (ℓ : Λ) ^ k ∈ I) {X' Y' : SmallVStack.{u} p}
    {f : Y ⟶ X} {g : X' ⟶ X} {f' : Y' ⟶ X'} {g' : Y' ⟶ Y} (sq : IsPullback g' f' f g)
    (hs : CohSmoothData ℓ f) (hf : SupportData f) (hf' : SupportData f') :
    Nonempty (AdicSix.pushforward (I := I) g ⋙ AdicSix.pullback f ≅
        AdicSix.pullback f' ⋙ AdicSix.pushforward g') ∧
      Nonempty (AdicSix.upperShriek (I := I) f hf ⋙ AdicSix.pullback g' ≅
        AdicSix.pullback g ⋙ AdicSix.upperShriek f' hf') :=
  sorry

/-- `L0/adic-forms-of-introduction-theorems` (adic ECD Theorem 1.13, from ECD Theorem 19.5): for an
extension `C'/C` of complete algebraically closed nonarchimedean fields of characteristic `p` and
a small v-stack `Y` over `Spd C`, pullback along `Y ×_{Spd C} Spd C' → Y` is fully faithful on
adic coefficients. -/
theorem adicFieldChange_fullyFaithful [Fact p.Prime] (hI : IsAdicCoefficientPair p I)
    {C C' : Type u} [NontriviallyNormedField C] [IsUltrametricDist C] [CompleteSpace C]
    [IsAlgClosed C] [CharP C p] [NontriviallyNormedField C'] [IsUltrametricDist C']
    [CompleteSpace C'] [IsAlgClosed C'] [CharP C' p] (φ : C →+* C') (hφ : Isometry φ)
    (π : Y ⟶ EllAdic.point p C) :
    (AdicSix.pullback (I := I)
        (Limits.pullback.fst π ((SmallVSheaf.toStack p).map (geomPointChange φ hφ)))).Full ∧
      (AdicSix.pullback (I := I)
        (Limits.pullback.fst π ((SmallVSheaf.toStack p).map (geomPointChange φ hφ)))).Faithful :=
  sorry

end IntroTheorems

/-! ### L0/rational-constructible-coefficients: Rational coefficients from integral lattices

The rational lattice category of an integral `ℤ_ℓ`-linear category of constructible lattices is
its scalar localisation at multiplication by `ℓ`, built with Mathlib's localisation of a
category at a class of morphisms. Its morphisms are the integral morphisms tensored with `ℚ_ℓ`.
It is not obtained by inverting `ℓ` through completed colimits (see the test
`AdicEtale.telescope`), and no comparison with all `ℚ_ℓ`-sheaves on a general small v-stack is
asserted. -/

namespace RationalLattice

variable (C : Type*) [Category C] [Preadditive C] (ℓ : ℕ) [Fact ℓ.Prime] [Linear ℤ_[ℓ] C]

/-- Multiplication by `ℓ` on the objects of a `ℤ_ℓ`-linear category. -/
def ellMul : MorphismProperty C := MorphismProperty.ofHoms (fun A : C => (ℓ : ℤ_[ℓ]) • 𝟙 A)

end RationalLattice

/-- `L0/rational-constructible-coefficients`: the rational lattice category `C[1/ℓ]` of a
`ℤ_ℓ`-linear category `C` of integral lattices (intended: `D_cons(X, ℤ_ℓ)`), the localisation of
`C` at multiplication by `ℓ`. -/
abbrev RationalLattice (C : Type*) [Category C] [Preadditive C] (ℓ : ℕ) [Fact ℓ.Prime]
    [Linear ℤ_[ℓ] C] :=
  (RationalLattice.ellMul C ℓ).Localization

namespace RationalLattice

variable (C : Type*) [Category C] [Preadditive C] (ℓ : ℕ) [Fact ℓ.Prime] [Linear ℤ_[ℓ] C]

/-- `RationalLattice.localise`: an integral lattice as a rational lattice. -/
def localise : C ⥤ RationalLattice C ℓ := (ellMul C ℓ).Q

/-- `RationalLattice.invert`: multiplication by `ℓ` becomes invertible. -/
instance invert (A : C) : IsIso ((localise C ℓ).map ((ℓ : ℤ_[ℓ]) • 𝟙 A)) :=
  MorphismProperty.Q_inverts _ _ (MorphismProperty.ofHoms.mk A)

/-- `RationalLattice.hom`: morphisms of rational lattices are integral morphisms tensored with
`ℚ_ℓ`: `f` corresponds to `1 ⊗ f`, and `ℓ⁻¹ · f` to `f` composed with the inverse of
multiplication by `ℓ`. -/
theorem hom (A B : C) :
    ∃ e : ((localise C ℓ).obj A ⟶ (localise C ℓ).obj B) ≃ TensorProduct ℤ_[ℓ] ℚ_[ℓ] (A ⟶ B),
      ∀ f : A ⟶ B, e ((localise C ℓ).map f) = TensorProduct.tmul ℤ_[ℓ] (1 : ℚ_[ℓ]) f ∧
        e (inv ((localise C ℓ).map ((ℓ : ℤ_[ℓ]) • 𝟙 A)) ≫ (localise C ℓ).map f) =
          TensorProduct.tmul ℤ_[ℓ] (ℓ : ℚ_[ℓ])⁻¹ f :=
  sorry

/-- `RationalLattice.universal`: a functor inverting multiplication by `ℓ` factors through the
rational lattice category. -/
def universal {D : Type*} [Category D] (G : C ⥤ D)
    (hG : ∀ A : C, IsIso (G.map ((ℓ : ℤ_[ℓ]) • 𝟙 A))) : RationalLattice C ℓ ⥤ D :=
  Localization.Construction.lift G (fun _ _ _ hf => by cases hf; exact hG _)

theorem universal_fac {D : Type*} [Category D] (G : C ⥤ D)
    (hG : ∀ A : C, IsIso (G.map ((ℓ : ℤ_[ℓ]) • 𝟙 A))) :
    localise C ℓ ⋙ universal C ℓ G hG = G :=
  Localization.Construction.fac G _

theorem universal_uniq {D : Type*} [Category D] (G₁ G₂ : RationalLattice C ℓ ⥤ D)
    (h : localise C ℓ ⋙ G₁ = localise C ℓ ⋙ G₂) : G₁ = G₂ :=
  Localization.Construction.uniq G₁ G₂ h

/-- `RationalLattice.schemeComparison` (Bhatt–Scholze Proposition 6.8.14(2)): for a scheme whose
underlying space is noetherian, rationalisation of integral constructible lattices induces an
equivalence of the rational lattice category with the constructible `ℚ_ℓ`-category. -/
theorem schemeComparison (X : Scheme.{u}) [TopologicalSpace.NoetherianSpace X] (ℓ : ℕ)
    [Fact ℓ.Prime] :
    ∃ F : RationalLattice (SchemeConstructibleAdic X ℓ) ℓ ⥤ SchemeConstructibleRational X ℓ,
      F.IsEquivalence ∧
        Nonempty (localise (SchemeConstructibleAdic X ℓ) ℓ ⋙ F ≅
          SchemeConstructibleAdic.rationalise X ℓ) :=
  sorry

end RationalLattice

/- Test `RationalLattice.point` (computation): over a geometric point `Spec k`, the endomorphisms
of the localised rank-one lattice form the field `ℚ_ℓ` (with multiplication by `ℓ` going to `ℓ`),
not the zero ring. -/
example (ℓ : ℕ) [Fact ℓ.Prime] (k : Type u) [Field k] [IsAlgClosed k] :
    ∃ e : ((RationalLattice.localise (SchemeConstructibleAdic (Spec (CommRingCat.of k)) ℓ) ℓ).obj
          (SchemeConstructibleAdic.unit (Spec (CommRingCat.of k)) ℓ) ⟶
        (RationalLattice.localise (SchemeConstructibleAdic (Spec (CommRingCat.of k)) ℓ) ℓ).obj
          (SchemeConstructibleAdic.unit (Spec (CommRingCat.of k)) ℓ)) ≃ ℚ_[ℓ],
      e (𝟙 _) = 1 ∧ (∀ f g, e (f ≫ g) = e f * e g) ∧
        e ((RationalLattice.localise (SchemeConstructibleAdic (Spec (CommRingCat.of k)) ℓ) ℓ).map
          ((ℓ : ℤ_[ℓ]) • 𝟙 (SchemeConstructibleAdic.unit (Spec (CommRingCat.of k)) ℓ))) = ℓ :=
  sorry

/- Test `RationalLattice.torsion` (characterisation): a lattice killed by a power of `ℓ` becomes
zero in the rational lattice category. -/
example (C : Type*) [Category C] [Preadditive C] (ℓ : ℕ) [Fact ℓ.Prime] [Linear ℤ_[ℓ] C]
    (A : C) (k : ℕ) (hA : ((ℓ : ℤ_[ℓ]) ^ k) • 𝟙 A = 0) :
    IsZero ((RationalLattice.localise C ℓ).obj A) :=
  sorry

/- Test `RationalLattice.zero` (degenerate): the zero lattice stays zero. -/
example (C : Type*) [Category C] [Preadditive C] (ℓ : ℕ) [Fact ℓ.Prime] [Linear ℤ_[ℓ] C]
    (A : C) (hA : IsZero A) :
    IsZero ((RationalLattice.localise C ℓ).obj A) :=
  sorry

/- Test `RationalLattice.isogeny` (characterisation): over a geometric point, multiplication by
`ℓ` on the rank-one lattice is not invertible, but becomes invertible after localisation. -/
example (ℓ : ℕ) [Fact ℓ.Prime] (k : Type u) [Field k] [IsAlgClosed k] :
    ¬ IsIso ((ℓ : ℤ_[ℓ]) • 𝟙 (SchemeConstructibleAdic.unit (Spec (CommRingCat.of k)) ℓ)) ∧
      IsIso ((RationalLattice.localise (SchemeConstructibleAdic (Spec (CommRingCat.of k)) ℓ) ℓ).map
        ((ℓ : ℤ_[ℓ]) • 𝟙 (SchemeConstructibleAdic.unit (Spec (CommRingCat.of k)) ℓ))) :=
  ⟨sorry, inferInstance⟩

end L0

/-! ## Layer L1: schemes as v-sheaves (ECD §27) -/

section L1

/-! #### Interfaces used here -/

/-- The adic avatar `Xᵃᵈ` of a characteristic-`p` scheme: `Spec R` goes to `Spa(R, R⁺)` with `R`
discrete and `R⁺ = charPPlus p R` the integral closure of `𝔽_p`, glued along scheme opens.
Owner: `DiamondsAndVStacks:D6/gluing-and-the-diamond-functor`. -/
def CharPScheme.adicAvatar (p : ℕ) [Fact p.Prime] : CharPScheme.{u} p ⥤ AdicSpace.{u} := sorry

/-- The perfection `X_perf = lim(⋯ → X → X)` of a characteristic-`p` scheme along the absolute
Frobenius (on `Spec R` it is `Spec` of the perfect closure of `R`). Mathlib has no perfection of
schemes. Owner: `SchemeAndStackFoundations:SF.0`. -/
def CharPScheme.perfection (p : ℕ) [Fact p.Prime] : CharPScheme.{u} p ⥤ CharPScheme.{u} p :=
  sorry

/-- The natural projection `X_perf → X`. Owner: `SchemeAndStackFoundations:SF.0`. -/
def CharPScheme.perfectionMap (p : ℕ) [Fact p.Prime] :
    CharPScheme.perfection.{u} p ⟶ 𝟭 (CharPScheme.{u} p) := sorry

/-- The absolute Frobenius of characteristic-`p` schemes (identity on points, `f ↦ fᵖ` on
sections), as an endomorphism of the identity functor. Mathlib has no Frobenius of schemes.
Owner: `SchemeAndStackFoundations:SF.0`. -/
def CharPScheme.frobenius (p : ℕ) [Fact p.Prime] : 𝟭 (CharPScheme.{u} p) ⟶ 𝟭 (CharPScheme.{u} p) :=
  sorry

/-- The map of adic spectra `Spa(B, B⁺) → Spa(A, A⁺)` induced by a continuous ring map
`f : A → B` with `f(A⁺) ⊆ B⁺`. Owner: the Tau Ceti roadmap `AdicSpaces`, Layers 2–5. -/
def adicSpectrumMap {A B : Type u} [CommRing A] [tA : TopologicalSpace A] [CommRing B]
    [tB : TopologicalSpace B] {Aplus : Subring A} {Bplus : Subring B} (f : A →+* B)
    (hf : Continuous f) (hplus : Aplus ≤ Bplus.comap f) :
    adicSpectrum B Bplus ⟶ adicSpectrum A Aplus := sorry

/-- The canonical map of locally ringed spaces `Spa(A, A⁺) → Spec A`, adjoint to the ring map
from `A` to the global sections of the structure sheaf. Owner: the Tau Ceti roadmap `AdicSpaces`,
Layer 3. -/
def adicSpectrumToSpec (A : Type u) [CommRing A] [TopologicalSpace A] (Aplus : Subring A) :
    AdicSpace.toLocallyRingedSpace.obj (adicSpectrum A Aplus) ⟶
      (Spec (CommRingCat.of A)).toLocallyRingedSpace := sorry

/-- The analytification `X ↦ Xᵃⁿ` of schemes locally of finite type over a complete
nonarchimedean field `K` with ring of integral elements `K⁺`, as adic spaces over `Spa(K, K⁺)`.
Owner: `AdicSpacesPartII:R1/analytification-universal-property`. -/
def SchemeAnalytification (K : Type u) [Field K] [TopologicalSpace K] (Kplus : Subring K) :
    LFTScheme K ⥤ AdicSpace.{u} := sorry

/-- The diamond-side datum of a marked untilt: the map `S → Spd(A, A⁺)` that it classifies.
Owner: `PerfectoidSpaces:P1/marked-untilt`. -/
def MarkedUntilt.toSpd {p : ℕ} {A : Type u} [CommRing A] [TopologicalSpace A]
    {Aplus : Subring A} {S : PerfectoidSpace.{u} p} (x : MarkedUntilt p A Aplus S) :
    (PerfectoidSpace.toVSheaf p).obj S ⟶ spd p A Aplus := sorry

/-- The relative analytification `X ↦ X ×_{Spec O} S♯` of `O`-schemes locally of finite type over
an adic space `S♯ → Spa(O, O)` (glued from closed analytic subspaces of relative affine spaces).
Owner: `AdicSpacesPartII:R1/scheme-fibre-product-analytification`. -/
def relativeAnalytification {O : Type u} [CommRing O] [TopologicalSpace O]
    (T : Over (adicSpectrum O ⊤)) : LFTScheme O ⥤ AdicSpace.{u} := sorry

/-- The constant étale sheaf on a `Λ`-module, in degree zero, in `D̂(X_ét, Λ)`.
Owner: `SchemeAndStackFoundations:SF.2`. -/
def SchemeEtale.const (X : Scheme.{u}) (Λ : Type u) [CommRing Λ] :
    ModuleCat.{u} Λ ⥤ SchemeEtale X Λ := sorry

/-- `ν^* : D(X_ét, Λ) → D(X_proét, Λ)` on the ordinary (not left-completed) unbounded étale
derived category. Owner: `SchemeAndStackFoundations:SF.2`. -/
def SchemeEtaleOrdinary.toProEt (X : Scheme.{u}) (Λ : Type u) [CommRing Λ] :
    SchemeEtaleOrdinary X Λ ⥤ ProEtDerived X Λ := sorry

/-- The bounded-below étale derived category `D⁺(X_ét, Λ)`, a full subcategory of
`D(X_ét, Λ)`. Owner: `SchemeAndStackFoundations:SF.2`. -/
def SchemeEtaleBoundedBelow (X : Scheme.{u}) (Λ : Type u) [CommRing Λ] : Type (u + 1) := sorry

instance SchemeEtaleBoundedBelow.instCategory (X : Scheme.{u}) (Λ : Type u) [CommRing Λ] :
    Category.{u} (SchemeEtaleBoundedBelow X Λ) := sorry

/-- The fully faithful inclusion `D⁺(X_ét, Λ) ⊂ D(X_ét, Λ)`.
Owner: `SchemeAndStackFoundations:SF.2`. -/
def SchemeEtaleBoundedBelow.ι (X : Scheme.{u}) (Λ : Type u) [CommRing Λ] :
    SchemeEtaleBoundedBelow X Λ ⥤ SchemeEtaleOrdinary X Λ := sorry

/-! #### Helper constructions on `O`-schemes -/

/-- `Spec A` for a finitely generated `O`-algebra, as an `O`-scheme locally of finite type. -/
def LFTScheme.spec (O : Type u) [CommRing O] (A : Type u) [CommRing A] [Algebra O A]
    [Algebra.FiniteType O A] : LFTScheme O :=
  ⟨Over.mk (Spec.map (CommRingCat.ofHom (algebraMap O A))),
    HasRingHomProperty.Spec_iff.mpr (RingHom.finiteType_algebraMap.mpr inferInstance)⟩

/-- The residue field of a local ring is a finitely generated algebra. -/
instance residueField_finiteType (O : Type u) [CommRing O] [IsLocalRing O] :
    Algebra.FiniteType O (IsLocalRing.ResidueField O) :=
  Algebra.FiniteType.of_surjective (Algebra.ofId O _) (fun x => by
    obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective x
    exact ⟨y, rfl⟩)

/-- Base change `X ↦ X ×_{Spec A} Spec B` along a ring map `A → B`. -/
def LFTScheme.baseChange (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] :
    LFTScheme A ⥤ LFTScheme B :=
  (IsLFTOver B).lift
    ((IsLFTOver A).ι ⋙ Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap A B))))
    (fun X => by
      have : LocallyOfFiniteType X.obj.hom := X.property
      exact (inferInstance : LocallyOfFiniteType (pullback.snd X.obj.hom _)))

/-- A scheme locally of finite type over `𝔽_p` is a characteristic-`p` scheme (stated in the
universe of `ZMod p`). -/
def LFTScheme.toCharPScheme (p : ℕ) : LFTScheme (ZMod p) ⥤ CharPScheme.{0} p :=
  (IsCharPScheme p).lift ((IsLFTOver (ZMod p)).ι ⋙ Over.forget _)
    (fun X => by
      have h : ((p : ℕ) : Γ(Spec (CommRingCat.of (ZMod p)), ⊤)) = 0 := by
        rw [← map_natCast (Scheme.ΓSpecIso (CommRingCat.of (ZMod p))).inv.hom p,
          ZMod.natCast_self, map_zero]
      change ((p : ℕ) : Γ(X.obj.left, ⊤)) = 0
      rw [← map_natCast X.obj.hom.appTop.hom p, h, map_zero])

/-- Small v-sheaves have binary products (from the terminal object and pullbacks). Over
`Perf_{𝔽_p}` the terminal object is `Spd 𝔽_p`, so `A ⨯ B` is the fibre product over `Spd 𝔽_p`. -/
instance SmallVSheaf.hasBinaryProducts (p : ℕ) : HasBinaryProducts (SmallVSheaf.{u} p) :=
  hasBinaryProducts_of_hasTerminal_and_pullbacks _

/-! ### L1/char-p-scheme-diamond-and-comparison-functor: the characteristic-`p` scheme v-sheaf

The functor `X ↦ X◇` is `SchemeDiamond.charP` and its value as a small v-stack is
`SchemeDiamond.charPStack`; the source category is `CharPScheme` with affine objects
`CharPScheme.spec` (all declared in the core section). -/

namespace SchemeDiamond

variable (p : ℕ) [Fact p.Prime]

-- API SchemeDiamond.charP: declared in core.

/-- `SchemeDiamond.charP_points`: for a perfectoid space `S` of characteristic `p`, maps
`S → X◇` of small v-sheaves are the maps `S → Xᵃᵈ` of adic spaces, naturally in `S` and `X`. -/
def charP_points :
    charP p ⋙ yoneda ⋙ (Functor.whiskeringLeft _ _ _).obj (PerfectoidSpace.toVSheaf.{u} p).op ≅
      CharPScheme.adicAvatar p ⋙ yoneda ⋙
        (Functor.whiskeringLeft _ _ _).obj (PerfectoidSpace.toAdicSpace.{u} p).op :=
  sorry

/-- The affine form of `charP_points`: for `X = Spec R`, maps `S → X◇` are the ring maps
`R → 𝒪(S)` into the global sections of the underlying locally ringed space of `S`; the plus ring
condition is automatic since `𝒪⁺(S)` is integrally closed and contains `𝔽_p`. -/
def charP_points_affine (R : Type u) [CommRing R] [CharP R p] (S : PerfectoidSpace.{u} p) :
    ((PerfectoidSpace.toVSheaf p).obj S ⟶ (charP p).obj (CharPScheme.spec p R)) ≃
      (CommRingCat.of R ⟶ LocallyRingedSpace.Γ.obj
        (Opposite.op (AdicSpace.toLocallyRingedSpace.obj ((PerfectoidSpace.toAdicSpace p).obj S)))) :=
  sorry

/-- `SchemeDiamond.charP_open`: an open immersion of characteristic-`p` schemes induces an open
immersion of small v-stacks (the open subfunctor of maps landing in the open). -/
def charP_open {U X : CharPScheme.{u} p} (j : U ⟶ X) [IsOpenImmersion j.hom] :
    OpenImmersionData ((SmallVSheaf.toStack p).map ((charP p).map j)) := sorry

/-- `SchemeDiamond.charP_perfection`: the projection `X_perf → X` induces an isomorphism
`X_perf◇ ≅ X◇`, naturally in `X`. -/
theorem charP_perfection :
    IsIso (Functor.whiskerRight (CharPScheme.perfectionMap.{u} p) (charP p)) := sorry

/-- `SchemeDiamond.charP_functor`: `X ↦ X◇` preserves identities and composition. -/
theorem charP_functor {X Y Z : CharPScheme.{u} p} (f : X ⟶ Y) (g : Y ⟶ Z) :
    (charP p).map (𝟙 X) = 𝟙 _ ∧ (charP p).map (f ≫ g) = (charP p).map f ≫ (charP p).map g :=
  ⟨(charP p).map_id X, (charP p).map_comp f g⟩

/-- Gluing: for a scheme `X = U ∪ V` covered by two opens with intersection `W`, the square of
v-sheaves `W◇, U◇, V◇, X◇` is a pushout. -/
theorem charP_glue {W U V X : CharPScheme.{u} p} (i₁ : W ⟶ U) (i₂ : W ⟶ V) (j₁ : U ⟶ X)
    (j₂ : V ⟶ X) [IsOpenImmersion j₁.hom] [IsOpenImmersion j₂.hom]
    (hW : IsPullback i₁.hom i₂.hom j₁.hom j₂.hom)
    (hcov : Set.range j₁.hom ∪ Set.range j₂.hom = Set.univ) :
    IsPushout ((charP p).map i₁) ((charP p).map i₂) ((charP p).map j₁) ((charP p).map j₂) :=
  sorry

/-- `SchemeDiamond.charP_spa`: the adic avatar of `Spec R` is `Spa(R, R⁺)` with `R` discrete and
`R⁺ = charPPlus p R`, the integral closure of `𝔽_p`. On points this is Tau Ceti's
`TauCeti.ValuationSpectrum.spa`, and for this plus ring it equals `spa` of the prime subring `⊥`,
i.e. all valuations of `R` (all are continuous for the discrete topology): the plus-ring
condition is automatic. -/
theorem charP_spa (R : Type u) [CommRing R] [CharP R p] [Algebra (ZMod p) R] :
    Nonempty ((CharPScheme.adicAvatar p).obj (CharPScheme.spec p R) ≅
        @adicSpectrum R _ ⊥ (charPPlus p R)) ∧
      @TauCeti.ValuationSpectrum.spa R _ ⊥ (charPPlus p R) =
        @TauCeti.ValuationSpectrum.spa R _ ⊥ ⊥ := by
  let _ : TopologicalSpace R := ⊥
  refine ⟨sorry, ?_⟩
  have hle : charPPlus p R ≤ (integralClosure (⊥ : Subring R) R).toSubring := by
    intro x hx
    rw [Subalgebra.mem_toSubring, mem_integralClosure_iff] at hx ⊢
    let φ : ZMod p →+* (⊥ : Subring R) :=
      (algebraMap (ZMod p) R).codRestrict ⊥ (fun a => by
        obtain ⟨n, rfl⟩ := ZMod.intCast_surjective a
        exact Subring.mem_bot.mpr ⟨n, (map_intCast _ n).symm⟩)
    exact hx.map_of_comp_eq φ (RingHom.id R) (by ext a; rfl)
  apply le_antisymm
  · exact TauCeti.ValuationSpectrum.spa_antitone bot_le
  · rw [← TauCeti.ValuationSpectrum.spa_integralClosure]
    exact TauCeti.ValuationSpectrum.spa_antitone hle

/-- `SchemeDiamond.charP_baseChangeField`: for `X` locally of finite type over `𝔽_p` and a perfectoid
field `K` of characteristic `p` (a complete nontrivially valued nonarchimedean perfect field, with
ring of integers the unit ball), `X◇ ×_{Spd 𝔽_p} Spd K ≅ (X_K)ᵃⁿ◇`, naturally in `X`. The fibre
product over `Spd 𝔽_p` is the binary product, `Spd 𝔽_p` being terminal. Stated in the universe
of `ZMod p`. -/
theorem charP_baseChangeField (K : Type) [NontriviallyNormedField K] [IsUltrametricDist K]
    [CompleteSpace K] [CharP K p] [PerfectRing K p] [Algebra (ZMod p) K] :
    Nonempty (LFTScheme.toCharPScheme p ⋙ charP p ⋙
        (prod.functor.flip.obj (spd p K (NormedField.valuation (K := K)).integer)) ≅
      LFTScheme.baseChange (ZMod p) K ⋙
        SchemeAnalytification K (NormedField.valuation (K := K)).integer ⋙ AdicSpace.diamond p) :=
  sorry

/- Test `SchemeDiamond.Fp` (computation): `Spec 𝔽_p` goes to `Spd(𝔽_p, 𝔽_p)`, which is the
terminal small v-sheaf over `Perf_{𝔽_p}`. -/
example : Nonempty ((charP p).obj (CharPScheme.spec p (ZMod p)) ≅ spdDiscrete p (ZMod p) ⊤) ∧
    Nonempty (IsTerminal ((charP p).obj (CharPScheme.spec p (ZMod p)))) := sorry

/- Test `SchemeDiamond.plusRing` (non-example): for a perfect field `k` over `𝔽_p` containing an
element transcendental over `𝔽_p`, the plus ring `k⁺` is a proper subring, `Spa(k, k⁺) ≠ Spa(k, k)`
on points, and the adic avatar of `Spec k` is not `Spa(k, k)`. -/
example (k : Type u) [Field k] [CharP k p] [Algebra (ZMod p) k] [PerfectRing k p] (t : k)
    (ht : Transcendental (ZMod p) t) :
    charPPlus p k ≠ ⊤ ∧
      @TauCeti.ValuationSpectrum.spa k _ ⊥ ⊤ ≠
        @TauCeti.ValuationSpectrum.spa k _ ⊥ (charPPlus p k) ∧
      ¬ Nonempty ((CharPScheme.adicAvatar p).obj (CharPScheme.spec p k) ≅
        @adicSpectrum k _ ⊥ ⊤) := by
  refine ⟨fun h => ht ?_, sorry, sorry⟩
  have hk : t ∈ charPPlus p k := by rw [h]; exact Subring.mem_top t
  rw [Subalgebra.mem_toSubring, mem_integralClosure_iff] at hk
  exact hk.isAlgebraic

/- Test `SchemeDiamond.empty` (degenerate): the empty scheme gives the initial (empty) small
v-sheaf. -/
example (X : CharPScheme.{u} p) [IsEmpty X.obj] : Nonempty (IsInitial ((charP p).obj X)) :=
  sorry

/- Test `SchemeDiamond.frobenius` (characterisation): on `Spec 𝔽_p[t]` the absolute Frobenius is
not an isomorphism of schemes but induces an isomorphism of v-sheaves; the Frobenius stand-in is
this map there, and it induces an isomorphism on `X◇` for every `X`. -/
example :
    let R := Polynomial (ZMod p)
    let F : CharPScheme.spec p R ⟶ CharPScheme.spec p R :=
      ObjectProperty.homMk (Spec.map (CommRingCat.ofHom (frobenius R p)))
    ¬ IsIso F.hom ∧ IsIso ((charP p).map F) ∧ (CharPScheme.frobenius p).app _ = F ∧
      ∀ X : CharPScheme.{0} p, IsIso ((charP p).map ((CharPScheme.frobenius p).app X)) :=
  sorry

end SchemeDiamond

/-! ### L1/scheme-adic-category: the scheme adic étale category

The object property is `schemeAdicProperty` and the category is `SchemeAdic` (core): derived
`I`-complete objects of `D(X_proét, Λ)` whose reduction modulo `I` lies in the essential image of
the left-completed étale category `D̂(X_ét, Λ/I)` under `ν^*` (Bhatt–Scholze Proposition 5.3.2). -/

namespace SchemeAdic

variable {X : Scheme.{u}} {Λ : Type u} [CommRing Λ] {I : Ideal Λ}

/-- `SchemeAdic.ofComplete`: a derived `I`-complete pro-étale complex whose reduction modulo `I`
comes from `D̂(X_ét, Λ/I)` is an object of the scheme adic category. -/
def ofComplete (A : ProEtDerived X Λ) (hA : IsIso ((ProEtDerived.completionUnit X I).app A))
    (hred : (SchemeEtale.toProEt X (Λ ⧸ I)).essImage ((ProEtDerived.reduce X I).obj A)) :
    SchemeAdic X I :=
  ⟨A, hA, hred⟩

/-- `SchemeAdic.forget`: the inclusion into `D(X_proét, Λ)`. -/
abbrev forget (X : Scheme.{u}) (I : Ideal Λ) : SchemeAdic X I ⥤ ProEtDerived X Λ :=
  (schemeAdicProperty X I).ι

/-- The inclusion `SchemeAdic.forget` is fully faithful. -/
theorem forget_fullyFaithful : (forget X I).Full ∧ (forget X I).Faithful :=
  ⟨inferInstance, inferInstance⟩

/-- `SchemeAdic.reduce`: for `n ≥ 1`, reduction modulo `Iⁿ` as a functor to the left-completed
étale category `D̂(X_ét, Λ/Iⁿ)` (the reduction lies in the étale image because `Λ/Iⁿ` has a
finite filtration with free `Λ/I`-module graded pieces, `I` being generated by a regular
sequence). -/
def reduce (X : Scheme.{u}) {p : ℕ} (hI : IsAdicCoefficientPair p I) (n : ℕ) (hn : 1 ≤ n) :
    SchemeAdic X I ⥤ SchemeEtale X (Λ ⧸ I ^ n) := sorry

/-- The reduction functor `SchemeAdic.reduce` followed by `ν^*` is the derived reduction
`A ↦ A ⊗ᴸ_Λ Λ/Iⁿ` on `D(X_proét, Λ)`. -/
theorem reduce_comp_toProEt {p : ℕ} (hI : IsAdicCoefficientPair p I) (n : ℕ) (hn : 1 ≤ n) :
    Nonempty (reduce X hI n hn ⋙ SchemeEtale.toProEt X (Λ ⧸ I ^ n) ≅
      forget X I ⋙ ProEtDerived.reduce X (I ^ n)) := sorry

/-- `SchemeAdic.boundedBelow` (Bhatt–Scholze Proposition 5.2.6): on bounded-below étale complexes
`ν^*` is fully faithful and agrees with the left-completed embedding `D̂(X_ét, Λ) → D(X_proét, Λ)`
precomposed with left completion. -/
theorem boundedBelow (X : Scheme.{u}) (Λ : Type u) [CommRing Λ] :
    (SchemeEtaleBoundedBelow.ι X Λ ⋙ SchemeEtaleOrdinary.toProEt X Λ).Full ∧
      (SchemeEtaleBoundedBelow.ι X Λ ⋙ SchemeEtaleOrdinary.toProEt X Λ).Faithful ∧
      Nonempty (SchemeEtaleBoundedBelow.ι X Λ ⋙ SchemeEtaleOrdinary.toProEt X Λ ≅
        SchemeEtaleBoundedBelow.ι X Λ ⋙ SchemeEtale.leftCompletion X Λ ⋙ SchemeEtale.toProEt X Λ) :=
  sorry

/-- A derived `I`-complete pro-étale complex whose reduction modulo `I` is `ν^*` of a
bounded-below étale complex lies in the scheme adic category. -/
theorem mem_of_boundedBelow (A : ProEtDerived X Λ)
    (hA : IsIso ((ProEtDerived.completionUnit X I).app A))
    (K : SchemeEtaleBoundedBelow X (Λ ⧸ I))
    (e : (ProEtDerived.reduce X I).obj A ≅
      (SchemeEtaleOrdinary.toProEt X (Λ ⧸ I)).obj ((SchemeEtaleBoundedBelow.ι X (Λ ⧸ I)).obj K)) :
    schemeAdicProperty X I A := sorry

/-- `SchemeAdic.leftComplete`: if left completion `D(X_ét, Λ/I) → D̂(X_ét, Λ/I)` is an
equivalence, the reduction condition may be tested with ordinary étale complexes. -/
theorem leftComplete (X : Scheme.{u}) (I : Ideal Λ)
    [(SchemeEtale.leftCompletion X (Λ ⧸ I)).IsEquivalence] (A : ProEtDerived X Λ) :
    schemeAdicProperty X I A ↔ IsIso ((ProEtDerived.completionUnit X I).app A) ∧
      (SchemeEtaleOrdinary.toProEt X (Λ ⧸ I)).essImage ((ProEtDerived.reduce X I).obj A) :=
  sorry

/-- `SchemeAdic.ext`: morphisms of the scheme adic category are equal when their images in
`D(X_proét, Λ)` are. -/
theorem ext {A B : SchemeAdic X I} {f g : A ⟶ B} (h : (forget X I).map f = (forget X I).map g) :
    f = g :=
  (forget X I).map_injective h

/- Test `SchemeAdic.geometricPoint` (computation): for `X = Spec k` with `k` algebraically closed of
characteristic `p`, `Λ = ℤ_ℓ` and `I = (ℓ)` with `ℓ ≠ p`, the derived completion of the constant
sheaf `ℤ_ℓ` lies in the scheme adic category and its reductions modulo `ℓⁿ` are `ν^*` of the étale
constants `ℤ/ℓⁿ`. (This completed lattice is the object that Mathlib's pro-étale sheaf
`AlgebraicGeometry.Scheme.ellAdicSheaf`, `U ↦ C(U, ℤ_ℓ)`, should represent.) -/
example (p ℓ : ℕ) [Fact p.Prime] [Fact ℓ.Prime] (hℓ : ℓ ≠ p) (k : Type) [Field k]
    [IsAlgClosed k] [CharP k p] :
    let X := Spec (CommRingCat.of k)
    let I : Ideal ℤ_[ℓ] := Ideal.span {(ℓ : ℤ_[ℓ])}
    let L := (ProEtDerived.completion X I).obj
      ((ProEtDerived.const X ℤ_[ℓ]).obj (ModuleCat.of ℤ_[ℓ] ℤ_[ℓ]))
    schemeAdicProperty X I L ∧ ∀ n : ℕ, 1 ≤ n →
      Nonempty ((ProEtDerived.reduce X (I ^ n)).obj L ≅
        (SchemeEtale.toProEt X (ℤ_[ℓ] ⧸ I ^ n)).obj
          ((SchemeEtale.const X (ℤ_[ℓ] ⧸ I ^ n)).obj
            (ModuleCat.of (ℤ_[ℓ] ⧸ I ^ n) (ℤ_[ℓ] ⧸ I ^ n)))) :=
  sorry

/- Test `SchemeAdic.zeroIdeal` (compatibility): for `I = 0` and `Λ` killed by an integer prime to
`p`, the scheme adic category is exactly the essential image of `D̂(X_ét, Λ)`; this is not all of
`D(X_proét, Λ)`, already for a geometric point `Spec k` with `Λ = ℤ/ℓ`. -/
example (p : ℕ) [Fact p.Prime] (X : Scheme.{u}) (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) (ℓ : ℕ) [Fact ℓ.Prime] (hℓ : ℓ ≠ p) (k : Type u) [Field k]
    [IsAlgClosed k] [CharP k p] :
    (∀ A : ProEtDerived X Λ,
      schemeAdicProperty X (⊥ : Ideal Λ) A ↔ (SchemeEtale.toProEt X Λ).essImage A) ∧
    ∃ A : ProEtDerived (Spec (CommRingCat.of k)) (ULift.{u} (ZMod ℓ)),
      ¬ schemeAdicProperty _ (⊥ : Ideal (ULift.{u} (ZMod ℓ))) A :=
  sorry

/- Test `SchemeAdic.reject_inverted` (non-example): for `Λ = ℤ_ℓ`, `I = (ℓ)` and a nonempty scheme,
the constant sheaf `ℚ_ℓ` is not in the scheme adic category: its reduction modulo `ℓ` vanishes,
but it is not derived `ℓ`-complete. -/
example (ℓ : ℕ) [Fact ℓ.Prime] (X : Scheme.{0}) [Nonempty X] :
    ¬ schemeAdicProperty X (Ideal.span {(ℓ : ℤ_[ℓ])})
      ((ProEtDerived.const X ℤ_[ℓ]).obj (ModuleCat.of ℤ_[ℓ] ℚ_[ℓ])) :=
  sorry

/- Test `SchemeAdic.empty` (degenerate): over the empty scheme every object of the scheme adic
category is zero. -/
example [IsEmpty X] (A : SchemeAdic X I) : IsZero A := sorry

end SchemeAdic

/-! ### L1/comparison-pullback: the scheme-to-v-sheaf comparison functor

The comparison functors are in the core section: `SchemeComparison.pullback` (discrete
coefficients, `c_X : X◇_v → X_ét`), `SchemeComparison.pullbackAdic` (adic coefficients,
`c_X : X◇_v → X_proét`, completed), their right adjoints `pushforward`, `pushforwardAdic` and the
adjunctions `adj`, `adjAdic`. -/

namespace SchemeComparison

variable (p : ℕ) [Fact p.Prime]

-- API SchemeComparison.pullback: declared in core.

/-- `SchemeComparison.reduce`: the adic comparison `c_X^*` commutes with reduction modulo `Iⁿ`,
where the discrete comparison is used on `Λ/Iⁿ`. -/
theorem reduce (X : CharPScheme.{u} p) {Λ : Type u} [CommRing Λ] (I : Ideal Λ)
    (hI : IsAdicCoefficientPair p I) (n : ℕ) (hn : 1 ≤ n) :
    Nonempty (pullbackAdic p X I ⋙ AdicEtale.reduction (SchemeDiamond.charPStack p X) I n ≅
      SchemeAdic.reduce X.obj hI n hn ⋙ pullback p X (Λ ⧸ I ^ n)) := sorry

/-- The canonical point `Spd C → (Spec C)◇` of a complete algebraically closed nonarchimedean field
of characteristic `p`: under `SchemeDiamond.charP_points_affine` it is the identity ring map
`C → C = 𝒪(Spa(C, 𝒪_C))`. -/
def geomPointToSpec (C : Type u) [NontriviallyNormedField C] [IsUltrametricDist C]
    [CompleteSpace C] [IsAlgClosed C] [CharP C p] :
    geomPoint p C ⟶ (SchemeDiamond.charP p).obj (CharPScheme.spec p C) := sorry

/-- `SchemeComparison.stalk`: at a geometric perfectoid point `Spd C → X◇` the pullback computes the
geometric stalk of the scheme at the induced point `Spec C → X`. Precisely: on `Spec C` the
comparison followed by restriction to `Spd C` is an equivalence (both sides are `D(Λ)`); every
point `Spd C → X◇` comes from a point `x : Spec C → X`; and restricting `c_X^*` to the point is the
scheme pullback `x^*` followed by that equivalence. -/
theorem stalk (X : CharPScheme.{u} p) (Λ : Type u) [CommRing Λ] (hΛ : IsPrimeToPTorsion p Λ)
    (C : Type u) [NontriviallyNormedField C] [IsUltrametricDist C] [CompleteSpace C]
    [IsAlgClosed C] [CharP C p] :
    (pullback p (CharPScheme.spec p C) Λ ⋙
        DEtale.pullback ((SmallVSheaf.toStack p).map (geomPointToSpec p C))).IsEquivalence ∧
      (∀ y : geomPoint p C ⟶ (SchemeDiamond.charP p).obj X,
        ∃ x : CharPScheme.spec p C ⟶ X, y = geomPointToSpec p C ≫ (SchemeDiamond.charP p).map x) ∧
      ∀ x : CharPScheme.spec p C ⟶ X,
        Nonempty (pullback p X Λ ⋙ DEtale.pullback ((SmallVSheaf.toStack p).map
            (geomPointToSpec p C ≫ (SchemeDiamond.charP p).map x)) ≅
          SchemeEtale.pullback x.hom ⋙ pullback p (CharPScheme.spec p C) Λ ⋙
            DEtale.pullback ((SmallVSheaf.toStack p).map (geomPointToSpec p C))) :=
  sorry

/-- `SchemeComparison.unit`: `c_X^*` sends the tensor unit to the tensor unit, for discrete
coefficients (the constant sheaf `Λ`) and for adic coefficients (the completed constant `Λ̂`). -/
theorem unit (X : CharPScheme.{u} p) (Λ : Type u) [CommRing Λ] (hΛ : IsPrimeToPTorsion p Λ)
    {Λ' : Type u} [CommRing Λ'] (I : Ideal Λ') (hI : IsAdicCoefficientPair p I) :
    Nonempty ((pullback p X Λ).obj (𝟙_ (SchemeEtale X.obj Λ)) ≅
        𝟙_ (DEtale (SchemeDiamond.charPStack p X) Λ)) ∧
      Nonempty ((pullbackAdic p X I).obj (𝟙_ (SchemeAdic X.obj I)) ≅
        AdicEtale.completedUnit (SchemeDiamond.charPStack p X) I) :=
  sorry

/-- `SchemeComparison.colimit`: the comparison functors preserve all small colimits (for adic
coefficients these are the completed colimits of `D_ét(X◇, Λ)`), being left adjoints with right
adjoints `pushforward` and `pushforwardAdic`. -/
theorem colimit (X : CharPScheme.{u} p) (Λ : Type u) [CommRing Λ] {Λ' : Type u} [CommRing Λ']
    (I : Ideal Λ') :
    PreservesColimitsOfSize.{u, u} (pullback p X Λ) ∧ (pullback p X Λ).IsLeftAdjoint ∧
      PreservesColimitsOfSize.{u, u} (pullbackAdic p X I) ∧ (pullbackAdic p X I).IsLeftAdjoint :=
  ⟨(adj p X Λ).leftAdjoint_preservesColimits, (adj p X Λ).isLeftAdjoint,
    (adjAdic p X I).leftAdjoint_preservesColimits, (adjAdic p X I).isLeftAdjoint⟩

/- Test `SchemeComparison.point` (computation): at a geometric point `Spec k` the comparison sends
the constant étale sheaf on a finite module `M` over a prime-to-`p` torsion ring to the constant
v-sheaf `M`. -/
example (k : Type u) [Field k] [IsAlgClosed k] [CharP k p] (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) (M : ModuleCat.{u} Λ) [Module.Finite Λ M] :
    Nonempty ((DEtale.toV _ Λ).obj ((pullback p (CharPScheme.spec p k) Λ).obj
        ((SchemeEtale.const _ Λ).obj M)) ≅
      (VDerived.const (SchemeDiamond.charPStack p (CharPScheme.spec p k)) Λ).obj M) :=
  sorry

/- Test `SchemeComparison.zero` (degenerate): `c_X^*` sends zero objects to zero objects, for
discrete and for adic coefficients. -/
example (X : CharPScheme.{u} p) (Λ : Type u) [CommRing Λ] {Λ' : Type u} [CommRing Λ']
    (I : Ideal Λ') :
    (∀ A : SchemeEtale X.obj Λ, IsZero A → IsZero ((pullback p X Λ).obj A)) ∧
      ∀ A : SchemeAdic X.obj I, IsZero A → IsZero ((pullbackAdic p X I).obj A) := by
  have : PreservesColimitsOfSize.{0, 0} (pullback p X Λ) :=
    (adj p X Λ).leftAdjoint_preservesColimits
  have : PreservesColimitsOfSize.{0, 0} (pullbackAdic p X I) :=
    (adjAdic p X I).leftAdjoint_preservesColimits
  exact ⟨fun A hA => (IsInitial.isInitialObj _ A hA.isInitial).isZero,
    fun A hA => (IsInitial.isInitialObj _ A hA.isInitial).isZero⟩

/- Test `SchemeComparison.openSupport` (characterisation): for an open immersion `j : U → X` and a
geometric point `Spd C → X◇` that does not factor through `U◇`, the stalk of `c_X^*(j_! A)` at that
point is zero. -/
example {U X : CharPScheme.{u} p} (j : U ⟶ X) [IsOpenImmersion j.hom] (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) (A : SchemeEtale U.obj Λ) (C : Type u)
    [NontriviallyNormedField C] [IsUltrametricDist C] [CompleteSpace C] [IsAlgClosed C]
    [CharP C p] (y : geomPoint p C ⟶ (SchemeDiamond.charP p).obj X)
    (hy : ¬ ∃ z, y = z ≫ (SchemeDiamond.charP p).map j) :
    IsZero ((DEtale.pullback ((SmallVSheaf.toStack p).map y)).obj
      ((pullback p X Λ).obj ((SchemeEtale.extendByZero j.hom).obj A))) :=
  sorry

/- Test `SchemeComparison.adic` (compatibility): for `Λ = ℤ_ℓ`, `I = (ℓ)`, `ℓ ≠ p`, the adic
comparison sends the completed lattice `ℤ_ℓ` on `X` to the derived completion of the constant
v-sheaf `ℤ_ℓ` (not to the uncompleted constant sheaf), and its reductions are the constants
`ℤ/ℓⁿ`. -/
example (ℓ : ℕ) [Fact ℓ.Prime] (hℓ : ℓ ≠ p) (X : CharPScheme.{0} p)
    (hI : IsAdicCoefficientPair p (Ideal.span {(ℓ : ℤ_[ℓ])}))
    (L : SchemeAdic X.obj (Ideal.span {(ℓ : ℤ_[ℓ])}))
    (hL : Nonempty (L.obj ≅ (ProEtDerived.completion X.obj (Ideal.span {(ℓ : ℤ_[ℓ])})).obj
      ((ProEtDerived.const X.obj ℤ_[ℓ]).obj (ModuleCat.of ℤ_[ℓ] ℤ_[ℓ])))) :
    Nonempty ((AdicEtale.forget _ _).obj ((pullbackAdic p X _).obj L) ≅
        (VDerived.completion _ (Ideal.span {(ℓ : ℤ_[ℓ])})).obj
          ((VDerived.const (SchemeDiamond.charPStack p X) ℤ_[ℓ]).obj
            (ModuleCat.of ℤ_[ℓ] ℤ_[ℓ]))) ∧
      ∀ (n : ℕ) (hn : 1 ≤ n),
        Nonempty ((DEtale.toV _ _).obj ((AdicEtale.reduction _ _ n).obj
            ((pullbackAdic p X _).obj L)) ≅
          (VDerived.const (SchemeDiamond.charPStack p X) (ℤ_[ℓ] ⧸ Ideal.span {(ℓ : ℤ_[ℓ])} ^ n)).obj
            (ModuleCat.of _ (ℤ_[ℓ] ⧸ Ideal.span {(ℓ : ℤ_[ℓ])} ^ n))) :=
  sorry

end SchemeComparison

/-! ### L1/plus-convention-comparison: comparison of residue-field conventions

The characteristic-`p` functor sends `Spec k` to `Spd(k, k⁺)` with `k⁺ = charPPlus p k`
(`SchemeDiamond.charP_spa`), the mixed-characteristic functor sends the residue point to
`Spd(k, k)` (`SchemeDiamond.overDVR_closedFibre`); `plusConventionMap` compares them. -/

namespace SchemeDiamond

variable (p : ℕ) [Fact p.Prime]

/-- The map `Spd(k, k) → Spd(k, k⁺)` of the discrete field `k`, induced by the identity of `k` and
the inclusion of plus rings `k⁺ ⊆ k`: it goes from the larger plus ring to the smaller one. -/
def plusConventionMap (k : Type u) [Field k] [Algebra (ZMod p) k] :
    spdDiscrete p k ⊤ ⟶ spdDiscrete p k (charPPlus p k) :=
  (AdicSpace.diamond p).map
    (adicSpectrumMap (tA := ⊥) (tB := ⊥) (Aplus := charPPlus p k) (Bplus := ⊤) (RingHom.id k)
      continuous_bot (fun _ _ => Subring.mem_comap.mpr (Subring.mem_top _)))

/-- `L1/plus-convention-comparison`, set-level form: on points, `Spa(k, k) ⊆ Spa(k, k⁺)` for the
discrete topology on `k` (a larger plus ring gives a smaller adic spectrum). -/
theorem spa_top_subset_spa_charPPlus (k : Type u) [Field k] [Algebra (ZMod p) k] :
    @TauCeti.ValuationSpectrum.spa k _ ⊥ ⊤ ⊆ @TauCeti.ValuationSpectrum.spa k _ ⊥ (charPPlus p k) :=
  @TauCeti.ValuationSpectrum.spa_antitone k _ ⊥ _ _ le_top

/-- `L1/plus-convention-comparison` (ECD §27, mixed-characteristic paragraph): for a perfect field
`k` algebraic over `𝔽_p` the plus ring `k⁺` is all of `k` and the comparison map
`Spd(k, k) → Spd(k, k⁺)` is an isomorphism. For general `k` it is not (see the test
`SchemeDiamond.nonagreement`). -/
theorem isIso_plusConventionMap (k : Type u) [Field k] [CharP k p] [Algebra (ZMod p) k]
    [PerfectRing k p] [Algebra.IsAlgebraic (ZMod p) k] :
    charPPlus p k = ⊤ ∧ IsIso (plusConventionMap p k) := by
  refine ⟨?_, sorry⟩
  rw [charPPlus, integralClosure_eq_top_iff.mpr inferInstance, Algebra.top_toSubring]

/-- `L1/plus-convention-comparison`, the two avatars of the residue point: for the residue field
`k` of `O`, the mixed-characteristic functor gives `Spd(k, k)` and the characteristic-`p` functor
gives `Spd(k, k⁺)`, so `plusConventionMap` goes from the first avatar to the second. -/
theorem plusConvention_avatars (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [TopologicalSpace O] [IsCompleteDVRBase p O] [CharP (IsLocalRing.ResidueField O) p]
    [Algebra (ZMod p) (IsLocalRing.ResidueField O)] :
    Nonempty (((overDVR p O).obj (LFTScheme.spec O (IsLocalRing.ResidueField O))).left ≅
        spdDiscrete p (IsLocalRing.ResidueField O) ⊤) ∧
      Nonempty ((charP p).obj (CharPScheme.spec p (IsLocalRing.ResidueField O)) ≅
        spdDiscrete p (IsLocalRing.ResidueField O) (charPPlus p (IsLocalRing.ResidueField O))) :=
  sorry

end SchemeDiamond

/-! ### L1/mixed-characteristic-scheme-diamond: the scheme v-sheaf over a complete DVR

The functor `X ↦ X◇` from `O`-schemes locally of finite type to small v-sheaves over
`Spd(O, O)` is `SchemeDiamond.overDVR`, with value `SchemeDiamond.overDVRStack` as a small
v-stack (core). -/

namespace SchemeDiamond

variable (p : ℕ) [Fact p.Prime]

section DVR

variable (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] [TopologicalSpace O]
  [IsCompleteDVRBase p O]

-- API SchemeDiamond.overDVR: declared in core.

/-- `SchemeDiamond.overDVR_points`: for a perfectoid space `S`, maps `S → X◇` are pairs of a marked
untilt `S♯` over `Spa(O, O)` and a map `S♯ → X` of locally ringed spaces over `Spec O`. -/
def overDVR_points (X : LFTScheme O) (S : PerfectoidSpace.{u} p) :
    ((PerfectoidSpace.toVSheaf p).obj S ⟶ ((overDVR p O).obj X).left) ≃
      Σ x : MarkedUntilt p O ⊤ S,
        {g : AdicSpace.toLocallyRingedSpace.obj x.space.left ⟶ X.obj.left.toLocallyRingedSpace //
          g ≫ X.obj.hom.toLRSHom =
            AdicSpace.toLocallyRingedSpace.map x.space.hom ≫ adicSpectrumToSpec O ⊤} :=
  sorry

/-- The untilt attached to a map `S → X◇` by `overDVR_points` is the one classifying the composite
`S → X◇ → Spd(O, O)`. -/
theorem overDVR_points_toSpd (X : LFTScheme O) (S : PerfectoidSpace.{u} p)
    (f : (PerfectoidSpace.toVSheaf p).obj S ⟶ ((overDVR p O).obj X).left) :
    ((overDVR_points p O X S) f).1.toSpd = f ≫ ((overDVR p O).obj X).hom := sorry

/-- `SchemeDiamond.overDVR_functor`: `X ↦ X◇` preserves identities and composition. -/
theorem overDVR_functor {X Y Z : LFTScheme O} (f : X ⟶ Y) (g : Y ⟶ Z) :
    (overDVR p O).map (𝟙 X) = 𝟙 _ ∧
      (overDVR p O).map (f ≫ g) = (overDVR p O).map f ≫ (overDVR p O).map g :=
  ⟨(overDVR p O).map_id X, (overDVR p O).map_comp f g⟩

/-- Gluing: for an `O`-scheme `X = U ∪ V` covered by two opens with intersection `W`, the square
of v-sheaves `W◇, U◇, V◇, X◇` is a pushout. -/
theorem overDVR_glue {W U V X : LFTScheme O} (i₁ : W ⟶ U) (i₂ : W ⟶ V) (j₁ : U ⟶ X)
    (j₂ : V ⟶ X) [IsOpenImmersion j₁.hom.left] [IsOpenImmersion j₂.hom.left]
    (hW : IsPullback i₁.hom.left i₂.hom.left j₁.hom.left j₂.hom.left)
    (hcov : Set.range j₁.hom.left ∪ Set.range j₂.hom.left = Set.univ) :
    IsPushout ((overDVR p O).map i₁).left ((overDVR p O).map i₂).left
      ((overDVR p O).map j₁).left ((overDVR p O).map j₂).left :=
  sorry

/-- `SchemeDiamond.overDVR_closedFibre`: the residue point `Spec k → Spec O` goes to
`Spd(k, k) → Spd(O, O)`, with plus ring all of `k` (not `k⁺`), `k` discrete. The continuity of
the residue map for the discrete topology holds because the maximal ideal is open. -/
theorem overDVR_closedFibre (hres : @Continuous O (IsLocalRing.ResidueField O) _ ⊥
      (algebraMap O (IsLocalRing.ResidueField O))) :
    ∃ e : ((overDVR p O).obj (LFTScheme.spec O (IsLocalRing.ResidueField O))).left ≅
        spdDiscrete p (IsLocalRing.ResidueField O) ⊤,
      e.inv ≫ ((overDVR p O).obj (LFTScheme.spec O (IsLocalRing.ResidueField O))).hom =
        (AdicSpace.diamond p).map (adicSpectrumMap (tB := ⊥) (Aplus := ⊤) (Bplus := ⊤)
          (algebraMap O (IsLocalRing.ResidueField O)) hres
          (fun _ _ => Subring.mem_comap.mpr (Subring.mem_top _))) :=
  sorry

/-- `SchemeDiamond.overDVR_generic`: let `K = Frac O` with the topology making `O ⊂ K` an open
topological subring. The generic fibre `X◇ ×_{Spd O} Spd(K, O)` is the diamond of the
analytification of the algebraic generic fibre `X_K`, naturally in `X`. -/
theorem overDVR_generic (K : Type u) [Field K] [Algebra O K] [IsFractionRing O K]
    [TopologicalSpace K] [IsTopologicalRing K] (hK : Topology.IsOpenEmbedding (algebraMap O K)) :
    Nonempty (overDVR p O ⋙
        Over.pullback ((AdicSpace.diamond p).map (adicSpectrumMap (Aplus := ⊤)
          (Bplus := (algebraMap O K).range) (algebraMap O K) hK.continuous
          (fun x _ => Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨x, rfl⟩)))) ⋙
        Over.forget _ ≅
      LFTScheme.baseChange O K ⋙ SchemeAnalytification K (algebraMap O K).range ⋙
        AdicSpace.diamond p) :=
  sorry

/-- `SchemeDiamond.overDVR_empty`: an empty `O`-scheme gives the empty (initial) small v-sheaf. -/
theorem overDVR_empty (X : LFTScheme O) [IsEmpty X.obj.left] :
    Nonempty (IsInitial ((overDVR p O).obj X).left) := sorry

/-- `SchemeDiamond.overDVR_representable`: for a perfectoid `S → Spd(O, O)` classified by a marked
untilt `S♯`, the base change `X◇ ×_{Spd O} S` is the diamond of the relative analytification
`X ×_{Spec O} S♯`, naturally in `X`. In particular `X◇ → Spd O` is representable in locally
spatial diamonds, although `X◇` itself need not be a diamond. -/
theorem overDVR_representable (S : PerfectoidSpace.{u} p) (x : MarkedUntilt p O ⊤ S) :
    Nonempty (overDVR p O ⋙ Over.pullback x.toSpd ⋙ Over.forget _ ≅
      relativeAnalytification x.space ⋙ AdicSpace.diamond p) := sorry

/- Test `SchemeDiamond.residue` (computation): `Spec k`, for `k` the residue field of `O`, gives
`Spd(k, k)` with `k` itself as plus ring. -/
example : Nonempty (((overDVR p O).obj (LFTScheme.spec O (IsLocalRing.ResidueField O))).left ≅
    spdDiscrete p (IsLocalRing.ResidueField O) ⊤) := sorry

/- Test `SchemeDiamond.base` (degenerate): `Spec O` gives `Spd(O, O)` with the identity as structure
map, i.e. the terminal object over `Spd(O, O)`. -/
example : Nonempty ((overDVR p O).obj (LFTScheme.spec O O) ≅ Over.mk (𝟙 (spd p O ⊤))) := sorry

/- Test `SchemeDiamond.emptyDVR` (degenerate): the empty `O`-scheme gives the empty small
v-sheaf. -/
example : Nonempty (IsInitial ((overDVR p O).obj
    ⟨Over.mk (Scheme.emptyTo (Spec (CommRingCat.of O))),
      inferInstanceAs (LocallyOfFiniteType (Scheme.emptyTo _))⟩).left) := sorry

/- Test `SchemeDiamond.nonagreement` (non-example): if the residue field `k` contains an element
transcendental over `𝔽_p`, then `k⁺ ≠ k` and the comparison `Spd(k, k) → Spd(k, k⁺)` between the
mixed-characteristic and the characteristic-`p` residue avatars is not an isomorphism. -/
example [Algebra (ZMod p) (IsLocalRing.ResidueField O)] (t : IsLocalRing.ResidueField O)
    (ht : Transcendental (ZMod p) t) :
    charPPlus p (IsLocalRing.ResidueField O) ≠ ⊤ ∧
      ¬ IsIso (plusConventionMap p (IsLocalRing.ResidueField O)) := by
  refine ⟨fun h => ht ?_, sorry⟩
  have hk : t ∈ charPPlus p (IsLocalRing.ResidueField O) := by rw [h]; exact Subring.mem_top t
  rw [Subalgebra.mem_toSubring, mem_integralClosure_iff] at hk
  exact hk.isAlgebraic

end DVR

/- Test `SchemeDiamond.notDiamond` (non-example): for `O = ℤ_p`, `Spd ℤ_p = (Spec ℤ_p)◇` is not a
diamond (it contains the non-diamond `Spd 𝔽_p = *` as the locus `p = 0`), so a definition with
values in diamonds would reject `Spec ℤ_p`. -/
example [IsCompleteDVRBase p ℤ_[p]] :
    ¬ IsDiamond (spd p ℤ_[p] ⊤) ∧
      ¬ IsDiamond ((overDVR p ℤ_[p]).obj (LFTScheme.spec ℤ_[p] ℤ_[p])).left := sorry

end SchemeDiamond

end L1

/-! ## L2: compactifications over qcqs bases, limits, continuity and proper support

The schematic layer is stated with Mathlib's `Scheme`, its morphism properties, its pullbacks,
its scheme-theoretic image and its cofiltered limits. -/

section L2

/-! ### L2/affine-transition-limit-existence: Existence of affine-transition inverse limits -/

/-- `L2/affine-transition-limit-existence` (Stacks Lemma 32.2.2, Tag 01YX): a cofiltered diagram
of schemes with affine transition maps has a limit. For a given limit cone, the affineness of the
projections, the compatibility with restriction to an open of a stage and quasi-compactness are
Mathlib's `isAffineHom_π_app`, `isLimitOpensCone` and `Scheme.compactSpace_of_isLimit`. -/
theorem affineTransitionLimit {I : Type u} [Category.{u} I] [IsCofiltered I]
    (D : I ⥤ Scheme.{u}) [∀ {i j : I} (g : i ⟶ j), IsAffineHom (D.map g)] :
    Nonempty (LimitCone D) := by
  sorry

section Limits

variable {I : Type u} [Category.{u} I] [IsCofiltered I] (D : I ⥤ Scheme.{u})
  [∀ {i j : I} (g : i ⟶ j), IsAffineHom (D.map g)] [∀ i, CompactSpace (D.obj i)]
  [∀ i, QuasiSeparatedSpace (D.obj i)] (c : Cone D) (hc : IsLimit c)

omit [∀ i, CompactSpace (D.obj i)] in
include hc in
/-- `L2/affine-transition-limit-existence` (Stacks Lemma 32.2.2, Tag 01YX), quasi-separatedness
clause: a limit of quasi-separated stages with affine transitions is quasi-separated. -/
theorem quasiSeparatedSpace_of_isLimit : QuasiSeparatedSpace c.pt := by
  sorry

/-! ### L2/fp-relative-diagram-descent: Finite-presentation objects and diagram descent

The morphism and eventual-equality clauses for maps from the limit into a scheme locally of
finite presentation are Mathlib's `Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation`
and `Scheme.exists_hom_hom_comp_eq_comp_of_locallyOfFiniteType`, applied to the cofiltered
diagram of base changes. -/

include hc in
/-- `L2/fp-relative-diagram-descent` (Stacks Lemma 32.10.1, Tag 01ZM), object clause: a finitely
presented scheme over the limit is the base change of a finitely presented scheme over some
stage. -/
theorem fpObjectDescent {X : Scheme.{u}} (f : X ⟶ c.pt) [LocallyOfFinitePresentation f]
    [QuasiCompact f] [QuasiSeparated f] :
    ∃ (i : I) (Xi : Scheme.{u}) (fi : Xi ⟶ D.obj i), LocallyOfFinitePresentation fi ∧
      QuasiCompact fi ∧ QuasiSeparated fi ∧
      ∃ e : X ≅ pullback fi (c.π.app i), e.hom ≫ pullback.snd fi (c.π.app i) = f := by
  sorry

/-- A finitely presented `𝒪`-module on a scheme (Mathlib's `SheafOfModules.IsFinitePresentation`
on `Scheme.Modules`). -/
abbrev IsFinitelyPresentedModule {Z : Scheme.{u}} (M : Z.Modules) : Prop :=
  SheafOfModules.IsFinitePresentation M

include hc in
/-- `L2/fp-relative-diagram-descent` (Stacks Lemma 32.10.2, Tag 01ZR), module object clause: a
finitely presented `𝒪`-module on the limit is the pullback of a finitely presented module on
some stage. -/
theorem fpModuleDescent (M : c.pt.Modules) (hM : IsFinitelyPresentedModule M) :
    ∃ (i : I) (Mi : (D.obj i).Modules), IsFinitelyPresentedModule Mi ∧
      Nonempty ((Scheme.Modules.pullback (c.π.app i)).obj Mi ≅ M) := by
  sorry

/-- The canonical isomorphism between the pullback to the limit of the pullback of `M` to a
stage `j ⟶ i`, and the pullback of `M` to the limit. -/
def limitModuleIso {i j : I} (g : j ⟶ i) (M : (D.obj i).Modules) :
    (Scheme.Modules.pullback (c.π.app j)).obj ((Scheme.Modules.pullback (D.map g)).obj M) ≅
      (Scheme.Modules.pullback (c.π.app i)).obj M :=
  (Scheme.Modules.pullbackComp (c.π.app j) (D.map g)).app M ≪≫
    (Scheme.Modules.pullbackCongr (c.w g)).app M

include hc in
/-- `L2/fp-relative-diagram-descent` (Stacks Lemma 32.10.2, Tag 01ZR), module morphism clause:
for finitely presented modules on a stage, a map between their pullbacks to the limit comes
from a map between their pullbacks to a later stage. -/
theorem fpModuleHomDescent {i : I} (M N : (D.obj i).Modules)
    (hM : IsFinitelyPresentedModule M) (hN : IsFinitelyPresentedModule N)
    (φ : (Scheme.Modules.pullback (c.π.app i)).obj M ⟶
      (Scheme.Modules.pullback (c.π.app i)).obj N) :
    ∃ (j : I) (g : j ⟶ i) (ψ : (Scheme.Modules.pullback (D.map g)).obj M ⟶
        (Scheme.Modules.pullback (D.map g)).obj N),
      (Scheme.Modules.pullback (c.π.app j)).map ψ =
        (limitModuleIso D c g M).hom ≫ φ ≫ (limitModuleIso D c g N).inv := by
  sorry

include hc in
/-- `L2/fp-relative-diagram-descent` (Stacks Lemma 32.10.2, Tag 01ZR), eventual equality: two
maps of modules on a stage, with finitely presented source, that agree on the limit agree on a
later stage. -/
theorem fpModuleHom_eventuallyEq {i : I} (M N : (D.obj i).Modules)
    (hM : IsFinitelyPresentedModule M) (hN : IsFinitelyPresentedModule N) (a b : M ⟶ N)
    (hab : (Scheme.Modules.pullback (c.π.app i)).map a =
      (Scheme.Modules.pullback (c.π.app i)).map b) :
    ∃ (j : I) (g : j ⟶ i),
      (Scheme.Modules.pullback (D.map g)).map a = (Scheme.Modules.pullback (D.map g)).map b := by
  sorry

/-! ### L2/compactification-property-descent: Descent of compactification properties -/

/-- The base change to the stage `j` of a morphism `φ` of schemes over the stage `i`. -/
def stageMap {i : I} {X Y : Scheme.{u}} (p : X ⟶ D.obj i) (q : Y ⟶ D.obj i) (φ : X ⟶ Y)
    (h : φ ≫ q = p) {j : I} (g : j ⟶ i) : pullback p (D.map g) ⟶ pullback q (D.map g) :=
  pullback.map p (D.map g) q (D.map g) φ (𝟙 _) (𝟙 _) (by simp [h]) (by simp)

/-- The base change to the limit of a morphism `φ` of schemes over the stage `i`. -/
def limitMap {i : I} {X Y : Scheme.{u}} (p : X ⟶ D.obj i) (q : Y ⟶ D.obj i) (φ : X ⟶ Y)
    (h : φ ≫ q = p) : pullback p (c.π.app i) ⟶ pullback q (c.π.app i) :=
  pullback.map p (c.π.app i) q (c.π.app i) φ (𝟙 _) (𝟙 _) (by simp [h]) (by simp)

include hc in
/-- `L2/compactification-property-descent` (Stacks Lemma 32.8.12, Tag 0EUU), open-immersion
clause: for finitely presented schemes over a stage, a map whose base change to the limit is an
open immersion has an open-immersion base change at a later stage. -/
theorem openImmersion_descends {i : I} {X Y : Scheme.{u}} (p : X ⟶ D.obj i)
    (q : Y ⟶ D.obj i) [LocallyOfFinitePresentation p] [QuasiCompact p] [QuasiSeparated p]
    [LocallyOfFinitePresentation q] [QuasiCompact q] [QuasiSeparated q]
    (φ : X ⟶ Y) (h : φ ≫ q = p) (hφ : IsOpenImmersion (limitMap D c p q φ h)) :
    ∃ (j : I) (g : j ⟶ i), IsOpenImmersion (stageMap D p q φ h g) := by
  sorry

include hc in
/-- `L2/compactification-property-descent` (Stacks Lemma 32.13.1, Tag 081F), properness clause:
for finitely presented schemes over a stage, a map whose base change to the limit is proper has
a proper base change at a later stage. -/
theorem proper_descends {i : I} {X Y : Scheme.{u}} (p : X ⟶ D.obj i) (q : Y ⟶ D.obj i)
    [LocallyOfFinitePresentation p] [QuasiCompact p] [QuasiSeparated p]
    [LocallyOfFinitePresentation q] [QuasiCompact q] [QuasiSeparated q]
    (φ : X ⟶ Y) (h : φ ≫ q = p) (hφ : IsProper (limitMap D c p q φ h)) :
    ∃ (j : I) (g : j ⟶ i), IsProper (stageMap D p q φ h g) := by
  sorry

include hc in
/-- `L2/compactification-property-descent` (Stacks Tags 0EUU and 081F), compactification
diagram: for finitely presented `p : X ⟶ Dᵢ`, `q : Z ⟶ Dᵢ` and `φ : X ⟶ Z` over `Dᵢ`, if at the
limit `φ` becomes a quasi-compact open immersion and `q` becomes proper, then both hold at one
common later stage, where the base-changed triangle commutes by construction. -/
theorem compactificationDiagram_descends {i : I} {X Z : Scheme.{u}} (p : X ⟶ D.obj i)
    (q : Z ⟶ D.obj i) [LocallyOfFinitePresentation p] [QuasiCompact p] [QuasiSeparated p]
    [LocallyOfFinitePresentation q] [QuasiCompact q] [QuasiSeparated q]
    (φ : X ⟶ Z) (h : φ ≫ q = p) (hφ : IsOpenImmersion (limitMap D c p q φ h))
    (hq : IsProper (pullback.snd q (c.π.app i))) :
    ∃ (j : I) (g : j ⟶ i), IsOpenImmersion (stageMap D p q φ h g) ∧
      IsProper (pullback.snd q (D.map g)) := by
  sorry

end Limits

/-! ### L2/noetherian-approximation: Noetherian approximation of qcqs schemes -/

/-- `L2/noetherian-approximation` (Stacks Proposition 32.5.4, Tag 01ZA, with Lemma 32.5.3,
Tag 07RN): a quasi-compact quasi-separated scheme is the limit of a cofiltered diagram of
schemes of finite type over `Spec ℤ` with affine transition maps. The projections are then
affine (`isAffineHom_π_app`), and finitely presented data descend by
`L2/fp-relative-diagram-descent`. -/
theorem noetherianApproximation (S : Scheme.{u}) [CompactSpace S] [QuasiSeparatedSpace S] :
    ∃ (I : Type u) (_ : SmallCategory I) (_ : IsCofiltered I) (D : I ⥤ Scheme.{u})
      (_ : ∀ {i j : I} (g : i ⟶ j), IsAffineHom (D.map g))
      (_ : ∀ i, CompactSpace (D.obj i) ∧ LocallyOfFiniteType (terminal.from (D.obj i)))
      (c : Cone D) (_ : IsLimit c), Nonempty (c.pt ≅ S) := by
  sorry

/-! ### L2/finite-type-fp-factorisation: Finite-type factorisation through finite presentation -/

/-- `L2/finite-type-fp-factorisation` (Stacks Proposition 32.9.6, Tag 01ZJ): a separated
finite-type morphism to a qcqs scheme is a closed immersion followed by a separated finitely
presented morphism. Finite presentation of `f` is not assumed. -/
theorem finiteTypeFPFactorisation {Y X : Scheme.{u}} (f : Y ⟶ X) [CompactSpace X]
    [QuasiSeparatedSpace X] [IsSeparated f] [LocallyOfFiniteType f] [QuasiCompact f] :
    ∃ (Y' : Scheme.{u}) (i : Y ⟶ Y') (g : Y' ⟶ X), IsClosedImmersion i ∧ IsSeparated g ∧
      LocallyOfFinitePresentation g ∧ QuasiCompact g ∧ i ≫ g = f := by
  sorry

/-! ### L2/compactification: Scheme compactification -/

/-- `L2/compactification` (Boxer–Pilloni Definition 2.1.2; Stacks Section 38.32, Tag 0ATT): a
compactification of `f : Y ⟶ X` is a scheme `Ȳ` with a quasi-compact open immersion
`j : Y ⟶ Ȳ` and a proper `p : Ȳ ⟶ X` with `p ∘ j = f`. Density of `Y` in `Ȳ` is not required,
so extra proper components are allowed. A compactification exists only for separated
finite-type `f`; the theorems below carry that hypothesis and the quasi-compactness and
quasi-separatedness of `X`.

API `Compactification.mk`, `Compactification.ambient`, `Compactification.open`,
`Compactification.properMap`: the constructor and the projections of this structure; the
field `factorisation` records `p ∘ j = f`. -/
structure Compactification {Y X : Scheme.{u}} (f : Y ⟶ X) where
  /-- The ambient scheme `Ȳ`. -/
  ambient : Scheme.{u}
  /-- The open immersion `j : Y ⟶ Ȳ`. -/
  «open» : Y ⟶ ambient
  /-- The proper map `p : Ȳ ⟶ X`. -/
  properMap : ambient ⟶ X
  openImmersion : IsOpenImmersion «open»
  quasiCompact : QuasiCompact «open»
  proper : IsProper properMap
  factorisation : «open» ≫ properMap = f

attribute [instance] Compactification.openImmersion Compactification.quasiCompact
  Compactification.proper

namespace Compactification

variable {Y X : Scheme.{u}} {f : Y ⟶ X}

/-- The open range `j(Y)` of a compactification, as an open of `Ȳ`. -/
abbrev openRange (C : Compactification f) : C.ambient.Opens := C.open.opensRange

/-- The identity compactification `(Y, 𝟙, f)` of a proper map. -/
def ofProper (f : Y ⟶ X) [IsProper f] : Compactification f where
  ambient := Y
  «open» := 𝟙 Y
  properMap := f
  openImmersion := inferInstance
  quasiCompact := inferInstance
  proper := inferInstance
  factorisation := Category.id_comp f

/-- Transport of a compactification along an isomorphism `e : Ȳ ≅ Z` of ambient schemes: the
open immersion becomes `j ≫ e.hom` and the proper map `e.inv ≫ p`. -/
def transportAmbient (C : Compactification f) {Z : Scheme.{u}} (e : C.ambient ≅ Z) :
    Compactification f where
  ambient := Z
  «open» := C.open ≫ e.hom
  properMap := e.inv ≫ C.properMap
  openImmersion := inferInstance
  quasiCompact := inferInstance
  proper := inferInstance
  factorisation := by simp [C.factorisation]

/-- A compactification with a whole extra proper component: `Y ⨿ Y` over `Y`, with `j` the
first summand. -/
def double (Y : Scheme.{u}) : Compactification (𝟙 Y) where
  ambient := Y ⨿ Y
  «open» := coprod.inl
  properMap := coprod.desc (𝟙 Y) (𝟙 Y)
  openImmersion := inferInstance
  quasiCompact := sorry
  proper := sorry
  factorisation := coprod.inl_desc _ _

/-! ### L2/compactification-morphism: Maps and strict maps of compactifications -/

/-- `L2/compactification-morphism` (Zavyalov Definition 2.1.1): a morphism `C' ⟶ C` of
compactifications of `f` is an `X`-map `g : Ȳ' ⟶ Ȳ` with `g ∘ j' = j`. Morphisms point from
finer to coarser compactifications and need not be strict.

API `Compactification.Hom.mk`, `Compactification.Hom.map`: the constructor and the ambient
map of this structure. -/
structure Hom (C D : Compactification f) where
  /-- The ambient map `g : Ȳ' ⟶ Ȳ`. -/
  map : C.ambient ⟶ D.ambient
  open_comm : C.open ≫ map = D.open
  base_comm : map ≫ D.properMap = C.properMap

attribute [reassoc (attr := simp)] Hom.open_comm Hom.base_comm

theorem Hom.ext_map {C D : Compactification f} {a b : Hom C D} (h : a.map = b.map) : a = b := by
  cases a; cases b; cases h; rfl

/-! ### L2/compactification-category: Category of compactifications -/

/-- API `Compactification.category`: compactifications of `f` form a category under
composition of ambient maps. -/
instance category : Category (Compactification f) where
  Hom C D := Hom C D
  id C := { map := 𝟙 _, open_comm := by simp, base_comm := by simp }
  comp a b :=
    { map := a.map ≫ b.map
      open_comm := by rw [← Category.assoc, a.open_comm, b.open_comm]
      base_comm := by rw [Category.assoc, b.base_comm, a.base_comm] }
  id_comp _ := Hom.ext_map (Category.id_comp _)
  comp_id _ := Hom.ext_map (Category.comp_id _)
  assoc _ _ _ := Hom.ext_map (Category.assoc _ _ _)

@[simp]
theorem id_map (C : Compactification f) : Hom.map (𝟙 C) = 𝟙 C.ambient := rfl

@[simp]
theorem comp_map {C D E : Compactification f} (a : C ⟶ D) (b : D ⟶ E) :
    Hom.map (a ≫ b) = a.map ≫ b.map := rfl

/-- API `Compactification.Hom.ext`: two morphisms of compactifications are equal iff their
ambient maps are equal. -/
theorem Hom.ext {C D : Compactification f} (a b : C ⟶ D) : a = b ↔ a.map = b.map :=
  ⟨fun h => h ▸ rfl, Hom.ext_map⟩

/-- API `Compactification.iso`: an isomorphism of ambient schemes commuting with the open
immersions and the proper maps is an isomorphism of compactifications. -/
def iso {C D : Compactification f} (e : C.ambient ≅ D.ambient) (he : C.open ≫ e.hom = D.open)
    (hp : e.hom ≫ D.properMap = C.properMap) : C ≅ D where
  hom := { map := e.hom, open_comm := he, base_comm := hp }
  inv :=
    { map := e.inv
      open_comm := by rw [← he, Category.assoc, e.hom_inv_id, Category.comp_id]
      base_comm := by rw [← hp, e.inv_hom_id_assoc] }
  hom_inv_id := Hom.ext_map e.hom_inv_id
  inv_hom_id := Hom.ext_map e.inv_hom_id

/-- A compactification is isomorphic to its transport along an ambient isomorphism. -/
def transportAmbientIso (C : Compactification f) {Z : Scheme.{u}} (e : C.ambient ≅ Z) :
    C ≅ C.transportAmbient e :=
  iso e rfl (by simp [transportAmbient])

/-- API `Compactification.isomorphism`: a morphism of compactifications is an isomorphism iff
its ambient map is an isomorphism of schemes. -/
theorem isomorphism {C D : Compactification f} (g : C ⟶ D) : IsIso g ↔ IsIso g.map := by
  sorry

/-- API `Compactification.Hom.strict`: a morphism `g : C' ⟶ C` is strict if the inverse image
of `j(Y)` under `g` is exactly `j'(Y)`. -/
def Hom.strict {C D : Compactification f} (g : C ⟶ D) : Prop :=
  g.map ⁻¹' Set.range D.open = Set.range C.open

/-- API `Compactification.Hom.strict_iff`: strictness says that the inverse image of the open
range of the target is the open range of the source, as opens of the source ambient. -/
theorem Hom.strict_iff {C D : Compactification f} (g : C ⟶ D) :
    Hom.strict g ↔ g.map ⁻¹ᵁ D.openRange = C.openRange := by
  sorry

/-- The cartesian reformulation of strictness: `g` is strict iff the square formed by `j'`, `j`,
`g` and the identity of `Y` is cartesian. -/
theorem Hom.strict_iff_isPullback {C D : Compactification f} (g : C ⟶ D) :
    Hom.strict g ↔ IsPullback (𝟙 Y) C.open D.open g.map := by
  sorry

/-- API `Compactification.Hom.strict_comp`, identity clause: identities are strict. -/
theorem Hom.strict_id (C : Compactification f) : Hom.strict (𝟙 C) := by
  sorry

/-- API `Compactification.Hom.strict_comp`: composites of strict morphisms are strict. -/
theorem Hom.strict_comp {C D E : Compactification f} (g : C ⟶ D) (h : D ⟶ E)
    (hg : Hom.strict g) (hh : Hom.strict h) : Hom.strict (g ≫ h) := by
  sorry

/-- The fold map `Y ⨿ Y ⟶ Y`, a morphism from the extra-component compactification to the
identity compactification of `𝟙 Y`. -/
def fold (Y : Scheme.{u}) : double Y ⟶ ofProper (𝟙 Y) where
  map := coprod.desc (𝟙 Y) (𝟙 Y)
  open_comm := coprod.inl_desc _ _
  base_comm := Category.comp_id _

/-- The endomorphism of `Y ⨿ Y` sending both summands to the first one; it fixes the open
summand. -/
def collapse (Y : Scheme.{u}) : double Y ⟶ double Y where
  map := coprod.desc coprod.inl coprod.inl
  open_comm := coprod.inl_desc _ _
  base_comm := sorry

/-! #### Tests for `L2/compactification` -/

/- Test `Compactification.proper` (degenerate): for a proper map the identity of `Y` with the
map itself is a compactification. -/
example (f : Y ⟶ X) [IsProper f] :
    (ofProper f).ambient = Y ∧ (ofProper f).open = 𝟙 Y ∧ (ofProper f).properMap = f :=
  ⟨rfl, rfl, rfl⟩

/- Test `Compactification.empty` (degenerate): an empty `Y` has a compactification with empty
ambient, and it also embeds openly into every proper `X`-scheme. -/
example [IsEmpty Y] (f : Y ⟶ X) :
    (∃ C : Compactification f, IsEmpty C.ambient) ∧
      ∀ (Z : Scheme.{u}) (p : Z ⟶ X) [IsProper p],
        ∃ C : Compactification f, ∃ e : C.ambient ≅ Z, e.hom ≫ p = C.properMap := by
  sorry

/- Test `Compactification.extraComponent` (non-example for density): over a point, `Y ⨿ Y`
with the first summand is a compactification of the identity whose open immersion is not
dominant. -/
example (k : Type u) [Field k] : ¬ IsDominant (double (Spec (.of k))).open := by
  sorry

/- Test `Compactification.nonproper` (non-example): the affine line over a field, with the
identity open immersion and its structure map, is not a compactification, since the structure
map is not proper. -/
example (k : Type u) [Field k]
    (C : Compactification (𝔸(ULift.{u} (Fin 1); Spec (.of k)) ↘ Spec (.of k)))
    (e : C.ambient ≅ 𝔸(ULift.{u} (Fin 1); Spec (.of k))) (he : C.open ≫ e.hom = 𝟙 _) :
    False := by
  sorry

/-! #### Tests for `L2/compactification-morphism` -/

/- Test `Compactification.Hom.identity` (degenerate): identities are strict. -/
example (C : Compactification f) : Hom.strict (𝟙 C) := Hom.strict_id C

/- Test `Compactification.Hom.boundary` (non-example): over a point, the fold map from the
extra-component compactification `Y ⨿ Y` to `Y` is a morphism that is not strict. -/
example (k : Type u) [Field k] : ¬ Hom.strict (fold (Spec (.of k))) := by
  sorry

/- Test `Compactification.Hom.empty` (degenerate): if `Y` is empty, every morphism of
compactifications of `f` is strict, both open ranges being empty. -/
example [IsEmpty Y] {C D : Compactification f} (g : C ⟶ D) : Hom.strict g := by
  sorry

/-! #### Tests for `L2/compactification-category` -/

/- Test `Compactification.category_id` (characterisation): the identity has the identity
ambient map, and composing with it leaves the ambient map and the bundled morphism unchanged. -/
example {C D : Compactification f} (g : C ⟶ D) :
    (𝟙 C : C ⟶ C).map = 𝟙 C.ambient ∧ (𝟙 C ≫ g).map = g.map ∧ 𝟙 C ≫ g = g ∧ g ≫ 𝟙 D = g :=
  ⟨rfl, Category.id_comp g.map, Category.id_comp g, Category.comp_id g⟩

/- Test `Compactification.parallelMaps` (non-example): for `Y` a point and `Y ⨿ Y` as both
source and target, the identity and the map sending the second summand to the first are
distinct morphisms. -/
example (k : Type u) [Field k] : collapse (Spec (.of k)) ≠ 𝟙 (double (Spec (.of k))) := by
  sorry

/- Test `Compactification.category_empty` (degenerate): for empty `Y` every proper `X`-scheme
`Z` is the ambient of some compactification, and if `Z` is nonempty such a compactification
admits no morphism to the empty one, so the category is not the one-object category. -/
example [IsEmpty Y] (Z : Scheme.{u}) (p : Z ⟶ X) [IsProper p] [Nonempty Z] :
    ∃ C C' : Compactification f, IsEmpty C.ambient ∧ Nonempty (C'.ambient ≅ Z) ∧
      IsEmpty (C' ⟶ C) := by
  sorry

/-! #### The scheme-theoretic image refinement -/

/-- API `Compactification.image`: the scheme-theoretic image `Ȳ₀` of `j` (Mathlib's
`Scheme.Hom.image`), with open immersion `Scheme.Hom.toImage` and proper map
`Ȳ₀ ⟶ Ȳ ⟶ X`. -/
def image (C : Compactification f) : Compactification f where
  ambient := C.open.image
  «open» := C.open.toImage
  properMap := C.open.imageι ≫ C.properMap
  openImmersion := inferInstance
  quasiCompact := sorry
  proper := sorry
  factorisation := by rw [← Category.assoc, Scheme.Hom.toImage_imageι, C.factorisation]

/-- The refinement map `Ȳ₀ ⟶ Ȳ` from the image compactification, through the native
factorisation `toImage ≫ imageι = j`. -/
def imageHom (C : Compactification f) : C.image ⟶ C where
  map := C.open.imageι
  open_comm := Scheme.Hom.toImage_imageι _
  base_comm := rfl

/-- The image refinement is scheme-theoretically dense. -/
theorem image_dense (C : Compactification f) : IsSchemeTheoreticallyDominant C.image.open := by
  sorry

/-- The image refinement map is strict. -/
theorem imageHom_strict (C : Compactification f) : Hom.strict C.imageHom := by
  sorry

/-! #### Base change -/

/-- Base change of compactifications along a cartesian square `Y' ⟶ Y`, `f' : Y' ⟶ X'`,
`f`, `g : X' ⟶ X`: the ambient is `Ȳ ×_X X'`, the open immersion is induced by `j`, and the
proper map is the second projection. -/
def ofIsPullback {Y' X' : Scheme.{u}} {f' : Y' ⟶ X'} {g' : Y' ⟶ Y} {g : X' ⟶ X}
    (sq : IsPullback g' f' f g) : Compactification f ⥤ Compactification f' where
  obj C :=
    { ambient := pullback C.properMap g
      «open» := pullback.lift (g' ≫ C.open) f' (by rw [Category.assoc, C.factorisation, sq.w])
      properMap := pullback.snd C.properMap g
      openImmersion := sorry
      quasiCompact := sorry
      proper := inferInstance
      factorisation := pullback.lift_snd _ _ _ }
  map {C D} a :=
    { map := pullback.map C.properMap g D.properMap g a.map (𝟙 _) (𝟙 _) (by simp) (by simp)
      open_comm := sorry
      base_comm := sorry }
  map_id _ := sorry
  map_comp _ _ := sorry

/-- API `Compactification.baseChange`: the base-change functor along `g : X' ⟶ X`, given by
Mathlib's pullback square of `f` and `g`. -/
def baseChange {X' : Scheme.{u}} (g : X' ⟶ X) :
    Compactification f ⥤ Compactification (pullback.snd f g) :=
  ofIsPullback (IsPullback.of_hasPullback f g)

/-- Change of the source along an isomorphism `e : Y' ≅ Y` over `X`: the ambient and the proper
map are unchanged and the open immersion becomes `e.hom ≫ j`. -/
def transport {Y' : Scheme.{u}} {f' : Y' ⟶ X} (e : Y' ≅ Y) (he : e.hom ≫ f = f') :
    Compactification f ⥤ Compactification f' where
  obj C :=
    { ambient := C.ambient
      «open» := e.hom ≫ C.open
      properMap := C.properMap
      openImmersion := inferInstance
      quasiCompact := inferInstance
      proper := inferInstance
      factorisation := by rw [Category.assoc, C.factorisation, he] }
  map {C D} a :=
    { map := a.map
      open_comm := by dsimp only; rw [Category.assoc, a.open_comm]
      base_comm := a.base_comm }

/-- API `Compactification.baseChange`, identity coherence: base change along `𝟙 X` is the
transport along the canonical isomorphism `Y ×_X X ≅ Y`. -/
theorem baseChange_id :
    Nonempty (baseChange (f := f) (𝟙 X) ≅
      transport (asIso (pullback.fst f (𝟙 X))) (by simp [pullback.condition])) := by
  sorry

/-- API `Compactification.baseChange`, composition coherence: base change along `g` and then
along `g'` is base change along `g' ≫ g`, transported along the canonical isomorphism of
iterated pullbacks. -/
theorem baseChange_comp {X' X'' : Scheme.{u}} (g : X' ⟶ X) (g' : X'' ⟶ X') :
    Nonempty (baseChange (f := f) g ⋙ baseChange g' ≅
      baseChange (g' ≫ g) ⋙ transport (pullbackLeftPullbackSndIso f g g') (by simp)) := by
  sorry

/-- The ambient of the base change is the pullback of the ambient, and its open immersion lies
over the original one. -/
theorem baseChange_open {X' : Scheme.{u}} (g : X' ⟶ X) (C : Compactification f) :
    ((baseChange g).obj C).open ≫ pullback.fst C.properMap g = pullback.fst f g ≫ C.open :=
  pullback.lift_fst _ _ _

/-- API `Compactification.Hom.strict_baseChange` (Zavyalov Remark 2.1.3): base change
preserves strict morphisms. -/
theorem Hom.strict_baseChange {C D : Compactification f} (h : C ⟶ D) {X' : Scheme.{u}}
    (g : X' ⟶ X) (hh : Hom.strict h) : Hom.strict ((baseChange g).map h) := by
  sorry

/-- Base change along a cartesian square preserves strict morphisms. -/
theorem Hom.strict_ofIsPullback {Y' X' : Scheme.{u}} {f' : Y' ⟶ X'} {g' : Y' ⟶ Y} {g : X' ⟶ X}
    (sq : IsPullback g' f' f g) {C D : Compactification f} (h : C ⟶ D) (hh : Hom.strict h) :
    Hom.strict ((ofIsPullback sq).map h) := by
  sorry

/- Test `Compactification.Hom.baseChange` (compatibility): for a strict morphism, the inverse
image under its base change of the base-changed open is exactly the inverse image of `j'(Y)`
under the first projection, i.e. the pulled-back `Y`. -/
example {C D : Compactification f} (h : C ⟶ D) {X' : Scheme.{u}} (g : X' ⟶ X)
    (hh : Hom.strict h) :
    ((baseChange g).map h).map ⁻¹' Set.range ((baseChange g).obj D).open =
      pullback.fst C.properMap g ⁻¹' Set.range C.open := by
  sorry

end Compactification

/-! ### L2/fp-compactification: Finitely presented compactification -/

/-- `L2/fp-compactification` (Zavyalov Definition 2.1.1): the property of a compactification
that its proper map is locally of finite presentation; with properness this makes it finitely
presented. -/
def fpProperty {Y X : Scheme.{u}} (f : Y ⟶ X) : ObjectProperty (Compactification f) :=
  fun C => LocallyOfFinitePresentation C.properMap

/-- `L2/fp-compactification`: the full subcategory `Comp_fp(f)` of finitely presented
compactifications. -/
abbrev FPCompactification {Y X : Scheme.{u}} (f : Y ⟶ X) : Type (u + 1) :=
  (fpProperty f).FullSubcategory

namespace FPCompactification

variable {Y X : Scheme.{u}} {f : Y ⟶ X}

/-- API `FPCompactification.mk`: a compactification together with a witness that its proper
map is locally of finite presentation. -/
def mk (C : Compactification f) (h : LocallyOfFinitePresentation C.properMap) :
    FPCompactification f :=
  ⟨C, h⟩

/-- API `FPCompactification.forget`: the underlying compactification, with the same ambient. -/
def forget (C : FPCompactification f) : Compactification f := C.obj

/-- API `FPCompactification.finitePresentation`: the proper map of an fp compactification is
quasi-compact, quasi-separated and locally of finite presentation. -/
theorem finitePresentation (C : FPCompactification f) :
    QuasiCompact C.obj.properMap ∧ QuasiSeparated C.obj.properMap ∧
      LocallyOfFinitePresentation C.obj.properMap :=
  ⟨inferInstance, inferInstance, C.property⟩

/-- API `FPCompactification.inclusion`: the inclusion `Comp_fp(f) ⊂ Comp(f)`. -/
abbrev inclusion : FPCompactification f ⥤ Compactification f :=
  (fpProperty f).ι

/-- The inclusion of fp compactifications is fully faithful. -/
def inclusionFullyFaithful : (inclusion (f := f)).FullyFaithful :=
  (fpProperty f).fullyFaithfulι

/-- Base change of fp compactifications along a cartesian square. -/
def ofIsPullback {Y' X' : Scheme.{u}} {f' : Y' ⟶ X'} {g' : Y' ⟶ Y} {g : X' ⟶ X}
    (sq : IsPullback g' f' f g) : FPCompactification f ⥤ FPCompactification f' :=
  (fpProperty f').lift (inclusion ⋙ Compactification.ofIsPullback sq) (fun C => by
    have : LocallyOfFinitePresentation C.obj.properMap := C.property
    exact (inferInstance : LocallyOfFinitePresentation (pullback.snd C.obj.properMap g)))

/-- API `FPCompactification.baseChange`: base change of fp compactifications along any
`g : X' ⟶ X`, lifting `Compactification.baseChange`. -/
def baseChange {X' : Scheme.{u}} (g : X' ⟶ X) :
    FPCompactification f ⥤ FPCompactification (pullback.snd f g) :=
  ofIsPullback (IsPullback.of_hasPullback f g)

/-- Base change of fp compactifications is the base change of the underlying
compactifications. -/
def baseChangeCompInclusion {X' : Scheme.{u}} (g : X' ⟶ X) :
    baseChange (f := f) g ⋙ inclusion ≅ inclusion ⋙ Compactification.baseChange g :=
  Iso.refl _

/-- Change of the source of an fp compactification along an isomorphism over `X`. -/
def transport {Y' : Scheme.{u}} {f' : Y' ⟶ X} (e : Y' ≅ Y) (he : e.hom ≫ f = f') :
    FPCompactification f ⥤ FPCompactification f' :=
  (fpProperty f').lift (inclusion ⋙ Compactification.transport e he) (fun C => C.property)

/-! #### Tests for `L2/fp-compactification` -/

/- Test `FPCompactification.proper` (degenerate): for a proper finitely presented map the
identity compactification is finitely presented. -/
example (f : Y ⟶ X) [IsProper f] [LocallyOfFinitePresentation f] :
    fpProperty f (Compactification.ofProper f) :=
  inferInstanceAs (LocallyOfFinitePresentation f)

/- Test `FPCompactification.empty` (degenerate): for empty `Y` the map is proper and the
identity compactification is finitely presented. -/
example [IsEmpty Y] (f : Y ⟶ X) :
    ∃ _ : IsProper f, fpProperty f (Compactification.ofProper f) := by
  sorry

/- Test `FPCompactification.rejectFiniteType` (non-example): for a ring `A` and an ideal `J`
that is not finitely generated, the closed immersion `Spec (A/J) ⟶ Spec A` is proper but its
identity compactification is not finitely presented. -/
example {A : Type u} [CommRing A] (J : Ideal A) (hJ : ¬ J.FG)
    [IsProper (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))] :
    ¬ fpProperty _ (Compactification.ofProper (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk J)))) := by
  sorry

/- Test `Compactification.fpForget` (compatibility): the inclusion of fp compactifications
keeps the underlying compactification, the ambient maps and their composites. -/
example {C D E : FPCompactification f} (g : C ⟶ D) (h : D ⟶ E) :
    inclusion.obj C = C.obj ∧ (inclusion.map g).map = g.hom.map ∧
      (inclusion.map (g ≫ h)).map = (inclusion.map g).map ≫ (inclusion.map h).map :=
  ⟨rfl, rfl, rfl⟩

section ProjectiveLine

attribute [local instance] MvPolynomial.gradedAlgebra

variable (k : Type u) [Field k]

/-- The grading of `k[X₀, X₁]` by total degree; its `Proj` is the projective line `ℙ¹_k`, over
`Spec` of the degree-zero part, which is `k`. -/
abbrev projectiveLineGrading : ℕ → Submodule k (MvPolynomial (Fin 2) k) :=
  MvPolynomial.homogeneousSubmodule (Fin 2) k

/-- The standard chart `𝔸¹_k = D₊(X₀) ⊂ ℙ¹_k`. -/
def projectiveLineChart :
    Spec (.of (HomogeneousLocalization.Away (projectiveLineGrading k) (MvPolynomial.X 0))) ⟶
      Proj (projectiveLineGrading k) :=
  Proj.awayι _ (MvPolynomial.X 0) (MvPolynomial.isHomogeneous_X k 0) one_pos

/-- The finitely presented compactification `𝔸¹_k ⊂ ℙ¹_k` of the affine line. -/
def projectiveLine :
    FPCompactification (projectiveLineChart k ≫ Proj.toSpecZero (projectiveLineGrading k)) :=
  mk { ambient := Proj (projectiveLineGrading k)
       «open» := projectiveLineChart k
       properMap := Proj.toSpecZero _
       openImmersion := sorry
       quasiCompact := sorry
       proper := sorry
       factorisation := rfl } sorry

/-- The point `Spec K ⟶ Spec k` of a field extension `K / k`, where the degree-zero part of
`k[X₀, X₁]` is identified with `k` by the constant coefficient. -/
def projectiveLineBasePoint (K : Type u) [Field K] [Algebra k K] :
    Spec (.of K) ⟶ Spec (.of (projectiveLineGrading k 0)) :=
  Spec.map (CommRingCat.ofHom ((algebraMap k K).comp (MvPolynomial.constantCoeff.comp
    (algebraMap (projectiveLineGrading k 0) (MvPolynomial (Fin 2) k)))))

/- Test `FPCompactification.basePoint` (computation): the base change of `𝔸¹_k ⊂ ℙ¹_k` to a
field extension `K` has as open immersion the base change of the standard chart, and its
ambient map `ℙ¹_K ⟶ Spec K` is proper and locally of finite presentation. -/
example (K : Type u) [Field K] [Algebra k K] :
    ((baseChange (projectiveLineBasePoint k K)).obj (projectiveLine k)).obj.open ≫
        pullback.fst (projectiveLine k).obj.properMap (projectiveLineBasePoint k K) =
      pullback.fst _ (projectiveLineBasePoint k K) ≫ projectiveLineChart k ∧
    IsProper ((baseChange (projectiveLineBasePoint k K)).obj (projectiveLine k)).obj.properMap ∧
    LocallyOfFinitePresentation
      ((baseChange (projectiveLineBasePoint k K)).obj (projectiveLine k)).obj.properMap := by
  sorry

end ProjectiveLine

end FPCompactification

/-! ### L2/nagata-factorisation-as-used-in-27-4: Nonnoetherian Nagata compactification -/

/-- `L2/nagata-factorisation-as-used-in-27-4` (Stacks Theorem 38.33.8, Tag 0F41): a separated
morphism of finite type to a quasi-compact quasi-separated scheme has a compactification.
Finite presentation is not assumed. -/
theorem nagata {Y X : Scheme.{u}} (f : Y ⟶ X) [CompactSpace X] [QuasiSeparatedSpace X]
    [IsSeparated f] [LocallyOfFiniteType f] [QuasiCompact f] :
    Nonempty (Compactification f) := by
  sorry

/-! ### L2/strict-from-dense: Strictness from a dense source -/

/-- `L2/strict-from-dense` (Boxer–Pilloni Lemma 2.1.4 and its proof; Stacks Lemma 38.32.1, last
assertion, Tag 0ATU): a morphism of compactifications whose source open `j'(Y)` is
topologically dense in `Ȳ'` is strict. Schematic density is not needed. -/
theorem strictFromDense {Y X : Scheme.{u}} {f : Y ⟶ X} {C D : Compactification f} (g : C ⟶ D)
    (hd : DenseRange C.open) : Compactification.Hom.strict g := by
  sorry

/-! ### L2/compactification-cofiltered: Cofiltered compactifications -/

/-- The compactifications in which `Y` is topologically dense. -/
def denseProperty {Y X : Scheme.{u}} (f : Y ⟶ X) : ObjectProperty (Compactification f) :=
  fun C => DenseRange C.open

/-- The compactifications in which `Y` is scheme-theoretically dense. -/
def schematicallyDenseProperty {Y X : Scheme.{u}} (f : Y ⟶ X) :
    ObjectProperty (Compactification f) :=
  fun C => IsSchemeTheoreticallyDominant C.open

section Cofiltered

variable {Y X : Scheme.{u}} (f : Y ⟶ X) [CompactSpace X] [QuasiSeparatedSpace X]

/-- `L2/compactification-cofiltered` (Stacks Lemma 38.32.1, Tag 0ATU): if `f` has a
compactification, the category of compactifications of `f` is cofiltered: it is nonempty, two
objects have a common refinement and a parallel pair is equalised by a refinement. -/
theorem compactificationCofiltered (h : Nonempty (Compactification f)) :
    IsCofiltered (Compactification f) := by
  sorry

/-- `L2/compactification-cofiltered` (Stacks Lemma 38.32.1, Tag 0ATU), common refinements: two
compactifications have a common scheme-theoretically dense refinement whose two refinement
maps are strict (the scheme-theoretic image of `Y` in the fibre product). -/
theorem compactification_strictRefinement (C D : Compactification f) :
    ∃ (E : Compactification f) (_ : schematicallyDenseProperty f E) (a : E ⟶ C) (b : E ⟶ D),
      Compactification.Hom.strict a ∧ Compactification.Hom.strict b := by
  sorry

/-- `L2/compactification-cofiltered` (Stacks Lemma 38.32.1, Tag 0ATU), equalisers: a parallel
pair of morphisms of compactifications is equalised by a strict refinement (the
scheme-theoretic closure of `Y` in the closed equaliser, which is proper over `X`). -/
theorem compactification_strictEqualiser {C D : Compactification f} (a b : C ⟶ D) :
    ∃ (E : Compactification f) (g : E ⟶ C), Compactification.Hom.strict g ∧ g ≫ a = g ≫ b := by
  sorry

/-- `L2/compactification-cofiltered` (Stacks Lemma 38.32.1, Tag 0ATU), initiality: if `f` has a
compactification, the full subcategory of compactifications in which `Y` is dense is initial. -/
theorem dense_initial (h : Nonempty (Compactification f)) : (denseProperty f).ι.Initial := by
  sorry

/-- `L2/compactification-cofiltered` (Stacks Lemma 38.32.1, Tag 0ATU), initiality: if `f` has a
compactification, the full subcategory of compactifications in which `Y` is
scheme-theoretically dense is initial, and every compactification receives a strict map from
one of them. -/
theorem schematicallyDense_initial (h : Nonempty (Compactification f)) :
    (schematicallyDenseProperty f).ι.Initial ∧
      ∀ C : Compactification f, ∃ (E : Compactification f) (_ : schematicallyDenseProperty f E)
        (g : E ⟶ C), Compactification.Hom.strict g := by
  sorry

end Cofiltered

/-! ### L2/fp-compactification-limit: Compactifications over inverse limits -/

section FPLimit

variable {I : Type u} [Category.{u} I] [IsCofiltered I] (D : I ⥤ Scheme.{u})
  (c : Cone D) {i₀ : I} (t : IsTerminal i₀) {X₀ : Scheme.{u}} (f₀ : X₀ ⟶ D.obj i₀)

/-- The base change `X₀ ×_{D i₀} D i ⟶ D i` of `f₀ : X₀ ⟶ D i₀` to a stage `i`, along the
transition to the least index `i₀`. -/
abbrev fpStage (i : I) : pullback f₀ (D.map (t.from i)) ⟶ D.obj i :=
  pullback.snd f₀ (D.map (t.from i))

/-- The base change `X₀ ×_{D i₀} lim D ⟶ lim D` of `f₀` to the limit. -/
abbrev fpLimit : pullback f₀ (c.π.app i₀) ⟶ c.pt :=
  pullback.snd f₀ (c.π.app i₀)

/-- The cartesian square relating the base changes of `f₀` to the stages `i` and `j ⟶ i`. -/
theorem fpStage_isPullback {i j : I} (g : j ⟶ i) :
    IsPullback (pullback.map f₀ (D.map (t.from j)) f₀ (D.map (t.from i)) (𝟙 _) (D.map g) (𝟙 _)
      (by simp) (by rw [Category.comp_id, ← D.map_comp]; exact congrArg D.map (t.hom_ext _ _)))
      (fpStage D t f₀ j) (fpStage D t f₀ i) (D.map g) := by
  sorry

/-- The cartesian square relating the base changes of `f₀` to the stage `i` and to the limit. -/
theorem fpLimit_isPullback (i : I) :
    IsPullback (pullback.map f₀ (c.π.app i₀) f₀ (D.map (t.from i)) (𝟙 _) (c.π.app i) (𝟙 _)
      (by simp) (by rw [Category.comp_id, c.w]))
      (fpLimit D c f₀) (fpStage D t f₀ i) (c.π.app i) := by
  sorry

/-- The transition functor `Comp_fp(X₀ ×_{D i₀} D i / D i) ⥤ Comp_fp(X₀ ×_{D i₀} D j / D j)` for
`g : j ⟶ i`, by base change. -/
def fpStageTransition {i j : I} (g : j ⟶ i) :
    FPCompactification (fpStage D t f₀ i) ⥤ FPCompactification (fpStage D t f₀ j) :=
  FPCompactification.ofIsPullback (fpStage_isPullback D t f₀ g)

/-- The functor `Comp_fp(X₀ ×_{D i₀} D i / D i) ⥤ Comp_fp(X₀ ×_{D i₀} lim D / lim D)`, by base
change to the limit. -/
def fpToLimit (i : I) :
    FPCompactification (fpStage D t f₀ i) ⥤ FPCompactification (fpLimit D c f₀) :=
  FPCompactification.ofIsPullback (fpLimit_isPullback D c t f₀ i)

/-- The canonical isomorphism between base change to a stage `j ⟶ i` followed by base change to
the limit, and base change from `i` to the limit (iterated fibre products). -/
def fpTransitionLimitIso {i j : I} (g : j ⟶ i) :
    fpStageTransition D t f₀ g ⋙ fpToLimit D c t f₀ j ≅ fpToLimit D c t f₀ i :=
  sorry

/-- `L2/fp-compactification-limit` (Zavyalov Lemma 2.1.4 and its proof, using Stacks Tags 01ZM,
0EUU, 081F and 01Z4): for a cofiltered diagram of qcqs schemes with affine transitions, a least
index `i₀` and a separated finitely presented `f₀ : X₀ ⟶ D i₀`, the functor
`colimᵢ Comp_fp(X₀ ×_{D i₀} D i / D i) ⥤ Comp_fp(X₀ ×_{D i₀} lim D / lim D)` is an equivalence:
every fp compactification at the limit is isomorphic to the base change of one at some stage;
maps at the limit descend to a later stage; maps that agree at the limit agree at a later stage.
Base change sends strict maps to strict maps, and a map that is strict at the limit is strict
at a later stage. -/
theorem fpCompactificationLimit [∀ {i j : I} (g : i ⟶ j), IsAffineHom (D.map g)]
    [∀ i, CompactSpace (D.obj i)] [∀ i, QuasiSeparatedSpace (D.obj i)] (hc : IsLimit c)
    [IsSeparated f₀] [LocallyOfFinitePresentation f₀] [QuasiCompact f₀] :
    (∀ E : FPCompactification (fpLimit D c f₀), ∃ (i : I)
        (C : FPCompactification (fpStage D t f₀ i)), Nonempty ((fpToLimit D c t f₀ i).obj C ≅ E)) ∧
    (∀ (i : I) (C C' : FPCompactification (fpStage D t f₀ i))
        (φ : (fpToLimit D c t f₀ i).obj C ⟶ (fpToLimit D c t f₀ i).obj C'),
        ∃ (j : I) (g : j ⟶ i)
          (ψ : (fpStageTransition D t f₀ g).obj C ⟶ (fpStageTransition D t f₀ g).obj C'),
          (fpToLimit D c t f₀ j).map ψ = ((fpTransitionLimitIso D c t f₀ g).app C).hom ≫ φ ≫
            ((fpTransitionLimitIso D c t f₀ g).app C').inv) ∧
    (∀ (i : I) (C C' : FPCompactification (fpStage D t f₀ i)) (a b : C ⟶ C'),
        (fpToLimit D c t f₀ i).map a = (fpToLimit D c t f₀ i).map b →
        ∃ (j : I) (g : j ⟶ i), (fpStageTransition D t f₀ g).map a =
          (fpStageTransition D t f₀ g).map b) ∧
    (∀ (i : I) (C C' : FPCompactification (fpStage D t f₀ i)) (a : C ⟶ C'),
        Compactification.Hom.strict a.hom →
        Compactification.Hom.strict ((fpToLimit D c t f₀ i).map a).hom) ∧
    (∀ (i : I) (C C' : FPCompactification (fpStage D t f₀ i)) (a : C ⟶ C'),
        Compactification.Hom.strict ((fpToLimit D c t f₀ i).map a).hom →
        ∃ (j : I) (g : j ⟶ i), Compactification.Hom.strict ((fpStageTransition D t f₀ g).map a).hom) := by
  sorry

end FPLimit

/-! ### L2/fp-strict-cofiltered: Strict cofilteredness of fp compactifications -/

/-- `L2/fp-strict-cofiltered` (Zavyalov Corollary 2.1.5 and its proof): for a separated finitely
presented `f` over a qcqs base, fp compactifications exist; two of them have a common fp
refinement with strict refinement maps; and a parallel pair is equalised by a strict map from
an fp compactification. No noetherianity of `X` is assumed. -/
theorem fpStrictCofiltered {Y X : Scheme.{u}} (f : Y ⟶ X) [CompactSpace X]
    [QuasiSeparatedSpace X] [IsSeparated f] [LocallyOfFinitePresentation f] [QuasiCompact f] :
    Nonempty (FPCompactification f) ∧
      (∀ C D : FPCompactification f, ∃ (E : FPCompactification f) (a : E ⟶ C) (b : E ⟶ D),
        Compactification.Hom.strict a.hom ∧ Compactification.Hom.strict b.hom) ∧
      (∀ {C D : FPCompactification f} (a b : C ⟶ D), ∃ (E : FPCompactification f) (g : E ⟶ C),
        Compactification.Hom.strict g.hom ∧ g ≫ a = g ≫ b) := by
  sorry

/-- `L2/fp-strict-cofiltered` (Zavyalov Corollary 2.1.5): the category of fp compactifications of
a separated finitely presented map over a qcqs base is cofiltered. -/
theorem fpCompactification_isCofiltered {Y X : Scheme.{u}} (f : Y ⟶ X) [CompactSpace X]
    [QuasiSeparatedSpace X] [IsSeparated f] [LocallyOfFinitePresentation f] [QuasiCompact f] :
    IsCofiltered (FPCompactification f) := by
  sorry

/-! ### L2/cartier-boundary-cofinal: Cartier-boundary compactifications -/

/-- An ideal sheaf is the ideal sheaf of an effective Cartier divisor if every point has an affine
open neighbourhood on which the ideal is generated by a single non-zero-divisor. -/
def IsEffectiveCartierIdeal {Z : Scheme.{u}} (I : Z.IdealSheafData) : Prop :=
  ∀ z : Z, ∃ U : Z.affineOpens, z ∈ (U : Z.Opens) ∧
    ∃ s ∈ nonZeroDivisors Γ(Z, U), I.ideal U = Ideal.span {s}

/-- The compactifications whose boundary `Ȳ ∖ j(Y)` is the support of an effective Cartier
divisor. The empty boundary is allowed, as the support of the unit ideal. -/
def cartierBoundaryProperty {Y X : Scheme.{u}} (f : Y ⟶ X) :
    ObjectProperty (Compactification f) :=
  fun C => ∃ I : C.ambient.IdealSheafData, IsEffectiveCartierIdeal I ∧
    (I.support : Set C.ambient) = (Set.range C.open)ᶜ

/-- `L2/cartier-boundary-cofinal` (Boxer–Pilloni Lemma 2.1.5, with the blow-up taken on the
compactification `Ȳ` rather than on `Y`): over a noetherian affine base, for separated
finite-type `f`, the compactifications whose boundary supports an effective Cartier divisor form
an initial full subcategory, and every compactification receives a strict map from one of them
(the blow-up of `Ȳ` in an ideal cutting out the boundary). -/
theorem cartierBoundary_initial {Y X : Scheme.{u}} (f : Y ⟶ X) [IsAffine X] [IsNoetherian X]
    [IsSeparated f] [LocallyOfFiniteType f] [QuasiCompact f] :
    (cartierBoundaryProperty f).ι.Initial ∧
      ∀ C : Compactification f, ∃ (E : Compactification f) (_ : cartierBoundaryProperty f E)
        (g : E ⟶ C), Compactification.Hom.strict g := by
  sorry

/-! ### L2/vector-bundle-extension-cofinal: Vector-bundle extension compactifications -/

/-- A finite locally free `𝒪`-module: locally free (Mathlib's `SheafOfModules.IsLocallyFree`) and
of finite type. Its rank is locally constant and need not be constant. -/
def IsFiniteLocallyFree {Z : Scheme.{u}} (M : Z.Modules) : Prop :=
  SheafOfModules.IsLocallyFree M ∧ SheafOfModules.IsFiniteType M

/-- The compactifications to which a module `F` on `Y` extends as a finite locally free module:
there is a finite locally free `F'` on `Ȳ` whose restriction along `j` is isomorphic to `F`. -/
def bundleExtensionProperty {Y X : Scheme.{u}} {f : Y ⟶ X} (F : Y.Modules) :
    ObjectProperty (Compactification f) :=
  fun C => ∃ F' : C.ambient.Modules, IsFiniteLocallyFree F' ∧
    Nonempty ((Scheme.Modules.pullback C.open).obj F' ≅ F)

/-- `L2/vector-bundle-extension-cofinal` (Boxer–Pilloni Lemma 2.1.6, with the proof corrected by
Stacks Lemma 31.36.3, Tag 0ESN, applied to the closures of the constant-rank pieces, and Stacks
Lemma 28.23.5, Tag 0G41): over a noetherian affine base, for separated finite-type `f` and a
finite locally free module `F` on `Y` of possibly non-constant rank, the compactifications to
which `F` extends as a finite locally free module form an initial full subcategory, and every
compactification receives a strict map from one of them. -/
theorem vectorBundleExtension_initial {Y X : Scheme.{u}} (f : Y ⟶ X) [IsAffine X]
    [IsNoetherian X] [IsSeparated f] [LocallyOfFiniteType f] [QuasiCompact f] (F : Y.Modules)
    (hF : IsFiniteLocallyFree F) :
    (bundleExtensionProperty (f := f) F).ι.Initial ∧
      ∀ C : Compactification f, ∃ (E : Compactification f) (_ : bundleExtensionProperty F E)
        (g : E ⟶ C), Compactification.Hom.strict g := by
  sorry

/-! ### L2/etale-cohomology-continuity: Higher étale cohomology continuity -/

/-- Abelian sheaves on the small étale site form a Grothendieck abelian category (the site is
essentially small), so their cohomology `CategoryTheory.Sheaf.H` is defined. -/
instance etaleSheaf_isGrothendieckAbelian (X : Scheme.{u}) :
    IsGrothendieckAbelian.{u + 1} (Sheaf X.smallEtaleTopology AddCommGrpCat.{u + 1}) := by
  have : EssentiallySmall.{u + 1} X.Etale := inferInstance
  exact Sheaf.isGrothendieckAbelian_of_essentiallySmall X.smallEtaleTopology AddCommGrpCat.{u + 1}

/-- Inverse image of abelian étale sheaves along a morphism of schemes.
Owner: `SchemeAndStackFoundations:SF.2`. -/
def etaleInverseImage {X Y : Scheme.{u}} (f : Y ⟶ X) :
    Sheaf X.smallEtaleTopology AddCommGrpCat.{u + 1} ⥤
      Sheaf Y.smallEtaleTopology AddCommGrpCat.{u + 1} := sorry

/-- The pullback map on étale cohomology `Hᵠ(X, F) → Hᵠ(Y, f⁻¹F)`.
Owner: `SchemeAndStackFoundations:SF.2`. -/
def etaleCohomologyPullback {X Y : Scheme.{u}} (f : Y ⟶ X)
    (F : Sheaf X.smallEtaleTopology AddCommGrpCat.{u + 1}) (q : ℕ) :
    F.H q →+ ((etaleInverseImage f).obj F).H q := sorry

/-- The composition isomorphism `(f ≫ g)⁻¹ ≅ f⁻¹ ∘ g⁻¹` of inverse images of abelian étale
sheaves. Owner: `SchemeAndStackFoundations:SF.2`. -/
def etaleInverseImageComp {X Y Z : Scheme.{u}} (f : Z ⟶ Y) (g : Y ⟶ X) :
    etaleInverseImage (f ≫ g) ≅ etaleInverseImage g ⋙ etaleInverseImage f := sorry

section EtaleContinuity

variable {I : Type u} [Category.{u} I] [IsCofiltered I] (D : I ⥤ Scheme.{u})
  [∀ {i j : I} (g : i ⟶ j), IsAffineHom (D.map g)] [∀ i, CompactSpace (D.obj i)]
  [∀ i, QuasiSeparatedSpace (D.obj i)] (c : Cone D) (hc : IsLimit c)

include hc in
/-- `L2/etale-cohomology-continuity` (Stacks Theorem 59.51.3, Tag 09YQ): let `Fᵢ` be abelian
étale sheaves on the stages with transition maps `t g : (D.map g)⁻¹ Fᵢ → Fⱼ` for `g : j ⟶ i`, and
let `F` on the limit be a colimit of the pulled-back sheaves `πᵢ⁻¹Fᵢ` (the diagram `G` with
identifications `e`). Then for every `q` the canonical map `colimᵢ Hᵠ(Xᵢ, Fᵢ) → Hᵠ(X, F)` is
bijective: every class at the limit comes from a stage, and a class at a stage that vanishes at
the limit vanishes at a later stage.
The transition maps satisfy the composition law (`ht`), and `G` is the diagram they induce on
the limit (`hG`). -/
theorem etaleCohomologyContinuity
    (F : ∀ i, Sheaf (D.obj i).smallEtaleTopology AddCommGrpCat.{u + 1})
    (t : ∀ {i j : I} (g : j ⟶ i), (etaleInverseImage (D.map g)).obj (F i) ⟶ F j)
    (ht : ∀ {i j k : I} (g : j ⟶ i) (h : k ⟶ j),
      t (h ≫ g) = eqToHom (by rw [D.map_comp]) ≫
        (etaleInverseImageComp (D.map h) (D.map g)).hom.app (F i) ≫
          (etaleInverseImage (D.map h)).map (t g) ≫ t h)
    (G : Iᵒᵖ ⥤ Sheaf c.pt.smallEtaleTopology AddCommGrpCat.{u + 1})
    (e : ∀ i, G.obj (Opposite.op i) ≅ (etaleInverseImage (c.π.app i)).obj (F i))
    (hG : ∀ {i j : I} (g : j ⟶ i), G.map g.op = (e i).hom ≫ eqToHom (by rw [c.w g]) ≫
        (etaleInverseImageComp (c.π.app j) (D.map g)).hom.app (F i) ≫
          (etaleInverseImage (c.π.app j)).map (t g) ≫ (e j).inv)
    (cG : Cocone G) (hcG : IsColimit cG) (q : ℕ) :
    (∀ x : cG.pt.H q, ∃ (i : I) (y : (F i).H q),
      Sheaf.H.map ((e i).inv ≫ cG.ι.app (Opposite.op i)) q
        (etaleCohomologyPullback (c.π.app i) (F i) q y) = x) ∧
    (∀ (i : I) (y : (F i).H q),
      Sheaf.H.map ((e i).inv ≫ cG.ι.app (Opposite.op i)) q
        (etaleCohomologyPullback (c.π.app i) (F i) q y) = 0 →
      ∃ (j : I) (g : j ⟶ i), Sheaf.H.map (t g) q (etaleCohomologyPullback (D.map g) (F i) q y) = 0) :=
  sorry

end EtaleContinuity

/-! ### L2/constructible-Hom-continuity: Continuity of constructible derived Hom -/

/-- The bounded-above étale complexes with constructible cohomology `D⁻_c(X_ét, Λ)`, with their
inclusion into `D(X_ét, Λ)`. Owner: `SchemeAndStackFoundations:SF.2`. -/
def SchemeEtaleConstructibleBoundedAbove (X : Scheme.{u}) (Λ : Type u) [CommRing Λ] :
    Type (u + 1) := sorry

instance (X : Scheme.{u}) (Λ : Type u) [CommRing Λ] :
    Category.{u} (SchemeEtaleConstructibleBoundedAbove X Λ) := sorry

/-- The inclusion `D⁻_c(X_ét, Λ) ⊂ D(X_ét, Λ)`. -/
def SchemeEtaleConstructibleBoundedAbove.ι (X : Scheme.{u}) (Λ : Type u) [CommRing Λ] :
    SchemeEtaleConstructibleBoundedAbove X Λ ⥤ SchemeEtaleOrdinary X Λ := sorry

/-- The shift on `D(X_ét, Λ)`. Owner: `SchemeAndStackFoundations:SF.2`. -/
instance (X : Scheme.{u}) (Λ : Type u) [CommRing Λ] : HasShift (SchemeEtaleOrdinary X Λ) ℤ :=
  sorry

/-- Pullback on `D(X_ét, Λ)`. Owner: `SchemeAndStackFoundations:SF.2`. -/
def SchemeEtaleOrdinary.pullback {X Y : Scheme.{u}} (f : Y ⟶ X) (Λ : Type u) [CommRing Λ] :
    SchemeEtaleOrdinary X Λ ⥤ SchemeEtaleOrdinary Y Λ := sorry

/-- Pullback preserves `D⁻_c`. Owner: `SchemeAndStackFoundations:SF.2`. -/
def SchemeEtaleConstructibleBoundedAbove.pullback {X Y : Scheme.{u}} (f : Y ⟶ X) (Λ : Type u)
    [CommRing Λ] : SchemeEtaleConstructibleBoundedAbove X Λ ⥤
      SchemeEtaleConstructibleBoundedAbove Y Λ := sorry

/-- Pullback preserves `D⁺`. Owner: `SchemeAndStackFoundations:SF.2`. -/
def SchemeEtaleBoundedBelow.pullback {X Y : Scheme.{u}} (f : Y ⟶ X) (Λ : Type u) [CommRing Λ] :
    SchemeEtaleBoundedBelow X Λ ⥤ SchemeEtaleBoundedBelow Y Λ := sorry

section HomContinuity

variable {Z₀ : Scheme.{u}} {Λ : Type u} [CommRing Λ]
  (F₀ : SchemeEtaleConstructibleBoundedAbove Z₀ Λ) (G₀ : SchemeEtaleBoundedBelow Z₀ Λ) (k : ℤ)

/-- Maps `f*F₀ → f*G₀[k]` in `D(Z_ét, Λ)` for a map `f : Z → Z₀`. -/
abbrev pulledBackHom {Z : Scheme.{u}} (f : Z ⟶ Z₀) : Type u :=
  (SchemeEtaleConstructibleBoundedAbove.ι Z Λ).obj
      ((SchemeEtaleConstructibleBoundedAbove.pullback f Λ).obj F₀) ⟶
    (shiftFunctor (SchemeEtaleOrdinary Z Λ) k).obj
      ((SchemeEtaleBoundedBelow.ι Z Λ).obj ((SchemeEtaleBoundedBelow.pullback f Λ).obj G₀))

/-- Transport of such maps along `h : Z' → Z` with `h ≫ f = f'`, through the canonical
identification `h* f* ≅ f'*`. Owner of the identification: `SchemeAndStackFoundations:SF.2`. -/
def pulledBackHom.transport {Z Z' : Scheme.{u}} (h : Z' ⟶ Z) {f : Z ⟶ Z₀} {f' : Z' ⟶ Z₀}
    (w : h ≫ f = f') : pulledBackHom F₀ G₀ k f → pulledBackHom F₀ G₀ k f' := sorry

end HomContinuity

/-- `L2/constructible-Hom-continuity` (Abe §1.4, the statement on maps inside the proof of the
continuity lemma): for a small cofiltered system of qcqs schemes with affine transitions, a
noetherian `Λ`, `F₀ ∈ D⁻_c` and `G₀ ∈ D⁺` at a stage `i₀`, the map
`colimᵢ Hom(Fᵢ, Gᵢ[k]) → Hom(F, G[k])` is bijective for every shift `k`. No integer is assumed
invertible on the schemes. -/
theorem constructibleHomContinuity {I : Type u} [Category.{u} I] [IsCofiltered I]
    (D : I ⥤ Scheme.{u}) [∀ {i j : I} (g : i ⟶ j), IsAffineHom (D.map g)]
    [∀ i, CompactSpace (D.obj i)] [∀ i, QuasiSeparatedSpace (D.obj i)] (c : Cone D)
    (hc : IsLimit c) {Λ : Type u} [CommRing Λ] [IsNoetherianRing Λ] (i₀ : I)
    (F₀ : SchemeEtaleConstructibleBoundedAbove (D.obj i₀) Λ)
    (G₀ : SchemeEtaleBoundedBelow (D.obj i₀) Λ) (k : ℤ) :
    (∀ φ : pulledBackHom F₀ G₀ k (c.π.app i₀), ∃ (i : I) (g : i ⟶ i₀)
      (ψ : pulledBackHom F₀ G₀ k (D.map g)),
        pulledBackHom.transport F₀ G₀ k (c.π.app i) (c.w g) ψ = φ) ∧
    (∀ (i : I) (g : i ⟶ i₀) (ψ ψ' : pulledBackHom F₀ G₀ k (D.map g)),
      pulledBackHom.transport F₀ G₀ k (c.π.app i) (c.w g) ψ =
        pulledBackHom.transport F₀ G₀ k (c.π.app i) (c.w g) ψ' →
      ∃ (j : I) (h : j ⟶ i),
        pulledBackHom.transport F₀ G₀ k (D.map h) (D.map_comp h g).symm ψ =
          pulledBackHom.transport F₀ G₀ k (D.map h) (D.map_comp h g).symm ψ') :=
  sorry

/-! ### L2/constructible-derived-continuity: Continuity of bounded constructible categories -/

/-- Pullback on bounded constructible complexes. Owner: `SchemeAndStackFoundations:SF.2`. -/
def SchemeConstructible.pullback {X Y : Scheme.{u}} (f : Y ⟶ X) (Λ : Type u) [CommRing Λ] :
    SchemeConstructible X Λ ⥤ SchemeConstructible Y Λ := sorry

/-- Transport of maps between pulled-back bounded constructible complexes along `h` with
`h ≫ f = f'`. Owner of the identification `h* f* ≅ f'*`: `SchemeAndStackFoundations:SF.2`. -/
def SchemeConstructible.homTransport {Z₀ Z Z' : Scheme.{u}} {Λ : Type u} [CommRing Λ]
    (A B : SchemeConstructible Z₀ Λ) (h : Z' ⟶ Z) {f : Z ⟶ Z₀} {f' : Z' ⟶ Z₀}
    (w : h ≫ f = f') :
    ((SchemeConstructible.pullback f Λ).obj A ⟶ (SchemeConstructible.pullback f Λ).obj B) →
      ((SchemeConstructible.pullback f' Λ).obj A ⟶ (SchemeConstructible.pullback f' Λ).obj B) :=
  sorry

/-- `L2/constructible-derived-continuity` (Abe §1.4, the continuity lemma): for a small cofiltered
system of qcqs schemes with affine transitions and limit `X` and a noetherian `Λ`, the functor
`2-colimᵢ Dᵇ_c(Xᵢ, Λ) → Dᵇ_c(X, Λ)` is an equivalence: every bounded constructible complex on `X`
descends to a stage, maps descend, and maps that agree on `X` agree at a later stage. No integer
is assumed invertible on the schemes. -/
theorem constructibleDerivedContinuity {I : Type u} [Category.{u} I] [IsCofiltered I]
    (D : I ⥤ Scheme.{u}) [∀ {i j : I} (g : i ⟶ j), IsAffineHom (D.map g)]
    [∀ i, CompactSpace (D.obj i)] [∀ i, QuasiSeparatedSpace (D.obj i)] (c : Cone D)
    (hc : IsLimit c) (Λ : Type u) [CommRing Λ] [IsNoetherianRing Λ] :
    (∀ A : SchemeConstructible c.pt Λ, ∃ (i : I) (Aᵢ : SchemeConstructible (D.obj i) Λ),
      Nonempty ((SchemeConstructible.pullback (c.π.app i) Λ).obj Aᵢ ≅ A)) ∧
    (∀ (i₀ : I) (A B : SchemeConstructible (D.obj i₀) Λ)
      (φ : (SchemeConstructible.pullback (c.π.app i₀) Λ).obj A ⟶
        (SchemeConstructible.pullback (c.π.app i₀) Λ).obj B),
      ∃ (i : I) (g : i ⟶ i₀) (ψ : (SchemeConstructible.pullback (D.map g) Λ).obj A ⟶
          (SchemeConstructible.pullback (D.map g) Λ).obj B),
        SchemeConstructible.homTransport A B (c.π.app i) (c.w g) ψ = φ) ∧
    (∀ (i₀ i : I) (g : i ⟶ i₀) (A B : SchemeConstructible (D.obj i₀) Λ)
      (ψ ψ' : (SchemeConstructible.pullback (D.map g) Λ).obj A ⟶
        (SchemeConstructible.pullback (D.map g) Λ).obj B),
      SchemeConstructible.homTransport A B (c.π.app i) (c.w g) ψ =
          SchemeConstructible.homTransport A B (c.π.app i) (c.w g) ψ' →
        ∃ (j : I) (h : j ⟶ i),
          SchemeConstructible.homTransport A B (D.map h) (D.map_comp h g).symm ψ =
            SchemeConstructible.homTransport A B (D.map h) (D.map_comp h g).symm ψ') :=
  sorry

/-! ### L2/scheme-support-extension: Proper-support operations over qcqs schemes

`SchemeSupport.extend` (API `SchemeSupport.extend`) is declared in the core section. The
coefficient hypothesis is that `Λ` is killed by an integer invertible on the base. -/

/-- `Λ` is killed by a positive integer that is invertible on `X`. -/
def IsInvertibleTorsionOn (X : Scheme.{u}) (Λ : Type u) [CommRing Λ] : Prop :=
  ∃ n : ℕ, 0 < n ∧ (n : Λ) = 0 ∧ IsUnit ((n : ℕ) : Γ(X, ⊤))

namespace SchemeSupport

variable {Y X : Scheme.{u}} (f : Y ⟶ X) [CompactSpace X] [QuasiSeparatedSpace X]
  [IsSeparated f] [LocallyOfFiniteType f] [QuasiCompact f] (Λ : Type u) [CommRing Λ]

/-- `SchemeSupport.compactification`: the canonical identification `Rf_! ≅ Rp_* j_!` for a
compactification `f = p ∘ j`. -/
def compactification (hΛ : IsInvertibleTorsionOn X Λ) (C : Compactification f) :
    extend f Λ ≅ SchemeEtale.extendByZero C.open ⋙ SchemeEtale.pushforward C.properMap :=
  sorry

/-- The identification of `SchemeSupport.compactification`, compatibly with a refinement
`g : C' ⟶ C`: the two identifications differ by the proper base-change map `Rp'_* j'_! ≅ Rp_* j_!`
of the refinement (constructed from proper base change for the strict part and the vanishing of
`j_!` off the open). -/
def refinementIso (hΛ : IsInvertibleTorsionOn X Λ) {C C' : Compactification f} (g : C' ⟶ C)
    (hg : Compactification.Hom.strict g) :
    SchemeEtale.extendByZero (Λ := Λ) C'.open ⋙ SchemeEtale.pushforward C'.properMap ≅
      SchemeEtale.extendByZero (Λ := Λ) C.open ⋙ SchemeEtale.pushforward C.properMap := sorry

/-- `SchemeSupport.open`: for a quasi-compact open immersion, `Rj_!` is extension by zero. -/
theorem «open» {U : Scheme.{u}} (j : U ⟶ X) [IsOpenImmersion j] [QuasiCompact j]
    (hΛ : IsInvertibleTorsionOn X Λ) :
    Nonempty (extend j Λ ≅ SchemeEtale.extendByZero j) := sorry

/-- `SchemeSupport.compose`: `R(g ∘ f)_! ≅ Rg_! Rf_!`. The identity clause is `extend_id`; the
associativity coherence of these isomorphisms is part of the target and needs them as named data,
so it is not stated here. -/
theorem compose {W : Scheme.{u}} (g : X ⟶ W) [CompactSpace W] [QuasiSeparatedSpace W]
    [IsSeparated g] [LocallyOfFiniteType g] [QuasiCompact g] (hΛ : IsInvertibleTorsionOn W Λ) :
    Nonempty (extend (f ≫ g) Λ ≅ extend f Λ ⋙ extend g Λ) := sorry

/-- `SchemeSupport.compose`, identity clause: `R(𝟙_X)_! ≅ 𝟭`. -/
theorem extend_id (hΛ : IsInvertibleTorsionOn X Λ) :
    Nonempty (extend (𝟙 X) Λ ≅ 𝟭 (SchemeEtale X Λ)) := sorry

/-- `SchemeSupport.baseChange`: proper base change `g* Rf_! ≅ Rf'_! g'*` for the cartesian square
of `f` and `g : X' → X`. -/
theorem baseChange {X' : Scheme.{u}} (g : X' ⟶ X) [CompactSpace X'] [QuasiSeparatedSpace X']
    (hΛ : IsInvertibleTorsionOn X Λ) :
    Nonempty (extend f Λ ⋙ SchemeEtale.pullback g ≅
      SchemeEtale.pullback (Limits.pullback.fst f g) ⋙ extend (Limits.pullback.snd f g) Λ) :=
  sorry

/-- `SchemeSupport.projection`: `Rf_!(A ⊗ f*B) ≅ Rf_!A ⊗ B`. -/
theorem projection (hΛ : IsInvertibleTorsionOn X Λ) (A : SchemeEtale Y Λ) (B : SchemeEtale X Λ) :
    Nonempty ((extend f Λ).obj (A ⊗ (SchemeEtale.pullback f).obj B) ≅
      (extend f Λ).obj A ⊗ B) := sorry

/-- `SchemeSupport.adic`: for adic coefficients, reduction modulo `Iⁿ` identifies the adic
`Rf_!` with the finite-level one. -/
theorem adic {p : ℕ} {I : Ideal Λ} (hI : IsAdicCoefficientPair p I) (n : ℕ) (hn : 1 ≤ n)
    (hΛ : IsInvertibleTorsionOn X (Λ ⧸ I ^ n)) :
    Nonempty (extendAdic f I ⋙ SchemeAdic.reduce X hI n hn ≅
      SchemeAdic.reduce Y hI n hn ⋙ extend f (Λ ⧸ I ^ n)) := sorry

end SchemeSupport

/-- `SchemeSupport.proper`: for proper `f`, `Rf_! = Rf_*`. -/
theorem SchemeSupport.proper {Y X : Scheme.{u}} (f : Y ⟶ X) [CompactSpace X]
    [QuasiSeparatedSpace X] [IsProper f] (Λ : Type u) [CommRing Λ]
    (hΛ : IsInvertibleTorsionOn X Λ) :
    Nonempty (SchemeSupport.extend f Λ ≅ SchemeEtale.pushforward f) := sorry

attribute [local instance] hasBinaryBiproducts_of_finite_biproducts in
/- Test `SchemeSupport.properPoint` (computation): for the map from two copies of a geometric
point `Spec κ` to one, `Rf_! = Rf_*` and the constant sheaf `Λ` goes to `Λ ⊕ Λ`. -/
example (κ : Type u) [Field κ] [IsSepClosed κ] (Λ : Type u) [CommRing Λ]
    (hΛ : IsInvertibleTorsionOn (Spec (CommRingCat.of κ)) Λ)
    [IsProper (coprod.desc (𝟙 (Spec (CommRingCat.of κ))) (𝟙 (Spec (CommRingCat.of κ))))] :
    Nonempty (SchemeSupport.extend
        (coprod.desc (𝟙 (Spec (CommRingCat.of κ))) (𝟙 (Spec (CommRingCat.of κ)))) Λ ≅
      SchemeEtale.pushforward
        (coprod.desc (𝟙 (Spec (CommRingCat.of κ))) (𝟙 (Spec (CommRingCat.of κ))))) ∧
    Nonempty ((SchemeSupport.extend
        (coprod.desc (𝟙 (Spec (CommRingCat.of κ))) (𝟙 (Spec (CommRingCat.of κ)))) Λ).obj
        (𝟙_ (SchemeEtale (Spec (CommRingCat.of κ) ⨿ Spec (CommRingCat.of κ)) Λ)) ≅
      𝟙_ (SchemeEtale (Spec (CommRingCat.of κ)) Λ) ⊞ 𝟙_ (SchemeEtale (Spec (CommRingCat.of κ)) Λ)) :=
  sorry

/- Test `SchemeSupport.openBoundary` (computation): for the open immersion `j : U ↪ 𝔸¹_k` onto the
complement `D(x)` of the origin and the origin `0 : Spec k → 𝔸¹_k`, the stalk `0* j_! Λ` vanishes. -/
example (k : Type u) [Field k] (Λ : Type u) [CommRing Λ]
    (hΛ : IsInvertibleTorsionOn (Spec (CommRingCat.of (Polynomial k))) Λ) {U : Scheme.{u}}
    (j : U ⟶ Spec (CommRingCat.of (Polynomial k))) [IsOpenImmersion j] [IsSeparated j]
    [LocallyOfFiniteType j] [QuasiCompact j]
    (hj : j.opensRange = (Spec (CommRingCat.of (Polynomial k))).basicOpen
      ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv.hom Polynomial.X)) :
    IsZero ((SchemeEtale.pullback (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k))))).obj
      ((SchemeSupport.extend j Λ).obj (𝟙_ (SchemeEtale U Λ)))) := sorry

/- Test `SchemeSupport.empty` (degenerate): the map from the empty scheme gives the zero functor:
every object in its image is zero. -/
example {X : Scheme.{u}} [CompactSpace X] [QuasiSeparatedSpace X] (Λ : Type u) [CommRing Λ]
    (A : SchemeEtale (⊥_ Scheme.{u}) Λ) :
    IsZero ((SchemeSupport.extend (initial.to X) Λ).obj A) := sorry

/- Test `SchemeSupport.refinement` (characterisation): for a strict refinement `g : C' ⟶ C` of
compactifications, the identification of `Rf_!` with `Rp'_* j'_!` is the identification with
`Rp_* j_!` followed by the canonical refinement isomorphism (not an arbitrary isomorphism). -/
example {Y X : Scheme.{u}} (f : Y ⟶ X) [CompactSpace X] [QuasiSeparatedSpace X] [IsSeparated f]
    [LocallyOfFiniteType f] [QuasiCompact f] (Λ : Type u) [CommRing Λ]
    (hΛ : IsInvertibleTorsionOn X Λ) {C C' : Compactification f} (g : C' ⟶ C)
    (hg : Compactification.Hom.strict g) :
    SchemeSupport.compactification f Λ hΛ C' ≪≫ SchemeSupport.refinementIso f Λ hΛ g hg =
      SchemeSupport.compactification f Λ hΛ C := sorry

/-! ### L2/coefficient-and-unbounded-extension: Scheme support coefficient extensions -/

/-- Derived extension of scalars `A ↦ A ⊗ᴸ_Λ Λ'` along `φ : Λ →+* Λ'` on `D̂(X_ét, -)`.
Owner: `SchemeAndStackFoundations:SF.2`. -/
def SchemeEtale.changeRing (X : Scheme.{u}) {Λ Λ' : Type u} [CommRing Λ] [CommRing Λ']
    (φ : Λ →+* Λ') : SchemeEtale X Λ ⥤ SchemeEtale X Λ' := sorry

/-- `L2/coefficient-and-unbounded-extension` (proof of ECD Proposition 27.4): the qcqs proper
support extends to larger coefficient rings killed by an integer invertible on the base, with no
finiteness condition on the modules, compatibly with change of coefficients along `φ : Λ → Λ'`
(here `SchemeEtale.changeRing`), and to regular adic coefficients, compatibly with reduction
modulo `Iⁿ` for every `n ≥ 1` (`SchemeSupport.adic`). The left-completed unbounded extension is
part of the target through the category `SchemeEtale` itself. The proof needs a locally uniform
finite relative cohomological bound for the proper models; it is not a hypothesis of the
statement. -/
theorem coefficientExtension {Y X : Scheme.{u}} (f : Y ⟶ X) [CompactSpace X]
    [QuasiSeparatedSpace X] [IsSeparated f] [LocallyOfFiniteType f] [QuasiCompact f]
    {Λ Λ' : Type u} [CommRing Λ] [CommRing Λ'] (φ : Λ →+* Λ') (hΛ : IsInvertibleTorsionOn X Λ)
    (hΛ' : IsInvertibleTorsionOn X Λ') :
    Nonempty (SchemeSupport.extend f Λ ⋙ SchemeEtale.changeRing X φ ≅
        SchemeEtale.changeRing Y φ ⋙ SchemeSupport.extend f Λ') ∧
    ∀ {p : ℕ} {I : Ideal Λ} (hI : IsAdicCoefficientPair p I) (n : ℕ) (hn : 1 ≤ n),
      IsInvertibleTorsionOn X (Λ ⧸ I ^ n) →
      Nonempty (SchemeSupport.extendAdic f I ⋙ SchemeAdic.reduce X hI n hn ≅
        SchemeAdic.reduce Y hI n hn ⋙ SchemeSupport.extend f (Λ ⧸ I ^ n)) := sorry

end L2

/-! ## Layers L3–L6: the comparison theorems of ECD §27

Characteristic `p` (L3, ECD Propositions 27.1–27.4), the analytic test space and the
mixed-characteristic proper-support comparison (L4, ECD Proposition 27.5), the alteration and
normal-crossing inputs of the proof of ECD Proposition 27.6 (L5), and the constructible
comparison theorems (L6, ECD Propositions 27.6–27.7). -/

section L3toL6

open Opposite

/-! #### Interfaces used here -/

/-- The symmetry of the derived tensor product on `D̂(X_ét, Λ)`.
Owner: `SchemeAndStackFoundations:SF.2`. -/
instance schemeEtaleSymmetric (X : Scheme.{u}) (Λ : Type u) [CommRing Λ] :
    SymmetricCategory (SchemeEtale X Λ) := sorry

/-- The `q`-th cohomology of the stalk at a geometric point `x : Spec κ → X` (`κ` separably
closed), `A ↦ Hᑫ(A_x)`. Owner: `SchemeAndStackFoundations:SF.2`. -/
def SchemeEtale.stalkCohomology {X : Scheme.{u}} {Λ : Type u} [CommRing Λ] (q : ℤ)
    {κ : Type u} [Field κ] [IsSepClosed κ] (x : Spec (CommRingCat.of κ) ⟶ X) :
    SchemeEtale X Λ ⥤ ModuleCat.{u} Λ := sorry

/-- The `q`-th cohomology of the stalk of an étale complex on a small v-stack at a geometric
point `Spd C → Y`. Owner: `DiamondEtaleCohomology:C2`. -/
def DEtale.stalkCohomology {p : ℕ} {Y : SmallVStack.{u} p} {Λ : Type u} [CommRing Λ] (q : ℤ)
    {C : Type u} [NontriviallyNormedField C] [IsUltrametricDist C] [CompleteSpace C]
    [IsAlgClosed C] [CharP C p] (s : (SmallVSheaf.toStack p).obj (geomPoint p C) ⟶ Y) :
    DEtale Y Λ ⥤ ModuleCat.{u} Λ := sorry

/-- Proper hypercovers by alterations of an `O`-scheme `X` of finite type: augmented simplicial
`O`-schemes `X_• → X` of finite type whose matching maps are proper and surjective, obtained by
applying de Jong's alterations (over fields, and over traits after a finite extension) to the
matching objects, so that each `X_n` is a finite disjoint union of regular schemes with strict
normal crossings boundary. No condition on the degrees of the alterations is imposed.
Owner of the notion and of the alteration theorems: `SchemeAndStackFoundations:SF.4`. -/
def AlterationHypercover {O : Type u} [CommRing O] (X : LFTScheme O) : Type (u + 1) := sorry

/-- The underlying simplicial `O`-scheme `X_•` of an alteration hypercover. -/
def AlterationHypercover.simplicial {O : Type u} [CommRing O] {X : LFTScheme O}
    (H : AlterationHypercover X) : SimplicialObject (LFTScheme O) := sorry

/-- The augmentation `X_• → X` of an alteration hypercover. -/
def AlterationHypercover.augmentation {O : Type u} [CommRing O] {X : LFTScheme O}
    (H : AlterationHypercover X) : H.simplicial ⟶ (SimplicialObject.const _).obj X := sorry

/-- Cartesian objects of `D̂_ét` on the simplicial scheme `X_•` (the enhanced limit of the
`D̂(X_{n,ét}, Λ)` along the face and degeneracy pullbacks), with the augmentation pullback.
Owner: `EnhancedDerivedSheaves:E2/hypercovers-and-cohomological-descent`. -/
def CartesianSchemeEtale {O : Type u} [CommRing O] {X : LFTScheme O}
    (H : AlterationHypercover X) (Λ : Type u) [CommRing Λ] : Type (u + 1) := sorry

instance {O : Type u} [CommRing O] {X : LFTScheme O} (H : AlterationHypercover X) (Λ : Type u)
    [CommRing Λ] : Category.{u} (CartesianSchemeEtale H Λ) := sorry

/-- Pullback along the augmentation `X_• → X` into cartesian complexes.
Owner: `EnhancedDerivedSheaves:E2/hypercovers-and-cohomological-descent`. -/
def CartesianSchemeEtale.descentPullback {O : Type u} [CommRing O] {X : LFTScheme O}
    (H : AlterationHypercover X) (Λ : Type u) [CommRing Λ] :
    SchemeEtale X.obj.left Λ ⥤ CartesianSchemeEtale H Λ := sorry

/-- Cartesian objects of `D_ét` on the simplicial small v-stack `X_•◇` over `Spd O`, with the
augmentation pullback from `X◇`. Owner:
`EnhancedDerivedSheaves:E2/unbounded-hypercover-descent` with `DiamondEtaleCohomology:C2`. -/
def CartesianDEtale (p : ℕ) [Fact p.Prime] {O : Type u} [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O] {X : LFTScheme O}
    (H : AlterationHypercover X) (Λ : Type u) [CommRing Λ] : Type (u + 1) := sorry

instance (p : ℕ) [Fact p.Prime] {O : Type u} [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O] {X : LFTScheme O}
    (H : AlterationHypercover X) (Λ : Type u) [CommRing Λ] :
    Category.{u} (CartesianDEtale p H Λ) := sorry

