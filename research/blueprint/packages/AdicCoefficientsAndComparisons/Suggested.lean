/-! #### Notation for the maps of v-stacks induced by scheme maps -/

/-- `f◇ : Y◇ → X◇` for a map of characteristic-`p` schemes, as a map of small v-stacks. -/
abbrev SchemeDiamond.charPStackMap (p : ℕ) [Fact p.Prime] {X Y : CharPScheme.{u} p}
    (f : Y ⟶ X) : SchemeDiamond.charPStack p Y ⟶ SchemeDiamond.charPStack p X :=
  (SmallVSheaf.toStack p).map ((SchemeDiamond.charP p).map f)

/-- `f◇ : Y◇ → X◇` for a map of `O`-schemes locally of finite type, as a map of small
v-stacks. -/
abbrev SchemeDiamond.overDVRStackMap (p : ℕ) [Fact p.Prime] (O : Type u) [CommRing O]
    [IsDomain O] [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O]
    {X Y : LFTScheme O} (f : Y ⟶ X) :
    SchemeDiamond.overDVRStack p O Y ⟶ SchemeDiamond.overDVRStack p O X :=
  (SmallVSheaf.toStack p).map ((SchemeDiamond.overDVR p O).map f).left

/-- The structure map `X◇ → Spd O` as a map of small v-stacks. -/
abbrev SchemeDiamond.overDVRStackStructure (p : ℕ) [Fact p.Prime] (O : Type u) [CommRing O]
    [IsDomain O] [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O]
    (X : LFTScheme O) :
    SchemeDiamond.overDVRStack p O X ⟶ (SmallVSheaf.toStack p).obj (spd p O ⊤) :=
  (SmallVSheaf.toStack p).map ((SchemeDiamond.overDVR p O).obj X).hom

/-! #### Symmetric monoidal comparison maps -/

/-- An oplax monoidal functor between symmetric monoidal categories is strong symmetric monoidal
through its own comparison maps: the unit map `F(𝟙) → 𝟙` and the maps `F(A ⊗ B) → FA ⊗ FB` are
isomorphisms, and the latter commute with the symmetries. (Mathlib's
`Functor.Monoidal.ofOplaxMonoidal` then gives the strong monoidal structure.) -/
def IsStrongSymmetricOplax {C D : Type*} [Category C] [Category D] [MonoidalCategory C]
    [MonoidalCategory D] [BraidedCategory C] [BraidedCategory D] (F : C ⥤ D)
    [F.OplaxMonoidal] : Prop :=
  IsIso (Functor.OplaxMonoidal.η F) ∧ (∀ A B : C, IsIso (Functor.OplaxMonoidal.δ F A B)) ∧
    ∀ A B : C, F.map (β_ A B).hom ≫ Functor.OplaxMonoidal.δ F B A =
      Functor.OplaxMonoidal.δ F A B ≫ (β_ (F.obj A) (F.obj B)).hom

/-! ### L3/commutation-and-adjoints-27-1-27-3: tensor and pullback compatibility -/

namespace SchemeComparison

variable (p : ℕ) [Fact p.Prime]

/-- The canonical comparison maps `c_X^*(A ⊗ B) → c_X^*A ⊗ c_X^*B` and `c_X^*Λ → Λ` of the
pullback along the morphism of ringed sites `c_X : X◇_v → X_ét`. -/
instance pullbackOplax (X : CharPScheme.{u} p) (Λ : Type u) [CommRing Λ] :
    (SchemeComparison.pullback p X Λ).OplaxMonoidal := sorry

/-- The canonical comparison maps of the completed pullback for the completed tensor products. -/
instance pullbackAdicOplax (X : CharPScheme.{u} p) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) :
    (SchemeComparison.pullbackAdic p X I).OplaxMonoidal := sorry

/-- The canonical base-change transformation `c_X^* ⋙ (f◇)^* ⟶ f^* ⋙ c_Y^*` of a map
`f : Y → X` of characteristic-`p` schemes, from the commutative square of morphisms of sites
`c_X ∘ f◇ = f ∘ c_Y`. -/
def pullbackBaseChange {X Y : CharPScheme.{u} p} (f : Y ⟶ X) (Λ : Type u) [CommRing Λ] :
    SchemeComparison.pullback p X Λ ⋙ DEtale.pullback (SchemeDiamond.charPStackMap p f) ⟶
      SchemeEtale.pullback f.hom ⋙ SchemeComparison.pullback p Y Λ := sorry

/-- The base-change transformation for adic coefficients. -/
def pullbackBaseChangeAdic {X Y : CharPScheme.{u} p} (f : Y ⟶ X) {Λ : Type u} [CommRing Λ]
    (I : Ideal Λ) :
    SchemeComparison.pullbackAdic p X I ⋙ AdicSix.pullback (SchemeDiamond.charPStackMap p f) ⟶
      SchemeAdic.pullback f.hom I ⋙ SchemeComparison.pullbackAdic p Y I := sorry

/-- `L3/commutation-and-adjoints-27-1-27-3` (ECD Proposition 27.1, tensor part): for discrete
coefficients killed by an integer prime to `p`, `c_X^*` is symmetric monoidal for the derived
tensor products through its canonical comparison maps. -/
theorem pullbackMonoidal_charP (X : CharPScheme.{u} p) (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) : IsStrongSymmetricOplax (SchemeComparison.pullback p X Λ) :=
  sorry

/-- `L3/commutation-and-adjoints-27-1-27-3` (ECD Proposition 27.1, tensor part, adic
coefficients): the completed pullback is symmetric monoidal for the completed tensor products. -/
theorem pullbackMonoidalAdic_charP (X : CharPScheme.{u} p) {Λ : Type u} [CommRing Λ]
    (I : Ideal Λ) (hI : IsAdicCoefficientPair p I) :
    IsStrongSymmetricOplax (SchemeComparison.pullbackAdic p X I) := sorry

/-- `L3/commutation-and-adjoints-27-1-27-3` (ECD Proposition 27.1, pullback part): for every map
`f : Y → X` of characteristic-`p` schemes the canonical transformation
`(f◇)^* c_X^* → c_Y^* f^*` is an isomorphism. No eligibility condition on `f` is needed. -/
theorem pullbackCommutes_charP {X Y : CharPScheme.{u} p} (f : Y ⟶ X) (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) : IsIso (SchemeComparison.pullbackBaseChange p f Λ) := sorry

/-- `L3/commutation-and-adjoints-27-1-27-3` (ECD Proposition 27.1, pullback part, adic
coefficients). -/
theorem pullbackCommutesAdic_charP {X Y : CharPScheme.{u} p} (f : Y ⟶ X) {Λ : Type u}
    [CommRing Λ] (I : Ideal Λ) (hI : IsAdicCoefficientPair p I) :
    IsIso (SchemeComparison.pullbackBaseChangeAdic p f I) := sorry

/-- The isomorphism `(f◇)^* c_X^* ≅ c_Y^* f^*` of ECD Proposition 27.1. -/
def pullbackBaseChangeIso {X Y : CharPScheme.{u} p} (f : Y ⟶ X) (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) :
    SchemeComparison.pullback p X Λ ⋙ DEtale.pullback (SchemeDiamond.charPStackMap p f) ≅
      SchemeEtale.pullback f.hom ⋙ SchemeComparison.pullback p Y Λ :=
  haveI := pullbackCommutes_charP p f Λ hΛ
  asIso (SchemeComparison.pullbackBaseChange p f Λ)

/-- The isomorphism of ECD Proposition 27.1 for adic coefficients. -/
def pullbackBaseChangeAdicIso {X Y : CharPScheme.{u} p} (f : Y ⟶ X) {Λ : Type u} [CommRing Λ]
    (I : Ideal Λ) (hI : IsAdicCoefficientPair p I) :
    SchemeComparison.pullbackAdic p X I ⋙ AdicSix.pullback (SchemeDiamond.charPStackMap p f) ≅
      SchemeAdic.pullback f.hom I ⋙ SchemeComparison.pullbackAdic p Y I :=
  haveI := pullbackCommutesAdic_charP p f I hI
  asIso (SchemeComparison.pullbackBaseChangeAdic p f I)

/-- The canonical direct-image comparison `c_X^* Rf_* → R(f◇)_* c_Y^*`: the mate of
`pullbackBaseChange` under `f^* ⊣ Rf_*` and `(f◇)^* ⊣ R(f◇)_*`. -/
def pushforwardComparison {X Y : CharPScheme.{u} p} (f : Y ⟶ X) (Λ : Type u) [CommRing Λ] :
    SchemeEtale.pushforward f.hom ⋙ SchemeComparison.pullback p X Λ ⟶
      SchemeComparison.pullback p Y Λ ⋙ DEtale.pushforward (SchemeDiamond.charPStackMap p f) :=
  (mateEquiv (SchemeEtale.pullbackAdj f.hom)
    (DEtale.pullbackAdj (SchemeDiamond.charPStackMap p f))
    (TwoSquare.mk _ _ _ _ (SchemeComparison.pullbackBaseChange p f Λ))).natTrans

variable (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] [TopologicalSpace O]
  [IsCompleteDVRBase p O]

/-- The canonical comparison maps of `c_X^*` over `O` for the derived tensor products. -/
instance pullbackDVROplax (X : LFTScheme O) (Λ : Type u) [CommRing Λ] :
    (SchemeComparison.pullbackDVR p O X Λ).OplaxMonoidal := sorry

/-- The canonical comparison maps of the completed `c_X^*` over `O`. -/
instance pullbackAdicDVROplax (X : LFTScheme O) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) :
    (SchemeComparison.pullbackAdicDVR p O X I).OplaxMonoidal := sorry

/-- The canonical base-change transformation `c_X^* ⋙ (f◇)^* ⟶ f^* ⋙ c_Y^*` for a map of
`O`-schemes locally of finite type. -/
def pullbackBaseChangeDVR {X Y : LFTScheme O} (f : Y ⟶ X) (Λ : Type u) [CommRing Λ] :
    SchemeComparison.pullbackDVR p O X Λ ⋙ DEtale.pullback (SchemeDiamond.overDVRStackMap p O f) ⟶
      SchemeEtale.pullback f.hom.left ⋙ SchemeComparison.pullbackDVR p O Y Λ := sorry

/-- The base-change transformation over `O` for adic coefficients. -/
def pullbackBaseChangeAdicDVR {X Y : LFTScheme O} (f : Y ⟶ X) {Λ : Type u} [CommRing Λ]
    (I : Ideal Λ) :
    SchemeComparison.pullbackAdicDVR p O X I ⋙
        AdicSix.pullback (SchemeDiamond.overDVRStackMap p O f) ⟶
      SchemeAdic.pullback f.hom.left I ⋙ SchemeComparison.pullbackAdicDVR p O Y I := sorry

/-- `L3/commutation-and-adjoints-27-1-27-3` (ECD Proposition 27.1 in the mixed-characteristic
range, p. 166): `c_X^*` over `O` is symmetric monoidal through its canonical comparison maps,
for discrete and for adic coefficients. -/
theorem pullbackMonoidal_DVR (X : LFTScheme O) :
    (∀ (Λ : Type u) [CommRing Λ], IsPrimeToPTorsion p Λ →
      IsStrongSymmetricOplax (SchemeComparison.pullbackDVR p O X Λ)) ∧
    ∀ (Λ : Type u) [CommRing Λ] (I : Ideal Λ), IsAdicCoefficientPair p I →
      IsStrongSymmetricOplax (SchemeComparison.pullbackAdicDVR p O X I) := sorry

/-- `L3/commutation-and-adjoints-27-1-27-3` (ECD Proposition 27.1 in the mixed-characteristic
range): for every map `f : Y → X` of `O`-schemes locally of finite type the canonical
transformations `(f◇)^* c_X^* → c_Y^* f^*` are isomorphisms, for discrete and adic coefficients. -/
theorem pullbackCommutes_DVR {X Y : LFTScheme O} (f : Y ⟶ X) :
    (∀ (Λ : Type u) [CommRing Λ], IsPrimeToPTorsion p Λ →
      IsIso (SchemeComparison.pullbackBaseChangeDVR p O f Λ)) ∧
    ∀ (Λ : Type u) [CommRing Λ] (I : Ideal Λ), IsAdicCoefficientPair p I →
      IsIso (SchemeComparison.pullbackBaseChangeAdicDVR p O f I) := sorry

/-- The isomorphism `(f◇)^* c_X^* ≅ c_Y^* f^*` over `O`. -/
def pullbackBaseChangeDVRIso {X Y : LFTScheme O} (f : Y ⟶ X) (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) :
    SchemeComparison.pullbackDVR p O X Λ ⋙ DEtale.pullback (SchemeDiamond.overDVRStackMap p O f) ≅
      SchemeEtale.pullback f.hom.left ⋙ SchemeComparison.pullbackDVR p O Y Λ :=
  haveI := (pullbackCommutes_DVR p O f).1 Λ hΛ
  asIso (SchemeComparison.pullbackBaseChangeDVR p O f Λ)

/-- The isomorphism `(f◇)^* c_X^* ≅ c_Y^* f^*` over `O` for adic coefficients. -/
def pullbackBaseChangeAdicDVRIso {X Y : LFTScheme O} (f : Y ⟶ X) {Λ : Type u} [CommRing Λ]
    (I : Ideal Λ) (hI : IsAdicCoefficientPair p I) :
    SchemeComparison.pullbackAdicDVR p O X I ⋙
        AdicSix.pullback (SchemeDiamond.overDVRStackMap p O f) ≅
      SchemeAdic.pullback f.hom.left I ⋙ SchemeComparison.pullbackAdicDVR p O Y I :=
  haveI := (pullbackCommutes_DVR p O f).2 Λ I hI
  asIso (SchemeComparison.pullbackBaseChangeAdicDVR p O f I)

/-- The canonical direct-image comparison `c_X^* Rf_* → R(f◇)_* c_Y^*` over `O`: the mate of
`pullbackBaseChangeDVR` under `f^* ⊣ Rf_*` and `(f◇)^* ⊣ R(f◇)_*`. It is the map of ECD
Propositions 27.5–27.6. -/
def pushforwardComparisonDVR {X Y : LFTScheme O} (f : Y ⟶ X) (Λ : Type u) [CommRing Λ] :
    SchemeEtale.pushforward f.hom.left ⋙ SchemeComparison.pullbackDVR p O X Λ ⟶
      SchemeComparison.pullbackDVR p O Y Λ ⋙
        DEtale.pushforward (SchemeDiamond.overDVRStackMap p O f) :=
  (mateEquiv (SchemeEtale.pullbackAdj f.hom.left)
    (DEtale.pullbackAdj (SchemeDiamond.overDVRStackMap p O f))
    (TwoSquare.mk _ _ _ _ (SchemeComparison.pullbackBaseChangeDVR p O f Λ))).natTrans

end SchemeComparison

/-! ### L3/full-faithfulness-27-2: characteristic-`p` full faithfulness -/

section FullFaithfulness

variable (p : ℕ) [Fact p.Prime]

/-- `L3/full-faithfulness-27-2` (ECD Proposition 27.2, unit form): for every characteristic-`p`
scheme `X` (no finiteness hypothesis) and discrete `Λ` killed by an integer prime to `p`, the unit
`A → Rc_{X*} c_X^* A` is an isomorphism on the left-completed category `D̂(X_ét, Λ)`. -/
theorem comparisonUnit_isIso_charP (X : CharPScheme.{u} p) (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) : IsIso (SchemeComparison.adj p X Λ).unit := sorry

/-- `L3/full-faithfulness-27-2` (ECD Proposition 27.2, unit form, adic coefficients). -/
theorem comparisonUnitAdic_isIso_charP (X : CharPScheme.{u} p) {Λ : Type u} [CommRing Λ]
    (I : Ideal Λ) (hI : IsAdicCoefficientPair p I) :
    IsIso (SchemeComparison.adjAdic p X I).unit := sorry

/-- `L3/full-faithfulness-27-2` (ECD Proposition 27.2): `c_X^*` is fully faithful for every
characteristic-`p` scheme `X` and discrete `Λ` killed by an integer prime to `p`. -/
theorem fullyFaithful_charP (X : CharPScheme.{u} p) (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) :
    (SchemeComparison.pullback p X Λ).Full ∧ (SchemeComparison.pullback p X Λ).Faithful := by
  have := comparisonUnit_isIso_charP p X Λ hΛ
  exact ⟨(SchemeComparison.adj p X Λ).fullyFaithfulLOfIsIsoUnit.full,
    (SchemeComparison.adj p X Λ).fullyFaithfulLOfIsIsoUnit.faithful⟩

/-- `L3/full-faithfulness-27-2` (ECD Proposition 27.2, adic coefficients): the completed `c_X^*`
from the scheme adic category is fully faithful. -/
theorem fullyFaithfulAdic_charP (X : CharPScheme.{u} p) {Λ : Type u} [CommRing Λ]
    (I : Ideal Λ) (hI : IsAdicCoefficientPair p I) :
    (SchemeComparison.pullbackAdic p X I).Full ∧
      (SchemeComparison.pullbackAdic p X I).Faithful := by
  have := comparisonUnitAdic_isIso_charP p X I hI
  exact ⟨(SchemeComparison.adjAdic p X I).fullyFaithfulLOfIsIsoUnit.full,
    (SchemeComparison.adjAdic p X I).fullyFaithfulLOfIsIsoUnit.faithful⟩

end FullFaithfulness

/-! ### L3/internal-Hom-right-adjoint: internal `RHom` through the right adjoint -/

section InternalHom

variable (p : ℕ) [Fact p.Prime]

/-- `L3/internal-Hom-right-adjoint` (ECD Proposition 27.3(i)): for `A` on `X_ét` and `B` on `X◇`,
`Rc_{X*} RHom(c_X^* A, B) ≅ RHom(A, Rc_{X*} B)`, naturally in both variables. The object `B` stays
on the v-sheaf side; nothing is claimed about `c_X^*` and internal `RHom` in general. -/
theorem internalHomComparison_charP (X : CharPScheme.{u} p) (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) :
    Nonempty ((SchemeComparison.pullback p X Λ).op ⋙ MonoidalClosed.internalHom ⋙
        (Functor.whiskeringRight _ _ _).obj (SchemeComparison.pushforward p X Λ) ≅
      MonoidalClosed.internalHom ⋙
        (Functor.whiskeringLeft _ _ _).obj (SchemeComparison.pushforward p X Λ)) := sorry

/-- `L3/internal-Hom-right-adjoint` (ECD Proposition 27.3(i), adic coefficients), with the
internal `RHom` of the completed tensor products on both sides. -/
theorem internalHomComparisonAdic_charP (X : CharPScheme.{u} p) {Λ : Type u} [CommRing Λ]
    (I : Ideal Λ) (hI : IsAdicCoefficientPair p I) :
    Nonempty ((SchemeComparison.pullbackAdic p X I).op ⋙ MonoidalClosed.internalHom ⋙
        (Functor.whiskeringRight _ _ _).obj (SchemeComparison.pushforwardAdic p X I) ≅
      MonoidalClosed.internalHom ⋙
        (Functor.whiskeringLeft _ _ _).obj (SchemeComparison.pushforwardAdic p X I)) := sorry

/-- `L3/internal-Hom-right-adjoint` (ECD Proposition 27.3(i) in the mixed-characteristic range):
the same identity for `c_X^* ⊣ Rc_{X*}` over `O`; no full faithfulness is used. -/
theorem internalHomComparison_DVR (O : Type u) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O] (X : LFTScheme O)
    (Λ : Type u) [CommRing Λ] (hΛ : IsPrimeToPTorsion p Λ) :
    Nonempty ((SchemeComparison.pullbackDVR p O X Λ).op ⋙ MonoidalClosed.internalHom ⋙
        (Functor.whiskeringRight _ _ _).obj (SchemeComparison.pushforwardDVR p O X Λ) ≅
      MonoidalClosed.internalHom ⋙
        (Functor.whiskeringLeft _ _ _).obj (SchemeComparison.pushforwardDVR p O X Λ)) := sorry

/-- `L3/internal-Hom-right-adjoint` (ECD Proposition 27.3(i), over `O`, adic coefficients):
`Rc_{X*} RHom(c_X^* A, B) ≅ RHom(A, Rc_{X*} B)`, naturally in `A` and `B`. -/
theorem internalHomComparisonAdic_DVR (O : Type u) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O] (X : LFTScheme O)
    {Λ : Type u} [CommRing Λ] (I : Ideal Λ) (hI : IsAdicCoefficientPair p I) :
    Nonempty ((SchemeComparison.pullbackAdicDVR p O X I).op ⋙ MonoidalClosed.internalHom ⋙
        (Functor.whiskeringRight _ _ _).obj (SchemeComparison.pushforwardAdicDVR p O X I) ≅
      MonoidalClosed.internalHom ⋙
        (Functor.whiskeringLeft _ _ _).obj (SchemeComparison.pushforwardAdicDVR p O X I)) := sorry

end InternalHom

/-! ### L3/pushforward-right-adjoint: direct images through the right adjoints

The isomorphisms below are constructed (not assumed): they are the conjugates, under the
composite adjunctions `f^* ⋙ c_Y^* ⊣ Rc_{Y*} ⋙ Rf_*` and `c_X^* ⋙ (f◇)^* ⊣ R(f◇)_* ⋙ Rc_{X*}`,
of the isomorphisms of ECD Proposition 27.1. They are not the direct-image comparison
`c_X^* Rf_* → R(f◇)_* c_Y^*`, which is `SchemeComparison.pushforwardComparison`. -/

namespace SchemeComparison

variable (p : ℕ) [Fact p.Prime]

/-- `Rf_* Rc_{Y*} ≅ Rc_{X*} R(f◇)_*`, the right-adjoint conjugate of `pullbackBaseChangeIso`. -/
def pushforwardIso {X Y : CharPScheme.{u} p} (f : Y ⟶ X) (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) :
    SchemeComparison.pushforward p Y Λ ⋙ SchemeEtale.pushforward f.hom ≅
      DEtale.pushforward (SchemeDiamond.charPStackMap p f) ⋙
        SchemeComparison.pushforward p X Λ :=
  conjugateIsoEquiv ((SchemeEtale.pullbackAdj f.hom).comp (SchemeComparison.adj p Y Λ))
    ((SchemeComparison.adj p X Λ).comp (DEtale.pullbackAdj (SchemeDiamond.charPStackMap p f)))
    (SchemeComparison.pullbackBaseChangeIso p f Λ hΛ)

/-- `Rf_* Rc_{Y*} ≅ Rc_{X*} R(f◇)_*` for adic coefficients. -/
def pushforwardAdicIso {X Y : CharPScheme.{u} p} (f : Y ⟶ X) {Λ : Type u} [CommRing Λ]
    (I : Ideal Λ) (hI : IsAdicCoefficientPair p I) :
    SchemeComparison.pushforwardAdic p Y I ⋙ SchemeAdic.pushforward f.hom I ≅
      AdicSix.pushforward (SchemeDiamond.charPStackMap p f) ⋙
        SchemeComparison.pushforwardAdic p X I :=
  conjugateIsoEquiv ((SchemeAdic.pullbackAdj f.hom I).comp (SchemeComparison.adjAdic p Y I))
    ((SchemeComparison.adjAdic p X I).comp
      (AdicSix.pushAdjunction (SchemeDiamond.charPStackMap p f)))
    (SchemeComparison.pullbackBaseChangeAdicIso p f I hI)

/-- `L3/pushforward-right-adjoint` (ECD Proposition 27.3(ii)): for every map `f : Y → X` of
characteristic-`p` schemes, `Rf_* Rc_{Y*} ≅ Rc_{X*} R(f◇)_*`, by an isomorphism whose forward map
is the conjugate (right-adjoint mate) of the base-change map `(f◇)^* c_X^* → c_Y^* f^*` of ECD
Proposition 27.1. No constructibility is needed. -/
theorem pushforwardRightAdjoint_charP {X Y : CharPScheme.{u} p} (f : Y ⟶ X) (Λ : Type u)
    [CommRing Λ] (hΛ : IsPrimeToPTorsion p Λ) :
    ∃ e : SchemeComparison.pushforward p Y Λ ⋙ SchemeEtale.pushforward f.hom ≅
        DEtale.pushforward (SchemeDiamond.charPStackMap p f) ⋙
          SchemeComparison.pushforward p X Λ,
      e.hom = conjugateEquiv ((SchemeEtale.pullbackAdj f.hom).comp (SchemeComparison.adj p Y Λ))
        ((SchemeComparison.adj p X Λ).comp
          (DEtale.pullbackAdj (SchemeDiamond.charPStackMap p f)))
        (SchemeComparison.pullbackBaseChange p f Λ) :=
  ⟨SchemeComparison.pushforwardIso p f Λ hΛ, rfl⟩

/-- `L3/pushforward-right-adjoint` (ECD Proposition 27.3(ii), adic coefficients). -/
theorem pushforwardRightAdjointAdic_charP {X Y : CharPScheme.{u} p} (f : Y ⟶ X) {Λ : Type u}
    [CommRing Λ] (I : Ideal Λ) (hI : IsAdicCoefficientPair p I) :
    ∃ e : SchemeComparison.pushforwardAdic p Y I ⋙ SchemeAdic.pushforward f.hom I ≅
        AdicSix.pushforward (SchemeDiamond.charPStackMap p f) ⋙
          SchemeComparison.pushforwardAdic p X I,
      e.hom = conjugateEquiv
        ((SchemeAdic.pullbackAdj f.hom I).comp (SchemeComparison.adjAdic p Y I))
        ((SchemeComparison.adjAdic p X I).comp
          (AdicSix.pushAdjunction (SchemeDiamond.charPStackMap p f)))
        (SchemeComparison.pullbackBaseChangeAdic p f I) :=
  ⟨SchemeComparison.pushforwardAdicIso p f I hI, rfl⟩

variable (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] [TopologicalSpace O]
  [IsCompleteDVRBase p O]

/-- `L3/pushforward-right-adjoint` (ECD Proposition 27.3(ii) in the mixed-characteristic range):
for a map `f : Y → X` of `O`-schemes locally of finite type, `Rf_* Rc_{Y*} ≅ Rc_{X*} R(f◇)_*`,
the conjugate of `pullbackBaseChangeDVRIso`. -/
theorem pushforwardRightAdjoint_DVR {X Y : LFTScheme O} (f : Y ⟶ X) (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) :
    ∃ e : SchemeComparison.pushforwardDVR p O Y Λ ⋙ SchemeEtale.pushforward f.hom.left ≅
        DEtale.pushforward (SchemeDiamond.overDVRStackMap p O f) ⋙
          SchemeComparison.pushforwardDVR p O X Λ,
      e.hom = conjugateEquiv
        ((SchemeEtale.pullbackAdj f.hom.left).comp (SchemeComparison.adjDVR p O Y Λ))
        ((SchemeComparison.adjDVR p O X Λ).comp
          (DEtale.pullbackAdj (SchemeDiamond.overDVRStackMap p O f)))
        (SchemeComparison.pullbackBaseChangeDVR p O f Λ) :=
  ⟨conjugateIsoEquiv
    ((SchemeEtale.pullbackAdj f.hom.left).comp (SchemeComparison.adjDVR p O Y Λ))
    ((SchemeComparison.adjDVR p O X Λ).comp
      (DEtale.pullbackAdj (SchemeDiamond.overDVRStackMap p O f)))
    (SchemeComparison.pullbackBaseChangeDVRIso p O f Λ hΛ), rfl⟩

/-- `L3/pushforward-right-adjoint` (ECD Proposition 27.3(ii) over `O`, adic coefficients). -/
theorem pushforwardRightAdjointAdic_DVR {X Y : LFTScheme O} (f : Y ⟶ X) {Λ : Type u}
    [CommRing Λ] (I : Ideal Λ) (hI : IsAdicCoefficientPair p I) :
    ∃ e : SchemeComparison.pushforwardAdicDVR p O Y I ⋙ SchemeAdic.pushforward f.hom.left I ≅
        AdicSix.pushforward (SchemeDiamond.overDVRStackMap p O f) ⋙
          SchemeComparison.pushforwardAdicDVR p O X I,
      e.hom = conjugateEquiv
        ((SchemeAdic.pullbackAdj f.hom.left I).comp (SchemeComparison.adjAdicDVR p O Y I))
        ((SchemeComparison.adjAdicDVR p O X I).comp
          (AdicSix.pushAdjunction (SchemeDiamond.overDVRStackMap p O f)))
        (SchemeComparison.pullbackBaseChangeAdicDVR p O f I) :=
  ⟨conjugateIsoEquiv
    ((SchemeAdic.pullbackAdj f.hom.left I).comp (SchemeComparison.adjAdicDVR p O Y I))
    ((SchemeComparison.adjAdicDVR p O X I).comp
      (AdicSix.pushAdjunction (SchemeDiamond.overDVRStackMap p O f)))
    (SchemeComparison.pullbackBaseChangeAdicDVRIso p O f I hI), rfl⟩

end SchemeComparison

/-! ### L3/rf-shriek-comparison-27-4: characteristic-`p` proper-support comparison

For a separated map `f : Y → X` of finite type between qcqs characteristic-`p` schemes. The case
of the perfection of such a map is transported through perfection: `X_perf◇ ≅ X◇`
(`SchemeDiamond.charP_perfection`) and the étale sites of `X_perf` and `X` agree by topological
invariance, so it is not stated separately. -/

section ShriekComparison

variable (p : ℕ) [Fact p.Prime]

/-- `L3/rf-shriek-comparison-27-4` (ECD Proposition 27.4, geometric part): for a separated map of
finite type `f : Y → X` of characteristic-`p` schemes with `X` qcqs, `f◇` is compactifiable,
representable in locally spatial diamonds and of finite `dim.trg`; this is the eligibility
data. -/
def SchemeDiamond.charPSupportData {X Y : CharPScheme.{u} p} (f : Y ⟶ X) [CompactSpace X.obj]
    [QuasiSeparatedSpace X.obj] [IsSeparated f.hom] [LocallyOfFiniteType f.hom]
    [QuasiCompact f.hom] : SupportData (SchemeDiamond.charPStackMap p f) := sorry

/-- The canonical exchange map `c_X^* Rf_! → R(f◇)_! c_Y^*` (for a compactification
`f = p ∘ j`, the exchange map of `j_!` followed by the proper base-change map of `p`). -/
def SchemeComparison.shriekComparison_charP {X Y : CharPScheme.{u} p} (f : Y ⟶ X)
    [CompactSpace X.obj] [QuasiSeparatedSpace X.obj] [IsSeparated f.hom]
    [LocallyOfFiniteType f.hom] [QuasiCompact f.hom] (Λ : Type u) [CommRing Λ] :
    SchemeSupport.extend f.hom Λ ⋙ SchemeComparison.pullback p X Λ ⟶
      SchemeComparison.pullback p Y Λ ⋙
        DEtale.shriek (SchemeDiamond.charPStackMap p f) (SchemeDiamond.charPSupportData p f) :=
  sorry

/-- `L3/rf-shriek-comparison-27-4` (ECD Proposition 27.4): for a separated map of finite type
`f : Y → X` of characteristic-`p` schemes with `X` qcqs and discrete `Λ` killed by an integer
prime to `p`, the canonical map `c_X^* Rf_! → R(f◇)_! c_Y^*` is an isomorphism, with `Rf_!` the
qcqs support extension. -/
theorem properSupportComparison_charP {X Y : CharPScheme.{u} p} (f : Y ⟶ X)
    [CompactSpace X.obj] [QuasiSeparatedSpace X.obj] [IsSeparated f.hom]
    [LocallyOfFiniteType f.hom] [QuasiCompact f.hom] (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) :
    IsIso (SchemeComparison.shriekComparison_charP p f Λ) :=
  sorry

/-- The canonical exchange map `c_X^* Rf_! → R(f◇)_! c_Y^*` (for a compactification
`f = p ∘ j`, the exchange map of `j_!` followed by the proper base-change map of `p`). -/
def SchemeComparison.shriekComparisonAdic_charP {X Y : CharPScheme.{u} p} (f : Y ⟶ X)
    [CompactSpace X.obj] [QuasiSeparatedSpace X.obj] [IsSeparated f.hom]
    [LocallyOfFiniteType f.hom] [QuasiCompact f.hom] {Λ : Type u} [CommRing Λ] (I : Ideal Λ) :
    SchemeSupport.extendAdic f.hom I ⋙ SchemeComparison.pullbackAdic p X I ⟶
      SchemeComparison.pullbackAdic p Y I ⋙
        AdicSix.support (SchemeDiamond.charPStackMap p f) (SchemeDiamond.charPSupportData p f) :=
  sorry

/-- `L3/rf-shriek-comparison-27-4` (ECD Proposition 27.4, adic coefficients):
`c_X^* Rf_! ≅ R(f◇)_! c_Y^*` for the completed comparison. -/
theorem properSupportComparisonAdic_charP {X Y : CharPScheme.{u} p} (f : Y ⟶ X)
    [CompactSpace X.obj] [QuasiSeparatedSpace X.obj] [IsSeparated f.hom]
    [LocallyOfFiniteType f.hom] [QuasiCompact f.hom] {Λ : Type u} [CommRing Λ] (I : Ideal Λ)
    (hI : IsAdicCoefficientPair p I) :
    IsIso (SchemeComparison.shriekComparisonAdic_charP p f I) :=
  sorry

/-- `L3/rf-shriek-comparison-27-4` (ECD Proposition 27.4, proper case through the canonical map):
for `f` proper, the canonical map `c_X^* Rf_* → R(f◇)_* c_Y^*` is an isomorphism. -/
theorem properPushforwardComparison_charP {X Y : CharPScheme.{u} p} (f : Y ⟶ X)
    [CompactSpace X.obj] [QuasiSeparatedSpace X.obj] [IsProper f.hom] (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) : IsIso (SchemeComparison.pushforwardComparison p f Λ) := sorry

/-- `L3/rf-shriek-comparison-27-4` (ECD Proposition 27.4, right adjoints):
`Rf^! Rc_{X*} ≅ Rc_{Y*} R(f◇)^!`, constructed as the conjugate of the inverse of the canonical map
`shriekComparison_charP` (an isomorphism by `properSupportComparison_charP`) under `Rf_! ⋙ c_X^* ⊣ Rc_{X*} ⋙ Rf^!` and
`c_Y^* ⋙ R(f◇)_! ⊣ R(f◇)^! ⋙ Rc_{Y*}`. (The direction `c_Y^* Rf^! ≅ R(f◇)^! c_X^*` is not
claimed.) -/
theorem upperShriekComparison_charP {X Y : CharPScheme.{u} p} (f : Y ⟶ X)
    [CompactSpace X.obj] [QuasiSeparatedSpace X.obj] [IsSeparated f.hom]
    [LocallyOfFiniteType f.hom] [QuasiCompact f.hom] (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) :
    Nonempty (SchemeComparison.pushforward p X Λ ⋙ SchemeSupport.upperShriek f.hom Λ ≅
      DEtale.upperShriek (SchemeDiamond.charPStackMap p f) (SchemeDiamond.charPSupportData p f) ⋙
        SchemeComparison.pushforward p Y Λ) :=
  ⟨conjugateIsoEquiv ((SchemeSupport.extendAdj f.hom Λ).comp (SchemeComparison.adj p X Λ))
    ((SchemeComparison.adj p Y Λ).comp
      (DEtale.shriekAdj (SchemeDiamond.charPStackMap p f) (SchemeDiamond.charPSupportData p f)))
    (haveI := properSupportComparison_charP p f Λ hΛ; asIso (SchemeComparison.shriekComparison_charP p f Λ)).symm⟩

/-- `L3/rf-shriek-comparison-27-4` (ECD Proposition 27.4, right adjoints, adic coefficients). -/
theorem upperShriekComparisonAdic_charP {X Y : CharPScheme.{u} p} (f : Y ⟶ X)
    [CompactSpace X.obj] [QuasiSeparatedSpace X.obj] [IsSeparated f.hom]
    [LocallyOfFiniteType f.hom] [QuasiCompact f.hom] {Λ : Type u} [CommRing Λ] (I : Ideal Λ)
    (hI : IsAdicCoefficientPair p I) :
    Nonempty (SchemeComparison.pushforwardAdic p X I ⋙ SchemeSupport.upperShriekAdic f.hom I ≅
      AdicSix.upperShriek (SchemeDiamond.charPStackMap p f)
          (SchemeDiamond.charPSupportData p f) ⋙
        SchemeComparison.pushforwardAdic p Y I) :=
  ⟨conjugateIsoEquiv
    ((SchemeSupport.extendAdicAdj f.hom I).comp (SchemeComparison.adjAdic p X I))
    ((SchemeComparison.adjAdic p Y I).comp
      (AdicSix.shriekAdjunction (SchemeDiamond.charPStackMap p f)
        (SchemeDiamond.charPSupportData p f)))
    (haveI := properSupportComparisonAdic_charP p f I hI; asIso (SchemeComparison.shriekComparisonAdic_charP p f I)).symm⟩

end ShriekComparison

/-! ### L4/analytic-test-space: the analytic test space over a DVR

`O⟦x⟧` carries the coefficientwise topology of Mathlib's `PowerSeries.WithPiTopology`; when `O`
carries its `π`-adic topology this is the `(π, x)`-adic topology. The test space is
`T = {x ≠ 0} ⊂ Spa(O⟦x⟧, O⟦x⟧)` with its structure map to `Spa(O, O)`. -/

section TestSpace

open scoped PowerSeries.WithPiTopology

variable (p : ℕ) [Fact p.Prime] (O : Type u) [CommRing O] [IsDomain O]
  [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O]

/-- `DVRTestSpace.mk`: for a uniformiser `π` of `O`, the analytic adic space
`T = {x ≠ 0} ⊂ Spa(O⟦x⟧, O⟦x⟧)`, the analytic locus `x ≠ 0` of the noetherian formal chart
`Spf O⟦x⟧` with its `(π, x)`-adic rational charts, together with its structure map to
`Spa(O, O)`. -/
def DVRTestSpace.mk (p : ℕ) [Fact p.Prime] (O : Type u) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O] (π : O)
    (hπ : Irreducible π) : Over (adicSpectrum O ⊤) := sorry

/-- The points of `T` inside Tau Ceti's `Spa(O⟦x⟧, O⟦x⟧)`: the continuous valuations, bounded by
`1` on `O⟦x⟧`, that do not vanish at `x`. -/
def DVRTestSpace.pointSet : Set (TauCeti.ValuationSpectrum (PowerSeries O)) :=
  TauCeti.ValuationSpectrum.spa (⊤ : Subring (PowerSeries O)) ∩
    {v | ¬ v.toValuativeRel.vle PowerSeries.X 0}

/-- The underlying topological space of `DVRTestSpace.mk` is the subspace `DVRTestSpace.pointSet`
of Tau Ceti's `Spa(O⟦x⟧, O⟦x⟧)`. -/
theorem DVRTestSpace.points (π : O) (hπ : Irreducible π) :
    Nonempty ((AdicSpace.toLocallyRingedSpace.obj (DVRTestSpace.mk p O π hπ).left).carrier ≃ₜ
      DVRTestSpace.pointSet O) := sorry

/-- `DVRTestSpace.analytic`: `T` is analytic. At the level of points: every point `v` of `T` is
analytic in the sense of Wedhorn Definition 7.39 (its support is not open, i.e. some element of
the ideal of definition `(π, x)`, namely `x`, has nonzero value), and `v` lies in a rational
subset `{v(πⁿ) ≤ v(x) ≠ 0}`, on which `x` becomes a topologically nilpotent unit. -/
theorem DVRTestSpace.analytic (π : O) (hπ : Irreducible π) :
    ∀ v ∈ DVRTestSpace.pointSet O, ¬ IsOpen (v.supp : Set (PowerSeries O)) ∧
      ∃ n : ℕ, v ∈ TauCeti.ValuationSpectrum.basicOpen (PowerSeries.C π ^ n) PowerSeries.X :=
  sorry

/-- The structure map `T◇ → Spd O` as a map of small v-stacks. -/
abbrev DVRTestSpace.coverMap (π : O) (hπ : Irreducible π) :
    (SmallVSheaf.toStack p).obj ((AdicSpace.diamond p).obj (DVRTestSpace.mk p O π hπ).left) ⟶
      (SmallVSheaf.toStack p).obj (spd p O ⊤) :=
  (SmallVSheaf.toStack p).map ((AdicSpace.diamond p).map (DVRTestSpace.mk p O π hπ).hom)

/-- `DVRTestSpace.diamondCover`: for a prime `ℓ ≠ p`, `T◇ → Spd O` is `ℓ`-cohomologically smooth.
`Spd O` is not analytic, so ECD Proposition 24.4 is applied only to the base changes
`T◇ ×_{Spd O} S` over perfectoid `S → Spd O`, which are diamonds of punctured open unit discs over
`S♯`; ECD Definition 23.8 tests smoothness after such base changes. -/
def DVRTestSpace.diamondCover (π : O) (hπ : Irreducible π) (ℓ : ℕ) [Fact ℓ.Prime]
    (hℓ : ℓ ≠ p) : CohSmoothData ℓ (DVRTestSpace.coverMap p O π hπ) := sorry

/-- `DVRTestSpace.diamondCover`, surjectivity: `T◇ → Spd O` is an epimorphism of small v-sheaves
(over a perfectoid field point, choose for `x` a nonzero topologically nilpotent element). -/
theorem DVRTestSpace.diamondCover_epi (π : O) (hπ : Irreducible π) :
    Epi ((AdicSpace.diamond p).map (DVRTestSpace.mk p O π hπ).hom) := sorry

/-- `DVRTestSpace.conservative`: after any base change `S → Spd O`, pullback along the base change
`T◇ ×_{Spd O} S → S` of the cover reflects isomorphisms on `D_ét`. -/
theorem DVRTestSpace.conservative (π : O) (hπ : Irreducible π) {Λ : Type u} [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) {S : SmallVStack.{u} p}
    (g : S ⟶ (SmallVSheaf.toStack p).obj (spd p O ⊤)) :
    (DEtale.pullback (Λ := Λ) (Limits.pullback.snd (DVRTestSpace.coverMap p O π hπ) g)).ReflectsIsomorphisms :=
  sorry

/-- `DVRTestSpace.fibreProduct`: for `X` locally of finite type over `O`,
`(X ×_{Spec O} T)◇ ≅ X◇ ×_{Spd O} T◇`, naturally in `X`, with the relative analytification over
the locally noetherian adic space `T`. -/
theorem DVRTestSpace.fibreProduct (π : O) (hπ : Irreducible π) :
    Nonempty (relativeAnalytification (DVRTestSpace.mk p O π hπ) ⋙ AdicSpace.diamond p ≅
      SchemeDiamond.overDVR p O ⋙
        Over.pullback ((AdicSpace.diamond p).map (DVRTestSpace.mk p O π hπ).hom) ⋙
          Over.forget _) := sorry

/-- `Spec O` as an `O`-scheme locally of finite type (structure map the identity). -/
def LFTScheme.specBase (O : Type u) [CommRing O] : LFTScheme O :=
  ⟨Over.mk (𝟙 (Spec (CommRingCat.of O))),
    show LocallyOfFiniteType (𝟙 (Spec (CommRingCat.of O))) from inferInstance⟩

/- Test `DVRTestSpace.base` (degenerate): for `X = Spec O`, whose v-sheaf is `Spd O`, the fibre
product `X◇ ×_{Spd O} T◇` is `T◇` itself, through the first projection, and so is the diamond of
`Spec O ×_{Spec O} T = T`. -/
example (π : O) (hπ : Irreducible π) :
    IsIso (Limits.pullback.snd ((SchemeDiamond.overDVR p O).obj (LFTScheme.specBase O)).hom
        ((AdicSpace.diamond p).map (DVRTestSpace.mk p O π hπ).hom)) ∧
      Nonempty ((relativeAnalytification (DVRTestSpace.mk p O π hπ)).obj (LFTScheme.specBase O) ≅
        (DVRTestSpace.mk p O π hπ).left) := sorry

/- Test `DVRTestSpace.special` (computation): `T` has a point over the special fibre: a point
`v` with `v(π) = 0` at which `x` has a nonzero topologically nilpotent value (for instance the
`x`-adic valuation of `k((x))`). -/
example (π : O) (hπ : Irreducible π) :
    ∃ v ∈ DVRTestSpace.pointSet O, PowerSeries.C π ∈ v.supp ∧
      v.toValuativeRel.vlt PowerSeries.X 1 := sorry

/- Test `DVRTestSpace.generic` (computation): `T` has a point over the generic fibre: a point `v`
with `v(π) ≠ 0` at which both `π` and `x` are topologically nilpotent and `x` is nonzero. -/
example (π : O) (hπ : Irreducible π) :
    ∃ v ∈ DVRTestSpace.pointSet O, PowerSeries.C π ∉ v.supp ∧
      v.toValuativeRel.vlt (PowerSeries.C π) 1 ∧ v.toValuativeRel.vlt PowerSeries.X 1 := sorry

/- Test `DVRTestSpace.zeroExcluded` (non-example): the ambient `Spa(O⟦x⟧, O⟦x⟧)` has points with
`v(x) = 0` (for instance the trivial valuation with support `(π, x)`), and no such point lies
in `T`. -/
example : (∃ v ∈ TauCeti.ValuationSpectrum.spa (⊤ : Subring (PowerSeries O)),
      (PowerSeries.X : PowerSeries O) ∈ v.supp) ∧
    ∀ v : TauCeti.ValuationSpectrum (PowerSeries O),
      (PowerSeries.X : PowerSeries O) ∈ v.supp → v ∉ DVRTestSpace.pointSet O := by
  refine ⟨sorry, fun v hv hmem => hmem.2 ?_⟩
  exact (TauCeti.ValuationSpectrum.mem_supp_iff v _).1 hv

end TestSpace

/-! ### L4/proper-support-comparison-27-5: mixed-characteristic proper-support comparison

For a separated map `f : Y → X` between `O`-schemes of finite type (not merely locally of finite
type). The instance arguments `[CompactSpace X.obj.left] [QuasiSeparatedSpace X.obj.left]
[LocallyOfFiniteType f.hom.left] [QuasiCompact f.hom.left]` required by `SchemeSupport.extend` are
consequences of the finite-type hypotheses (`Spec O` is noetherian); they are listed so that the
support functor can be formed. No full faithfulness is claimed. -/

section MixedShriek

variable (p : ℕ) [Fact p.Prime] (O : Type u) [CommRing O] [IsDomain O]
  [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O]

/-- `L4/proper-support-comparison-27-5` (ECD Proposition 27.5, geometric part): for a separated
map `f : Y → X` of `O`-schemes of finite type, `f◇` is compactifiable, representable in locally
spatial diamonds and of finite `dim.trg` (checked after base change to perfectoid `S → Spd O`,
where `f◇` becomes the diamond of the analytified map over `S♯`); this is the eligibility data. -/
def SchemeDiamond.overDVRSupportData {X Y : LFTScheme O} (f : Y ⟶ X) [QuasiCompact X.obj.hom]
    [QuasiCompact Y.obj.hom] [IsSeparated f.hom.left] :
    SupportData (SchemeDiamond.overDVRStackMap p O f) := sorry

/-- The canonical exchange map `c_X^* Rf_! → R(f◇)_! c_Y^*` (for a compactification
`f = p ∘ j`, the exchange map of `j_!` followed by the proper base-change map of `p`). -/
def SchemeComparison.shriekComparison_DVR {X Y : LFTScheme O} (f : Y ⟶ X) [QuasiCompact X.obj.hom]
    [QuasiCompact Y.obj.hom] [IsSeparated f.hom.left] [CompactSpace X.obj.left]
    [QuasiSeparatedSpace X.obj.left] [LocallyOfFiniteType f.hom.left] [QuasiCompact f.hom.left]
    (Λ : Type u) [CommRing Λ] :
    SchemeSupport.extend f.hom.left Λ ⋙ SchemeComparison.pullbackDVR p O X Λ ⟶
      SchemeComparison.pullbackDVR p O Y Λ ⋙
        DEtale.shriek (SchemeDiamond.overDVRStackMap p O f)
          (SchemeDiamond.overDVRSupportData p O f) :=
  sorry

/-- `L4/proper-support-comparison-27-5` (ECD Proposition 27.5): for a separated map `f : Y → X`
of `O`-schemes of finite type and discrete `Λ` killed by an integer prime to `p`,
`c_X^* Rf_! ≅ R(f◇)_! c_Y^*`. -/
theorem properSupportComparison_DVR {X Y : LFTScheme O} (f : Y ⟶ X) [QuasiCompact X.obj.hom]
    [QuasiCompact Y.obj.hom] [IsSeparated f.hom.left] [CompactSpace X.obj.left]
    [QuasiSeparatedSpace X.obj.left] [LocallyOfFiniteType f.hom.left] [QuasiCompact f.hom.left]
    (Λ : Type u) [CommRing Λ] (hΛ : IsPrimeToPTorsion p Λ) :
    IsIso (SchemeComparison.shriekComparison_DVR p O f Λ) :=
  sorry

/-- The canonical exchange map `c_X^* Rf_! → R(f◇)_! c_Y^*` (for a compactification
`f = p ∘ j`, the exchange map of `j_!` followed by the proper base-change map of `p`). -/
def SchemeComparison.shriekComparisonAdic_DVR {X Y : LFTScheme O} (f : Y ⟶ X)
    [QuasiCompact X.obj.hom] [QuasiCompact Y.obj.hom] [IsSeparated f.hom.left]
    [CompactSpace X.obj.left] [QuasiSeparatedSpace X.obj.left] [LocallyOfFiniteType f.hom.left]
    [QuasiCompact f.hom.left] {Λ : Type u} [CommRing Λ] (I : Ideal Λ) :
    SchemeSupport.extendAdic f.hom.left I ⋙ SchemeComparison.pullbackAdicDVR p O X I ⟶
      SchemeComparison.pullbackAdicDVR p O Y I ⋙
        AdicSix.support (SchemeDiamond.overDVRStackMap p O f)
          (SchemeDiamond.overDVRSupportData p O f) :=
  sorry

/-- `L4/proper-support-comparison-27-5` (ECD Proposition 27.5, adic coefficients). -/
theorem properSupportComparisonAdic_DVR {X Y : LFTScheme O} (f : Y ⟶ X)
    [QuasiCompact X.obj.hom] [QuasiCompact Y.obj.hom] [IsSeparated f.hom.left]
    [CompactSpace X.obj.left] [QuasiSeparatedSpace X.obj.left] [LocallyOfFiniteType f.hom.left]
    [QuasiCompact f.hom.left] {Λ : Type u} [CommRing Λ] (I : Ideal Λ)
    (hI : IsAdicCoefficientPair p I) :
    IsIso (SchemeComparison.shriekComparisonAdic_DVR p O f I) :=
  sorry

/-- `L4/proper-support-comparison-27-5` (ECD Proposition 27.5, proper case through the canonical
map): for `f` proper between `O`-schemes of finite type, the canonical base-change map
`c_X^* Rf_* → R(f◇)_* c_Y^*` is an isomorphism. (Proved after pullback to the conservative test
space `DVRTestSpace.mk`, using Huber's proper base change.) -/
theorem properPushforwardComparison_DVR {X Y : LFTScheme O} (f : Y ⟶ X)
    [QuasiCompact X.obj.hom] [IsProper f.hom.left] (Λ : Type u) [CommRing Λ]
    (hΛ : IsPrimeToPTorsion p Λ) : IsIso (SchemeComparison.pushforwardComparisonDVR p O f Λ) :=
  sorry

/-- `L4/proper-support-comparison-27-5` (ECD Proposition 27.5, right adjoints):
`Rf^! Rc_{X*} ≅ Rc_{Y*} R(f◇)^!`, the conjugate of the inverse of the canonical map
`shriekComparison_DVR` (an isomorphism by `properSupportComparison_DVR`). -/
theorem upperShriekComparison_DVR {X Y : LFTScheme O} (f : Y ⟶ X) [QuasiCompact X.obj.hom]
    [QuasiCompact Y.obj.hom] [IsSeparated f.hom.left] [CompactSpace X.obj.left]
    [QuasiSeparatedSpace X.obj.left] [LocallyOfFiniteType f.hom.left] [QuasiCompact f.hom.left]
    (Λ : Type u) [CommRing Λ] (hΛ : IsPrimeToPTorsion p Λ) :
    Nonempty (SchemeComparison.pushforwardDVR p O X Λ ⋙ SchemeSupport.upperShriek f.hom.left Λ ≅
      DEtale.upperShriek (SchemeDiamond.overDVRStackMap p O f)
          (SchemeDiamond.overDVRSupportData p O f) ⋙
        SchemeComparison.pushforwardDVR p O Y Λ) :=
  ⟨conjugateIsoEquiv
    ((SchemeSupport.extendAdj f.hom.left Λ).comp (SchemeComparison.adjDVR p O X Λ))
    ((SchemeComparison.adjDVR p O Y Λ).comp
      (DEtale.shriekAdj (SchemeDiamond.overDVRStackMap p O f)
        (SchemeDiamond.overDVRSupportData p O f)))
    (haveI := properSupportComparison_DVR p O f Λ hΛ; asIso (SchemeComparison.shriekComparison_DVR p O f Λ)).symm⟩

/-- `L4/proper-support-comparison-27-5` (ECD Proposition 27.5, right adjoints, adic
coefficients). -/
theorem upperShriekComparisonAdic_DVR {X Y : LFTScheme O} (f : Y ⟶ X)
    [QuasiCompact X.obj.hom] [QuasiCompact Y.obj.hom] [IsSeparated f.hom.left]
    [CompactSpace X.obj.left] [QuasiSeparatedSpace X.obj.left] [LocallyOfFiniteType f.hom.left]
    [QuasiCompact f.hom.left] {Λ : Type u} [CommRing Λ] (I : Ideal Λ)
    (hI : IsAdicCoefficientPair p I) :
    Nonempty (SchemeComparison.pushforwardAdicDVR p O X I ⋙
        SchemeSupport.upperShriekAdic f.hom.left I ≅
      AdicSix.upperShriek (SchemeDiamond.overDVRStackMap p O f)
          (SchemeDiamond.overDVRSupportData p O f) ⋙
        SchemeComparison.pushforwardAdicDVR p O Y I) :=
  ⟨conjugateIsoEquiv
    ((SchemeSupport.extendAdicAdj f.hom.left I).comp (SchemeComparison.adjAdicDVR p O X I))
    ((SchemeComparison.adjAdicDVR p O Y I).comp
      (AdicSix.shriekAdjunction (SchemeDiamond.overDVRStackMap p O f)
        (SchemeDiamond.overDVRSupportData p O f)))
    (haveI := properSupportComparisonAdic_DVR p O f I hI; asIso (SchemeComparison.shriekComparisonAdic_DVR p O f I)).symm⟩

end MixedShriek

/-! #### Traits and generic fibres as `O`-schemes -/

section Traits

/-- `Spec K` for the fraction field `K` of a discrete valuation ring `O`, as an `O`-scheme locally
of finite type (`K = O[1/π]` is a finitely generated `O`-algebra; that proof is omitted). -/
def LFTScheme.specFraction (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] :
    LFTScheme O :=
  haveI : Algebra.FiniteType O (FractionRing O) := sorry
  LFTScheme.spec O (FractionRing O)

/-- `Spec k` for the residue field `k` of `O`, as an `O`-scheme locally of finite type. -/
def LFTScheme.specResidue (O : Type u) [CommRing O] [IsLocalRing O] : LFTScheme O :=
  haveI : Algebra.FiniteType O (IsLocalRing.ResidueField O) :=
    Algebra.FiniteType.of_surjective (Algebra.ofId O _) IsLocalRing.residue_surjective
  LFTScheme.spec O (IsLocalRing.ResidueField O)

/-- The open immersion `j : Spec K ↪ Spec O` of the generic point of the trait. -/
def LFTScheme.traitOpen (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] :
    LFTScheme.specFraction O ⟶ LFTScheme.specBase O :=
  ObjectProperty.homMk (Over.homMk (LFTScheme.specFraction O).obj.hom (Category.comp_id _))

/-- The closed immersion `i : Spec k ↪ Spec O` of the closed point of the trait. -/
def LFTScheme.traitClosed (O : Type u) [CommRing O] [IsLocalRing O] :
    LFTScheme.specResidue O ⟶ LFTScheme.specBase O :=
  ObjectProperty.homMk (Over.homMk (LFTScheme.specResidue O).obj.hom (Category.comp_id _))

/-- The generic fibre `X_η = X ×_{Spec O} Spec K` of an `O`-scheme, as an `O`-scheme locally of
finite type. -/
def LFTScheme.genericFibre {O : Type u} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    (X : LFTScheme O) : LFTScheme O :=
  ⟨Over.mk (Limits.pullback.snd X.obj.hom (LFTScheme.specFraction O).obj.hom ≫
      (LFTScheme.specFraction O).obj.hom), by
    have : LocallyOfFiniteType X.obj.hom := X.property
    have : LocallyOfFiniteType (LFTScheme.specFraction O).obj.hom :=
      (LFTScheme.specFraction O).property
    change LocallyOfFiniteType (Limits.pullback.snd _ _ ≫ _)
    infer_instance⟩

/-- The inclusion `X_η ↪ X` of the generic fibre. -/
def LFTScheme.genericFibreι {O : Type u} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    (X : LFTScheme O) : LFTScheme.genericFibre X ⟶ X :=
  ObjectProperty.homMk
    (Over.homMk (Limits.pullback.fst X.obj.hom (LFTScheme.specFraction O).obj.hom)
      Limits.pullback.condition)

end Traits

/-! ### L5/alteration-hypercover-descent: proper alteration hypercovers -/

section Alterations

variable (p : ℕ) [Fact p.Prime] (O : Type u) [CommRing O] [IsDomain O]
  [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O]

/-- The levelwise comparison `(c_{X_n}^*)_n` on cartesian complexes: the comparison functors of
the levels, made cartesian by the base-change isomorphisms of ECD Proposition 27.1 for the face
and degeneracy maps. -/
def CartesianSchemeEtale.comparison {X : LFTScheme O} (H : AlterationHypercover X) (Λ : Type u)
    [CommRing Λ] : CartesianSchemeEtale H Λ ⥤ CartesianDEtale p H Λ := sorry

/-- `L5/alteration-hypercover-descent`: let `X` be of finite type over `O` and `Λ` finite, killed
by an integer prime to `p`. Proper hypercovers of `X` by alterations exist, and for each of them
(i) pullback along `X_• → X` identifies `D̂(X_ét, Λ)` with cartesian complexes on `X_•`;
(ii) pullback along `X_•◇ → X◇` identifies `D_ét(X◇, Λ)` with cartesian objects on `X_•◇` (proper
surjections give v-covers); (iii) the two descent equivalences intertwine `c_X^*` with the
levelwise comparison. The alteration degrees may be divisible by the primes dividing the order of
`Λ`: no trace splitting is used. -/
theorem alterationHypercoverDescent (X : LFTScheme O) [QuasiCompact X.obj.hom] (Λ : Type u)
    [CommRing Λ] [Finite Λ] (hΛ : IsPrimeToPTorsion p Λ) :
    Nonempty (AlterationHypercover X) ∧
      ∀ H : AlterationHypercover X,
        (CartesianSchemeEtale.descentPullback H Λ).IsEquivalence ∧
        (CartesianDEtale.descentPullback p H Λ).IsEquivalence ∧
        Nonempty (CartesianSchemeEtale.descentPullback H Λ ⋙
            CartesianSchemeEtale.comparison p O H Λ ≅
          SchemeComparison.pullbackDVR p O X Λ ⋙ CartesianDEtale.descentPullback p H Λ) :=
  sorry

/-- `L5/alteration-hypercover-descent` (detection on the augmentation): if for every level `X_n`
of an alteration hypercover the unit of `c_{X_n}^* ⊣ Rc_{X_n *}` is an isomorphism at the
pullback of `A`, then the unit for `X` is an isomorphism at `A`. -/
theorem alterationHypercover_detectsUnit (X : LFTScheme O) [QuasiCompact X.obj.hom] (Λ : Type u)
    [CommRing Λ] [Finite Λ] (hΛ : IsPrimeToPTorsion p Λ) (H : AlterationHypercover X)
    (A : SchemeEtale X.obj.left Λ)
    (hA : ∀ n : ℕ, IsIso ((SchemeComparison.adjDVR p O
        (H.simplicial.obj (op (SimplexCategory.mk n))) Λ).unit.app
          ((SchemeEtale.pullback (H.augmentation.app (op (SimplexCategory.mk n))).hom.left).obj
            A))) :
    IsIso ((SchemeComparison.adjDVR p O X Λ).unit.app A) := sorry

end Alterations

/-! ### L5/normal-crossing-local-comparison: normal-crossing boundary comparison

`F` is a field of finite type over `O`; equivalently a finite extension of the residue field `k`
or of the fraction field `K` of `O` (in equal characteristic `F` may be imperfect). The
compatibility of the comparison with the Kummer generators, cup products and residues is part of
the proof and is not stated separately. -/

section NormalCrossings

variable (p : ℕ) [Fact p.Prime] (O : Type u) [CommRing O] [IsDomain O]
  [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O]

/-- The number `r` of boundary components through a geometric point `x : Spec κ → X` (the number
of boundary parameters of a strictly henselian chart at `x`). -/
def SNCBoundary.branchCount {F : Type u} [Field F] {X U : LFTScheme O}
    {g : X.obj.left ⟶ Spec (CommRingCat.of F)} {j : U ⟶ X} (D : SNCBoundary g j) {κ : Type u}
    [Field κ] (x : Spec (CommRingCat.of κ) ⟶ X.obj.left) : ℕ :=
  Nat.card {i : Fin D.numComponents //
    ∃ y : Spec (CommRingCat.of κ) ⟶ (D.component i).obj.left, y ≫ (D.componentι i).hom.left = x}

/-- The number of boundary components through a geometric point `s : Spd C → X◇`. -/
def SNCBoundary.branchCountDiamond {F : Type u} [Field F] {X U : LFTScheme O}
    {g : X.obj.left ⟶ Spec (CommRingCat.of F)} {j : U ⟶ X} (D : SNCBoundary g j) {C : Type u}
    [NontriviallyNormedField C] [IsUltrametricDist C] [CompleteSpace C] [IsAlgClosed C]
    [CharP C p] (s : (SmallVSheaf.toStack p).obj (geomPoint p C) ⟶ SchemeDiamond.overDVRStack p O X) :
    ℕ :=
  Nat.card {i : Fin D.numComponents //
    ∃ t : (SmallVSheaf.toStack p).obj (geomPoint p C) ⟶
        SchemeDiamond.overDVRStack p O (D.component i),
      t ≫ SchemeDiamond.overDVRStackMap p O (D.componentι i) = s}

/-- `L5/normal-crossing-local-comparison` (proof of ECD Proposition 27.6): let `X` be smooth over a
field `F` of finite type over `O`, `j : U ↪ X` the complement of a strict normal crossings divisor
and `Λ` finite, killed by an integer prime to `p`. Then the canonical comparison
`c_X^* Rj_* Λ → R(j◇)_* Λ` becomes an isomorphism after pullback along the base change
`X◇ ×_{Spd O} T◇ → X◇` of the analytic test space. -/
theorem normalCrossingComparison (π : O) (hπ : Irreducible π) (F : Type u) [Field F]
    [Algebra O F] [Algebra.FiniteType O F] {X U : LFTScheme O}
    (g : X.obj.left ⟶ Spec (CommRingCat.of F))
    (hg : g ≫ Spec.map (CommRingCat.ofHom (algebraMap O F)) = X.obj.hom) [Smooth g]
    (j : U ⟶ X) [IsOpenImmersion j.hom.left] (D : SNCBoundary g j) (Λ : Type u) [CommRing Λ]
    [Finite Λ] (hΛ : IsPrimeToPTorsion p Λ) :
    IsIso ((DEtale.pullback (Limits.pullback.snd (DVRTestSpace.coverMap p O π hπ)
        (SchemeDiamond.overDVRStackStructure p O X))).map
      ((SchemeComparison.pushforwardComparisonDVR p O j Λ).app (𝟙_ (SchemeEtale U.obj.left Λ)))) :=
  sorry

/-- `L5/normal-crossing-local-comparison` (local computation, both sides): with `X`, `j`, `D` as
in `normalCrossingComparison`, `Λ` killed by `n` prime to `p` and `q ≥ 0`: at a geometric point
`x : Spec κ → X` lying on exactly `r` boundary components, `Hᑫ((Rj_* Λ)_x) ≅ ⋀ᑫ (Λ(-1)ʳ)`,
where `Λ(-1) = Hom(μ_n(κ), Λ)` is spanned by the Kummer classes of the `r` boundary parameters;
and at a geometric point `s : Spd C → X◇` lying on exactly `r` components of `D◇`,
`Hᑫ((R(j◇)_* Λ)_s) ≅ ⋀ᑫ (Λ(-1)ʳ)` with `Λ(-1) = Hom(μ_n(C), Λ)`. -/
theorem normalCrossingStalks (F : Type u) [Field F] [Algebra O F] [Algebra.FiniteType O F]
    {X U : LFTScheme O} (g : X.obj.left ⟶ Spec (CommRingCat.of F))
    (hg : g ≫ Spec.map (CommRingCat.ofHom (algebraMap O F)) = X.obj.hom) [Smooth g]
    (j : U ⟶ X) [IsOpenImmersion j.hom.left] (D : SNCBoundary g j) (Λ : Type u) [CommRing Λ]
    [Finite Λ] (n : ℕ) (hn : n.Coprime p) (hnΛ : (n : Λ) = 0) (q : ℕ) :
    (∀ (κ : Type u) [Field κ] [IsSepClosed κ] (x : Spec (CommRingCat.of κ) ⟶ X.obj.left),
      Nonempty ((SchemeEtale.stalkCohomology (q : ℤ) x).obj
          ((SchemeEtale.pushforward j.hom.left).obj (𝟙_ (SchemeEtale U.obj.left Λ))) ≅
        ModuleCat.of Λ (⋀[Λ]^q (Fin (D.branchCount O x) →
          (Additive (rootsOfUnity n κ) →+ Λ))))) ∧
    ∀ (C : Type u) [NontriviallyNormedField C] [IsUltrametricDist C] [CompleteSpace C]
      [IsAlgClosed C] [CharP C p]
      (s : (SmallVSheaf.toStack p).obj (geomPoint p C) ⟶ SchemeDiamond.overDVRStack p O X),
      Nonempty ((DEtale.stalkCohomology (q : ℤ) s).obj
          ((DEtale.pushforward (SchemeDiamond.overDVRStackMap p O j)).obj
            (𝟙_ (DEtale (SchemeDiamond.overDVRStack p O U) Λ))) ≅
        ModuleCat.of Λ (⋀[Λ]^q (Fin (D.branchCountDiamond p O s) →
          (Additive (rootsOfUnity n C) →+ Λ)))) := sorry

end NormalCrossings

/-! ### L6/trait-open-comparison: the punctured trait -/

section Trait

variable (p : ℕ) [Fact p.Prime] (O : Type u) [CommRing O] [IsDomain O]
  [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O]

/-- `L6/trait-open-comparison` (proofs of ECD Propositions 27.6–27.7): for `j : Spec K ↪ Spec O`,
`Λ` finite and killed by an integer prime to `p`, and `M` a finite `Λ`-module with a continuous
(open-stabiliser) action of `G_K`, the comparison `c_O^* Rj_* M → R(j◇)_* c_K^* M` is an
isomorphism. -/
theorem traitOpenComparison (Λ : Type u) [CommRing Λ] [Finite Λ] (hΛ : IsPrimeToPTorsion p Λ)
    {M : Type u} [AddCommGroup M] [Module Λ M] [Module.Finite Λ M]
    (ρ : Representation Λ (Field.absoluteGaloisGroup (FractionRing O)) M)
    (hρ : ∀ m : M, IsOpen {σ : Field.absoluteGaloisGroup (FractionRing O) | ρ σ m = m}) :
    IsIso ((SchemeComparison.pushforwardComparisonDVR p O (LFTScheme.traitOpen O) Λ).app
      (SchemeEtale.ofGaloisModule (FractionRing O) ρ hρ)) := sorry

/-- `L6/trait-open-comparison` (closed stalks): with the hypotheses of `traitOpenComparison`, the
restriction of `Rj_* M` to the closed point `Spec k` is `RΓ(I_K, M)` with its residual
`G_k`-action (inertia cohomology, not `G_K`-cohomology), and the restriction of `R(j◇)_* c_K^* M`
to the closed point of `Spd O` is the pullback of the same complex, and the restriction of the
comparison map to the closed point is the identity of that complex under these identifications
and the base-change isomorphism of `c^*`. (At geometric generic points both sides are `M`; this
is formal, by restriction of `Rj_*` to the open.) -/
theorem traitClosedStalk (Λ : Type u) [CommRing Λ] [Finite Λ] (hΛ : IsPrimeToPTorsion p Λ)
    {M : Type u} [AddCommGroup M] [Module Λ M] [Module.Finite Λ M]
    (ρ : Representation Λ (Field.absoluteGaloisGroup (FractionRing O)) M)
    (hρ : ∀ m : M, IsOpen {σ : Field.absoluteGaloisGroup (FractionRing O) | ρ σ m = m}) :
    ∃ (e₁ : (SchemeEtale.pullback (LFTScheme.traitClosed O).hom.left).obj
        ((SchemeEtale.pushforward (LFTScheme.traitOpen O).hom.left).obj
          (SchemeEtale.ofGaloisModule (FractionRing O) ρ hρ)) ≅ inertiaCohomology O ρ hρ)
      (e₂ : (DEtale.pullback (SchemeDiamond.overDVRStackMap p O (LFTScheme.traitClosed O))).obj
        ((DEtale.pushforward (SchemeDiamond.overDVRStackMap p O (LFTScheme.traitOpen O))).obj
          ((SchemeComparison.pullbackDVR p O (LFTScheme.specFraction O) Λ).obj
            (SchemeEtale.ofGaloisModule (FractionRing O) ρ hρ))) ≅
        (SchemeComparison.pullbackDVR p O (LFTScheme.specResidue O) Λ).obj
          (inertiaCohomology O ρ hρ)),
      (DEtale.pullback (SchemeDiamond.overDVRStackMap p O (LFTScheme.traitClosed O))).map
          ((SchemeComparison.pushforwardComparisonDVR p O (LFTScheme.traitOpen O) Λ).app
            (SchemeEtale.ofGaloisModule (FractionRing O) ρ hρ)) ≫ e₂.hom =
        ((SchemeComparison.pullbackBaseChangeDVRIso p O (LFTScheme.traitClosed O) Λ hΛ).app
            ((SchemeEtale.pushforward (LFTScheme.traitOpen O).hom.left).obj
              (SchemeEtale.ofGaloisModule (FractionRing O) ρ hρ))).hom ≫
          (SchemeComparison.pullbackDVR p O (LFTScheme.specResidue O) Λ).map e₁.hom := sorry

end Trait

/-! ### L6/semistable-boundary-induction: strictly semistable models -/

section Semistable

variable (p : ℕ) [Fact p.Prime] (O : Type u) [CommRing O] [IsDomain O]
  [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O]

/-- `L6/semistable-boundary-induction` (proof of ECD Proposition 27.6): for a proper strictly
semistable `O`-scheme `X` (reached after a finite extension of the trait, whose residue field stays
perfect) and constant coefficients `Λ`, finite and killed by an integer prime to `p`, the
comparison for the inclusion `X_η ↪ X` of the generic fibre is an isomorphism at the constant
sheaf `Λ`. -/
theorem semistableComparison (X : LFTScheme O) [IsProper X.obj.hom]
    (hX : StrictlySemistableData X) (Λ : Type u) [CommRing Λ] [Finite Λ]
    (hΛ : IsPrimeToPTorsion p Λ) :
    IsIso ((SchemeComparison.pushforwardComparisonDVR p O (LFTScheme.genericFibreι X) Λ).app
      (𝟙_ (SchemeEtale (LFTScheme.genericFibre X).obj.left Λ))) := sorry

end Semistable

/-! ### L6/constructible-direct-image-comparison-27-6: direct images of constructible complexes -/

section Constructible

variable (p : ℕ) [Fact p.Prime] (O : Type u) [CommRing O] [IsDomain O]
  [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O]

/-- `L6/constructible-direct-image-comparison-27-6` (ECD Proposition 27.6): for a separated map
`f : Y → X` of `O`-schemes of finite type (`O` of mixed or equal characteristic) and a finite ring
`Λ` killed by an integer prime to `p`, the canonical map `c_X^* Rf_* A → R(f◇)_* c_Y^* A` is an
isomorphism for every bounded constructible `A` on `Y_ét`. -/
theorem constructibleDirectImageComparison {X Y : LFTScheme O} (f : Y ⟶ X)
    [QuasiCompact X.obj.hom] [QuasiCompact Y.obj.hom] [IsSeparated f.hom.left] (Λ : Type u)
    [CommRing Λ] [Finite Λ] (hΛ : IsPrimeToPTorsion p Λ)
    (A : SchemeConstructible Y.obj.left Λ) :
    IsIso ((SchemeComparison.pushforwardComparisonDVR p O f Λ).app
      ((SchemeConstructible.toEtale Y.obj.left Λ).obj A)) := sorry

/-! ### L6/constructible-full-faithfulness-27-7: full faithfulness on constructible complexes -/

/-- `L6/constructible-full-faithfulness-27-7` (ECD Proposition 27.7, with the hypothesis of 27.6
on `Λ`): for `X` locally of finite type over `O` and `Λ` a finite ring killed by an integer prime
to `p`, the unit `A → Rc_{X*} c_X^* A` is an isomorphism for every bounded constructible `A`. -/
theorem constructibleUnit_isIso (X : LFTScheme O) (Λ : Type u) [CommRing Λ] [Finite Λ]
    (hΛ : IsPrimeToPTorsion p Λ) (A : SchemeConstructible X.obj.left Λ) :
    IsIso ((SchemeComparison.adjDVR p O X Λ).unit.app
      ((SchemeConstructible.toEtale X.obj.left Λ).obj A)) := sorry

/-- `L6/constructible-full-faithfulness-27-7`: hence `c_X^*` is fully faithful on bounded
constructible complexes. -/
theorem constructible_fullyFaithful (X : LFTScheme O) (Λ : Type u) [CommRing Λ] [Finite Λ]
    (hΛ : IsPrimeToPTorsion p Λ) :
    (SchemeConstructible.toEtale X.obj.left Λ ⋙ SchemeComparison.pullbackDVR p O X Λ).Full ∧
      (SchemeConstructible.toEtale X.obj.left Λ ⋙ SchemeComparison.pullbackDVR p O X Λ).Faithful :=
  sorry

end Constructible

end L3toL6

