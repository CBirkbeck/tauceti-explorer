/-! ### L0/adic-coefficient-limit: Enhanced coefficient reconstruction -/

/-- The functor sending an adic object `A` to the compatible tower of its reductions
`(A ⊗ᴸ_Λ Λ/Iⁿ)ₙ` with the canonical identifications between consecutive levels. -/
def AdicTower.ofAdic (Y : SmallVStack.{u} p) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) :
    AdicEtale Y I ⥤ AdicTower Y I := sorry

-- Only homotopy categories are visible here: presentability and stability of the enhancement,
-- and the equivalence of enhanced categories, are statements about the enhancements.
/-- `L0/adic-coefficient-limit` (ECD Proposition 26.2): passing to the tower of reductions is an
equivalence `D_ét(Y, Λ) ≃ limₙ D_ét(Y, Λ/Iⁿ)` from adic objects to compatible towers, and its
component at level `n ≥ 1` is the reduction modulo `Iⁿ`. -/
theorem adicCoefficientLimit [Fact p.Prime] (Y : SmallVStack.{u} p) {Λ : Type u} [CommRing Λ]
    (I : Ideal Λ) (hI : IsAdicCoefficientPair p I) :
    (AdicTower.ofAdic Y I).IsEquivalence ∧
      ∀ n : ℕ, 1 ≤ n →
        Nonempty (AdicTower.ofAdic Y I ⋙ AdicTower.eval Y I n ≅ AdicEtale.reduction Y I n) :=
  sorry

/-! ### L0/completed-tensor-and-colimits: Completed operations on adic étale objects -/

namespace AdicEtale

variable {Y : SmallVStack.{u} p} {Λ : Type u} [CommRing Λ] {I : Ideal Λ}

-- API AdicEtale.tensor: declared in core (with `SymmetricCategory` and `MonoidalClosed`).
/-- The contract of `AdicEtale.tensor`: `A ⊗̂ B = Comp_I (A ⊗ᴸ_Λ B)`, naturally in `A` and `B`. -/
theorem forget_tensor [Fact p.Prime] (hI : IsAdicCoefficientPair p I) :
    Nonempty (MonoidalCategory.tensor (AdicEtale Y I) ⋙ forget Y I ≅
      (forget Y I).prod (forget Y I) ⋙ MonoidalCategory.tensor (VDerived Y Λ) ⋙
        VDerived.completion Y I) :=
  sorry

/-- `AdicEtale.colimit`: the completed colimit. For a diagram `F` of adic objects and a cocone
`c` over its image in `D(Y_v, Λ)` whose vertex has étale reduction modulo `I` (in practice the
colimit of the enhancement: `D_ét` is closed under colimits), the cocone of adic objects with
vertex `Comp_I c.pt` and legs the completed legs of `c`. -/
def colimit {J : Type u} [SmallCategory J] (F : J ⥤ AdicEtale Y I)
    (c : Cocone (F ⋙ forget Y I)) : Cocone F := sorry

/-- The completion map from the ambient vertex to the completed colimit. -/
def colimitComparison {J : Type u} [SmallCategory J] (F : J ⥤ AdicEtale Y I)
    (c : Cocone (F ⋙ forget Y I)) : c.pt ⟶ (forget Y I).obj (colimit F c).pt := sorry

/-- The completed colimit is the derived completion of the ambient one: the comparison map is
compatible with the legs and is the completion map of `c.pt`. -/
theorem colimit_isCompletion [Fact p.Prime] (hI : IsAdicCoefficientPair p I) {J : Type u}
    [SmallCategory J] (F : J ⥤ AdicEtale Y I) (c : Cocone (F ⋙ forget Y I))
    (hc : IsEtale ((VDerived.reduce Y I).obj c.pt)) :
    (∀ j : J, c.ι.app j ≫ colimitComparison F c = (forget Y I).map ((colimit F c).ι.app j)) ∧
      ∃ e : (forget Y I).obj (colimit F c).pt ≅ (VDerived.completion Y I).obj c.pt,
        colimitComparison F c ≫ e.hom = (VDerived.completionUnit Y I).app c.pt :=
  sorry

/-- The universal property against complete objects: maps from the completed colimit to a
derived `I`-complete object are exactly maps from the ambient vertex. With `c` the enhanced
colimit this is the colimit universal property of the completed colimit. -/
theorem colimit_universal [Fact p.Prime] (hI : IsAdicCoefficientPair p I) {J : Type u}
    [SmallCategory J] (F : J ⥤ AdicEtale Y I) (c : Cocone (F ⋙ forget Y I))
    (hc : IsEtale ((VDerived.reduce Y I).obj c.pt)) (B : VDerived Y Λ)
    (hB : IsDerivedComplete I B) :
    Function.Bijective (fun g : (forget Y I).obj (colimit F c).pt ⟶ B =>
      colimitComparison F c ≫ g) :=
  sorry

/-- When `c` is a colimit in the homotopy category (for instance a coproduct), its vertex has
étale reduction and the completed colimit is a colimit of adic objects; the inclusion into
`D(Y_v, Λ)` need not preserve it. -/
def colimitIsColimit [Fact p.Prime] (hI : IsAdicCoefficientPair p I) {J : Type u}
    [SmallCategory J] (F : J ⥤ AdicEtale Y I) {c : Cocone (F ⋙ forget Y I)}
    (hc : IsColimit c) : IsColimit (colimit F c) := sorry

/-- `AdicEtale.tensor_reduce`: the reduction modulo `Iⁿ` of a completed tensor product is the
derived tensor product over `Λ/Iⁿ` of the reductions, naturally in both variables. -/
theorem tensor_reduce [Fact p.Prime] (hI : IsAdicCoefficientPair p I) {n : ℕ} (hn : 1 ≤ n) :
    Nonempty (MonoidalCategory.tensor (AdicEtale Y I) ⋙ reduction Y I n ≅
      (reduction Y I n).prod (reduction Y I n) ⋙ MonoidalCategory.tensor (DEtale Y (Λ ⧸ I ^ n))) :=
  sorry

/-- `AdicEtale.internalHom`: the tensor–Hom adjunction `Hom(A ⊗̂ B, C) ≃ Hom(A, RHom(B, C))`. -/
def internalHom (A B C : AdicEtale Y I) : (A ⊗ B ⟶ C) ≃ (A ⟶ (ihom B).obj C) :=
  ((β_ B A).homCongr (Iso.refl C)).symm.trans ((ihom.adjunction B).homEquiv A C)

/-- The internal `RHom` commutes with reduction modulo `Iⁿ` (ECD Remark 26.3). -/
theorem internalHom_reduce [Fact p.Prime] (hI : IsAdicCoefficientPair p I) {n : ℕ} (hn : 1 ≤ n)
    (B C : AdicEtale Y I) :
    Nonempty ((reduction Y I n).obj ((ihom B).obj C) ≅
      (ihom ((reduction Y I n).obj B)).obj ((reduction Y I n).obj C)) :=
  sorry

/-- `AdicEtale.unit_tensor`: the tensor unit is the completed constant object `Comp_I Λ`, and
`Comp_I (Comp_I Λ ⊗ᴸ A) ≅ A` for every adic object `A`. -/
theorem unit_tensor [Fact p.Prime] (hI : IsAdicCoefficientPair p I) (A : AdicEtale Y I) :
    Nonempty ((forget Y I).obj (completedUnit Y I) ≅
        (VDerived.completion Y I).obj ((VDerived.const Y Λ).obj (ModuleCat.of Λ Λ))) ∧
      Nonempty ((VDerived.completion Y I).obj
          ((VDerived.completion Y I).obj ((VDerived.const Y Λ).obj (ModuleCat.of Λ Λ)) ⊗
            (forget Y I).obj A) ≅ (forget Y I).obj A) :=
  sorry

end AdicEtale

/-- The sequence `Λ̂ --ℓ--> Λ̂ --ℓ--> ⋯` of completed units. -/
abbrev EllAdic.ellTower (Y : SmallVStack.{0} p) (ℓ : ℕ) [Fact ℓ.Prime] :
    ℕ ⥤ AdicEtale Y (EllAdic.ideal ℓ) :=
  Functor.ofSequence (X := fun _ => AdicEtale.completedUnit Y (EllAdic.ideal ℓ)) (fun _ => ℓ • 𝟙 _)

section TensorTests

variable (ℓ : ℕ) [Fact ℓ.Prime] (C : Type) [NontriviallyNormedField C] [IsUltrametricDist C]
  [CompleteSpace C] [IsAlgClosed C] [CharP C p]

/- Test `AdicEtale.tensor_point` (computation): at a geometric point, if an adic object `T` is the
constant sheaf `ℤ/ℓ`, then `T ⊗̂ T` is `ℤ/ℓ ⊞ ℤ/ℓ[1]`, with the Tor term in degree `−1`. -/
example [Fact p.Prime] (hℓ : ℓ ≠ p) (T : AdicEtale (EllAdic.point p C) (EllAdic.ideal ℓ))
    (hT : Nonempty ((AdicEtale.forget _ _).obj T ≅
      EllAdic.const (EllAdic.point p C) ℓ (ℤ_[ℓ] ⧸ EllAdic.ideal ℓ))) :
    Nonempty ((AdicEtale.forget _ _).obj (T ⊗ T) ≅
      EllAdic.const (EllAdic.point p C) ℓ (ℤ_[ℓ] ⧸ EllAdic.ideal ℓ) ⊞
        (EllAdic.const (EllAdic.point p C) ℓ (ℤ_[ℓ] ⧸ EllAdic.ideal ℓ))⟦(1 : ℤ)⟧) :=
  sorry

/- Test `AdicEtale.telescope` (non-example): at a geometric point, the enhanced colimit of
`Λ̂ --ℓ--> Λ̂ --ℓ--> ⋯` in `D(Y_v, ℤ_ℓ)` is the nonzero rationalisation `Λ̂ ⊗ᴸ ℚ_ℓ`, whose
reduction modulo `ℓ` is zero, while the completed colimit is zero. -/
example [Fact p.Prime] (hℓ : ℓ ≠ p) :
    Nonempty ((VDerived.seqColimit
        (EllAdic.ellTower (EllAdic.point p C) ℓ ⋙ AdicEtale.forget _ _)).pt ≅
      (AdicEtale.forget _ _).obj
          (AdicEtale.completedUnit (EllAdic.point p C) (EllAdic.ideal ℓ)) ⊗
        EllAdic.const (EllAdic.point p C) ℓ ℚ_[ℓ]) ∧
      ¬ IsZero (VDerived.seqColimit
        (EllAdic.ellTower (EllAdic.point p C) ℓ ⋙ AdicEtale.forget _ _)).pt ∧
      IsZero ((VDerived.reduce (EllAdic.point p C) (EllAdic.ideal ℓ)).obj (VDerived.seqColimit
        (EllAdic.ellTower (EllAdic.point p C) ℓ ⋙ AdicEtale.forget _ _)).pt) ∧
      IsZero (AdicEtale.colimit (EllAdic.ellTower (EllAdic.point p C) ℓ)
        (VDerived.seqColimit (EllAdic.ellTower (EllAdic.point p C) ℓ ⋙ AdicEtale.forget _ _))).pt :=
  sorry

/- Test `AdicEtale.unit` (computation): at a geometric point, `Λ̂ ⊗̂ Λ̂` is the derived completion
of the constant sheaf `ℤ_ℓ`, and so is `Comp_ℓ (Λ̂ ⊗ᴸ Λ̂)` computed in `D(Y_v, ℤ_ℓ)`. -/
example [Fact p.Prime] (hℓ : ℓ ≠ p) :
    Nonempty ((AdicEtale.forget _ _).obj
        (AdicEtale.completedUnit (EllAdic.point p C) (EllAdic.ideal ℓ) ⊗
          AdicEtale.completedUnit (EllAdic.point p C) (EllAdic.ideal ℓ)) ≅
      (VDerived.completion (EllAdic.point p C) (EllAdic.ideal ℓ)).obj
        (EllAdic.const (EllAdic.point p C) ℓ ℤ_[ℓ])) ∧
    Nonempty ((VDerived.completion (EllAdic.point p C) (EllAdic.ideal ℓ)).obj
        ((VDerived.completion (EllAdic.point p C) (EllAdic.ideal ℓ)).obj
            (EllAdic.const (EllAdic.point p C) ℓ ℤ_[ℓ]) ⊗
          (VDerived.completion (EllAdic.point p C) (EllAdic.ideal ℓ)).obj
            (EllAdic.const (EllAdic.point p C) ℓ ℤ_[ℓ])) ≅
      (VDerived.completion (EllAdic.point p C) (EllAdic.ideal ℓ)).obj
        (EllAdic.const (EllAdic.point p C) ℓ ℤ_[ℓ])) :=
  sorry

end TensorTests

/- Test `AdicEtale.empty_colimit` (degenerate): the completed colimit of the empty diagram, formed
from an initial object of `D(Y_v, Λ)`, is zero. -/
example (Y : SmallVStack.{u} p) {Λ : Type u} [CommRing Λ] (I : Ideal Λ)
    (c : Cocone ((Functor.empty (AdicEtale Y I) : Discrete.{u} PEmpty ⥤ AdicEtale Y I) ⋙
      AdicEtale.forget Y I))
    (hc : IsColimit c) :
    IsZero (AdicEtale.colimit (Functor.empty (AdicEtale Y I) : Discrete.{u} PEmpty ⥤ _) c).pt :=
