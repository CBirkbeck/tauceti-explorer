/-- The conductor-three Gaussian order, with its actual subring carrier. -/
def gaussianOrderThree : Subring ℂ where
  carrier := {z | ∃ m n : ℤ, z = (m : ℂ) + 3 * (n : ℂ) * Complex.I}
  zero_mem' := by sorry
  one_mem' := by sorry
  add_mem' := by sorry
  neg_mem' := by sorry
  mul_mem' := by sorry

/-- The Picard/class group of the nonmaximal order has two elements, rather than one. -/
theorem nonmaximalGaussian_classNumber : Nat.card (ClassGroup gaussianOrderThree) = 2 := by
  sorry

