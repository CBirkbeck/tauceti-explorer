import Mathlib

/-!
# AutomorphicCongruences: representative target signatures

The roadmap is README.md. This file records light definitions and milestone signatures
statable against the pinned Mathlib and Tau Ceti APIs; it is not exhaustive. The coefficient
map is explicit and need not be injective. The Hecke ideal and its contraction have different
ambient rings. Quotient surjectivity is a separate hypothesis. Factor separation is stated
over a domain; the arithmetic construction of the characteristic ideals needs the stronger
coefficient hypotheses specified in the README.
-/

namespace TauCetiRoadmap.AutomorphicCongruences

/-! ## Layer L0: Congruence ideals and ordinary Selmer classes -/

namespace EisensteinIdeal

variable {Λ H I : Type*} [CommRing Λ] [CommRing H]

/-- The Hecke ideal generated by the operator differences for an Eisenstein eigensystem.
The operators and their scalar eigenvalues are indexed by the same type. -/
def hecke (ι : Λ →+* H) (ops : I → H) (eig : I → Λ) : Ideal H :=
  Ideal.span (Set.range fun i => ops i - ι (eig i))

/-- The coefficient Eisenstein ideal is the contraction of the Hecke ideal, equivalently
the kernel of the coefficient map followed by the Hecke quotient. -/
def base (ι : Λ →+* H) (ops : I → H) (eig : I → Λ) : Ideal Λ :=
  Ideal.comap ι (hecke ι ops eig)

/-- Equal operator and eigenvalue give the zero Hecke ideal, but do not force the
coefficient map onto the Hecke quotient: the polynomial X is not a constant. -/
example : hecke (Polynomial.C : ℤ →+* Polynomial ℤ)
      (fun _ : Unit => Polynomial.C 7) (fun _ : Unit => 7) = ⊥ ∧
    ¬ Function.Surjective
      ((Ideal.Quotient.mk (hecke (Polynomial.C : ℤ →+* Polynomial ℤ)
        (fun _ : Unit => Polynomial.C 7) (fun _ : Unit => 7))).comp Polynomial.C) := by
  constructor
  · simp [hecke]
  · intro h
    obtain ⟨n, hn⟩ := h (Ideal.Quotient.mk _ Polynomial.X)
    have hconst : Polynomial.C n = (Polynomial.X : Polynomial ℤ) := by
      change Ideal.Quotient.mk _ (Polynomial.C n) = Ideal.Quotient.mk _ Polynomial.X at hn
      apply sub_eq_zero.mp
      simpa only [hecke, sub_self, Set.range_const, Ideal.span_singleton_zero,
        Submodule.mem_bot] using Ideal.Quotient.eq.mp hn
    have hcoeff := congrArg (fun f : Polynomial ℤ => f.coeff 1) hconst
    rw [Polynomial.coeff_C_of_ne_zero (by decide : (1 : ℕ) ≠ 0),
      Polynomial.coeff_X_one] at hcoeff
    exact zero_ne_one hcoeff

/-- A difference of five generates (5), retaining its first power. -/
example : hecke (RingHom.id ℤ) (fun _ : Unit => (8 : ℤ))
    (fun _ : Unit => (3 : ℤ)) = Ideal.span {(5 : ℤ)} := by
  norm_num [hecke]

/-- A noninjective coefficient map contributes its kernel even when every operator
equals its eigenvalue. Thus the coefficient ideal can be nonzero when the Hecke ideal is zero. -/
example : (5 : ℤ) ∈ base (Int.castRingHom (ZMod 5)) (fun _ : Unit => 0)
    (fun _ : Unit => (0 : ℤ)) ∧
    (1 : ℤ) ∉ base (Int.castRingHom (ZMod 5)) (fun _ : Unit => 0)
      (fun _ : Unit => (0 : ℤ)) := by
  norm_num [base, hecke]
  decide

/-- A unit operator difference gives the unit coefficient ideal. -/
example : base (RingHom.id ℤ) (fun _ : Unit => (2 : ℤ))
    (fun _ : Unit => (1 : ℤ)) = ⊤ := by
  norm_num [base, hecke]

end EisensteinIdeal

/-! ## Layer L5b: Four twists and cyclotomic factor separation -/

section FactorSeparation

variable {A I : Type*} [CommRing A] [IsDomain A] [Fintype I]

/-- The algebraic factor-separation milestone: every individual analytic ideal is
contained in its characteristic ideal, and the characteristic product is contained in
the analytic product. Nonzero analytic factors force equality factor by factor. This
holds for arbitrary finite families of ideals over a domain; the four twists give the
BCS application (proof of Theorem 1.1.2). -/
theorem factorSeparation (L : I → A) (J : I → Ideal A)
    (hnonzero : ∀ i, L i ≠ 0)
    (hupper : ∀ i, Ideal.span {L i} ≤ J i)
    (hproduct : (∏ i, J i) ≤ Ideal.span {∏ i, L i}) :
    ∀ i, J i = Ideal.span {L i} := by
  sorry

end FactorSeparation

