noncomputable section

namespace TauCetiRoadmap.HigherLocalFieldsAndHigherClassFieldTheory

open Filter Set Topology

namespace HigherLaurent

/-! ## Layer 0: coefficient boxes and the higher additive topology -/

variable (K : Type*) [Field K] [TopologicalSpace K]

/-- All integer coefficients satisfy the prescribed subgroup conditions. -/
def coefficientBox (U : ℤ → OpenAddSubgroup K) : AddSubgroup (LaurentSeries K) where
  carrier := {f | ∀ i, f.coeff i ∈ U i}
  zero_mem' := by
    intro i
    simp
  add_mem' := by
    intro f g hf hg i
    rw [HahnSeries.coeff_add]
    exact (U i).add_mem (hf i) (hg i)
  neg_mem' := by
    intro f hf i
    rw [HahnSeries.coeff_neg]
    exact (U i).neg_mem (hf i)

example : coefficientBox K (fun _ => ⊤) = ⊤ := by
  ext f
  simp [coefficientBox]

example (U : ℤ → OpenAddSubgroup K) (c : K) (hc : c ∉ U (-1)) :
    (HahnSeries.single (-1) c : LaurentSeries K) ∉ coefficientBox K U := by
  intro hf
  apply hc
  have h := hf (-1)
  simpa using h

/-- At sufficiently large positive exponents there is no restriction. -/
def IsAdmissible (U : ℤ → OpenAddSubgroup K) : Prop :=
  ∃ N : ℤ, ∀ i, N ≤ i → U i = ⊤

example : IsAdmissible K (fun _ => ⊤) := by
  exact ⟨0, fun _ _ => rfl⟩

example (V : OpenAddSubgroup K) (hV : V ≠ ⊤) :
    ¬ IsAdmissible K (fun _ => V) := by
  rintro ⟨N, hN⟩
  exact hV (hN N le_rfl)

/-- The topology generated by all translates of admissible coefficient boxes. -/
@[instance_reducible] def higherTopology : TopologicalSpace (LaurentSeries K) :=
  TopologicalSpace.generateFrom
    {S | ∃ (a : LaurentSeries K) (U : ℤ → OpenAddSubgroup K),
      IsAdmissible K U ∧ S = {f | f - a ∈ coefficientBox K U}}

example (U : ℤ → OpenAddSubgroup K) (hU : IsAdmissible K U) :
    (higherTopology K).IsOpen (coefficientBox K U : Set (LaurentSeries K)) := by
  apply TopologicalSpace.isOpen_generateFrom_of_mem
  refine ⟨0, U, hU, ?_⟩
  ext f
  simp

/-- Addition and negation are continuous for the named higher topology. -/
theorem higher_isTopologicalAddGroup :
    @IsTopologicalAddGroup (LaurentSeries K) (higherTopology K) _ := by
  sorry

/-- A zero-neighborhood contains an admissible box; it need not itself be a box. -/
theorem mem_nhds_zero_iff (S : Set (LaurentSeries K)) :
    S ∈ @nhds (LaurentSeries K) (higherTopology K) 0 ↔
      ∃ U : ℤ → OpenAddSubgroup K,
        IsAdmissible K U ∧ (coefficientBox K U : Set (LaurentSeries K)) ⊆ S := by
  sorry

variable [NonarchimedeanAddGroup K]

/-- Every coefficient projection is continuous in the higher topology. -/
theorem continuous_coeff (j : ℤ) :
    @Continuous (LaurentSeries K) K (higherTopology K) inferInstance
      (fun f => f.coeff j) := by
  sorry

/-- A monomial copy of K has exactly the original coefficient topology. -/
theorem induced_single (j : ℤ) :
    TopologicalSpace.induced (fun c : K => (HahnSeries.single j c : LaurentSeries K))
      (higherTopology K) = (inferInstance : TopologicalSpace K) := by
  sorry

/-- Coefficient separation makes the higher topology Hausdorff. -/
theorem higher_t2 [T2Space K] : @T2Space (LaurentSeries K) (higherTopology K) := by
  sorry

/-- Mathlib's order reverses inclusion of open sets. -/
theorem outer_le_higherTopology :
    (inferInstance : TopologicalSpace (LaurentSeries K)) ≤ higherTopology K := by
  sorry

/-- Equality with the outer topology detects discrete coefficients. -/
theorem higherTopology_eq_outer_iff :
    higherTopology K = (inferInstance : TopologicalSpace (LaurentSeries K)) ↔
      DiscreteTopology K := by
  sorry

/-- Nondiscrete coefficients make the higher topology strictly coarser. -/
theorem outer_lt_higherTopology (hK : ¬ DiscreteTopology K) :
    (inferInstance : TopologicalSpace (LaurentSeries K)) < higherTopology K := by
  sorry

/-- The ordinary local-field boundary case. -/
theorem higherTopology_discrete [DiscreteTopology K] :
    higherTopology K = (inferInstance : TopologicalSpace (LaurentSeries K)) := by
  sorry

/-- Nonzero constants tending to zero distinguish the two topologies. -/
theorem constant_sequence_higher_not_outer
    (s : ℕ → K) (hs : Tendsto s atTop (𝓝 0)) (hne : ∀ n, s n ≠ 0) :
    Tendsto (fun n => (HahnSeries.single 0 (s n) : LaurentSeries K)) atTop
      (@nhds (LaurentSeries K) (higherTopology K) 0) ∧
    ¬ Tendsto (fun n => (HahnSeries.single 0 (s n) : LaurentSeries K)) atTop
      (𝓝 0) := by
  sorry

/-- The outer degree-one ball cannot be higher-open over nondiscrete coefficients. -/
theorem outer_ball_not_higher_open (hK : ¬ DiscreteTopology K) :
    ¬ (higherTopology K).IsOpen {f : LaurentSeries K | ∀ i, i < 1 → f.coeff i = 0} := by
  sorry

end HigherLaurent

