    (taylor (1 : S) (1 - e₃)).coeff 0 = 0 ∧
    (taylor (1 : S) (1 - e₃)).coeff 1 = 0 ∧
    (taylor (1 : S) (1 - e₃)).coeff 2 = 0 := by sorry

