import Mathlib
import TauCeti.FieldTheory.Galois.AbsoluteGaloisGroup
import TauCeti.RepresentationTheory.Homological.ContCohomology.LowDegree
import TauCeti.RepresentationTheory.Homological.ContCohomology.Functoriality

/-!
# EllipticCurveModularityWild3Adic: representative target signatures

The roadmap is `README.md`. This file records the definitions and theorem signatures of the
roadmap that can be stated against the pinned Mathlib and Tau Ceti; it is not exhaustive, and
everything absent here is a README target.

Design choices made explicit here:
* `ℚ₃` is Mathlib's `ℚ_[3]`, and the explicit local fields of Layer W3.1 are intermediate fields of
  `AlgebraicClosure ℚ_[3]` generated by roots whose defining equations are hypotheses of the
  theorems, so no auxiliary field structure is introduced.
* Breuil modules, finite flat group schemes with descent, deformation rings, Weil–Deligne types,
  twisted modular curves and modularity predicates are not available at the pins; their
  statements are README targets. What is kept is the arithmetic that can be typed now: the
  truncated coefficient rings `𝔽₃[u]/(u^n)` and `𝔽₃[T]/(T^N)` as `AdjoinRoot`, filtrations as
  `Submodule.span`, matrix entry maps for the comparison maps, the admittance rules as
  arithmetic of exponents, explicit Weierstrass curves, and finite group facts.
* Valuations on `AlgebraicClosure ℚ_[3]` enter as an `AddValuation` hypothesis extending the
  `3`-adic valuation, so that the statements do not depend on a choice of extension.
-/

noncomputable section

open Polynomial

namespace TauCetiRoadmap.EllipticCurveModularityWild3Adic

local instance : Fact (Nat.Prime 3) := ⟨by norm_num⟩
local instance : Fact (Nat.Prime 5) := ⟨by norm_num⟩

/-- `ℚ₃`. -/
abbrev Q3 := ℚ_[3]

/-- A fixed algebraic closure of `ℚ₃`, containing all the explicit fields of Layer W3.1. -/
abbrev Q3bar := AlgebraicClosure Q3


/-! ## Layer W3.0: Types, admittance and the wild 3-adic types -/

section LayerW30

/-- The order-three matrix `ζ = (0, -1; 1, -1)` used to write the wild types (README 0.3–0.5);
the types do not depend on this choice. -/
def zetaMatrix : Matrix (Fin 2) (Fin 2) Q3 := !![0, -1; 1, -1]

/-- `ζ` as an element of `GL₂(ℚ₃)`; its determinant is `1`. -/
def zeta : GL (Fin 2) Q3 :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero zetaMatrix (by simp [zetaMatrix, Matrix.det_fin_two])

/-- `ζ` has order three. -/
theorem orderOf_zeta : orderOf zeta = 3 := by
  sorry

/-- The uniformizer value of the extended types: `(ζ - ζ⁻¹)² = -3` (README 0.5, check
`extendedWildType_uniformizer_square`). -/
theorem zeta_sub_inv_sq :
    ((zeta : Matrix (Fin 2) (Fin 2) Q3) - ((zeta⁻¹ : GL (Fin 2) Q3) : Matrix (Fin 2) (Fin 2) Q3)) ^ 2 =
      (-3 : Q3) • (1 : Matrix (Fin 2) (Fin 2) Q3) := by
  sorry

/-- The rule by which `σ_{n,m} = Sym^n ⊗ det^m` admits a residual representation whose inertial
restriction is the triangular `(ω^a, ∗; 0, ω^b)` (README 0.2): `1 - m = a`, `-n - m = b`, with
`0 ≤ n ≤ ℓ - 1`, and the extension peu ramifié when `n = 0`. Exponents of `ω` live in
`ZMod (ℓ - 1)`. -/
def SerreWeightAdmitsTriangular (ℓ : ℕ) (n : ℕ) (m a b : ZMod (ℓ - 1)) (peu : Prop) : Prop :=
  n ≤ ℓ - 1 ∧ 1 - m = a ∧ -(n : ZMod (ℓ - 1)) - m = b ∧ (n = 0 → peu)

/-- The rule by which the character `σ'_{m,m}` of `U₀(ℓ)` simply admits a triangular
`(ω^a, ∗; 0, ω^b)` (README 0.2): `1 - m = a`, `-m = b`, and the extension très ramifié. -/
def DiagonalCharacterSimplyAdmits (ℓ : ℕ) (m a b : ZMod (ℓ - 1)) (tres : Prop) : Prop :=
  1 - m = a ∧ -m = b ∧ tres

/-- The Frobenius condition for `σ'_{{m},c}` to admit a très ramifié `ρ̄ ≅ (∗, ∗; 0, ω^{-m}χ)`
(README 0.2): the unramified character `χ` sends Frobenius to `-c`. Here `frob` is `χ(Frob)`. -/
def ExtendedCharacterFrobeniusCondition {k : Type*} [Field k] (c frob : k) : Prop :=
  frob = -c

/-- README 0.2 check / 0.6: for `ℓ = 3` and `ρ̄|_{I₃} ≅ (1, ∗; 0, ω)` très ramifié (`a = 0`,
`b = 1`), `σ_{2,1}` admits `ρ̄`. -/
example : SerreWeightAdmitsTriangular 3 2 1 0 1 False := by
  refine ⟨by norm_num, by decide, by decide, by simp⟩

/-- … and `σ_{0,1}` does not: the peu condition at `n = 0` fails for a très ramifié `ρ̄`. -/
example : ¬ SerreWeightAdmitsTriangular 3 0 1 0 1 False := by
  rintro ⟨-, -, -, h⟩
  exact h rfl

/-- … nor does `σ_{2,0}`: the exponent of the subrepresentation is wrong. -/
example : ¬ SerreWeightAdmitsTriangular 3 2 0 0 1 False := by
  rintro ⟨-, h, -⟩
  exact absurd h (by decide)

/-- README 0.7: for `ρ̄|_{I₃} ≅ (ω, ∗; 0, 1)` très ramifié, `σ'_{0,0}` simply admits and `σ'_{1,1}`
does not. -/
example : DiagonalCharacterSimplyAdmits 3 0 1 0 True := ⟨by decide, by decide, trivial⟩

example : ¬ DiagonalCharacterSimplyAdmits 3 1 1 0 True := by
  rintro ⟨h, -⟩
  exact absurd h (by decide)

/-- README 0.8: with trivial quotient character (`χ(Frob) = 1`), only `c = -1` satisfies the
Frobenius condition over `𝔽₃`. -/
example : ExtendedCharacterFrobeniusCondition (-1 : ZMod 3) 1 := by
  simp [ExtendedCharacterFrobeniusCondition]

example : ¬ ExtendedCharacterFrobeniusCondition (1 : ZMod 3) 1 := by
  simp only [ExtendedCharacterFrobeniusCondition]
  decide

end LayerW30

/-! ## Layer W3.1: Local arithmetic of `ℚ₃` -/

section LayerW31

/-- README 1.1: `ℚ₃^×/(ℚ₃^×)³` has order nine (it is `H¹(G₃, μ₃)` by Kummer theory). -/
theorem card_units_mod_cubes :
    Nat.card (Q3ˣ ⧸ (powMonoidHom 3 : Q3ˣ →* Q3ˣ).range) = 9 := by
  sorry

/-- README 1.1: the unit line `ℤ₃^×/(ℤ₃^×)³` has order three. -/
theorem card_integerUnits_mod_cubes :
    Nat.card (ℤ_[3]ˣ ⧸ (powMonoidHom 3 : ℤ_[3]ˣ →* ℤ_[3]ˣ).range) = 3 := by
  sorry

/-- README 1.1: the class of `3` is not a unit class modulo cubes (très ramifié direction). -/
theorem three_not_unit_mod_cubes (u : ℤ_[3]ˣ) (x : Q3ˣ) :
    ((u : ℤ_[3]) : Q3) * (x : Q3) ^ 3 ≠ 3 := by
  sorry

/-- README 1.1 negative control: a pure cubic extension kills the nonzero class of `3`
without containing `√-3`. Restriction injectivity therefore needs the Galois hypothesis. -/
theorem nonGalois_cubic_kummer_control (α : Q3bar) (hα : α ^ 3 = 3) :
    let L := IntermediateField.adjoin Q3 {α}
    Module.finrank Q3 L = 3 ∧ ¬ IsGalois Q3 L ∧
      (∀ x : Q3, x ^ 3 ≠ 3) ∧ (∃ x : L, x ^ 3 = 3) ∧
      (∀ β : Q3bar, β ^ 2 = -3 → β ∉ L) := by
  sorry

/-- The defining polynomial of the cyclic cubic field (README 1.3). -/
def cyclicCubicPoly : Q3[X] := X ^ 3 - C 3 * X ^ 2 + C 3

/-- The defining polynomial of the nonabelian cubic field (README 1.4). -/
def nonabelianCubicPoly : Q3[X] := X ^ 3 - C 3 * X ^ 2 + C 6

/-- `F₁ = ℚ₃(π)` (README 1.3). -/
def cyclicCubicField (π : Q3bar) : IntermediateField Q3 Q3bar := IntermediateField.adjoin Q3 {π}

/-- `F′₋₁ = ℚ₃(π, j)` (README 1.4). -/
def nonabelianCubicSplittingField (π j : Q3bar) : IntermediateField Q3 Q3bar :=
  IntermediateField.adjoin Q3 {π, j}

/-- `F′₃`, `F′₋₃` and `F′_i` are all of the form `ℚ₃(s, j, α, β)` (README 1.5–1.7). -/
def degreeTwelveSplittingField (s j α β : Q3bar) : IntermediateField Q3 Q3bar :=
  IntermediateField.adjoin Q3 {s, j, α, β}

/-- README 1.3: the minimal polynomial and the other two roots. -/
theorem cyclicCubic_minpoly (π : Q3bar) (hπ : π ^ 3 - 3 * π ^ 2 + 3 = 0) :
    minpoly Q3 π = cyclicCubicPoly ∧ aeval (π ^ 2 - 2 * π) cyclicCubicPoly = 0 ∧
      aeval (3 + π - π ^ 2) cyclicCubicPoly = 0 := by
  sorry

/-- README 1.3: `F₁/ℚ₃` is cyclic of degree three, generated by `π ↦ π² - 2π`. -/
theorem cyclicCubic_galois (π : Q3bar) (hπ : π ^ 3 - 3 * π ^ 2 + 3 = 0) :
    Module.finrank Q3 (cyclicCubicField π) = 3 ∧ IsGalois Q3 (cyclicCubicField π) ∧
      ∃ σ : cyclicCubicField π ≃ₐ[Q3] cyclicCubicField π, orderOf σ = 3 ∧
        ((σ ⟨π, IntermediateField.mem_adjoin_simple_self Q3 π⟩ : cyclicCubicField π) : Q3bar) =
          π ^ 2 - 2 * π := by
  sorry

/-- README 1.4: the degrees of the nonabelian cubic field and of its splitting field. -/
theorem nonabelianCubic_finrank (π j : Q3bar) (hπ : π ^ 3 - 3 * π ^ 2 + 6 = 0) (hj : j ^ 2 = -1) :
    Module.finrank Q3 (IntermediateField.adjoin Q3 {π}) = 3 ∧
      Module.finrank Q3 (nonabelianCubicSplittingField π j) = 6 ∧
      ¬ IsGalois Q3 (IntermediateField.adjoin Q3 {π}) := by
  sorry

/-- README 1.4 check `nonabelianCubic_polynomial`: `(jπ² - π + 3(1 - j))/2` is another root. -/
example (π j : Q3bar) (hπ : π ^ 3 - 3 * π ^ 2 + 6 = 0) (hj : j ^ 2 = -1) :
    aeval ((j * π ^ 2 - π + 3 * (1 - j)) / 2) nonabelianCubicPoly = 0 := by
  sorry

/-- README 1.5–1.7: each degree-twelve splitting field has degree 24 over `ℚ₃`. The three
families differ only in the hypotheses on `s`, `α`, `β`. -/
theorem positiveQuadratic_finrank (s j α β : Q3bar) (hs : s ^ 2 = 3) (hj : j ^ 2 = -1)
    (hα : α ^ 3 - 3 * α + 3 = 0) (hβ : β ^ 2 = s) :
    Module.finrank Q3 (degreeTwelveSplittingField s j α β) = 24 := by
  sorry

theorem negativeQuadratic_finrank (s j α β : Q3bar) (hs : s ^ 2 = -3) (hj : j ^ 2 = -1)
    (hα : α ^ 3 = 4) (hβ : β ^ 2 = -s) :
    Module.finrank Q3 (degreeTwelveSplittingField s j α β) = 24 := by
  sorry

theorem extendedTypeField_finrank (i : Fin 3) (s j α β : Q3bar) (hs : s ^ 2 = -3)
    (hj : j ^ 2 = -1) (hα : α ^ 3 = 3 * (1 + 3 * (i.val : Q3bar))) (hβ : β ^ 2 = -s) :
    Module.finrank Q3 (degreeTwelveSplittingField s j α β) = 24 := by
  sorry

/-- README 1.6: `α - 1` is a root of the Eisenstein polynomial `X³ + 3X² + 3X - 3`. -/
theorem negativeQuadratic_shifted_root (α : Q3bar) (hα : α ^ 3 = 4) :
    (α - 1) ^ 3 + 3 * (α - 1) ^ 2 + 3 * (α - 1) - 3 = 0 := by
  linear_combination hα

/-- README 1.7: `π¹² = -3(1 + 3ĩ)⁴` for `π = α/β`. -/
theorem extendedTypeField_pi_pow_twelve (i : Fin 3) (s α β : Q3bar) (hs : s ^ 2 = -3)
    (hα : α ^ 3 = 3 * (1 + 3 * (i.val : Q3bar))) (hβ : β ^ 2 = -s) :
    (α / β) ^ 12 = -3 * (1 + 3 * (i.val : Q3bar)) ^ 4 := by
  sorry

/-- README 1.5 check `positiveQuadratic_valuation`: for any additive valuation on `ℚ̄₃` extending
the `3`-adic one, `v(α/β) = 1/12`. -/
theorem positiveQuadratic_valuation (v : AddValuation Q3bar (WithTop ℚ))
    (hv : ∀ q : Q3, v (algebraMap Q3 Q3bar q) = ((Padic.addValuation q).map ((↑) : ℤ → ℚ)))
    (s α β : Q3bar) (hs : s ^ 2 = 3) (hα : α ^ 3 - 3 * α + 3 = 0) (hβ : β ^ 2 = s) :
    v (α / β) = ((1 / 12 : ℚ) : WithTop ℚ) := by
  sorry

/-- README 1.6 check `negativeQuadratic_wrongUniformizer`: `α/β` has valuation `-1/4`, while
`(α - 1)/β` has valuation `1/12`. -/
theorem negativeQuadratic_valuations (v : AddValuation Q3bar (WithTop ℚ))
    (hv : ∀ q : Q3, v (algebraMap Q3 Q3bar q) = ((Padic.addValuation q).map ((↑) : ℤ → ℚ)))
    (s α β : Q3bar) (hs : s ^ 2 = -3) (hα : α ^ 3 = 4) (hβ : β ^ 2 = -s) :
    v (α / β) = ((-1 / 4 : ℚ) : WithTop ℚ) ∧ v ((α - 1) / β) = ((1 / 12 : ℚ) : WithTop ℚ) := by
  sorry

/-- README 1.8(3): in `𝔽₂₅`, an element `β` with `β⁵ = -β` (conjugation by the semilinear
element) and norm `β⁶ = 3` satisfies `β² = -3`, so `β = ±(ζ - ζ⁻¹)`. -/
theorem cartan_element_sq (β : GaloisField 5 2) (h₁ : β ^ 5 = -β) (h₂ : β ^ 6 = 3) :
    β ^ 2 = -3 := by
  have : β ^ 6 = β * β ^ 5 := by ring
  rw [h₁] at this
  linear_combination -h₂ + this

/-- README 1.8(4): `SL₂(𝔽₃)` is the unique subgroup of index two of `GL₂(𝔽₃)`. -/
theorem GL2_F3_index_two (H : Subgroup (GL (Fin 2) (ZMod 3))) (hH : H.index = 2) :
    H = (Matrix.GeneralLinearGroup.det : GL (Fin 2) (ZMod 3) →* (ZMod 3)ˣ).ker := by
  sorry

/-- README 1.8(4): a subgroup of `GL₂(𝔽₃)` of order at least 24 with surjective determinant is
everything. -/
theorem GL2_F3_eq_top (H : Subgroup (GL (Fin 2) (ZMod 3))) (hcard : 24 ≤ Nat.card H)
    (hdet : Function.Surjective fun h : H => Matrix.GeneralLinearGroup.det (h : GL (Fin 2) (ZMod 3))) :
    H = ⊤ := by
  sorry

/-- The short Weierstrass curve `y² = x³ + a x + b` over `ℚ`. -/
def shortWeierstrass (a b : ℚ) : WeierstrassCurve ℚ := ⟨0, 0, 0, a, b⟩

/-- README 1.16 test curves: `y² = x³ - x` (case 1), `y² = x³ - 3x + 8` (case 2),
`y² = x³ - 3x + 4` (case 3), `y² = x³ + 3x + 2` (case 4), `y² = x³ + 3x + 6` (case 5),
`y² = x³ + 9x - 3` (case 6). -/
def localCurveCaseOne : WeierstrassCurve ℚ := shortWeierstrass (-1) 0
def localCurveCaseTwo : WeierstrassCurve ℚ := shortWeierstrass (-3) 8
def localCurveCaseThree : WeierstrassCurve ℚ := shortWeierstrass (-3) 4
def localCurveCaseFour : WeierstrassCurve ℚ := shortWeierstrass 3 2
def localCurveCaseFive : WeierstrassCurve ℚ := shortWeierstrass 3 6
def localCurveCaseSix : WeierstrassCurve ℚ := shortWeierstrass 9 (-3)

/-- Discriminants `-16(4a³ + 27b²)` of the six test curves. -/
example : localCurveCaseOne.Δ = 64 := by
  simp [localCurveCaseOne, shortWeierstrass, WeierstrassCurve.Δ, WeierstrassCurve.b₂,
    WeierstrassCurve.b₄, WeierstrassCurve.b₆, WeierstrassCurve.b₈]; norm_num

example : localCurveCaseTwo.Δ = -25920 := by
  simp [localCurveCaseTwo, shortWeierstrass, WeierstrassCurve.Δ, WeierstrassCurve.b₂,
    WeierstrassCurve.b₄, WeierstrassCurve.b₆, WeierstrassCurve.b₈]; norm_num

example : localCurveCaseSix.Δ = -50544 := by
  simp [localCurveCaseSix, shortWeierstrass, WeierstrassCurve.Δ, WeierstrassCurve.b₂,
    WeierstrassCurve.b₄, WeierstrassCurve.b₆, WeierstrassCurve.b₈]; norm_num

/-- The other local companion curves also have nonzero discriminants (README 1.16). -/
example : localCurveCaseThree.Δ = -5184 ∧ localCurveCaseFour.Δ = -3456 ∧
    localCurveCaseFive.Δ = -17280 := by
  norm_num [localCurveCaseThree, localCurveCaseFour, localCurveCaseFive, shortWeierstrass,
    WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
    WeierstrassCurve.b₆, WeierstrassCurve.b₈]

/-- README 1.14: the conductor-243 congruences `A ≡ B + 3 ≡ 0 mod 9` hold for the test curve
`y² = x³ + 9x - 3`, and its discriminant has `3`-adic valuation `5`. -/
example : (9 : ℤ) % 9 = 0 ∧ (-3 + 3 : ℤ) % 9 = 0 ∧ padicValInt 3 (-50544) = 5 := by
  refine ⟨by norm_num, by norm_num, ?_⟩
  sorry

/-- README 1.14: the reduction `Y² = X³ - X - 1` has no affine `𝔽₃`-point, so `#E(𝔽₃) = 1` and
arithmetic Frobenius has trace `3 + 1 - 1 = 3`. -/
example : ∀ x y : ZMod 3, y ^ 2 ≠ x ^ 3 - x - 1 := by decide

end LayerW31

/-! ## Layer W3.2: Breuil modules with wild descent and the comparison maps

Breuil modules, descent data and the deformation conditions are README targets (2.1–2.7,
2.10–2.11). Kept here: the matrix entries that define the comparison maps of 2.8–2.9 on a
cocycle `φ = (φ₁₁, φ₁₂; φ₂₁, φ₂₂)`, and the truncated coefficient rings with the constant
`c_π = -φ(G_π)` of 1.2. -/

section LayerW32

/-- `𝔽₃`. -/
abbrev F3 := ZMod 3

/-- `2 × 2` matrices over `𝔽₃`, the values of a cocycle in `ad ρ̄`. -/
abbrev M2 := Matrix (Fin 2) (Fin 2) F3

/-- The lower-left entry, which computes `Θ₀` on cocycles (README 2.8). -/
def thetaLowerLeft : M2 →ₗ[F3] F3 where
  toFun A := A 1 0
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The lower-right entry, which computes `Θ₁` on cocycles with `φ₂₁ = 0` (README 2.8). -/
def thetaOneDiagonal : M2 →ₗ[F3] F3 where
  toFun A := A 1 1
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The upper-left entry, which computes `Θ_ω` on cocycles with `φ₂₁ = 0` (README 2.8). -/
def thetaOmegaDiagonal : M2 →ₗ[F3] F3 where
  toFun A := A 0 0
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- README 2.8 `theta_fixedDeterminant`, at the level of matrices: on trace-zero matrices the
two diagonal entries are negatives. -/
theorem thetaOne_eq_neg_thetaOmega (A : M2) (hA : Matrix.trace A = 0) :
    thetaOneDiagonal A = -thetaOmegaDiagonal A := by
  simp only [thetaOneDiagonal, thetaOmegaDiagonal, LinearMap.coe_mk]
  rw [Matrix.trace_fin_two] at hA
  linear_combination hA

/-- README 2.8 check `theta_upperRight`: an upper-right cocycle has all three entries zero. -/
example (b : F3) : thetaLowerLeft !![0, b; 0, 0] = 0 ∧ thetaOneDiagonal !![0, b; 0, 0] = 0 ∧
    thetaOmegaDiagonal !![0, b; 0, 0] = 0 :=
  ⟨rfl, rfl, rfl⟩

/-- README 2.9(1): the embedding `ρ̄ ⊗ χ → ad⁰ρ̄`, `(x, y) ↦ (-y/2, x; 0, y/2)`. -/
def adjointKernelEmbedding : (Fin 2 → F3) →ₗ[F3] M2 where
  toFun v := !![-(v 1) / 2, v 0; 0, v 1 / 2]
  map_add' v w := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp only [Pi.add_apply, Matrix.add_apply] <;> simp <;> ring
  map_smul' c v := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp <;> ring

/-- README 2.9(1): the image of the embedding is exactly the trace-zero matrices with zero
lower-left entry, i.e. `ker Θ₀ ∩ ad⁰ρ̄` on the level of matrices. -/
theorem range_adjointKernelEmbedding :
    LinearMap.range adjointKernelEmbedding =
      LinearMap.ker (Matrix.traceLinearMap (Fin 2) F3 F3) ⊓ LinearMap.ker thetaLowerLeft := by
  sorry

/-- The truncated Breuil coefficient ring `𝔽₃[u]/(u^n)` (`n = 3e`: `9` for the cubic fields,
`36` for the degree-twelve fields). -/
abbrev BreuilScalars (n : ℕ) := AdjoinRoot ((X : F3[X]) ^ n)

/-- The variable `u` of `𝔽₃[u]/(u^n)`. -/
def uVar (n : ℕ) : BreuilScalars n := AdjoinRoot.root _

/-- The constant `c_π = -φ(G_π)` of README 1.2 over `𝔽₃`: there `φ(G) = G³`. -/
def cPi (G : F3[X]) : F3[X] := -(G ^ 3)

/-- README 1.3 check `cyclicCubic_constant`: for `G = u² - 1`, `G(0) = -1` and `c_π(0) = 1`. -/
example : (X ^ 2 - C 1 : F3[X]).eval 0 = -1 ∧ (cPi (X ^ 2 - C 1)).eval 0 = 1 := by
  simp [cPi]

/-- README 1.4 check `nonabelianCubic_constant`: for `G = u² + 1` (that is `u² - 2` modulo 3),
`c_π(0) = -1`. -/
example : (cPi (X ^ 2 + C 1)).eval 0 = -1 := by
  simp [cPi]

/-- README 2.2: the scalar Euler operator sends `u` to `u`; zero monodromy on a
standard generator does not mean the derivation is identically zero. -/
example : (X : F3[X]) * derivative (X : F3[X]) = X ∧ (X : F3[X]) ≠ 0 := by
  simp

/-- README 2.2: `-1` is a square after extending the residue field to `𝔽₉`; it is not
one in `𝔽₃`. The distinction controls rank-one isomorphism classes. -/
example : (∃ j : GaloisField 3 2, j ^ 2 = -1) ∧ ¬ ∃ j : F3, j ^ 2 = -1 := by
  constructor
  · sorry
  · decide

/-- README 2.3: the coefficient of the unramified quadratic twist at `3` commutes with
Frobenius but is not the identity; a fixed uniformizer alone does not force wild descent. -/
example : (-1 : F3) ^ 3 = -1 ∧ (-1 : F3) ≠ 1 := by decide

/-- README 2.7: the order-three unipotent action differs from its inverse on `(0,1)`.
With the two other operators as in the README this detects the third ideal generator. -/
example : let U : M2 := !![1, 1; 0, 1]
    let Uinv : M2 := !![1, -1; 0, 1]
    U ^ 3 = 1 ∧ U * Uinv = 1 ∧ (U - Uinv).mulVec ![0, 1] = ![-1, 0] := by
  decide

end LayerW32

/-! ## Layers W3.3–W3.5: the three weak-acceptability computations

The rank-one models, extension normal forms, descent constants and tangent bounds of these
layers are statements about Breuil modules with descent and are README targets. Kept here: the
filtration of the exceptional `(6,6)` family, the coefficient-linear Frobenius on the Artin
coefficient rings of 5.9, and the annihilator step of 5.10. -/

section LayersW33toW35

/-- README 5.1: the filtration `⟨u⁶e₁, u⁶e′_ω + (c + c′u⁴)e₁⟩` of the `(6,6)` family, on
`S₃₆²` with basis `(e₁, e′_ω)`. -/
def sixSixFiltration (c c' : F3) : Submodule (BreuilScalars 36) (Fin 2 → BreuilScalars 36) :=
  Submodule.span _ {![uVar 36 ^ 6, 0], ![(c : BreuilScalars 36) + (c' : BreuilScalars 36) * uVar 36 ^ 4,
    uVar 36 ^ 6]}

/-- README 5.1 check `extendedModel_sixSixUnitCrossTerm`: at `c = 1, c′ = 0` the second
generator `e₁ + u⁶e′_ω` lies in the filtration; its `e₁`-coefficient is a unit. -/
example : ![1, uVar 36 ^ 6] ∈ sixSixFiltration 1 0 := by
  apply Submodule.subset_span
  simp

/-- The Artin coefficient ring `A_N = 𝔽₃[T]/(T^N)` of README 5.9. -/
abbrev ArtinCoeff (N : ℕ) := AdjoinRoot ((X : F3[X]) ^ N)

/-- `T ∈ A_N`. -/
def tVar (N : ℕ) : ArtinCoeff N := AdjoinRoot.root _

/-- Breuil scalars with Artin coefficients, `A_N[u]/(u³⁶)`. -/
abbrev ArtinBreuilScalars (N : ℕ) := AdjoinRoot ((X : (ArtinCoeff N)[X]) ^ 36)

/-- `u ∈ A_N[u]/(u³⁶)`. -/
def uArtin (N : ℕ) : ArtinBreuilScalars N := AdjoinRoot.root _

/-- The `A_N`-linear Frobenius `u ↦ u³` of README 5.9: it fixes `A_N`, in particular `T`. -/
def artinFrobenius (N : ℕ) : ArtinBreuilScalars N →ₐ[ArtinCoeff N] ArtinBreuilScalars N :=
  AdjoinRoot.liftAlgHom _ (Algebra.ofId (ArtinCoeff N) (ArtinBreuilScalars N)) (uArtin N ^ 3) (by
    simp only [eval₂_X_pow, uArtin, ← pow_mul]
    rw [show 3 * 36 = 36 + 72 by norm_num, pow_add, AdjoinRoot.root, ← map_pow,
      AdjoinRoot.mk_self, zero_mul])

theorem artinFrobenius_u (N : ℕ) : artinFrobenius N (uArtin N) = uArtin N ^ 3 := by
  simp [artinFrobenius, uArtin]

/-- README 5.9 check `extendedArtinModel_coefficientFrobenius`: the Frobenius fixes `T`, whereas
`T³ = 0` in `A₂`. -/
example : artinFrobenius 2 (algebraMap _ _ (tVar 2)) = algebraMap _ _ (tVar 2) ∧
    tVar 2 ^ 3 = 0 := by
  refine ⟨(artinFrobenius 2).commutes _, ?_⟩
  sorry

/-- README 5.10, the annihilator step: on a finite `3`-primary abelian group with an additive
`F` such that `F² = -3` and `F` kills the `3`-torsion, everything is killed by `3`. -/
theorem nsmul_three_eq_zero_of_frobenius_sq {D : Type*} [AddCommGroup D] (F : D →+ D)
    (hprimary : ∃ n : ℕ, ∀ x : D, (3 ^ n) • x = 0)
    (hker : ∀ x : D, 3 • x = 0 → F x = 0) (hsq : ∀ x : D, F (F x) = -(3 • x)) :
    ∀ x : D, 3 • x = 0 := by
  sorry

/-- README 5.10 check: the hypothesis that `F` kills `D[3]` is needed. On `(ℤ/9)²`,
`F(x, y) = (-3y, x)` has `F² = -3` but `F(3, 0) ≠ 0`, and `3 • (1, 0) ≠ 0`. -/
example : let F : ZMod 9 × ZMod 9 → ZMod 9 × ZMod 9 := fun p => (-3 * p.2, p.1)
    (∀ p, F (F p) = -(3 • p)) ∧ F (3, 0) ≠ 0 ∧ (3 • ((1, 0) : ZMod 9 × ZMod 9)) ≠ 0 := by
  decide

end LayersW33toW35

/-! ## Layer W3.6: Global switching and the modularity theorems

The twisted modular curves, the global companion, the lifting theorems and the modularity
statements need carriers (twisted modular curves, newforms, modularity predicates) that are not
at the pins; they are README targets. The finite count behind the degree-24 cover of 6.2 is kept. -/

section LayerW36

/-- README 6.2: there are `48` ordered bases of `𝔽₃²`, so the cover of pairs modulo
`(a, b) ∼ (-a, b)` has degree `24`. -/
theorem card_GL2_F3 : Nat.card (GL (Fin 2) (ZMod 3)) = 48 := by
  rw [Matrix.card_GL_field]
  norm_num [Finset.prod_range_succ, ZMod.card]

/-- README 6.11: the fixed conductor-50 curve, Cremona `50b1`. -/
def exceptionalCurveFifty : WeierstrassCurve ℚ := ⟨1, 1, 1, -3, 1⟩

/-- README 6.11: the fixed conductor-338 curve, Cremona `338e1`. -/
def exceptionalCurveThreeThirtyEight : WeierstrassCurve ℚ := ⟨1, 1, 1, 3, -5⟩

/-- The discriminant and `c₄` witnesses determine the two exceptional `j`-invariants. -/
example : exceptionalCurveFifty.Δ = -800 ∧ exceptionalCurveFifty.c₄ = 145 ∧
    exceptionalCurveThreeThirtyEight.Δ = -17576 ∧
    exceptionalCurveThreeThirtyEight.c₄ = -143 := by
  norm_num [exceptionalCurveFifty, exceptionalCurveThreeThirtyEight, WeierstrassCurve.Δ,
    WeierstrassCurve.c₄, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
    WeierstrassCurve.b₆, WeierstrassCurve.b₈]

/-- Each fixed equation has a nonzero rational discriminant, hence is elliptic. -/
local instance : exceptionalCurveFifty.IsElliptic := ⟨by
  norm_num [exceptionalCurveFifty, WeierstrassCurve.Δ, WeierstrassCurve.b₂,
    WeierstrassCurve.b₄, WeierstrassCurve.b₆, WeierstrassCurve.b₈, isUnit_iff_ne_zero]⟩

local instance : exceptionalCurveThreeThirtyEight.IsElliptic := ⟨by
  norm_num [exceptionalCurveThreeThirtyEight, WeierstrassCurve.Δ, WeierstrassCurve.b₂,
    WeierstrassCurve.b₄, WeierstrassCurve.b₆, WeierstrassCurve.b₈, isUnit_iff_ne_zero]⟩

/-- README 6.11: the sign of the level-50 `j` and the level-338 value. -/
example : exceptionalCurveFifty.j = -121945 / 32 ∧
    exceptionalCurveThreeThirtyEight.j = 1331 / 8 := by
  norm_num [exceptionalCurveFifty, exceptionalCurveThreeThirtyEight, WeierstrassCurve.j, Units.val_inv_eq_inv_val, WeierstrassCurve.coe_Δ',
    WeierstrassCurve.Δ, WeierstrassCurve.c₄, WeierstrassCurve.b₂,
    WeierstrassCurve.b₄, WeierstrassCurve.b₆, WeierstrassCurve.b₈]

end LayerW36

